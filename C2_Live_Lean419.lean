/- ===== C2.Boundary ===== -/

/-! Exact complex-algebra part of the general unit-circle boundary theorem.
Root-count constancy and finite real-root isolation are distinct obligations. -/

namespace C2

theorem feedback_zero_iff_complex_gain (H N : ℂ) (k : ℝ) (hN : N ≠ 0) :
    H + (k : ℂ) * N = 0 ↔ (k : ℂ) = -H / N := by
  constructor
  · intro h
    apply (eq_div_iff hN).mpr
    linear_combination h
  · intro h
    have hm := (eq_div_iff hN).mp h
    linear_combination hm

theorem feedback_zero_iff_real_gain (H N : ℂ) (k : ℝ) (hN : N ≠ 0) :
    H + (k : ℂ) * N = 0 ↔
      k = (-H / N).re ∧ (-H / N).im = 0 := by
  rw [feedback_zero_iff_complex_gain H N k hN, Complex.ext_iff]
  simp only [Complex.ofReal_re, Complex.ofReal_im, eq_comm (a := (0 : ℝ))]

theorem negative_quotient_re (H N : ℂ) :
    (-H / N).re = -(H * star N).re / Complex.normSq N := by
  simp [Complex.div_re, Complex.mul_re, Complex.mul_im]
  ring

theorem negative_quotient_im (H N : ℂ) :
    (-H / N).im = -(H * star N).im / Complex.normSq N := by
  simp [Complex.div_im, Complex.mul_re, Complex.mul_im]
  ring

theorem feedback_zero_iff_cross_product (H N : ℂ) (k : ℝ) (hN : N ≠ 0) :
    H + (k : ℂ) * N = 0 ↔
      k = -(H * star N).re / Complex.normSq N ∧ (H * star N).im = 0 := by
  rw [feedback_zero_iff_real_gain H N k hN, negative_quotient_re,
    negative_quotient_im]
  have hn : Complex.normSq N ≠ 0 := (Complex.normSq_pos.mpr hN).ne'
  simp only [div_eq_zero_iff, hn, or_false, neg_eq_zero]

def UnitCircleRoot (H N : ℂ → ℂ) (k : ℝ) : Prop :=
  ∃ z : ℂ, ‖z‖ = 1 ∧ H z + (k : ℂ) * N z = 0

theorem unitCircleRoot_iff_boundary (H N : ℂ → ℂ) (k : ℝ)
    (hc : ∀ z : ℂ, ‖z‖ = 1 → N z = 0 → H z ≠ 0) :
    UnitCircleRoot H N k ↔
      ∃ z : ℂ, ‖z‖ = 1 ∧ N z ≠ 0 ∧
        k = -(H z * star (N z)).re / Complex.normSq (N z) ∧
        (H z * star (N z)).im = 0 := by
  constructor
  · rintro ⟨z, hz, he⟩
    have hn : N z ≠ 0 := by
      intro hn
      have hh : H z = 0 := by simpa [hn] using he
      exact hc z hz hn hh
    exact ⟨z, hz, hn, (feedback_zero_iff_cross_product (H z) (N z) k hn).mp he⟩
  · rintro ⟨z, hz, hn, hk, hi⟩
    exact ⟨z, hz, (feedback_zero_iff_cross_product (H z) (N z) k hn).mpr ⟨hk, hi⟩⟩

end C2


/- ===== C2.GainProjection ===== -/

/-!
# Open gain projections and finite exceptional fibers

This module proves the topological step used by the exact projection
algorithm: finite exceptional gain fibers can be omitted when computing the
global supremum of a strict feasible gain set. It does not formalize
polynomial projection, algebraic root isolation, or the CAD algorithm.
-/

noncomputable section

namespace C2.GainProjection

open Set

/-- The projection onto gain of a finite family of strict inequalities.
The admissible parameter set is arbitrary; in the application it is `[0,1]`.
Continuity will only be needed in the gain variable at each fixed parameter. -/
def feasibleGains {ι : Type*} (Γ : Set ℝ) (f : ℝ → ℝ → ι → ℝ) : Set ℝ :=
  {k | ∃ γ ∈ Γ, ∀ i, 0 < f γ k i}

/-- A finite strict continuous system has an open gain projection, even when
the parameter domain is closed and a witness occurs at its endpoint. -/
theorem feasibleGains_isOpen {ι : Type*} [Finite ι]
    (Γ : Set ℝ) (f : ℝ → ℝ → ι → ℝ)
    (hf : ∀ γ ∈ Γ, ∀ i, Continuous (fun k => f γ k i)) :
    IsOpen (feasibleGains Γ f) := by
  have heq : feasibleGains Γ f =
      ⋃ γ ∈ Γ, ⋂ i, {k : ℝ | 0 < f γ k i} := by
    ext k
    simp [feasibleGains]
  rw [heq]
  exact isOpen_iUnion fun γ => isOpen_iUnion fun hγ =>
    isOpen_iInter_of_finite fun i => isOpen_lt continuous_const (hf γ hγ i)

/-- Every nonempty open subset of the real line is infinite. -/
theorem open_nonempty_infinite {S : Set ℝ} (hS : IsOpen S)
    (hne : S.Nonempty) : S.Infinite := by
  obtain ⟨a, b, hab, hsub⟩ := hS.exists_Ioo_subset hne
  exact (Ioo_infinite hab).mono hsub

/-- Removing finitely many exceptional points from an open gain set preserves
all upper bounds. In particular, feasible gains at exceptional fibers cannot
produce a larger isolated maximum. -/
theorem upperBounds_diff_finite {S E : Set ℝ} (hS : IsOpen S)
    (hE : E.Finite) : upperBounds (S \ E) = upperBounds S := by
  ext b
  constructor
  · intro hb x hx
    by_contra hxb
    have hbx : b < x := lt_of_not_ge hxb
    have hopen : IsOpen (S ∩ Ioi b) := hS.inter isOpen_Ioi
    have hinf : (S ∩ Ioi b).Infinite :=
      open_nonempty_infinite hopen ⟨x, hx, hbx⟩
    obtain ⟨y, hy, hyE⟩ := hinf.exists_not_mem_finite hE
    exact (not_le_of_gt hy.2) (hb ⟨hy.1, hyE⟩)
  · intro hb x hx
    exact hb hx.1

/-- Exact equivalence of least-upper-bound assertions before and after
omitting the finite exceptional projection fibers. No boundedness or
nonemptiness hypothesis is hidden in this equivalence. -/
theorem isLUB_diff_finite_iff {S E : Set ℝ} (hS : IsOpen S)
    (hE : E.Finite) (a : ℝ) : IsLUB (S \ E) a ↔ IsLUB S a := by
  unfold IsLUB
  rw [upperBounds_diff_finite hS hE]

/-- Omitting finite fibers also preserves whether a strict gain set is empty. -/
theorem diff_finite_nonempty_iff {S E : Set ℝ} (hS : IsOpen S)
    (hE : E.Finite) : (S \ E).Nonempty ↔ S.Nonempty := by
  constructor
  · rintro ⟨x, hx, _⟩
    exact ⟨x, hx⟩
  · intro hne
    obtain ⟨x, hx, hxE⟩ := (open_nonempty_infinite hS hne).exists_not_mem_finite hE
    exact ⟨x, hx, hxE⟩

/-- The finite-exception omission theorem applied directly to the strict
continuous gain projection used by the general rational optimization. -/
theorem feasibleGains_isLUB_iff {ι : Type*} [Finite ι]
    (Γ : Set ℝ) (f : ℝ → ℝ → ι → ℝ)
    (hf : ∀ γ ∈ Γ, ∀ i, Continuous (fun k => f γ k i))
    {E : Set ℝ} (hE : E.Finite) (a : ℝ) :
    IsLUB (feasibleGains Γ f \ E) a ↔ IsLUB (feasibleGains Γ f) a :=
  isLUB_diff_finite_iff (feasibleGains_isOpen Γ f hf) hE a

/-- Polynomial dependence on gain is sufficient; no continuity assumption
in the discretization parameter is necessary for this projection argument. -/
theorem polynomial_feasibleGains_isOpen {ι : Type*} [Finite ι]
    (Γ : Set ℝ) (p : ℝ → ι → Polynomial ℝ) :
    IsOpen (feasibleGains Γ (fun γ k i => (p γ i).eval k)) :=
  feasibleGains_isOpen Γ _ (fun γ _ i => (p γ i).continuous)

/-- The finite-fiber omission lemma specialized to the polynomial inequalities
obtained from the Schur recursion. This proves the topological component only;
the projection polynomials and lifting algorithm are not defined here. -/
theorem polynomial_feasibleGains_isLUB_iff {ι : Type*} [Finite ι]
    (Γ : Set ℝ) (p : ℝ → ι → Polynomial ℝ)
    {E : Set ℝ} (hE : E.Finite) (a : ℝ) :
    IsLUB (feasibleGains Γ (fun γ k i => (p γ i).eval k) \ E) a ↔
      IsLUB (feasibleGains Γ (fun γ k i => (p γ i).eval k)) a :=
  isLUB_diff_finite_iff (polynomial_feasibleGains_isOpen Γ p) hE a

end C2.GainProjection

end

/- ===== C2.CADAlgorithm ===== -/

/-!
# Finite marked-cell output for the gain projection algorithm

The list maximum and marked-endpoint selection are executable for any supplied
linear order. Their recursion is structural; no numerical tolerance, unbounded
loop, or choice operator occurs in these definitions. The real interpretation
below proves exact least-upper-bound and algebraicity conclusions once the CAD
projection/lifting stage supplies its finite cell decomposition. That stage is
an explicit interface hypothesis here, not an assumed output optimum.
-/

namespace C2.CADAlgorithm

/-- A gain cell with its rational test point and the result of its finite
parameter sign tests. Correct sample placement and marking are separate proof
obligations of projection/lifting. -/
structure Cell (α : Type*) where
  left : α
  right : α
  sample : ℚ
  marked : Bool

/-- Exact maximum of a finite list, with no value assigned to an empty list. -/
def maximum? {α : Type*} [LinearOrder α] : List α → Option α
  | [] => none
  | a :: rest =>
      match maximum? rest with
      | none => some a
      | some b => some (max a b)

/-- The endpoints tested by the final finite maximum step. -/
def markedEndpoints {α : Type*} (cells : List (Cell α)) : List α :=
  (cells.filter fun c => c.marked).map Cell.right

/-- The final output: empty feasible collection or its largest right endpoint. -/
def output {α : Type*} [LinearOrder α] (cells : List (Cell α)) : Option α :=
  maximum? (markedEndpoints cells)

theorem maximum_eq_none_iff {α : Type*} [LinearOrder α] (xs : List α) :
    maximum? xs = none ↔ xs = [] := by
  cases xs with
  | nil => simp [maximum?]
  | cons a rest =>
      cases h : maximum? rest <;> simp [maximum?, h]

theorem maximum_some_spec {α : Type*} [LinearOrder α]
    {xs : List α} {b : α} (h : maximum? xs = some b) :
    b ∈ xs ∧ ∀ a ∈ xs, a ≤ b := by
  induction xs generalizing b with
  | nil => simp [maximum?] at h
  | cons a rest ih =>
      cases ht : maximum? rest with
      | none =>
          have hr : rest = [] := (maximum_eq_none_iff rest).mp ht
          subst rest
          simp [maximum?] at h
          subst b
          simp
      | some m =>
          have hm := ih ht
          simp only [maximum?, ht, Option.some.injEq] at h
          subst b
          constructor
          · by_cases ham : a ≤ m
            · rw [max_eq_right ham]
              exact List.mem_cons_of_mem a hm.1
            · rw [max_eq_left (le_of_not_ge ham)]
              exact List.mem_cons_self
          · intro x hx
            rcases List.mem_cons.mp hx with rfl | hx
            · exact le_max_left _ _
            · exact (hm.2 x hx).trans (le_max_right _ _)

theorem maximum_some_of_nonempty {α : Type*} [LinearOrder α]
    {xs : List α} (h : xs ≠ []) : ∃ b, maximum? xs = some b := by
  cases hmax : maximum? xs with
  | none => exact False.elim (h ((maximum_eq_none_iff xs).mp hmax))
  | some b => exact ⟨b, rfl⟩

theorem mem_markedEndpoints {α : Type*} {cells : List (Cell α)} {a : α} :
    a ∈ markedEndpoints cells ↔
      ∃ c ∈ cells, c.marked = true ∧ c.right = a := by
  simp [markedEndpoints, List.mem_filter, and_assoc]

theorem output_none_iff {α : Type*} [LinearOrder α] (cells : List (Cell α)) :
    output cells = none ↔ ∀ c ∈ cells, c.marked = false := by
  rw [output, maximum_eq_none_iff]
  constructor
  · intro h c hc
    cases hm : c.marked with
    | false => rfl
    | true =>
      have he : c.right ∈ markedEndpoints cells :=
        mem_markedEndpoints.mpr ⟨c, hc, hm, rfl⟩
      simpa [h] using he
  · intro h
    apply List.eq_nil_iff_forall_not_mem.mpr
    intro a ha
    obtain ⟨c, hc, hm, _⟩ := mem_markedEndpoints.mp ha
    have := h c hc
    simp [hm] at this

theorem output_some_spec {α : Type*} [LinearOrder α]
    {cells : List (Cell α)} {b : α} (h : output cells = some b) :
    (∃ c ∈ cells, c.marked = true ∧ c.right = b) ∧
      ∀ c ∈ cells, c.marked = true → c.right ≤ b := by
  obtain ⟨hb, hupper⟩ := maximum_some_spec h
  refine ⟨mem_markedEndpoints.mp hb, ?_⟩
  intro c hc hm
  exact hupper c.right (mem_markedEndpoints.mpr ⟨c, hc, hm, rfl⟩)

theorem output_some_iff {α : Type*} [LinearOrder α]
    {cells : List (Cell α)} {b : α} :
    output cells = some b ↔
      (∃ c ∈ cells, c.marked = true ∧ c.right = b) ∧
        ∀ c ∈ cells, c.marked = true → c.right ≤ b := by
  constructor
  · exact output_some_spec
  · rintro ⟨⟨c, hc, hm, hcb⟩, hb⟩
    have hne : markedEndpoints cells ≠ [] := by
      intro hnil
      have : c.right ∈ markedEndpoints cells :=
        mem_markedEndpoints.mpr ⟨c, hc, hm, rfl⟩
      simpa [hnil] using this
    obtain ⟨a, ha⟩ := maximum_some_of_nonempty hne
    have hoa : output cells = some a := ha
    obtain ⟨⟨d, hd, hdm, hda⟩, haupper⟩ := output_some_spec hoa
    have hab : a ≤ b := hda ▸ hb d hd hdm
    have hba : b ≤ a := hcb ▸ haupper c hc hm
    have : a = b := le_antisymm hab hba
    simpa [this] using hoa

/-- Exact rational tests at one parameter/gain point. In the application the
functions are evaluations of the supplied rational polynomial inequalities. -/
def testPoint (tests : List (ℚ → ℚ → ℚ)) (parameter gain : ℚ) : Bool :=
  tests.all fun f => decide (0 < f parameter gain)

/-- A gain cell is marked iff one of the finitely many rational parameter
samples satisfies all inequalities. Both loops are over explicit lists. -/
def markAtGain (tests : List (ℚ → ℚ → ℚ))
    (parameterSamples : List ℚ) (gain : ℚ) : Bool :=
  parameterSamples.any fun parameter => testPoint tests parameter gain

theorem testPoint_eq_true_iff (tests : List (ℚ → ℚ → ℚ)) (parameter gain : ℚ) :
    testPoint tests parameter gain = true ↔
      ∀ f ∈ tests, 0 < f parameter gain := by
  simp [testPoint, List.all_eq_true]

theorem markAtGain_eq_true_iff (tests : List (ℚ → ℚ → ℚ))
    (parameterSamples : List ℚ) (gain : ℚ) :
    markAtGain tests parameterSamples gain = true ↔
      ∃ parameter ∈ parameterSamples, ∀ f ∈ tests, 0 < f parameter gain := by
  simp [markAtGain, List.any_eq_true, testPoint_eq_true_iff]

/-- Data produced by gain-root and parameter-root isolation, before testing
the signs. The numerical values are rational, rather than approximations. -/
structure SampledCell (α : Type*) where
  left : α
  right : α
  gainSample : ℚ
  parameterSamples : List ℚ

def SampledCell.test {α : Type*} (c : SampledCell α)
    (tests : List (ℚ → ℚ → ℚ)) : Cell α where
  left := c.left
  right := c.right
  sample := c.gainSample
  marked := markAtGain tests c.parameterSamples c.gainSample

/-- Complete finite testing/selection stage, after isolation has returned its
finite lists. It does not call a black-box feasible-set or supremum oracle. -/
def testAndSelect {α : Type*} [LinearOrder α]
    (tests : List (ℚ → ℚ → ℚ)) (cells : List (SampledCell α)) : Option α :=
  output (cells.map fun c => c.test tests)

theorem testAndSelect_none_iff {α : Type*} [LinearOrder α]
    (tests : List (ℚ → ℚ → ℚ)) (cells : List (SampledCell α)) :
    testAndSelect tests cells = none ↔
      ∀ c ∈ cells, ¬∃ parameter ∈ c.parameterSamples,
        ∀ f ∈ tests, 0 < f parameter c.gainSample := by
  rw [testAndSelect, output_none_iff]
  simp only [List.forall_mem_map, SampledCell.test]
  simp only [Bool.eq_false_iff, ne_eq, markAtGain_eq_true_iff]

theorem testAndSelect_some_spec {α : Type*} [LinearOrder α]
    {tests : List (ℚ → ℚ → ℚ)} {cells : List (SampledCell α)} {b : α}
    (h : testAndSelect tests cells = some b) :
    (∃ c ∈ cells, (∃ parameter ∈ c.parameterSamples,
      ∀ f ∈ tests, 0 < f parameter c.gainSample) ∧ c.right = b) ∧
    ∀ c ∈ cells, (∃ parameter ∈ c.parameterSamples,
      ∀ f ∈ tests, 0 < f parameter c.gainSample) → c.right ≤ b := by
  obtain ⟨hsel, hupper⟩ := output_some_spec h
  constructor
  · obtain ⟨c, hc, hm, hcb⟩ := hsel
    obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc
    exact ⟨d, hd, (markAtGain_eq_true_iff _ _ _).mp hm, hcb⟩
  · intro c hc htest
    exact hupper (c.test tests) (List.mem_map.mpr ⟨c, hc, rfl⟩)
      ((markAtGain_eq_true_iff _ _ _).mpr htest)

section RealInterpretation

open Set

/-- The union represented by marked open gain cells. -/
def representedGains (cells : List (Cell ℝ)) : Set ℝ :=
  {k | ∃ c ∈ cells, c.marked = true ∧ c.left < k ∧ k < c.right}

/-- Cell validity is geometric and does not include any optimizer assertion. -/
def ValidCells (cells : List (Cell ℝ)) : Prop :=
  ∀ c ∈ cells, c.left < c.right

theorem representedGains_empty_iff {cells : List (Cell ℝ)}
    (hvalid : ValidCells cells) :
    representedGains cells = ∅ ↔ output cells = none := by
  rw [output_none_iff]
  constructor
  · intro he c hc
    cases hm : c.marked with
    | false => rfl
    | true =>
      have hab := hvalid c hc
      have hw : (c.left + c.right) / 2 ∈ representedGains cells := by
        exact ⟨c, hc, hm, by linarith, by linarith⟩
      simpa [he] using hw
  · intro h
    apply Set.eq_empty_iff_forall_not_mem.mpr
    rintro k ⟨c, hc, hm, _⟩
    have := h c hc
    simp [hm] at this

theorem output_isLUB {cells : List (Cell ℝ)} {b : ℝ}
    (hvalid : ValidCells cells) (hout : output cells = some b) :
    IsLUB (representedGains cells) b := by
  obtain ⟨⟨c, hc, hm, hcb⟩, hupper⟩ := output_some_spec hout
  constructor
  · rintro k ⟨d, hd, hdm, _, hk⟩
    exact hk.le.trans (hupper d hd hdm)
  · intro u hu
    have hub : u ∈ upperBounds (Ioo c.left c.right) := by
      intro k hk
      exact hu ⟨c, hc, hm, hk.1, hk.2⟩
    rw [← hcb]
    exact (isLUB_Ioo (hvalid c hc)).2 hub

theorem output_algebraic {cells : List (Cell ℝ)} {b : ℝ}
    (halg : ∀ c ∈ cells, IsAlgebraic ℚ c.right)
    (hout : output cells = some b) : IsAlgebraic ℚ b := by
  obtain ⟨⟨c, hc, _, hcb⟩, _⟩ := output_some_spec hout
  exact hcb ▸ halg c hc

/-- The cell-output theorem for the actual open gain projection. The equality
`hcover` is the precise projection/lifting correctness obligation: it concerns
all nonexceptional feasible gains, including components away from zero. -/
theorem output_isLUB_of_decomposition {cells : List (Cell ℝ)} {S E : Set ℝ}
    {b : ℝ} (hS : IsOpen S) (hE : E.Finite)
    (hvalid : ValidCells cells) (hcover : S \ E = representedGains cells)
    (hout : output cells = some b) : IsLUB S b := by
  apply (C2.GainProjection.isLUB_diff_finite_iff hS hE b).mp
  rw [hcover]
  exact output_isLUB hvalid hout

theorem output_none_iff_empty_of_decomposition {cells : List (Cell ℝ)}
    {S E : Set ℝ} (hS : IsOpen S) (hE : E.Finite)
    (hvalid : ValidCells cells) (hcover : S \ E = representedGains cells) :
    output cells = none ↔ S = ∅ := by
  rw [← representedGains_empty_iff hvalid, ← hcover]
  rw [← Set.not_nonempty_iff_eq_empty, ← Set.not_nonempty_iff_eq_empty]
  exact not_congr (C2.GainProjection.diff_finite_nonempty_iff hS hE)

end RealInterpretation
end C2.CADAlgorithm


/- ===== C2.ProjectionCompletionWitness ===== -/

/-!
# Rational interior witnesses for strict parameter inequalities

This closes the endpoint-witness step of the projection argument.  CAD
delineability and real-algebraic root isolation are separate obligations.
-/
noncomputable section
open Set
namespace C2.GainProjection

/-- A finite system of strict continuous inequalities feasible anywhere in
the closed parameter interval has a rational witness in its interior. -/
theorem exists_rational_interior_witness {ι : Type*} [Finite ι]
    (f : ℝ → ι → ℝ) (hf : ∀ i, Continuous (fun γ => f γ i))
    {γ : ℝ} (hγ : γ ∈ Icc (0 : ℝ) 1) (hpos : ∀ i, 0 < f γ i) :
    ∃ q : ℚ, 0 < (q : ℝ) ∧ (q : ℝ) < 1 ∧ ∀ i, 0 < f q i := by
  let S : Set ℝ := ⋂ i, {x | 0 < f x i}
  have hS : IsOpen S := isOpen_iInter_of_finite
    (fun i => isOpen_lt continuous_const (hf i))
  have hmem : γ ∈ S := by simpa [S] using hpos
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hS γ hmem
  let a := max 0 (γ - ε/2)
  let b := min 1 (γ + ε/2)
  have hab : a < b := by
    dsimp [a, b]
    apply max_lt
    · apply lt_min
      · norm_num
      · linarith [hγ.1]
    · apply lt_min
      · linarith [hγ.2]
      · linarith
  obtain ⟨q, hqa, hqb⟩ := exists_rat_btwn hab
  have hq0 : 0 < (q : ℝ) := (le_max_left 0 (γ-ε/2)).trans_lt hqa
  have hq1 : (q : ℝ) < 1 := hqb.trans_le (min_le_left 1 (γ+ε/2))
  have hqa' : γ-ε/2 < (q : ℝ) := (le_max_right 0 (γ-ε/2)).trans_lt hqa
  have hqb' : (q : ℝ) < γ+ε/2 := hqb.trans_le (min_le_right 1 (γ+ε/2))
  have hdist : dist (q : ℝ) γ < ε := by
    rw [Real.dist_eq]
    apply abs_lt.mpr
    constructor <;> linarith
  have hqs : (q : ℝ) ∈ S := hball hdist
  exact ⟨q, hq0, hq1, by simpa [S] using hqs⟩

/-- Rational interior witnesses suffice for the full closed-interval gain
projection, including feasible parameters at gamma=0 or gamma=1. -/
theorem feasibleGains_iff_rational_interior {ι : Type*} [Finite ι]
    (f : ℝ → ℝ → ι → ℝ)
    (hf : ∀ k i, Continuous (fun γ => f γ k i)) (k : ℝ) :
    k ∈ feasibleGains (Icc (0 : ℝ) 1) f ↔
      ∃ q : ℚ, 0 < (q : ℝ) ∧ (q : ℝ) < 1 ∧ ∀ i, 0 < f q k i := by
  constructor
  · rintro ⟨γ, hγ, hpos⟩
    exact exists_rational_interior_witness (fun γ i => f γ k i) (hf k) hγ hpos
  · rintro ⟨q, hq0, hq1, hpos⟩
    exact ⟨q, ⟨hq0.le, hq1.le⟩, hpos⟩

end C2.GainProjection

end

/- ===== C2.CADAlgorithmLifting ===== -/

/-!
# Exact finite lifting tests, including closed parameter endpoints

This module connects sign-invariant open parameter cells to the finite
rational tests used in the output stage. The geometric cover and sign
invariance are explicit inputs to be supplied by the polynomial CAD lemmas.
No feasible parameter at an exceptional root or at 0 or 1 is lost.
-/

noncomputable section
open Set
namespace C2.CADAlgorithm

theorem closed_parameter_feasibility_iff_cell_test
    {ι : Type*} [Finite ι] (f : ℝ → ι → ℝ)
    (hf : ∀ i, Continuous (fun γ => f γ i))
    (cells : List (Cell ℝ)) (E : Set ℝ) (hE : E.Finite)
    (hcover : ∀ γ ∈ Ioo (0 : ℝ) 1, γ ∉ E →
      ∃ c ∈ cells, γ ∈ Ioo c.left c.right)
    (hbounded : ∀ c ∈ cells, 0 ≤ c.left ∧ c.right ≤ 1)
    (hsample : ∀ c ∈ cells, (c.sample : ℝ) ∈ Ioo c.left c.right)
    (hconstant : ∀ c ∈ cells, ∀ γ ∈ Ioo c.left c.right,
      (∀ i, 0 < f γ i) ↔ ∀ i, 0 < f c.sample i) :
    (∃ γ ∈ Icc (0 : ℝ) 1, ∀ i, 0 < f γ i) ↔
      ∃ c ∈ cells, ∀ i, 0 < f c.sample i := by
  constructor
  · rintro ⟨γ, hγ, hpos⟩
    obtain ⟨q, hq0, hq1, hqpos⟩ :=
      C2.GainProjection.exists_rational_interior_witness f hf hγ hpos
    let S : Set ℝ := (⋂ i, {x | 0 < f x i}) ∩ Ioo 0 1
    have hopen : IsOpen S :=
      (isOpen_iInter_of_finite (fun i => isOpen_lt continuous_const (hf i))).inter
        isOpen_Ioo
    have hne : S.Nonempty := by
      exact ⟨q, by simpa [S] using And.intro hqpos (And.intro hq0 hq1)⟩
    obtain ⟨x, hx, hxE⟩ :=
      (C2.GainProjection.diff_finite_nonempty_iff hopen hE).mpr hne
    have hxpos : ∀ i, 0 < f x i := by simpa using hx.1
    obtain ⟨c, hc, hxc⟩ := hcover x hx.2 hxE
    exact ⟨c, hc, (hconstant c hc x hxc).mp hxpos⟩
  · rintro ⟨c, hc, hpos⟩
    have hs := hsample c hc
    have hb := hbounded c hc
    exact ⟨c.sample, ⟨hb.1.trans hs.1.le, hs.2.le.trans hb.2⟩, hpos⟩

theorem testPoint_ofFn_iff {n : ℕ}
    (tests : Fin n → ℚ → ℚ → ℚ) (parameter gain : ℚ) :
    testPoint (List.ofFn tests) parameter gain = true ↔
      ∀ i, 0 < tests i parameter gain := by
  simp [testPoint_eq_true_iff, List.mem_ofFn]

theorem markAtGain_ofFn_iff {n : ℕ}
    (tests : Fin n → ℚ → ℚ → ℚ) (samples : List ℚ) (gain : ℚ) :
    markAtGain (List.ofFn tests) samples gain = true ↔
      ∃ parameter ∈ samples, ∀ i, 0 < tests i parameter gain := by
  simp [markAtGain, List.any_eq_true, testPoint_ofFn_iff]

/-- Rational arithmetic sign testing agrees exactly with the real
interpretation. This is an equality bridge, not a floating-point claim. -/
theorem markAtGain_real_interpretation {n : ℕ}
    (tests : Fin n → ℚ → ℚ → ℚ) (f : ℝ → ℝ → Fin n → ℝ)
    (hcast : ∀ q k i, ((tests i q k : ℚ) : ℝ) = f q k i)
    (samples : List ℚ) (gain : ℚ) :
    markAtGain (List.ofFn tests) samples gain = true ↔
      ∃ parameter ∈ samples, ∀ i, 0 < f parameter gain i := by
  rw [markAtGain_ofFn_iff]
  have heq : ∀ q i, 0 < tests i q gain ↔ 0 < f q gain i := by
    intro q i
    rw [← hcast q gain i]
    exact Rat.cast_pos.symm
  simp_rw [heq]

/-- The exact list of cell samples suffices at a fixed rational gain, including
feasible closed-domain endpoints and omitted finite parameter cuts. -/
theorem finite_lifting_mark_correct {n : ℕ}
    (tests : Fin n → ℚ → ℚ → ℚ) (f : ℝ → ℝ → Fin n → ℝ)
    (hcast : ∀ q k i, ((tests i q k : ℚ) : ℝ) = f q k i)
    (gain : ℚ) (hf : ∀ i, Continuous (fun γ => f γ gain i))
    (cells : List (Cell ℝ)) (E : Set ℝ) (hE : E.Finite)
    (hcover : ∀ γ ∈ Ioo (0 : ℝ) 1, γ ∉ E →
      ∃ c ∈ cells, γ ∈ Ioo c.left c.right)
    (hbounded : ∀ c ∈ cells, 0 ≤ c.left ∧ c.right ≤ 1)
    (hsample : ∀ c ∈ cells, (c.sample : ℝ) ∈ Ioo c.left c.right)
    (hconstant : ∀ c ∈ cells, ∀ γ ∈ Ioo c.left c.right,
      (∀ i, 0 < f γ gain i) ↔ ∀ i, 0 < f c.sample gain i) :
    markAtGain (List.ofFn tests) (cells.map Cell.sample) gain = true ↔
      ∃ γ ∈ Icc (0 : ℝ) 1, ∀ i, 0 < f γ gain i := by
  rw [markAtGain_real_interpretation tests f hcast]
  rw [closed_parameter_feasibility_iff_cell_test
    (fun γ i => f γ gain i) hf cells E hE hcover hbounded hsample hconstant]
  simp only [List.mem_map]
  constructor
  · rintro ⟨q, ⟨c, hc, rfl⟩, hq⟩
    exact ⟨c, hc, hq⟩
  · rintro ⟨c, hc, hq⟩
    exact ⟨c.sample, ⟨c, hc, rfl⟩, hq⟩

end C2.CADAlgorithm

end

/- ===== C2.CADCells ===== -/

/-! Mathematical coverage of the gain axis by the adjacent cells of a finite
cut set. This is a semantic partition theorem; effective encodings and ordered
root isolation are separate algorithmic obligations. -/

open Set

namespace C2.CADCells

def Adjacent (cuts : Finset ℝ) (a b : ℝ) : Prop :=
  a ∈ cuts ∧ b ∈ cuts ∧ a < b ∧ ∀ c ∈ cuts, a < c → b ≤ c

noncomputable def cells (cuts : Finset ℝ) : Finset (ℝ × ℝ) := by
  classical
  exact (cuts.product cuts).filter fun c =>
    c.1 < c.2 ∧ ∀ z ∈ cuts, c.1 < z → c.2 ≤ z

theorem mem_cells_iff (cuts : Finset ℝ) (a b : ℝ) :
    (a,b) ∈ cells cuts ↔ Adjacent cuts a b := by
  classical
  simp [cells, Adjacent, and_assoc]

theorem no_cut_inside {cuts : Finset ℝ} {a b x : ℝ}
    (h : Adjacent cuts a b) (hx : x ∈ Ioo a b) : x ∉ cuts := by
  intro hxc
  exact (not_le_of_gt hx.2) (h.2.2.2 x hxc hx.1)

theorem exists_adjacent_of_between {cuts : Finset ℝ} {K x : ℝ}
    (hzero : 0 ∈ cuts) (hK : K ∈ cuts) (hx : x ∈ Ioo 0 K)
    (hxc : x ∉ cuts) :
    ∃ a b, Adjacent cuts a b ∧ x ∈ Ioo a b := by
  classical
  let lows := cuts.filter (fun c => c < x)
  let highs := cuts.filter (fun c => x < c)
  have hl : lows.Nonempty := ⟨0, Finset.mem_filter.mpr ⟨hzero,hx.1⟩⟩
  have hh : highs.Nonempty := ⟨K, Finset.mem_filter.mpr ⟨hK,hx.2⟩⟩
  let a := lows.max' hl
  let b := highs.min' hh
  have ha : a ∈ lows := Finset.max'_mem _ _
  have hb : b ∈ highs := Finset.min'_mem _ _
  obtain ⟨hac,hax⟩ := Finset.mem_filter.mp ha
  obtain ⟨hbc,hxb⟩ := Finset.mem_filter.mp hb
  have hnext : ∀ c ∈ cuts, a < c → b ≤ c := by
    intro c hc hac'
    have hcx : ¬ c < x := by
      intro hcx
      have hca : c ≤ a := Finset.le_max' lows c (Finset.mem_filter.mpr ⟨hc,hcx⟩)
      exact (not_le_of_gt hac') hca
    have hne : c ≠ x := by
      intro heq
      exact hxc (heq ▸ hc)
    have hxc' : x < c := lt_of_le_of_ne (le_of_not_gt hcx) (Ne.symm hne)
    exact Finset.min'_le highs c (Finset.mem_filter.mpr ⟨hc,hxc'⟩)
  exact ⟨a,b,⟨hac,hbc,lt_trans hax hxb,hnext⟩,hax,hxb⟩

theorem finite_cell_cover {cuts : Finset ℝ} {K x : ℝ}
    (hzero : 0 ∈ cuts) (hK : K ∈ cuts)
    (hbound : ∀ c ∈ cuts, c ∈ Icc 0 K) :
    (∃ c ∈ cells cuts, x ∈ Ioo c.1 c.2) ↔
      x ∈ Ioo 0 K ∧ x ∉ cuts := by
  constructor
  · rintro ⟨⟨a,b⟩,hc,hx⟩
    have h := (mem_cells_iff cuts a b).mp hc
    exact ⟨⟨lt_of_le_of_lt (hbound a h.1).1 hx.1,
      lt_of_lt_of_le hx.2 (hbound b h.2.1).2⟩,no_cut_inside h hx⟩
  · rintro ⟨hx,hxc⟩
    obtain ⟨a,b,hab,hxab⟩ := exists_adjacent_of_between hzero hK hx hxc
    exact ⟨(a,b),(mem_cells_iff cuts a b).mpr hab,hxab⟩

theorem adjacent_unique_at {cuts : Finset ℝ} {a b c d x : ℝ}
    (hab : Adjacent cuts a b) (hcd : Adjacent cuts c d)
    (hxab : x ∈ Ioo a b) (hxcd : x ∈ Ioo c d) : a = c ∧ b = d := by
  have hac : a = c := by
    apply le_antisymm
    · by_contra! hca
      have hda := hcd.2.2.2 a hab.1 hca
      linarith [hxab.1,hxcd.2]
    · by_contra! hac
      have hbc := hab.2.2.2 c hcd.1 hac
      linarith [hxcd.1,hxab.2]
  refine ⟨hac,le_antisymm ?_ ?_⟩
  · exact hab.2.2.2 d hcd.2.1 (hac ▸ hcd.2.2.1)
  · exact hcd.2.2.2 b hab.2.1 (hac ▸ hab.2.2.1)

theorem rational_sample_exists {cuts : Finset ℝ} {a b : ℝ}
    (h : Adjacent cuts a b) : ∃ q : ℚ, (q : ℝ) ∈ Ioo a b := by
  exact exists_rat_btwn h.2.2.1

theorem cut_union_coverage {cuts : Finset ℝ} {K : ℝ}
    (hzero : 0 ∈ cuts) (hK : K ∈ cuts)
    (hbound : ∀ c ∈ cuts, c ∈ Icc 0 K) :
    {x | ∃ c ∈ cells cuts, x ∈ Ioo c.1 c.2} = Ioo 0 K \ (cuts : Set ℝ) := by
  ext x
  exact finite_cell_cover hzero hK hbound

end C2.CADCells


/- ===== C2.CADAlgorithmAssembly ===== -/

/-!
# Assembly of finite gain cells, exact tests, and the algebraic supremum

Finite projection cuts determine the actual adjacent cells. This module
connects their rational lifting tests to the executable finite output stage.
The polynomial projection theorem must supply constancy of feasibility on a
gain cell; root isolation/lifting must supply the test correctness at its
rational gain sample. Those are explicit obligations, not an optimizer oracle.
-/

noncomputable section
open Set
namespace C2.CADAlgorithm

def sampledPair (c : ℝ × ℝ) (gainSamples : (ℝ × ℝ) → ℚ)
    (parameterSamples : (ℝ × ℝ) → List ℚ) : SampledCell ℝ where
  left := c.1
  right := c.2
  gainSample := gainSamples c
  parameterSamples := parameterSamples c

/-- Semantic interpretation of the finite adjacent cells. Effective root
encodings supply this list and its samples; `testAndSelect` itself is the
structurally recursive computation, independent of this real interpretation. -/
def adjacentSampledCells (cuts : Finset ℝ) (gainSamples : (ℝ × ℝ) → ℚ)
    (parameterSamples : (ℝ × ℝ) → List ℚ) : List (SampledCell ℝ) :=
  (C2.CADCells.cells cuts).toList.map fun c => sampledPair c gainSamples parameterSamples

theorem adjacent_tested_cells_valid (cuts : Finset ℝ)
    (gainSamples : (ℝ × ℝ) → ℚ) (parameterSamples : (ℝ × ℝ) → List ℚ)
    (tests : List (ℚ → ℚ → ℚ)) :
    ValidCells ((adjacentSampledCells cuts gainSamples parameterSamples).map
      fun c => c.test tests) := by
  intro c hc
  obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc
  obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hd
  have hp' : p ∈ C2.CADCells.cells cuts := Finset.mem_toList.mp hp
  exact ((C2.CADCells.mem_cells_iff cuts p.1 p.2).mp hp').2.2.1

/-- Exact representation of all nonexceptional gains by the marked cells,
derived from geometric adjacent-cell coverage and sample-test correctness. -/
theorem tested_adjacent_decomposition {S : Set ℝ} {cuts : Finset ℝ} {K : ℝ}
    (hzero : 0 ∈ cuts) (hK : K ∈ cuts)
    (hbound : ∀ c ∈ cuts, c ∈ Icc 0 K)
    (hsupport : S ⊆ Ioo 0 K)
    (gainSamples : (ℝ × ℝ) → ℚ) (parameterSamples : (ℝ × ℝ) → List ℚ)
    (tests : List (ℚ → ℚ → ℚ))
    (hconstant : ∀ c ∈ C2.CADCells.cells cuts, ∀ k ∈ Ioo c.1 c.2,
      k ∈ S ↔ (gainSamples c : ℝ) ∈ S)
    (htest : ∀ c ∈ C2.CADCells.cells cuts,
      markAtGain tests (parameterSamples c) (gainSamples c) = true ↔
        (gainSamples c : ℝ) ∈ S) :
    S \ (cuts : Set ℝ) = representedGains
      ((adjacentSampledCells cuts gainSamples parameterSamples).map fun c => c.test tests) := by
  ext k
  constructor
  · rintro ⟨hkS, hkcut⟩
    obtain ⟨p, hp, hkp⟩ :=
      (C2.CADCells.finite_cell_cover hzero hK hbound).mpr ⟨hsupport hkS, hkcut⟩
    have hm := (htest p hp).mpr ((hconstant p hp k hkp).mp hkS)
    refine ⟨(sampledPair p gainSamples parameterSamples).test tests, ?_, hm, hkp⟩
    apply List.mem_map.mpr
    refine ⟨sampledPair p gainSamples parameterSamples, ?_, rfl⟩
    exact List.mem_map.mpr ⟨p, Finset.mem_toList.mpr hp, rfl⟩
  · rintro ⟨c, hc, hm, hkleft, hkright⟩
    obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc
    obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hd
    have hp' : p ∈ C2.CADCells.cells cuts := Finset.mem_toList.mp hp
    have hkp : k ∈ Ioo p.1 p.2 := ⟨hkleft, hkright⟩
    have hsamp := (htest p hp').mp hm
    exact ⟨(hconstant p hp' k hkp).mpr hsamp,
      (C2.CADCells.finite_cell_cover hzero hK hbound).mp ⟨p, hp', hkp⟩ |>.2⟩

theorem tested_adjacent_empty_iff {S : Set ℝ} {cuts : Finset ℝ} {K : ℝ}
    (hS : IsOpen S) (hzero : 0 ∈ cuts) (hK : K ∈ cuts)
    (hbound : ∀ c ∈ cuts, c ∈ Icc 0 K) (hsupport : S ⊆ Ioo 0 K)
    (gainSamples : (ℝ × ℝ) → ℚ) (parameterSamples : (ℝ × ℝ) → List ℚ)
    (tests : List (ℚ → ℚ → ℚ))
    (hconstant : ∀ c ∈ C2.CADCells.cells cuts, ∀ k ∈ Ioo c.1 c.2,
      k ∈ S ↔ (gainSamples c : ℝ) ∈ S)
    (htest : ∀ c ∈ C2.CADCells.cells cuts,
      markAtGain tests (parameterSamples c) (gainSamples c) = true ↔
        (gainSamples c : ℝ) ∈ S) :
    testAndSelect tests (adjacentSampledCells cuts gainSamples parameterSamples) = none ↔
      S = ∅ := by
  exact output_none_iff_empty_of_decomposition hS cuts.finite_toSet
    (adjacent_tested_cells_valid cuts gainSamples parameterSamples tests)
    (tested_adjacent_decomposition hzero hK hbound hsupport
      gainSamples parameterSamples tests hconstant htest)

theorem tested_adjacent_supremum {S : Set ℝ} {cuts : Finset ℝ} {K b : ℝ}
    (hS : IsOpen S) (hzero : 0 ∈ cuts) (hK : K ∈ cuts)
    (hbound : ∀ c ∈ cuts, c ∈ Icc 0 K) (hsupport : S ⊆ Ioo 0 K)
    (gainSamples : (ℝ × ℝ) → ℚ) (parameterSamples : (ℝ × ℝ) → List ℚ)
    (tests : List (ℚ → ℚ → ℚ))
    (hconstant : ∀ c ∈ C2.CADCells.cells cuts, ∀ k ∈ Ioo c.1 c.2,
      k ∈ S ↔ (gainSamples c : ℝ) ∈ S)
    (htest : ∀ c ∈ C2.CADCells.cells cuts,
      markAtGain tests (parameterSamples c) (gainSamples c) = true ↔
        (gainSamples c : ℝ) ∈ S)
    (hout : testAndSelect tests (adjacentSampledCells cuts gainSamples parameterSamples) = some b) :
    IsLUB S b := by
  exact output_isLUB_of_decomposition hS cuts.finite_toSet
    (adjacent_tested_cells_valid cuts gainSamples parameterSamples tests)
    (tested_adjacent_decomposition hzero hK hbound hsupport
      gainSamples parameterSamples tests hconstant htest) hout

theorem tested_adjacent_output_mem_cuts {cuts : Finset ℝ} {b : ℝ}
    (gainSamples : (ℝ × ℝ) → ℚ) (parameterSamples : (ℝ × ℝ) → List ℚ)
    (tests : List (ℚ → ℚ → ℚ))
    (hout : testAndSelect tests (adjacentSampledCells cuts gainSamples parameterSamples) = some b) :
    b ∈ cuts := by
  obtain ⟨⟨c, hc, _, hcb⟩, _⟩ := testAndSelect_some_spec hout
  obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hc
  have hp' : p ∈ C2.CADCells.cells cuts := Finset.mem_toList.mp hp
  have hb := ((C2.CADCells.mem_cells_iff cuts p.1 p.2).mp hp').2.1
  exact hcb ▸ hb

theorem tested_adjacent_output_algebraic {cuts : Finset ℝ} {b : ℝ}
    (gainSamples : (ℝ × ℝ) → ℚ) (parameterSamples : (ℝ × ℝ) → List ℚ)
    (tests : List (ℚ → ℚ → ℚ))
    (halgebraic : ∀ c ∈ cuts, IsAlgebraic ℚ c)
    (hout : testAndSelect tests (adjacentSampledCells cuts gainSamples parameterSamples) = some b) :
    IsAlgebraic ℚ b := by
  exact halgebraic b (tested_adjacent_output_mem_cuts gainSamples parameterSamples tests hout)

theorem supremum_strict_search_bound {S : Set ℝ} {b K₀ K : ℝ}
    (hb : IsLUB S b) (hbound : ∀ k ∈ S, k ≤ K₀) (hstrict : K₀ < K) : b < K :=
  (hb.2 hbound).trans_lt hstrict

end C2.CADAlgorithm

end

/- ===== C2.CADAlgorithmInterpretation ===== -/

/-! Exact interpretation of executable ordered endpoint data. This bridge
allows a computable representation of real algebraic cuts to use the generic
finite algorithm, while the geometric correctness theorem is stated in ℝ. -/

namespace C2.CADAlgorithm

def Cell.mapEndpoints {α β : Type*} (f : α → β) (c : Cell α) : Cell β where
  left := f c.left
  right := f c.right
  sample := c.sample
  marked := c.marked

def SampledCell.mapEndpoints {α β : Type*} (f : α → β)
    (c : SampledCell α) : SampledCell β where
  left := f c.left
  right := f c.right
  gainSample := c.gainSample
  parameterSamples := c.parameterSamples

theorem monotone_map_max {α β : Type*} [LinearOrder α] [LinearOrder β]
    {f : α → β} (hf : Monotone f) (a b : α) :
    f (max a b) = max (f a) (f b) := by
  by_cases h : a ≤ b
  · rw [max_eq_right h, max_eq_right (hf h)]
  · rw [max_eq_left (le_of_not_ge h), max_eq_left (hf (le_of_not_ge h))]

theorem maximum_map {α β : Type*} [LinearOrder α] [LinearOrder β]
    {f : α → β} (hf : Monotone f) (xs : List α) :
    maximum? (xs.map f) = (maximum? xs).map f := by
  induction xs with
  | nil => rfl
  | cons a rest ih =>
    simp only [List.map_cons, maximum?, ih]
    cases h : maximum? rest with
    | none => rfl
    | some b => simp [monotone_map_max hf]

theorem markedEndpoints_map {α β : Type*} (f : α → β) (cells : List (Cell α)) :
    markedEndpoints (cells.map (Cell.mapEndpoints f)) = (markedEndpoints cells).map f := by
  induction cells with
  | nil => rfl
  | cons c rest ih =>
    cases hm : c.marked <;>
      simp [markedEndpoints, Cell.mapEndpoints, hm, markedEndpoints] at ih ⊢ <;>
      exact ih

theorem output_map {α β : Type*} [LinearOrder α] [LinearOrder β]
    {f : α → β} (hf : Monotone f) (cells : List (Cell α)) :
    output (cells.map (Cell.mapEndpoints f)) = (output cells).map f := by
  rw [output, markedEndpoints_map, maximum_map hf]
  rfl

theorem testAndSelect_map {α β : Type*} [LinearOrder α] [LinearOrder β]
    {f : α → β} (hf : Monotone f)
    (tests : List (ℚ → ℚ → ℚ)) (cells : List (SampledCell α)) :
    testAndSelect tests (cells.map (SampledCell.mapEndpoints f)) =
      (testAndSelect tests cells).map f := by
  have hlist : (cells.map (SampledCell.mapEndpoints f)).map (fun c => c.test tests) =
      (cells.map fun c => c.test tests).map (Cell.mapEndpoints f) := by
    simp only [List.map_map]
    rfl
  simp only [testAndSelect]
  rw [hlist, output_map hf]

theorem interpreted_output_isLUB {α : Type*} [LinearOrder α]
    {f : α → ℝ} (hf : Monotone f) {cells : List (Cell α)} {a : α}
    (hvalid : ValidCells (cells.map (Cell.mapEndpoints f)))
    (hout : output cells = some a) :
    IsLUB (representedGains (cells.map (Cell.mapEndpoints f))) (f a) := by
  apply output_isLUB hvalid
  rw [output_map hf, hout]
  rfl

theorem interpreted_output_algebraic {α : Type*} [LinearOrder α]
    {f : α → ℝ} {cells : List (Cell α)} {a : α}
    (halg : ∀ c ∈ cells, IsAlgebraic ℚ (f c.right))
    (hout : output cells = some a) : IsAlgebraic ℚ (f a) := by
  obtain ⟨⟨c, hc, _, hca⟩, _⟩ := output_some_spec hout
  exact hca ▸ halg c hc

end C2.CADAlgorithm


/- ===== C2.CADDelineability ===== -/

/-!
# Direct CAD fiber constancy from simple disjoint roots

For strict feasibility on a compact parameter interval, global ordered root
sections can be avoided: a weakly feasible limiting parameter can be made
strictly feasible whenever at most one basis factor vanishes there and its
parameter derivative is nonzero. Compactness then makes each feasible sign
pattern closed on the regular gain set; openness is already elementary.
-/

noncomputable section
open Set Filter
open scoped Topology

namespace C2.CADDelineability

/-- A simple real zero has positive values in every neighborhood. This is the
contrapositive of Fermat's theorem, not a root-continuation hypothesis. -/
theorem simple_zero_positive_near {f : ℝ → ℝ} {x d : ℝ}
    (hf : HasDerivAt f d x) (hd : d ≠ 0) (hx : f x = 0)
    {U : Set ℝ} (hU : U ∈ 𝓝 x) : ∃ y ∈ U, 0 < f y := by
  by_contra h
  have hm : IsLocalMax f x := by
    change ∀ᶠ y in 𝓝 x, f y ≤ f x
    filter_upwards [hU] with y hy
    rw [hx]
    exact le_of_not_gt (fun hpos => h ⟨y, hy, hpos⟩)
  exact hd (hm.hasDerivAt_eq_zero hf)

/-- On the closed parameter interval, a nonnegative sign pattern is attainable
strictly if roots are pairwise disjoint and simple and no factor vanishes at
an endpoint. The theorem applies also after independently reversing signs. -/
theorem weak_pattern_implies_strict {ι : Type*} [Finite ι]
    (F : ι → ℝ → ℝ) (hcont : ∀ i, Continuous (F i))
    (hzero : ∀ i, F i 0 ≠ 0) (hone : ∀ i, F i 1 ≠ 0)
    {x : ℝ} (hx : x ∈ Icc (0 : ℝ) 1) (hweak : ∀ i, 0 ≤ F i x)
    (hdisjoint : ∀ i j, i ≠ j → F i x = 0 → F j x ≠ 0)
    (hsimple : ∀ i, F i x = 0 → ∃ d : ℝ, d ≠ 0 ∧ HasDerivAt (F i) d x) :
    ∃ y ∈ Icc (0 : ℝ) 1, ∀ i, 0 < F i y := by
  classical
  by_cases hz : ∃ j, F j x = 0
  · obtain ⟨j, hj⟩ := hz
    have hx0 : x ≠ 0 := by intro h; subst x; exact hzero j hj
    have hx1 : x ≠ 1 := by intro h; subst x; exact hone j hj
    have hxi : x ∈ Ioo (0 : ℝ) 1 :=
      ⟨lt_of_le_of_ne hx.1 (Ne.symm hx0), lt_of_le_of_ne hx.2 hx1⟩
    have hother : ∀ᶠ y in 𝓝 x, ∀ i, i ≠ j → 0 < F i y := by
      apply Filter.eventually_all.mpr
      intro i
      by_cases hij : i = j
      · exact Filter.Eventually.of_forall (by simp [hij])
      · have hi : 0 < F i x :=
          lt_of_le_of_ne (hweak i) (Ne.symm (hdisjoint j i (Ne.symm hij) hj))
        exact ((hcont i).continuousAt.eventually (Ioi_mem_nhds hi)).mono
          (fun y hy _ => hy)
    obtain ⟨d, hd, hf⟩ := hsimple j hj
    obtain ⟨y, hy, hpos⟩ := simple_zero_positive_near hf hd hj
      (inter_mem (Ioo_mem_nhds hxi.1 hxi.2) hother)
    refine ⟨y, ⟨hy.1.1.le, hy.1.2.le⟩, ?_⟩
    intro i
    by_cases hij : i = j
    · simpa [hij] using hpos
    · exact hy.2 i hij
  · refine ⟨x, hx, fun i => ?_⟩
    exact lt_of_le_of_ne (hweak i) (by intro hi; exact hz ⟨i, hi.symm⟩)

/-- Strict realization of one signed basis pattern. The first coordinate is
 gain and the second coordinate is the bounded design parameter. -/
def patternGains {ι : Type*} (F : ι → ℝ × ℝ → ℝ) : Set ℝ :=
  {k | ∃ x ∈ Icc (0 : ℝ) 1, ∀ i, 0 < F i (k, x)}

/-- Compactness plus a transverse simple root closes the feasible sign-pattern
 projection at every regular gain. No root-ordering or CAD invariance is assumed. -/
theorem pattern_limit_feasible {ι : Type*} [Finite ι]
    (F : ι → ℝ × ℝ → ℝ) (hcont : ∀ i, Continuous (F i))
    {k : ℝ} (hzero : ∀ i, F i (k, 0) ≠ 0) (hone : ∀ i, F i (k, 1) ≠ 0)
    (hdisjoint : ∀ x ∈ Icc (0 : ℝ) 1, ∀ i j,
      i ≠ j → F i (k, x) = 0 → F j (k, x) ≠ 0)
    (hsimple : ∀ x ∈ Icc (0 : ℝ) 1, ∀ i, F i (k, x) = 0 →
      ∃ d : ℝ, d ≠ 0 ∧ HasDerivAt (fun y => F i (k, y)) d x)
    {ks : ℕ → ℝ} (hks : ∀ n, ks n ∈ patternGains F)
    (hlim : Tendsto ks atTop (𝓝 k)) : k ∈ patternGains F := by
  classical
  choose xs hxs hpos using hks
  obtain ⟨x, hx, φ, hφ, hxlim⟩ := isCompact_Icc.tendsto_subseq hxs
  have hkφ : Tendsto (ks ∘ φ) atTop (𝓝 k) := hlim.comp hφ.tendsto_atTop
  have hp : Tendsto (fun n => (ks (φ n), xs (φ n))) atTop (𝓝 (k, x)) :=
    hkφ.prodMk_nhds hxlim
  have hweak : ∀ i, 0 ≤ F i (k, x) := by
    intro i
    exact ge_of_tendsto ((hcont i).continuousAt.tendsto.comp hp)
      (Filter.Eventually.of_forall (fun n => (hpos (φ n) i).le))
  exact weak_pattern_implies_strict (fun i y => F i (k, y))
    (fun i => (hcont i).comp (continuous_const.prodMk continuous_id))
    hzero hone hx hweak (hdisjoint x hx) (hsimple x hx)

/-- The sign-pattern projection is always open, regardless of regularity. -/
theorem patternGains_isOpen {ι : Type*} [Finite ι]
    (F : ι → ℝ × ℝ → ℝ) (hcont : ∀ i, Continuous (F i)) :
    IsOpen (patternGains F) :=
  C2.GainProjection.feasibleGains_isOpen (Icc (0 : ℝ) 1)
    (fun x k i => F i (k, x))
    (fun x _ i => (hcont i).comp (continuous_id.prodMk continuous_const))

/-- Algebraic regularity is stated pointwise on the gain set. -/
def Regular {ι : Type*} (F : ι → ℝ × ℝ → ℝ) (k : ℝ) : Prop :=
  (∀ i, F i (k, 0) ≠ 0) ∧ (∀ i, F i (k, 1) ≠ 0) ∧
  (∀ x ∈ Icc (0 : ℝ) 1, ∀ i j,
    i ≠ j → F i (k, x) = 0 → F j (k, x) ≠ 0) ∧
  (∀ x ∈ Icc (0 : ℝ) 1, ∀ i, F i (k, x) = 0 →
    ∃ d : ℝ, d ≠ 0 ∧ HasDerivAt (fun y => F i (k, y)) d x)

/-- On an arbitrary set of regular gains, the strict pattern projection is
 relatively closed. Openness and connectedness will give sample invariance. -/
theorem patternGains_isClosed_relative {ι : Type*} [Finite ι]
    (F : ι → ℝ × ℝ → ℝ) (hcont : ∀ i, Continuous (F i))
    (I : Set ℝ) (hreg : ∀ k ∈ I, Regular F k) :
    IsClosed {k : I | (k : ℝ) ∈ patternGains F} := by
  apply isSeqClosed_iff_isClosed.mp
  intro ks k hks hlim
  have hk := hreg k k.property
  exact pattern_limit_feasible F hcont hk.1 hk.2.1 hk.2.2.1 hk.2.2.2 hks
    (continuous_subtype_val.continuousAt.tendsto.comp hlim)

/-- One rational sample therefore determines feasibility of this complete sign
 pattern on every connected projection-free gain interval. -/
theorem pattern_constant_on_preconnected {ι : Type*} [Finite ι]
    (F : ι → ℝ × ℝ → ℝ) (hcont : ∀ i, Continuous (F i))
    (I : Set ℝ) (hI : IsPreconnected I) (hreg : ∀ k ∈ I, Regular F k)
    {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) :
    a ∈ patternGains F ↔ b ∈ patternGains F := by
  letI : PreconnectedSpace I := isPreconnected_iff_preconnectedSpace.mp hI
  have hc : IsClopen {k : I | (k : ℝ) ∈ patternGains F} :=
    ⟨patternGains_isClosed_relative F hcont I hreg,
      (patternGains_isOpen F hcont).preimage continuous_subtype_val⟩
  constructor
  · intro h
    have hu := hc.eq_univ ⟨⟨a, ha⟩, h⟩
    have : (⟨b, hb⟩ : I) ∈ ({k : I | (k : ℝ) ∈ patternGains F}) := by rw [hu]; trivial
    exact this
  · intro h
    have hu := hc.eq_univ ⟨⟨b, hb⟩, h⟩
    have : (⟨a, ha⟩ : I) ∈ ({k : I | (k : ℝ) ∈ patternGains F}) := by rw [hu]; trivial
    exact this

end C2.CADDelineability

end

/- ===== C2.CADEffectivePolynomial ===== -/

/-! Dense coefficient lists give executable rational polynomial arithmetic.
The mathematical polynomial is used only as the semantic target; no runtime
operation calls mathlib's noncomputable polynomial ring or Euclidean domain. -/
namespace C2.CADEffective.Dense
open Polynomial

abbrev Poly := List ℚ

def denote (p : Poly) : ℚ[X] := ⟨p.toFinsupp⟩

@[simp] theorem coeff_denote (p : Poly) (n : ℕ) :
    (denote p).coeff n = p.getD n 0 := rfl

@[simp] theorem denote_nil : denote [] = 0 := by
  ext n; simp

@[simp] theorem denote_cons (a : ℚ) (p : Poly) :
    denote (a :: p) = C a + X * denote p := by
  ext n
  cases n with
  | zero => simp
  | succ n => simp [coeff_X_mul]

def add : Poly → Poly → Poly
  | [], q => q
  | p, [] => p
  | a :: p, b :: q => (a + b) :: add p q

def neg (p : Poly) : Poly := p.map (- ·)

def scale (a : ℚ) (p : Poly) : Poly := p.map (a * ·)

def mul : Poly → Poly → Poly
  | [], _ => []
  | a :: p, q => add (scale a q) (0 :: mul p q)

def derivative : Poly → Poly
  | [] => []
  | _ :: p => add p (0 :: derivative p)

def eval (p : Poly) (x : ℚ) : ℚ := p.foldr (fun a b => a + x*b) 0

def coeffBound (p : Poly) (R : ℚ) : ℚ :=
  ∑ i ∈ Finset.range p.length, |p.getD i 0| * R^i

def eqb (p q : Poly) : Bool :=
  (List.range (max p.length q.length)).all
    (fun n => decide (p.getD n 0 = q.getD n 0))

@[simp] theorem denote_add (p q : Poly) : denote (add p q) = denote p + denote q := by
  induction p generalizing q with
  | nil => simp [add]
  | cons a p ih =>
      cases q with
      | nil => simp [add]
      | cons b q => simp [add, ih, C_add]; ring

@[simp] theorem denote_neg (p : Poly) : denote (neg p) = -denote p := by
  induction p with
  | nil => simp [neg]
  | cons a p ih =>
      simp only [neg, List.map_cons, denote_cons, C_neg]
      rw [show denote (List.map Neg.neg p) = -denote p from ih]
      ring

@[simp] theorem denote_scale (a : ℚ) (p : Poly) :
    denote (scale a p) = C a * denote p := by
  induction p with
  | nil => simp [scale]
  | cons b p ih =>
      simp only [scale, List.map_cons, denote_cons, C_mul]
      rw [show denote (List.map (a * ·) p) = C a * denote p from ih]
      ring

@[simp] theorem denote_mul (p q : Poly) : denote (mul p q) = denote p * denote q := by
  induction p with
  | nil => simp [mul]
  | cons a p ih => simp [mul, ih]; ring

@[simp] theorem denote_derivative (p : Poly) : denote (derivative p) = (denote p).derivative := by
  induction p with
  | nil => simp [derivative]
  | cons a p ih =>
      simp [derivative, ih, Polynomial.derivative_mul, add_comm]

@[simp] theorem eval_denote (p : Poly) (x : ℚ) : eval p x = (denote p).eval x := by
  induction p with
  | nil => simp [eval]
  | cons a p ih => simpa [eval] using congrArg (fun v : ℚ => a + x*v) ih

@[simp] theorem eqb_eq_true_iff (p q : Poly) : eqb p q = true ↔ denote p = denote q := by
  simp only [eqb, List.all_eq_true, List.mem_range, decide_eq_true_eq]
  constructor
  · intro h
    ext n
    by_cases hn : n < max p.length q.length
    · exact h n hn
    · simp only [coeff_denote]
      rw [List.getD_eq_default _ _ (by omega), List.getD_eq_default _ _ (by omega)]
  · intro h n hn
    exact congrArg (fun P : ℚ[X] => P.coeff n) h

theorem coeffBound_eq_support_sum (p : Poly) (R : ℚ) :
    coeffBound p R = ∑ i ∈ (denote p).support, |(denote p).coeff i| * R^i := by
  change (∑ i ∈ Finset.range p.length, |p.getD i 0| * R^i) =
    ∑ i ∈ (Finset.range p.length).filter (fun i => p.getD i 0 ≠ 0), |p.getD i 0| * R^i
  rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro i hi
  by_cases h : p.getD i 0 = 0
  · rw [h]; simp only [abs_zero, zero_mul, ne_eq, not_true_eq_false, if_false]
  · simp only [h, ne_eq, not_false_eq_true, if_true]

/-- Every mathematical rational polynomial has a finite dense encoding. This
existence theorem is used only to prove termination of enumeration. -/
theorem exists_encoding (p : ℚ[X]) : ∃ v : Poly, denote v = p := by
  refine ⟨List.ofFn (fun i : Fin (p.natDegree + 1) => p.coeff i), ?_⟩
  ext n
  by_cases hn : n < p.natDegree + 1
  · simp only [coeff_denote]
    rw [List.getD_eq_getElem _ _ (by simpa using hn)]
    exact List.getElem_ofFn _
  · simp only [coeff_denote]
    rw [List.getD_eq_default _ _ (by simp; omega)]
    exact (coeff_eq_zero_of_natDegree_lt (by omega)).symm

/-- Rational identity tests are finite Boolean computations with an exact
reflection theorem; they do not invoke classical polynomial equality. -/
theorem checked_identity (p q : Poly) (h : eqb p q = true) : denote p = denote q :=
  (eqb_eq_true_iff p q).mp h

end C2.CADEffective.Dense


/- ===== C2.CADEffectiveSearch ===== -/

/-! Executable search over an explicitly encoded type. No Countable.choose or
classical decision procedure is introduced: encoding and acceptance are data
arguments. Existence is used only in the erased termination proof of Nat.find. -/
namespace C2.CADEffective

variable {α : Type*} [Encodable α]

def acceptedCode (accept : α → Bool) (n : ℕ) : Bool :=
  (Encodable.decode (α := α) n).any accept

theorem exists_acceptedCode (accept : α → Bool)
    (h : ∃ a, accept a = true) : ∃ n, acceptedCode accept n = true := by
  obtain ⟨a, ha⟩ := h
  exact ⟨Encodable.encode a, by simp [acceptedCode, ha]⟩

def searchIndex (accept : α → Bool) (h : ∃ a, accept a = true) : ℕ :=
  Nat.find (exists_acceptedCode accept h)

theorem searchIndex_accepted (accept : α → Bool) (h : ∃ a, accept a = true) :
    acceptedCode accept (searchIndex accept h) = true :=
  Nat.find_spec (exists_acceptedCode accept h)

theorem searchIndex_le_code (accept : α → Bool) (h : ∃ a, accept a = true)
    (a : α) (ha : accept a = true) : searchIndex accept h ≤ Encodable.encode a := by
  apply Nat.find_min'
  simp [acceptedCode, ha]

theorem searchIndex_minimal (accept : α → Bool) (h : ∃ a, accept a = true)
    {n : ℕ} (hn : n < searchIndex accept h) : acceptedCode accept n = false := by
  have hh := Nat.find_min (exists_acceptedCode accept h) hn
  simpa using hh

def search (accept : α → Bool) (h : ∃ a, accept a = true) : α :=
  (Encodable.decode (α := α) (searchIndex accept h)).get (by
    have hh := searchIndex_accepted accept h
    cases he : Encodable.decode (α := α) (searchIndex accept h) with
    | none => simp [acceptedCode, he] at hh
    | some a => simp)

theorem search_accepted (accept : α → Bool) (h : ∃ a, accept a = true) :
    accept (search accept h) = true := by
  have hh := searchIndex_accepted accept h
  have he : Encodable.decode (α := α) (searchIndex accept h) = some (search accept h) :=
    Option.eq_some_of_isSome _
  simpa only [acceptedCode, he, Option.any_some] using hh

/-- A finite prefix implementation of the same enumeration, returning the first
accepted decoding before the fuel is exhausted. -/
def scanFrom (accept : α → Bool) : ℕ → ℕ → Option α
  | _, 0 => none
  | n, fuel + 1 =>
      match Encodable.decode (α := α) n with
      | none => scanFrom accept (n + 1) fuel
      | some a => if accept a then some a else scanFrom accept (n + 1) fuel

theorem scanFrom_sound (accept : α → Bool) (n fuel : ℕ) {a : α}
    (h : scanFrom accept n fuel = some a) : accept a = true := by
  induction fuel generalizing n with
  | zero => simp [scanFrom] at h
  | succ fuel ih =>
      simp only [scanFrom] at h
      split at h
      · exact ih _ h
      · split at h
        · cases h; assumption
        · exact ih _ h

theorem scanFrom_exists_of_hit (accept : α → Bool) (n fuel : ℕ)
    (h : ∃ j, n ≤ j ∧ j < n + fuel ∧ acceptedCode accept j = true) :
    ∃ a, scanFrom accept n fuel = some a := by
  induction fuel generalizing n with
  | zero => obtain ⟨j, h1, h2, h3⟩ := h; omega
  | succ fuel ih =>
      obtain ⟨j, hnj, hj, ha⟩ := h
      cases he : Encodable.decode (α := α) n with
      | none =>
          have hjne : j ≠ n := by
            intro e; subst j; simp [acceptedCode, he] at ha
          have ht : ∃ a, scanFrom accept (n + 1) fuel = some a :=
            ih (n + 1) ⟨j, by omega, by omega, ha⟩
          simpa [scanFrom, he] using ht
      | some a =>
          by_cases hac : accept a = true
          · exact ⟨a, by simp [scanFrom, he, hac]⟩
          · have hjne : j ≠ n := by
              intro e; subst j; simp [acceptedCode, he, hac] at ha
            have ht : ∃ a, scanFrom accept (n + 1) fuel = some a :=
              ih (n + 1) ⟨j, by omega, by omega, ha⟩
            simpa [scanFrom, he, hac] using ht

theorem search_has_finite_execution (accept : α → Bool) (h : ∃ a, accept a = true) :
    ∃ a, scanFrom accept 0 (searchIndex accept h + 1) = some a ∧ accept a = true := by
  obtain ⟨a, ha⟩ := scanFrom_exists_of_hit accept 0 (searchIndex accept h + 1)
    ⟨searchIndex accept h, Nat.zero_le _, by omega, searchIndex_accepted accept h⟩
  exact ⟨a, ha, scanFrom_sound accept 0 _ ha⟩

end C2.CADEffective


/- ===== C2.CADFactorSquarefree ===== -/

/-! The square-free quotient used in one-parameter CAD preprocessing.
This file proves its mathematical specification. A finite coefficient-list
implementation is a separate executable refinement, not supplied by `noncomputable`.
-/
noncomputable section
open Polynomial
namespace C2.CADFactor

variable {F : Type*} [Field F] [DecidableEq F] [CharZero F]

def squarefreePart (p : F[X]) : F[X] :=
  p / EuclideanDomain.gcd p p.derivative

theorem gcd_derivative_ne_zero {p : F[X]} (hp : p ≠ 0) :
    EuclideanDomain.gcd p p.derivative ≠ 0 := by
  intro h
  have hd := EuclideanDomain.gcd_dvd_left p p.derivative
  rw [h, zero_dvd_iff] at hd
  exact hp hd

theorem gcd_mul_squarefreePart {p : F[X]} (hp : p ≠ 0) :
    EuclideanDomain.gcd p p.derivative * squarefreePart p = p := by
  exact EuclideanDomain.mul_div_cancel' (gcd_derivative_ne_zero hp)
    (EuclideanDomain.gcd_dvd_left p p.derivative)

theorem squarefreePart_ne_zero {p : F[X]} (hp : p ≠ 0) :
    squarefreePart p ≠ 0 := by
  intro h
  have he := gcd_mul_squarefreePart hp
  rw [h, mul_zero] at he
  exact hp he.symm

theorem squarefreePart_dvd (p : F[X]) : squarefreePart p ∣ p := by
  by_cases hp : p = 0
  · simp [hp]
  · exact ⟨EuclideanDomain.gcd p p.derivative, by
      rw [mul_comm, gcd_mul_squarefreePart hp]⟩

theorem dvd_derivative_mul_squarefreePart {p : F[X]} (hp : p ≠ 0) :
    p ∣ p.derivative * squarefreePart p := by
  obtain ⟨r, hr⟩ := EuclideanDomain.gcd_dvd_right p p.derivative
  refine ⟨r, ?_⟩
  calc
    p.derivative * squarefreePart p =
        (EuclideanDomain.gcd p p.derivative * r) * squarefreePart p :=
      congrArg (fun a => a * squarefreePart p) hr
    _ = (EuclideanDomain.gcd p p.derivative * squarefreePart p) * r := by ring
    _ = p * r := by rw [gcd_mul_squarefreePart hp]

theorem isRoot_squarefreePart_iff {p : F[X]} (hp : p ≠ 0) (x : F) :
    (squarefreePart p).IsRoot x ↔ p.IsRoot x := by
  constructor
  · intro hx
    obtain ⟨r, hr⟩ := squarefreePart_dvd p
    rw [Polynomial.IsRoot, hr, Polynomial.eval_mul, hx, zero_mul]
  · intro hx
    exact isRoot_of_isRoot_of_dvd_derivative_mul hp
      (dvd_derivative_mul_squarefreePart hp) hx

theorem squarefreePart_rootMultiplicity_le_one {p : F[X]} (hp : p ≠ 0) (x : F) :
    (squarefreePart p).rootMultiplicity x ≤ 1 := by
  by_cases hx : p.IsRoot x
  · have hg0 := gcd_derivative_ne_zero hp
    have hm : p.rootMultiplicity x =
        (EuclideanDomain.gcd p p.derivative).rootMultiplicity x +
          (squarefreePart p).rootMultiplicity x := by
      calc
        p.rootMultiplicity x =
            (EuclideanDomain.gcd p p.derivative * squarefreePart p).rootMultiplicity x :=
          congrArg (Polynomial.rootMultiplicity x) (gcd_mul_squarefreePart hp).symm
        _ = _ := rootMultiplicity_mul (by rw [gcd_mul_squarefreePart hp]; exact hp)
    have hg : p.rootMultiplicity x - 1 ≤
        (EuclideanDomain.gcd p p.derivative).rootMultiplicity x := by
      apply (le_rootMultiplicity_iff hg0).mpr
      apply EuclideanDomain.dvd_gcd
      · exact (pow_dvd_pow (X - C x) (Nat.sub_le _ _)).trans
          (pow_rootMultiplicity_dvd p x)
      · rw [← derivative_rootMultiplicity_of_root hx]
        exact pow_rootMultiplicity_dvd p.derivative x
    omega
  · have hq : ¬ (squarefreePart p).IsRoot x :=
      fun h => hx ((isRoot_squarefreePart_iff hp x).mp h)
    rw [rootMultiplicity_eq_zero hq]
    exact Nat.zero_le _

theorem squarefreePart_map {E : Type*} [Field E] [DecidableEq E] [CharZero E]
    (f : F →+* E) (p : F[X]) :
    (squarefreePart p).map f = squarefreePart (p.map f) := by
  simp only [squarefreePart, Polynomial.map_div, ← Polynomial.gcd_map,
    Polynomial.derivative_map]

theorem squarefreePart_separable {p : F[X]} (hp : p ≠ 0) :
    (squarefreePart p).Separable := by
  classical
  let E := AlgebraicClosure F
  let f : F →+* E := algebraMap F E
  have hp' : p.map f ≠ 0 := Polynomial.map_ne_zero hp
  have hq' : squarefreePart (p.map f) ≠ 0 := squarefreePart_ne_zero hp'
  have hs : (squarefreePart (p.map f)).Separable := by
    apply (nodup_roots_iff_of_splits hq' (IsAlgClosed.splits _)).mp
    rw [Multiset.nodup_iff_count_le_one]
    intro x
    rw [Polynomial.count_roots]
    exact squarefreePart_rootMultiplicity_le_one hp' x
  rw [← squarefreePart_map f p] at hs
  exact (Polynomial.separable_map f).mp hs

theorem squarefreePart_natDegree_le {p : F[X]} (hp : p ≠ 0) :
    (squarefreePart p).natDegree ≤ p.natDegree :=
  Polynomial.natDegree_le_of_dvd (squarefreePart_dvd p) hp

theorem squarefreePart_eval₂_zero_iff {E : Type*} [Field E] [DecidableEq E] [CharZero E]
    (f : F →+* E) {p : F[X]} (hp : p ≠ 0) (x : E) :
    (squarefreePart p).eval₂ f x = 0 ↔ p.eval₂ f x = 0 := by
  have h := isRoot_squarefreePart_iff (Polynomial.map_ne_zero (f:=f) hp) x
  rw [← squarefreePart_map f p] at h
  simpa only [Polynomial.IsRoot, Polynomial.eval_map] using h

/-- Root preservation is an algebraic witness property, independent of the
particular quotient used to obtain the witnesses. -/
theorem isRoot_iff_of_reduction_witnesses {p q : F[X]} (hp : p ≠ 0)
    (hqp : q ∣ p) (hpq : p ∣ p.derivative * q) (x : F) :
    q.IsRoot x ↔ p.IsRoot x := by
  constructor
  · intro hx
    obtain ⟨r, hr⟩ := hqp
    rw [Polynomial.IsRoot, hr, Polynomial.eval_mul, hx, zero_mul]
  · exact isRoot_of_isRoot_of_dvd_derivative_mul hp hpq

/-- The same checked identities preserve zeros after any field embedding. -/
theorem eval₂_zero_iff_of_reduction_witnesses
    {E : Type*} [Field E] [CharZero E] (f : F →+* E)
    {p q : F[X]} (hp : p ≠ 0) (hqp : q ∣ p) (hpq : p ∣ p.derivative * q) (x : E) :
    q.eval₂ f x = 0 ↔ p.eval₂ f x = 0 := by
  classical
  have hqpm := Polynomial.map_dvd f hqp
  have hpqm : p.map f ∣ (p.map f).derivative * q.map f := by
    simpa only [Polynomial.map_mul, Polynomial.derivative_map] using Polynomial.map_dvd f hpq
  simpa only [Polynomial.IsRoot, Polynomial.eval_map] using
    isRoot_iff_of_reduction_witnesses (Polynomial.map_ne_zero hp) hqpm hpqm x

/-- Every nonzero polynomial has finite square-free reduction data whose
correctness is checked solely by the displayed polynomial identities. -/
theorem exists_squarefree_reduction_witnesses (p : F[X]) (hp : p ≠ 0) :
    ∃ q g h u v : F[X],
      p = g*q ∧ p.derivative*q = p*h ∧ u*q + v*q.derivative = 1 := by
  let q := squarefreePart p
  obtain ⟨h, hh⟩ := dvd_derivative_mul_squarefreePart hp
  obtain ⟨u,v,huv⟩ := (Polynomial.separable_def _).mp (squarefreePart_separable hp)
  exact ⟨q, EuclideanDomain.gcd p p.derivative, h,u,v,
    (gcd_mul_squarefreePart hp).symm, hh, huv⟩

/-- Soundness of the coefficient-identity checks used by an executable
finite-data search. Neither roots nor separability are assumed. -/
theorem squarefree_reduction_witnesses_sound
    {p q g h u v : F[X]} (hp : p ≠ 0)
    (hpg : p = g*q) (hph : p.derivative*q = p*h)
    (huv : u*q + v*q.derivative = 1) :
    q.Separable ∧ q ≠ 0 ∧
      ∀ {E : Type*} [Field E] [CharZero E] (f : F →+* E) (x : E),
        q.eval₂ f x = 0 ↔ p.eval₂ f x = 0 := by
  have hq0 : q ≠ 0 := by
    intro hq
    apply hp
    rw [hpg,hq,mul_zero]
  have hqp : q ∣ p := ⟨g, by rw [hpg,mul_comm]⟩
  have hpq : p ∣ p.derivative*q := ⟨h,hph⟩
  exact ⟨(Polynomial.separable_def _).mpr ⟨u,v,huv⟩, hq0,
    fun f x => eval₂_zero_iff_of_reduction_witnesses f hp hqp hpq x⟩

end C2.CADFactor

end

/- ===== C2.CADEffectiveSquarefree ===== -/

/-! A genuinely executable square-free reducer. It enumerates five dense
rational polynomials and checks three identities. Mathematical gcds prove
existence of accepted data but are not called by the extracted algorithm. -/
namespace C2.CADEffective.Dense
open Polynomial

abbrev ReductionData := Poly × Poly × Poly × Poly × Poly

def reductionCheck (p : Poly) (w : ReductionData) : Bool :=
  eqb p (mul w.2.1 w.1) &&
    eqb (mul (derivative p) w.1) (mul p w.2.2.1) &&
      eqb (add (mul w.2.2.2.1 w.1) (mul w.2.2.2.2 (derivative w.1))) [1]

theorem reductionCheck_iff (p : Poly) (w : ReductionData) :
    reductionCheck p w = true ↔
      (denote p = denote w.2.1 * denote w.1 ∧
        (denote p).derivative * denote w.1 = denote p * denote w.2.2.1) ∧
      denote w.2.2.2.1 * denote w.1 +
        denote w.2.2.2.2 * (denote w.1).derivative = 1 := by
  simp [reductionCheck, Bool.and_eq_true, eqb_eq_true_iff]

theorem exists_reductionCheck (p : Poly) (hp : denote p ≠ 0) :
    ∃ w : ReductionData, reductionCheck p w = true := by
  obtain ⟨q,g,h,u,v,hp1,hp2,hp3⟩ := C2.CADFactor.exists_squarefree_reduction_witnesses (denote p) hp
  obtain ⟨q',hq'⟩ := exists_encoding q
  obtain ⟨g',hg'⟩ := exists_encoding g
  obtain ⟨h',hh'⟩ := exists_encoding h
  obtain ⟨u',hu'⟩ := exists_encoding u
  obtain ⟨v',hv'⟩ := exists_encoding v
  refine ⟨(q',g',h',u',v'), (reductionCheck_iff _ _).mpr ?_⟩
  simpa only [hq',hg',hh',hu',hv'] using And.intro (And.intro hp1 hp2) hp3

def produceReduction (p : Poly) (hp : denote p ≠ 0) : ReductionData :=
  C2.CADEffective.search (reductionCheck p) (exists_reductionCheck p hp)

theorem produceReduction_accepted (p : Poly) (hp : denote p ≠ 0) :
    reductionCheck p (produceReduction p hp) = true :=
  C2.CADEffective.search_accepted _ _

def reducedPoly (p : Poly) (hp : denote p ≠ 0) : Poly := (produceReduction p hp).1

theorem reductionCheck_sound (p : Poly) (hp : denote p ≠ 0) (w : ReductionData)
    (hw : reductionCheck p w = true) :
    (denote w.1).Separable ∧ denote w.1 ≠ 0 ∧
      ∀ {E : Type*} [Field E] [CharZero E] (f : ℚ →+* E) (x : E),
        (denote w.1).eval₂ f x = 0 ↔ (denote p).eval₂ f x = 0 := by
  obtain ⟨⟨hpg,hph⟩,huv⟩ := (reductionCheck_iff _ _).mp hw
  exact C2.CADFactor.squarefree_reduction_witnesses_sound hp hpg hph huv

theorem reducedPoly_correct (p : Poly) (hp : denote p ≠ 0) :
    (denote (reducedPoly p hp)).Separable ∧ denote (reducedPoly p hp) ≠ 0 ∧
      ∀ {E : Type*} [Field E] [CharZero E] (f : ℚ →+* E) (x : E),
        (denote (reducedPoly p hp)).eval₂ f x = 0 ↔ (denote p).eval₂ f x = 0 :=
  reductionCheck_sound p hp _ (produceReduction_accepted p hp)

theorem produceReduction_finite_execution (p : Poly) (hp : denote p ≠ 0) :
    ∃ fuel w, C2.CADEffective.scanFrom (reductionCheck p) 0 fuel = some w ∧
      reductionCheck p w = true := by
  obtain ⟨w,hw,hc⟩ := C2.CADEffective.search_has_finite_execution
    (reductionCheck p) (exists_reductionCheck p hp)
  exact ⟨_,w,hw,hc⟩

end C2.CADEffective.Dense


/- ===== C2.CADIsolationBounds ===== -/

/-! Effective rational coefficient enclosures for a general real polynomial.
These estimates support a dyadic root-isolation procedure; no root oracle occurs
in the definitions. -/
namespace C2.CADIsolation
open Polynomial Set

/-- Evaluation through the canonical rational-to-real embedding. -/
noncomputable def realEval (p : ℚ[X]) (x : ℝ) : ℝ := p.eval₂ (algebraMap ℚ ℝ) x

/-- A computable coefficient one-norm bound at radius `R`. -/
def coeffBound (p : ℚ[X]) (R : ℚ) : ℚ :=
  ∑ i ∈ p.support, |p.coeff i| * R^i

@[simp] theorem realEval_rat (p : ℚ[X]) (x : ℚ) :
    realEval p (x:ℝ) = ((p.eval x : ℚ) : ℝ) := by
  exact Polynomial.eval₂_at_apply (algebraMap ℚ ℝ) x

theorem realEval_continuous (p : ℚ[X]) : Continuous (realEval p) :=
  p.continuous_eval₂ _

theorem coeffBound_nonneg (p : ℚ[X]) {R : ℚ} (hR : 0 ≤ R) :
    0 ≤ coeffBound p R := by
  exact Finset.sum_nonneg (fun i hi => mul_nonneg (abs_nonneg _) (pow_nonneg hR _))

theorem abs_realEval_le_coeffBound (p : ℚ[X]) {R : ℚ} (hR : 0 ≤ R)
    {x : ℝ} (hx : |x| ≤ (R:ℝ)) :
    |realEval p x| ≤ (coeffBound p R : ℝ) := by
  rw [realEval, Polynomial.eval₂_eq_sum, Polynomial.sum_def]
  calc
    |∑ i ∈ p.support, (algebraMap ℚ ℝ) (p.coeff i) * x^i| ≤
        ∑ i ∈ p.support, |(algebraMap ℚ ℝ) (p.coeff i) * x^i| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i ∈ p.support, |(p.coeff i : ℝ)| * (R:ℝ)^i := by
      apply Finset.sum_le_sum
      intro i hi
      change |(p.coeff i:ℝ) * x^i| ≤ |(p.coeff i:ℝ)| * (R:ℝ)^i
      rw [abs_mul, abs_pow]
      exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (abs_nonneg _) hx _) (abs_nonneg _)
    _ = (coeffBound p R : ℝ) := by
      simp only [coeffBound, Rat.cast_sum, Rat.cast_mul, Rat.cast_abs, Rat.cast_pow]

theorem realEval_hasDerivAt (p : ℚ[X]) (x : ℝ) :
    HasDerivAt (realEval p) (realEval p.derivative x) x := by
  have hfun : realEval p = fun z => (p.map (algebraMap ℚ ℝ)).eval z := by
    funext z
    exact Polynomial.eval₂_eq_eval_map _
  rw [hfun]
  simpa only [realEval, Polynomial.eval₂_eq_eval_map, Polynomial.derivative_map] using
    (p.map (algebraMap ℚ ℝ)).hasDerivAt x

/-- Radius enclosing a rational interval, with a spare unit. -/
def intervalRadius (a b : ℚ) : ℚ := max |a| |b| + 1

theorem intervalRadius_pos (a b : ℚ) : 0 < intervalRadius a b := by
  have h := le_max_left |a| |b|
  have ha := abs_nonneg a
  dsimp [intervalRadius]
  linarith

theorem abs_le_intervalRadius {a b : ℚ} {x : ℝ}
    (hx : x ∈ Icc (a:ℝ) (b:ℝ)) : |x| ≤ (intervalRadius a b : ℝ) := by
  rw [abs_le]
  have ha : |(a:ℝ)| ≤ (intervalRadius a b : ℝ) := by
    exact_mod_cast (show |a| ≤ intervalRadius a b by dsimp [intervalRadius]; linarith [le_max_left |a| |b|])
  have hb : |(b:ℝ)| ≤ (intervalRadius a b : ℝ) := by
    exact_mod_cast (show |b| ≤ intervalRadius a b by dsimp [intervalRadius]; linarith [le_max_right |a| |b|])
  exact ⟨(neg_le_of_abs_le ha).trans hx.1, hx.2.trans (le_of_abs_le hb)⟩

/-- Explicit Lipschitz bound on any rational closed interval. -/
theorem realEval_sub_le (p : ℚ[X]) (a b : ℚ) {x y : ℝ}
    (hx : x ∈ Icc (a:ℝ) (b:ℝ)) (hy : y ∈ Icc (a:ℝ) (b:ℝ)) :
    |realEval p y - realEval p x| ≤
      (coeffBound p.derivative (intervalRadius a b) : ℝ) * |y-x| := by
  have hb : ∀ z ∈ Icc (a:ℝ) (b:ℝ), ‖realEval p.derivative z‖ ≤
      (coeffBound p.derivative (intervalRadius a b) : ℝ) := by
    intro z hz
    rw [Real.norm_eq_abs]
    exact abs_realEval_le_coeffBound p.derivative (intervalRadius_pos a b).le
      (abs_le_intervalRadius hz)
  have h := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
    (fun z (_ : z ∈ Icc (a:ℝ) (b:ℝ)) => (realEval_hasDerivAt p z).hasDerivWithinAt)
    hb (convex_Icc (a:ℝ) (b:ℝ)) hx hy
  simpa only [Real.norm_eq_abs] using h

end C2.CADIsolation


/- ===== C2.CADIsolationCells ===== -/

/-! Rational cell tests for root isolation. Analytic meaning is separated from
any dense-polynomial executable representation. -/
namespace C2.CADIsolation
open Polynomial Set

noncomputable def slopeBound (p : ℚ[X]) (a b : ℚ) : ℚ :=
  1 + coeffBound p.derivative (intervalRadius a b) +
    coeffBound p.derivative.derivative (intervalRadius a b)

def midpoint (l u : ℚ) : ℚ := (l+u)/2

noncomputable def zeroFreeTest (p : ℚ[X]) (a b l u : ℚ) : Prop :=
  slopeBound p a b * (u-l) < |p.eval (midpoint l u)|

noncomputable def monotoneTest (p : ℚ[X]) (a b l u : ℚ) : Prop :=
  slopeBound p a b * (u-l) < |p.derivative.eval (midpoint l u)|

noncomputable def certifiedCell (p : ℚ[X]) (a b l u : ℚ) : Prop :=
  zeroFreeTest p a b l u ∨ monotoneTest p a b l u

theorem slopeBound_pos (p : ℚ[X]) (a b : ℚ) : 0 < slopeBound p a b := by
  have h₁ := coeffBound_nonneg p.derivative (intervalRadius_pos a b).le
  have h₂ := coeffBound_nonneg p.derivative.derivative (intervalRadius_pos a b).le
  dsimp [slopeBound]
  linarith

theorem derivative_bound_le (p : ℚ[X]) (a b : ℚ) :
    coeffBound p.derivative (intervalRadius a b) ≤ slopeBound p a b := by
  have h := coeffBound_nonneg p.derivative.derivative (intervalRadius_pos a b).le
  dsimp [slopeBound]
  linarith

theorem second_derivative_bound_le (p : ℚ[X]) (a b : ℚ) :
    coeffBound p.derivative.derivative (intervalRadius a b) ≤ slopeBound p a b := by
  have h := coeffBound_nonneg p.derivative (intervalRadius_pos a b).le
  dsimp [slopeBound]
  linarith

theorem midpoint_mem {l u : ℚ} (hlu : l ≤ u) :
    (midpoint l u : ℝ) ∈ Icc (l:ℝ) (u:ℝ) := by
  have h : (l:ℝ) ≤ (u:ℝ) := by exact_mod_cast hlu
  dsimp [midpoint]
  push_cast
  constructor <;> linarith

theorem midpoint_distance {l u : ℚ} (hlu : l ≤ u) {x : ℝ}
    (hx : x ∈ Icc (l:ℝ) (u:ℝ)) :
    |x-(midpoint l u:ℝ)| ≤ ((u-l:ℚ):ℝ) := by
  have h := midpoint_mem hlu
  rw [abs_le]
  push_cast
  constructor <;> linarith [h.1,h.2,hx.1,hx.2]

theorem variation_in_cell (p : ℚ[X]) {a b l u B : ℚ}
    (hal : a ≤ l) (hlu : l ≤ u) (hub : u ≤ b)
    (hB : coeffBound p.derivative (intervalRadius a b) ≤ B)
    (hB0 : 0 ≤ B) {x : ℝ} (hx : x ∈ Icc (l:ℝ) (u:ℝ)) :
    |realEval p x - realEval p (midpoint l u:ℝ)| ≤ (B:ℝ)*((u-l:ℚ):ℝ) := by
  have hal' : (a:ℝ) ≤ (l:ℝ) := by exact_mod_cast hal
  have hub' : (u:ℝ) ≤ (b:ℝ) := by exact_mod_cast hub
  have hm := midpoint_mem hlu
  have hvar := realEval_sub_le p a b
    (show (midpoint l u:ℝ) ∈ Icc (a:ℝ) (b:ℝ) from ⟨hal'.trans hm.1,hm.2.trans hub'⟩)
    (show x ∈ Icc (a:ℝ) (b:ℝ) from ⟨hal'.trans hx.1,hx.2.trans hub'⟩)
  have hB' : (coeffBound p.derivative (intervalRadius a b):ℝ) ≤ (B:ℝ) := by exact_mod_cast hB
  have hB0' : (0:ℝ) ≤ (B:ℝ) := by exact_mod_cast hB0
  exact hvar.trans ((mul_le_mul_of_nonneg_right hB' (abs_nonneg _)).trans
    (mul_le_mul_of_nonneg_left (midpoint_distance hlu hx) hB0'))

/-- The exact rational zero-free test excludes every real root in the cell. -/
theorem zeroFreeTest_sound (p : ℚ[X]) {a b l u : ℚ}
    (hal : a ≤ l) (hlu : l ≤ u) (hub : u ≤ b)
    (ht : zeroFreeTest p a b l u) :
    ∀ x ∈ Icc (l:ℝ) (u:ℝ), realEval p x ≠ 0 := by
  intro x hx hz
  have hv := variation_in_cell p hal hlu hub (derivative_bound_le p a b)
    (slopeBound_pos p a b).le hx
  have ht' : (slopeBound p a b:ℝ)*((u-l:ℚ):ℝ) < |realEval p (midpoint l u:ℝ)| := by
    rw [realEval_rat]
    exact_mod_cast ht
  rw [hz,zero_sub,abs_neg] at hv
  exact (not_lt_of_ge hv) ht'

/-- The derivative test supplies its sign on the entire cell. -/
theorem monotoneTest_derivative_sign (p : ℚ[X]) {a b l u : ℚ}
    (hal : a ≤ l) (hlu : l ≤ u) (hub : u ≤ b)
    (ht : monotoneTest p a b l u) :
    (∀ x ∈ Icc (l:ℝ) (u:ℝ), 0 < realEval p.derivative x) ∨
      (∀ x ∈ Icc (l:ℝ) (u:ℝ), realEval p.derivative x < 0) := by
  have ht' : (slopeBound p a b:ℝ)*((u-l:ℚ):ℝ) <
      |realEval p.derivative (midpoint l u:ℝ)| := by
    rw [realEval_rat]
    exact_mod_cast ht
  have hwidth : (0:ℝ) ≤ ((u-l:ℚ):ℝ) := by exact_mod_cast sub_nonneg.mpr hlu
  have hB : (0:ℝ) ≤ (slopeBound p a b:ℝ) := by exact_mod_cast (slopeBound_pos p a b).le
  have hc : realEval p.derivative (midpoint l u:ℝ) ≠ 0 := by
    intro h
    rw [h,abs_zero] at ht'
    exact (not_lt_of_ge (mul_nonneg hB hwidth)) ht'
  rcases lt_or_gt_of_ne hc with hc | hc
  · right
    intro x hx
    have hv := variation_in_cell p.derivative hal hlu hub
      (second_derivative_bound_le p a b) (slopeBound_pos p a b).le hx
    have hv' := (abs_le.mp hv).2
    rw [abs_of_neg hc] at ht'
    linarith
  · left
    intro x hx
    have hv := variation_in_cell p.derivative hal hlu hub
      (second_derivative_bound_le p a b) (slopeBound_pos p a b).le hx
    have hv' := (abs_le.mp hv).1
    rw [abs_of_pos hc] at ht'
    linarith

/-- Accepted derivative cells are genuinely strictly monotone. -/
theorem monotoneTest_sound (p : ℚ[X]) {a b l u : ℚ}
    (hal : a ≤ l) (hlu : l ≤ u) (hub : u ≤ b)
    (ht : monotoneTest p a b l u) :
    StrictMonoOn (realEval p) (Icc (l:ℝ) (u:ℝ)) ∨
      StrictAntiOn (realEval p) (Icc (l:ℝ) (u:ℝ)) := by
  rcases monotoneTest_derivative_sign p hal hlu hub ht with hp | hn
  · left
    apply strictMonoOn_of_deriv_pos (convex_Icc _ _) (realEval_continuous p).continuousOn
    intro x hx
    rw [(realEval_hasDerivAt p x).deriv]
    exact hp x (interior_subset hx)
  · right
    apply strictAntiOn_of_deriv_neg (convex_Icc _ _) (realEval_continuous p).continuousOn
    intro x hx
    rw [(realEval_hasDerivAt p x).deriv]
    exact hn x (interior_subset hx)

/-- Every accepted cell contains at most one distinct real root. -/
theorem certifiedCell_at_most_one (p : ℚ[X]) {a b l u : ℚ}
    (hal : a ≤ l) (hlu : l ≤ u) (hub : u ≤ b)
    (ht : certifiedCell p a b l u) {x y : ℝ}
    (hx : x ∈ Icc (l:ℝ) (u:ℝ)) (hy : y ∈ Icc (l:ℝ) (u:ℝ))
    (hpx : realEval p x = 0) (hpy : realEval p y = 0) : x = y := by
  rcases ht with hz | hm
  · exact (zeroFreeTest_sound p hal hlu hub hz x hx hpx).elim
  · rcases monotoneTest_sound p hal hlu hub hm with h | h
    · exact h.injOn hx hy (hpx.trans hpy.symm)
    · exact h.injOn hx hy (hpx.trans hpy.symm)

end C2.CADIsolation


/- ===== C2.CADIsolationMesh ===== -/

/-! An eventually accepted rational dyadic mesh for every polynomial with
simple roots on the requested compact interval. -/
namespace C2.CADIsolation
open Polynomial Set Filter
open scoped Topology

def gridPoint (a b : ℚ) (n i : ℕ) : ℚ := a + (b-a)*(i:ℚ)/(2:ℚ)^n

def meshWidth (a b : ℚ) (n : ℕ) : ℚ := (b-a)/(2:ℚ)^n

noncomputable def certifiedMesh (p : ℚ[X]) (a b : ℚ) (n : ℕ) : Prop :=
  ∀ i ∈ Finset.range (2^n),
    certifiedCell p a b (gridPoint a b n i) (gridPoint a b n (i+1))

@[simp] theorem gridPoint_zero (a b : ℚ) (n : ℕ) : gridPoint a b n 0 = a := by
  simp [gridPoint]

@[simp] theorem gridPoint_last (a b : ℚ) (n : ℕ) : gridPoint a b n (2^n) = b := by
  have h : (2:ℚ)^n ≠ 0 := pow_ne_zero _ (by norm_num)
  simp only [gridPoint,Nat.cast_pow,Nat.cast_ofNat]
  field_simp
  <;> ring

theorem gridPoint_step_width (a b : ℚ) (n i : ℕ) :
    gridPoint a b n (i+1) - gridPoint a b n i = meshWidth a b n := by
  simp only [gridPoint,meshWidth,Nat.cast_add,Nat.cast_one]
  ring

theorem gridPoint_mono {a b : ℚ} (hab : a ≤ b) (n : ℕ) :
    Monotone (gridPoint a b n) := by
  intro i j hij
  dsimp [gridPoint]
  exact add_le_add_left (div_le_div_of_nonneg_right
    (mul_le_mul_of_nonneg_left (by exact_mod_cast hij) (sub_nonneg.mpr hab))
    (pow_nonneg (by norm_num) n)) a

theorem gridPoint_mem {a b : ℚ} (hab : a ≤ b) {n i : ℕ} (hi : i ≤ 2^n) :
    a ≤ gridPoint a b n i ∧ gridPoint a b n i ≤ b := by
  constructor
  · simpa using gridPoint_mono hab n (Nat.zero_le i)
  · simpa using gridPoint_mono hab n hi

theorem grid_cell_bounds {a b : ℚ} (hab : a ≤ b) {n i : ℕ} (hi : i < 2^n) :
    a ≤ gridPoint a b n i ∧
    gridPoint a b n i ≤ gridPoint a b n (i+1) ∧
    gridPoint a b n (i+1) ≤ b := by
  exact ⟨(gridPoint_mem hab hi.le).1,gridPoint_mono hab n (Nat.le_succ i),
    (gridPoint_mem hab (Nat.succ_le_iff.mpr hi)).2⟩

theorem meshWidth_cast (a b : ℚ) (n : ℕ) :
    (meshWidth a b n : ℝ) = ((b:ℝ)-(a:ℝ))*(1/2:ℝ)^n := by
  simp only [meshWidth,Rat.cast_div,Rat.cast_sub,Rat.cast_pow,Rat.cast_ofNat]
  rw [div_pow,one_pow]
  ring

theorem meshWidth_tendsto_zero (a b : ℚ) :
    Tendsto (fun n => (meshWidth a b n : ℝ)) atTop (𝓝 0) := by
  simp_rw [meshWidth_cast]
  simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one
    (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num : (1/2:ℝ) < 1)).const_mul ((b:ℝ)-(a:ℝ))

/-- Compactness supplies a strictly positive separation from simultaneous
vanishing. This is an existence proof used only to prove search termination. -/
theorem exists_positive_separation (p : ℚ[X]) (a b : ℚ)
    (hs : ∀ x ∈ Icc (a:ℝ) (b:ℝ), realEval p x ≠ 0 ∨ realEval p.derivative x ≠ 0) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ x ∈ Icc (a:ℝ) (b:ℝ),
      δ ≤ |realEval p x| + |realEval p.derivative x| := by
  apply isCompact_Icc.exists_forall_le'
    (((realEval_continuous p).abs.add (realEval_continuous p.derivative).abs).continuousOn)
  intro x hx
  rcases hs x hx with hp | hd
  · exact add_pos_of_pos_of_nonneg (abs_pos.mpr hp) (abs_nonneg _)
  · exact add_pos_of_nonneg_of_pos (abs_nonneg _) (abs_pos.mpr hd)

/-- Every sufficiently fine dyadic mesh passes the exact rational tests.
The input only requires simple real roots on this interval; it does not
assume an isolator output, a root count, or a sign-invariant partition. -/
theorem certifiedMesh_eventually (p : ℚ[X]) {a b : ℚ} (hab : a ≤ b)
    (hs : ∀ x ∈ Icc (a:ℝ) (b:ℝ), realEval p x ≠ 0 ∨ realEval p.derivative x ≠ 0) :
    ∃ N : ℕ, ∀ n ≥ N, certifiedMesh p a b n := by
  obtain ⟨δ,hδ,hsep⟩ := exists_positive_separation p a b hs
  have hlim : Tendsto (fun n => 2*(slopeBound p a b:ℝ)*(meshWidth a b n:ℝ))
      atTop (𝓝 0) := by
    simpa using (meshWidth_tendsto_zero a b).const_mul (2*(slopeBound p a b:ℝ))
  obtain ⟨N,hN⟩ := eventually_atTop.mp (hlim.eventually (gt_mem_nhds hδ))
  refine ⟨N,fun n hn i hi => ?_⟩
  have hb := grid_cell_bounds hab (Finset.mem_range.mp hi)
  let l := gridPoint a b n i
  let u := gridPoint a b n (i+1)
  have hm := midpoint_mem hb.2.1
  have hal : (a:ℝ) ≤ (l:ℝ) := by exact_mod_cast hb.1
  have hub : (u:ℝ) ≤ (b:ℝ) := by exact_mod_cast hb.2.2
  have hsep' := hsep (midpoint l u:ℝ) ⟨hal.trans hm.1,hm.2.trans hub⟩
  change certifiedCell p a b l u
  by_contra hfail
  have h₁ : |p.eval (midpoint l u)| ≤ slopeBound p a b * (u-l) := by
    apply le_of_not_gt
    intro h
    exact hfail (Or.inl h)
  have h₂ : |p.derivative.eval (midpoint l u)| ≤ slopeBound p a b * (u-l) := by
    apply le_of_not_gt
    intro h
    exact hfail (Or.inr h)
  have h₁' : |realEval p (midpoint l u:ℝ)| ≤
      (slopeBound p a b:ℝ)*((u-l:ℚ):ℝ) := by
    rw [realEval_rat]
    exact_mod_cast h₁
  have h₂' : |realEval p.derivative (midpoint l u:ℝ)| ≤
      (slopeBound p a b:ℝ)*((u-l:ℚ):ℝ) := by
    rw [realEval_rat]
    exact_mod_cast h₂
  have hw : u-l = meshWidth a b n := gridPoint_step_width a b n i
  rw [hw] at h₁' h₂'
  have hsmall := hN n hn
  linarith

/-- Existence of an accepted finite mesh, the hypothesis needed by an
executable least-index search with a decidable dense rational checker. -/
theorem exists_certifiedMesh (p : ℚ[X]) {a b : ℚ} (hab : a ≤ b)
    (hs : ∀ x ∈ Icc (a:ℝ) (b:ℝ), realEval p x ≠ 0 ∨ realEval p.derivative x ≠ 0) :
    ∃ n, certifiedMesh p a b n := by
  obtain ⟨N,hN⟩ := certifiedMesh_eventually p hab hs
  exact ⟨N,hN N le_rfl⟩

end C2.CADIsolation


/- ===== C2.CADIsolationOutput ===== -/

/-! Completeness and separation of root points and open isolating cells.
The selectors use only exact rational evaluations. -/
namespace C2.CADIsolation
open Polynomial Set

theorem gridPoint_strictMono {a b : ℚ} (hab : a < b) (n : ℕ) :
    StrictMono (gridPoint a b n) := by
  intro i j hij
  dsimp [gridPoint]
  exact add_lt_add_left (div_lt_div_of_pos_right
    (mul_lt_mul_of_pos_left (by exact_mod_cast hij) (sub_pos.mpr hab))
    (pow_pos (by norm_num) n)) a

/-- Successive cells of a finite monotone grid cover its whole interval. -/
theorem successive_cells_cover (v : ℕ → ℝ) (hm : Monotone v) (N : ℕ)
    (hN : 0 < N) {x : ℝ} (hx : x ∈ Icc (v 0) (v N)) :
    ∃ i < N, x ∈ Icc (v i) (v (i+1)) := by
  induction N with
  | zero => omega
  | succ N ih =>
    by_cases hzero : N = 0
    · subst N
      exact ⟨0,by omega,hx⟩
    by_cases hle : x ≤ v N
    · obtain ⟨i,hi,hcell⟩ := ih (by omega) ⟨hx.1,hle⟩
      exact ⟨i,by omega,hcell⟩
    · exact ⟨N,Nat.lt_succ_self N,⟨(lt_of_not_ge hle).le,hx.2⟩⟩

theorem grid_cells_cover {a b : ℚ} (hab : a ≤ b) (n : ℕ) {x : ℝ}
    (hx : x ∈ Icc (a:ℝ) (b:ℝ)) :
    ∃ i < 2^n, x ∈ Icc (gridPoint a b n i:ℝ) (gridPoint a b n (i+1):ℝ) := by
  apply successive_cells_cover (fun i => (gridPoint a b n i:ℝ))
    (fun i j hij => by
      change (gridPoint a b n i:ℝ) ≤ (gridPoint a b n j:ℝ)
      exact_mod_cast gridPoint_mono hab n hij) (2^n) (by positivity)
  simpa using hx

/-- Exact endpoint sign tests characterize open-cell roots after certification. -/
theorem root_in_cell_iff_crossing (p : ℚ[X]) {a b l u : ℚ}
    (hal : a ≤ l) (hlu : l < u) (hub : u ≤ b)
    (ht : certifiedCell p a b l u) :
    (∃ x ∈ Ioo (l:ℝ) (u:ℝ), realEval p x = 0) ↔ p.eval l * p.eval u < 0 := by
  have hlu' : (l:ℝ) < (u:ℝ) := by exact_mod_cast hlu
  constructor
  · rintro ⟨x,hx,hpx⟩
    rcases ht with hz | hm
    · exact (zeroFreeTest_sound p hal hlu.le hub hz x ⟨hx.1.le,hx.2.le⟩ hpx).elim
    · have hp : realEval p (l:ℝ) * realEval p (u:ℝ) < 0 := by
        rcases monotoneTest_sound p hal hlu.le hub hm with h | h
        · have hl := h (left_mem_Icc.mpr hlu'.le) ⟨hx.1.le,hx.2.le⟩ hx.1
          have hu := h ⟨hx.1.le,hx.2.le⟩ (right_mem_Icc.mpr hlu'.le) hx.2
          rw [hpx] at hl hu
          exact mul_neg_of_neg_of_pos hl hu
        · have hl := h (left_mem_Icc.mpr hlu'.le) ⟨hx.1.le,hx.2.le⟩ hx.1
          have hu := h ⟨hx.1.le,hx.2.le⟩ (right_mem_Icc.mpr hlu'.le) hx.2
          rw [hpx] at hl hu
          exact mul_neg_of_pos_of_neg hl hu
      rw [realEval_rat,realEval_rat] at hp
      exact_mod_cast hp
  · intro hp
    have hp' : realEval p (l:ℝ) * realEval p (u:ℝ) < 0 := by
      rw [realEval_rat,realEval_rat]
      exact_mod_cast hp
    have hcont : ContinuousOn (realEval p) (Icc (l:ℝ) (u:ℝ)) := (realEval_continuous p).continuousOn
    have hroot : ∃ x ∈ Icc (l:ℝ) (u:ℝ), realEval p x = 0 := by
      rcases mul_neg_iff.mp hp' with h | h
      · exact intermediate_value_Icc' hlu'.le hcont ⟨h.2.le,h.1.le⟩
      · exact intermediate_value_Icc hlu'.le hcont ⟨h.1.le,h.2.le⟩
    obtain ⟨x,hx,hpx⟩ := hroot
    refine ⟨x,⟨?_,?_⟩,hpx⟩
    · by_contra hn
      have he : x = (l:ℝ) := le_antisymm (not_lt.mp hn) hx.1
      rw [he] at hpx
      rw [hpx,zero_mul] at hp'
      exact (lt_irrefl 0) hp'
    · by_contra hn
      have he : x = (u:ℝ) := le_antisymm hx.2 (not_lt.mp hn)
      rw [he] at hpx
      rw [hpx,mul_zero] at hp'
      exact (lt_irrefl 0) hp'

/-- A selected open cell isolates exactly one distinct real root. -/
theorem selected_cell_unique_root (p : ℚ[X]) {a b l u : ℚ}
    (hal : a ≤ l) (hlu : l < u) (hub : u ≤ b)
    (ht : certifiedCell p a b l u) (hp : p.eval l*p.eval u < 0) :
    ∃! x, x ∈ Ioo (l:ℝ) (u:ℝ) ∧ realEval p x = 0 := by
  obtain ⟨x,hx,hpx⟩ := (root_in_cell_iff_crossing p hal hlu hub ht).mpr hp
  refine ⟨x,⟨hx,hpx⟩,fun y hy => ?_⟩
  exact certifiedCell_at_most_one p hal hlu.le hub ht
    ⟨hy.1.1.le,hy.1.2.le⟩ ⟨hx.1.le,hx.2.le⟩ hy.2 hpx

/-- Output selectors: rational root points and intervals with opposite signs. -/
noncomputable def selectedPoint (p : ℚ[X]) (a b : ℚ) (n j : ℕ) : Prop :=
  j ≤ 2^n ∧ p.eval (gridPoint a b n j) = 0

noncomputable def selectedInterval (p : ℚ[X]) (a b : ℚ) (n i : ℕ) : Prop :=
  i < 2^n ∧ p.eval (gridPoint a b n i) * p.eval (gridPoint a b n (i+1)) < 0

/-- Every real root in the target interval occurs in the finite output. -/
theorem certifiedMesh_covers_roots (p : ℚ[X]) {a b : ℚ} (hab : a < b)
    {n : ℕ} (hm : certifiedMesh p a b n) {x : ℝ}
    (hx : x ∈ Icc (a:ℝ) (b:ℝ)) (hpx : realEval p x = 0) :
    (∃ j, selectedPoint p a b n j ∧ x = (gridPoint a b n j:ℝ)) ∨
    (∃ i, selectedInterval p a b n i ∧
      x ∈ Ioo (gridPoint a b n i:ℝ) (gridPoint a b n (i+1):ℝ)) := by
  obtain ⟨i,hi,hcell⟩ := grid_cells_cover hab.le n hx
  by_cases hl : x = (gridPoint a b n i:ℝ)
  · left
    refine ⟨i,⟨hi.le,?_⟩,hl⟩
    rw [hl,realEval_rat] at hpx
    exact_mod_cast hpx
  by_cases hu : x = (gridPoint a b n (i+1):ℝ)
  · left
    refine ⟨i+1,⟨Nat.succ_le_iff.mpr hi,?_⟩,hu⟩
    rw [hu,realEval_rat] at hpx
    exact_mod_cast hpx
  · right
    have hxopen : x ∈ Ioo (gridPoint a b n i:ℝ) (gridPoint a b n (i+1):ℝ) :=
      ⟨lt_of_le_of_ne hcell.1 (Ne.symm hl),lt_of_le_of_ne hcell.2 hu⟩
    have hb := grid_cell_bounds hab.le hi
    refine ⟨i,⟨hi,?_⟩,hxopen⟩
    apply (root_in_cell_iff_crossing p hb.1 (gridPoint_strictMono hab n (Nat.lt_succ_self i))
      hb.2.2 (hm i (Finset.mem_range.mpr hi))).mp
    exact ⟨x,hxopen,hpx⟩

/-- Distinct open output cells are disjoint; root points are handled separately. -/
theorem grid_open_cells_disjoint {a b : ℚ} (hab : a ≤ b) (n : ℕ) {i j : ℕ}
    (hij : i < j) :
    Disjoint (Ioo (gridPoint a b n i:ℝ) (gridPoint a b n (i+1):ℝ))
      (Ioo (gridPoint a b n j:ℝ) (gridPoint a b n (j+1):ℝ)) := by
  rw [Set.disjoint_left]
  intro x hi hj
  have h : (gridPoint a b n (i+1):ℝ) ≤ (gridPoint a b n j:ℝ) := by
    exact_mod_cast gridPoint_mono hab n (Nat.succ_le_iff.mpr hij)
  linarith [hi.2,hj.1]

/-- Square-free reduction supplies the simple-root hypothesis without losing
any real root, including roots of even multiplicity in the original input. -/
theorem squarefree_reduction_isolatable (p : ℚ[X]) (hp : p ≠ 0)
    {a b : ℚ} (hab : a ≤ b) :
    (∀ x : ℝ, realEval (C2.CADFactor.squarefreePart p) x = 0 ↔ realEval p x = 0) ∧
    ∃ n, certifiedMesh (C2.CADFactor.squarefreePart p) a b n := by
  classical
  constructor
  · intro x
    exact C2.CADFactor.squarefreePart_eval₂_zero_iff (algebraMap ℚ ℝ) hp x
  · apply exists_certifiedMesh _ hab
    intro x hx
    by_cases hz : realEval (C2.CADFactor.squarefreePart p) x = 0
    · right
      exact (C2.CADFactor.squarefreePart_separable hp).eval₂_derivative_ne_zero
        (algebraMap ℚ ℝ) hz
    · exact Or.inl hz

/-- A selected rational point is an actual target-interval root. -/
theorem selectedPoint_sound (p : ℚ[X]) {a b : ℚ} (hab : a ≤ b)
    {n j : ℕ} (hp : selectedPoint p a b n j) :
    (gridPoint a b n j:ℝ) ∈ Icc (a:ℝ) (b:ℝ) ∧
      realEval p (gridPoint a b n j:ℝ) = 0 := by
  refine ⟨?_,?_⟩
  · have h := gridPoint_mem hab hp.1
    exact ⟨by exact_mod_cast h.1,by exact_mod_cast h.2⟩
  · rw [realEval_rat,hp.2]
    norm_num

/-- A selected mesh interval has exactly one real root in its open interior. -/
theorem selectedInterval_sound (p : ℚ[X]) {a b : ℚ} (hab : a < b)
    {n i : ℕ} (hm : certifiedMesh p a b n) (hi : selectedInterval p a b n i) :
    ∃! x, x ∈ Ioo (gridPoint a b n i:ℝ) (gridPoint a b n (i+1):ℝ) ∧
      realEval p x = 0 := by
  have hb := grid_cell_bounds hab.le hi.1
  exact selected_cell_unique_root p hb.1
    (gridPoint_strictMono hab n (Nat.lt_succ_self i)) hb.2.2
    (hm i (Finset.mem_range.mpr hi.1)) hi.2

/-- A grid point never lies in an open grid cell; hence point outputs cannot
represent the same root as any selected interval output. -/
theorem gridPoint_not_in_open_cell {a b : ℚ} (hab : a ≤ b) (n i j : ℕ) :
    (gridPoint a b n j:ℝ) ∉
      Ioo (gridPoint a b n i:ℝ) (gridPoint a b n (i+1):ℝ) := by
  intro hj
  by_cases hji : j ≤ i
  · have h : (gridPoint a b n j:ℝ) ≤ (gridPoint a b n i:ℝ) := by
      exact_mod_cast gridPoint_mono hab n hji
    exact (not_lt_of_ge h) hj.1
  · have h : (gridPoint a b n (i+1):ℝ) ≤ (gridPoint a b n j:ℝ) := by
      exact_mod_cast gridPoint_mono hab n (by omega : i+1 ≤ j)
    exact (not_lt_of_ge h) hj.2

end C2.CADIsolation


/- ===== C2.CADEffectiveIsolation ===== -/

/-! Executable dyadic-mesh search. All acceptance decisions use finite rational
coefficient lists. Compactness supplies only the erased termination proof. -/
namespace C2.CADEffective.Dense
open Polynomial Set

def slopeBound (p : Poly) (a b : ℚ) : ℚ :=
  1 + coeffBound (derivative p) (C2.CADIsolation.intervalRadius a b) +
    coeffBound (derivative (derivative p)) (C2.CADIsolation.intervalRadius a b)

theorem slopeBound_eq (p : Poly) (a b : ℚ) :
    slopeBound p a b = C2.CADIsolation.slopeBound (denote p) a b := by
  simp only [slopeBound, C2.CADIsolation.slopeBound, C2.CADIsolation.coeffBound,
    coeffBound_eq_support_sum, denote_derivative]

def cellCheck (p : Poly) (a b l u : ℚ) : Bool :=
  decide (slopeBound p a b * (u-l) < |eval p (C2.CADIsolation.midpoint l u)| ∨
    slopeBound p a b * (u-l) < |eval (derivative p) (C2.CADIsolation.midpoint l u)|)

theorem cellCheck_iff (p : Poly) (a b l u : ℚ) :
    cellCheck p a b l u = true ↔ C2.CADIsolation.certifiedCell (denote p) a b l u := by
  simp only [cellCheck, decide_eq_true_eq, C2.CADIsolation.certifiedCell,
    C2.CADIsolation.zeroFreeTest, C2.CADIsolation.monotoneTest,
    slopeBound_eq, eval_denote, denote_derivative]

def meshCheck (p : Poly) (a b : ℚ) (n : ℕ) : Bool :=
  (List.range (2^n)).all (fun i => cellCheck p a b
    (C2.CADIsolation.gridPoint a b n i) (C2.CADIsolation.gridPoint a b n (i+1)))

theorem meshCheck_iff (p : Poly) (a b : ℚ) (n : ℕ) :
    meshCheck p a b n = true ↔ C2.CADIsolation.certifiedMesh (denote p) a b n := by
  simp only [meshCheck, List.all_eq_true, List.mem_range, cellCheck_iff,
    C2.CADIsolation.certifiedMesh, Finset.mem_range]

theorem exists_meshCheck (p : Poly) {a b : ℚ} (hab : a ≤ b)
    (hs : ∀ x ∈ Icc (a:ℝ) (b:ℝ),
      C2.CADIsolation.realEval (denote p) x ≠ 0 ∨
        C2.CADIsolation.realEval (denote p).derivative x ≠ 0) :
    ∃ n, meshCheck p a b n = true := by
  obtain ⟨n, hn⟩ := C2.CADIsolation.exists_certifiedMesh (denote p) hab hs
  exact ⟨n, (meshCheck_iff p a b n).mpr hn⟩

/-- Genuine terminating natural-number search: only the Boolean rational mesh
checker is evaluated. The real nondegeneracy assumption occurs in a proof. -/
def meshIndex (p : Poly) {a b : ℚ} (hab : a ≤ b)
    (hs : ∀ x ∈ Icc (a:ℝ) (b:ℝ),
      C2.CADIsolation.realEval (denote p) x ≠ 0 ∨
        C2.CADIsolation.realEval (denote p).derivative x ≠ 0) : ℕ :=
  Nat.find (exists_meshCheck p hab hs)

theorem meshIndex_accepted (p : Poly) {a b : ℚ} (hab : a ≤ b)
    (hs : ∀ x ∈ Icc (a:ℝ) (b:ℝ),
      C2.CADIsolation.realEval (denote p) x ≠ 0 ∨
        C2.CADIsolation.realEval (denote p).derivative x ≠ 0) :
    meshCheck p a b (meshIndex p hab hs) = true :=
  Nat.find_spec (exists_meshCheck p hab hs)

theorem meshIndex_certified (p : Poly) {a b : ℚ} (hab : a ≤ b)
    (hs : ∀ x ∈ Icc (a:ℝ) (b:ℝ),
      C2.CADIsolation.realEval (denote p) x ≠ 0 ∨
        C2.CADIsolation.realEval (denote p).derivative x ≠ 0) :
    C2.CADIsolation.certifiedMesh (denote p) a b (meshIndex p hab hs) :=
  (meshCheck_iff p a b _).mp (meshIndex_accepted p hab hs)

theorem meshIndex_le_any_accepted (p : Poly) {a b : ℚ} (hab : a ≤ b)
    (hs : ∀ x ∈ Icc (a:ℝ) (b:ℝ),
      C2.CADIsolation.realEval (denote p) x ≠ 0 ∨
        C2.CADIsolation.realEval (denote p).derivative x ≠ 0)
    {n : ℕ} (hn : meshCheck p a b n = true) : meshIndex p hab hs ≤ n :=
  Nat.find_min' (exists_meshCheck p hab hs) hn

def meshIntervals (a b : ℚ) (n : ℕ) : List (ℚ × ℚ) :=
  (List.range (2^n)).map (fun i =>
    (C2.CADIsolation.gridPoint a b n i, C2.CADIsolation.gridPoint a b n (i+1)))

@[simp] theorem meshIntervals_length (a b : ℚ) (n : ℕ) :
    (meshIntervals a b n).length = 2^n := by simp [meshIntervals]

theorem every_meshInterval_checked (p : Poly) (a b : ℚ) (n : ℕ)
    (hn : meshCheck p a b n = true) {l u : ℚ}
    (hlu : (l,u) ∈ meshIntervals a b n) : cellCheck p a b l u = true := by
  obtain ⟨i, hi, hp⟩ := List.mem_map.mp hlu
  cases hp
  exact (List.all_eq_true.mp hn) i hi

/-- All exact rational grid roots, including endpoints. -/
def pointIndices (p : Poly) (a b : ℚ) (n : ℕ) : List ℕ :=
  (List.range (2^n+1)).filter (fun i =>
    decide (eval p (C2.CADIsolation.gridPoint a b n i) = 0))

/-- All open cells whose endpoint values have opposite signs. -/
def rootIntervalIndices (p : Poly) (a b : ℚ) (n : ℕ) : List ℕ :=
  (List.range (2^n)).filter (fun i => decide
    (eval p (C2.CADIsolation.gridPoint a b n i) *
      eval p (C2.CADIsolation.gridPoint a b n (i+1)) < 0))

theorem mem_pointIndices (p : Poly) (a b : ℚ) (n i : ℕ) :
    i ∈ pointIndices p a b n ↔ C2.CADIsolation.selectedPoint (denote p) a b n i := by
  simp only [pointIndices, List.mem_filter, List.mem_range, decide_eq_true_eq,
    eval_denote, C2.CADIsolation.selectedPoint, Nat.lt_succ_iff]

theorem mem_rootIntervalIndices (p : Poly) (a b : ℚ) (n i : ℕ) :
    i ∈ rootIntervalIndices p a b n ↔
      C2.CADIsolation.selectedInterval (denote p) a b n i := by
  simp only [rootIntervalIndices, List.mem_filter, List.mem_range, decide_eq_true_eq,
    eval_denote, C2.CADIsolation.selectedInterval]

def isolatedPoints (p : Poly) (a b : ℚ) (n : ℕ) : List ℚ :=
  (pointIndices p a b n).map (C2.CADIsolation.gridPoint a b n)

def isolatingIntervals (p : Poly) (a b : ℚ) (n : ℕ) : List (ℚ × ℚ) :=
  (rootIntervalIndices p a b n).map (fun i =>
    (C2.CADIsolation.gridPoint a b n i, C2.CADIsolation.gridPoint a b n (i+1)))

end C2.CADEffective.Dense


/- ===== C2.CADIsolationSamples ===== -/

/-! Explicit rational separating samples for the finite root output and exact
rational sign semantics. -/
namespace C2.CADIsolation
open Polynomial Set

theorem realEval_zero_isAlgebraic {p : ℚ[X]} (hp : p ≠ 0) {x : ℝ}
    (hx : realEval p x = 0) : IsAlgebraic ℚ x := by
  exact ⟨p,hp,hx⟩

@[simp] theorem realEval_rat_pos (p : ℚ[X]) (q : ℚ) :
    0 < realEval p (q:ℝ) ↔ 0 < p.eval q := by
  rw [realEval_rat]
  exact_mod_cast (Iff.rfl : (0:ℚ) < p.eval q ↔ 0 < p.eval q)

@[simp] theorem realEval_rat_neg (p : ℚ[X]) (q : ℚ) :
    realEval p (q:ℝ) < 0 ↔ p.eval q < 0 := by
  rw [realEval_rat]
  exact_mod_cast (Iff.rfl : p.eval q < (0:ℚ) ↔ p.eval q < 0)

@[simp] theorem realEval_rat_zero (p : ℚ[X]) (q : ℚ) :
    realEval p (q:ℝ) = 0 ↔ p.eval q = 0 := by
  rw [realEval_rat]
  exact_mod_cast (Iff.rfl : p.eval q = (0:ℚ) ↔ p.eval q = 0)

/-- Two open root enclosures are separated by the right rational endpoint
of the earlier cell, even when the cells share that endpoint. -/
theorem rational_sample_between_cells {a b : ℚ} (hab : a ≤ b) (n : ℕ)
    {i j : ℕ} (hij : i < j) {x y : ℝ}
    (hx : x ∈ Ioo (gridPoint a b n i:ℝ) (gridPoint a b n (i+1):ℝ))
    (hy : y ∈ Ioo (gridPoint a b n j:ℝ) (gridPoint a b n (j+1):ℝ)) :
    x < (gridPoint a b n (i+1):ℝ) ∧ (gridPoint a b n (i+1):ℝ) < y := by
  refine ⟨hx.2,?_⟩
  have h : (gridPoint a b n (i+1):ℝ) ≤ (gridPoint a b n j:ℝ) := by
    exact_mod_cast gridPoint_mono hab n (Nat.succ_le_iff.mpr hij)
  exact h.trans_lt hy.1

/-- A rational root point before a selected root cell has a strict rational
separator: selection rules out the point being the cell's left endpoint. -/
theorem rational_sample_point_before_cell (p : ℚ[X]) {a b : ℚ} (hab : a < b)
    (n : ℕ) {j i : ℕ} (hji : j ≤ i)
    (hp : selectedPoint p a b n j) (hc : selectedInterval p a b n i)
    {x : ℝ} (hx : x ∈ Ioo (gridPoint a b n i:ℝ) (gridPoint a b n (i+1):ℝ)) :
    (gridPoint a b n j:ℝ) < (gridPoint a b n i:ℝ) ∧
      (gridPoint a b n i:ℝ) < x := by
  have hne : j ≠ i := by
    intro h
    have hneg := hc.2
    rw [← h,hp.2,zero_mul] at hneg
    exact (lt_irrefl 0) hneg
  refine ⟨?_,hx.1⟩
  exact_mod_cast gridPoint_strictMono hab n (lt_of_le_of_ne hji hne)

/-- The right endpoint similarly separates a selected root cell from a
later rational root point. -/
theorem rational_sample_cell_before_point (p : ℚ[X]) {a b : ℚ} (hab : a < b)
    (n : ℕ) {i j : ℕ} (hij : i < j)
    (hc : selectedInterval p a b n i) (hp : selectedPoint p a b n j)
    {x : ℝ} (hx : x ∈ Ioo (gridPoint a b n i:ℝ) (gridPoint a b n (i+1):ℝ)) :
    x < (gridPoint a b n (i+1):ℝ) ∧
      (gridPoint a b n (i+1):ℝ) < (gridPoint a b n j:ℝ) := by
  have hne : i+1 ≠ j := by
    intro h
    have hneg := hc.2
    rw [h,hp.2,mul_zero] at hneg
    exact (lt_irrefl 0) hneg
  refine ⟨hx.2,?_⟩
  exact_mod_cast gridPoint_strictMono hab n (lt_of_le_of_ne (Nat.succ_le_iff.mpr hij) hne)

/-- Two exact rational root points admit their explicit rational midpoint. -/
theorem rational_sample_between_points {a b : ℚ} (hab : a < b) (n : ℕ)
    {i j : ℕ} (hij : i < j) :
    (gridPoint a b n i:ℝ) <
      (midpoint (gridPoint a b n i) (gridPoint a b n j):ℝ) ∧
    (midpoint (gridPoint a b n i) (gridPoint a b n j):ℝ) < (gridPoint a b n j:ℝ) := by
  have h : (gridPoint a b n i:ℝ) < (gridPoint a b n j:ℝ) := by
    exact_mod_cast gridPoint_strictMono hab n hij
  dsimp [midpoint]
  push_cast
  constructor <;> linarith

/-- Constant sign on an interval with no polynomial root. The exact rational
sample tests therefore determine the sign throughout any such cell. -/
theorem realEval_pos_iff_of_no_roots (p : ℚ[X]) {l u x y : ℝ}
    (hx : x ∈ Ioo l u) (hy : y ∈ Ioo l u)
    (hzero : ∀ z ∈ Ioo l u, realEval p z ≠ 0) :
    0 < realEval p x ↔ 0 < realEval p y := by
  have aux : ∀ x ∈ Ioo l u, ∀ y ∈ Ioo l u,
      x ≤ y → 0 < realEval p x → 0 < realEval p y := by
    intro x hx y hy hxy hpos
    by_contra hn
    have hneg : realEval p y < 0 := lt_of_le_of_ne (not_lt.mp hn) (hzero y hy)
    obtain ⟨z,hz,hpz⟩ := intermediate_value_Icc' hxy
      (realEval_continuous p).continuousOn ⟨hneg.le,hpos.le⟩
    exact hzero z ⟨hx.1.trans_le hz.1,hz.2.trans_lt hy.2⟩ hpz
  have aux' : ∀ x ∈ Ioo l u, ∀ y ∈ Ioo l u,
      x ≤ y → 0 < realEval p y → 0 < realEval p x := by
    intro x hx y hy hxy hpos
    by_contra hn
    have hneg : realEval p x < 0 := lt_of_le_of_ne (not_lt.mp hn) (hzero x hx)
    obtain ⟨z,hz,hpz⟩ := intermediate_value_Icc hxy
      (realEval_continuous p).continuousOn ⟨hneg.le,hpos.le⟩
    exact hzero z ⟨hx.1.trans_le hz.1,hz.2.trans_lt hy.2⟩ hpz
  rcases le_total x y with h | h
  · exact ⟨aux x hx y hy h,aux' x hx y hy h⟩
  · exact ⟨aux' y hy x hx h,aux y hy x hx h⟩

end C2.CADIsolation


/- ===== C2.CADEffectiveRootOutput ===== -/

/-! Sorted finite root descriptors and explicit rational samples. Even ranks
represent exact grid root points; odd ranks represent open isolating cells.
All returned data and sample operations are executable rational arithmetic. -/
namespace C2.CADEffective.Dense
open Polynomial Set C2.CADIsolation

/-- Increasing descriptor ranks, interleaving points and open cells. -/
def rootRanks (p : Poly) (a b : ℚ) (n : ℕ) : List ℕ :=
  (List.range (2*2^n+1)).filter fun r =>
    if r % 2 = 0 then decide (eval p (gridPoint a b n (r/2)) = 0)
    else decide (eval p (gridPoint a b n (r/2)) * eval p (gridPoint a b n (r/2+1)) < 0)

/-- Mathematical meaning of a returned exact-algebraic descriptor. -/
noncomputable def rootAtRank (p : Poly) (a b : ℚ) (n r : ℕ) (x : ℝ) : Prop :=
  if r % 2 = 0 then x = (gridPoint a b n (r/2):ℝ) ∧ realEval (denote p) x = 0
  else x ∈ Ioo (gridPoint a b n (r/2):ℝ) (gridPoint a b n (r/2+1):ℝ) ∧
    realEval (denote p) x = 0

theorem mem_rootRanks (p : Poly) (a b : ℚ) (n r : ℕ) :
    r ∈ rootRanks p a b n ↔
    if r % 2 = 0 then selectedPoint (denote p) a b n (r/2)
      else selectedInterval (denote p) a b n (r/2) := by
  simp only [rootRanks,List.mem_filter,List.mem_range]
  by_cases hr : r % 2 = 0
  · simp only [hr,ite_true,decide_eq_true_eq,eval_denote,selectedPoint]
    constructor
    · rintro ⟨hb,hp⟩
      exact ⟨by omega,hp⟩
    · rintro ⟨hb,hp⟩
      exact ⟨by omega,hp⟩
  · simp only [hr,ite_false,decide_eq_true_eq,eval_denote,selectedInterval]
    constructor
    · rintro ⟨hb,hp⟩
      exact ⟨by omega,hp⟩
    · rintro ⟨hb,hp⟩
      exact ⟨by omega,hp⟩

theorem rootRanks_sorted (p : Poly) (a b : ℚ) (n : ℕ) :
    List.Pairwise (· < ·) (rootRanks p a b n) := by
  exact List.pairwise_lt_range.filter _

/-- Every returned descriptor denotes exactly one actual real root. -/
theorem rootRanks_unique_root (p : Poly) {a b : ℚ} (hab : a < b) {n r : ℕ}
    (hm : certifiedMesh (denote p) a b n) (hr : r ∈ rootRanks p a b n) :
    ∃! x, rootAtRank p a b n r x := by
  have hsel := (mem_rootRanks p a b n r).mp hr
  by_cases he : r % 2 = 0
  · simp only [he,if_pos] at hsel
    have hs := selectedPoint_sound (denote p) hab.le hsel
    refine ⟨(gridPoint a b n (r/2):ℝ),?_,?_⟩
    · simpa [rootAtRank,he] using hs.2
    · intro y hy
      exact (by simpa only [rootAtRank,he,if_pos] using hy :
        y = (gridPoint a b n (r/2):ℝ) ∧ realEval (denote p) y = 0).1
  · simp only [he,if_neg] at hsel
    simpa only [rootAtRank,he,if_neg] using selectedInterval_sound (denote p) hab hm hsel

/-- The finite returned descriptor list accounts for every root in [a,b]. -/
theorem rootRanks_complete (p : Poly) {a b : ℚ} (hab : a < b) {n : ℕ}
    (hm : certifiedMesh (denote p) a b n) {x : ℝ}
    (hx : x ∈ Icc (a:ℝ) (b:ℝ)) (hpx : realEval (denote p) x = 0) :
    ∃ r ∈ rootRanks p a b n, rootAtRank p a b n r x := by
  rcases certifiedMesh_covers_roots (denote p) hab hm hx hpx with hp | hc
  · obtain ⟨j,hj,hxj⟩ := hp
    refine ⟨2*j,?_,?_⟩
    · rw [mem_rootRanks]
      simpa using hj
    · simpa [rootAtRank] using And.intro hxj hpx
  · obtain ⟨i,hi,hxi⟩ := hc
    have hdiv : (2*i+1)/2 = i := by omega
    refine ⟨2*i+1,?_,?_⟩
    · rw [mem_rootRanks]
      simpa [hdiv] using hi
    · simpa [rootAtRank,hdiv] using And.intro hxi hpx

/-- Rational sample between two descriptor ranks. -/
def betweenRanks (a b : ℚ) (n r s : ℕ) : ℚ :=
  if r % 2 = 0 then
    if s % 2 = 0 then midpoint (gridPoint a b n (r/2)) (gridPoint a b n (s/2))
    else gridPoint a b n (s/2)
  else gridPoint a b n (r/2+1)

/-- Rank order is the true root order, and the computed rational sample lies
strictly between the corresponding roots. No algebraic-order oracle is used. -/
theorem betweenRanks_correct (p : Poly) {a b : ℚ} (hab : a < b) {n r s : ℕ}
    (hr : r ∈ rootRanks p a b n) (hs : s ∈ rootRanks p a b n) (hrs : r < s)
    {x y : ℝ} (hx : rootAtRank p a b n r x) (hy : rootAtRank p a b n s y) :
    x < (betweenRanks a b n r s:ℝ) ∧ (betweenRanks a b n r s:ℝ) < y := by
  have hsr := (mem_rootRanks p a b n r).mp hr
  have hss := (mem_rootRanks p a b n s).mp hs
  by_cases he : r % 2 = 0 <;> by_cases hf : s % 2 = 0
  · simp only [rootAtRank,he,hf,if_pos] at hx hy
    rw [hx.1,hy.1]
    simpa only [betweenRanks,he,hf,if_pos] using
      rational_sample_between_points hab n (show r/2 < s/2 by omega)
  · simp only [rootAtRank,he,hf,if_pos,if_neg] at hx hy
    simp only [he,if_pos] at hsr
    simp only [hf,if_neg] at hss
    rw [hx.1]
    simpa only [betweenRanks,he,hf,if_pos,if_neg] using
      rational_sample_point_before_cell (denote p) hab n (show r/2 ≤ s/2 by omega)
        hsr hss hy.1
  · simp only [rootAtRank,he,hf,if_pos,if_neg] at hx hy
    simp only [he,if_neg] at hsr
    simp only [hf,if_pos] at hss
    rw [hy.1]
    simpa only [betweenRanks,he,if_neg] using
      rational_sample_cell_before_point (denote p) hab n (show r/2 < s/2 by omega)
        hsr hss hx.1
  · simp only [rootAtRank,he,hf,if_neg] at hx hy
    simpa only [betweenRanks,he,if_neg] using
      rational_sample_between_cells hab.le n (show r/2 < s/2 by omega) hx.1 hy.1

theorem root_rank_order (p : Poly) {a b : ℚ} (hab : a < b) {n r s : ℕ}
    (hr : r ∈ rootRanks p a b n) (hs : s ∈ rootRanks p a b n) (hrs : r < s)
    {x y : ℝ} (hx : rootAtRank p a b n r x) (hy : rootAtRank p a b n s y) : x < y :=
  (betweenRanks_correct p hab hr hs hrs hx hy).1.trans
    (betweenRanks_correct p hab hr hs hrs hx hy).2

end C2.CADEffective.Dense


/- ===== C2.CADDriverIsolation ===== -/

/-! The concrete executable isolation stage of the CAD driver. Endpoints are
inserted as polynomial roots before square-free reduction. All computed data
are dense rational coefficients, mesh indices, and ordered natural ranks. -/

namespace C2.CADDriver
open Polynomial Set
open C2.CADEffective

def product : List Dense.Poly → Dense.Poly
  | [] => [1]
  | p :: ps => Dense.mul p (product ps)

theorem denote_product (ps : List Dense.Poly) :
    Dense.denote (product ps) = (ps.map Dense.denote).prod := by
  induction ps with
  | nil => simp [product]
  | cons p ps ih => simp [product, ih]

theorem product_nonzero (ps : List Dense.Poly)
    (h : ∀ p ∈ ps, Dense.denote p ≠ 0) : Dense.denote (product ps) ≠ 0 := by
  induction ps with
  | nil => simp [product]
  | cons p ps ih =>
    simp only [product, Dense.denote_mul]
    exact mul_ne_zero (h p (List.mem_cons_self))
      (ih fun q hq => h q (List.mem_cons_of_mem p hq))

def anyZero (ps : List Dense.Poly) : Bool := ps.any fun p => Dense.eqb p []

theorem anyZero_eq_false_iff (ps : List Dense.Poly) :
    anyZero ps = false ↔ ∀ p ∈ ps, Dense.denote p ≠ 0 := by
  simp [anyZero, Bool.eq_false_iff, ne_eq, List.any_eq_true,
    Dense.eqb_eq_true_iff]

def augmented (p : Dense.Poly) (a b : ℚ) : Dense.Poly :=
  Dense.mul p (Dense.mul [-a, 1] [-b, 1])

theorem denote_linear (a : ℚ) : Dense.denote [-a, 1] = X - C a := by
  simp
  ring

theorem denote_augmented (p : Dense.Poly) (a b : ℚ) :
    Dense.denote (augmented p a b) = Dense.denote p * ((X - C a) * (X - C b)) := by
  unfold augmented
  rw [Dense.denote_mul, Dense.denote_mul, denote_linear, denote_linear]

theorem augmented_nonzero (p : Dense.Poly) (hp : Dense.denote p ≠ 0) (a b : ℚ) :
    Dense.denote (augmented p a b) ≠ 0 := by
  rw [denote_augmented]
  exact mul_ne_zero hp (mul_ne_zero (X_sub_C_ne_zero a) (X_sub_C_ne_zero b))

theorem reduced_nondegenerate (p : Dense.Poly) (hp : Dense.denote p ≠ 0) (a b : ℚ) :
    ∀ x ∈ Icc (a : ℝ) (b : ℝ),
      CADIsolation.realEval (Dense.denote (Dense.reducedPoly p hp)) x ≠ 0 ∨
        CADIsolation.realEval (Dense.denote (Dense.reducedPoly p hp)).derivative x ≠ 0 := by
  intro x hx
  by_cases hz : CADIsolation.realEval (Dense.denote (Dense.reducedPoly p hp)) x = 0
  · exact Or.inr ((Dense.reducedPoly_correct.{0} p hp).1.eval₂_derivative_ne_zero
      (algebraMap ℚ ℝ) hz)
  · exact Or.inl hz

structure Isolation where
  polynomial : Dense.Poly
  mesh : ℕ
  ranks : List ℕ

/-- Total executable isolation, including both rational interval endpoints.
The searches evaluate only dense rational identities and mesh inequalities. -/
def isolate (p : Dense.Poly) (hp : Dense.denote p ≠ 0)
    (a b : ℚ) (hab : a ≤ b) : Isolation :=
  let ap := augmented p a b
  let hap := augmented_nonzero p hp a b
  let q := Dense.reducedPoly ap hap
  let n := Dense.meshIndex q hab (reduced_nondegenerate ap hap a b)
  ⟨q, n, Dense.rootRanks q a b n⟩

theorem isolate_mesh_certified (p : Dense.Poly) (hp : Dense.denote p ≠ 0)
    (a b : ℚ) (hab : a ≤ b) :
    CADIsolation.certifiedMesh (Dense.denote (isolate p hp a b hab).polynomial) a b
      (isolate p hp a b hab).mesh := by
  dsimp only [isolate]
  exact Dense.meshIndex_certified _ hab (reduced_nondegenerate _ _ a b)

theorem isolate_polynomial_nonzero (p : Dense.Poly) (hp : Dense.denote p ≠ 0)
    (a b : ℚ) (hab : a ≤ b) :
    Dense.denote (isolate p hp a b hab).polynomial ≠ 0 :=
  (Dense.reducedPoly_correct.{0} _ (augmented_nonzero p hp a b)).2.1

theorem isolate_root_iff (p : Dense.Poly) (hp : Dense.denote p ≠ 0)
    (a b : ℚ) (hab : a ≤ b) (x : ℝ) :
    CADIsolation.realEval (Dense.denote (isolate p hp a b hab).polynomial) x = 0 ↔
      CADIsolation.realEval (Dense.denote p) x = 0 ∨ x = (a : ℝ) ∨ x = (b : ℝ) := by
  change CADIsolation.realEval (Dense.denote (Dense.reducedPoly (augmented p a b)
    (augmented_nonzero p hp a b))) x = 0 ↔ _
  simp only [CADIsolation.realEval]
  rw [(Dense.reducedPoly_correct _ (augmented_nonzero p hp a b)).2.2 (algebraMap ℚ ℝ) x]
  simp [CADIsolation.realEval, denote_augmented, mul_eq_zero, sub_eq_zero, or_assoc]

theorem isolate_ranks_sorted (p : Dense.Poly) (hp : Dense.denote p ≠ 0)
    (a b : ℚ) (hab : a ≤ b) :
    List.Pairwise (· < ·) (isolate p hp a b hab).ranks :=
  Dense.rootRanks_sorted _ _ _ _

theorem isolate_unique_root (p : Dense.Poly) (hp : Dense.denote p ≠ 0)
    (a b : ℚ) (hab : a < b) {r : ℕ}
    (hr : r ∈ (isolate p hp a b hab.le).ranks) :
    ∃! x, Dense.rootAtRank (isolate p hp a b hab.le).polynomial a b
      (isolate p hp a b hab.le).mesh r x :=
  Dense.rootRanks_unique_root _ hab (isolate_mesh_certified p hp a b hab.le) hr

theorem isolate_complete (p : Dense.Poly) (hp : Dense.denote p ≠ 0)
    (a b : ℚ) (hab : a < b) {x : ℝ} (hx : x ∈ Icc (a : ℝ) (b : ℝ))
    (hroot : CADIsolation.realEval (Dense.denote p) x = 0 ∨ x = (a : ℝ) ∨ x = (b : ℝ)) :
    ∃ r ∈ (isolate p hp a b hab.le).ranks,
      Dense.rootAtRank (isolate p hp a b hab.le).polynomial a b
        (isolate p hp a b hab.le).mesh r x := by
  exact Dense.rootRanks_complete _ hab (isolate_mesh_certified p hp a b hab.le) hx
    ((isolate_root_iff p hp a b hab.le x).mpr hroot)

end C2.CADDriver


/- ===== C2.CADEffectiveBivariate ===== -/

/-! Executable bivariate rational arithmetic. Outer lists index gamma powers;
inner rational lists index gain powers. Equality is checked coefficientwise. -/
namespace C2.CADEffective.Bivariate
open Polynomial

abbrev Poly := List Dense.Poly

noncomputable def denote (p : Poly) : Polynomial (Polynomial ℚ) :=
  p.foldr (fun a b => C (Dense.denote a) + X*b) 0

@[simp] theorem denote_nil : denote [] = 0 := rfl
@[simp] theorem denote_cons (a : Dense.Poly) (p : Poly) :
    denote (a :: p) = C (Dense.denote a) + X * denote p := rfl

@[simp] theorem coeff_denote (p : Poly) (n : ℕ) :
    (denote p).coeff n = Dense.denote (p.getD n []) := by
  induction p generalizing n with
  | nil => simp [List.getD_nil]
  | cons a p ih =>
      cases n with
      | zero => simp
      | succ n => simp [coeff_X_mul, ih]

def add : Poly → Poly → Poly
  | [], q => q
  | p, [] => p
  | a :: p, b :: q => Dense.add a b :: add p q

def neg (p : Poly) : Poly := p.map Dense.neg

def scale (a : Dense.Poly) (p : Poly) : Poly := p.map (Dense.mul a)

def mul : Poly → Poly → Poly
  | [], _ => []
  | a :: p, q => add (scale a q) ([] :: mul p q)

def constant (a : Dense.Poly) : Poly := [a]

def one : Poly := [[1]]

def pow (p : Poly) : ℕ → Poly
  | 0 => one
  | n+1 => mul (pow p n) p

def derivative : Poly → Poly
  | [] => []
  | _ :: p => add p ([] :: derivative p)

def atGain (p : Poly) (k : ℚ) : Dense.Poly := p.map (fun a => Dense.eval a k)

def eval (p : Poly) (gamma k : ℚ) : ℚ := Dense.eval (atGain p k) gamma

def eqb (p q : Poly) : Bool :=
  (List.range (max p.length q.length)).all
    (fun n => Dense.eqb (p.getD n []) (q.getD n []))

@[simp] theorem denote_add (p q : Poly) : denote (add p q) = denote p + denote q := by
  induction p generalizing q with
  | nil => simp [add]
  | cons a p ih =>
      cases q with
      | nil => simp [add]
      | cons b q => simp [add, ih, C_add]; ring

@[simp] theorem denote_neg (p : Poly) : denote (neg p) = -denote p := by
  induction p with
  | nil => simp [neg]
  | cons a p ih =>
      simp only [neg, List.map_cons, denote_cons, Dense.denote_neg, C_neg]
      rw [show denote (List.map Dense.neg p) = -denote p from ih]
      ring

@[simp] theorem denote_scale (a : Dense.Poly) (p : Poly) :
    denote (scale a p) = C (Dense.denote a) * denote p := by
  induction p with
  | nil => simp [scale]
  | cons b p ih =>
      simp only [scale, List.map_cons, denote_cons, Dense.denote_mul, C_mul]
      rw [show denote (List.map (Dense.mul a) p) = C (Dense.denote a) * denote p from ih]
      ring

@[simp] theorem denote_mul (p q : Poly) : denote (mul p q) = denote p * denote q := by
  induction p with
  | nil => simp [mul]
  | cons a p ih => simp [mul, ih]; ring

@[simp] theorem denote_constant (p : Dense.Poly) : denote (constant p) = C (Dense.denote p) := by
  simp [constant]

@[simp] theorem denote_one : denote one = 1 := by simp [one]

@[simp] theorem denote_pow (p : Poly) (n : ℕ) : denote (pow p n) = denote p ^ n := by
  induction n with
  | zero => simp [pow]
  | succ n ih => simp [pow, ih, pow_succ]

@[simp] theorem denote_derivative (p : Poly) : denote (derivative p) = (denote p).derivative := by
  induction p with
  | nil => simp [derivative]
  | cons a p ih => simp [derivative, ih, Polynomial.derivative_mul, add_comm]

@[simp] theorem denote_atGain (p : Poly) (k : ℚ) :
    Dense.denote (atGain p k) = (denote p).map (Polynomial.evalRingHom k) := by
  induction p with
  | nil => simp [atGain]
  | cons a p ih =>
      change Dense.denote (Dense.eval a k :: atGain p k) =
        (C (Dense.denote a) + X * denote p).map (Polynomial.evalRingHom k)
      rw [Dense.denote_cons, ih]
      simp [Dense.eval_denote]

@[simp] theorem eval_denote (p : Poly) (gamma k : ℚ) :
    eval p gamma k = ((denote p).map (Polynomial.evalRingHom k)).eval gamma := by
  simp only [eval, Dense.eval_denote, denote_atGain]

@[simp] theorem eqb_eq_true_iff (p q : Poly) : eqb p q = true ↔ denote p = denote q := by
  simp only [eqb, List.all_eq_true, List.mem_range, Dense.eqb_eq_true_iff]
  constructor
  · intro h
    apply Polynomial.ext
    intro n
    by_cases hn : n < max p.length q.length
    · simpa only [coeff_denote] using h n hn
    · simp only [coeff_denote]
      rw [List.getD_eq_default _ _ (by omega), List.getD_eq_default _ _ (by omega)]
  · intro h n hn
    simpa only [coeff_denote] using congrArg (fun P : Polynomial (Polynomial ℚ) => P.coeff n) h

/-- Existence of a finite dense encoding; no encoding oracle is used at runtime. -/
theorem exists_encoding (p : Polynomial (Polynomial ℚ)) : ∃ v : Poly, denote v = p := by
  choose f hf using (fun i : Fin (p.natDegree + 1) => Dense.exists_encoding (p.coeff i))
  refine ⟨List.ofFn f, ?_⟩
  apply Polynomial.ext
  intro n
  simp only [coeff_denote]
  by_cases hn : n < p.natDegree + 1
  · rw [List.getD_eq_getElem _ _ (by simpa using hn)]
    rw [List.getElem_ofFn]
    exact hf _
  · rw [List.getD_eq_default _ _ (by simp; omega), Dense.denote_nil]
    exact (coeff_eq_zero_of_natDegree_lt (by omega)).symm

end C2.CADEffective.Bivariate


/- ===== C2.CADDriver ===== -/

/-! A concrete total CAD testing driver. It specializes the supplied dense
bivariate inequalities at each rational gain sample, handles identically zero
specializations, isolates the square-free parameter-root product with 0 and 1,
tests every computed rational parameter gap, and returns the greatest marked
right gain-root rank. The projection polynomial is an explicit dense input;
the projection producer and semantic constancy theorem are separate modules.
-/

namespace C2.CADDriver
open C2.CADEffective C2.CADAlgorithm

def consecutiveRanks (data : Isolation) : List (ℕ × ℕ) :=
  data.ranks.zip data.ranks.tail

def gapSamples (data : Isolation) (a b : ℚ) : List ℚ :=
  (consecutiveRanks data).map fun c => Dense.betweenRanks a b data.mesh c.1 c.2

def specializations (input : List Bivariate.Poly) (gain : ℚ) : List Dense.Poly :=
  input.map fun p => Bivariate.atGain p gain

/-- Zero specializations make the strict feasible set empty. Otherwise the
actual product is nonzero, and the proved total square-free isolator applies. -/
def parameterIsolation (input : List Bivariate.Poly) (gain : ℚ) : Option Isolation :=
  let ps := specializations input gain
  if hz : anyZero ps = true then none
  else
    have hp : Dense.denote (product ps) ≠ 0 :=
      product_nonzero ps ((anyZero_eq_false_iff ps).mp (Bool.eq_false_iff.mpr hz))
    some (isolate (product ps) hp 0 1 (by norm_num))

def parameterSamples (input : List Bivariate.Poly) (gain : ℚ) : List ℚ :=
  match parameterIsolation input gain with
  | none => []
  | some data => gapSamples data 0 1

def rationalTests (input : List Bivariate.Poly) : List (ℚ → ℚ → ℚ) :=
  input.map Bivariate.eval

def markGain (input : List Bivariate.Poly) (gain : ℚ) : Bool :=
  markAtGain (rationalTests input) (parameterSamples input gain) gain

def sampledGainCells (input : List Bivariate.Poly) (data : Isolation)
    (K : ℚ) : List (SampledCell ℕ) :=
  (consecutiveRanks data).map fun c =>
    let k := Dense.betweenRanks 0 K data.mesh c.1 c.2
    {left := c.1, right := c.2, gainSample := k,
      parameterSamples := parameterSamples input k}

structure Run where
  isolation : Isolation
  sampledCells : List (SampledCell ℕ)
  result : Option ℕ

/-- Every computation is dense rational arithmetic, a proved terminating
search, or structural list recursion. Natural rank comparisons replace any
general-purpose real-algebraic comparison oracle. -/
def runWithProjection (input : List Bivariate.Poly) (projection : Dense.Poly)
    (hp : Dense.denote projection ≠ 0) (K : ℚ) (hK : 0 ≤ K) : Run :=
  let iso := isolate projection hp 0 K hK
  let cells := sampledGainCells input iso K
  ⟨iso, cells, testAndSelect (rationalTests input) cells⟩

theorem parameterIsolation_none_iff (input : List Bivariate.Poly) (gain : ℚ) :
    parameterIsolation input gain = none ↔
      anyZero (specializations input gain) = true := by
  dsimp only [parameterIsolation]
  split <;> simp_all

theorem parameterIsolation_some (input : List Bivariate.Poly) (gain : ℚ)
    (hz : anyZero (specializations input gain) = false) :
    ∃ data, parameterIsolation input gain = some data := by
  unfold parameterIsolation
  simp only [hz, Bool.false_eq_true, dite_false]
  exact ⟨_, rfl⟩

theorem markGain_zero_specialization (input : List Bivariate.Poly) (gain : ℚ)
    (hz : anyZero (specializations input gain) = true) : markGain input gain = false := by
  have hn := (parameterIsolation_none_iff input gain).mpr hz
  simp [markGain, parameterSamples, hn, markAtGain]

theorem markGain_true_iff (input : List Bivariate.Poly) (gain : ℚ) :
    markGain input gain = true ↔
      ∃ parameter ∈ parameterSamples input gain,
        ∀ p ∈ input, 0 < Bivariate.eval p parameter gain := by
  rw [markGain, markAtGain_eq_true_iff]
  simp [rationalTests]

theorem run_none_iff (input : List Bivariate.Poly) (projection : Dense.Poly)
    (hp : Dense.denote projection ≠ 0) (K : ℚ) (hK : 0 ≤ K) :
    (runWithProjection input projection hp K hK).result = none ↔
      ∀ c ∈ (runWithProjection input projection hp K hK).sampledCells,
        ¬∃ parameter ∈ c.parameterSamples,
          ∀ p ∈ input, 0 < Bivariate.eval p parameter c.gainSample := by
  change testAndSelect (rationalTests input) _ = none ↔ _
  rw [testAndSelect_none_iff]
  simp [rationalTests, runWithProjection]

theorem run_some_test_spec (input : List Bivariate.Poly) (projection : Dense.Poly)
    (hp : Dense.denote projection ≠ 0) (K : ℚ) (hK : 0 ≤ K) {r : ℕ}
    (hout : (runWithProjection input projection hp K hK).result = some r) :
    (∃ c ∈ (runWithProjection input projection hp K hK).sampledCells,
      (∃ parameter ∈ c.parameterSamples,
        ∀ p ∈ input, 0 < Bivariate.eval p parameter c.gainSample) ∧ c.right = r) ∧
    ∀ c ∈ (runWithProjection input projection hp K hK).sampledCells,
      (∃ parameter ∈ c.parameterSamples,
        ∀ p ∈ input, 0 < Bivariate.eval p parameter c.gainSample) → c.right ≤ r := by
  have h := testAndSelect_some_spec hout
  simpa [rationalTests] using h

theorem selected_rank_mem (input : List Bivariate.Poly) (projection : Dense.Poly)
    (hp : Dense.denote projection ≠ 0) (K : ℚ) (hK : 0 ≤ K) {r : ℕ}
    (hout : (runWithProjection input projection hp K hK).result = some r) :
    r ∈ (runWithProjection input projection hp K hK).isolation.ranks := by
  obtain ⟨⟨c, hc, _, hcr⟩, _⟩ := run_some_test_spec input projection hp K hK hout
  obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc
  have hright := List.mem_of_mem_tail (List.of_mem_zip hd).2
  exact hcr ▸ hright

theorem selected_rank_unique_root (input : List Bivariate.Poly) (projection : Dense.Poly)
    (hp : Dense.denote projection ≠ 0) (K : ℚ) (hK : 0 < K) {r : ℕ}
    (hout : (runWithProjection input projection hp K hK.le).result = some r) :
    ∃! x, Dense.rootAtRank (runWithProjection input projection hp K hK.le).isolation.polynomial
      0 K (runWithProjection input projection hp K hK.le).isolation.mesh r x := by
  exact isolate_unique_root projection hp 0 K hK
    (selected_rank_mem input projection hp K hK.le hout)

end C2.CADDriver


/- ===== C2.CADEffectiveRootGaps ===== -/

/-! Endpoint inclusion and root-free gaps of the sorted executable output. -/
namespace C2.CADEffective.Dense
open Polynomial Set C2.CADIsolation

theorem rootAtRank_mem_interval (p : Poly) {a b : ℚ} (hab : a ≤ b) {n r : ℕ}
    (hr : r ∈ rootRanks p a b n) {x : ℝ} (hx : rootAtRank p a b n r x) :
    x ∈ Icc (a:ℝ) (b:ℝ) := by
  have hs := (mem_rootRanks p a b n r).mp hr
  by_cases he : r % 2 = 0
  · simp only [rootAtRank,he,if_pos] at hx
    simp only [he,if_pos] at hs
    rw [hx.1]
    exact (selectedPoint_sound (denote p) hab hs).1
  · simp only [rootAtRank,he,if_neg] at hx
    simp only [he,if_neg] at hs
    have hb := grid_cell_bounds hab hs.1
    have hl : (a:ℝ) ≤ (gridPoint a b n (r/2):ℝ) := by exact_mod_cast hb.1
    have hu : (gridPoint a b n (r/2+1):ℝ) ≤ (b:ℝ) := by exact_mod_cast hb.2.2
    exact ⟨hl.trans hx.1.1.le,hx.1.2.le.trans hu⟩

theorem rootAtRank_is_root (p : Poly) (a b : ℚ) (n r : ℕ) {x : ℝ}
    (hx : rootAtRank p a b n r x) : realEval (denote p) x = 0 := by
  unfold rootAtRank at hx
  split_ifs at hx <;> exact hx.2

theorem first_rank_mem (p : Poly) (a b : ℚ) (n : ℕ) (ha : eval p a = 0) :
    0 ∈ rootRanks p a b n := by
  rw [mem_rootRanks]
  simp only [Nat.zero_mod,Nat.zero_div,if_pos,selectedPoint,gridPoint_zero,Nat.zero_le,true_and]
  rwa [← eval_denote]

theorem last_rank_mem (p : Poly) (a b : ℚ) (n : ℕ) (hb : eval p b = 0) :
    2*2^n ∈ rootRanks p a b n := by
  rw [mem_rootRanks]
  simpa [selectedPoint,← eval_denote] using hb

theorem first_rank_meaning (p : Poly) (a b : ℚ) (n : ℕ) {x : ℝ}
    (hx : rootAtRank p a b n 0 x) : x = (a:ℝ) := by
  simpa [rootAtRank] using hx.1

theorem last_rank_meaning (p : Poly) (a b : ℚ) (n : ℕ) {x : ℝ}
    (hx : rootAtRank p a b n (2*2^n) x) : x = (b:ℝ) := by
  have h : x = (b:ℝ) ∧ realEval (denote p) x = 0 := by simpa [rootAtRank] using hx
  exact h.1

/-- No root is hidden between consecutive returned ranks. -/
theorem no_root_between_consecutive_ranks (p : Poly) {a b : ℚ} (hab : a < b)
    {n r s : ℕ} (hm : certifiedMesh (denote p) a b n)
    (hr : r ∈ rootRanks p a b n) (hs : s ∈ rootRanks p a b n)
    (hcon : ∀ t ∈ rootRanks p a b n, r < t → t < s → False)
    {x y : ℝ} (hx : rootAtRank p a b n r x) (hy : rootAtRank p a b n s y) :
    ∀ z ∈ Ioo x y, realEval (denote p) z ≠ 0 := by
  intro z hz hpz
  have hxg := rootAtRank_mem_interval p hab.le hr hx
  have hyg := rootAtRank_mem_interval p hab.le hs hy
  have hzg : z ∈ Icc (a:ℝ) (b:ℝ) := ⟨hxg.1.trans hz.1.le,hz.2.le.trans hyg.2⟩
  obtain ⟨t,ht,hzt⟩ := rootRanks_complete p hab hm hzg hpz
  have hrt : r < t := by
    by_contra hn
    rcases lt_or_eq_of_le (not_lt.mp hn) with hlt | he
    · have hzx := root_rank_order p hab ht hr hlt hzt hx
      exact (not_lt_of_ge hzx.le) hz.1
    · subst t
      have he := (rootRanks_unique_root p hab hm hr).unique hzt hx
      exact (ne_of_lt hz.1) he.symm
  have hts : t < s := by
    by_contra hn
    rcases lt_or_eq_of_le (not_lt.mp hn) with hlt | he
    · have hyz := root_rank_order p hab hs ht hlt hy hzt
      exact (not_lt_of_ge hyz.le) hz.2
    · subst t
      have he := (rootRanks_unique_root p hab hm hs).unique hzt hy
      exact (ne_of_lt hz.2) he
  exact hcon t ht hrt hts

/-- An exact rational gap sample determines the polynomial sign throughout
that true gap between consecutive roots. -/
theorem gap_sample_sign (p : Poly) {a b : ℚ} (hab : a < b) {n r s : ℕ}
    (hm : certifiedMesh (denote p) a b n)
    (hr : r ∈ rootRanks p a b n) (hs : s ∈ rootRanks p a b n) (hrs : r < s)
    (hcon : ∀ t ∈ rootRanks p a b n, r < t → t < s → False)
    {x y z : ℝ} (hx : rootAtRank p a b n r x) (hy : rootAtRank p a b n s y)
    (hz : z ∈ Ioo x y) :
    0 < realEval (denote p) z ↔ 0 < eval p (betweenRanks a b n r s) := by
  have hsample := betweenRanks_correct p hab hr hs hrs hx hy
  rw [eval_denote,← realEval_rat_pos]
  exact realEval_pos_iff_of_no_roots (denote p) hz hsample
    (no_root_between_consecutive_ranks p hab hm hr hs hcon hx hy)

end C2.CADEffective.Dense


/- ===== C2.CADRootPairs ===== -/

/-! Finite adjacent-pair enumeration and coverage for the ordered root output. -/
namespace C2.CADEffective.Dense
open Set

def rankPairs (rs : List ℕ) : List (ℕ × ℕ) := rs.zip rs.tail

@[simp] theorem rankPairs_nil : rankPairs [] = [] := rfl
@[simp] theorem rankPairs_singleton (r : ℕ) : rankPairs [r] = [] := rfl
@[simp] theorem rankPairs_cons_cons (r s : ℕ) (rs : List ℕ) :
    rankPairs (r::s::rs) = (r,s)::rankPairs (s::rs) := rfl

/-- A computed neighboring pair consists of ordered list members with no
other returned rank strictly between them. -/
theorem rankPairs_properties {rs : List ℕ} (hsort : rs.Pairwise (· < ·))
    {r s : ℕ} (hpair : (r,s) ∈ rankPairs rs) :
    r ∈ rs ∧ s ∈ rs ∧ r < s ∧
      ∀ t ∈ rs, r < t → t < s → False := by
  induction rs with
  | nil => simp at hpair
  | cons a tail ih =>
    cases tail with
    | nil => simp at hpair
    | cons b bs =>
      obtain ⟨ha,hbt⟩ := List.pairwise_cons.mp hsort
      rw [rankPairs_cons_cons] at hpair
      rcases List.mem_cons.mp hpair with he | ht
      · cases he
        refine ⟨by simp,by simp,ha s (by simp),?_⟩
        intro t htm hrt hts
        rcases List.mem_cons.mp htm with hta | htm
        · subst t
          exact (lt_irrefl _) hrt
        · have hb : s ≤ t := by
            rcases List.mem_cons.mp htm with htb | htm
            · subst t; rfl
            · exact ((List.pairwise_cons.mp hbt).1 t htm).le
          exact (not_lt_of_ge hb) hts
      · obtain ⟨hr,hs,hrs,hcon⟩ := ih hbt ht
        refine ⟨List.mem_cons_of_mem a hr,List.mem_cons_of_mem a hs,hrs,?_⟩
        intro t htm hrt hts
        rcases List.mem_cons.mp htm with hta | htm
        · subst t
          exact (not_lt_of_ge (ha r hr).le) hrt
        · exact hcon t htm hrt hts

/-- Any finite sequence starting below a point and later lying above it has
an adjacent bracket, if no member equals the point. -/
theorem rankPairs_bracket_from_head (v : ℕ → ℝ) (z : ℝ) (a : ℕ) (tail : List ℕ)
    (ha : v a < z) (hhigh : ∃ s ∈ a::tail, z < v s)
    (hne : ∀ t ∈ a::tail, z ≠ v t) :
    ∃ r s, (r,s) ∈ rankPairs (a::tail) ∧ v r < z ∧ z < v s := by
  induction tail generalizing a with
  | nil =>
    obtain ⟨s,hs,hzs⟩ := hhigh
    have he : s = a := by simpa using hs
    subst s
    exact (not_lt_of_ge ha.le hzs).elim
  | cons b bs ih =>
    by_cases hzb : z < v b
    · exact ⟨a,b,by simp,ha,hzb⟩
    · have hb : v b < z := lt_of_le_of_ne (not_lt.mp hzb) (Ne.symm (hne b (by simp)))
      have hh : ∃ s ∈ b::bs, z < v s := by
        obtain ⟨s,hs,hzs⟩ := hhigh
        rcases List.mem_cons.mp hs with he | hs
        · subst s
          exact (not_lt_of_ge ha.le hzs).elim
        · exact ⟨s,hs,hzs⟩
      obtain ⟨r,s,hpair,hr,hs⟩ := ih b hb hh (fun t ht => hne t (List.mem_cons_of_mem a ht))
      exact ⟨r,s,by simp only [rankPairs_cons_cons,List.mem_cons]; exact Or.inr hpair,hr,hs⟩

/-- Every point between some two returned roots, and unequal to all roots,
is bracketed by a computed neighboring pair. -/
theorem exists_rankPair_bracket (rs : List ℕ) (v : ℕ → ℝ) (z : ℝ)
    (hsort : rs.Pairwise (fun r s => v r < v s))
    (hlow : ∃ r ∈ rs, v r < z) (hhigh : ∃ s ∈ rs, z < v s)
    (hne : ∀ t ∈ rs, z ≠ v t) :
    ∃ r s, (r,s) ∈ rankPairs rs ∧ v r < z ∧ z < v s := by
  cases rs with
  | nil => simpa using hlow
  | cons a tail =>
    have ha : v a < z := by
      obtain ⟨r,hr,hrz⟩ := hlow
      rcases List.mem_cons.mp hr with he | hr
      · subst r; exact hrz
      · exact ((List.pairwise_cons.mp hsort).1 r hr).trans hrz
    exact rankPairs_bracket_from_head v z a tail ha hhigh hne

/-- Descriptor semantics turn the sorted natural ranks into a strictly
increasing real interpretation. This function is used only in specifications. -/
theorem rootRanks_values_sorted (p : Poly) {a b : ℚ} (hab : a < b)
    (n : ℕ) (v : ℕ → ℝ)
    (hv : ∀ r ∈ rootRanks p a b n, rootAtRank p a b n r (v r)) :
    (rootRanks p a b n).Pairwise (fun r s => v r < v s) := by
  exact (rootRanks_sorted p a b n).imp_of_mem
    (fun hr hs hrs => root_rank_order p hab hr hs hrs (hv _ hr) (hv _ hs))

end C2.CADEffective.Dense


/- ===== C2.CADDriverValues ===== -/

/-! Real interpretation of the executable finite root ranks. This semantic
interpretation is never called by the native rational CAD computation. -/
noncomputable section
namespace C2.CADDriver
open Set C2.CADEffective C2.CADIsolation

noncomputable def rootValue (p : Dense.Poly) (hp : Dense.denote p ≠ 0)
    (a b : ℚ) (hab : a < b) (r : ℕ) : ℝ :=
  if hr : r ∈ (isolate p hp a b hab.le).ranks then
    Classical.choose (isolate_unique_root p hp a b hab hr).exists
  else 0

section
variable (p : Dense.Poly) (hp : Dense.denote p ≠ 0) (a b : ℚ) (hab : a < b)

theorem rootValue_spec {r : ℕ} (hr : r ∈ (isolate p hp a b hab.le).ranks) :
    Dense.rootAtRank (isolate p hp a b hab.le).polynomial a b
      (isolate p hp a b hab.le).mesh r (rootValue p hp a b hab r) := by
  simp only [rootValue, dif_pos hr]
  exact Classical.choose_spec (isolate_unique_root p hp a b hab hr).exists

theorem rootValue_mem_Icc {r : ℕ} (hr : r ∈ (isolate p hp a b hab.le).ranks) :
    rootValue p hp a b hab r ∈ Icc (a : ℝ) (b : ℝ) :=
  Dense.rootAtRank_mem_interval _ hab.le hr (rootValue_spec p hp a b hab hr)

theorem rootValue_is_root {r : ℕ} (hr : r ∈ (isolate p hp a b hab.le).ranks) :
    realEval (Dense.denote (isolate p hp a b hab.le).polynomial)
      (rootValue p hp a b hab r) = 0 :=
  Dense.rootAtRank_is_root _ _ _ _ _ (rootValue_spec p hp a b hab hr)

theorem rootValue_algebraic {r : ℕ} (hr : r ∈ (isolate p hp a b hab.le).ranks) :
    IsAlgebraic ℚ (rootValue p hp a b hab r) :=
  realEval_zero_isAlgebraic (isolate_polynomial_nonzero p hp a b hab.le)
    (rootValue_is_root p hp a b hab hr)

theorem rootValue_strictMono {r s : ℕ}
    (hr : r ∈ (isolate p hp a b hab.le).ranks)
    (hs : s ∈ (isolate p hp a b hab.le).ranks) (hrs : r < s) :
    rootValue p hp a b hab r < rootValue p hp a b hab s :=
  Dense.root_rank_order _ hab hr hs hrs
    (rootValue_spec p hp a b hab hr) (rootValue_spec p hp a b hab hs)

theorem rootValues_sorted :
    (isolate p hp a b hab.le).ranks.Pairwise
      (fun r s => rootValue p hp a b hab r < rootValue p hp a b hab s) :=
  Dense.rootRanks_values_sorted _ hab _ _ (fun _ hr => rootValue_spec p hp a b hab hr)

theorem rootValue_complete {x : ℝ} (hx : x ∈ Icc (a : ℝ) (b : ℝ))
    (hroot : realEval (Dense.denote p) x = 0 ∨ x = (a : ℝ) ∨ x = (b : ℝ)) :
    ∃ r ∈ (isolate p hp a b hab.le).ranks, rootValue p hp a b hab r = x := by
  obtain ⟨r, hr, hspec⟩ := isolate_complete p hp a b hab hx hroot
  exact ⟨r, hr, (isolate_unique_root p hp a b hab hr).unique
    (rootValue_spec p hp a b hab hr) hspec⟩

theorem rootValue_gap_sample {r s : ℕ}
    (hpair : (r,s) ∈ consecutiveRanks (isolate p hp a b hab.le)) :
    (Dense.betweenRanks a b (isolate p hp a b hab.le).mesh r s : ℝ) ∈
      Ioo (rootValue p hp a b hab r) (rootValue p hp a b hab s) := by
  obtain ⟨hr, hs, hrs, _⟩ := Dense.rankPairs_properties
    (isolate_ranks_sorted p hp a b hab.le) hpair
  exact Dense.betweenRanks_correct _ hab hr hs hrs
    (rootValue_spec p hp a b hab hr) (rootValue_spec p hp a b hab hs)

theorem rootValue_gap_no_root {r s : ℕ}
    (hpair : (r,s) ∈ consecutiveRanks (isolate p hp a b hab.le)) :
    ∀ x ∈ Ioo (rootValue p hp a b hab r) (rootValue p hp a b hab s),
      realEval (Dense.denote p) x ≠ 0 := by
  obtain ⟨hr, hs, _, hcon⟩ := Dense.rankPairs_properties
    (isolate_ranks_sorted p hp a b hab.le) hpair
  have hn := Dense.no_root_between_consecutive_ranks _ hab
    (isolate_mesh_certified p hp a b hab.le) hr hs hcon
    (rootValue_spec p hp a b hab hr) (rootValue_spec p hp a b hab hs)
  intro x hx hz
  exact hn x hx ((isolate_root_iff p hp a b hab.le x).mpr (Or.inl hz))

theorem rootValue_gap_cover {x : ℝ} (hx : x ∈ Ioo (a : ℝ) (b : ℝ))
    (hn : realEval (Dense.denote p) x ≠ 0) :
    ∃ r s, (r,s) ∈ consecutiveRanks (isolate p hp a b hab.le) ∧
      x ∈ Ioo (rootValue p hp a b hab r) (rootValue p hp a b hab s) := by
  have habR : (a : ℝ) ≤ (b : ℝ) := by exact_mod_cast hab.le
  obtain ⟨r, hr, hrv⟩ := rootValue_complete p hp a b hab
    ⟨le_rfl, habR⟩ (Or.inr (Or.inl rfl))
  obtain ⟨s, hs, hsv⟩ := rootValue_complete p hp a b hab
    ⟨habR, le_rfl⟩ (Or.inr (Or.inr rfl))
  apply Dense.exists_rankPair_bracket _ _ x (rootValues_sorted p hp a b hab)
  · exact ⟨r, hr, hrv ▸ hx.1⟩
  · exact ⟨s, hs, hsv ▸ hx.2⟩
  · intro t ht hxt
    have hz := rootValue_is_root p hp a b hab ht
    rw [← hxt] at hz
    rcases (isolate_root_iff p hp a b hab.le x).mp hz with hz | ha | hb
    · exact hn hz
    · exact (ne_of_gt hx.1) ha
    · exact (ne_of_lt hx.2) hb

end
end C2.CADDriver

end

/- ===== C2.CADEffectiveLeading ===== -/

/-! Executable coefficient selection and gamma specialization for dense
bivariate polynomials. All runtime operations are finite list/rational arithmetic. -/
namespace C2.CADEffective.Bivariate
open Polynomial

/-- Highest semantically nonzero gamma coefficient; inner zero lists may have
arbitrary trailing zeros, so they are tested with the proved dense equality test. -/
def leadingCoeff : Poly → Dense.Poly
  | [] => []
  | a :: p =>
      let b := leadingCoeff p
      if Dense.eqb b [] then a else b

/-- Horner specialization in gamma, leaving an executable gain polynomial. -/
def gammaEval : Poly → ℚ → Dense.Poly
  | [], _ => []
  | a :: p, g => Dense.add a (Dense.scale g (gammaEval p g))

@[simp] theorem denote_gammaEval (p : Poly) (g : ℚ) :
    Dense.denote (gammaEval p g) = (denote p).eval (C g) := by
  induction p with
  | nil => simp [gammaEval]
  | cons a p ih => simp [gammaEval, ih]

@[simp] theorem denote_leadingCoeff (p : Poly) :
    Dense.denote (leadingCoeff p) = (denote p).leadingCoeff := by
  induction p with
  | nil => simp [leadingCoeff]
  | cons a p ih =>
      change Dense.denote (if Dense.eqb (leadingCoeff p) [] then a else leadingCoeff p) =
        (C (Dense.denote a) + X * denote p).leadingCoeff
      split_ifs with ht
      · have he : (denote p).leadingCoeff = 0 := by
          simpa only [ih, Dense.denote_nil] using
            (Dense.eqb_eq_true_iff (leadingCoeff p) []).mp ht
        have hp : denote p = 0 := Polynomial.leadingCoeff_eq_zero.mp he
        simp [hp]
      · have hp : denote p ≠ 0 := by
          intro h
          apply ht
          apply (Dense.eqb_eq_true_iff (leadingCoeff p) []).mpr
          simp only [ih, h, Polynomial.leadingCoeff_zero, Dense.denote_nil]
        have hxp : (X * denote p : Polynomial (Polynomial ℚ)) ≠ 0 :=
          mul_ne_zero Polynomial.X_ne_zero hp
        have hd : (C (Dense.denote a) : Polynomial (Polynomial ℚ)).degree <
            (X * denote p).degree := by
          have hpos : (0 : WithBot ℕ) < (X * denote p).degree := by
            rw [Polynomial.degree_eq_natDegree hxp, Polynomial.natDegree_X_mul hp]
            exact_mod_cast Nat.succ_pos (denote p).natDegree
          exact lt_of_le_of_lt Polynomial.degree_C_le hpos
        rw [ih, Polynomial.leadingCoeff_add_of_degree_lt hd,
          Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_X, one_mul]

/-- Nonzero tests on the selected gain coefficient agree with nonzero
mathematical bivariate polynomials. -/
theorem leadingCoeff_eqb_zero_iff (p : Poly) :
    Dense.eqb (leadingCoeff p) [] = true ↔ denote p = 0 := by
  rw [Dense.eqb_eq_true_iff, denote_leadingCoeff, Dense.denote_nil,
    Polynomial.leadingCoeff_eq_zero]

/-- Endpoint gain polynomials are computed by the same Horner routine. -/
theorem gammaEval_zero (p : Poly) :
    Dense.denote (gammaEval p 0) = (denote p).eval 0 := by
  simpa using denote_gammaEval p 0

theorem gammaEval_one (p : Poly) :
    Dense.denote (gammaEval p 1) = (denote p).eval 1 := by
  simpa using denote_gammaEval p 1

end C2.CADEffective.Bivariate


/- ===== C2.CADProjectionBezout ===== -/

/-! Polynomial projection by denominator-cleared Bezout identities.
These results prove nonzero projection cuts from generic coprimeness; no
regularity of specialized roots is assumed. -/

noncomputable section
open Polynomial
namespace C2.CADProjection

section FractionField
variable {R F : Type*} [CommRing R] [IsDomain R] [Field F]
  [Algebra R F] [IsFractionRing R F]

/-- A polynomial over the fraction field has a nonzero common denominator. -/
theorem exists_clear_denominator (p : F[X]) :
    ∃ b : R, b ≠ 0 ∧ ∃ q : R[X],
      q.map (algebraMap R F) = C (algebraMap R F b) * p := by
  obtain ⟨b, hb⟩ := IsLocalization.integerNormalization_map_to_map
    (nonZeroDivisors R) p
  refine ⟨b, nonZeroDivisors.ne_zero b.property, IsLocalization.integerNormalization
    (nonZeroDivisors R) p, ?_⟩
  rw [hb]
  ext n
  simp [Algebra.smul_def]

/-- Coprimeness over the gain fraction field gives an actual nonzero
polynomial in the gain lying in the original polynomial ideal. -/
theorem exists_bezout_eliminant (p q : R[X])
    (h : IsCoprime (p.map (algebraMap R F)) (q.map (algebraMap R F))) :
    ∃ r : R, r ≠ 0 ∧ ∃ u v : R[X], u*p + v*q = C r := by
  obtain ⟨a,b,hab⟩ := h
  obtain ⟨s,hs,a0,ha⟩ := exists_clear_denominator (R:=R) a
  obtain ⟨t,ht,b0,hb⟩ := exists_clear_denominator (R:=R) b
  refine ⟨s*t,mul_ne_zero hs ht,C t*a0,C s*b0,?_⟩
  apply Polynomial.map_injective (f := algebraMap R F) (IsFractionRing.injective R F)
  simp only [Polynomial.map_add,Polynomial.map_mul,Polynomial.map_C]
  rw [ha,hb]
  calc
    C (algebraMap R F t) * (C (algebraMap R F s) * a) * p.map (algebraMap R F) +
        C (algebraMap R F s) * (C (algebraMap R F t) * b) * q.map (algebraMap R F)
        = C (algebraMap R F (s*t)) *
            (a*p.map (algebraMap R F) + b*q.map (algebraMap R F)) := by
              rw [map_mul, Polynomial.C_mul]
              ring
    _ = C (algebraMap R F (s*t)) := by rw [hab,mul_one]

end FractionField

/-- Any specialization away from a Bezout eliminant has no common root. -/
theorem no_common_root_of_bezout {R S : Type*} [CommRing R] [CommRing S]
    {p q u v : R[X]} {r : R} (h : u*p + v*q = C r)
    (f : R →+* S) (hr : f r ≠ 0) (x : S) :
    (p.map f).eval x ≠ 0 ∨ (q.map f).eval x ≠ 0 := by
  by_contra! hh
  have he := congrArg (fun P : R[X] => (P.map f).eval x) h
  simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
    Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
    hh.1,hh.2,mul_zero,add_zero] at he
  exact hr he.symm

/-- Generic coprimeness produces a nonzero cut excluding every collision
under every field specialization away from that cut. -/
theorem exists_collision_cut {R F : Type*} [CommRing R] [IsDomain R] [Field F]
    [Algebra R F] [IsFractionRing R F] (p q : R[X])
    (h : IsCoprime (p.map (algebraMap R F)) (q.map (algebraMap R F))) :
    ∃ r : R, r ≠ 0 ∧ ∀ {S : Type*} [CommRing S] (f : R →+* S),
      f r ≠ 0 → ∀ x : S, (p.map f).eval x ≠ 0 ∨ (q.map f).eval x ≠ 0 := by
  obtain ⟨r,hr,u,v,hid⟩ := exists_bezout_eliminant p q h
  exact ⟨r,hr,fun f hf x => no_common_root_of_bezout hid f hf x⟩

/-- Generic separability supplies a gain cut away from which every actual
specialized root is simple. -/
theorem exists_simple_root_cut {R F : Type*} [CommRing R] [IsDomain R] [Field F]
    [Algebra R F] [IsFractionRing R F] (p : R[X])
    (h : (p.map (algebraMap R F)).Separable) :
    ∃ r : R, r ≠ 0 ∧ ∀ {S : Type*} [CommRing S] (f : R →+* S),
      f r ≠ 0 → ∀ x : S, (p.map f).eval x = 0 →
        (p.map f).derivative.eval x ≠ 0 := by
  have hc : IsCoprime (p.map (algebraMap R F))
      (p.derivative.map (algebraMap R F)) := by
    simpa only [Polynomial.derivative_map] using (Polynomial.separable_def _).mp h
  obtain ⟨r,hr,hcut⟩ := exists_collision_cut p p.derivative hc
  refine ⟨r,hr,fun f hf x hx => ?_⟩
  have hn := (hcut f hf x).resolve_left (not_not.mpr hx)
  simpa only [Polynomial.derivative_map] using hn

end C2.CADProjection

end

/- ===== C2.CADProjectionRegularity ===== -/

/-! A finite algebraic exceptional set for rational bivariate polynomials.
The exceptional polynomial is derived from generic separability through the
proved Bezout construction. These are mathematical projection results; the
choice of the Bezout coefficients is not advertised as executable code. -/
noncomputable section
open Polynomial
namespace C2.CADProjection

abbrev Bivariate := Polynomial (Polynomial ℚ)

def specialize (p : Bivariate) (k : ℝ) : ℝ[X] :=
  p.map (Polynomial.eval₂RingHom (algebraMap ℚ ℝ) k)

def value (p : Bivariate) (k x : ℝ) : ℝ := (specialize p k).eval x

def RegularAt (p : Bivariate) (k : ℝ) : Prop :=
  (specialize p k).natDegree = p.natDegree ∧
  ∀ x : ℝ, value p k x = 0 → (specialize p k).derivative.eval x ≠ 0

@[simp] theorem value_derivative (p : Bivariate) (k x : ℝ) :
    value p.derivative k x = (specialize p k).derivative.eval x := by
  simp only [value, specialize, Polynomial.derivative_map]

@[simp] theorem value_mul (p q : Bivariate) (k x : ℝ) :
    value (p*q) k x = value p k x * value q k x := by
  simp [value,specialize]

@[simp] theorem value_X (k x : ℝ) : value (X : Bivariate) k x = x := by
  simp [value,specialize]

@[simp] theorem value_C (p : ℚ[X]) (k x : ℝ) :
    value (C p) k x = p.eval₂ (algebraMap ℚ ℝ) k := by
  simp [value,specialize]

@[simp] theorem value_sub (p q : Bivariate) (k x : ℝ) :
    value (p-q) k x = value p k x - value q k x := by
  simp [value,specialize]

/-- Joint continuity in the gain and parameter, without any root hypotheses. -/
theorem continuous_value (p : Bivariate) :
    Continuous (fun y : ℝ × ℝ => value p y.1 y.2) := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      simpa [value,specialize] using hp.add hq
  | monomial n a =>
      simpa [value,specialize] using
        ((a.continuous_eval₂ (algebraMap ℚ ℝ)).comp continuous_fst).mul
          (continuous_snd.pow n)

/-- A nonzero rational polynomial has finitely many real zeros. -/
theorem rational_zero_set_finite (p : ℚ[X]) (hp : p ≠ 0) :
    Set.Finite {k : ℝ | p.eval₂ (algebraMap ℚ ℝ) k = 0} := by
  have hm : p.map (algebraMap ℚ ℝ) ≠ 0 := by
    intro h
    exact hp ((Polynomial.map_injective (f:=algebraMap ℚ ℝ)
      (algebraMap ℚ ℝ).injective) (by simpa using h))
  simpa only [Polynomial.IsRoot,Polynomial.eval_map] using
    Polynomial.finite_setOf_isRoot hm

/-- Every zero of the projection polynomial is a real algebraic number. -/
theorem rational_zero_isAlgebraic (p : ℚ[X]) (hp : p ≠ 0) {k : ℝ}
    (hk : p.eval₂ (algebraMap ℚ ℝ) k = 0) : IsAlgebraic ℚ k :=
  ⟨p,hp,hk⟩

/-- A separable generic polynomial admits one nonzero rational gain
polynomial excluding all degree losses and all multiple specialized roots. -/
theorem exists_regular_projection (p : Bivariate) (hp : p ≠ 0)
    (hsep : (p.map (algebraMap ℚ[X] (RatFunc ℚ))).Separable) :
    ∃ d : ℚ[X], d ≠ 0 ∧
      Set.Finite {k : ℝ | d.eval₂ (algebraMap ℚ ℝ) k = 0} ∧
      (∀ k : ℝ, d.eval₂ (algebraMap ℚ ℝ) k = 0 → IsAlgebraic ℚ k) ∧
      ∀ k : ℝ, d.eval₂ (algebraMap ℚ ℝ) k ≠ 0 → RegularAt p k := by
  obtain ⟨r,hr,hcut⟩ := exists_simple_root_cut p hsep
  let d := p.leadingCoeff * r
  have hd : d ≠ 0 := mul_ne_zero (Polynomial.leadingCoeff_ne_zero.mpr hp) hr
  refine ⟨d,hd,rational_zero_set_finite d hd,fun k hk =>
    rational_zero_isAlgebraic d hd hk,fun k hk => ?_⟩
  have hparts : p.leadingCoeff.eval₂ (algebraMap ℚ ℝ) k ≠ 0 ∧
      r.eval₂ (algebraMap ℚ ℝ) k ≠ 0 := by
    simpa only [d,Polynomial.eval₂_mul,mul_ne_zero_iff] using hk
  refine ⟨?_,fun x hx => ?_⟩
  · exact Polynomial.natDegree_map_eq_iff.mpr (Or.inl hparts.1)
  · exact hcut (Polynomial.eval₂RingHom (algebraMap ℚ ℝ) k) hparts.2 x hx

/-- Additional denominators or gain-only factors can be added to the
projection without invalidating the proved generic-root regularity. -/
theorem exists_regular_projection_with_extra (p : Bivariate) (hp : p ≠ 0)
    (hsep : (p.map (algebraMap ℚ[X] (RatFunc ℚ))).Separable)
    (a : ℚ[X]) (ha : a ≠ 0) :
    ∃ d : ℚ[X], d ≠ 0 ∧
      Set.Finite {k : ℝ | d.eval₂ (algebraMap ℚ ℝ) k = 0} ∧
      (∀ k : ℝ, d.eval₂ (algebraMap ℚ ℝ) k = 0 → IsAlgebraic ℚ k) ∧
      ∀ k : ℝ, d.eval₂ (algebraMap ℚ ℝ) k ≠ 0 →
        a.eval₂ (algebraMap ℚ ℝ) k ≠ 0 ∧ RegularAt p k := by
  obtain ⟨d,hd,_,_,hreg⟩ := exists_regular_projection p hp hsep
  refine ⟨a*d,mul_ne_zero ha hd,rational_zero_set_finite _ (mul_ne_zero ha hd),
    fun k hk => rational_zero_isAlgebraic _ (mul_ne_zero ha hd) hk,fun k hk => ?_⟩
  have hx : a.eval₂ (algebraMap ℚ ℝ) k ≠ 0 ∧ d.eval₂ (algebraMap ℚ ℝ) k ≠ 0 := by
    simpa only [Polynomial.eval₂_mul,mul_ne_zero_iff] using hk
  exact ⟨hx.1,hreg k hx.2⟩

end C2.CADProjection

end

/- ===== C2.CADProjectionFamily ===== -/

/-! A common projection for a finite simple coprime bivariate basis. -/
noncomputable section
open Polynomial
namespace C2.CADProjection

/-- Specializing the gain commutes with evaluation at the fixed parameter 0. -/
@[simp] theorem value_zero (p : Bivariate) (k : ℝ) :
    value p k 0 = (p.eval 0).eval₂ (algebraMap ℚ ℝ) k := by
  simp [value,specialize]

/-- Specializing the gain commutes with evaluation at the fixed parameter 1. -/
@[simp] theorem value_one (p : Bivariate) (k : ℝ) :
    value p k 1 = (p.eval 1).eval₂ (algebraMap ℚ ℝ) k := by
  simp only [value,specialize,Polynomial.eval_map]
  exact Polynomial.eval₂_at_one _

/-- Finite basis regularity needed for sign-invariant parameter cells. -/
def RegularFamilyAt {ι : Type*} (p : ι → Bivariate) (k : ℝ) : Prop :=
  (∀ i, RegularAt (p i) k ∧ value (p i) k 0 ≠ 0 ∧ value (p i) k 1 ≠ 0) ∧
  ∀ i j, i ≠ j → ∀ x : ℝ, value (p i) k x ≠ 0 ∨ value (p j) k x ≠ 0

/-- Finitely many generic simple coprime factors admit one actual nonzero
rational gain polynomial whose complement satisfies every root-regularity
condition. Endpoints are handled by the explicit evaluated factors. -/
theorem exists_family_projection {ι : Type*} [Fintype ι]
    (p : ι → Bivariate) (hp : ∀ i, p i ≠ 0)
    (hsep : ∀ i, ((p i).map (algebraMap ℚ[X] (RatFunc ℚ))).Separable)
    (hpair : ∀ i j, i ≠ j → IsCoprime
      ((p i).map (algebraMap ℚ[X] (RatFunc ℚ)))
      ((p j).map (algebraMap ℚ[X] (RatFunc ℚ))))
    (hzero : ∀ i, (p i).eval 0 ≠ 0) (hone : ∀ i, (p i).eval 1 ≠ 0) :
    ∃ d : ℚ[X], d ≠ 0 ∧
      Set.Finite {k : ℝ | d.eval₂ (algebraMap ℚ ℝ) k = 0} ∧
      (∀ k : ℝ, d.eval₂ (algebraMap ℚ ℝ) k = 0 → IsAlgebraic ℚ k) ∧
      ∀ k : ℝ, d.eval₂ (algebraMap ℚ ℝ) k ≠ 0 → RegularFamilyAt p k := by
  classical
  have hi : ∀ i, ∃ d : ℚ[X], d ≠ 0 ∧ ∀ k : ℝ,
      d.eval₂ (algebraMap ℚ ℝ) k ≠ 0 →
        RegularAt (p i) k ∧ value (p i) k 0 ≠ 0 ∧ value (p i) k 1 ≠ 0 := by
    intro i
    obtain ⟨d,hd,_,_,hreg⟩ := exists_regular_projection_with_extra
      (p i) (hp i) (hsep i) ((p i).eval 0 * (p i).eval 1)
      (mul_ne_zero (hzero i) (hone i))
    refine ⟨d,hd,fun k hk => ?_⟩
    obtain ⟨ha,hr⟩ := hreg k hk
    have he : ((p i).eval 0).eval₂ (algebraMap ℚ ℝ) k ≠ 0 ∧
        ((p i).eval 1).eval₂ (algebraMap ℚ ℝ) k ≠ 0 := by
      simpa only [Polynomial.eval₂_mul,mul_ne_zero_iff] using ha
    exact ⟨hr,by simpa only [value_zero] using he.1,
      by simpa only [value_one] using he.2⟩
  choose d hd hdi using hi
  have hij : ∀ i j, ∃ e : ℚ[X], e ≠ 0 ∧ ∀ k : ℝ,
      e.eval₂ (algebraMap ℚ ℝ) k ≠ 0 → i ≠ j →
        ∀ x : ℝ, value (p i) k x ≠ 0 ∨ value (p j) k x ≠ 0 := by
    intro i j
    by_cases heq : i = j
    · exact ⟨1,one_ne_zero,fun _ _ hne => False.elim (hne heq)⟩
    · obtain ⟨e,he,hcut⟩ := exists_collision_cut (p i) (p j) (hpair i j heq)
      exact ⟨e,he,fun k hk _ x => hcut
        (Polynomial.eval₂RingHom (algebraMap ℚ ℝ) k) hk x⟩
  choose e he hei using hij
  let D : ℚ[X] := (∏ i, d i) * ∏ i, ∏ j, e i j
  have hD : D ≠ 0 := mul_ne_zero
    (Finset.prod_ne_zero_iff.mpr (fun i _ => hd i))
    (Finset.prod_ne_zero_iff.mpr (fun i _ =>
      Finset.prod_ne_zero_iff.mpr (fun j _ => he i j)))
  refine ⟨D,hD,rational_zero_set_finite D hD,
    fun k hk => rational_zero_isAlgebraic D hD hk,fun k hk => ?_⟩
  let f : ℚ[X] →+* ℝ := Polynomial.eval₂RingHom (algebraMap ℚ ℝ) k
  have hDk : (∏ i, f (d i)) * (∏ i, ∏ j, f (e i j)) ≠ 0 := by
    have hfk : f D ≠ 0 := hk
    simpa only [D,map_mul,map_prod] using hfk
  obtain ⟨hdk,hek⟩ := mul_ne_zero_iff.mp hDk
  refine ⟨fun i => hdi i k ?_,fun i j hij x => hei i j k ?_ hij x⟩
  · exact Finset.prod_ne_zero_iff.mp hdk i (Finset.mem_univ i)
  · exact Finset.prod_ne_zero_iff.mp
      (Finset.prod_ne_zero_iff.mp hek i (Finset.mem_univ i)) j (Finset.mem_univ j)

/-- Arbitrary additional rational cuts preserve finite-family regularity. -/
theorem exists_family_projection_with_extra {ι : Type*} [Fintype ι]
    (p : ι → Bivariate) (hp : ∀ i, p i ≠ 0)
    (hsep : ∀ i, ((p i).map (algebraMap ℚ[X] (RatFunc ℚ))).Separable)
    (hpair : ∀ i j, i ≠ j → IsCoprime
      ((p i).map (algebraMap ℚ[X] (RatFunc ℚ)))
      ((p j).map (algebraMap ℚ[X] (RatFunc ℚ))))
    (hzero : ∀ i, (p i).eval 0 ≠ 0) (hone : ∀ i, (p i).eval 1 ≠ 0)
    (a : ℚ[X]) (ha : a ≠ 0) :
    ∃ d : ℚ[X], d ≠ 0 ∧
      Set.Finite {k : ℝ | d.eval₂ (algebraMap ℚ ℝ) k = 0} ∧
      (∀ k : ℝ, d.eval₂ (algebraMap ℚ ℝ) k = 0 → IsAlgebraic ℚ k) ∧
      ∀ k : ℝ, d.eval₂ (algebraMap ℚ ℝ) k ≠ 0 →
        a.eval₂ (algebraMap ℚ ℝ) k ≠ 0 ∧ RegularFamilyAt p k := by
  obtain ⟨d,hd,_,_,hreg⟩ := exists_family_projection p hp hsep hpair hzero hone
  refine ⟨a*d,mul_ne_zero ha hd,rational_zero_set_finite _ (mul_ne_zero ha hd),
    fun k hk => rational_zero_isAlgebraic _ (mul_ne_zero ha hd) hk,fun k hk => ?_⟩
  have hx : a.eval₂ (algebraMap ℚ ℝ) k ≠ 0 ∧ d.eval₂ (algebraMap ℚ ℝ) k ≠ 0 := by
    simpa only [Polynomial.eval₂_mul,mul_ne_zero_iff] using hk
  exact ⟨hx.1,hreg k hx.2⟩

end C2.CADProjection

end

/- ===== C2.CADProjectionWitness ===== -/

/-! Finite algebraic projection data. Validity consists of rational polynomial
identities and nonzero tests, suitable for exact verification of finite data. -/
noncomputable section
open Polynomial
namespace C2.CADProjection

structure ProjectionData (ι : Type*) where
  simple : ι → ℚ[X]
  simpleU : ι → Bivariate
  simpleV : ι → Bivariate
  pair : ι → ι → ℚ[X]
  pairU : ι → ι → Bivariate
  pairV : ι → ι → Bivariate

def ValidProjectionData {ι : Type*} (p : ι → Bivariate) (w : ProjectionData ι) : Prop :=
  (∀ i, (p i).leadingCoeff ≠ 0 ∧ (p i).eval 0 ≠ 0 ∧ (p i).eval 1 ≠ 0 ∧
    w.simple i ≠ 0 ∧ w.simpleU i * p i + w.simpleV i * (p i).derivative = C (w.simple i)) ∧
  (∀ i j, w.pair i j ≠ 0 ∧ (i ≠ j →
    w.pairU i j * p i + w.pairV i j * p j = C (w.pair i j)))

def projectionCut {ι : Type*} [Fintype ι] (p : ι → Bivariate) (w : ProjectionData ι) : ℚ[X] :=
  (∏ i, (p i).leadingCoeff * (p i).eval 0 * (p i).eval 1 * w.simple i) *
    ∏ i, ∏ j, w.pair i j

/-- Generic separability and coprimeness yield finite algebraic data; neither
root regularity nor algorithm output correctness is an assumption. -/
theorem exists_valid_projection_data {ι : Type*} (p : ι → Bivariate)
    (hp : ∀ i, p i ≠ 0)
    (hsep : ∀ i, ((p i).map (algebraMap ℚ[X] (RatFunc ℚ))).Separable)
    (hpair : ∀ i j, i ≠ j → IsCoprime
      ((p i).map (algebraMap ℚ[X] (RatFunc ℚ)))
      ((p j).map (algebraMap ℚ[X] (RatFunc ℚ))))
    (hzero : ∀ i, (p i).eval 0 ≠ 0) (hone : ∀ i, (p i).eval 1 ≠ 0) :
    ∃ w : ProjectionData ι, ValidProjectionData p w := by
  classical
  have hsi : ∀ i, ∃ r : ℚ[X], r ≠ 0 ∧ ∃ u v : Bivariate,
      u*p i + v*(p i).derivative = C r := by
    intro i
    apply exists_bezout_eliminant (F:=RatFunc ℚ)
    simpa only [Polynomial.derivative_map] using (Polynomial.separable_def _).mp (hsep i)
  choose s hs su sv hid using hsi
  have hpi : ∀ i j, ∃ r : ℚ[X], r ≠ 0 ∧ ∃ u v : Bivariate,
      i ≠ j → u*p i + v*p j = C r := by
    intro i j
    by_cases hij : i = j
    · exact ⟨1,one_ne_zero,0,0,fun h => False.elim (h hij)⟩
    · obtain ⟨r,hr,u,v,hid⟩ := exists_bezout_eliminant (p i) (p j) (hpair i j hij)
      exact ⟨r,hr,u,v,fun _ => hid⟩
  choose r hr ru rv hpid using hpi
  refine ⟨⟨s,su,sv,r,ru,rv⟩,?_,?_⟩
  · intro i
    exact ⟨Polynomial.leadingCoeff_ne_zero.mpr (hp i),hzero i,hone i,hs i,hid i⟩
  · intro i j
    exact ⟨hr i j,hpid i j⟩

/-- Exact validity of the finite data proves its projection polynomial nonzero. -/
theorem ValidProjectionData.cut_ne_zero {ι : Type*} [Fintype ι]
    {p : ι → Bivariate} {w : ProjectionData ι} (h : ValidProjectionData p w) :
    projectionCut p w ≠ 0 := by
  apply mul_ne_zero
  · apply Finset.prod_ne_zero_iff.mpr
    intro i _
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero (h.1 i).1 (h.1 i).2.1)
      (h.1 i).2.2.1) (h.1 i).2.2.2.1
  · apply Finset.prod_ne_zero_iff.mpr
    intro i _
    exact Finset.prod_ne_zero_iff.mpr (fun j _ => (h.2 i j).1)

/-- The accepted finite identities imply concrete simple/disjoint roots at
every gain outside the actual computed product of their cuts. -/
theorem ValidProjectionData.regular {ι : Type*} [Fintype ι]
    {p : ι → Bivariate} {w : ProjectionData ι} (h : ValidProjectionData p w)
    (k : ℝ) (hk : (projectionCut p w).eval₂ (algebraMap ℚ ℝ) k ≠ 0) :
    RegularFamilyAt p k := by
  let f : ℚ[X] →+* ℝ := Polynomial.eval₂RingHom (algebraMap ℚ ℝ) k
  have hfk : f (projectionCut p w) ≠ 0 := hk
  have hprod :
      (∏ i, f (p i).leadingCoeff * f ((p i).eval 0) *
        f ((p i).eval 1) * f (w.simple i)) ≠ 0 ∧
      (∏ i, ∏ j, f (w.pair i j)) ≠ 0 := by
    simpa only [projectionCut,map_mul,map_prod,mul_ne_zero_iff] using hfk
  have hi : ∀ i, f (p i).leadingCoeff ≠ 0 ∧ f ((p i).eval 0) ≠ 0 ∧
      f ((p i).eval 1) ≠ 0 ∧ f (w.simple i) ≠ 0 := by
    intro i
    have hh := Finset.prod_ne_zero_iff.mp hprod.1 i (Finset.mem_univ i)
    simpa only [mul_ne_zero_iff,and_assoc] using hh
  refine ⟨fun i => ⟨⟨?_,?_⟩,?_,?_⟩,?_⟩
  · exact Polynomial.natDegree_map_eq_iff.mpr (Or.inl (hi i).1)
  · intro x hx
    have hh := no_common_root_of_bezout (h.1 i).2.2.2.2 f (hi i).2.2.2 x
    have hd := hh.resolve_left (not_not.mpr hx)
    change ((p i).map f).derivative.eval x ≠ 0
    simpa only [Polynomial.derivative_map] using hd
  · simpa only [value_zero] using (hi i).2.1
  · simpa only [value_one] using (hi i).2.2.1
  · intro i j hij x
    have hn := Finset.prod_ne_zero_iff.mp
      (Finset.prod_ne_zero_iff.mp hprod.2 i (Finset.mem_univ i)) j (Finset.mem_univ j)
    exact no_common_root_of_bezout ((h.2 i j).2 hij) f hn x

/-- All exceptional gains of valid projection data form a finite algebraic set. -/
theorem ValidProjectionData.finite_algebraic_exceptions {ι : Type*} [Fintype ι]
    {p : ι → Bivariate} {w : ProjectionData ι} (h : ValidProjectionData p w) :
    Set.Finite {k : ℝ | (projectionCut p w).eval₂ (algebraMap ℚ ℝ) k = 0} ∧
    ∀ k : ℝ, (projectionCut p w).eval₂ (algebraMap ℚ ℝ) k = 0 → IsAlgebraic ℚ k :=
  ⟨rational_zero_set_finite _ h.cut_ne_zero,
    fun _ hk => rational_zero_isAlgebraic _ h.cut_ne_zero hk⟩

end C2.CADProjection

end

/- ===== C2.CADFactorBasis ===== -/

/-! Finite common separable factor bases, with fixed endpoint factors removed.
This is a classical existence theorem used to justify a finite witness search;
`normalizedFactors` is not presented as an executable factorization routine. -/
noncomputable section
open Polynomial UniqueFactorizationMonoid
open scoped BigOperators
namespace C2.CADFactor

variable {F : Type*} [Field F] [DecidableEq F] [CharZero F]
variable {ι : Type*} [Fintype ι]

def factorBasis (f : ι → F[X]) : Finset F[X] :=
  insert X (insert (X - 1) (Finset.univ.biUnion fun i => (normalizedFactors (f i)).toFinset))

def interiorBasis (f : ι → F[X]) : Finset F[X] :=
  ((factorBasis f).erase X).erase (X - 1)

def factorExponent (f : ι → F[X]) (i : ι) (q : F[X]) : ℕ :=
  (normalizedFactors (f i)).count q

theorem normalized_factor_monic {p q : F[X]} (hq : q ∈ normalizedFactors p) : q.Monic := by
  have hn := normalize_normalized_factor q hq
  have hm := Polynomial.monic_normalize (irreducible_of_normalized_factor q hq).ne_zero
  rwa [hn] at hm

theorem factorBasis_irreducible (f : ι → F[X]) {q : F[X]} (hq : q ∈ factorBasis f) :
    Irreducible q := by
  simp only [factorBasis, Finset.mem_insert, Finset.mem_biUnion, Finset.mem_univ,
    true_and, Multiset.mem_toFinset] at hq
  rcases hq with rfl | rfl | ⟨i, hi⟩
  · exact irreducible_X
  · simpa using irreducible_X_sub_C (1 : F)
  · exact irreducible_of_normalized_factor q hi

theorem factorBasis_monic (f : ι → F[X]) {q : F[X]} (hq : q ∈ factorBasis f) :
    q.Monic := by
  simp only [factorBasis, Finset.mem_insert, Finset.mem_biUnion, Finset.mem_univ,
    true_and, Multiset.mem_toFinset] at hq
  rcases hq with rfl | rfl | ⟨i, hi⟩
  · exact monic_X
  · simpa using monic_X_sub_C (1 : F)
  · exact normalized_factor_monic hi

theorem monic_irreducibles_coprime {p q : F[X]} (hp : Irreducible p)
    (hq : Irreducible q) (hpm : p.Monic) (hqm : q.Monic) (hne : p ≠ q) :
    IsCoprime p q := by
  apply hp.coprime_iff_not_dvd.mpr
  intro hd
  exact hne (eq_of_monic_of_associated hpm hqm
    (associated_of_dvd_dvd hd (hp.dvd_symm hq hd)))

theorem factorBasis_pairwise_coprime (f : ι → F[X]) {p q : F[X]}
    (hp : p ∈ factorBasis f) (hq : q ∈ factorBasis f) (hne : p ≠ q) :
    IsCoprime p q :=
  monic_irreducibles_coprime (factorBasis_irreducible f hp)
    (factorBasis_irreducible f hq) (factorBasis_monic f hp) (factorBasis_monic f hq) hne

theorem mem_interiorBasis {f : ι → F[X]} {q : F[X]} (hq : q ∈ interiorBasis f) :
    q ∈ factorBasis f ∧ q ≠ X ∧ q ≠ X - 1 := by
  simpa only [interiorBasis, Finset.mem_erase, and_assoc, and_left_comm, and_comm] using hq

theorem interiorBasis_separable (f : ι → F[X]) {q : F[X]} (hq : q ∈ interiorBasis f) :
    q.Separable :=
  (factorBasis_irreducible f (mem_interiorBasis hq).1).separable

theorem interiorBasis_nonzero (f : ι → F[X]) {q : F[X]} (hq : q ∈ interiorBasis f) :
    q ≠ 0 :=
  (factorBasis_irreducible f (mem_interiorBasis hq).1).ne_zero

theorem interiorBasis_pairwise_coprime (f : ι → F[X]) {p q : F[X]}
    (hp : p ∈ interiorBasis f) (hq : q ∈ interiorBasis f) (hne : p ≠ q) :
    IsCoprime p q :=
  factorBasis_pairwise_coprime f (mem_interiorBasis hp).1 (mem_interiorBasis hq).1 hne

theorem interiorBasis_endpoint_ne_zero (f : ι → F[X]) {q : F[X]}
    (hq : q ∈ interiorBasis f) : q.eval 0 ≠ 0 ∧ q.eval 1 ≠ 0 := by
  have hq' := mem_interiorBasis hq
  have hi := factorBasis_irreducible f hq'.1
  have hm := factorBasis_monic f hq'.1
  constructor
  · intro h
    have hd : (X - C (0 : F)) ∣ q := dvd_iff_isRoot.mpr h
    have he := eq_of_monic_of_associated (monic_X_sub_C (0 : F)) hm
      (associated_of_dvd_dvd hd ((irreducible_X_sub_C (0 : F)).dvd_symm hi hd))
    apply hq'.2.1
    simpa using he.symm
  · intro h
    have hd : (X - C (1 : F)) ∣ q := dvd_iff_isRoot.mpr h
    have he := eq_of_monic_of_associated (monic_X_sub_C (1 : F)) hm
      (associated_of_dvd_dvd hd ((irreducible_X_sub_C (1 : F)).dvd_symm hi hd))
    apply hq'.2.2
    simpa using he.symm

theorem factor_support_subset (f : ι → F[X]) (i : ι) :
    (normalizedFactors (f i)).toFinset ⊆ factorBasis f := by
  intro q hq
  apply Finset.mem_insert_of_mem
  apply Finset.mem_insert_of_mem
  exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, hq⟩

theorem factorization_full_basis (f : ι → F[X]) (i : ι) :
    f i = C (f i).leadingCoeff * ∏ q ∈ factorBasis f, q ^ factorExponent f i q := by
  dsimp only [factorExponent]
  rw [← Finset.prod_multiset_count_of_subset _ _ (factor_support_subset f i)]
  exact (Polynomial.leadingCoeff_mul_prod_normalizedFactors (f i)).symm

theorem X_sub_one_ne_X : (X - 1 : F[X]) ≠ X := by
  intro h
  have hh := congrArg (fun p : F[X] => p.eval 0) h
  norm_num at hh

theorem factorization_interior_basis (f : ι → F[X]) (i : ι) :
    f i = C (f i).leadingCoeff * X ^ factorExponent f i X *
      (X - 1) ^ factorExponent f i (X - 1) *
      ∏ q ∈ interiorBasis f, q ^ factorExponent f i q := by
  have hx : (X : F[X]) ∈ factorBasis f := by simp [factorBasis]
  have hx1 : (X - 1 : F[X]) ∈ (factorBasis f).erase X := by
    simp [factorBasis, X_sub_one_ne_X]
  have he1 := Finset.mul_prod_erase (factorBasis f) (fun q => q ^ factorExponent f i q) hx
  have he2 := Finset.mul_prod_erase ((factorBasis f).erase X)
    (fun q => q ^ factorExponent f i q) hx1
  calc
    f i = C (f i).leadingCoeff * ∏ q ∈ factorBasis f, q ^ factorExponent f i q :=
      factorization_full_basis f i
    _ = _ := by
      rw [← he1, ← he2]
      dsimp only [interiorBasis]
      ring

theorem interiorBasis_active (f : ι → F[X]) {q : F[X]} (hq : q ∈ interiorBasis f) :
    ∃ i, 0 < factorExponent f i q := by
  have hq' := mem_interiorBasis hq
  have hmem := hq'.1
  simp only [factorBasis, Finset.mem_insert, Finset.mem_biUnion, Finset.mem_univ,
    true_and, Multiset.mem_toFinset] at hmem
  rcases hmem with h | h | ⟨i, hi⟩
  · exact False.elim (hq'.2.1 h)
  · exact False.elim (hq'.2.2 h)
  · exact ⟨i, Multiset.count_pos.mpr hi⟩

/-- Complete finite basis specification. Zero input polynomials are explicitly
excluded only where nonzero unit coefficients are needed. -/
theorem exists_finite_interior_factor_basis (f : ι → F[X]) (hf : ∀ i, f i ≠ 0) :
    ∃ (S : Finset F[X]) (a b : ι → ℕ) (m : ι → F[X] → ℕ) (u : ι → F),
      (∀ i, u i ≠ 0) ∧
      (∀ q ∈ S, q.Monic ∧ q.Separable ∧ q.eval 0 ≠ 0 ∧ q.eval 1 ≠ 0) ∧
      (∀ p ∈ S, ∀ q ∈ S, p ≠ q → IsCoprime p q) ∧
      (∀ q ∈ S, ∃ i, 0 < m i q) ∧
      (∀ i, f i = C (u i) * X ^ a i * (X - 1) ^ b i * ∏ q ∈ S, q ^ m i q) := by
  refine ⟨interiorBasis f, (fun i => factorExponent f i X),
    (fun i => factorExponent f i (X - 1)), factorExponent f,
    (fun i => (f i).leadingCoeff), ?_, ?_, ?_, ?_, ?_⟩
  · intro i; exact leadingCoeff_ne_zero.mpr (hf i)
  · intro q hq
    exact ⟨factorBasis_monic f (mem_interiorBasis hq).1,
      interiorBasis_separable f hq, interiorBasis_endpoint_ne_zero f hq⟩
  · intro p hp q hq hne; exact interiorBasis_pairwise_coprime f hp hq hne
  · intro q hq; exact interiorBasis_active f hq
  · exact factorization_interior_basis f

end C2.CADFactor

end

/- ===== C2.CADFactorClearing ===== -/

/-! Exact polynomial identities after clearing a finite factor basis.
No evaluation homomorphism from a rational-function field at a gain is used. -/
noncomputable section
open Polynomial
open scoped BigOperators
namespace C2.CADFactor

variable {R K : Type*} [CommRing R] [IsDomain R] [Field K]
  [Algebra R K] [IsFractionRing R K]

theorem exists_clear_unit_multiple (P Q : R[X]) {u : K} (hu : u ≠ 0)
    (h : P.map (algebraMap R K) = C u * Q.map (algebraMap R K)) :
    ∃ r s : R, r ≠ 0 ∧ s ≠ 0 ∧ C r * P = C s * Q := by
  obtain ⟨s,r,hr,hsr⟩ := IsFractionRing.div_surjective (A:=R) u
  have hr0 : r ≠ 0 := nonZeroDivisors.ne_zero hr
  have hrK : algebraMap R K r ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hr
  have hs0 : s ≠ 0 := by
    intro hs
    apply hu
    rw [← hsr, hs, map_zero, zero_div]
  refine ⟨r,s,hr0,hs0,?_⟩
  apply Polynomial.map_injective (f:=algebraMap R K) (IsFractionRing.injective R K)
  simp only [Polynomial.map_mul, Polynomial.map_C]
  have he : algebraMap R K r * u = algebraMap R K s := by
    rw [← hsr]
    field_simp
  rw [h, ← mul_assoc, ← Polynomial.C_mul, he]

variable {J : Type*} [Fintype J]

/-- Clearing each factor and the scalar unit gives an actual identity over R,
with nonzero coefficient multipliers on both sides. -/
theorem exists_clear_factor_identity (P : R[X]) (q : J → K[X])
    (Q : J → R[X]) (d : J → R) (hd : ∀ j, d j ≠ 0)
    (hQ : ∀ j, (Q j).map (algebraMap R K) = C (algebraMap R K (d j)) * q j)
    (a b : ℕ) (m : J → ℕ) {u : K} (hu : u ≠ 0)
    (hP : P.map (algebraMap R K) =
      C u * X^a * (X-1)^b * ∏ j, (q j)^(m j)) :
    ∃ r s : R, r ≠ 0 ∧ s ≠ 0 ∧
      C r * P = C s * X^a * (X-1)^b * ∏ j, (Q j)^(m j) := by
  classical
  let D : R := ∏ j, d j ^ m j
  let H : K[X] := X^a * (X-1)^b * ∏ j, (q j)^(m j)
  let G : R[X] := X^a * (X-1)^b * ∏ j, (Q j)^(m j)
  have hD : D ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun j _ => pow_ne_zero _ (hd j))
  have hDK : algebraMap R K D ≠ 0 := by
    simpa only [map_zero] using (IsFractionRing.injective R K).ne hD
  have hprod : (∏ j, ((Q j).map (algebraMap R K)) ^ m j) =
      C (algebraMap R K D) * ∏ j, (q j) ^ m j := by
    simp only [hQ, mul_pow, Finset.prod_mul_distrib]
    congr 1
    simp only [D, map_prod, map_pow]
  have hG : G.map (algebraMap R K) = C (algebraMap R K D) * H := by
    simp only [G, Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_X,
      Polynomial.map_sub, Polynomial.map_one, Polynomial.map_prod]
    rw [hprod]
    dsimp only [H]
    ring
  have hP' : P.map (algebraMap R K) = C u * H := by
    rw [hP]
    dsimp only [H]
    ring
  have he : P.map (algebraMap R K) =
      C (u / algebraMap R K D) * G.map (algebraMap R K) := by
    have hC : C (u / algebraMap R K D) * C (algebraMap R K D) = (C u : K[X]) := by
      rw [← Polynomial.C_mul, div_mul_cancel₀ _ hDK]
    calc
      P.map (algebraMap R K) = C u * H := hP'
      _ = (C (u / algebraMap R K D) * C (algebraMap R K D)) * H := by rw [hC]
      _ = C (u / algebraMap R K D) * (C (algebraMap R K D) * H) := mul_assoc _ _ _
      _ = C (u / algebraMap R K D) * G.map (algebraMap R K) :=
        congrArg (fun z => C (u / algebraMap R K D) * z) hG.symm
  obtain ⟨r,s,hr,hs,hrs⟩ := exists_clear_unit_multiple P G (div_ne_zero hu hDK) he
  refine ⟨r,s,hr,hs,?_⟩
  simpa only [G, mul_assoc] using hrs

/-- The cleared identity specializes at every gain for which the denominator
multiplier remains nonzero. This statement uses an ordinary coefficient map. -/
theorem specialize_cleared_identity {S : Type*} [Field S]
    (e : R →+* S) (P : R[X]) (Q : J → R[X]) (a b : ℕ) (m : J → ℕ)
    {r s : R} (h : C r * P = C s * X^a * (X-1)^b * ∏ j, (Q j)^m j)
    (hr : e r ≠ 0) (x : S) :
    (P.map e).eval x = (e s / e r) * x^a * (x-1)^b *
      ∏ j, (Q j |>.map e |>.eval x)^m j := by
  have he := congrArg (fun p : R[X] => (p.map e).eval x) h
  simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow,
    Polynomial.map_X, Polynomial.map_sub, Polynomial.map_one, Polynomial.map_prod,
    Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X,
    Polynomial.eval_sub, Polynomial.eval_one, Polynomial.eval_prod] at he
  apply (mul_left_cancel₀ hr)
  calc
    e r * (P.map e).eval x = e s * x^a * (x-1)^b *
        ∏ j, (Q j |>.map e |>.eval x)^m j := he
    _ = e r * ((e s / e r) * x^a * (x-1)^b *
        ∏ j, (Q j |>.map e |>.eval x)^m j) := by field_simp

end C2.CADFactor

end

/- ===== C2.CADProjectionBasis ===== -/

/-! Rational finite data derived from the common fraction-field factor basis.
The exported validity conditions are only finite exact polynomial identities
and nonzero tests; generic coprimeness is proved while constructing the data. -/
noncomputable section
open Polynomial
namespace C2.CADProjection

structure FactorData (ι : Type*) (n : ℕ) where
  factors : Fin n → Bivariate
  left : ι → ℚ[X]
  right : ι → ℚ[X]
  zeroPower : ι → ℕ
  onePower : ι → ℕ
  powers : ι → Fin n → ℕ

def ValidFactorData {ι : Type*} {n : ℕ} (F : ι → Bivariate)
    (w : FactorData ι n) : Prop :=
  (∀ i, w.left i ≠ 0 ∧ w.right i ≠ 0) ∧
  (∀ j, ∃ i, w.powers i j ≠ 0) ∧
  ∀ i, C (w.left i) * F i = C (w.right i) * X ^ w.zeroPower i *
    (X-1) ^ w.onePower i * ∏ j, (w.factors j) ^ w.powers i j

/-- Clearing a nonzero scalar denominator preserves the factor's concrete
properties over the generic gain field and its endpoint exclusions. -/
theorem cleared_factor_properties (q : (RatFunc ℚ)[X]) (b : ℚ[X]) (P : Bivariate)
    (hb : b ≠ 0)
    (hP : P.map (algebraMap ℚ[X] (RatFunc ℚ)) =
      C (algebraMap ℚ[X] (RatFunc ℚ) b) * q)
    (hsep : q.Separable) (h0 : q.eval 0 ≠ 0) (h1 : q.eval 1 ≠ 0) :
    P ≠ 0 ∧ (P.map (algebraMap ℚ[X] (RatFunc ℚ))).Separable ∧
      P.eval 0 ≠ 0 ∧ P.eval 1 ≠ 0 := by
  let a := algebraMap ℚ[X] (RatFunc ℚ)
  have hbmap : a b ≠ 0 := by
    simpa only [map_zero] using (IsFractionRing.injective ℚ[X] (RatFunc ℚ)).ne hb
  have he0 : (P.map a).eval 0 = a (P.eval 0) := by
    rw [Polynomial.eval_map]
    simpa only [map_zero] using Polynomial.eval₂_at_apply (p:=P) a (0:ℚ[X])
  have he1 : (P.map a).eval 1 = a (P.eval 1) := by
    rw [Polynomial.eval_map]
    exact Polynomial.eval₂_at_one a
  have hP0 : P.eval 0 ≠ 0 := by
    intro hh
    have hz : (P.map a).eval 0 = 0 := by rw [he0,hh,map_zero]
    rw [hP,Polynomial.eval_mul,Polynomial.eval_C] at hz
    exact (mul_ne_zero hbmap h0) hz
  have hP1 : P.eval 1 ≠ 0 := by
    intro hh
    have hz : (P.map a).eval 1 = 0 := by rw [he1,hh,map_zero]
    rw [hP,Polynomial.eval_mul,Polynomial.eval_C] at hz
    exact (mul_ne_zero hbmap h1) hz
  refine ⟨?_,?_,hP0,hP1⟩
  · intro hh
    exact hP0 (by simp [hh])
  · rw [hP]
    exact Polynomial.Separable.unit_mul (Polynomial.isUnit_C.mpr
      (isUnit_iff_ne_zero.mpr hbmap)) hsep

/-- Constant unit rescalings preserve pairwise generic coprimeness. -/
theorem cleared_factors_coprime (q₁ q₂ : (RatFunc ℚ)[X])
    (b₁ b₂ : ℚ[X]) (P₁ P₂ : Bivariate) (hb₁ : b₁ ≠ 0) (hb₂ : b₂ ≠ 0)
    (h₁ : P₁.map (algebraMap ℚ[X] (RatFunc ℚ)) =
      C (algebraMap ℚ[X] (RatFunc ℚ) b₁) * q₁)
    (h₂ : P₂.map (algebraMap ℚ[X] (RatFunc ℚ)) =
      C (algebraMap ℚ[X] (RatFunc ℚ) b₂) * q₂)
    (h : IsCoprime q₁ q₂) :
    IsCoprime (P₁.map (algebraMap ℚ[X] (RatFunc ℚ)))
      (P₂.map (algebraMap ℚ[X] (RatFunc ℚ))) := by
  rw [h₁,h₂]
  apply (isCoprime_mul_units_left ?_ ?_ q₁ q₂).mpr h
  · apply Polynomial.isUnit_C.mpr
    apply isUnit_iff_ne_zero.mpr
    simpa only [map_zero] using (IsFractionRing.injective ℚ[X] (RatFunc ℚ)).ne hb₁
  · apply Polynomial.isUnit_C.mpr
    apply isUnit_iff_ne_zero.mpr
    simpa only [map_zero] using (IsFractionRing.injective ℚ[X] (RatFunc ℚ)).ne hb₂

/-- Every finite nonzero rational polynomial system has finite rational
factorization and projection data satisfying only exact algebraic checks.
This existence theorem provides witnesses needed to prove termination of exhaustive finite-data search;
it does not identify the noncomputable factorization with executable code. -/
theorem exists_factor_projection_data {ι : Type*} [Fintype ι]
    (F : ι → Bivariate) (hF : ∀ i, F i ≠ 0) :
    ∃ n : ℕ, ∃ w : FactorData ι n, ∃ v : ProjectionData (Fin n),
      ValidFactorData F w ∧ ValidProjectionData w.factors v := by
  classical
  letI : CharZero (RatFunc ℚ) := charZero_of_injective_algebraMap
    (IsFractionRing.injective ℚ[X] (RatFunc ℚ))
  let f : ι → (RatFunc ℚ)[X] := fun i => (F i).map (algebraMap ℚ[X] (RatFunc ℚ))
  have hf : ∀ i, f i ≠ 0 := by
    intro i hi
    apply hF i
    apply Polynomial.map_injective (f:=algebraMap ℚ[X] (RatFunc ℚ))
      (IsFractionRing.injective ℚ[X] (RatFunc ℚ))
    simpa only [Polynomial.map_zero] using hi
  obtain ⟨S,a,b,m,u,hu,hS,hcop,hactive,hid⟩ :=
    C2.CADFactor.exists_finite_interior_factor_basis f hf
  let n := Fintype.card S
  let e : Fin n ≃ S := (Fintype.equivFin S).symm
  let q : Fin n → (RatFunc ℚ)[X] := fun j => (e j).val
  have hq (j : Fin n) : (q j).Monic ∧ (q j).Separable ∧
      (q j).eval 0 ≠ 0 ∧ (q j).eval 1 ≠ 0 := hS (q j) (e j).property
  have hqcop (i j : Fin n) (hne : i ≠ j) : IsCoprime (q i) (q j) := by
    apply hcop (q i) (e i).property (q j) (e j).property
    intro heq
    apply hne
    apply e.injective
    exact Subtype.ext heq
  have hexpr (i : ι) : (F i).map (algebraMap ℚ[X] (RatFunc ℚ)) =
      C (u i) * X ^ a i * (X-1) ^ b i * ∏ j : Fin n, (q j) ^ m i (q j) := by
    have heq : (∏ r ∈ S, r ^ m i r) = ∏ j : Fin n, (q j) ^ m i (q j) := by
      rw [← Finset.prod_coe_sort]
      exact (e.prod_comp (fun r : S => (r.val) ^ m i r.val)).symm
    simpa only [heq] using hid i
  have hclear : ∀ j : Fin n, ∃ d : ℚ[X], d ≠ 0 ∧ ∃ P : Bivariate,
      P.map (algebraMap ℚ[X] (RatFunc ℚ)) = C (algebraMap ℚ[X] (RatFunc ℚ) d) * q j := by
    intro j
    exact exists_clear_denominator (R:=ℚ[X]) (q j)
  choose d hd P hP using hclear
  have hprops (j : Fin n) : P j ≠ 0 ∧
      ((P j).map (algebraMap ℚ[X] (RatFunc ℚ))).Separable ∧
      (P j).eval 0 ≠ 0 ∧ (P j).eval 1 ≠ 0 :=
    cleared_factor_properties (q j) (d j) (P j) (hd j) (hP j)
      (hq j).2.1 (hq j).2.2.1 (hq j).2.2.2
  have hpcop : ∀ i j : Fin n, i ≠ j → IsCoprime
      ((P i).map (algebraMap ℚ[X] (RatFunc ℚ)))
      ((P j).map (algebraMap ℚ[X] (RatFunc ℚ))) := by
    intro i j hne
    exact cleared_factors_coprime (q i) (q j) (d i) (d j) (P i) (P j)
      (hd i) (hd j) (hP i) (hP j) (hqcop i j hne)
  have hids : ∀ i, ∃ r s : ℚ[X], r ≠ 0 ∧ s ≠ 0 ∧
      C r * F i = C s * X ^ a i * (X-1) ^ b i * ∏ j : Fin n, (P j) ^ m i (q j) := by
    intro i
    exact C2.CADFactor.exists_clear_factor_identity (F i) q P d hd hP
      (a i) (b i) (fun j => m i (q j)) (hu i) (hexpr i)
  choose r s hr hs hidentity using hids
  obtain ⟨v,hv⟩ := exists_valid_projection_data P (fun j => (hprops j).1)
    (fun j => (hprops j).2.1) hpcop (fun j => (hprops j).2.2.1)
    (fun j => (hprops j).2.2.2)
  refine ⟨n,⟨P,r,s,a,b,fun i j => m i (q j)⟩,v,?_,hv⟩
  refine ⟨fun i => ⟨hr i,hs i⟩,?_,hidentity⟩
  intro j
  obtain ⟨i,hi⟩ := hactive (q j) (e j).property
  exact ⟨i,Nat.ne_of_gt hi⟩

end C2.CADProjection

end

/- ===== C2.CADEffectiveWitness ===== -/

/-! Finite executable data for the complete factorization/projection stage.
All stored coefficients are rational lists. The checker is finite Boolean
arithmetic; the proof of existence will establish total exhaustive production. -/
namespace C2.CADEffective.Bivariate
open Polynomial

structure Witness where
  n : ℕ
  factors : List Poly
  left : List Dense.Poly
  right : List Dense.Poly
  zeroPower : List ℕ
  onePower : List ℕ
  powers : List (List ℕ)
  simple : List Dense.Poly
  simpleU : List Poly
  simpleV : List Poly
  pair : List (List Dense.Poly)
  pairU : List (List Poly)
  pairV : List (List Poly)
  deriving Encodable

def nativeProd : List Poly → Poly
  | [] => one
  | p :: ps => mul p (nativeProd ps)

@[simp] theorem denote_nativeProd (ps : List Poly) :
    denote (nativeProd ps) = (ps.map denote).prod := by
  induction ps with
  | nil => simp [nativeProd]
  | cons p ps ih => simp [nativeProd, ih]

def gammaX : Poly := [[], [1]]
def gammaXSubOne : Poly := [[-1], [1]]

@[simp] theorem denote_gammaX : denote gammaX = X := by simp [gammaX]
@[simp] theorem denote_gammaXSubOne : denote gammaXSubOne = X - 1 := by
  simp [gammaXSubOne]; ring

def factorsProduct (w : Witness) (i : ℕ) : Poly :=
  nativeProd (List.ofFn (fun j : Fin w.n =>
    pow (w.factors.getD j []) ((w.powers.getD i []).getD j 0)))

noncomputable def inputFamily (F : List Poly) : Fin F.length → C2.CADProjection.Bivariate :=
  fun i => denote (F.getD i [])

noncomputable def toFactorData (F : List Poly) (w : Witness) :
    C2.CADProjection.FactorData (Fin F.length) w.n where
  factors := fun j => denote (w.factors.getD j [])
  left := fun i => Dense.denote (w.left.getD i [])
  right := fun i => Dense.denote (w.right.getD i [])
  zeroPower := fun i => w.zeroPower.getD i 0
  onePower := fun i => w.onePower.getD i 0
  powers := fun i j => (w.powers.getD i []).getD j 0

noncomputable def toProjectionData (w : Witness) : C2.CADProjection.ProjectionData (Fin w.n) where
  simple := fun i => Dense.denote (w.simple.getD i [])
  simpleU := fun i => denote (w.simpleU.getD i [])
  simpleV := fun i => denote (w.simpleV.getD i [])
  pair := fun i j => Dense.denote ((w.pair.getD i []).getD j [])
  pairU := fun i j => denote ((w.pairU.getD i []).getD j [])
  pairV := fun i j => denote ((w.pairV.getD i []).getD j [])

@[simp] theorem denote_factorsProduct (F : List Poly) (w : Witness) (i : Fin F.length) :
    denote (factorsProduct w i) =
      ∏ j : Fin w.n, ((toFactorData F w).factors j) ^ (toFactorData F w).powers i j := by
  simp [factorsProduct, denote_nativeProd, List.map_ofFn, List.prod_ofFn, toFactorData]

def factorIdentity (F : List Poly) (w : Witness) (i : ℕ) : Bool :=
  eqb (mul (constant (w.left.getD i [])) (F.getD i []))
    (mul (mul (mul (constant (w.right.getD i [])) (pow gammaX (w.zeroPower.getD i 0)))
      (pow gammaXSubOne (w.onePower.getD i 0))) (factorsProduct w i))

def witnessCheck (F : List Poly) (w : Witness) : Bool := decide (
  (∀ i : Fin F.length,
    Dense.eqb (w.left.getD i []) [] = false ∧
    Dense.eqb (w.right.getD i []) [] = false ∧ factorIdentity F w i = true) ∧
  (∀ j : Fin w.n, ∃ i : Fin F.length, (w.powers.getD i []).getD j 0 ≠ 0) ∧
  (∀ i : Fin w.n,
    Dense.eqb (leadingCoeff (w.factors.getD i [])) [] = false ∧
    Dense.eqb (gammaEval (w.factors.getD i []) 0) [] = false ∧
    Dense.eqb (gammaEval (w.factors.getD i []) 1) [] = false ∧
    Dense.eqb (w.simple.getD i []) [] = false ∧
    eqb (add (mul (w.simpleU.getD i []) (w.factors.getD i []))
      (mul (w.simpleV.getD i []) (derivative (w.factors.getD i []))))
        (constant (w.simple.getD i [])) = true) ∧
  (∀ i j : Fin w.n,
    Dense.eqb ((w.pair.getD i []).getD j []) [] = false ∧
      (i ≠ j → eqb (add
        (mul ((w.pairU.getD i []).getD j []) (w.factors.getD i []))
        (mul ((w.pairV.getD i []).getD j []) (w.factors.getD j [])))
        (constant ((w.pair.getD i []).getD j [])) = true)))

theorem dense_eqb_false_iff (p q : Dense.Poly) :
    Dense.eqb p q = false ↔ Dense.denote p ≠ Dense.denote q := by
  simpa only [Bool.not_eq_true] using not_congr (Dense.eqb_eq_true_iff p q)

theorem factorIdentity_iff (F : List Poly) (w : Witness) (i : Fin F.length) :
    factorIdentity F w i = true ↔
      C ((toFactorData F w).left i) * inputFamily F i =
        C ((toFactorData F w).right i) * X ^ (toFactorData F w).zeroPower i *
        (X-1) ^ (toFactorData F w).onePower i *
          ∏ j : Fin w.n, ((toFactorData F w).factors j) ^ (toFactorData F w).powers i j := by
  simp only [factorIdentity, eqb_eq_true_iff, denote_mul, denote_constant,
    denote_pow, denote_gammaX, denote_gammaXSubOne, denote_factorsProduct]
  rfl

/-- The executable finite checker is exactly the established mathematical
factor and projection specifications. -/
theorem witnessCheck_iff (F : List Poly) (w : Witness) :
    witnessCheck F w = true ↔
      C2.CADProjection.ValidFactorData (inputFamily F) (toFactorData F w) ∧
      C2.CADProjection.ValidProjectionData (toFactorData F w).factors (toProjectionData w) := by
  simp only [witnessCheck, decide_eq_true_eq, dense_eqb_false_iff,
    Dense.denote_nil, factorIdentity_iff, denote_leadingCoeff,
    gammaEval_zero, gammaEval_one, eqb_eq_true_iff, denote_add,
    denote_mul, denote_derivative, denote_constant]
  simp only [C2.CADProjection.ValidFactorData, C2.CADProjection.ValidProjectionData,
    toFactorData, toProjectionData]
  constructor
  · rintro ⟨hleft,hused,hsimple,hpair⟩
    exact ⟨⟨fun i => ⟨(hleft i).1, (hleft i).2.1⟩, hused,
      fun i => (hleft i).2.2⟩, hsimple, hpair⟩
  · rintro ⟨⟨hlr,hused,hid⟩,hsimple,hpair⟩
    exact ⟨fun i => ⟨(hlr i).1, (hlr i).2, hid i⟩,hused,hsimple,hpair⟩

end C2.CADEffective.Bivariate


/- ===== C2.CADSignPatterns ===== -/

/-! Finite Boolean combinations of strict factor signs inherit gain-cell
invariance from concrete simple/disjoint polynomial-root regularity. -/

noncomputable section
open Set Filter
open scoped Topology BigOperators
namespace C2.CADDelineability

/-- Independent nonzero constant rescalings preserve concrete root regularity. -/
theorem Regular.scale {ι : Type*} {F : ι → ℝ × ℝ → ℝ} {k : ℝ}
    (hreg : Regular F k) (s : ι → ℝ) (hs : ∀ i, s i ≠ 0) :
    Regular (fun i p => s i * F i p) k := by
  refine ⟨fun i => mul_ne_zero (hs i) (hreg.1 i),
    fun i => mul_ne_zero (hs i) (hreg.2.1 i), ?_, ?_⟩
  · intro x hx i j hij hi hj
    have hi0 : F i (k, x) = 0 := (mul_eq_zero.mp hi).resolve_left (hs i)
    have hj0 : F j (k, x) = 0 := (mul_eq_zero.mp hj).resolve_left (hs j)
    exact hreg.2.2.1 x hx i j hij hi0 hj0
  · intro x hx i hi
    have hi0 : F i (k, x) = 0 := (mul_eq_zero.mp hi).resolve_left (hs i)
    obtain ⟨d, hd, hf⟩ := hreg.2.2.2 x hx i hi0
    exact ⟨s i * d, mul_ne_zero (hs i) hd, hf.const_mul (s i)⟩

def signMultiplier (b : Bool) : ℝ := if b then 1 else -1

theorem signMultiplier_ne_zero (b : Bool) : signMultiplier b ≠ 0 := by
  cases b <;> norm_num [signMultiplier]

theorem signMultiplier_sq (b : Bool) : signMultiplier b * signMultiplier b = 1 := by
  cases b <;> norm_num [signMultiplier]

/-- All strict sign patterns are invariant on a connected regular gain cell. -/
theorem signed_pattern_constant {ι : Type*} [Finite ι]
    (F : ι → ℝ × ℝ → ℝ) (hcont : ∀ i, Continuous (F i))
    (I : Set ℝ) (hI : IsPreconnected I) (hreg : ∀ k ∈ I, Regular F k)
    (σ : ι → Bool) {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) :
    a ∈ patternGains (fun i p => signMultiplier (σ i) * F i p) ↔
    b ∈ patternGains (fun i p => signMultiplier (σ i) * F i p) :=
  pattern_constant_on_preconnected _
    (fun i => continuous_const.mul (hcont i)) I hI
    (fun k hk => (hreg k hk).scale _ (fun i => signMultiplier_ne_zero (σ i))) ha hb

/-- A Boolean acceptance condition on a finite factor-sign pattern. -/
def acceptedPatternGains {ι : Type*} (F : ι → ℝ × ℝ → ℝ)
    (Accept : (ι → Bool) → Prop) : Set ℝ :=
  {k | ∃ σ : ι → Bool, Accept σ ∧
    k ∈ patternGains (fun i p => signMultiplier (σ i) * F i p)}

/-- Exact cell marking for any fixed Boolean combination of strict factor
signs, including the positivity constraints obtained from finite products. -/
theorem accepted_pattern_constant {ι : Type*} [Finite ι]
    (F : ι → ℝ × ℝ → ℝ) (hcont : ∀ i, Continuous (F i))
    (Accept : (ι → Bool) → Prop)
    (I : Set ℝ) (hI : IsPreconnected I) (hreg : ∀ k ∈ I, Regular F k)
    {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) :
    a ∈ acceptedPatternGains F Accept ↔ b ∈ acceptedPatternGains F Accept := by
  constructor
  · rintro ⟨σ, hσ, haσ⟩
    exact ⟨σ, hσ, (signed_pattern_constant F hcont I hI hreg σ ha hb).mp haσ⟩
  · rintro ⟨σ, hσ, hbσ⟩
    exact ⟨σ, hσ, (signed_pattern_constant F hcont I hI hreg σ ha hb).mpr hbσ⟩

/-- Product signs are exactly determined by the factor signs and multiplicities. -/
theorem product_sign_iff {ι : Type*} [Fintype ι]
    (v : ι → ℝ) (e : ι → ℕ) (c : ℝ) (σ : ι → Bool)
    (hσ : ∀ i, 0 < signMultiplier (σ i) * v i) :
    (0 < c * ∏ i, (v i) ^ e i) ↔
    (0 < c * ∏ i, signMultiplier (σ i) ^ e i) := by
  have hv : ∀ i, v i = signMultiplier (σ i) * (signMultiplier (σ i) * v i) := by
    intro i
    rw [← mul_assoc, signMultiplier_sq, one_mul]
  have heq : (∏ i, (v i) ^ e i) =
      (∏ i, signMultiplier (σ i) ^ e i) *
      (∏ i, (signMultiplier (σ i) * v i) ^ e i) := by
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro i _
    rw [← mul_pow, ← hv i]
  rw [heq, ← mul_assoc]
  exact mul_pos_iff_of_pos_right (Finset.prod_pos (fun i _ => pow_pos (hσ i) _))

/-- Every nonzero tuple has its actual strict sign vector. -/
theorem exists_sign_pattern {ι : Type*} (v : ι → ℝ) (hv : ∀ i, v i ≠ 0) :
    ∃ σ : ι → Bool, ∀ i, 0 < signMultiplier (σ i) * v i := by
  classical
  refine ⟨fun i => decide (0 < v i), fun i => ?_⟩
  by_cases hi : 0 < v i
  · simpa [signMultiplier, hi] using hi
  · have hn : v i < 0 := lt_of_le_of_ne (le_of_not_gt hi) (hv i)
    simpa [signMultiplier, hi] using neg_pos.mpr hn

/-- A factor that occurs in a strictly positive product cannot vanish. -/
theorem factors_ne_zero_of_positive_products {ι τ : Type*} [Fintype ι]
    (v : ι → ℝ) (c : τ → ℝ) (e : τ → ι → ℕ)
    (hused : ∀ i, ∃ j, e j i ≠ 0)
    (hpos : ∀ j, 0 < c j * ∏ i, (v i) ^ e j i) :
    ∀ i, v i ≠ 0 := by
  intro i hi
  obtain ⟨j, hj⟩ := hused i
  have hz : ∏ i, (v i) ^ e j i = 0 :=
    Finset.prod_eq_zero (Finset.mem_univ i) (by simp [hi, hj])
  simpa [hz] using hpos j

/-- Exact reduction of simultaneous strict product inequalities to a finite
accepted factor-sign pattern. No sign-equivalence premise is assumed. -/
theorem positive_products_iff_pattern {ι τ : Type*} [Fintype ι]
    (v : ι → ℝ) (c : τ → ℝ) (e : τ → ι → ℕ)
    (hused : ∀ i, ∃ j, e j i ≠ 0) :
    (∀ j, 0 < c j * ∏ i, (v i) ^ e j i) ↔
    ∃ σ : ι → Bool,
      (∀ j, 0 < c j * ∏ i, signMultiplier (σ i) ^ e j i) ∧
      (∀ i, 0 < signMultiplier (σ i) * v i) := by
  constructor
  · intro h
    obtain ⟨σ, hσ⟩ := exists_sign_pattern v
      (factors_ne_zero_of_positive_products v c e hused h)
    exact ⟨σ, fun j => (product_sign_iff v (e j) (c j) σ hσ).mp (h j), hσ⟩
  · rintro ⟨σ, ha, hσ⟩ j
    exact (product_sign_iff v (e j) (c j) σ hσ).mpr (ha j)

/-- Exact finite-factor reduction at the level of gain projections. -/
theorem productGains_eq_accepted {ι τ : Type*} [Fintype ι]
    (F : ι → ℝ × ℝ → ℝ) (c : τ → ℝ) (e : τ → ι → ℕ)
    (hused : ∀ i, ∃ j, e j i ≠ 0) :
    patternGains (fun j p => c j * ∏ i, (F i p) ^ e j i) =
    acceptedPatternGains F (fun σ => ∀ j,
      0 < c j * ∏ i, signMultiplier (σ i) ^ e j i) := by
  ext k
  constructor
  · rintro ⟨x, hx, hpos⟩
    obtain ⟨σ, ha, hσ⟩ := (positive_products_iff_pattern (fun i => F i (k, x)) c e hused).mp hpos
    exact ⟨σ, ha, x, hx, hσ⟩
  · rintro ⟨σ, ha, x, hx, hσ⟩
    exact ⟨x, hx, (positive_products_iff_pattern (fun i => F i (k, x)) c e hused).mpr ⟨σ, ha, hσ⟩⟩

/-- The actual simultaneous positivity region of a finite product system has
constant gain-cell feasibility under algebraic regularity of its factor basis. -/
theorem products_constant_on_preconnected {ι τ : Type*} [Fintype ι]
    (F : ι → ℝ × ℝ → ℝ) (hcont : ∀ i, Continuous (F i))
    (c : τ → ℝ) (e : τ → ι → ℕ) (hused : ∀ i, ∃ j, e j i ≠ 0)
    (I : Set ℝ) (hI : IsPreconnected I) (hreg : ∀ k ∈ I, Regular F k)
    {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) :
    a ∈ patternGains (fun j p => c j * ∏ i, (F i p) ^ e j i) ↔
    b ∈ patternGains (fun j p => c j * ∏ i, (F i p) ^ e j i) := by
  rw [productGains_eq_accepted F c e hused]
  exact accepted_pattern_constant F hcont _ I hI hreg ha hb

end C2.CADDelineability

end

/- ===== C2.CADProjectionCells ===== -/

/-! The algebraic projection gives actual gain-cell feasibility invariance. -/
noncomputable section
open Polynomial Set
namespace C2.CADProjection

theorem RegularFamilyAt.analytic {ι : Type*} {p : ι → Bivariate} {k : ℝ}
    (h : RegularFamilyAt p k) :
    C2.CADDelineability.Regular (fun i z => value (p i) z.1 z.2) k := by
  refine ⟨fun i => (h.1 i).2.1,fun i => (h.1 i).2.2,?_,?_⟩
  · intro x _ i j hij hi
    exact (h.2 i j hij x).resolve_left (not_not.mpr hi)
  · intro x _ i hi
    refine ⟨(specialize (p i) k).derivative.eval x,(h.1 i).1.2 x hi,?_⟩
    exact (specialize (p i) k).hasDerivAt x

/-- Root regularity from a verified projection implies exact constancy of all
strict basis-sign patterns on each connected set avoiding its zeros. -/
theorem projected_signed_pattern_constant {ι : Type*} [Fintype ι]
    (p : ι → Bivariate) (d : ℚ[X])
    (hreg : ∀ k : ℝ, d.eval₂ (algebraMap ℚ ℝ) k ≠ 0 → RegularFamilyAt p k)
    (I : Set ℝ) (hI : IsPreconnected I)
    (hcut : ∀ k ∈ I, d.eval₂ (algebraMap ℚ ℝ) k ≠ 0)
    (σ : ι → Bool) {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) :
    a ∈ C2.CADDelineability.patternGains (fun i z =>
      C2.CADDelineability.signMultiplier (σ i) * value (p i) z.1 z.2) ↔
    b ∈ C2.CADDelineability.patternGains (fun i z =>
      C2.CADDelineability.signMultiplier (σ i) * value (p i) z.1 z.2) := by
  exact C2.CADDelineability.signed_pattern_constant
    (fun i z => value (p i) z.1 z.2) (fun i => continuous_value (p i)) I hI
    (fun k hk => (hreg k (hcut k hk)).analytic) σ ha hb

/-- The positivity projection of a polynomial product system is constant on
an entire connected gain cell, not only at the selected rational sample. -/
theorem projected_products_constant {ι τ : Type*} [Fintype ι]
    (p : ι → Bivariate) (d : ℚ[X])
    (hreg : ∀ k : ℝ, d.eval₂ (algebraMap ℚ ℝ) k ≠ 0 → RegularFamilyAt p k)
    (c : τ → ℝ) (e : τ → ι → ℕ) (hused : ∀ i, ∃ j, e j i ≠ 0)
    (I : Set ℝ) (hI : IsPreconnected I)
    (hcut : ∀ k ∈ I, d.eval₂ (algebraMap ℚ ℝ) k ≠ 0)
    {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) :
    a ∈ C2.CADDelineability.patternGains (fun j z =>
      c j * ∏ i, value (p i) z.1 z.2 ^ e j i) ↔
    b ∈ C2.CADDelineability.patternGains (fun j z =>
      c j * ∏ i, value (p i) z.1 z.2 ^ e j i) := by
  exact C2.CADDelineability.products_constant_on_preconnected
    (fun i z => value (p i) z.1 z.2) (fun i => continuous_value (p i))
    c e hused I hI (fun k hk => (hreg k (hcut k hk)).analytic) ha hb

end C2.CADProjection

end

/- ===== C2.CADProductCells ===== -/

/-! Exact gain-cell invariance for factored strict polynomial systems,
including gain-dependent nonzero units and the fixed endpoint factors. -/
noncomputable section
open Set Filter
open scoped Topology BigOperators
namespace C2.CADDelineability

/-- A continuous nonvanishing real unit has constant sign on a connected set. -/
theorem unit_positive_iff {I : Set ℝ} (hI : IsPreconnected I)
    (u : ℝ → ℝ) (hu : ContinuousOn u I) (hnz : ∀ k ∈ I, u k ≠ 0)
    {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) : 0 < u a ↔ 0 < u b := by
  have transfer : ∀ {a b : ℝ}, a ∈ I → b ∈ I → 0 < u a → 0 < u b := by
    intro a b ha hb hpos
    by_contra h
    obtain ⟨x, hx, hz⟩ := hI.intermediate_value hb ha hu
      (show (0 : ℝ) ∈ Icc (u b) (u a) from ⟨le_of_not_gt h, hpos.le⟩)
    exact hnz x hx hz
  exact ⟨transfer ha hb, transfer hb ha⟩

/-- Replacing a gain-dependent nonzero unit by its value at any other gain
of the same connected cell preserves every product sign. -/
theorem unit_product_positive_iff {I : Set ℝ} (hI : IsPreconnected I)
    (u : ℝ → ℝ) (hu : ContinuousOn u I) (hnz : ∀ k ∈ I, u k ≠ 0)
    {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) (v : ℝ) :
    0 < u a * v ↔ 0 < u b * v := by
  have hp := unit_positive_iff hI u hu hnz ha hb
  have hn : u a < 0 ↔ u b < 0 := by
    have hpn := unit_positive_iff hI (fun k => -u k) hu.neg
      (fun k hk => neg_ne_zero.mpr (hnz k hk)) ha hb
    simpa using hpn
  simp only [mul_pos_iff, hp, hn]

/-- Gain-dependent units are handled by their proved sign constancy, not by
assuming they are constant rational numbers. -/
theorem variable_unit_products_constant {ι τ : Type*} [Fintype ι]
    (F : ι → ℝ × ℝ → ℝ) (hcont : ∀ i, Continuous (F i))
    (u : τ → ℝ → ℝ) (e : τ → ι → ℕ) (hused : ∀ i, ∃ j, e j i ≠ 0)
    (I : Set ℝ) (hI : IsPreconnected I) (hreg : ∀ k ∈ I, Regular F k)
    (hu : ∀ j, ContinuousOn (u j) I) (hunz : ∀ j k, k ∈ I → u j k ≠ 0)
    {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) :
    a ∈ patternGains (fun j p => u j p.1 * ∏ i, (F i p) ^ e j i) ↔
    b ∈ patternGains (fun j p => u j p.1 * ∏ i, (F i p) ^ e j i) := by
  have hchange : ∀ k ∈ I,
      k ∈ patternGains (fun j p => u j p.1 * ∏ i, (F i p) ^ e j i) ↔
      k ∈ patternGains (fun j p => u j a * ∏ i, (F i p) ^ e j i) := by
    intro k hk
    constructor
    · rintro ⟨x, hx, hpos⟩
      exact ⟨x, hx, fun j => (unit_product_positive_iff hI (u j) (hu j)
        (hunz j) hk ha _).mp (hpos j)⟩
    · rintro ⟨x, hx, hpos⟩
      exact ⟨x, hx, fun j => (unit_product_positive_iff hI (u j) (hu j)
        (hunz j) hk ha _).mpr (hpos j)⟩
  rw [hchange a ha, hchange b hb]
  exact products_constant_on_preconnected F hcont (fun j => u j a) e hused
    I hI hreg ha hb

/-- At a strictly interior parameter, fixed endpoint powers have known signs. -/
theorem endpoint_product_sign_iff (x c p : ℝ) (a b : ℕ)
    (hx0 : 0 < x) (hx1 : x < 1) :
    (0 < c * x ^ a * (x - 1) ^ b * p) ↔
    (0 < (c * (-1 : ℝ) ^ b) * p) := by
  have hpos : 0 < x ^ a * (1 - x) ^ b :=
    mul_pos (pow_pos hx0 _) (pow_pos (sub_pos.mpr hx1) _)
  have hidentity : c * x ^ a * (x - 1) ^ b * p =
      ((c * (-1 : ℝ) ^ b) * p) * (x ^ a * (1 - x) ^ b) := by
    have hx : x - 1 = (-1 : ℝ) * (1 - x) := by ring
    rw [hx, mul_pow]
    ring
  rw [hidentity]
  exact mul_pos_iff_of_pos_right hpos

/-- Removing fixed endpoint factors does not alter the gain projection:
feasible boundary parameters can first be moved to the interior by continuity. -/
theorem endpoint_products_gain_iff {ι τ : Type*} [Fintype ι] [Finite τ]
    (F : ι → ℝ × ℝ → ℝ) (hcont : ∀ i, Continuous (F i))
    (u : τ → ℝ → ℝ) (e : τ → ι → ℕ) (r s : τ → ℕ) (k : ℝ) :
    k ∈ patternGains (fun j p =>
      u j p.1 * p.2 ^ r j * (p.2 - 1) ^ s j * ∏ i, (F i p) ^ e j i) ↔
    k ∈ patternGains (fun j p =>
      (u j p.1 * (-1 : ℝ) ^ s j) * ∏ i, (F i p) ^ e j i) := by
  have hf : ∀ j, Continuous (fun x : ℝ =>
      u j k * x ^ r j * (x - 1) ^ s j * ∏ i, (F i (k, x)) ^ e j i) := by
    intro j
    exact ((continuous_const.mul (continuous_id.pow _)).mul
      ((continuous_id.sub continuous_const).pow _)).mul
        (continuous_finset_prod _ (fun i _ =>
          ((hcont i).comp (continuous_const.prodMk continuous_id)).pow _))
  have hg : ∀ j, Continuous (fun x : ℝ =>
      (u j k * (-1 : ℝ) ^ s j) * ∏ i, (F i (k, x)) ^ e j i) := by
    intro j
    exact continuous_const.mul (continuous_finset_prod _ (fun i _ =>
      ((hcont i).comp (continuous_const.prodMk continuous_id)).pow _))
  constructor
  · rintro ⟨x, hx, hpos⟩
    obtain ⟨q, hq0, hq1, hq⟩ := C2.GainProjection.exists_rational_interior_witness
      (fun x j => u j k * x ^ r j * (x - 1) ^ s j * ∏ i, (F i (k, x)) ^ e j i)
      hf hx hpos
    exact ⟨q, ⟨hq0.le, hq1.le⟩, fun j =>
      (endpoint_product_sign_iff q (u j k) _ (r j) (s j) hq0 hq1).mp (hq j)⟩
  · rintro ⟨x, hx, hpos⟩
    obtain ⟨q, hq0, hq1, hq⟩ := C2.GainProjection.exists_rational_interior_witness
      (fun x j => (u j k * (-1 : ℝ) ^ s j) * ∏ i, (F i (k, x)) ^ e j i)
      hg hx hpos
    exact ⟨q, ⟨hq0.le, hq1.le⟩, fun j =>
      (endpoint_product_sign_iff q (u j k) _ (r j) (s j) hq0 hq1).mpr (hq j)⟩

/-- Complete analytic cell-marking theorem for a factored polynomial system,
with gain-dependent units and arbitrary fixed endpoint multiplicities. -/
theorem endpoint_products_constant {ι τ : Type*} [Fintype ι] [Finite τ]
    (F : ι → ℝ × ℝ → ℝ) (hcont : ∀ i, Continuous (F i))
    (u : τ → ℝ → ℝ) (e : τ → ι → ℕ) (r s : τ → ℕ)
    (hused : ∀ i, ∃ j, e j i ≠ 0)
    (I : Set ℝ) (hI : IsPreconnected I) (hreg : ∀ k ∈ I, Regular F k)
    (hu : ∀ j, ContinuousOn (u j) I) (hunz : ∀ j k, k ∈ I → u j k ≠ 0)
    {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) :
    a ∈ patternGains (fun j p =>
      u j p.1 * p.2 ^ r j * (p.2 - 1) ^ s j * ∏ i, (F i p) ^ e j i) ↔
    b ∈ patternGains (fun j p =>
      u j p.1 * p.2 ^ r j * (p.2 - 1) ^ s j * ∏ i, (F i p) ^ e j i) := by
  rw [endpoint_products_gain_iff F hcont u e r s a,
    endpoint_products_gain_iff F hcont u e r s b]
  apply variable_unit_products_constant F hcont (fun j k => u j k * (-1 : ℝ) ^ s j)
    e hused I hI hreg
  · intro j
    exact (hu j).mul continuousOn_const
  · intro j k hk
    exact mul_ne_zero (hunz j k hk) (pow_ne_zero _ (by norm_num))
  · exact ha
  · exact hb

end C2.CADDelineability

end

/- ===== C2.CADProjectionComplete ===== -/

/-! Projection correctness for arbitrary finite strict rational bivariate
systems. The factorization and Bezout data are proved to exist, and their
finite exact identities imply feasibility constancy on every regular cell. -/
noncomputable section
open Polynomial Set
namespace C2.CADProjection

def totalProjectionCut {ι : Type*} [Fintype ι] {n : ℕ}
    (w : FactorData ι n) (v : ProjectionData (Fin n)) : ℚ[X] :=
  projectionCut w.factors v * ∏ i, w.left i * w.right i

theorem totalProjectionCut_ne_zero {ι : Type*} [Fintype ι] {n : ℕ}
    {F : ι → Bivariate} {w : FactorData ι n} {v : ProjectionData (Fin n)}
    (hw : ValidFactorData F w) (hv : ValidProjectionData w.factors v) :
    totalProjectionCut w v ≠ 0 :=
  mul_ne_zero hv.cut_ne_zero (Finset.prod_ne_zero_iff.mpr
    (fun i _ => mul_ne_zero (hw.1 i).1 (hw.1 i).2))

/-- The full finite cut also excludes every scalar multiplier denominator
and numerator used in the exact cleared factorization identities. -/
theorem totalProjectionCut_regular {ι : Type*} [Fintype ι] {n : ℕ}
    {F : ι → Bivariate} {w : FactorData ι n} {v : ProjectionData (Fin n)}
    (hw : ValidFactorData F w) (hv : ValidProjectionData w.factors v)
    (k : ℝ) (hk : (totalProjectionCut w v).eval₂ (algebraMap ℚ ℝ) k ≠ 0) :
    RegularFamilyAt w.factors k ∧ ∀ i,
      (w.left i).eval₂ (algebraMap ℚ ℝ) k ≠ 0 ∧
      (w.right i).eval₂ (algebraMap ℚ ℝ) k ≠ 0 := by
  let e : ℚ[X] →+* ℝ := Polynomial.eval₂RingHom (algebraMap ℚ ℝ) k
  have hmap : e (totalProjectionCut w v) ≠ 0 := hk
  have hparts : e (projectionCut w.factors v) ≠ 0 ∧
      (∏ i, e (w.left i) * e (w.right i)) ≠ 0 := by
    simpa only [totalProjectionCut,map_mul,map_prod,mul_ne_zero_iff] using hmap
  refine ⟨hv.regular k hparts.1,fun i => ?_⟩
  exact mul_ne_zero_iff.mp (Finset.prod_ne_zero_iff.mp hparts.2 i (Finset.mem_univ i))

def unitValue {ι : Type*} {n : ℕ} (w : FactorData ι n) (i : ι) (k : ℝ) : ℝ :=
  (w.right i).eval₂ (algebraMap ℚ ℝ) k / (w.left i).eval₂ (algebraMap ℚ ℝ) k

/-- The original polynomial values equal the specialized finite factor data
at every gain at which the checked scalar denominator does not vanish. -/
theorem ValidFactorData.value_eq {ι : Type*} {n : ℕ}
    {F : ι → Bivariate} {w : FactorData ι n} (hw : ValidFactorData F w)
    (i : ι) (k x : ℝ) (hk : (w.left i).eval₂ (algebraMap ℚ ℝ) k ≠ 0) :
    value (F i) k x = unitValue w i k * x ^ w.zeroPower i *
      (x-1) ^ w.onePower i * ∏ j, value (w.factors j) k x ^ w.powers i j := by
  exact C2.CADFactor.specialize_cleared_identity
    (Polynomial.eval₂RingHom (algebraMap ℚ ℝ) k) (F i) w.factors
    (w.zeroPower i) (w.onePower i) (w.powers i) (hw.2.2 i) hk x

/-- Finite exact factor and projection identities prove actual feasibility
invariance of the original inequalities on each connected projection-free set. -/
theorem valid_data_feasibility_constant {ι : Type*} [Fintype ι] {n : ℕ}
    (F : ι → Bivariate) (w : FactorData ι n) (v : ProjectionData (Fin n))
    (hw : ValidFactorData F w) (hv : ValidProjectionData w.factors v)
    (I : Set ℝ) (hI : IsPreconnected I)
    (hcut : ∀ k ∈ I, (totalProjectionCut w v).eval₂ (algebraMap ℚ ℝ) k ≠ 0)
    {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) :
    (∃ x ∈ Icc (0:ℝ) 1, ∀ i, 0 < value (F i) a x) ↔
    (∃ x ∈ Icc (0:ℝ) 1, ∀ i, 0 < value (F i) b x) := by
  have hregular (k : ℝ) (hk : k ∈ I) := totalProjectionCut_regular hw hv k (hcut k hk)
  have hucont : ∀ i, ContinuousOn (unitValue w i) I := by
    intro i
    exact ((w.right i).continuous_eval₂ (algebraMap ℚ ℝ)).continuousOn.div
      ((w.left i).continuous_eval₂ (algebraMap ℚ ℝ)).continuousOn
      (fun k hk => (hregular k hk).2 i |>.1)
  have hunz : ∀ i k, k ∈ I → unitValue w i k ≠ 0 := by
    intro i k hk
    exact div_ne_zero ((hregular k hk).2 i).2 ((hregular k hk).2 i).1
  have hpattern := C2.CADDelineability.endpoint_products_constant
    (fun j z => value (w.factors j) z.1 z.2) (fun j => continuous_value (w.factors j))
    (unitValue w) w.powers w.zeroPower w.onePower hw.2.1 I hI
    (fun k hk => (hregular k hk).1.analytic) hucont hunz ha hb
  have heq (k : ℝ) (hk : k ∈ I) :
      (∃ x ∈ Icc (0:ℝ) 1, ∀ i, 0 < value (F i) k x) ↔
      k ∈ C2.CADDelineability.patternGains (fun i z =>
        unitValue w i z.1 * z.2 ^ w.zeroPower i * (z.2-1) ^ w.onePower i *
          ∏ j, value (w.factors j) z.1 z.2 ^ w.powers i j) := by
    constructor
    · rintro ⟨x,hx,hpos⟩
      refine ⟨x,hx,fun i => ?_⟩
      have hi := hpos i
      rw [hw.value_eq i k x ((hregular k hk).2 i).1] at hi
      exact hi
    · rintro ⟨x,hx,hpos⟩
      refine ⟨x,hx,fun i => ?_⟩
      rw [hw.value_eq i k x ((hregular k hk).2 i).1]
      exact hpos i
  exact (heq a ha).trans (hpattern.trans (heq b hb).symm)

/-- General mathematical projection theorem, with no supplied factorization,
root regularity or feasibility-invariance assumption. This includes constants,
repeated factors, common factors and every gain-only factor. -/
theorem exists_feasibility_projection {ι : Type*} [Fintype ι]
    (F : ι → Bivariate) (hF : ∀ i, F i ≠ 0) :
    ∃ D : ℚ[X], D ≠ 0 ∧
      ∀ I : Set ℝ, IsPreconnected I →
      (∀ k ∈ I, D.eval₂ (algebraMap ℚ ℝ) k ≠ 0) →
      ∀ {a b : ℝ}, a ∈ I → b ∈ I →
        ((∃ x ∈ Icc (0:ℝ) 1, ∀ i, 0 < value (F i) a x) ↔
         (∃ x ∈ Icc (0:ℝ) 1, ∀ i, 0 < value (F i) b x)) := by
  obtain ⟨n,w,v,hw,hv⟩ := exists_factor_projection_data F hF
  exact ⟨totalProjectionCut w v,totalProjectionCut_ne_zero hw hv,
    fun I hI hcut _ _ ha hb => valid_data_feasibility_constant F w v hw hv I hI hcut ha hb⟩

end C2.CADProjection

end

/- ===== C2.CADEffectiveProjection ===== -/

/-! Executable construction of the complete rational projection polynomial.
All multiplication and coefficient selection operate on rational lists;
the mathematical polynomial appears only in the reflection theorems. -/

namespace C2.CADEffective.Bivariate
open Polynomial

def gainProd : List Dense.Poly → Dense.Poly
  | [] => [1]
  | p :: ps => Dense.mul p (gainProd ps)

@[simp] theorem denote_gainProd (ps : List Dense.Poly) :
    Dense.denote (gainProd ps) = (ps.map Dense.denote).prod := by
  induction ps with
  | nil => simp [gainProd]
  | cons p ps ih => simp [gainProd,ih]

def simpleProjection (w : Witness) : Dense.Poly :=
  gainProd (List.ofFn (fun i : Fin w.n =>
    Dense.mul (Dense.mul (Dense.mul (leadingCoeff (w.factors.getD i []))
      (gammaEval (w.factors.getD i []) 0))
      (gammaEval (w.factors.getD i []) 1)) (w.simple.getD i [])))

def pairProjection (w : Witness) : Dense.Poly :=
  gainProd (List.ofFn (fun i : Fin w.n =>
    gainProd (List.ofFn (fun j : Fin w.n => (w.pair.getD i []).getD j []))))

def unitProjection (F : List Poly) (w : Witness) : Dense.Poly :=
  gainProd (List.ofFn (fun i : Fin F.length =>
    Dense.mul (w.left.getD i []) (w.right.getD i [])))

def basisProjection (w : Witness) : Dense.Poly :=
  Dense.mul (simpleProjection w) (pairProjection w)

/-- The exact finite product of all scalar, endpoint, leading and Bezout cuts. -/
def totalProjection (F : List Poly) (w : Witness) : Dense.Poly :=
  Dense.mul (basisProjection w) (unitProjection F w)

@[simp] theorem denote_simpleProjection (F : List Poly) (w : Witness) :
    Dense.denote (simpleProjection w) =
      ∏ i : Fin w.n, ((toFactorData F w).factors i).leadingCoeff *
        ((toFactorData F w).factors i).eval 0 *
        ((toFactorData F w).factors i).eval 1 * (toProjectionData w).simple i := by
  simp [simpleProjection,List.map_ofFn,List.prod_ofFn,toFactorData,toProjectionData]

@[simp] theorem denote_pairProjection (w : Witness) :
    Dense.denote (pairProjection w) =
      ∏ i : Fin w.n, ∏ j : Fin w.n, (toProjectionData w).pair i j := by
  simp [pairProjection,List.map_ofFn,List.prod_ofFn,toProjectionData]

@[simp] theorem denote_unitProjection (F : List Poly) (w : Witness) :
    Dense.denote (unitProjection F w) =
      ∏ i : Fin F.length, (toFactorData F w).left i * (toFactorData F w).right i := by
  simp [unitProjection,List.map_ofFn,List.prod_ofFn,toFactorData]

theorem denote_basisProjection (F : List Poly) (w : Witness) :
    Dense.denote (basisProjection w) =
      C2.CADProjection.projectionCut (toFactorData F w).factors (toProjectionData w) := by
  rw [basisProjection,Dense.denote_mul,denote_simpleProjection F w,denote_pairProjection]
  rfl

theorem denote_totalProjection (F : List Poly) (w : Witness) :
    Dense.denote (totalProjection F w) =
      C2.CADProjection.totalProjectionCut (toFactorData F w) (toProjectionData w) := by
  rw [totalProjection,Dense.denote_mul,denote_basisProjection F w,denote_unitProjection]
  rfl

theorem totalProjection_nonzero_of_valid (F : List Poly) (w : Witness)
    (hf : C2.CADProjection.ValidFactorData (inputFamily F) (toFactorData F w))
    (hp : C2.CADProjection.ValidProjectionData (toFactorData F w).factors (toProjectionData w)) :
    Dense.denote (totalProjection F w) ≠ 0 := by
  rw [denote_totalProjection]
  exact C2.CADProjection.totalProjectionCut_ne_zero hf hp

end C2.CADEffective.Bivariate


/- ===== C2.CADEffectiveWitnessEncoding ===== -/

/-! Finite rational-list witnesses exist for every nonzero input family.
The encodings in this proof are not runtime inputs: exhaustive search runs the
finite Boolean checker, and this theorem establishes that search terminates. -/
namespace C2.CADEffective.Bivariate

private theorem getD_ofFn_fin {α : Type*} {n : ℕ} (f : Fin n → α)
    (i : Fin n) (a : α) : (List.ofFn f).getD i a = f i := by
  rw [List.getD_eq_getElem _ _ (by simpa using i.isLt), List.getElem_ofFn]

/-- Every valid mathematical factor/projection package is represented by an
accepted finite raw witness. All polynomial coefficients are rational lists. -/
theorem exists_witness_of_valid_data (F : List Poly) {n : ℕ}
    (fd : C2.CADProjection.FactorData (Fin F.length) n)
    (pd : C2.CADProjection.ProjectionData (Fin n))
    (hfd : C2.CADProjection.ValidFactorData (inputFamily F) fd)
    (hpd : C2.CADProjection.ValidProjectionData fd.factors pd) :
    ∃ w : Witness, witnessCheck F w = true := by
  classical
  choose factors hfactors using (fun j => exists_encoding (fd.factors j))
  choose left hleft using (fun i => Dense.exists_encoding (fd.left i))
  choose right hright using (fun i => Dense.exists_encoding (fd.right i))
  choose simple hsimple using (fun j => Dense.exists_encoding (pd.simple j))
  choose simpleU hsimpleU using (fun j => exists_encoding (pd.simpleU j))
  choose simpleV hsimpleV using (fun j => exists_encoding (pd.simpleV j))
  choose pair hpair using (fun i j => Dense.exists_encoding (pd.pair i j))
  choose pairU hpairU using (fun i j => exists_encoding (pd.pairU i j))
  choose pairV hpairV using (fun i j => exists_encoding (pd.pairV i j))
  let w : Witness := {
    n := n
    factors := List.ofFn factors
    left := List.ofFn left
    right := List.ofFn right
    zeroPower := List.ofFn fd.zeroPower
    onePower := List.ofFn fd.onePower
    powers := List.ofFn (fun i => List.ofFn (fd.powers i))
    simple := List.ofFn simple
    simpleU := List.ofFn simpleU
    simpleV := List.ofFn simpleV
    pair := List.ofFn (fun i => List.ofFn (pair i))
    pairU := List.ofFn (fun i => List.ofFn (pairU i))
    pairV := List.ofFn (fun i => List.ofFn (pairV i)) }
  have hfd_eq : toFactorData F w = fd := by
    simp only [toFactorData, w, getD_ofFn_fin, hfactors, hleft, hright]
  have hpd_eq : toProjectionData w = pd := by
    simp only [toProjectionData, w, getD_ofFn_fin, hsimple, hsimpleU, hsimpleV,
      hpair, hpairU, hpairV]
  refine ⟨w, (witnessCheck_iff F w).mpr ?_⟩
  rw [hfd_eq, hpd_eq]
  exact ⟨hfd, hpd⟩

/-- The exact finite witness checker accepts some candidate for every family
whose input polynomials are nonzero. No projection or factor oracle is assumed. -/
theorem exists_witnessCheck (F : List Poly)
    (hF : ∀ i, inputFamily F i ≠ 0) : ∃ w : Witness, witnessCheck F w = true := by
  obtain ⟨n,fd,pd,hfd,hpd⟩ :=
    C2.CADProjection.exists_factor_projection_data (inputFamily F) hF
  exact exists_witness_of_valid_data F fd pd hfd hpd

end C2.CADEffective.Bivariate


/- ===== C2.CADEffectiveSearchExecution ===== -/

/-! Exact finite execution witnesses for the exhaustive search implementation. -/
namespace C2.CADEffective
variable {α : Type*} [Encodable α]

theorem scanFrom_eq_of_first (accept : α → Bool) (n fuel j : ℕ) (a : α)
    (hn : n ≤ j) (hj : j < n + fuel)
    (hd : Encodable.decode (α := α) j = some a) (ha : accept a = true)
    (hfirst : ∀ k, n ≤ k → k < j → acceptedCode accept k = false) :
    scanFrom accept n fuel = some a := by
  induction fuel generalizing n with
  | zero => omega
  | succ fuel ih =>
      by_cases he : j = n
      · subst j
        simp only [scanFrom, hd, ha, Bool.true_eq, ↓reduceIte]
      · have hnlt : n < j := by omega
        have hnext : scanFrom accept (n+1) fuel = some a :=
          ih (n+1) (by omega) (by omega) (fun k hk hkj => hfirst k (by omega) hkj)
        have hb := hfirst n (le_refl n) hnlt
        cases hnDec : Encodable.decode (α := α) n with
        | none => simpa only [scanFrom, hnDec] using hnext
        | some b =>
            have hbb : accept b = false := by simpa only [acceptedCode, hnDec, Option.any_some] using hb
            simpa only [scanFrom, hnDec, hbb, Bool.false_eq_true, ↓reduceIte] using hnext

/-- The exact selected result is returned after a finite explicitly bounded
prefix scan. This identifies the total search with its ordinary finite loop. -/
theorem search_finite_execution_eq (accept : α → Bool) (h : ∃ a, accept a = true) :
    scanFrom accept 0 (searchIndex accept h + 1) = some (search accept h) := by
  apply scanFrom_eq_of_first accept 0 (searchIndex accept h + 1)
    (searchIndex accept h) (search accept h) (Nat.zero_le _) (by omega)
  · exact Option.eq_some_of_isSome _
  · exact search_accepted accept h
  · intro k _ hk
    exact searchIndex_minimal accept h hk

end C2.CADEffective


/- ===== C2.CADEffectiveWitnessSearch ===== -/

/-! A total executable producer of the full finite factorization and projection
witness. Mathematical existence is used only by the erased termination proof;
the returned coefficients are decoded by an explicit finite search and checked
using rational list arithmetic. -/
namespace C2.CADEffective.Bivariate

/-- Every input polynomial is nonzero, decided by finite coefficient checks. -/
def nonzeroInputs (F : List Poly) : Bool :=
  decide (∀ i : Fin F.length, eqb (F.getD i []) [] = false)

theorem nonzeroInputs_iff (F : List Poly) : nonzeroInputs F = true ↔
    ∀ i : Fin F.length, inputFamily F i ≠ 0 := by
  simp only [nonzeroInputs, decide_eq_true_eq, inputFamily]
  apply forall_congr'
  intro i
  simpa only [Bool.not_eq_true, denote_nil] using not_congr (eqb_eq_true_iff (F.getD i []) [])

/-- The full projection-data producer uses no factorization or root oracle. -/
def produceWitness (F : List Poly) (hF : ∀ i : Fin F.length, inputFamily F i ≠ 0) : Witness :=
  C2.CADEffective.search (witnessCheck F) (exists_witnessCheck F hF)

theorem produceWitness_accepted (F : List Poly)
    (hF : ∀ i : Fin F.length, inputFamily F i ≠ 0) :
    witnessCheck F (produceWitness F hF) = true :=
  C2.CADEffective.search_accepted _ _

theorem produceWitness_correct (F : List Poly)
    (hF : ∀ i : Fin F.length, inputFamily F i ≠ 0) :
    C2.CADProjection.ValidFactorData (inputFamily F) (toFactorData F (produceWitness F hF)) ∧
    C2.CADProjection.ValidProjectionData (toFactorData F (produceWitness F hF)).factors
      (toProjectionData (produceWitness F hF)) :=
  (witnessCheck_iff F _).mp (produceWitness_accepted F hF)

/-- A concrete finite execution of the actual producer, with a natural-number
bound on its rational-data search. No external certificate is a runtime input. -/
theorem produceWitness_finite_execution (F : List Poly)
    (hF : ∀ i : Fin F.length, inputFamily F i ≠ 0) :
    ∃ fuel : ℕ, C2.CADEffective.scanFrom (witnessCheck F) 0 fuel =
      some (produceWitness F hF) := by
  exact ⟨C2.CADEffective.searchIndex (witnessCheck F) (exists_witnessCheck F hF) + 1,
    C2.CADEffective.search_finite_execution_eq _ _⟩

end C2.CADEffective.Bivariate


/- ===== C2.CADNativeProjection ===== -/

/-! Correctness of the actual projection produced from native rational lists.
The finite Boolean checker, and then its total search, imply feasibility
constancy of the original input inequalities on every projection-free cell. -/
namespace C2.CADEffective.Bivariate
open Set

def rawFeasible (F : List Poly) (k : ℝ) : Prop :=
  ∃ x ∈ Icc (0:ℝ) 1, ∀ p ∈ F, 0 < CADProjection.value (denote p) k x

theorem inputFamily_positive_iff (F : List Poly) (k x : ℝ) :
    (∀ i, 0 < CADProjection.value (inputFamily F i) k x) ↔
      ∀ p ∈ F, 0 < CADProjection.value (denote p) k x := by
  constructor
  · intro h p hp
    obtain ⟨i,hi,rfl⟩ := List.mem_iff_getElem.mp hp
    simpa only [inputFamily, List.getD_eq_getElem F [] hi] using h ⟨i,hi⟩
  · intro h i
    have hm : F.getD i [] ∈ F := by
      rw [List.getD_eq_getElem F [] i.isLt]
      exact List.getElem_mem i.isLt
    exact h (F.getD i []) hm

theorem rawFeasible_iff_inputFamily (F : List Poly) (k : ℝ) :
    rawFeasible F k ↔
      ∃ x ∈ Icc (0:ℝ) 1, ∀ i, 0 < CADProjection.value (inputFamily F i) k x := by
  simp only [rawFeasible, inputFamily_positive_iff]

/-- An accepted native witness proves constancy for the actual input list,
not merely for its encoded factor basis or an assumed CAD partition. -/
theorem totalProjection_feasibility_constant (F : List Poly) (w : Witness)
    (hw : witnessCheck F w = true) (I : Set ℝ) (hI : IsPreconnected I)
    (hcut : ∀ k ∈ I,
      CADIsolation.realEval (Dense.denote (totalProjection F w)) k ≠ 0)
    {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) :
    (∃ x ∈ Icc (0:ℝ) 1, ∀ p ∈ F, 0 < CADProjection.value (denote p) a x) ↔
    (∃ x ∈ Icc (0:ℝ) 1, ∀ p ∈ F, 0 < CADProjection.value (denote p) b x) := by
  obtain ⟨hf,hp⟩ := (witnessCheck_iff F w).mp hw
  have hc : ∀ k ∈ I,
      (CADProjection.totalProjectionCut (toFactorData F w) (toProjectionData w)).eval₂
        (algebraMap ℚ ℝ) k ≠ 0 := by
    simpa only [CADIsolation.realEval, denote_totalProjection] using hcut
  have h := CADProjection.valid_data_feasibility_constant (inputFamily F)
    (toFactorData F w) (toProjectionData w) hf hp I hI hc ha hb
  simpa only [inputFamily_positive_iff] using h

/-- The projection producer itself has the required cell invariance; its
only data input is the finite rational polynomial family. -/
theorem producedProjection_feasibility_constant (F : List Poly)
    (hF : ∀ i, inputFamily F i ≠ 0)
    (I : Set ℝ) (hI : IsPreconnected I)
    (hcut : ∀ k ∈ I, CADIsolation.realEval
      (Dense.denote (totalProjection F (produceWitness F hF))) k ≠ 0)
    {a b : ℝ} (ha : a ∈ I) (hb : b ∈ I) :
    (∃ x ∈ Icc (0:ℝ) 1, ∀ p ∈ F, 0 < CADProjection.value (denote p) a x) ↔
    (∃ x ∈ Icc (0:ℝ) 1, ∀ p ∈ F, 0 < CADProjection.value (denote p) b x) :=
  totalProjection_feasibility_constant F (produceWitness F hF)
    (produceWitness_accepted F hF) I hI hcut ha hb

end C2.CADEffective.Bivariate


/- ===== C2.CADDriverProduct ===== -/

/-! Exact product and specialization bridges for the native CAD lifting stage. -/
namespace C2.CADDriver
open Polynomial Set C2.CADEffective C2.CADIsolation

theorem realEval_product (ps : List Dense.Poly) (x : ℝ) :
    realEval (Dense.denote (product ps)) x =
      (ps.map (fun p => realEval (Dense.denote p) x)).prod := by
  rw [denote_product]
  simp only [realEval,Polynomial.eval₂_list_prod,List.map_map,Function.comp_def]

theorem product_root_of_factor (ps : List Dense.Poly) (p : Dense.Poly)
    (hp : p ∈ ps) (x : ℝ) (hz : realEval (Dense.denote p) x = 0) :
    realEval (Dense.denote (product ps)) x = 0 := by
  rw [realEval_product]
  apply List.prod_eq_zero
  exact List.mem_map.mpr ⟨p,hp,hz⟩

theorem product_roots_finite (ps : List Dense.Poly)
    (hp : Dense.denote (product ps) ≠ 0) :
    Set.Finite {x : ℝ | realEval (Dense.denote (product ps)) x = 0} := by
  have hp' : (Dense.denote (product ps)).map (algebraMap ℚ ℝ) ≠ 0 :=
    Polynomial.map_ne_zero (f:=algebraMap ℚ ℝ) hp
  simpa only [Polynomial.IsRoot,Polynomial.eval_map,realEval] using
    Polynomial.finite_setOf_isRoot hp'

theorem realEval_atGain_value (p : Bivariate.Poly) (gain : ℚ) (x : ℝ) :
    realEval (Dense.denote (Bivariate.atGain p gain)) x =
      CADProjection.value (Bivariate.denote p) (gain:ℝ) x := by
  simp only [realEval,Bivariate.denote_atGain,Polynomial.eval₂_map,
    CADProjection.value,CADProjection.specialize,Polynomial.eval_map]
  congr 1
  apply RingHom.ext
  intro q
  exact (Polynomial.eval₂_at_apply (p:=q) (algebraMap ℚ ℝ) gain).symm

@[simp] theorem rational_atGain_positive (p : Bivariate.Poly) (gain gamma : ℚ) :
    0 < Bivariate.eval p gamma gain ↔
      0 < CADProjection.value (Bivariate.denote p) (gain:ℝ) (gamma:ℝ) := by
  rw [← realEval_atGain_value, realEval_rat_pos]
  simp only [Bivariate.eval,Dense.eval_denote]

end C2.CADDriver


/- ===== C2.CADDriverParameter ===== -/

/-! Correctness of the actual fixed-gain lifting program. The finite rational
samples are computed from the isolated product roots; sign constancy and
coverage are consequences of that certified output. -/
noncomputable section
namespace C2.CADDriver
open Set C2.CADEffective C2.CADAlgorithm C2.CADIsolation

theorem forall_list_get_iff {α : Type*} (ps : List α) (P : α → Prop) :
    (∀ i : Fin ps.length, P (ps.get i)) ↔ ∀ p ∈ ps, P p := by
  constructor
  · intro h p hp
    obtain ⟨i, rfl⟩ := List.mem_iff_get.mp hp
    exact h i
  · intro h i
    exact h _ (List.get_mem _ _)

/-- The samples generated by the native product isolator decide the complete
closed parameter domain, including feasibility at endpoint or root sections. -/
theorem dense_feasible_iff_gap_samples (ps : List Dense.Poly)
    (hp : Dense.denote (product ps) ≠ 0) :
    (∃ x ∈ Icc (0 : ℝ) 1, ∀ p ∈ ps, 0 < realEval (Dense.denote p) x) ↔
      ∃ q ∈ gapSamples (isolate (product ps) hp 0 1 (by norm_num)) 0 1,
        ∀ p ∈ ps, 0 < Dense.eval p q := by
  let hab : (0 : ℚ) < 1 := by norm_num
  let d := isolate (product ps) hp 0 1 hab.le
  let v := rootValue (product ps) hp 0 1 hab
  let cells : List (Cell ℝ) := (consecutiveRanks d).map fun c =>
    ⟨v c.1, v c.2, Dense.betweenRanks 0 1 d.mesh c.1 c.2, false⟩
  let f : ℝ → Fin ps.length → ℝ := fun x i => realEval (Dense.denote (ps.get i)) x
  have hcover : ∀ x ∈ Ioo (0 : ℝ) 1,
      x ∉ {x | realEval (Dense.denote (product ps)) x = 0} →
      ∃ c ∈ cells, x ∈ Ioo c.left c.right := by
    intro x hx hn
    obtain ⟨r, s, hpair, hxs⟩ := rootValue_gap_cover (product ps) hp 0 1 hab (by simpa using hx) hn
    exact ⟨_, List.mem_map.mpr ⟨(r,s), hpair, rfl⟩, hxs⟩
  have hbounded : ∀ c ∈ cells, 0 ≤ c.left ∧ c.right ≤ 1 := by
    intro c hc
    obtain ⟨⟨r,s⟩, hpair, rfl⟩ := List.mem_map.mp hc
    obtain ⟨hr, hs, _, _⟩ := Dense.rankPairs_properties
      (isolate_ranks_sorted (product ps) hp 0 1 hab.le) hpair
    constructor
    · simpa [v] using (rootValue_mem_Icc (product ps) hp 0 1 hab hr).1
    · simpa [v] using (rootValue_mem_Icc (product ps) hp 0 1 hab hs).2
  have hsample : ∀ c ∈ cells, (c.sample : ℝ) ∈ Ioo c.left c.right := by
    intro c hc
    obtain ⟨⟨r,s⟩, hpair, rfl⟩ := List.mem_map.mp hc
    exact rootValue_gap_sample (product ps) hp 0 1 hab hpair
  have hconstant : ∀ c ∈ cells, ∀ x ∈ Ioo c.left c.right,
      (∀ i, 0 < f x i) ↔ ∀ i, 0 < f c.sample i := by
    intro c hc x hx
    obtain ⟨⟨r,s⟩, hpair, rfl⟩ := List.mem_map.mp hc
    apply forall_congr'
    intro i
    apply realEval_pos_iff_of_no_roots _ hx
      (rootValue_gap_sample (product ps) hp 0 1 hab hpair)
    intro z hz hzero
    exact rootValue_gap_no_root (product ps) hp 0 1 hab hpair z hz
      (product_root_of_factor ps (ps.get i) (List.get_mem _ _) z hzero)
  have hbridge := closed_parameter_feasibility_iff_cell_test f
    (fun i => realEval_continuous (Dense.denote (ps.get i))) cells
    {x | realEval (Dense.denote (product ps)) x = 0}
    (product_roots_finite ps hp) hcover hbounded hsample hconstant
  have hi : ∀ x, (∀ i, 0 < f x i) ↔ ∀ p ∈ ps, 0 < realEval (Dense.denote p) x :=
    fun x => forall_list_get_iff ps (fun p => 0 < realEval (Dense.denote p) x)
  simp_rw [hi] at hbridge
  rw [hbridge]
  constructor
  · rintro ⟨c, hc, hpos⟩
    obtain ⟨⟨r,s⟩, hpair, rfl⟩ := List.mem_map.mp hc
    refine ⟨_, List.mem_map.mpr ⟨(r,s), hpair, rfl⟩, ?_⟩
    intro p hpm
    rw [Dense.eval_denote]
    exact (realEval_rat_pos _ _).mp (hpos p hpm)
  · rintro ⟨q, hq, hpos⟩
    obtain ⟨⟨r,s⟩, hpair, rfl⟩ := List.mem_map.mp hq
    refine ⟨_, List.mem_map.mpr ⟨(r,s), hpair, rfl⟩, ?_⟩
    intro p hpm
    apply (realEval_rat_pos _ _).mpr
    simpa only [← Dense.eval_denote] using hpos p hpm

/-- Correctness of the executable lifting and Boolean mark at a rational gain. -/
theorem markGain_correct (input : List Bivariate.Poly) (gain : ℚ) :
    markGain input gain = true ↔
      ∃ x ∈ Icc (0 : ℝ) 1,
        ∀ p ∈ input, 0 < realEval (Dense.denote (Bivariate.atGain p gain)) x := by
  by_cases hz : anyZero (specializations input gain) = true
  · rw [markGain_zero_specialization input gain hz]
    simp only [Bool.false_eq_true, false_iff]
    obtain ⟨q, hq, hqzero⟩ : ∃ q ∈ specializations input gain, Dense.denote q = 0 := by
      simpa [anyZero, Dense.eqb_eq_true_iff] using hz
    obtain ⟨p, hpm, rfl⟩ := List.mem_map.mp hq
    rintro ⟨x, _, hpos⟩
    simpa [hqzero, realEval] using hpos p hpm
  · have hzfalse := Bool.eq_false_iff.mpr hz
    have hp := product_nonzero (specializations input gain)
      ((anyZero_eq_false_iff _).mp hzfalse)
    have he : parameterIsolation input gain =
        some (isolate (product (specializations input gain)) hp 0 1 (by norm_num)) := by
      simp only [parameterIsolation, hzfalse, Bool.false_eq_true, dite_false]
    rw [markGain_true_iff]
    simp only [parameterSamples, he]
    have h := dense_feasible_iff_gap_samples (specializations input gain) hp
    simpa only [specializations, List.forall_mem_map, Bivariate.eval] using h.symm

/-- The fixed-gain mark refers to the original bivariate inequalities. -/
theorem markGain_rawFeasible (input : List Bivariate.Poly) (gain : ℚ) :
    markGain input gain = true ↔ Bivariate.rawFeasible input (gain : ℝ) := by
  rw [markGain_correct]
  simp only [Bivariate.rawFeasible, realEval_atGain_value]

end C2.CADDriver

end

/- ===== C2.CADEffectiveBezout ===== -/

/-! A terminating producer for exact bivariate Bezout data. The algorithm
searches explicitly encoded rational coefficient lists and checks arithmetic
identities. Generic coprimeness proves that its search succeeds; it is not a
supplied witness oracle. -/
namespace C2.CADEffective.Bivariate
open Polynomial

abbrev BezoutData := Dense.Poly × Poly × Poly

def bezoutCheck (p q : Poly) (w : BezoutData) : Bool :=
  !(Dense.eqb w.1 []) &&
    eqb (add (mul w.2.1 p) (mul w.2.2 q)) (constant w.1)

theorem bezoutCheck_iff (p q : Poly) (w : BezoutData) :
    bezoutCheck p q w = true ↔
      Dense.denote w.1 ≠ 0 ∧
        denote w.2.1 * denote p + denote w.2.2 * denote q = C (Dense.denote w.1) := by
  simp only [bezoutCheck, Bool.and_eq_true, Bool.not_eq_true,
    eqb_eq_true_iff, denote_add, denote_mul, denote_constant]
  constructor
  · rintro ⟨hr, hi⟩
    refine ⟨?_, hi⟩
    intro hz
    have ht : Dense.eqb w.1 [] = true := (Dense.eqb_eq_true_iff _ _).mpr (by simpa using hz)
    rw [ht] at hr
    cases hr
  · rintro ⟨hr, hi⟩
    refine ⟨?_, hi⟩
    cases he : Dense.eqb w.1 [] with
    | false => rfl
    | true =>
        have hz := (Dense.eqb_eq_true_iff _ _).mp he
        exact False.elim (hr (by simpa using hz))

theorem exists_bezoutCheck (p q : Poly)
    (h : IsCoprime ((denote p).map (algebraMap ℚ[X] (RatFunc ℚ)))
      ((denote q).map (algebraMap ℚ[X] (RatFunc ℚ)))) :
    ∃ w : BezoutData, bezoutCheck p q w = true := by
  obtain ⟨r, hr, u, v, hid⟩ := C2.CADProjection.exists_bezout_eliminant
    (F := RatFunc ℚ) (denote p) (denote q) h
  obtain ⟨r', hr'⟩ := Dense.exists_encoding r
  obtain ⟨u', hu'⟩ := exists_encoding u
  obtain ⟨v', hv'⟩ := exists_encoding v
  refine ⟨(r', u', v'), (bezoutCheck_iff _ _ _).mpr ?_⟩
  simpa only [hr', hu', hv'] using And.intro hr hid

/-- Executable exhaustive search. The number of trials is finite because the
previous theorem supplies an accepted dense encoding. -/
def produceBezout (p q : Poly)
    (h : IsCoprime ((denote p).map (algebraMap ℚ[X] (RatFunc ℚ)))
      ((denote q).map (algebraMap ℚ[X] (RatFunc ℚ)))) : BezoutData :=
  C2.CADEffective.search (bezoutCheck p q) (exists_bezoutCheck p q h)

theorem produceBezout_accepted (p q : Poly)
    (h : IsCoprime ((denote p).map (algebraMap ℚ[X] (RatFunc ℚ)))
      ((denote q).map (algebraMap ℚ[X] (RatFunc ℚ)))) :
    bezoutCheck p q (produceBezout p q h) = true :=
  C2.CADEffective.search_accepted _ _

theorem produceBezout_correct (p q : Poly)
    (h : IsCoprime ((denote p).map (algebraMap ℚ[X] (RatFunc ℚ)))
      ((denote q).map (algebraMap ℚ[X] (RatFunc ℚ)))) :
    Dense.denote (produceBezout p q h).1 ≠ 0 ∧
      denote (produceBezout p q h).2.1 * denote p +
        denote (produceBezout p q h).2.2 * denote q = C (Dense.denote (produceBezout p q h).1) :=
  (bezoutCheck_iff _ _ _).mp (produceBezout_accepted p q h)

theorem produceBezout_finite_execution (p q : Poly)
    (h : IsCoprime ((denote p).map (algebraMap ℚ[X] (RatFunc ℚ)))
      ((denote q).map (algebraMap ℚ[X] (RatFunc ℚ)))) :
    ∃ fuel w, C2.CADEffective.scanFrom (bezoutCheck p q) 0 fuel = some w ∧
      bezoutCheck p q w = true := by
  obtain ⟨w, hw, hc⟩ := C2.CADEffective.search_has_finite_execution
    (bezoutCheck p q) (exists_bezoutCheck p q h)
  exact ⟨_, w, hw, hc⟩

end C2.CADEffective.Bivariate


/- ===== C2.CADGainCuts ===== -/

/-! Bounded algebraic gain cuts and their actual adjacent open cells. -/
noncomputable section
open Polynomial Set
namespace C2.CADGainCuts

def cuts (p : ℚ[X]) (hp : p ≠ 0) (K : ℚ) : Finset ℝ := by
  classical
  exact ((CADProjection.rational_zero_set_finite p hp).toFinset.filter
    fun x => x ∈ Icc (0 : ℝ) (K : ℝ)) ∪ {0,(K : ℝ)}

theorem mem_cuts_iff (p : ℚ[X]) (hp : p ≠ 0) (K : ℚ) (x : ℝ) :
    x ∈ cuts p hp K ↔
      (p.eval₂ (algebraMap ℚ ℝ) x = 0 ∧ x ∈ Icc 0 (K : ℝ)) ∨
      x = 0 ∨ x = (K : ℝ) := by
  classical
  simp [cuts,or_assoc,or_left_comm,or_comm]

theorem zero_mem (p : ℚ[X]) (hp : p ≠ 0) (K : ℚ) :
    (0 : ℝ) ∈ cuts p hp K := (mem_cuts_iff p hp K 0).mpr (Or.inr (Or.inl rfl))

theorem upper_mem (p : ℚ[X]) (hp : p ≠ 0) (K : ℚ) :
    (K : ℝ) ∈ cuts p hp K :=
  (mem_cuts_iff p hp K (K : ℝ)).mpr (Or.inr (Or.inr rfl))

theorem cuts_bounded (p : ℚ[X]) (hp : p ≠ 0) {K : ℚ} (hK : 0 ≤ K) :
    ∀ x ∈ cuts p hp K, x ∈ Icc (0 : ℝ) (K : ℝ) := by
  intro x hx
  have hK' : (0 : ℝ) ≤ (K : ℝ) := by exact_mod_cast hK
  rcases (mem_cuts_iff p hp K x).mp hx with hx | rfl | rfl
  · exact hx.2
  · exact ⟨le_rfl,hK'⟩
  · exact ⟨hK',le_rfl⟩

theorem rational_isAlgebraic (q : ℚ) : IsAlgebraic ℚ (q : ℝ) := by
  refine ⟨X - C q, Polynomial.X_sub_C_ne_zero q, ?_⟩
  simp

theorem cuts_algebraic (p : ℚ[X]) (hp : p ≠ 0) (K : ℚ) :
    ∀ x ∈ cuts p hp K, IsAlgebraic ℚ x := by
  intro x hx
  rcases (mem_cuts_iff p hp K x).mp hx with hx | rfl | rfl
  · exact CADProjection.rational_zero_isAlgebraic p hp hx.1
  · simpa using rational_isAlgebraic 0
  · exact rational_isAlgebraic K

theorem nonzero_on_cell (p : ℚ[X]) (hp : p ≠ 0) {K : ℚ} (hK : 0 ≤ K)
    {a b : ℝ} (hab : CADCells.Adjacent (cuts p hp K) a b)
    {x : ℝ} (hx : x ∈ Ioo a b) : p.eval₂ (algebraMap ℚ ℝ) x ≠ 0 := by
  intro heq
  have hbound := cuts_bounded p hp hK
  have hxbound : x ∈ Icc 0 (K : ℝ) :=
    ⟨(hbound a hab.1).1.trans hx.1.le,hx.2.le.trans (hbound b hab.2.1).2⟩
  exact CADCells.no_cut_inside hab hx
    ((mem_cuts_iff p hp K x).mpr (Or.inl ⟨heq,hxbound⟩))

theorem exact_cell_cover (p : ℚ[X]) (hp : p ≠ 0) {K : ℚ} (hK : 0 ≤ K) :
    {x : ℝ | ∃ c ∈ CADCells.cells (cuts p hp K), x ∈ Ioo c.1 c.2} =
      Ioo 0 (K : ℝ) \ (cuts p hp K : Set ℝ) := by
  exact CADCells.cut_union_coverage (zero_mem p hp K) (upper_mem p hp K)
    (cuts_bounded p hp hK)

theorem cells_are_projection_free (p : ℚ[X]) (hp : p ≠ 0)
    {K : ℚ} (hK : 0 ≤ K) {a b : ℝ}
    (hab : (a,b) ∈ CADCells.cells (cuts p hp K)) :
    IsPreconnected (Ioo a b) ∧
      ∀ k ∈ Ioo a b, p.eval₂ (algebraMap ℚ ℝ) k ≠ 0 := by
  exact ⟨isPreconnected_Ioo,fun _ hk =>
    nonzero_on_cell p hp hK ((CADCells.mem_cells_iff _ _ _).mp hab) hk⟩

end C2.CADGainCuts

end

/- ===== C2.CADParameterSigns ===== -/

/-! Fixed-gain lifting from actual polynomial root cuts. Unlike the generic
lifting interface, sign constancy is proved here by the intermediate value
theorem and the absence of polynomial roots inside adjacent cells. -/

noncomputable section
open Set
namespace C2.CADAlgorithm

theorem positive_iff_on_preconnected {S : Set ℝ} (hS : IsPreconnected S)
    {f : ℝ → ℝ} (hf : ContinuousOn f S) (hzero : ∀ x ∈ S, f x ≠ 0)
    {x y : ℝ} (hx : x ∈ S) (hy : y ∈ S) : 0 < f x ↔ 0 < f y := by
  have step : ∀ a ∈ S, ∀ b ∈ S, 0 < f a → 0 < f b := by
    intro a ha b hb hfa
    by_contra hfb
    obtain ⟨z, hz, hz0⟩ := hS.intermediate_value₂ hb ha hf continuousOn_const
      (le_of_not_gt hfb) hfa.le
    exact hzero z hz hz0
  exact ⟨step x hx y hy, step y hy x hx⟩

theorem polynomial_sign_constant_on_adjacent {cuts : Finset ℝ}
    {p : Polynomial ℝ} {a b x y : ℝ}
    (hadj : C2.CADCells.Adjacent cuts a b)
    (hroots : ∀ z ∈ Ioo a b, p.eval z = 0 → z ∈ cuts)
    (hx : x ∈ Ioo a b) (hy : y ∈ Ioo a b) :
    0 < p.eval x ↔ 0 < p.eval y := by
  apply positive_iff_on_preconnected isPreconnected_Ioo p.continuous.continuousOn
    _ hx hy
  intro z hz hzero
  exact C2.CADCells.no_cut_inside hadj hz (hroots z hz hzero)

def parameterCells (cuts : Finset ℝ) (samples : (ℝ × ℝ) → ℚ) : List (Cell ℝ) :=
  (C2.CADCells.cells cuts).toList.map fun c =>
    {left := c.1, right := c.2, sample := samples c, marked := false}

/-- Once all polynomial roots in (0,1) are among the cuts, one rational sample
in each actual adjacent cell decides the entire closed parameter interval. -/
theorem polynomial_parameter_feasibility_iff {ι : Type*} [Finite ι]
    (p : ι → Polynomial ℝ) (cuts : Finset ℝ)
    (hzero : 0 ∈ cuts) (hone : 1 ∈ cuts)
    (hbound : ∀ c ∈ cuts, c ∈ Icc (0 : ℝ) 1)
    (hroots : ∀ i z, z ∈ Ioo (0 : ℝ) 1 → (p i).eval z = 0 → z ∈ cuts)
    (samples : (ℝ × ℝ) → ℚ)
    (hsample : ∀ c ∈ C2.CADCells.cells cuts, (samples c : ℝ) ∈ Ioo c.1 c.2) :
    (∃ γ ∈ Icc (0 : ℝ) 1, ∀ i, 0 < (p i).eval γ) ↔
      ∃ c ∈ C2.CADCells.cells cuts, ∀ i, 0 < (p i).eval (samples c : ℝ) := by
  have hcover : ∀ γ ∈ Ioo (0 : ℝ) 1, γ ∉ (cuts : Set ℝ) →
      ∃ c ∈ parameterCells cuts samples, γ ∈ Ioo c.left c.right := by
    intro γ hγ hγc
    obtain ⟨c, hc, hγcell⟩ :=
      (C2.CADCells.finite_cell_cover hzero hone hbound).mpr ⟨hγ, hγc⟩
    exact ⟨⟨c.1, c.2, samples c, false⟩,
      List.mem_map.mpr ⟨c, Finset.mem_toList.mpr hc, rfl⟩, hγcell⟩
  have hbounded : ∀ c ∈ parameterCells cuts samples, 0 ≤ c.left ∧ c.right ≤ 1 := by
    intro c hc
    obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc
    have hadj := (C2.CADCells.mem_cells_iff cuts d.1 d.2).mp (Finset.mem_toList.mp hd)
    exact ⟨(hbound d.1 hadj.1).1, (hbound d.2 hadj.2.1).2⟩
  have hsample' : ∀ c ∈ parameterCells cuts samples,
      (c.sample : ℝ) ∈ Ioo c.left c.right := by
    intro c hc
    obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc
    exact hsample d (Finset.mem_toList.mp hd)
  have hconstant : ∀ c ∈ parameterCells cuts samples, ∀ γ ∈ Ioo c.left c.right,
      (∀ i, 0 < (p i).eval γ) ↔ ∀ i, 0 < (p i).eval (c.sample : ℝ) := by
    intro c hc γ hγ
    obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc
    have hd' := Finset.mem_toList.mp hd
    have hadj := (C2.CADCells.mem_cells_iff cuts d.1 d.2).mp hd'
    apply forall_congr'
    intro i
    apply polynomial_sign_constant_on_adjacent hadj _ hγ (hsample d hd')
    intro z hz hzeq
    have hz01 := (C2.CADCells.finite_cell_cover hzero hone hbound).mp ⟨d, hd', hz⟩
    exact hroots i z hz01.1 hzeq
  rw [closed_parameter_feasibility_iff_cell_test (fun γ i => (p i).eval γ)
    (fun i => (p i).continuous) (parameterCells cuts samples) (cuts : Set ℝ)
    cuts.finite_toSet hcover hbounded hsample' hconstant]
  constructor
  · rintro ⟨c, hc, hpos⟩
    obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc
    exact ⟨d, Finset.mem_toList.mp hd, hpos⟩
  · rintro ⟨d, hd, hpos⟩
    exact ⟨⟨d.1, d.2, samples d, false⟩,
      List.mem_map.mpr ⟨d, Finset.mem_toList.mpr hd, rfl⟩, hpos⟩

/-- Exact rational marking for a fixed gain, with sign constancy derived from
the actual polynomial root cuts rather than supplied as a hypothesis. -/
theorem polynomial_lifting_mark_correct {n : ℕ}
    (tests : Fin n → ℚ → ℚ → ℚ) (gain : ℚ) (p : Fin n → Polynomial ℝ)
    (hcast : ∀ q i, ((tests i q gain : ℚ) : ℝ) = (p i).eval (q : ℝ))
    (cuts : Finset ℝ) (hzero : 0 ∈ cuts) (hone : 1 ∈ cuts)
    (hbound : ∀ c ∈ cuts, c ∈ Icc (0 : ℝ) 1)
    (hroots : ∀ i z, z ∈ Ioo (0 : ℝ) 1 → (p i).eval z = 0 → z ∈ cuts)
    (samples : (ℝ × ℝ) → ℚ)
    (hsample : ∀ c ∈ C2.CADCells.cells cuts, (samples c : ℝ) ∈ Ioo c.1 c.2) :
    markAtGain (List.ofFn tests) ((C2.CADCells.cells cuts).toList.map samples) gain = true ↔
      ∃ γ ∈ Icc (0 : ℝ) 1, ∀ i, 0 < (p i).eval γ := by
  rw [markAtGain_ofFn_iff, polynomial_parameter_feasibility_iff
    p cuts hzero hone hbound hroots samples hsample]
  have hpos : ∀ q i, 0 < tests i q gain ↔ 0 < (p i).eval (q : ℝ) := by
    intro q i
    rw [← hcast q i]
    exact Rat.cast_pos.symm
  simp_rw [hpos]
  constructor
  · rintro ⟨q, hq, hpos⟩
    obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hq
    exact ⟨c, Finset.mem_toList.mp hc, hpos⟩
  · rintro ⟨c, hc, hpos⟩
    exact ⟨samples c, List.mem_map.mpr ⟨c, Finset.mem_toList.mpr hc, rfl⟩, hpos⟩

theorem zero_polynomial_inequality_infeasible {ι : Type*}
    (p : ι → Polynomial ℝ) {i : ι} (hzero : p i = 0) :
    ¬∃ γ ∈ Icc (0 : ℝ) 1, ∀ j, 0 < (p j).eval γ := by
  rintro ⟨γ, _, hpos⟩
  have := hpos i
  simpa [hzero] using this

theorem zero_rational_test_never_marks {n : ℕ}
    (tests : Fin n → ℚ → ℚ → ℚ) (gain : ℚ) (samples : List ℚ)
    {i : Fin n} (hzero : ∀ q, tests i q gain = 0) :
    markAtGain (List.ofFn tests) samples gain = false := by
  rw [Bool.eq_false_iff, ne_eq, markAtGain_ofFn_iff]
  rintro ⟨q, _, hpos⟩
  have := hpos i
  simpa [hzero] using this

end C2.CADAlgorithm

end

/- ===== C2.CADGlobalLifting ===== -/

/-! Construction of complete finite rational lifting samples at every rational
gain. This is mathematical existence from the actual finite polynomial roots;
the separate effective isolation development supplies executable encodings. -/

noncomputable section
open Polynomial Set
namespace C2.CADGlobal

/-- Exact rational evaluation, with parameter first and gain second. -/
def rationalTest (p : CADProjection.Bivariate) (γ k : ℚ) : ℚ :=
  (p.map (Polynomial.evalRingHom k)).eval γ

@[simp] theorem rational_eval_cast (p : ℚ[X]) (k : ℚ) :
    ((p.eval k : ℚ) : ℝ) = p.eval₂ (algebraMap ℚ ℝ) (k : ℝ) := by
  exact (Polynomial.eval₂_at_apply (p := p) (algebraMap ℚ ℝ) k).symm

/-- The exact rational sign test agrees with the actual real polynomial. -/
theorem rationalTest_cast (p : CADProjection.Bivariate) (γ k : ℚ) :
    ((rationalTest p γ k : ℚ) : ℝ) = CADProjection.value p k γ := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => simpa [rationalTest, CADProjection.value, CADProjection.specialize] using congrArg₂ (· + ·) hp hq
  | monomial n a =>
      simp [rationalTest, CADProjection.value, CADProjection.specialize, rational_eval_cast]

/-- Rational choices for every adjacent pair of any finite real cut set. -/
theorem exists_cell_samples (cuts : Finset ℝ) :
    ∃ samples : (ℝ × ℝ) → ℚ,
      ∀ c ∈ CADCells.cells cuts, (samples c : ℝ) ∈ Ioo c.1 c.2 := by
  classical
  have he : ∀ c : ℝ × ℝ, ∃ q : ℚ,
      c ∈ CADCells.cells cuts → (q : ℝ) ∈ Ioo c.1 c.2 := by
    intro c
    by_cases hc : c ∈ CADCells.cells cuts
    · obtain ⟨q, hq⟩ := CADCells.rational_sample_exists
        ((CADCells.mem_cells_iff cuts c.1 c.2).mp hc)
      exact ⟨q, fun _ => hq⟩
    · exact ⟨0, fun h => (hc h).elim⟩
  choose samples hsamples using he
  exact ⟨samples, hsamples⟩

/-- All actual roots of finitely many nonzero real polynomials in [0,1]
are included in one finite cut set with endpoints. -/
theorem exists_parameter_cuts {n : ℕ} (p : Fin n → ℝ[X])
    (hp : ∀ i, p i ≠ 0) :
    ∃ cuts : Finset ℝ, 0 ∈ cuts ∧ 1 ∈ cuts ∧
      (∀ c ∈ cuts, c ∈ Icc (0 : ℝ) 1) ∧
      (∀ i x, x ∈ Ioo (0 : ℝ) 1 → (p i).eval x = 0 → x ∈ cuts) := by
  classical
  let P : ℝ[X] := ∏ i, p i
  have hP : P ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)
  have hfinite : Set.Finite {x : ℝ | P.eval x = 0} :=
    Polynomial.finite_setOf_isRoot hP
  let cuts : Finset ℝ := (hfinite.toFinset.filter fun x => x ∈ Icc (0 : ℝ) 1) ∪ {0, 1}
  have hmem : ∀ x : ℝ, x ∈ cuts ↔
      (P.eval x = 0 ∧ x ∈ Icc (0 : ℝ) 1) ∨ x = 0 ∨ x = 1 := by
    intro x
    simp [cuts, or_assoc, or_left_comm, or_comm]
  refine ⟨cuts, (hmem 0).mpr (Or.inr (Or.inl rfl)),
    (hmem 1).mpr (Or.inr (Or.inr rfl)), ?_, ?_⟩
  · intro x hx
    rcases (hmem x).mp hx with hx | rfl | rfl
    · exact hx.2
    · norm_num
    · norm_num
  · intro i x hx hi
    apply (hmem x).mpr
    left
    refine ⟨?_, ⟨hx.1.le, hx.2.le⟩⟩
    dsimp [P]
    rw [Polynomial.eval_prod]
    exact Finset.prod_eq_zero (Finset.mem_univ i) hi

/-- Exact lifting tests exist for every fixed rational gain. They are obtained
from all actual parameter roots and rational samples in every adjacent cell;
a zero polynomial is handled separately as an impossible strict inequality. -/
theorem exists_lifting_samples {n : ℕ}
    (tests : Fin n → ℚ → ℚ → ℚ) (gain : ℚ) (p : Fin n → ℝ[X])
    (hcast : ∀ q i, ((tests i q gain : ℚ) : ℝ) = (p i).eval (q : ℝ)) :
    ∃ samples : List ℚ,
      CADAlgorithm.markAtGain (List.ofFn tests) samples gain = true ↔
        ∃ γ ∈ Icc (0 : ℝ) 1, ∀ i, 0 < (p i).eval γ := by
  classical
  by_cases hz : ∃ i, p i = 0
  · obtain ⟨i, hi⟩ := hz
    refine ⟨[], ?_⟩
    have hinfeasible := CADAlgorithm.zero_polynomial_inequality_infeasible p hi
    constructor
    · intro h
      simp [CADAlgorithm.markAtGain] at h
    · intro h
      exact (hinfeasible h).elim
  · have hp : ∀ i, p i ≠ 0 := by simpa using hz
    obtain ⟨cuts, hzero, hone, hbound, hroots⟩ := exists_parameter_cuts p hp
    obtain ⟨samples, hsample⟩ := exists_cell_samples cuts
    exact ⟨(CADCells.cells cuts).toList.map samples,
      CADAlgorithm.polynomial_lifting_mark_correct tests gain p hcast cuts
        hzero hone hbound hroots samples hsample⟩

/-- Specialization to the actual rational bivariate input family. -/
theorem exists_bivariate_lifting_samples {n : ℕ}
    (f : Fin n → CADProjection.Bivariate) (gain : ℚ) :
    ∃ samples : List ℚ,
      CADAlgorithm.markAtGain (List.ofFn (fun i => rationalTest (f i))) samples gain = true ↔
        ∃ γ ∈ Icc (0 : ℝ) 1, ∀ i, 0 < CADProjection.value (f i) gain γ := by
  exact exists_lifting_samples (fun i => rationalTest (f i)) gain
    (fun i => CADProjection.specialize (f i) gain)
    (fun q i => rationalTest_cast (f i) q gain)

end C2.CADGlobal

end

/- ===== C2.CADGlobalAssembly ===== -/

/-! Mathematical assembly from a proved nonzero projection polynomial. Every
cut, rational sample, lifting test and endpoint conclusion is constructed from
the actual input polynomials. The final original-input theorem discharges the
projection premise using the algebraic factor/projection development. -/

noncomputable section
open Polynomial Set
namespace C2.CADGlobal

/-- The actual positive-gain projection of the strict polynomial system. -/
def positiveGains {n : ℕ} (f : Fin n → CADProjection.Bivariate) : Set ℝ :=
  {k | 0 < k ∧ ∃ γ ∈ Icc (0 : ℝ) 1, ∀ i, 0 < CADProjection.value (f i) k γ}

theorem positiveGains_isOpen {n : ℕ} (f : Fin n → CADProjection.Bivariate) :
    IsOpen (positiveGains f) := by
  exact isOpen_Ioi.inter
    (CADDelineability.patternGains_isOpen
      (fun i p => CADProjection.value (f i) p.1 p.2)
      (fun i => CADProjection.continuous_value (f i)))

def calculationOutput {n : ℕ} (f : Fin n → CADProjection.Bivariate)
    (d : ℚ[X]) (hd : d ≠ 0) (K : ℚ)
    (gainSamples : (ℝ × ℝ) → ℚ) (parameterSamples : (ℝ × ℝ) → List ℚ) : Option ℝ :=
  CADAlgorithm.testAndSelect (List.ofFn (fun i => rationalTest (f i)))
    (CADAlgorithm.adjacentSampledCells (CADGainCuts.cuts d hd K) gainSamples parameterSamples)

/-- Complete correctness of a finite mathematical calculation, with all
relations referring to the original real polynomial evaluations. -/
def CalculationCorrect {n : ℕ} (f : Fin n → CADProjection.Bivariate)
    (d : ℚ[X]) (hd : d ≠ 0) (K : ℚ)
    (gainSamples : (ℝ × ℝ) → ℚ) (parameterSamples : (ℝ × ℝ) → List ℚ) : Prop :=
  (∀ c ∈ CADCells.cells (CADGainCuts.cuts d hd K),
    (gainSamples c : ℝ) ∈ Ioo c.1 c.2) ∧
  (∀ c ∈ CADCells.cells (CADGainCuts.cuts d hd K),
    CADAlgorithm.markAtGain (List.ofFn (fun i => rationalTest (f i)))
      (parameterSamples c) (gainSamples c) = true ↔
        (gainSamples c : ℝ) ∈ positiveGains f) ∧
  (calculationOutput f d hd K gainSamples parameterSamples = none ↔ positiveGains f = ∅) ∧
  (∀ b, calculationOutput f d hd K gainSamples parameterSamples = some b →
    IsLUB (positiveGains f) b ∧ IsAlgebraic ℚ b ∧ 0 < b ∧ b < (K : ℝ))

/-- The finite calculation is constructed from the exact input evaluations,
provided a nonzero polynomial has already been proved to cut the gain axis
into feasibility-constant connected cells. No cells or test answers are inputs. -/
theorem exists_calculation_of_projection {n : ℕ}
    (f : Fin n → CADProjection.Bivariate) (d : ℚ[X]) (hd : d ≠ 0)
    (hprojection : ∀ I : Set ℝ, IsPreconnected I →
      (∀ k ∈ I, d.eval₂ (algebraMap ℚ ℝ) k ≠ 0) →
      ∀ {a b : ℝ}, a ∈ I → b ∈ I →
      ((∃ x ∈ Icc (0 : ℝ) 1, ∀ i, 0 < CADProjection.value (f i) a x) ↔
        ∃ x ∈ Icc (0 : ℝ) 1, ∀ i, 0 < CADProjection.value (f i) b x))
    (K : ℚ) (hK : 0 < K) (K₀ : ℝ)
    (hbound : ∀ k ∈ positiveGains f, k ≤ K₀) (hstrict : K₀ < (K : ℝ)) :
    ∃ gainSamples : (ℝ × ℝ) → ℚ, ∃ parameterSamples : (ℝ × ℝ) → List ℚ,
      CalculationCorrect f d hd K gainSamples parameterSamples := by
  classical
  let cuts := CADGainCuts.cuts d hd K
  have hzero : 0 ∈ cuts := CADGainCuts.zero_mem d hd K
  have hupper : (K : ℝ) ∈ cuts := CADGainCuts.upper_mem d hd K
  have hcuts : ∀ c ∈ cuts, c ∈ Icc (0 : ℝ) (K : ℝ) :=
    CADGainCuts.cuts_bounded d hd hK.le
  have hsupport : positiveGains f ⊆ Ioo 0 (K : ℝ) := by
    intro k hk
    exact ⟨hk.1, (hbound k hk).trans_lt hstrict⟩
  obtain ⟨gainSamples, hgain⟩ := exists_cell_samples cuts
  choose parameterSamples hparameter using
    (fun c : ℝ × ℝ => exists_bivariate_lifting_samples f (gainSamples c))
  have hgainpos : ∀ c ∈ CADCells.cells cuts, 0 < (gainSamples c : ℝ) := by
    intro c hc
    have hcell := (CADCells.mem_cells_iff cuts c.1 c.2).mp hc
    exact (hcuts c.1 hcell.1).1.trans_lt (hgain c hc).1
  have htest : ∀ c ∈ CADCells.cells cuts,
      CADAlgorithm.markAtGain (List.ofFn (fun i => rationalTest (f i)))
        (parameterSamples c) (gainSamples c) = true ↔
        (gainSamples c : ℝ) ∈ positiveGains f := by
    intro c hc
    simpa only [positiveGains, mem_setOf_eq, hgainpos c hc, true_and] using hparameter c
  have hconstant : ∀ c ∈ CADCells.cells cuts, ∀ k ∈ Ioo c.1 c.2,
      k ∈ positiveGains f ↔ (gainSamples c : ℝ) ∈ positiveGains f := by
    intro c hc k hk
    have hcell := (CADCells.mem_cells_iff cuts c.1 c.2).mp hc
    have hkp : 0 < k := (hcuts c.1 hcell.1).1.trans_lt hk.1
    have hnonzero : ∀ t ∈ Ioo c.1 c.2,
        d.eval₂ (algebraMap ℚ ℝ) t ≠ 0 := by
      intro t ht
      exact CADGainCuts.nonzero_on_cell d hd hK.le hcell ht
    have he := hprojection (Ioo c.1 c.2) isPreconnected_Ioo hnonzero hk (hgain c hc)
    simpa only [positiveGains, mem_setOf_eq, hkp, hgainpos c hc, true_and] using he
  have hempty := CADAlgorithm.tested_adjacent_empty_iff (positiveGains_isOpen f)
    hzero hupper hcuts hsupport gainSamples parameterSamples
    (List.ofFn (fun i => rationalTest (f i))) hconstant htest
  refine ⟨gainSamples, parameterSamples, hgain, htest, hempty, ?_⟩
  intro b hout
  have hlub : IsLUB (positiveGains f) b :=
    CADAlgorithm.tested_adjacent_supremum (positiveGains_isOpen f)
      hzero hupper hcuts hsupport gainSamples parameterSamples
      (List.ofFn (fun i => rationalTest (f i))) hconstant htest hout
  have halg : IsAlgebraic ℚ b :=
    CADAlgorithm.tested_adjacent_output_algebraic gainSamples parameterSamples
      (List.ofFn (fun i => rationalTest (f i))) (CADGainCuts.cuts_algebraic d hd K) hout
  have hne : (positiveGains f).Nonempty := by
    apply Set.nonempty_iff_ne_empty.mpr
    intro hz
    have hn := hempty.mpr hz
    change calculationOutput f d hd K gainSamples parameterSamples = none at hn
    rw [hout] at hn
    cases hn
  obtain ⟨k, hk⟩ := hne
  exact ⟨hlub, halg, hk.1.trans_le (hlub.1 hk),
    CADAlgorithm.supremum_strict_search_bound hlub hbound hstrict⟩

/-- No identically zero strict inequality can be feasible, at any gain. -/
theorem zero_input_positiveGains_empty {n : ℕ} (f : Fin n → CADProjection.Bivariate)
    {i : Fin n} (hi : f i = 0) : positiveGains f = ∅ := by
  apply Set.eq_empty_iff_forall_not_mem.mpr
  rintro k ⟨_, x, _, hpos⟩
  have h := hpos i
  simpa [hi, CADProjection.value, CADProjection.specialize] using h

end C2.CADGlobal

end

/- ===== C2.CADGlobalTheorem ===== -/

/-!
# The general exact-gain theorem: mathematical completion

For the original rational polynomial inequalities, this module constructs a
finite exact cell calculation and proves the empty-set and algebraic-supremum
conclusions. No factorization, projection, regularity, partition, sample, or
sign-test-correctness hypothesis is supplied by the caller.

The construction in this mathematical existence theorem uses finite root sets
and classical choice of rational witnesses. Native execution and the total
finite-data search/isolation pipeline are separately verified; this module does
not conflate a mathematical choice with an executable implementation.
-/

noncomputable section
open Polynomial Set
namespace C2.CADGlobal

/-- An identically zero input inequality is handled without any nonzero-input
assumption. Otherwise the fully proved generic algebraic projection applies. -/
theorem exists_total_feasibility_projection {n : ℕ}
    (f : Fin n → CADProjection.Bivariate) :
    ∃ d : ℚ[X], d ≠ 0 ∧
      ∀ I : Set ℝ, IsPreconnected I →
      (∀ k ∈ I, d.eval₂ (algebraMap ℚ ℝ) k ≠ 0) →
      ∀ {a b : ℝ}, a ∈ I → b ∈ I →
      ((∃ x ∈ Icc (0 : ℝ) 1, ∀ i, 0 < CADProjection.value (f i) a x) ↔
        ∃ x ∈ Icc (0 : ℝ) 1, ∀ i, 0 < CADProjection.value (f i) b x) := by
  classical
  by_cases hz : ∃ i, f i = 0
  · obtain ⟨i, hi⟩ := hz
    have hfalse : ∀ k : ℝ,
        ¬∃ x ∈ Icc (0 : ℝ) 1, ∀ j, 0 < CADProjection.value (f j) k x := by
      rintro k ⟨x, _, hpos⟩
      have h := hpos i
      simpa [hi, CADProjection.value, CADProjection.specialize] using h
    exact ⟨1, one_ne_zero, fun _ _ _ {a b} _ _ => iff_of_false (hfalse a) (hfalse b)⟩
  · exact CADProjection.exists_feasibility_projection f (by simpa using hz)

/-- **Finite exact global gain calculation.** From the rational input family
and its proved uniform bound alone, there is a finite actual-cell calculation:
no marked cell iff the positive-gain set is empty; otherwise the selected right
endpoint is its actual least upper bound, is real algebraic, is positive, and
lies at most K₀, strictly below the chosen rational search bound K. Every stable
component is included, whether or not it is connected to zero gain. -/
theorem finite_global_gain_calculation {n : ℕ}
    (f : Fin n → CADProjection.Bivariate)
    (K : ℚ) (hK : 0 < K) (K₀ : ℝ)
    (hbound : ∀ k ∈ positiveGains f, k ≤ K₀) (hstrict : K₀ < (K : ℝ)) :
    ∃ d : ℚ[X], ∃ hd : d ≠ 0,
      ∃ gainSamples : (ℝ × ℝ) → ℚ,
      ∃ parameterSamples : (ℝ × ℝ) → List ℚ,
      CalculationCorrect f d hd K gainSamples parameterSamples ∧
      ∀ b, calculationOutput f d hd K gainSamples parameterSamples = some b → b ≤ K₀ := by
  obtain ⟨d, hd, hprojection⟩ := exists_total_feasibility_projection f
  obtain ⟨gainSamples, parameterSamples, hc⟩ :=
    exists_calculation_of_projection f d hd hprojection K hK K₀ hbound hstrict
  exact ⟨d, hd, gainSamples, parameterSamples, hc,
    fun b hb => (hc.2.2.2 b hb).1.2 hbound⟩

/-- The nonempty original feasible gain set has an actual algebraic supremum
with the stronger coefficient-bound separation required in the manuscript. -/
theorem nonempty_gain_supremum_algebraic {n : ℕ}
    (f : Fin n → CADProjection.Bivariate)
    (K : ℚ) (hK : 0 < K) (K₀ : ℝ)
    (hbound : ∀ k ∈ positiveGains f, k ≤ K₀) (hstrict : K₀ < (K : ℝ))
    (hne : (positiveGains f).Nonempty) :
    ∃ b : ℝ, IsLUB (positiveGains f) b ∧ IsAlgebraic ℚ b ∧
      0 < b ∧ b ≤ K₀ ∧ b < (K : ℝ) ∧ sSup (positiveGains f) = b := by
  obtain ⟨d, hd, gainSamples, parameterSamples, hc, hboundout⟩ :=
    finite_global_gain_calculation f K hK K₀ hbound hstrict
  cases hout : calculationOutput f d hd K gainSamples parameterSamples with
  | none =>
      have he := hc.2.2.1.mp hout
      exact (hne.ne_empty he).elim
  | some b =>
      have hb := hc.2.2.2 b hout
      exact ⟨b, hb.1, hb.2.1, hb.2.2.1, hboundout b hout,
        hb.2.2.2, hb.1.csSup_eq hne⟩

/-- A zero strict input inequality is recognized as the empty case by every
correct calculation of the original system. -/
theorem zero_input_output_none {n : ℕ} (f : Fin n → CADProjection.Bivariate)
    {i : Fin n} (hi : f i = 0)
    (d : ℚ[X]) (hd : d ≠ 0) (K : ℚ)
    (gainSamples : (ℝ × ℝ) → ℚ) (parameterSamples : (ℝ × ℝ) → List ℚ)
    (hc : CalculationCorrect f d hd K gainSamples parameterSamples) :
    calculationOutput f d hd K gainSamples parameterSamples = none :=
  hc.2.2.1.mpr (zero_input_positiveGains_empty f hi)

end C2.CADGlobal

end

/- ===== C2.CADNativeOutput ===== -/

/-! Transfer the finite maximum computed on native ranks to its real
interpretation. Order preservation is needed only on ranks actually used by
this finite computation; no ordering oracle on arbitrary algebraic numbers is
part of the executable algorithm. -/

namespace C2.CADAlgorithm
open Set

theorem output_map_of_rights_monotone {α : Type*} [LinearOrder α]
    (cells : List (Cell α)) (value : α → ℝ)
    (hmono : ∀ c ∈ cells, ∀ d ∈ cells, c.right ≤ d.right →
      value c.right ≤ value d.right) :
    output (cells.map (Cell.mapEndpoints value)) = (output cells).map value := by
  cases hout : output cells with
  | none =>
    apply (output_none_iff _).mpr
    intro c hc
    obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc
    exact (output_none_iff cells).mp hout d hd
  | some r =>
    obtain ⟨⟨c, hc, hm, hcr⟩, hmax⟩ := output_some_spec hout
    apply output_some_iff.mpr
    constructor
    · exact ⟨c.mapEndpoints value, List.mem_map.mpr ⟨c, hc, rfl⟩, hm,
        congrArg value hcr⟩
    · intro d hd hdm
      obtain ⟨e, he, rfl⟩ := List.mem_map.mp hd
      change value e.right ≤ value r
      rw [← hcr]
      exact hmono e he c hc (hcr ▸ hmax e he hdm)

theorem native_output_none_iff_empty {α : Type*} [LinearOrder α]
    (cells : List (Cell α)) (value : α → ℝ) {S E : Set ℝ}
    (hS : IsOpen S) (hE : E.Finite)
    (hvalid : ValidCells (cells.map (Cell.mapEndpoints value)))
    (hcover : S \ E = representedGains (cells.map (Cell.mapEndpoints value))) :
    output cells = none ↔ S = ∅ := by
  have hnone : output (cells.map (Cell.mapEndpoints value)) = none ↔
      output cells = none := by
    simp only [output_none_iff, List.forall_mem_map, Cell.mapEndpoints]
  exact hnone.symm.trans
    (output_none_iff_empty_of_decomposition hS hE hvalid hcover)

theorem native_output_isLUB {α : Type*} [LinearOrder α]
    (cells : List (Cell α)) (value : α → ℝ) {S E : Set ℝ}
    (hS : IsOpen S) (hE : E.Finite)
    (hvalid : ValidCells (cells.map (Cell.mapEndpoints value)))
    (hcover : S \ E = representedGains (cells.map (Cell.mapEndpoints value)))
    (hmono : ∀ c ∈ cells, ∀ d ∈ cells, c.right ≤ d.right →
      value c.right ≤ value d.right) {r : α} (hout : output cells = some r) :
    IsLUB S (value r) := by
  apply output_isLUB_of_decomposition hS hE hvalid hcover
  rw [output_map_of_rights_monotone cells value hmono, hout]
  rfl

end C2.CADAlgorithm


/- ===== C2.CADNativeProgram ===== -/

/-! The complete native CAD entry point. Its runtime inputs are only dense
rational bivariate polynomials and a positive rational gain bound. Factor data,
projection data, root isolation, rational test points and the selected output
are all constructed internally by proved terminating procedures. -/
namespace C2.CADNative
open C2.CADEffective

structure Output where
  isolation : C2.CADDriver.Isolation
  rank : ℕ

/-- The internally generated exact rational projection polynomial. -/
def projection (F : List Bivariate.Poly)
    (hF : ∀ i : Fin F.length, Bivariate.inputFamily F i ≠ 0) : Dense.Poly :=
  Bivariate.totalProjection F (Bivariate.produceWitness F hF)

theorem projection_nonzero (F : List Bivariate.Poly)
    (hF : ∀ i : Fin F.length, Bivariate.inputFamily F i ≠ 0) :
    Dense.denote (projection F hF) ≠ 0 :=
  Bivariate.totalProjection_nonzero_of_valid F _
    (Bivariate.produceWitness_correct F hF).1 (Bivariate.produceWitness_correct F hF).2

/-- Every witness and sample is computed from the original polynomial system. -/
def runNonzero (F : List Bivariate.Poly)
    (hF : ∀ i : Fin F.length, Bivariate.inputFamily F i ≠ 0)
    (K : ℚ) (hK : 0 < K) : C2.CADDriver.Run :=
  C2.CADDriver.runWithProjection F (projection F hF) (projection_nonzero F hF) K hK.le

/-- The user-facing total CAD program. A zero original inequality is immediately
infeasible; otherwise full projection and lifting are executed internally. -/
def run (F : List Bivariate.Poly) (K : ℚ) (hK : 0 < K) : Option Output :=
  if hz : Bivariate.nonzeroInputs F = true then
    let R := runNonzero F ((Bivariate.nonzeroInputs_iff F).mp hz) K hK
    R.result.map (fun r => ⟨R.isolation, r⟩)
  else none

theorem run_of_nonzero (F : List Bivariate.Poly)
    (hF : ∀ i : Fin F.length, Bivariate.inputFamily F i ≠ 0)
    (K : ℚ) (hK : 0 < K) :
    run F K hK = (runNonzero F hF K hK).result.map
      (fun r => ⟨(runNonzero F hF K hK).isolation, r⟩) := by
  simp only [run, (Bivariate.nonzeroInputs_iff F).mpr hF, dite_true]

theorem run_of_zero (F : List Bivariate.Poly) (K : ℚ) (hK : 0 < K)
    (hz : Bivariate.nonzeroInputs F = false) : run F K hK = none := by
  simp only [run, hz, Bool.false_eq_true, dite_false]

/-- The fast zero-input branch is semantically infeasible at every real gain. -/
theorem zero_guard_infeasible (F : List Bivariate.Poly)
    (hz : Bivariate.nonzeroInputs F = false) (k : ℝ) :
    ¬∃ x ∈ Set.Icc (0 : ℝ) 1,
      ∀ i, 0 < C2.CADProjection.value (Bivariate.inputFamily F i) k x := by
  classical
  have hn : ¬∀ i : Fin F.length, Bivariate.inputFamily F i ≠ 0 := by
    intro hh
    have ht := (Bivariate.nonzeroInputs_iff F).mpr hh
    rw [hz] at ht
    cases ht
  push_neg at hn
  obtain ⟨i, hi⟩ := hn
  rintro ⟨x, hx, hpos⟩
  have hh := hpos i
  simp [hi, C2.CADProjection.value, C2.CADProjection.specialize] at hh

theorem run_some_iff (F : List Bivariate.Poly)
    (hF : ∀ i : Fin F.length, Bivariate.inputFamily F i ≠ 0)
    (K : ℚ) (hK : 0 < K) (o : Output) :
    run F K hK = some o ↔ ∃ r,
      (runNonzero F hF K hK).result = some r ∧
      (⟨(runNonzero F hF K hK).isolation, r⟩ : Output) = o := by
  rw [run_of_nonzero F hF K hK, Option.map_eq_some_iff]

theorem run_none_iff_of_nonzero (F : List Bivariate.Poly)
    (hF : ∀ i : Fin F.length, Bivariate.inputFamily F i ≠ 0)
    (K : ℚ) (hK : 0 < K) :
    run F K hK = none ↔ (runNonzero F hF K hK).result = none := by
  rw [run_of_nonzero F hF K hK, Option.map_eq_none_iff]

/-- Every successful output is a unique real algebraic root descriptor, with
its dense polynomial, rational isolating grid and selected natural rank. -/
theorem run_some_unique_root (F : List Bivariate.Poly) (K : ℚ) (hK : 0 < K)
    {o : Output} (hout : run F K hK = some o) :
    ∃! x : ℝ, Dense.rootAtRank o.isolation.polynomial 0 K o.isolation.mesh o.rank x := by
  by_cases hz : Bivariate.nonzeroInputs F = true
  · let hF := (Bivariate.nonzeroInputs_iff F).mp hz
    obtain ⟨r,hr,rfl⟩ := (run_some_iff F hF K hK o).mp hout
    exact C2.CADDriver.selected_rank_unique_root F (projection F hF)
      (projection_nonzero F hF) K hK hr
  · have hf : Bivariate.nonzeroInputs F = false := Bool.eq_false_iff.mpr hz
    rw [run_of_zero F K hK hf] at hout
    cases hout

/-- The returned root polynomial is nonzero, so its descriptor certifies an
algebraic number rather than a root of the identically zero polynomial. -/
theorem run_some_polynomial_nonzero (F : List Bivariate.Poly) (K : ℚ) (hK : 0 < K)
    {o : Output} (hout : run F K hK = some o) :
    Dense.denote o.isolation.polynomial ≠ 0 := by
  by_cases hz : Bivariate.nonzeroInputs F = true
  · let hF := (Bivariate.nonzeroInputs_iff F).mp hz
    obtain ⟨r,hr,rfl⟩ := (run_some_iff F hF K hK o).mp hout
    exact C2.CADDriver.isolate_polynomial_nonzero (projection F hF)
      (projection_nonzero F hF) 0 K hK.le
  · have hf : Bivariate.nonzeroInputs F = false := Bool.eq_false_iff.mpr hz
    rw [run_of_zero F K hK hf] at hout
    cases hout

end C2.CADNative


/- ===== C2.CADNativeTheorem ===== -/

/-! Correctness of the actual executable gain-projection calculation.
The real interpretation is used only in theorem statements and proofs; the
computed endpoints are finite natural ranks with certified rational isolation
data, and all cell marks are computed from rational samples. -/

noncomputable section
namespace C2.CADDriver
open Set
open C2.CADEffective C2.CADAlgorithm

/-- The positive gains admitted by the original native input inequalities. -/
def positiveGains (input : List Bivariate.Poly) : Set ℝ :=
  {k | 0 < k ∧ Bivariate.rawFeasible input k}

theorem positiveGains_eq (input : List Bivariate.Poly) :
    positiveGains input = CADGlobal.positiveGains (Bivariate.inputFamily input) := by
  ext k
  simp only [positiveGains, CADGlobal.positiveGains, mem_setOf_eq,
    Bivariate.rawFeasible_iff_inputFamily]

theorem positiveGains_isOpen (input : List Bivariate.Poly) :
    IsOpen (positiveGains input) := by
  rw [positiveGains_eq]
  exact CADGlobal.positiveGains_isOpen _

theorem positiveGains_empty_of_zero (input : List Bivariate.Poly)
    (hz : Bivariate.nonzeroInputs input = false) : positiveGains input = ∅ := by
  rw [positiveGains_eq]
  have hn : ¬ ∀ i, Bivariate.inputFamily input i ≠ 0 := by
    intro h
    have := (Bivariate.nonzeroInputs_iff input).mpr h
    simp [hz] at this
  push_neg at hn
  obtain ⟨i, hi⟩ := hn
  exact CADGlobal.zero_input_positiveGains_empty _ hi

/-- The marked cells actually constructed by the native driver, interpreted
using the real roots associated with its finite ranks. -/
def interpretedCells (input : List Bivariate.Poly) (data : Isolation)
    (K : ℚ) (value : ℕ → ℝ) : List (Cell ℝ) :=
  ((sampledGainCells input data K).map (fun c => c.test (rationalTests input))).map
    (Cell.mapEndpoints value)

theorem mem_interpretedCells (input : List Bivariate.Poly) (data : Isolation)
    (K : ℚ) (value : ℕ → ℝ) (c : Cell ℝ) :
    c ∈ interpretedCells input data K value ↔
      ∃ d ∈ consecutiveRanks data,
        c = ⟨value d.1, value d.2,
          Dense.betweenRanks 0 K data.mesh d.1 d.2,
          markGain input (Dense.betweenRanks 0 K data.mesh d.1 d.2)⟩ := by
  simp only [interpretedCells, sampledGainCells, List.map_map, List.mem_map]
  constructor
  · rintro ⟨d, hd, hc⟩
    exact ⟨d, hd, hc.symm⟩
  · rintro ⟨d, hd, hc⟩
    exact ⟨d, hd, hc.symm⟩

theorem mem_represented_interpretedCells (input : List Bivariate.Poly) (data : Isolation)
    (K : ℚ) (value : ℕ → ℝ) (k : ℝ) :
    k ∈ representedGains (interpretedCells input data K value) ↔
      ∃ d ∈ consecutiveRanks data,
        markGain input (Dense.betweenRanks 0 K data.mesh d.1 d.2) = true ∧
          value d.1 < k ∧ k < value d.2 := by
  constructor
  · rintro ⟨c, hc, hm, hk⟩
    obtain ⟨d, hd, rfl⟩ := (mem_interpretedCells input data K value c).mp hc
    exact ⟨d, hd, hm, hk⟩
  · rintro ⟨d, hd, hm, hk⟩
    refine ⟨_, (mem_interpretedCells input data K value _).mpr ⟨d, hd, rfl⟩, hm, hk⟩

theorem interpretedCells_valid (input : List Bivariate.Poly)
    (p : Dense.Poly) (hp : Dense.denote p ≠ 0) (K : ℚ) (hK : 0 < K) :
    ValidCells (interpretedCells input (isolate p hp 0 K hK.le) K
      (rootValue p hp 0 K hK)) := by
  intro c hc
  obtain ⟨d, hd, rfl⟩ := (mem_interpretedCells _ _ _ _ c).mp hc
  have hs := rootValue_gap_sample p hp 0 K hK hd
  exact hs.1.trans hs.2

theorem tested_cell_right_mem (input : List Bivariate.Poly) (data : Isolation)
    (K : ℚ) {c : Cell ℕ}
    (hc : c ∈ (sampledGainCells input data K).map (fun c => c.test (rationalTests input))) :
    c.right ∈ data.ranks := by
  obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hc
  obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hs
  exact List.mem_of_mem_tail (List.of_mem_zip hd).2

theorem tested_cell_rights_monotone (input : List Bivariate.Poly)
    (p : Dense.Poly) (hp : Dense.denote p ≠ 0) (K : ℚ) (hK : 0 < K) :
    ∀ c ∈ (sampledGainCells input (isolate p hp 0 K hK.le) K).map
        (fun c => c.test (rationalTests input)),
      ∀ d ∈ (sampledGainCells input (isolate p hp 0 K hK.le) K).map
        (fun c => c.test (rationalTests input)), c.right ≤ d.right →
      rootValue p hp 0 K hK c.right ≤ rootValue p hp 0 K hK d.right := by
  intro c hc d hd hcd
  rcases lt_or_eq_of_le hcd with hlt | heq
  · exact (rootValue_strictMono p hp 0 K hK
      (tested_cell_right_mem input _ K hc) (tested_cell_right_mem input _ K hd) hlt).le
  · rw [heq]

theorem interpretedCells_decomposition (input : List Bivariate.Poly)
    (p : Dense.Poly) (hp : Dense.denote p ≠ 0) (K : ℚ) (hK : 0 < K)
    (hsupport : positiveGains input ⊆ Ioo (0:ℝ) (K:ℝ))
    (hmark : ∀ q : ℚ, markGain input q = true ↔ Bivariate.rawFeasible input (q:ℝ))
    (hconstant : ∀ I : Set ℝ, IsPreconnected I →
      (∀ k ∈ I, CADIsolation.realEval (Dense.denote p) k ≠ 0) →
      ∀ {a b : ℝ}, a ∈ I → b ∈ I →
        (Bivariate.rawFeasible input a ↔ Bivariate.rawFeasible input b)) :
    positiveGains input \ {k | CADIsolation.realEval (Dense.denote p) k = 0} =
      representedGains (interpretedCells input (isolate p hp 0 K hK.le) K
        (rootValue p hp 0 K hK)) := by
  ext k
  rw [mem_represented_interpretedCells]
  constructor
  · rintro ⟨hk, hn⟩
    obtain ⟨r, s, hpair, hgap⟩ := rootValue_gap_cover p hp 0 K hK
      (by simpa using hsupport hk) hn
    refine ⟨(r,s), hpair, ?_, hgap⟩
    apply (hmark _).mpr
    exact (hconstant _ isPreconnected_Ioo
      (rootValue_gap_no_root p hp 0 K hK hpair) hgap
      (rootValue_gap_sample p hp 0 K hK hpair)).mp hk.2
  · rintro ⟨d, hd, hm, hk⟩
    obtain ⟨hl, _, _, _⟩ := Dense.rankPairs_properties
      (isolate_ranks_sorted p hp 0 K hK.le) hd
    have hleft := (rootValue_mem_Icc p hp 0 K hK hl).1
    have hfree := rootValue_gap_no_root p hp 0 K hK hd
    refine ⟨⟨?_, ?_⟩, hfree k hk⟩
    · exact (by simpa using hleft : 0 ≤ rootValue p hp 0 K hK d.1).trans_lt hk.1
    · exact (hconstant _ isPreconnected_Ioo hfree hk
        (rootValue_gap_sample p hp 0 K hK hd)).mpr ((hmark _).mp hm)


section ProjectedRun
variable (input : List Bivariate.Poly) (p : Dense.Poly) (hp : Dense.denote p ≠ 0)
  (K : ℚ) (hK : 0 < K)
  (hsupport : positiveGains input ⊆ Ioo (0:ℝ) (K:ℝ))
  (hmark : ∀ q : ℚ, markGain input q = true ↔ Bivariate.rawFeasible input (q:ℝ))
  (hconstant : ∀ I : Set ℝ, IsPreconnected I →
    (∀ k ∈ I, CADIsolation.realEval (Dense.denote p) k ≠ 0) →
    ∀ {a b : ℝ}, a ∈ I → b ∈ I →
      (Bivariate.rawFeasible input a ↔ Bivariate.rawFeasible input b))

include hsupport hmark hconstant

theorem projected_run_none_iff :
    (runWithProjection input p hp K hK.le).result = none ↔ positiveGains input = ∅ := by
  apply native_output_none_iff_empty
    ((sampledGainCells input (isolate p hp 0 K hK.le) K).map
      (fun c => c.test (rationalTests input)))
    (rootValue p hp 0 K hK) (positiveGains_isOpen input)
  · exact CADProjection.rational_zero_set_finite (Dense.denote p) hp
  · exact interpretedCells_valid input p hp K hK
  · exact interpretedCells_decomposition input p hp K hK hsupport hmark hconstant

theorem projected_run_some_isLUB {r : ℕ}
    (hout : (runWithProjection input p hp K hK.le).result = some r) :
    IsLUB (positiveGains input) (rootValue p hp 0 K hK r) := by
  apply native_output_isLUB
    ((sampledGainCells input (isolate p hp 0 K hK.le) K).map
      (fun c => c.test (rationalTests input)))
    (rootValue p hp 0 K hK) (positiveGains_isOpen input)
  · exact CADProjection.rational_zero_set_finite (Dense.denote p) hp
  · exact interpretedCells_valid input p hp K hK
  · exact interpretedCells_decomposition input p hp K hK hsupport hmark hconstant
  · exact tested_cell_rights_monotone input p hp K hK
  · exact hout

end ProjectedRun

end C2.CADDriver

namespace C2.CADNative
open Set C2.CADEffective

/-- The complete native program returns `none` exactly for an empty feasible
positive-gain set. Its only data arguments are the original rational polynomial
list and the rational search bound. -/
theorem run_none_iff_empty (input : List Bivariate.Poly) (K : ℚ) (hK : 0 < K)
    (K₀ : ℝ) (hbound : ∀ k ∈ CADDriver.positiveGains input, k ≤ K₀)
    (hstrict : K₀ < (K:ℝ)) :
    run input K hK = none ↔ CADDriver.positiveGains input = ∅ := by
  by_cases hz : Bivariate.nonzeroInputs input = true
  · let hF := (Bivariate.nonzeroInputs_iff input).mp hz
    rw [run_none_iff_of_nonzero input hF K hK]
    apply CADDriver.projected_run_none_iff input (projection input hF)
      (projection_nonzero input hF) K hK
    · intro k hk
      exact ⟨hk.1, (hbound k hk).trans_lt hstrict⟩
    · exact CADDriver.markGain_rawFeasible input
    · intro I hI hcut a b ha hb
      exact Bivariate.producedProjection_feasibility_constant input hF I hI hcut ha hb
  · have hf := Bool.eq_false_iff.mpr hz
    rw [run_of_zero input K hK hf, CADDriver.positiveGains_empty_of_zero input hf]
    simp

/-- A returned native root descriptor denotes exactly one real number. That
number is the least upper bound of every feasible positive gain, is algebraic,
and lies strictly inside the rational search bound. All projection, lifting,
isolation, sample and marking obligations are discharged internally. -/
theorem run_some_correct (input : List Bivariate.Poly) (K : ℚ) (hK : 0 < K)
    (K₀ : ℝ) (hbound : ∀ k ∈ CADDriver.positiveGains input, k ≤ K₀)
    (hstrict : K₀ < (K:ℝ)) {o : Output} (hout : run input K hK = some o) :
    ∃ b : ℝ,
      (∀ x : ℝ, Dense.rootAtRank o.isolation.polynomial 0 K o.isolation.mesh o.rank x ↔ x = b) ∧
      IsLUB (CADDriver.positiveGains input) b ∧ IsAlgebraic ℚ b ∧
      0 < b ∧ b ≤ K₀ ∧ b < (K:ℝ) := by
  have hne : (CADDriver.positiveGains input).Nonempty := by
    apply Set.nonempty_iff_ne_empty.mpr
    intro he
    have hn := (run_none_iff_empty input K hK K₀ hbound hstrict).mpr he
    rw [hout] at hn
    cases hn
  by_cases hz : Bivariate.nonzeroInputs input = true
  · let hF := (Bivariate.nonzeroInputs_iff input).mp hz
    obtain ⟨r, hr, rfl⟩ := (run_some_iff input hF K hK o).mp hout
    let p := projection input hF
    let hp := projection_nonzero input hF
    let b := CADDriver.rootValue p hp 0 K hK r
    have hmem := CADDriver.selected_rank_mem input p hp K hK.le hr
    have hb : Dense.rootAtRank (runNonzero input hF K hK).isolation.polynomial
        0 K (runNonzero input hF K hK).isolation.mesh r b :=
      CADDriver.rootValue_spec p hp 0 K hK hmem
    have hu := CADDriver.selected_rank_unique_root input p hp K hK hr
    have hlub : IsLUB (CADDriver.positiveGains input) b := by
      apply CADDriver.projected_run_some_isLUB input p hp K hK
      · intro k hk
        exact ⟨hk.1, (hbound k hk).trans_lt hstrict⟩
      · exact CADDriver.markGain_rawFeasible input
      · intro I hI hcut a c ha hc
        exact Bivariate.producedProjection_feasibility_constant input hF I hI hcut ha hc
      · exact hr
    obtain ⟨k, hk⟩ := hne
    have hbK : b ≤ K₀ := hlub.2 hbound
    refine ⟨b, ?_, hlub, CADDriver.rootValue_algebraic p hp 0 K hK hmem,
      hk.1.trans_le (hlub.1 hk), hbK, hbK.trans_lt hstrict⟩
    intro x
    constructor
    · intro hx
      exact hu.unique hx hb
    · intro hx
      simpa only [hx] using hb
  · have hf := Bool.eq_false_iff.mpr hz
    rw [run_of_zero input K hK hf] at hout
    cases hout

/-- End-to-end correctness of the total native CAD program. In particular the
finite maximum is the output actually computed from the input, rather than a
separately chosen mathematically valid cell calculation. -/
theorem native_gain_projection_correct (input : List Bivariate.Poly)
    (K : ℚ) (hK : 0 < K) (K₀ : ℝ)
    (hbound : ∀ k ∈ CADDriver.positiveGains input, k ≤ K₀)
    (hstrict : K₀ < (K:ℝ)) :
    (run input K hK = none ↔ CADDriver.positiveGains input = ∅) ∧
    ∀ o, run input K hK = some o →
      ∃ b : ℝ,
        (∀ x : ℝ, Dense.rootAtRank o.isolation.polynomial 0 K o.isolation.mesh o.rank x ↔ x = b) ∧
        IsLUB (CADDriver.positiveGains input) b ∧ IsAlgebraic ℚ b ∧
        0 < b ∧ b ≤ K₀ ∧ b < (K:ℝ) :=
  ⟨run_none_iff_empty input K hK K₀ hbound hstrict,
    fun _ ho => run_some_correct input K hK K₀ hbound hstrict ho⟩

/-- On a nonempty system the actual computed descriptor represents `sSup` of
all feasible positive gains, including components separated from zero. -/
theorem run_nonempty_supremum (input : List Bivariate.Poly)
    (K : ℚ) (hK : 0 < K) (K₀ : ℝ)
    (hbound : ∀ k ∈ CADDriver.positiveGains input, k ≤ K₀)
    (hstrict : K₀ < (K:ℝ)) (hne : (CADDriver.positiveGains input).Nonempty) :
    ∃ o : Output, run input K hK = some o ∧
      Dense.rootAtRank o.isolation.polynomial 0 K o.isolation.mesh o.rank
        (sSup (CADDriver.positiveGains input)) ∧
      IsAlgebraic ℚ (sSup (CADDriver.positiveGains input)) ∧
      0 < sSup (CADDriver.positiveGains input) ∧
      sSup (CADDriver.positiveGains input) ≤ K₀ ∧
      sSup (CADDriver.positiveGains input) < (K:ℝ) := by
  cases hout : run input K hK with
  | none =>
    exact (hne.ne_empty ((run_none_iff_empty input K hK K₀ hbound hstrict).mp hout)).elim
  | some o =>
    obtain ⟨b, hroot, hlub, halg, hpos, hle, hlt⟩ :=
      run_some_correct input K hK K₀ hbound hstrict hout
    have heq := hlub.csSup_eq hne
    exact ⟨o, rfl, (hroot _).mpr heq, heq.symm ▸ halg,
      heq.symm ▸ hpos, heq.symm ▸ hle, heq.symm ▸ hlt⟩

end C2.CADNative

end

/- ===== C2.RationalTransform ===== -/

/-! Basic exact algebra of the common-parameter rational-delay family.
The hypotheses on transformed polynomial degrees remain explicit. This file
proves fixed degree, fixed leading coefficient and the denominator-cleared
feedback equation. It does not claim a full root-count or coprimeness theorem. -/
noncomputable section
namespace C2
open Polynomial

/-- Characteristic polynomial of the rational digital loop with integer delay. -/
def delayedCharacteristic (D N : ℝ[X]) (m : ℕ) (k : ℝ) : ℝ[X] :=
  X^m * D + C k * N

/-- Pure delay keeps the leading degree independent of the feedback gain. -/
theorem delayedCharacteristic_natDegree {D N : ℝ[X]} {m : ℕ} (k : ℝ)
    (hD : D ≠ 0) (hm : 0 < m) (hN : N.natDegree ≤ D.natDegree) :
    (delayedCharacteristic D N m k).natDegree = D.natDegree + m := by
  have hlow : (C k * N).natDegree < (X^m * D).natDegree := by
    rw [natDegree_X_pow_mul m hD]
    exact lt_of_le_of_lt (natDegree_C_mul_le k N) (by omega)
  unfold delayedCharacteristic
  rw [natDegree_add_eq_left_of_natDegree_lt hlow, natDegree_X_pow_mul m hD]

/-- The leading coefficient also does not depend on gain. -/
theorem delayedCharacteristic_leadingCoeff {D N : ℝ[X]} {m : ℕ} (k : ℝ)
    (hD : D ≠ 0) (hm : 0 < m) (hN : N.natDegree ≤ D.natDegree) :
    (delayedCharacteristic D N m k).leadingCoeff = D.leadingCoeff := by
  have hlow : (C k * N).natDegree < (X^m * D).natDegree := by
    rw [natDegree_X_pow_mul m hD]
    exact lt_of_le_of_lt (natDegree_C_mul_le k N) (by omega)
  unfold delayedCharacteristic
  rw [leadingCoeff_add_of_degree_lt' (degree_lt_degree hlow)]
  simp

/-- Common-degree clearing leaves the rational quotient unchanged. -/
theorem common_degree_quotient {𝕜 : Type*} [Field 𝕜] (x a b : 𝕜) (d : ℕ) (hx : x ≠ 0) :
    (x^d*b)/(x^d*a) = b/a := by
  exact mul_div_mul_left b a (pow_ne_zero d hx)

/-- The scalar negative-feedback equation clears to the stated characteristic
expression when the open-loop rational value is defined. -/
theorem delayed_feedback_equation {𝕜 : Type*} [Field 𝕜] (z D N k : 𝕜) (m : ℕ)
    (hz : z ≠ 0) (hD : D ≠ 0) :
    (1 + k * N / (z^m * D) = 0) ↔ z^m * D + k*N = 0 := by
  have hd : z^m * D ≠ 0 := mul_ne_zero (pow_ne_zero m hz) hD
  constructor <;> intro h
  · field_simp [hd] at h
    exact h
  · field_simp [hd]
    exact h

/-- The old integrator characteristic expression is recovered identically. -/
theorem integrator_characteristic_recovery (z T γ k : ℝ) (m : ℕ) :
    z^m*(z-1) + k*(T*(γ*z+1-γ)) =
      z^m*(z-1) + (k*T)*(γ*z+1-γ) := by ring



end C2

end

/- ===== C2.CommonDegree ===== -/

/-! Common declared degree, exact rational evaluation and absence of common roots. -/
noncomputable section
namespace C2
open Polynomial Finset

/-- Homogeneous coefficient substitution, with the same declared degree for both
members of a rational function. `U` clears the denominator and `V/U` replaces s. -/
def commonDegreeTransform {K : Type*} [CommRing K]
    (p : K[X]) (d : ℕ) (U V : K[X]) : K[X] :=
  ∑ j ∈ Finset.range (d+1), C (p.coeff j) * V^j * U^(d-j)

theorem commonDegreeTransform_eval {K : Type*} [CommRing K]
    (p : K[X]) (d : ℕ) (U V : K[X]) (z : K) :
    (commonDegreeTransform p d U V).eval z =
      ∑ j ∈ Finset.range (d+1), p.coeff j * (V.eval z)^j * (U.eval z)^(d-j) := by
  simp [commonDegreeTransform, eval_finset_sum]

/-- The polynomial substitution agrees with the denominator-cleared rational
substitution whenever the clearing factor is nonzero. -/
theorem commonDegreeTransform_eval_div {K : Type*} [Field K]
    (p : K[X]) (d : ℕ) (U V : K[X]) (z : K)
    (hp : p.natDegree ≤ d) (hU : U.eval z ≠ 0) :
    (commonDegreeTransform p d U V).eval z =
      (U.eval z)^d * p.eval (V.eval z / U.eval z) := by
  rw [commonDegreeTransform_eval, eval_eq_sum_range' (Nat.lt_succ_of_le hp),
    Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j hj
  have hjd : j ≤ d := by simpa only [Finset.mem_range, Nat.lt_succ_iff] using hj
  have hpow : (U.eval z)^d = (U.eval z)^(d-j) * (U.eval z)^j := by
    rw [← pow_add, Nat.sub_add_cancel hjd]
  rw [div_pow, hpow]
  field_simp
  ring

/-- At a zero of the clearing factor only the leading homogeneous term remains. -/
theorem commonDegreeTransform_eval_zero {K : Type*} [Field K]
    (p : K[X]) (d : ℕ) (U V : K[X]) (z : K) (hU : U.eval z = 0) :
    (commonDegreeTransform p d U V).eval z = p.coeff d * (V.eval z)^d := by
  rw [commonDegreeTransform_eval]
  trans p.coeff d * (V.eval z)^d * (U.eval z)^(d-d)
  · apply Finset.sum_eq_single_of_mem d (by simp)
    intro j hj hne
    have hjd : j < d := by
      have : j < d+1 := Finset.mem_range.mp hj
      omega
    have hpos : 0 < d-j := Nat.sub_pos_of_lt hjd
    simp [hU, zero_pow (ne_of_gt hpos)]
  · simp

/-- A linear homogeneous substitution cannot increase the declared degree. -/
theorem commonDegreeTransform_natDegree_le {K : Type*} [Field K]
    (p : K[X]) (d : ℕ) (U V : K[X])
    (hU : U.natDegree ≤ 1) (hV : V.natDegree ≤ 1) :
    (commonDegreeTransform p d U V).natDegree ≤ d := by
  unfold commonDegreeTransform
  apply natDegree_sum_le_of_forall_le
  intro j hj
  have hjd : j ≤ d := by simpa only [Finset.mem_range, Nat.lt_succ_iff] using hj
  have hVj : (V^j).natDegree ≤ j := by
    simpa using natDegree_pow_le_of_le j hV
  have hUj : (U^(d-j)).natDegree ≤ d-j := by
    simpa using natDegree_pow_le_of_le (d-j) hU
  have hc : (C (p.coeff j) * V^j).natDegree ≤ j :=
    le_trans (natDegree_C_mul_le _ _) hVj
  have hm := natDegree_mul_le_of_le hc hUj
  simpa [Nat.add_sub_of_le hjd] using hm

/-- Coprime input polynomials remain without a common evaluation zero, including
points where the rational substitution itself would have a zero denominator. -/
theorem commonDegreeTransform_no_common_zero {K : Type*} [Field K]
    (A B U V : K[X]) (d : ℕ) (hA : A.natDegree ≤ d) (hB : B.natDegree ≤ d)
    (hAd : A.coeff d ≠ 0) (hAB : IsCoprime A B)
    (hUV : ∀ z : K, U.eval z ≠ 0 ∨ V.eval z ≠ 0) (z : K) :
    (commonDegreeTransform A d U V).eval z ≠ 0 ∨
      (commonDegreeTransform B d U V).eval z ≠ 0 := by
  by_cases hU : U.eval z = 0
  · left
    rw [commonDegreeTransform_eval_zero A d U V z hU]
    have hV : V.eval z ≠ 0 := (hUV z).resolve_left (not_not_intro hU)
    exact mul_ne_zero hAd (pow_ne_zero d hV)
  · have hd : (U.eval z)^d ≠ 0 := pow_ne_zero d hU
    rcases hAB with ⟨f, g, hfg⟩
    by_contra! hz
    have hAz : A.eval (V.eval z / U.eval z) = 0 := by
      rw [commonDegreeTransform_eval_div A d U V z hA hU] at hz
      exact (mul_eq_zero.mp hz.1).resolve_left hd
    have hBz : B.eval (V.eval z / U.eval z) = 0 := by
      have h := hz.2
      rw [commonDegreeTransform_eval_div B d U V z hB hU] at h
      exact (mul_eq_zero.mp h).resolve_left hd
    have h := congrArg (fun p : K[X] => p.eval (V.eval z / U.eval z)) hfg
    simp [hAz, hBz] at h

/-- Linear clearing polynomial for the common theta parameter. -/
def thetaScale {K : Type*} [CommRing K] (T γ : K) : K[X] :=
  C T * (C γ * X + C (1-γ))

def thetaNumerator {K : Type*} [CommRing K] : K[X] := X - 1

theorem theta_no_common_zero {K : Type*} [Field K] (T γ : K) (hT : T ≠ 0)
    (z : K) : (thetaScale T γ).eval z ≠ 0 ∨ (thetaNumerator : K[X]).eval z ≠ 0 := by
  by_cases hz : z = 1
  · left
    subst z
    simpa [thetaScale] using hT
  · right
    simpa [thetaNumerator] using sub_ne_zero.mpr hz

@[simp] theorem commonDegreeTransform_integrator_den {K : Type*} [CommRing K]
    (U V : K[X]) : commonDegreeTransform X 1 U V = V := by
  simp [commonDegreeTransform, Finset.sum_range_succ, coeff_one]

@[simp] theorem commonDegreeTransform_integrator_num {K : Type*} [CommRing K]
    (U V : K[X]) : commonDegreeTransform 1 1 U V = U := by
  simp [commonDegreeTransform, Finset.sum_range_succ, coeff_one]

private theorem linear_pow_coeff {K : Type*} [Field K]
    (p : K[X]) (hp : p.natDegree ≤ 1) (n : ℕ) :
    (p^n).coeff n = (p.coeff 1)^n := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hn : (p^n).natDegree ≤ n := by
      simpa using natDegree_pow_le_of_le n hp
    rw [pow_succ, coeff_mul_add_eq_of_natDegree_le hn hp, ih, pow_succ]

/-- Exact coefficient at the common declared degree. It also records all
possible degree degeneracies caused by the parameter. -/
theorem commonDegreeTransform_top_coeff {K : Type*} [Field K]
    (p : K[X]) (d : ℕ) (U V : K[X])
    (hU : U.natDegree ≤ 1) (hV : V.natDegree ≤ 1) :
    (commonDegreeTransform p d U V).coeff d =
      ∑ j ∈ Finset.range (d+1), p.coeff j * (V.coeff 1)^j * (U.coeff 1)^(d-j) := by
  unfold commonDegreeTransform
  rw [finset_sum_coeff]
  apply Finset.sum_congr rfl
  intro j hj
  have hjd : j ≤ d := by simpa only [Finset.mem_range, Nat.lt_succ_iff] using hj
  have hVj : (V^j).natDegree ≤ j := by
    simpa using natDegree_pow_le_of_le j hV
  have hUj : (U^(d-j)).natDegree ≤ d-j := by
    simpa using natDegree_pow_le_of_le (d-j) hU
  have hprod : (V^j * U^(d-j)).coeff d =
      (V^j).coeff j * (U^(d-j)).coeff (d-j) := by
    simpa [Nat.add_sub_of_le hjd] using coeff_mul_add_eq_of_natDegree_le hVj hUj
  rw [mul_assoc, coeff_C_mul, hprod,
    linear_pow_coeff V hV j, linear_pow_coeff U hU (d-j)]
  ring

/-- Exact transformed degree, with the sole exceptional leading-coefficient
condition stated explicitly. -/
theorem commonDegreeTransform_natDegree {K : Type*} [Field K]
    (p : K[X]) (d : ℕ) (U V : K[X])
    (hU : U.natDegree ≤ 1) (hV : V.natDegree ≤ 1)
    (htop : (∑ j ∈ Finset.range (d+1),
      p.coeff j * (V.coeff 1)^j * (U.coeff 1)^(d-j)) ≠ 0) :
    (commonDegreeTransform p d U V).natDegree = d := by
  apply natDegree_eq_of_le_of_coeff_ne_zero
    (commonDegreeTransform_natDegree_le p d U V hU hV)
  rwa [commonDegreeTransform_top_coeff p d U V hU hV]

/-- The transformed rational quotient exactly equals the original quotient
evaluated at V/U wherever U is nonzero. -/
theorem commonDegreeTransform_quotient {K : Type*} [Field K]
    (A B U V : K[X]) (d : ℕ) (hA : A.natDegree ≤ d) (hB : B.natDegree ≤ d)
    (z : K) (hU : U.eval z ≠ 0) :
    (commonDegreeTransform B d U V).eval z /
        (commonDegreeTransform A d U V).eval z =
      B.eval (V.eval z / U.eval z) / A.eval (V.eval z / U.eval z) := by
  rw [commonDegreeTransform_eval_div B d U V z hB hU,
    commonDegreeTransform_eval_div A d U V z hA hU]
  exact common_degree_quotient _ _ _ _ hU

theorem thetaScale_natDegree_le {K : Type*} [Field K] (T γ : K) :
    (thetaScale T γ).natDegree ≤ 1 := by
  unfold thetaScale
  apply le_trans (natDegree_C_mul_le _ _)
  apply le_trans (natDegree_add_le _ _)
  apply max_le
  · exact le_trans (natDegree_C_mul_le _ _) (by simp)
  · simp

theorem thetaNumerator_natDegree_le {K : Type*} [Field K] :
    (thetaNumerator : K[X]).natDegree ≤ 1 := by
  unfold thetaNumerator
  apply le_trans (natDegree_sub_le _ _)
  simp

/-- The concrete common-theta transformation preserves absence of common roots. -/
theorem thetaTransform_no_common_zero {K : Type*} [Field K]
    (A B : K[X]) (d : ℕ) (T γ : K) (hT : T ≠ 0)
    (hA : A.natDegree ≤ d) (hB : B.natDegree ≤ d)
    (hAd : A.coeff d ≠ 0) (hAB : IsCoprime A B) (z : K) :
    (commonDegreeTransform A d (thetaScale T γ) thetaNumerator).eval z ≠ 0 ∨
    (commonDegreeTransform B d (thetaScale T γ) thetaNumerator).eval z ≠ 0 :=
  commonDegreeTransform_no_common_zero A B _ _ d hA hB hAd hAB
    (theta_no_common_zero T γ hT) z

/-- For any nondegenerate common-degree substitution, adding a positive integer
sample delay gives a degree d+m characteristic polynomial for every gain. -/
theorem transformedDelayedCharacteristic_natDegree
    (A B U V : ℝ[X]) (d m : ℕ) (k : ℝ)
    (hU : U.natDegree ≤ 1) (hV : V.natDegree ≤ 1) (hm : 0 < m)
    (htop : (∑ j ∈ Finset.range (d+1),
      A.coeff j * (V.coeff 1)^j * (U.coeff 1)^(d-j)) ≠ 0) :
    (delayedCharacteristic (commonDegreeTransform A d U V)
      (commonDegreeTransform B d U V) m k).natDegree = d+m := by
  have hd := commonDegreeTransform_natDegree A d U V hU hV htop
  have hD : commonDegreeTransform A d U V ≠ 0 := by
    intro hz
    have hc := commonDegreeTransform_top_coeff A d U V hU hV
    rw [hz, coeff_zero] at hc
    exact htop hc.symm
  have hN : (commonDegreeTransform B d U V).natDegree ≤
      (commonDegreeTransform A d U V).natDegree := by
    rw [hd]
    exact commonDegreeTransform_natDegree_le B d U V hU hV
  rw [delayedCharacteristic_natDegree k hD hm hN, hd]



theorem commonDegreeTransform_map {K L : Type*} [Field K] [Field L]
    (f : K →+* L) (p : K[X]) (d : ℕ) (U V : K[X]) :
    (commonDegreeTransform p d U V).map f =
      commonDegreeTransform (p.map f) d (U.map f) (V.map f) := by
  simp [commonDegreeTransform, Polynomial.map_sum]

theorem thetaTransform_coprime (A B : ℝ[X]) (d : ℕ) (T γ : ℝ) (hT : T ≠ 0)
    (hA : A.natDegree ≤ d) (hB : B.natDegree ≤ d)
    (hAd : A.coeff d ≠ 0) (hAB : IsCoprime A B) :
    IsCoprime (commonDegreeTransform A d (thetaScale T γ) thetaNumerator)
      (commonDegreeTransform B d (thetaScale T γ) thetaNumerator) := by
  apply (Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed ℝ ℂ _ _).mpr
  intro z
  let f : ℝ →+* ℂ := algebraMap ℝ ℂ
  have hTm : f T ≠ 0 := by simpa [f] using hT
  have hAm : (A.map f).natDegree ≤ d := by simpa using hA
  have hBm : (B.map f).natDegree ≤ d := by simpa using hB
  have hAdm : (A.map f).coeff d ≠ 0 := by simpa [f] using hAd
  have hABm : IsCoprime (A.map f) (B.map f) := hAB.map (Polynomial.mapRingHom f)
  have h := thetaTransform_no_common_zero (A.map f) (B.map f) d (f T) (f γ)
    hTm hAm hBm hAdm hABm z
  simpa only [← eval_map_algebraMap, commonDegreeTransform_map,
    thetaScale, thetaNumerator, Polynomial.map_mul, Polynomial.map_add,
    Polynomial.map_sub, Polynomial.map_C, Polynomial.map_X, Polynomial.map_one,
    map_sub, map_one] using h

/-- A sample delay can introduce only zero as a common numerator/denominator
root; it cannot create a hidden root outside the unit disk. -/
theorem delayed_common_zero_is_zero {K : Type*} [Field K]
    (D N : K[X]) (m : ℕ)
    (hDN : ∀ z : K, D.eval z ≠ 0 ∨ N.eval z ≠ 0) (z : K)
    (hD : (X^m*D).eval z = 0) (hN : N.eval z = 0) : z = 0 := by
  by_contra hz
  have hDz : D.eval z = 0 := by
    simp only [eval_mul, eval_pow, eval_X] at hD
    exact (mul_eq_zero.mp hD).resolve_left (pow_ne_zero m hz)
  rcases hDN z with h | h
  · exact h hDz
  · exact h hN

/-- The delayed characteristic's leading coefficient is exactly the common-
degree top-coefficient expression, independent of the feedback gain. -/
theorem transformedDelayedCharacteristic_leadingCoeff
    (A B U V : ℝ[X]) (d m : ℕ) (k : ℝ)
    (hU : U.natDegree ≤ 1) (hV : V.natDegree ≤ 1) (hm : 0 < m)
    (htop : (∑ j ∈ Finset.range (d+1),
      A.coeff j * (V.coeff 1)^j * (U.coeff 1)^(d-j)) ≠ 0) :
    (delayedCharacteristic (commonDegreeTransform A d U V)
      (commonDegreeTransform B d U V) m k).leadingCoeff =
      ∑ j ∈ Finset.range (d+1),
        A.coeff j * (V.coeff 1)^j * (U.coeff 1)^(d-j) := by
  have hd := commonDegreeTransform_natDegree A d U V hU hV htop
  have hD : commonDegreeTransform A d U V ≠ 0 := by
    intro hz
    have hc := commonDegreeTransform_top_coeff A d U V hU hV
    rw [hz, coeff_zero] at hc
    exact htop hc.symm
  have hN : (commonDegreeTransform B d U V).natDegree ≤
      (commonDegreeTransform A d U V).natDegree := by
    rw [hd]
    exact commonDegreeTransform_natDegree_le B d U V hU hV
  rw [delayedCharacteristic_leadingCoeff k hD hm hN, leadingCoeff, hd,
    commonDegreeTransform_top_coeff A d U V hU hV]

end C2

end

/- ===== C2.NGammaRealizationDecay ===== -/

/-! Strict spectral-radius stability implies decay of the actual powers.
The proof uses Gelfand's formula and an eventual geometric norm bound. -/
noncomputable section
open scoped Topology
open Filter
namespace C2.NGamma.Realization

lemma powers_tendsto_zero_of_spectralRadius_lt_one
    {A : Type*} [NormedRing A] [NormedAlgebra ℂ A] [CompleteSpace A]
    (a : A) (ha : spectralRadius ℂ a < 1) :
    Tendsto (fun n : ℕ => a ^ n) atTop (𝓝 0) := by
  obtain ⟨q,hq,hq1⟩ := exists_between ha
  have hq0 : 0 < q := lt_of_le_of_lt bot_le hq
  have hqtop : q ≠ ⊤ := ne_of_lt (hq1.trans_le le_top)
  have hc0 : 0 < q.toReal := ENNReal.toReal_pos (ne_of_gt hq0) hqtop
  have hc1 : q.toReal < 1 := by
    simpa using (ENNReal.toReal_lt_toReal hqtop (by simp)).2 hq1
  have he := (spectrum.pow_norm_pow_one_div_tendsto_nhds_spectralRadius a).eventually
    (gt_mem_nhds hq)
  have hbound : ∀ᶠ n : ℕ in atTop, ‖a ^ n‖ ≤ q.toReal ^ n := by
    filter_upwards [he,eventually_gt_atTop (0:ℕ)] with n hn hn0
    have hnR : 0 < (n : ℝ) := by exact_mod_cast hn0
    have hroot : ‖a ^ n‖ ^ (1 / (n : ℝ)) < q.toReal := by
      rw [← ENNReal.ofReal_toReal hqtop] at hn
      exact (ENNReal.ofReal_lt_ofReal_iff hc0).mp hn
    have hp := (Real.rpow_inv_lt_iff_of_pos (norm_nonneg (a ^ n)) hc0.le hnR).mp
      (by simpa only [one_div] using hroot)
    exact (by simpa only [Real.rpow_natCast] using hp.le)
  exact squeeze_zero_norm' hbound
    (tendsto_pow_atTop_nhds_zero_of_lt_one hc0.le hc1)

end C2.NGamma.Realization

end

/- ===== C2.CompactSchur ===== -/

/-! A uniform geometric power bound for a compact continuous family of stable
operators. Compactness supplies a common contracting power; Bernoulli's
inequality supplies an explicit geometric ratio without root extraction. -/
noncomputable section
open Filter Set
open scoped Topology
namespace C2.CompactSchur

theorem common_contracting_power
    {X R : Type*} [TopologicalSpace X] [CompactSpace X]
    [NormedRing R] [NormOneClass R] (A : X → R) (hA : Continuous A)
    (hstable : ∀ x, Tendsto (fun n : ℕ => A x ^ n) atTop (𝓝 0)) :
    ∃ N : ℕ, 0 < N ∧ ∀ x, ‖A x ^ N‖ ≤ (1 / 2 : ℝ) := by
  classical
  have hex : ∀ x, ∃ n : ℕ, 0 < n ∧ ‖A x ^ n‖ < (1 / 2 : ℝ) := by
    intro x
    have hnorm : Tendsto (fun n : ℕ => ‖A x ^ n‖) atTop (𝓝 (0 : ℝ)) := by
      simpa using (hstable x).norm
    have he := hnorm.eventually (gt_mem_nhds (by norm_num : (0 : ℝ) < 1 / 2))
    obtain ⟨n, hn, hpos⟩ := (he.and (eventually_gt_atTop (0 : ℕ))).exists
    exact ⟨n, hpos, by simpa using hn⟩
  choose m hm0 hm using hex
  let U : X → Set X := fun x => {y | ‖A y ^ m x‖ < (1 / 2 : ℝ)}
  have hU : ∀ x, IsOpen (U x) := fun x =>
    isOpen_lt ((hA.pow (m x)).norm) continuous_const
  have hcover : (Set.univ : Set X) ⊆ ⋃ x, U x := by
    intro x _
    exact Set.mem_iUnion.mpr ⟨x, hm x⟩
  obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover U hU hcover
  let N := ∏ x ∈ s, m x
  have hN : 0 < N := Finset.prod_pos (fun x _ => hm0 x)
  refine ⟨N, hN, ?_⟩
  intro x
  obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (hs (Set.mem_univ x))
  change ‖A x ^ m y‖ < (1 / 2 : ℝ) at hxy
  obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem m hy
  have he : N = m y * k := hk
  have hk0 : 0 < k := by
    apply Nat.pos_of_ne_zero
    intro hk0
    rw [hk0, mul_zero] at he
    omega
  rw [he, pow_mul]
  calc
    ‖(A x ^ m y) ^ k‖ ≤ ‖A x ^ m y‖ ^ k := norm_pow_le _ _
    _ ≤ (1 / 2 : ℝ) ^ k := pow_le_pow_left₀ (norm_nonneg _) hxy.le _
    _ ≤ (1 / 2 : ℝ) ^ 1 := pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
    _ = 1 / 2 := pow_one _

theorem geometric_ratio (N : ℕ) (hN : 0 < N) :
    ∃ q : ℝ, 0 < q ∧ q < 1 ∧ (1 / 2 : ℝ) ≤ q ^ N := by
  have hn : (0 : ℝ) < N := by exact_mod_cast hN
  have hn1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  let q : ℝ := 1 - 1 / (2 * N)
  have hfrac : 0 < 1 / (2 * (N : ℝ)) := by positivity
  have hfrac1 : 1 / (2 * (N : ℝ)) < 1 := (div_lt_one (by positivity)).mpr (by linarith)
  have hq0 : 0 < q := by dsimp [q]; linarith
  have hq1 : q < 1 := by dsimp [q]; linarith
  refine ⟨q, hq0, hq1, ?_⟩
  have hb := one_add_mul_sub_le_pow (show (-1 : ℝ) ≤ q by linarith) N
  have he : 1 + (N : ℝ) * (q - 1) = 1 / 2 := by
    dsimp [q]
    field_simp
    <;> ring
  rwa [he] at hb

theorem geometric_bound_of_block {R : Type*} [NormedRing R] [NormOneClass R]
    (a : R) {B q : ℝ} {N : ℕ} (hB : 1 ≤ B)
    (ha : ‖a‖ ≤ B) (hq0 : 0 < q) (hq1 : q < 1) (hN : 0 < N)
    (hblock : ‖a ^ N‖ ≤ q ^ N) (n : ℕ) :
    ‖a ^ n‖ ≤ (B / q) ^ N * q ^ n := by
  have hr : n % N ≤ N := (Nat.mod_lt n hN).le
  have hB0 : 0 ≤ B := by linarith
  have hratio : 1 ≤ B / q := (le_div_iff₀ hq0).mpr (by linarith)
  have hrest : B ^ (n % N) ≤ (B / q) ^ N * q ^ (n % N) := by
    have h := pow_le_pow_right₀ hratio hr
    rw [div_pow] at h
    exact (div_le_iff₀ (pow_pos hq0 _)).mp h
  have hn : n = N * (n / N) + n % N := (Nat.div_add_mod n N).symm
  calc
    ‖a ^ n‖ = ‖(a ^ N) ^ (n / N) * a ^ (n % N)‖ := by rw [← pow_mul, ← pow_add, ← hn]
    _ ≤ ‖(a ^ N) ^ (n / N)‖ * ‖a ^ (n % N)‖ := norm_mul_le _ _
    _ ≤ (q ^ N) ^ (n / N) * B ^ (n % N) := by
      apply mul_le_mul
      · exact (norm_pow_le _ _).trans (pow_le_pow_left₀ (norm_nonneg _) hblock _)
      · exact (norm_pow_le _ _).trans (pow_le_pow_left₀ (norm_nonneg _) ha _)
      · exact norm_nonneg _
      · positivity
    _ ≤ (q ^ N) ^ (n / N) * ((B / q) ^ N * q ^ (n % N)) :=
      mul_le_mul_of_nonneg_left hrest (by positivity)
    _ = (B / q) ^ N * q ^ n := by
      conv_rhs => rw [hn, pow_add, pow_mul]
      ring

theorem uniform_geometric_of_compact_power_decay
    {X R : Type*} [TopologicalSpace X] [CompactSpace X]
    [NormedRing R] [NormOneClass R] (A : X → R) (hA : Continuous A)
    (hstable : ∀ x, Tendsto (fun n : ℕ => A x ^ n) atTop (𝓝 0)) :
    ∃ C q : ℝ, 0 < C ∧ 0 < q ∧ q < 1 ∧ ∀ x n, ‖A x ^ n‖ ≤ C * q ^ n := by
  obtain ⟨N, hN, hblock⟩ := common_contracting_power A hA hstable
  obtain ⟨q, hq0, hq1, hqN⟩ := geometric_ratio N hN
  obtain ⟨B₀, hB₀⟩ := (isCompact_range hA).isBounded.exists_norm_le
  let B := max 1 B₀
  have hB : 1 ≤ B := le_max_left _ _
  have hAx : ∀ x, ‖A x‖ ≤ B := fun x =>
    (hB₀ (A x) (Set.mem_range_self x)).trans (le_max_right _ _)
  have hBpos : 0 < B := by linarith
  have hCpos : 0 < (B / q) ^ N := by positivity
  refine ⟨(B / q) ^ N, q, hCpos, hq0, hq1, ?_⟩
  intro x n
  exact geometric_bound_of_block (A x) hB (hAx x) hq0 hq1 hN ((hblock x).trans hqN) n

theorem uniform_geometric_of_compact_spectral_radius
    {X R : Type*} [TopologicalSpace X] [CompactSpace X]
    [NormedRing R] [NormOneClass R] [NormedAlgebra ℂ R] [CompleteSpace R]
    (A : X → R) (hA : Continuous A) (hstable : ∀ x, spectralRadius ℂ (A x) < 1) :
    ∃ C q : ℝ, 0 < C ∧ 0 < q ∧ q < 1 ∧ ∀ x n, ‖A x ^ n‖ ≤ C * q ^ n := by
  apply uniform_geometric_of_compact_power_decay A hA
  intro x
  exact C2.NGamma.Realization.powers_tendsto_zero_of_spectralRadius_lt_one (A x) (hstable x)

end C2.CompactSchur

end

/- ===== C2.Schur ===== -/

/-! # Root-based Schur stability of a real quadratic

`QuadraticSchur` quantifies over actual complex zeros and the complex norm.
It is not defined to mean the Jury inequalities. The equivalence below
supplies the bridge from algebraic parameter inequalities to pole locations.
-/

namespace C2

def QuadraticSchur (L b c : ℝ) : Prop :=
  ∀ z : ℂ, (L : ℂ) * z ^ 2 + (b : ℂ) * z + (c : ℂ) = 0 → ‖z‖ < 1

lemma quadratic_root_parts {L b c : ℝ} {z : ℂ}
    (hz : (L : ℂ) * z ^ 2 + (b : ℂ) * z + (c : ℂ) = 0) :
    L * (z.re ^ 2 - z.im ^ 2) + b * z.re + c = 0 ∧
      z.im * (2 * L * z.re + b) = 0 := by
  have hr := congrArg Complex.re hz
  have hi := congrArg Complex.im hz
  simp [pow_two, Complex.mul_re, Complex.mul_im] at hr hi
  constructor <;> nlinarith

theorem quadraticSchur_of_jury {L b c : ℝ} (hL : 0 < L)
    (hplus : 0 < L + b + c) (hminus : 0 < L - b + c)
    (hc : 0 < L - c) : QuadraticSchur L b c := by
  classical
  intro z hz
  obtain ⟨hr, hi⟩ := quadratic_root_parts hz
  have hnorm : ‖z‖ ^ 2 = z.re ^ 2 + z.im ^ 2 := by
    rw [Complex.sq_norm, Complex.normSq_apply]
    ring
  by_cases hy : z.im = 0
  · have hxlt : z.re < 1 := by
      by_contra! hx
      have hterm : 0 ≤ (z.re - 1) * (L * z.re - c) :=
        mul_nonneg (by linarith) (by nlinarith)
      have hpos : 0 < z.re * (L + b + c) := mul_pos (by linarith) hplus
      simp only [hy, zero_pow, sub_zero] at hr
      nlinarith
    have hxgt : -1 < z.re := by
      by_contra! hx
      have hterm : 0 ≤ (z.re + 1) * (L * z.re + c) :=
        mul_nonneg_of_nonpos_of_nonpos (by linarith) (by nlinarith)
      have hneg : z.re * (L - b + c) < 0 := mul_neg_of_neg_of_pos (by linarith) hminus
      simp only [hy, zero_pow, sub_zero] at hr
      nlinarith
    have hx2 : z.re ^ 2 < 1 := by nlinarith [mul_pos (by linarith : 0 < 1-z.re) (by linarith : 0 < 1+z.re)]
    rw [hy] at hnorm
    nlinarith [norm_nonneg z]
  · have hlin : 2 * L * z.re + b = 0 := (mul_eq_zero.mp hi).resolve_left hy
    have hprod : L * (z.re ^ 2 + z.im ^ 2) = c := by nlinarith
    have hsq : z.re ^ 2 + z.im ^ 2 < 1 := by nlinarith
    nlinarith [norm_nonneg z]

lemma quadratic_has_root {L b c : ℝ} (hL : L ≠ 0) :
    ∃ z : ℂ, (L : ℂ) * z ^ 2 + (b : ℂ) * z + (c : ℂ) = 0 := by
  obtain ⟨z, hz⟩ := exists_quadratic_eq_zero (a := (L : ℂ)) (b := (b : ℂ))
    (c := (c : ℂ)) (by exact_mod_cast hL)
    (IsAlgClosed.exists_eq_mul_self (discrim (L : ℂ) (b : ℂ) (c : ℂ)))
  exact ⟨z, by simpa [pow_two] using hz⟩

theorem jury_of_quadraticSchur {L b c : ℝ} (hL : 0 < L)
    (hs : QuadraticSchur L b c) :
    0 < L + b + c ∧ 0 < L - b + c ∧ 0 < L - c := by
  classical
  have hLr : L ≠ 0 := ne_of_gt hL
  have hLc : (L : ℂ) ≠ 0 := by exact_mod_cast hLr
  obtain ⟨z, hz⟩ := quadratic_has_root (b := b) (c := c) hLr
  let w : ℂ := -(b : ℂ) / (L : ℂ) - z
  have hw : (L : ℂ) * w ^ 2 + (b : ℂ) * w + (c : ℂ) = 0 := by
    dsimp [w]
    field_simp [hLc]
    linear_combination (L : ℂ) ^ 3 * hz
  have hprod : (L : ℂ) * z * w = (c : ℂ) := by
    dsimp [w]
    field_simp [hLc]
    linear_combination -(L : ℂ) * hz
  have hsum : (L : ℂ) * (z + w) = -(b : ℂ) := by
    dsimp [w]
    field_simp [hLc]
    ring
  have hzn := hs z hz
  have hwn := hs w hw
  have hmul : ‖z‖ * ‖w‖ < 1 := by
    calc
      ‖z‖ * ‖w‖ ≤ ‖z‖ * 1 := mul_le_mul_of_nonneg_left hwn.le (norm_nonneg z)
      _ < 1 := by simpa using hzn
  have hcabs : |c| < L := by
    calc
      |c| = ‖(L : ℂ) * z * w‖ := by rw [hprod]; simp
      _ = L * (‖z‖ * ‖w‖) := by simp [norm_mul, Complex.norm_real, abs_of_pos hL]; ring
      _ < L * 1 := mul_lt_mul_of_pos_left hmul hL
      _ = L := mul_one L
  have hc : 0 < L - c := by have := (le_abs_self c).trans_lt hcabs; linarith
  obtain ⟨hr, hi⟩ := quadratic_root_parts hz
  by_cases hy : z.im = 0
  · have hwy : w.im = 0 := by simp [w, hy]
    have hzx : -1 < z.re ∧ z.re < 1 := abs_lt.mp ((Complex.abs_re_le_norm z).trans_lt hzn)
    have hwx : -1 < w.re ∧ w.re < 1 := abs_lt.mp ((Complex.abs_re_le_norm w).trans_lt hwn)
    have hpr := congrArg Complex.re hprod
    have hsu := congrArg Complex.re hsum
    simp [Complex.mul_re, hy, hwy] at hpr hsu
    have hpos := mul_pos hL (mul_pos (by linarith : 0 < 1-z.re) (by linarith : 0 < 1-w.re))
    have hneg := mul_pos hL (mul_pos (by linarith : 0 < 1+z.re) (by linarith : 0 < 1+w.re))
    exact ⟨by nlinarith, by nlinarith, hc⟩
  · have hlin : 2 * L * z.re + b = 0 := (mul_eq_zero.mp hi).resolve_left hy
    have hpos := mul_pos hL (add_pos_of_nonneg_of_pos (sq_nonneg (z.re-1)) (sq_pos_of_ne_zero hy))
    have hneg := mul_pos hL (add_pos_of_nonneg_of_pos (sq_nonneg (z.re+1)) (sq_pos_of_ne_zero hy))
    exact ⟨by nlinarith, by nlinarith, hc⟩

theorem quadraticSchur_iff {L b c : ℝ} (hL : 0 < L) :
    QuadraticSchur L b c ↔ 0 < L + b + c ∧ 0 < L - b + c ∧ 0 < L - c :=
  ⟨jury_of_quadraticSchur hL, fun h => quadraticSchur_of_jury hL h.1 h.2.1 h.2.2⟩

theorem quadratic_hurwitz_of_positive {L b c : ℝ}
    (hL : 0 < L) (hb : 0 < b) (hc : 0 < c) {z : ℂ}
    (hz : (L:ℂ)*z^2+(b:ℂ)*z+(c:ℂ)=0) : z.re < 0 := by
  obtain ⟨hr,hi⟩ := quadratic_root_parts hz
  by_cases hy : z.im = 0
  · by_contra hx
    have hx0 : 0 ≤ z.re := le_of_not_gt hx
    have h1 := mul_nonneg hL.le (sq_nonneg z.re)
    have h2 := mul_nonneg hb.le hx0
    rw [hy] at hr
    nlinarith
  · have hlin := (mul_eq_zero.mp hi).resolve_left hy
    nlinarith

end C2


/- ===== C2.CubicSchur ===== -/

/-! # Cubic Jury inequalities and actual complex poles

The proof factors out a real root, whose existence follows from the
intermediate value theorem, and uses the quadratic root criterion.
No stability predicate is replaced by an algebraic definition.
-/

namespace C2

def CubicSchur (b c d : ℝ) : Prop :=
  ∀ z : ℂ, z ^ 3 + (b : ℂ) * z ^ 2 + (c : ℂ) * z + (d : ℂ) = 0 → ‖z‖ < 1

def CubicJury (b c d : ℝ) : Prop :=
  |d| < 1 ∧ 0 < 1+b+c+d ∧ 0 < 1-b+c-d ∧ 0 < 1-c+b*d-d^2

lemma cubic_has_real_root (b c d : ℝ) :
    ∃ r : ℝ, r ^ 3 + b*r^2 + c*r+d = 0 := by
  let R : ℝ := 1+|b|+|c|+|d|
  have hR : 1 ≤ R := by
    dsimp [R]
    linarith [abs_nonneg b, abs_nonneg c, abs_nonneg d]
  have hR0 : 0 < R := by linarith
  have hR2 : R ≤ R^2 := by nlinarith
  have hRident : R = 1+|b|+|c|+|d| := rfl
  have hb1 := mul_le_mul_of_nonneg_right (neg_abs_le b) (sq_nonneg R)
  have hb2 := mul_le_mul_of_nonneg_right (le_abs_self b) (sq_nonneg R)
  have hc1 := mul_le_mul_of_nonneg_right (neg_abs_le c) hR0.le
  have hc2 := mul_le_mul_of_nonneg_right (le_abs_self c) hR0.le
  have hcR := mul_le_mul_of_nonneg_left hR2 (abs_nonneg c)
  have hdR := mul_le_mul_of_nonneg_left (show (1:ℝ) ≤ R^2 by nlinarith) (abs_nonneg d)
  have hpositive : 0 < R^3+b*R^2+c*R+d := by
    have hi : R^3-(|b|+|c|+|d|)*R^2 = R^2 := by rw [hRident]; ring
    nlinarith [neg_abs_le d, sq_pos_of_pos hR0]
  have hnegative : (-R)^3+b*(-R)^2+c*(-R)+d < 0 := by
    have hi : R^3-(|b|+|c|+|d|)*R^2 = R^2 := by rw [hRident]; ring
    nlinarith [le_abs_self d, sq_pos_of_pos hR0]
  have hf : Continuous (fun x : ℝ => x^3+b*x^2+c*x+d) := by fun_prop
  exact intermediate_value_univ (-R) R hf ⟨hnegative.le, hpositive.le⟩

lemma factor_positive_aux {r u v : ℝ} (hr : -1 < r ∧ r < 1)
    (hv : -1 < r*v ∧ r*v < 1)
    (hp : 0 < 1+u+v) (hm : 0 < 1-u+v) : 0 < 1+r*u+r^2*v := by
  by_cases hr0 : 0 ≤ r
  · have h1 := mul_nonneg hr0 hp.le
    have h2 := mul_pos (by linarith : 0 < 1-r) (by linarith : 0 < 1-r*v)
    nlinarith
  · have h1 := mul_nonneg (by linarith : 0 ≤ -r) hm.le
    have h2 := mul_pos (by linarith : 0 < 1+r) (by linarith : 0 < 1+r*v)
    nlinarith

lemma cubicJury_factor_iff (r u v : ℝ) :
    CubicJury (u-r) (v-r*u) (-r*v) ↔
      |r| < 1 ∧ 0 < 1+u+v ∧ 0 < 1-u+v ∧ 0 < 1-v := by
  classical
  constructor
  · rintro ⟨hd, hp, hm, hf⟩
    have hrv : -1 < r*v ∧ r*v < 1 := by
      have := abs_lt.mp hd
      constructor <;> linarith
    have hplus : 0 < (1-r)*(1+u+v) := by nlinarith [hp]
    have hminus : 0 < (1+r)*(1-u+v) := by nlinarith [hm]
    have hlast : 0 < (1-v)*(1+r*u+r^2*v) := by nlinarith [hf]
    have hrlt : r < 1 := by
      by_contra h
      have hr1 : 1 ≤ r := le_of_not_gt h
      have hvlt : v < 1 := by
        by_contra hv
        have hv1 : 1 ≤ v := le_of_not_gt hv
        have := mul_le_mul_of_nonneg_left hv1 (by linarith : 0 ≤ r)
        nlinarith
      have hqp : 1+u+v < 0 := by
        by_contra hq
        have := mul_nonpos_of_nonpos_of_nonneg (by linarith : 1-r ≤ 0) (le_of_not_gt hq)
        linarith
      have h1 := mul_neg_of_pos_of_neg (by linarith : 0 < r) hqp
      have h2 := mul_nonpos_of_nonneg_of_nonpos (by linarith : 0 ≤ r-1) (by linarith : r*v-1 ≤ 0)
      have hs : 1+r*u+r^2*v < 0 := by nlinarith
      have := mul_neg_of_pos_of_neg (by linarith : 0 < 1-v) hs
      linarith
    have hrgt : -1 < r := by
      by_contra h
      have hr1 : r ≤ -1 := le_of_not_gt h
      have hvlt : v < 1 := by
        by_contra hv
        have hv1 : 1 ≤ v := le_of_not_gt hv
        have := mul_le_mul_of_nonpos_left hv1 (by linarith : r ≤ 0)
        nlinarith
      have hqm : 1-u+v < 0 := by
        by_contra hq
        have := mul_nonpos_of_nonpos_of_nonneg (by linarith : 1+r ≤ 0) (le_of_not_gt hq)
        linarith
      have h1 := mul_neg_of_pos_of_neg (by linarith : 0 < -r) hqm
      have h2 := mul_nonpos_of_nonpos_of_nonneg (by linarith : r+1 ≤ 0) (by linarith : 0 ≤ r*v+1)
      have hs : 1+r*u+r^2*v < 0 := by nlinarith
      have := mul_neg_of_pos_of_neg (by linarith : 0 < 1-v) hs
      linarith
    have hqp : 0 < 1+u+v := (mul_pos_iff_of_pos_left (by linarith : 0 < 1-r)).mp hplus
    have hqm : 0 < 1-u+v := (mul_pos_iff_of_pos_left (by linarith : 0 < 1+r)).mp hminus
    have hs := factor_positive_aux ⟨hrgt, hrlt⟩ hrv hqp hqm
    exact ⟨abs_lt.mpr ⟨hrgt,hrlt⟩, hqp, hqm, (mul_pos_iff_of_pos_right hs).mp hlast⟩
  · rintro ⟨hr, hp, hm, hv⟩
    have hrr := abs_lt.mp hr
    have hvabs : |v| < 1 := abs_lt.mpr ⟨by linarith, by linarith⟩
    have hprod : |r| * |v| < 1 := by
      calc
        |r| * |v| ≤ |r| * 1 := mul_le_mul_of_nonneg_left hvabs.le (abs_nonneg r)
        _ < 1 := by simpa using hr
    have hrv : -1 < r*v ∧ r*v < 1 := abs_lt.mp (by simpa [abs_mul] using hprod)
    have hp' := mul_pos (by linarith : 0 < 1-r) hp
    have hm' := mul_pos (by linarith : 0 < 1+r) hm
    have hf' := mul_pos hv (factor_positive_aux hrr hrv hp hm)
    refine ⟨?_, by nlinarith, by nlinarith, by nlinarith⟩
    simpa [abs_mul] using hprod

theorem cubicSchur_iff_factor {b c d r u v : ℝ}
    (hb : b = u-r) (hc : c = v-r*u) (hd : d = -r*v) :
    CubicSchur b c d ↔ |r| < 1 ∧ QuadraticSchur 1 u v := by
  have hfac (z : ℂ) : z^3+(b:ℂ)*z^2+(c:ℂ)*z+(d:ℂ) =
      (z-(r:ℂ)) * ((1:ℂ)*z^2+(u:ℂ)*z+(v:ℂ)) := by
    rw [hb, hc, hd]
    push_cast
    ring
  constructor
  · intro hs
    constructor
    · have := hs (r:ℂ) (by rw [hfac]; simp)
      simpa using this
    · intro z hz
      apply hs z
      rw [hfac]
      have hz' : (1:ℂ)*z^2+(u:ℂ)*z+(v:ℂ)=0 := by simpa using hz
      rw [hz', mul_zero]
  · rintro ⟨hr,hq⟩ z hz
    rw [hfac] at hz
    rcases mul_eq_zero.mp hz with h | h
    · have : z = (r:ℂ) := sub_eq_zero.mp h
      simpa [this] using hr
    · exact hq z h

theorem cubicSchur_iff (b c d : ℝ) :
    CubicSchur b c d ↔
      |d| < 1 ∧ 0 < 1+b+c+d ∧ 0 < 1-b+c-d ∧ 0 < 1-c+b*d-d^2 := by
  obtain ⟨r,hr⟩ := cubic_has_real_root b c d
  let u := b+r
  let v := c+r*u
  have hb : b = u-r := by dsimp [u]; ring
  have hc : c = v-r*u := by dsimp [v]; ring
  have hd : d = -r*v := by dsimp [v,u]; nlinarith [hr]
  rw [cubicSchur_iff_factor hb hc hd, quadraticSchur_iff (by norm_num : (0:ℝ)<1)]
  simpa [CubicJury, hb, hc, hd] using (cubicJury_factor_iff r u v).symm

end C2


/- ===== C2.FirstOrder ===== -/

/-!
# Exact one-delay first-order gain optimization

The predicate `Jury` is deliberately an algebraic predicate.  The equivalence
with complex-root Schur stability is connected in a separate theorem once
the quadratic Schur criterion is imported.  No analytical statement is
hidden in this definition.
-/

noncomputable section

namespace C2.FirstOrder

def Jury (r γ a : ℝ) : Prop :=
  0 < a ∧ 0 < 2 + (2 * γ - 1) * (r - a) ∧
    0 < 1 + r * γ - a * (1 - γ)

def closedJury (r γ a : ℝ) : Prop :=
  0 ≤ 2 + (2 * γ - 1) * (r - a) ∧
    0 ≤ 1 + r * γ - a * (1 - γ)

def γParam (u : ℝ) : ℝ := (u + 2) / (2 * (u + 1))

def aParam (u : ℝ) : ℝ := (u + 1) ^ 2

def γStar (r : ℝ) : ℝ := 1 / 2 + 1 / (2 * (1 + Real.sqrt (1 + r)))

def aStar (r : ℝ) : ℝ := (1 + Real.sqrt (1 + r)) ^ 2

theorem γParam_bounds {u : ℝ} (hu : 1 ≤ u) :
    0 ≤ γParam u ∧ γParam u ≤ 1 := by
  have hd : 0 < 2 * (u + 1) := by linarith
  constructor
  · exact div_nonneg (by linarith) (le_of_lt hd)
  · unfold γParam
    apply (div_le_one hd).2
    linarith

theorem aParam_pos {u : ℝ} (hu : 1 ≤ u) : 0 < aParam u := by
  unfold aParam
  have hp : 0 < u + 1 := by linarith
  positivity

theorem γParam_first_identity {u a : ℝ} (hu : 1 ≤ u) :
    2 + (2 * γParam u - 1) * (u ^ 2 - 1 - a) =
      (aParam u - a) / (u + 1) := by
  have hn : u + 1 ≠ 0 := by linarith
  unfold γParam aParam
  field_simp [hn]
  <;> ring

theorem γParam_second_identity {u a : ℝ} (hu : 1 ≤ u) :
    1 + (u ^ 2 - 1) * γParam u - a * (1 - γParam u) =
      u * (aParam u - a) / (2 * (u + 1)) := by
  have hn : u + 1 ≠ 0 := by linarith
  unfold γParam aParam
  field_simp [hn]
  <;> ring

theorem param_subcritical {u a : ℝ} (hu : 1 ≤ u)
    (ha : 0 < a) (hbound : a < aParam u) :
    Jury (u ^ 2 - 1) (γParam u) a := by
  refine ⟨ha, ?_, ?_⟩
  · rw [γParam_first_identity hu]
    exact div_pos (sub_pos.mpr hbound) (by linarith)
  · rw [γParam_second_identity hu]
    exact div_pos (mul_pos (by linarith) (sub_pos.mpr hbound)) (by linarith)

/-- Every algebraically admissible gain is strictly below the claimed optimum.
This proof does not assume a parameter grid or local optimality. -/
theorem param_global_bound {u γ a : ℝ} (hu : 1 ≤ u)
    (h : Jury (u ^ 2 - 1) γ a) : a < aParam u := by
  rcases h with ⟨ha, h₁, h₂⟩
  by_contra hn
  have hab : aParam u ≤ a := le_of_not_gt hn
  have hp : 0 < u ^ 2 - 1 + a := by
    have : 0 ≤ u ^ 2 - 1 := by nlinarith
    linarith
  have hm : 0 ≤ 2 * (a - (u ^ 2 - 1)) := by
    unfold aParam at hab
    nlinarith
  have hc₁ := mul_pos hp h₁
  have hc₂ := mul_nonneg hm (le_of_lt h₂)
  have hcomb : 0 < 4 * a - (a - (u ^ 2 - 1)) ^ 2 := by
    nlinarith [hc₁, hc₂]
  have hlow : 0 ≤ a - (u - 1) ^ 2 := by
    unfold aParam at hab
    nlinarith
  have hprod := mul_nonneg (sub_nonneg.mpr hab) hlow
  unfold aParam at hprod
  nlinarith [hprod]

/-- The weak boundary inequalities at the globally largest gain uniquely
determine the discretization parameter. -/
theorem param_boundary_unique {u γ : ℝ} (hu : 1 ≤ u)
    (h : closedJury (u ^ 2 - 1) γ (aParam u)) : γ = γParam u := by
  rcases h with ⟨h₁, h₂⟩
  let x : ℝ := 2 * (u + 1) * γ - (u + 2)
  have hx₁ : x ≤ 0 := by
    dsimp [x]
    unfold aParam at h₁
    nlinarith [h₁]
  have hfactor : 1 + (u ^ 2 - 1) * γ - aParam u * (1 - γ) = u * x := by
    dsimp [x, aParam]
    ring
  rw [hfactor] at h₂
  have hx₂ : 0 ≤ x := by
    by_contra hn
    have hx : x < 0 := lt_of_not_ge hn
    have hneg := mul_neg_of_pos_of_neg (show 0 < u by linarith) hx
    linarith
  have hx : x = 0 := le_antisymm hx₁ hx₂
  unfold γParam
  apply (eq_div_iff (show 2 * (u + 1) ≠ 0 by nlinarith)).2
  dsimp [x] at hx
  nlinarith

theorem param_boundary_not_admissible {u γ : ℝ} (hu : 1 ≤ u) :
    ¬ Jury (u ^ 2 - 1) γ (aParam u) := by
  intro h
  exact (lt_irrefl _) (param_global_bound hu h)

theorem sqrt_param {r : ℝ} (hr : 0 ≤ r) :
    1 ≤ Real.sqrt (1 + r) ∧ r = (Real.sqrt (1 + r)) ^ 2 - 1 := by
  have hs : (Real.sqrt (1 + r)) ^ 2 = 1 + r := Real.sq_sqrt (by linarith)
  have hn := Real.sqrt_nonneg (1 + r)
  constructor
  · nlinarith
  · linarith

theorem γStar_eq_param {r : ℝ} (hr : 0 ≤ r) :
    γStar r = γParam (Real.sqrt (1 + r)) := by
  have hu := (sqrt_param hr).1
  have hn : 1 + Real.sqrt (1 + r) ≠ 0 := by linarith
  have hn' : Real.sqrt (1 + r) + 1 ≠ 0 := by linarith
  unfold γStar γParam
  field_simp [hn, hn']
  <;> ring

theorem aStar_eq_param (r : ℝ) : aStar r = aParam (Real.sqrt (1 + r)) := by
  unfold aStar aParam
  ring

theorem γStar_bounds {r : ℝ} (hr : 0 ≤ r) :
    0 ≤ γStar r ∧ γStar r ≤ 1 := by
  rw [γStar_eq_param hr]
  exact γParam_bounds (sqrt_param hr).1

theorem aStar_pos {r : ℝ} (hr : 0 ≤ r) : 0 < aStar r := by
  rw [aStar_eq_param]
  exact aParam_pos (sqrt_param hr).1

theorem global_gain_bound {r γ a : ℝ} (hr : 0 ≤ r)
    (h : Jury r γ a) : a < aStar r := by
  obtain ⟨hu, hr'⟩ := sqrt_param hr
  rw [hr'] at h
  rw [aStar_eq_param]
  exact param_global_bound hu h

theorem optimum_admissible_iff {r a : ℝ} (hr : 0 ≤ r) :
    Jury r (γStar r) a ↔ 0 < a ∧ a < aStar r := by
  constructor
  · intro h
    exact ⟨h.1, global_gain_bound hr h⟩
  · rintro ⟨ha, hb⟩
    obtain ⟨hu, hr'⟩ := sqrt_param hr
    rw [aStar_eq_param] at hb
    have hp := param_subcritical hu ha hb
    simpa only [← hr', ← γStar_eq_param hr] using hp

theorem admissible_projection {r a : ℝ} (hr : 0 ≤ r) :
    (∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r γ a) ↔
      0 < a ∧ a < aStar r := by
  constructor
  · rintro ⟨γ, _, _, h⟩
    exact ⟨h.1, global_gain_bound hr h⟩
  · intro h
    exact ⟨γStar r, (γStar_bounds hr).1, (γStar_bounds hr).2,
      (optimum_admissible_iff hr).2 h⟩

theorem optimal_boundary_unique {r γ : ℝ} (hr : 0 ≤ r)
    (h : closedJury r γ (aStar r)) : γ = γStar r := by
  obtain ⟨hu, hr'⟩ := sqrt_param hr
  have hp : closedJury ((Real.sqrt (1 + r)) ^ 2 - 1) γ
      (aParam (Real.sqrt (1 + r))) := by
    rw [← hr', ← aStar_eq_param]
    exact h
  rw [γStar_eq_param hr]
  exact param_boundary_unique hu hp

theorem optimal_gain_isLUB {r : ℝ} (hr : 0 ≤ r) :
    IsLUB {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r γ a} (aStar r) := by
  constructor
  · intro a ha
    exact le_of_lt ((admissible_projection hr).1 ha).2
  · intro b hb
    by_contra hn
    have hbA : b < aStar r := lt_of_not_ge hn
    have hA := aStar_pos hr
    let a : ℝ := (max b 0 + aStar r) / 2
    have hmax : max b 0 < aStar r := max_lt_iff.mpr ⟨hbA, hA⟩
    have ha : 0 < a := by dsimp [a]; nlinarith [le_max_right b 0]
    have haA : a < aStar r := by dsimp [a]; linarith
    have hba : b < a := by dsimp [a]; nlinarith [le_max_left b 0]
    have hmem : a ∈ {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r γ a} :=
      (admissible_projection hr).2 ⟨ha, haA⟩
    have := hb hmem
    linarith

/-- A linear inequality valid on a set persists at its finite supremum.
The proof uses only ordered-field properties and the defining property of
`IsLUB`; it does not assume that the supremum is in the original set. -/
theorem affine_nonneg_at_lub {S : Set ℝ} {A b c : ℝ}
    (hS : IsLUB S A) (h : ∀ a ∈ S, 0 < b + c * a) :
    0 ≤ b + c * A := by
  have hne : S.Nonempty := by
    by_contra hn
    have hb : A - 1 ∈ upperBounds S := by
      intro x hx
      exact False.elim (hn ⟨x, hx⟩)
    have := hS.2 hb
    linarith
  by_cases hc : 0 ≤ c
  · obtain ⟨x, hx⟩ := hne
    have hxA := hS.1 hx
    have hf := h x hx
    have hm := mul_nonneg hc (sub_nonneg.mpr hxA)
    nlinarith
  · have hc' : c < 0 := lt_of_not_ge hc
    have hb : (-b / c) ∈ upperBounds S := by
      intro x hx
      apply (le_div_iff_of_neg hc').2
      have := h x hx
      nlinarith
    have hAb := hS.2 hb
    have hi := (le_div_iff_of_neg hc').1 hAb
    nlinarith

/-- Uniqueness concerns the supremum of the strict stable-gain interval,
not an inadmissible gain declared to be an attained stable maximum. -/
theorem maximizing_parameter_unique {r γ : ℝ} (hr : 0 ≤ r)
    (hS : IsLUB {a : ℝ | Jury r γ a} (aStar r)) : γ = γStar r := by
  apply optimal_boundary_unique hr
  have h₁ := affine_nonneg_at_lub (b := 2 + (2 * γ - 1) * r)
    (c := -(2 * γ - 1)) hS (by
      intro a ha
      have := ha.2.1
      nlinarith)
  have h₂ := affine_nonneg_at_lub (b := 1 + r * γ)
    (c := -(1 - γ)) hS (by
      intro a ha
      have := ha.2.2
      nlinarith)
  constructor <;> nlinarith

theorem optimum_parameter_isLUB {r : ℝ} (hr : 0 ≤ r) :
    IsLUB {a : ℝ | Jury r (γStar r) a} (aStar r) := by
  have heq : {a : ℝ | Jury r (γStar r) a} =
      {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r γ a} := by
    ext a
    exact (optimum_admissible_iff hr).trans (admissible_projection hr).symm
  rw [heq]
  exact optimal_gain_isLUB hr

theorem maximizing_parameter_iff {r γ : ℝ} (hr : 0 ≤ r) :
    IsLUB {a : ℝ | Jury r γ a} (aStar r) ↔ γ = γStar r := by
  constructor
  · exact maximizing_parameter_unique hr
  · rintro rfl
    exact optimum_parameter_isLUB hr

theorem param_boundary_coefficients {u : ℝ} (hu : 1 ≤ u) :
    -1 + (u ^ 2 - 1) * (1 - γParam u) + aParam u * γParam u =
        2 * (1 + (u ^ 2 - 1) * γParam u) ∧
      aParam u * (1 - γParam u) = 1 + (u ^ 2 - 1) * γParam u := by
  have h₁ := γParam_first_identity (a := aParam u) hu
  have h₂ := γParam_second_identity (a := aParam u) hu
  rw [sub_self, zero_div] at h₁
  rw [sub_self, mul_zero, zero_div] at h₂
  constructor <;> nlinarith

theorem boundary_coefficients {r : ℝ} (hr : 0 ≤ r) :
    -1 + r * (1 - γStar r) + aStar r * γStar r =
        2 * (1 + r * γStar r) ∧
      aStar r * (1 - γStar r) = 1 + r * γStar r := by
  obtain ⟨hu, heq⟩ := sqrt_param hr
  have h := param_boundary_coefficients hu
  simpa only [← heq, ← γStar_eq_param hr, ← aStar_eq_param] using h

/-- At the optimum the characteristic polynomial has a double root at -1.
This is an identity on the complex plane, not a numerical root calculation. -/
theorem boundary_polynomial_factorization {r : ℝ} (hr : 0 ≤ r) (z : ℂ) :
    ((1 + r * γStar r : ℝ) : ℂ) * z ^ 2 +
        ((-1 + r * (1 - γStar r) + aStar r * γStar r : ℝ) : ℂ) * z +
        ((aStar r * (1 - γStar r) : ℝ) : ℂ) =
      ((1 + r * γStar r : ℝ) : ℂ) * (z + 1) ^ 2 := by
  obtain ⟨hb, hc⟩ := boundary_coefficients hr
  rw [hb, hc]
  push_cast
  ring

theorem γStar_strict_decrease {r₁ r₂ : ℝ} (h₁ : 0 ≤ r₁) (h₁₂ : r₁ < r₂) :
    γStar r₂ < γStar r₁ := by
  have h₂ : 0 ≤ r₂ := le_trans h₁ (le_of_lt h₁₂)
  obtain ⟨hu₁, hr₁⟩ := sqrt_param h₁
  obtain ⟨hu₂, hr₂⟩ := sqrt_param h₂
  have hu : Real.sqrt (1 + r₁) < Real.sqrt (1 + r₂) := by
    apply (sq_lt_sq₀ (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)).1
    linarith
  have hd₁ : 0 < 2 * (1 + Real.sqrt (1 + r₁)) := by linarith
  have hd₂ : 0 < 2 * (1 + Real.sqrt (1 + r₂)) := by linarith
  have hf : (1 : ℝ) / (2 * (1 + Real.sqrt (1 + r₂))) <
      1 / (2 * (1 + Real.sqrt (1 + r₁))) := by
    apply (div_lt_div_iff₀ hd₂ hd₁).2
    nlinarith
  unfold γStar
  linarith

theorem integrator_γStar : γStar 0 = 3 / 4 := by norm_num [γStar]

theorem integrator_aStar : aStar 0 = 4 := by norm_num [aStar]

theorem integrator_optimum_iff {a : ℝ} :
    Jury 0 (3 / 4) a ↔ 0 < a ∧ a < 4 := by
  simpa only [integrator_γStar, integrator_aStar] using
    (optimum_admissible_iff (r := 0) (by norm_num))

end C2.FirstOrder

end

/- ===== C2.FirstOrderCalculus ===== -/

namespace C2.FirstOrder

theorem γStar_gt_half {r : ℝ} (hr : 0 ≤ r) : 1 / 2 < γStar r := by
  have hs := (sqrt_param hr).1
  unfold γStar
  have hp : 0 < 1 / (2 * (1 + Real.sqrt (1 + r))) := by positivity
  linarith

theorem γStar_lt_three_quarters {r : ℝ} (hr : 0 < r) : γStar r < 3 / 4 := by
  have h := γStar_strict_decrease (le_refl 0) hr
  simpa only [integrator_γStar] using h

theorem γStar_hasDerivAt {r : ℝ} (hr : 0 ≤ r) :
    HasDerivAt γStar
      (-1 / (4 * Real.sqrt (1 + r) * (1 + Real.sqrt (1 + r)) ^ 2)) r := by
  have hu := (sqrt_param hr).1
  have hbase : HasDerivAt (fun x : ℝ => 1 + x) 1 r :=
    (hasDerivAt_id r).const_add 1
  have hs := hbase.sqrt (show 1 + r ≠ 0 by linarith)
  have hd := (hs.const_add 1).const_mul 2
  have hn : 2 * (1 + Real.sqrt (1 + r)) ≠ 0 := by nlinarith
  have hi := hd.inv hn
  have hf := hi.const_add (1 / 2 : ℝ)
  convert hf using 1
  · ext x
    simp only [γStar, one_div]
  · field_simp
    <;> ring

theorem γStar_derivative {r : ℝ} (hr : 0 ≤ r) :
    deriv γStar r =
      -1 / (4 * Real.sqrt (1 + r) * (1 + Real.sqrt (1 + r)) ^ 2) :=
  (γStar_hasDerivAt hr).deriv

theorem γStar_derivative_negative {r : ℝ} (hr : 0 ≤ r) :
    deriv γStar r < 0 := by
  rw [γStar_derivative hr]
  have hu := (sqrt_param hr).1
  apply div_neg_of_neg_of_pos (by norm_num)
  positivity

theorem γStar_tendsto_half :
    Filter.Tendsto γStar Filter.atTop (nhds (1 / 2 : ℝ)) := by
  have ht : Filter.Tendsto (fun r : ℝ => 2 * (1 + Real.sqrt (1 + r)))
      Filter.atTop Filter.atTop := by
    apply Filter.tendsto_atTop.2
    intro b
    filter_upwards [Filter.eventually_ge_atTop ((max b 0) ^ 2)] with x hx
    have hx0 : 0 ≤ x := le_trans (sq_nonneg _) hx
    have hs : (Real.sqrt (1 + x)) ^ 2 = 1 + x := Real.sq_sqrt (by linarith)
    have hm : max b 0 ≤ Real.sqrt (1 + x) := by
      apply (sq_le_sq₀ (le_max_right b 0) (Real.sqrt_nonneg _)).1
      linarith
    nlinarith [le_max_left b 0, Real.sqrt_nonneg (1 + x)]
  have hi := (tendsto_inv_atTop_zero (𝕜 := ℝ)).comp ht
  have hf := Filter.Tendsto.add (tendsto_const_nhds (x := (1 / 2 : ℝ))) hi
  change Filter.Tendsto (fun r : ℝ => 1 / 2 + 1 / (2 * (1 + Real.sqrt (1 + r)))) _ _
  simpa only [Function.comp_apply, one_div, add_zero] using hf

end C2.FirstOrder


/- ===== C2.FirstOrderSchur ===== -/

namespace C2.FirstOrder

/-- Positive gain and genuine complex-root Schur stability of the complete
one-delay characteristic polynomial. -/
def Stable (r γ a : ℝ) : Prop :=
  0 < a ∧ C2.QuadraticSchur (1 + r * γ)
    (-1 + r * (1 - γ) + a * γ) (a * (1 - γ))

theorem stable_iff_jury {r γ a : ℝ} (hr : 0 ≤ r) (hγ : 0 ≤ γ) :
    Stable r γ a ↔ Jury r γ a := by
  have hL : 0 < 1 + r * γ := by nlinarith [mul_nonneg hr hγ]
  unfold Stable Jury
  rw [C2.quadraticSchur_iff hL]
  constructor
  · rintro ⟨ha, h₁, h₂, h₃⟩
    refine ⟨ha, ?_, ?_⟩ <;> nlinarith
  · rintro ⟨ha, h₁, h₂⟩
    refine ⟨ha, ?_, ?_, ?_⟩ <;> nlinarith

theorem stable_global_gain_bound {r γ a : ℝ} (hr : 0 ≤ r)
    (hγ : 0 ≤ γ) (h : Stable r γ a) : a < aStar r :=
  global_gain_bound hr ((stable_iff_jury hr hγ).1 h)

theorem optimum_stable_iff {r a : ℝ} (hr : 0 ≤ r) :
    Stable r (γStar r) a ↔ 0 < a ∧ a < aStar r := by
  rw [stable_iff_jury hr (γStar_bounds hr).1]
  exact optimum_admissible_iff hr

theorem stable_projection {r a : ℝ} (hr : 0 ≤ r) :
    (∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r γ a) ↔
      0 < a ∧ a < aStar r := by
  constructor
  · rintro ⟨γ, hγ, _, h⟩
    exact ⟨h.1, stable_global_gain_bound hr hγ h⟩
  · intro h
    exact ⟨γStar r, (γStar_bounds hr).1, (γStar_bounds hr).2,
      (optimum_stable_iff hr).2 h⟩

theorem stable_optimal_gain_isLUB {r : ℝ} (hr : 0 ≤ r) :
    IsLUB {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r γ a} (aStar r) := by
  have heq : {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r γ a} =
      {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r γ a} := by
    ext a
    exact (stable_projection hr).trans (admissible_projection hr).symm
  rw [heq]
  exact optimal_gain_isLUB hr

theorem stable_maximizing_parameter_iff {r γ : ℝ}
    (hr : 0 ≤ r) (hγ : 0 ≤ γ) :
    IsLUB {a : ℝ | Stable r γ a} (aStar r) ↔ γ = γStar r := by
  have heq : {a : ℝ | Stable r γ a} = {a : ℝ | Jury r γ a} := by
    ext a
    exact stable_iff_jury hr hγ
  rw [heq]
  exact maximizing_parameter_iff hr

theorem integrator_stable_optimum_iff {a : ℝ} :
    Stable 0 (3 / 4) a ↔ 0 < a ∧ a < 4 := by
  simpa only [integrator_γStar, integrator_aStar] using
    (optimum_stable_iff (r := 0) (by norm_num))

end C2.FirstOrder


/- ===== C2.FirstOrderTaylor ===== -/

namespace C2.FirstOrder

/-- Explicit global remainder bounds imply the stated right-sided Taylor
orders at the integrator limit.  The bounds are stronger than an unspecified
big-O constant and are valid for every r >= 0. -/
theorem param_γ_remainder_bounds {u : ℝ} (hu : 1 ≤ u) :
    0 ≤ γParam u - 3 / 4 + (u ^ 2 - 1) / 16 ∧
      γParam u - 3 / 4 + (u ^ 2 - 1) / 16 ≤ (u ^ 2 - 1) ^ 2 / 32 := by
  have hn : u + 1 ≠ 0 := by linarith
  have hid : γParam u - 3 / 4 + (u ^ 2 - 1) / 16 =
      (u - 1) ^ 2 * (u + 3) / (16 * (u + 1)) := by
    unfold γParam
    field_simp [hn]
    <;> ring
  have hdiff : (u ^ 2 - 1) ^ 2 / 32 -
      (γParam u - 3 / 4 + (u ^ 2 - 1) / 16) =
      (u - 1) ^ 3 * (u ^ 2 + 4 * u + 5) / (32 * (u + 1)) := by
    unfold γParam
    field_simp [hn]
    <;> ring
  have hp : 0 ≤ (u - 1) ^ 3 * (u ^ 2 + 4 * u + 5) / (32 * (u + 1)) := by
    apply div_nonneg
    · apply mul_nonneg (pow_nonneg (by linarith) _)
      nlinarith [sq_nonneg u]
    · linarith
  constructor
  · rw [hid]
    apply div_nonneg
    · exact mul_nonneg (sq_nonneg _) (by linarith)
    · linarith
  · linarith [hdiff]

theorem param_a_remainder_bounds {u : ℝ} (hu : 1 ≤ u) :
    0 ≤ aParam u - (4 + 2 * (u ^ 2 - 1) - (u ^ 2 - 1) ^ 2 / 4) ∧
      aParam u - (4 + 2 * (u ^ 2 - 1) - (u ^ 2 - 1) ^ 2 / 4) ≤
        (u ^ 2 - 1) ^ 3 / 8 := by
  have hid : aParam u - (4 + 2 * (u ^ 2 - 1) - (u ^ 2 - 1) ^ 2 / 4) =
      (u - 1) ^ 3 * (u + 3) / 4 := by
    unfold aParam
    ring
  have hdiff : (u ^ 2 - 1) ^ 3 / 8 -
      (aParam u - (4 + 2 * (u ^ 2 - 1) - (u ^ 2 - 1) ^ 2 / 4)) =
      (u - 1) ^ 4 * (u ^ 2 + 4 * u + 5) / 8 := by
    unfold aParam
    ring
  have hp : 0 ≤ (u - 1) ^ 4 * (u ^ 2 + 4 * u + 5) / 8 := by
    apply div_nonneg
    · apply mul_nonneg (pow_nonneg (by linarith) _)
      nlinarith [sq_nonneg u]
    · norm_num
  constructor
  · rw [hid]
    exact div_nonneg (mul_nonneg (pow_nonneg (by linarith) _) (by linarith)) (by norm_num)
  · linarith [hdiff]

theorem γStar_remainder_bounds {r : ℝ} (hr : 0 ≤ r) :
    0 ≤ γStar r - 3 / 4 + r / 16 ∧
      γStar r - 3 / 4 + r / 16 ≤ r ^ 2 / 32 := by
  obtain ⟨hu, heq⟩ := sqrt_param hr
  have h := param_γ_remainder_bounds hu
  simpa only [← heq, ← γStar_eq_param hr] using h

theorem aStar_remainder_bounds {r : ℝ} (hr : 0 ≤ r) :
    0 ≤ aStar r - (4 + 2 * r - r ^ 2 / 4) ∧
      aStar r - (4 + 2 * r - r ^ 2 / 4) ≤ r ^ 3 / 8 := by
  obtain ⟨hu, heq⟩ := sqrt_param hr
  have h := param_a_remainder_bounds hu
  simpa only [← heq, ← aStar_eq_param] using h

end C2.FirstOrder


/- ===== C2.GeneralBoundaryCandidatesChebyshev ===== -/

/-! Exact Chebyshev polynomial for the imaginary cross product of two real
polynomials. The finite double sum is the ungrouped form of the manuscript's
coefficient formula c_q: the integer-index convention automatically gives
U_{-q-1}=-U_{q-1}, while U_{-1}=0. -/
noncomputable section
open scoped BigOperators
open Polynomial ComplexConjugate
namespace C2.GeneralBoundaryCandidates

def evalC (p : ℝ[X]) (z : ℂ) : ℂ := aeval z p

def point (θ : ℝ) : ℂ := Complex.exp ((θ:ℂ)*Complex.I)

def Q (H N : ℝ[X]) : ℝ[X] :=
  ∑ i ∈ H.support, ∑ j ∈ N.support,
    C (H.coeff i*N.coeff j)*Polynomial.Chebyshev.U ℝ ((i:ℤ)-(j:ℤ)-1)

theorem evalC_sum (p : ℝ[X]) (z : ℂ) :
    evalC p z = ∑ i ∈ p.support, (p.coeff i:ℂ)*z^i := by
  simp [evalC,aeval_def,Polynomial.eval₂_eq_sum,Polynomial.sum]

theorem point_re (θ : ℝ) : (point θ).re = Real.cos θ := by
  exact Complex.exp_ofReal_mul_I_re θ

theorem point_im (θ : ℝ) : (point θ).im = Real.sin θ := by
  exact Complex.exp_ofReal_mul_I_im θ

theorem power_cross_im (i j : ℕ) (θ : ℝ) :
    ((point θ)^i*star ((point θ)^j)).im =
      Real.sin θ*(Polynomial.Chebyshev.U ℝ ((i:ℤ)-(j:ℤ)-1)).eval (Real.cos θ) := by
  have he : (point θ)^i*star ((point θ)^j) =
      Complex.exp (((((i:ℝ)-(j:ℝ))*θ:ℝ):ℂ)*Complex.I) := by
    unfold point
    rw [← Complex.exp_nat_mul, ← Complex.exp_nat_mul]
    change Complex.exp _*(starRingEnd ℂ) (Complex.exp _) = _
    rw [← Complex.exp_conj, ← Complex.exp_add]
    congr 1
    simp
    push_cast
    ring
  rw [he]
  have htrig := Polynomial.Chebyshev.U_real_cos θ ((i:ℤ)-(j:ℤ)-1)
  rw [Complex.exp_ofReal_mul_I_im]
  have harg : (((i:ℤ)-(j:ℤ)-1:ℤ):ℝ)+1=(i:ℝ)-(j:ℝ) := by push_cast; ring
  rw [harg] at htrig
  simpa only [mul_comm] using htrig.symm

theorem coefficient_power_cross_im (h n : ℝ) (i j : ℕ) (θ : ℝ) :
    ((h:ℂ)*(point θ)^i*star ((n:ℂ)*(point θ)^j)).im =
      h*n*(Real.sin θ*(Polynomial.Chebyshev.U ℝ ((i:ℤ)-(j:ℤ)-1)).eval (Real.cos θ)) := by
  have he : (h:ℂ)*(point θ)^i*star ((n:ℂ)*(point θ)^j) =
      ((h*n:ℝ):ℂ)*((point θ)^i*star ((point θ)^j)) := by
    simp
    ring
  rw [he]
  rw [Complex.mul_im]
  simp only [Complex.ofReal_re,Complex.ofReal_im,zero_mul,add_zero]
  rw [power_cross_im]

theorem chebyshev_identity (H N : ℝ[X]) (θ : ℝ) :
    (evalC H (point θ)*star (evalC N (point θ))).im =
      Real.sin θ*(Q H N).eval (Real.cos θ) := by
  rw [evalC_sum,evalC_sum]
  simp only [star_sum,Finset.sum_mul,Finset.mul_sum,Complex.im_sum]
  simp_rw [coefficient_power_cross_im]
  simp only [Q,Polynomial.eval_finset_sum,Polynomial.eval_mul,Polynomial.eval_C,
    Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  ring

theorem chebyshev_identity_on_circle (H N : ℝ[X]) {z : ℂ} (hz : ‖z‖ = 1) :
    (evalC H z*star (evalC N z)).im = z.im*(Q H N).eval z.re := by
  obtain ⟨θ,rfl⟩ := (Complex.norm_eq_one_iff z).mp hz
  change (evalC H (point θ)*star (evalC N (point θ))).im = _
  rw [chebyshev_identity]
  change _ = (point θ).im*(Q H N).eval (point θ).re
  rw [point_im,point_re]

theorem evalC_conj (p : ℝ[X]) (z : ℂ) : evalC p (star z) = star (evalC p z) := by
  exact Polynomial.aeval_conj p z

theorem evalC_ofReal (p : ℝ[X]) (x : ℝ) : evalC p (x:ℂ) = ((p.eval x:ℝ):ℂ) := by
  exact Polynomial.aeval_ofReal p x

end C2.GeneralBoundaryCandidates

end

/- ===== C2.GeneralBoundaryCandidates ===== -/

/-! Finite exact unit-circle gain candidates, constructed by roots of the
Chebyshev cross-product polynomial and the two real endpoints. -/
noncomputable section
open scoped BigOperators
open Polynomial Set
namespace C2.GeneralBoundaryCandidates

def upperPoint (x : ℝ) : ℂ := (x:ℂ)+(Real.sqrt (1-x^2):ℂ)*Complex.I

def gainAt (H N : ℝ[X]) (z : ℂ) : ℝ :=
  -(evalC H z*star (evalC N z)).re/Complex.normSq (evalC N z)

def candidatePoints (H N : ℝ[X]) : Set ℂ :=
  {1,-1} ∪ upperPoint '' (Ioo (-1:ℝ) 1 ∩ {x | (Q H N).eval x = 0})

def candidateGains (H N : ℝ[X]) : Set ℝ :=
  {k | 0 < k ∧ ∃ z ∈ candidatePoints H N, evalC N z ≠ 0 ∧ k = gainAt H N z}

@[simp] theorem upperPoint_re (x : ℝ) : (upperPoint x).re = x := by simp [upperPoint]
@[simp] theorem upperPoint_im (x : ℝ) : (upperPoint x).im = Real.sqrt (1-x^2) := by simp [upperPoint]

theorem circle_equation {z : ℂ} (hz : ‖z‖ = 1) : z.re^2+z.im^2=1 := by
  have hh := Complex.normSq_eq_norm_sq z
  rw [hz] at hh
  simpa [Complex.normSq_apply,pow_two] using hh

theorem upperPoint_norm {x : ℝ} (hx : x ∈ Ioo (-1:ℝ) 1) : ‖upperPoint x‖ = 1 := by
  have hs : 0 ≤ 1-x^2 := by nlinarith [hx.1,hx.2]
  have hq := Real.sq_sqrt hs
  have hn := Complex.normSq_eq_norm_sq (upperPoint x)
  simp only [Complex.normSq_apply,upperPoint_re,upperPoint_im] at hn
  nlinarith [norm_nonneg (upperPoint x)]

theorem upperPoint_im_pos {x : ℝ} (hx : x ∈ Ioo (-1:ℝ) 1) : 0 < (upperPoint x).im := by
  rw [upperPoint_im]
  apply Real.sqrt_pos.mpr
  nlinarith [hx.1,hx.2]

theorem upper_circle_representation {z : ℂ} (hz : ‖z‖ = 1) (hi : 0 < z.im) :
    z.re ∈ Ioo (-1:ℝ) 1 ∧ z = upperPoint z.re := by
  have hq := circle_equation hz
  have hx : z.re ∈ Ioo (-1:ℝ) 1 := by
    constructor <;> nlinarith [sq_pos_of_pos hi]
  refine ⟨hx,?_⟩
  apply Complex.ext
  · simp
  · rw [upperPoint_im]
    apply Eq.symm
    exact (Real.sqrt_eq_iff_eq_sq (by nlinarith) hi.le).mpr (by nlinarith)

theorem real_circle_points {z : ℂ} (hz : ‖z‖ = 1) (hi : z.im = 0) : z = 1 ∨ z = -1 := by
  have hq := circle_equation hz
  rw [hi] at hq
  have hr : z.re = 1 ∨ z.re = -1 := by
    have hh : (z.re-1)*(z.re+1)=0 := by nlinarith
    rcases mul_eq_zero.mp hh with h|h
    · exact Or.inl (by linarith)
    · exact Or.inr (by linarith)
  rcases hr with h|h
  · left; apply Complex.ext <;> simp [h,hi]
  · right; apply Complex.ext <;> simp [h,hi]

theorem candidatePoints_finite {H N : ℝ[X]} (hQ : Q H N ≠ 0) : (candidatePoints H N).Finite := by
  have hroots : ({x : ℝ | (Q H N).eval x=0}:Set ℝ).Finite := by
    simpa only [Polynomial.IsRoot] using Polynomial.finite_setOf_isRoot hQ
  exact ((Set.finite_singleton (-1:ℂ)).insert 1).union ((hroots.inter_of_right _).image upperPoint)

theorem candidateGains_finite {H N : ℝ[X]} (hQ : Q H N ≠ 0) : (candidateGains H N).Finite := by
  apply ((candidatePoints_finite hQ).image (gainAt H N)).subset
  rintro k ⟨hk,z,hz,hn,hkz⟩
  exact ⟨z,hz,hkz.symm⟩

theorem candidatePoint_properties {H N : ℝ[X]} {z : ℂ} (hz : z ∈ candidatePoints H N) :
    ‖z‖=1 ∧ (evalC H z*star (evalC N z)).im=0 := by
  rcases hz with hz | ⟨x,⟨hx,hQ⟩,rfl⟩
  · rcases hz with rfl | hz
    · constructor
      · simp
      · rw [chebyshev_identity_on_circle H N (by simp : ‖(1:ℂ)‖=1)]
        simp
    · have he : z = -1 := Set.mem_singleton_iff.mp hz
      subst z
      constructor
      · simp
      · rw [chebyshev_identity_on_circle H N (by simp : ‖(-1:ℂ)‖=1)]
        simp
  · refine ⟨upperPoint_norm hx,?_⟩
    rw [chebyshev_identity_on_circle H N (upperPoint_norm hx),upperPoint_re,hQ,mul_zero]

theorem feedback_conj {H N : ℝ[X]} {k : ℝ} {z : ℂ}
    (hz : evalC H z+(k:ℂ)*evalC N z=0) :
    evalC H (star z)+(k:ℂ)*evalC N (star z)=0 := by
  rw [evalC_conj,evalC_conj]
  have hh := congrArg (star : ℂ → ℂ) hz
  simpa only [map_add,map_mul,Complex.star_def,Complex.conj_ofReal,map_zero] using hh

/-- At the real endpoints the cross-product quotient is the ordinary real
quotient used in the manuscript. -/
theorem gainAt_ofReal (H N : ℝ[X]) (x : ℝ) (hN : N.eval x ≠ 0) :
    gainAt H N (x:ℂ) = -(H.eval x)/(N.eval x) := by
  unfold gainAt
  rw [evalC_ofReal,evalC_ofReal]
  simp only [Complex.star_def,Complex.conj_ofReal,Complex.mul_re,
    Complex.ofReal_re,Complex.ofReal_im,mul_zero,sub_zero,Complex.normSq_ofReal]
  field_simp
  ring

/-- Exact iff for the finite Chebyshev/endpoints candidate construction. -/
theorem unitCircleRoot_iff_candidate {H N : ℝ[X]} {k : ℝ} (hk : 0 < k)
    (hcommon : ∀ z : ℂ, ‖z‖=1 → evalC N z=0 → evalC H z≠0) :
    C2.UnitCircleRoot (evalC H) (evalC N) k ↔ k ∈ candidateGains H N := by
  constructor
  · rintro ⟨z,hz,hroot⟩
    have hupper : ∃ w : ℂ, ‖w‖=1 ∧ 0 ≤ w.im ∧ evalC H w+(k:ℂ)*evalC N w=0 := by
      by_cases hi : 0 ≤ z.im
      · exact ⟨z,hz,hi,hroot⟩
      · exact ⟨star z,by simpa using hz,by simpa using (show 0 ≤ -z.im by linarith),feedback_conj hroot⟩
    obtain ⟨w,hw,hwi,hwr⟩ := hupper
    have hN : evalC N w ≠ 0 := by
      intro hn
      have hh : evalC H w=0 := by simpa [hn] using hwr
      exact hcommon w hw hn hh
    obtain ⟨hkg,hcross⟩ := (C2.feedback_zero_iff_cross_product (evalC H w) (evalC N w) k hN).mp hwr
    refine ⟨hk,w,?_,hN,hkg⟩
    by_cases hi : w.im=0
    · exact Or.inl (real_circle_points hw hi)
    · have hip : 0 < w.im := lt_of_le_of_ne hwi (Ne.symm hi)
      obtain ⟨hx,hwx⟩ := upper_circle_representation hw hip
      have hQ : (Q H N).eval w.re=0 := by
        rw [chebyshev_identity_on_circle H N hw] at hcross
        exact (mul_eq_zero.mp hcross).resolve_left (ne_of_gt hip)
      exact Or.inr ⟨w.re,⟨hx,hQ⟩,hwx.symm⟩
  · rintro ⟨hk,z,hz,hN,hkg⟩
    obtain ⟨hnorm,hcross⟩ := candidatePoint_properties hz
    exact ⟨z,hnorm,(C2.feedback_zero_iff_cross_product (evalC H z) (evalC N z) k hN).mpr ⟨hkg,hcross⟩⟩

end C2.GeneralBoundaryCandidates

end

/- ===== C2.GeneralBoundaryChebyshevDegree ===== -/

/-! The degree bound for the explicit Chebyshev boundary polynomial. -/
noncomputable section
open scoped BigOperators
open Polynomial

namespace C2.GeneralBoundaryCandidates

theorem chebyshev_U_natDegree_le (n : ℕ) :
    (Polynomial.Chebyshev.U ℝ (n : ℤ)).natDegree ≤ n := by
  induction n using Nat.twoStepInduction with
  | zero => simp
  | one =>
    rw [Nat.cast_one, Polynomial.Chebyshev.U_one]
    exact (natDegree_mul_le).trans (by simp)
  | more n hn hn1 =>
    rw [show ((n + 2 : ℕ) : ℤ) = (n : ℤ) + 2 by omega,
      Polynomial.Chebyshev.U_add_two]
    have htwo : ((2 : ℝ[X]) * X).natDegree ≤ 1 :=
      natDegree_mul_le.trans (by simp)
    have hp : (((2 : ℝ[X]) * X) * Polynomial.Chebyshev.U ℝ ((n : ℤ) + 1)).natDegree ≤ n + 2 := by
      have hd := natDegree_mul_le (p := (2 : ℝ[X]) * X)
        (q := Polynomial.Chebyshev.U ℝ ((n : ℤ) + 1))
      have hn1' : (Polynomial.Chebyshev.U ℝ ((n : ℤ) + 1)).natDegree ≤ n + 1 := by
        simpa using hn1
      omega
    exact (natDegree_sub_le _ _).trans (max_le hp (by omega))

/-- Positive and negative frequency differences have the same degree bound;
the equal-frequency term is exactly U(-1)=0. -/
theorem chebyshev_difference_natDegree_le {i j L : ℕ} (hi : i ≤ L) (hj : j ≤ L) :
    (Polynomial.Chebyshev.U ℝ ((i : ℤ) - (j : ℤ) - 1)).natDegree ≤ L - 1 := by
  rcases lt_trichotomy i j with hij | hij | hij
  · have he : (i : ℤ) - (j : ℤ) - 1 = -((j - i - 1 : ℕ) : ℤ) - 2 := by omega
    rw [he, Polynomial.Chebyshev.U_neg_sub_two, natDegree_neg]
    exact (chebyshev_U_natDegree_le (j - i - 1)).trans (by omega)
  · subst j
    simp
  · have he : (i : ℤ) - (j : ℤ) - 1 = ((i - j - 1 : ℕ) : ℤ) := by omega
    rw [he]
    exact (chebyshev_U_natDegree_le (i - j - 1)).trans (by omega)

/-- The manuscript bound deg Q <= L-1 with L=deg H and deg N<=deg H.
The result is also valid for Q=0 when expressed using natDegree. -/
theorem Q_natDegree_le (H N : ℝ[X]) (hN : N.natDegree ≤ H.natDegree) :
    (Q H N).natDegree ≤ H.natDegree - 1 := by
  classical
  unfold Q
  apply natDegree_sum_le_of_forall_le
  intro i hi
  apply natDegree_sum_le_of_forall_le
  intro j hj
  apply (natDegree_C_mul_le _ _).trans
  exact chebyshev_difference_natDegree_le (le_natDegree_of_mem_supp i hi)
    ((le_natDegree_of_mem_supp j hj).trans hN)

end C2.GeneralBoundaryCandidates

end

/- ===== C2.GeneralBoundaryCandidateCardinality ===== -/

/-! At most L+1 candidate points and retained gains for deg H=L. -/
noncomputable section
open Polynomial Set

namespace C2.GeneralBoundaryCandidates

theorem real_zero_set_ncard_le {p : ℝ[X]} (hp : p ≠ 0) :
    ({x : ℝ | p.eval x = 0} : Set ℝ).ncard ≤ p.natDegree := by
  classical
  have he : ({x : ℝ | p.eval x = 0} : Set ℝ) = (p.roots.toFinset : Set ℝ) := by
    ext x
    simp only [Set.mem_setOf_eq, Finset.mem_coe, Multiset.mem_toFinset,
      Polynomial.mem_roots hp, Polynomial.IsRoot]
  rw [he, Set.ncard_coe_Finset]
  exact (Multiset.toFinset_card_le _).trans (Polynomial.card_roots' p)

theorem candidatePoints_ncard_le (H N : ℝ[X]) (hQ : Q H N ≠ 0) :
    (candidatePoints H N).ncard ≤ (Q H N).natDegree + 2 := by
  have hroots : ({x : ℝ | (Q H N).eval x = 0} : Set ℝ).Finite := by
    simpa only [Polynomial.IsRoot] using Polynomial.finite_setOf_isRoot hQ
  have hinter : (Ioo (-1 : ℝ) 1 ∩ {x | (Q H N).eval x = 0}).Finite :=
    hroots.inter_of_right _
  have himage := Set.ncard_image_le (f := upperPoint) hinter
  have hinter := Set.ncard_inter_le_ncard_right (Ioo (-1 : ℝ) 1)
    {x | (Q H N).eval x = 0} hroots
  have hzero := real_zero_set_ncard_le hQ
  have hpair : ({(1 : ℂ), -1} : Set ℂ).ncard = 2 := Set.ncard_pair (by norm_num)
  unfold candidatePoints
  have hu := Set.ncard_union_le ({(1 : ℂ), -1} : Set ℂ)
    (upperPoint '' (Ioo (-1 : ℝ) 1 ∩ {x | (Q H N).eval x = 0}))
  rw [hpair] at hu
  omega

theorem candidateGains_ncard_le_points (H N : ℝ[X]) (hQ : Q H N ≠ 0) :
    (candidateGains H N).ncard ≤ (candidatePoints H N).ncard := by
  have hp := candidatePoints_finite hQ
  have hsub : candidateGains H N ⊆ gainAt H N '' candidatePoints H N := by
    rintro k ⟨_, z, hz, _, hk⟩
    exact ⟨z, hz, hk.symm⟩
  exact (Set.ncard_le_ncard hsub (hp.image _)).trans (Set.ncard_image_le hp)

theorem candidate_cardinality_bound (H N : ℝ[X])
    (hN : N.natDegree ≤ H.natDegree) (hL : 0 < H.natDegree) (hQ : Q H N ≠ 0) :
    (candidatePoints H N).ncard ≤ H.natDegree + 1 ∧
      (candidateGains H N).ncard ≤ H.natDegree + 1 := by
  have hd := Q_natDegree_le H N hN
  have hp := candidatePoints_ncard_le H N hQ
  have hg := candidateGains_ncard_le_points H N hQ
  constructor <;> omega

end C2.GeneralBoundaryCandidates

end

/- ===== C2.NGammaRootCountBridge ===== -/

/-! An elementary polynomial argument principle, built from its actual complex
roots. Each root strictly inside the unit circle contributes one turn; roots
outside contribute zero turns. Multiplicity is retained by the root list. -/
noncomputable section
open scoped BigOperators
open Set Complex Polynomial
namespace C2.NGamma.RootCountBridge

def circle (t : ℝ) : ℂ := Complex.exp ((t : ℂ) * Complex.I)

@[simp] theorem circle_ne_zero (t : ℝ) : circle t ≠ 0 := Complex.exp_ne_zero _
@[simp] theorem norm_circle (t : ℝ) : ‖circle t‖ = 1 := Complex.norm_exp_ofReal_mul_I t
@[simp] theorem circle_zero : circle 0 = 1 := by simp [circle]
@[simp] theorem circle_two_pi : circle (2 * Real.pi) = 1 := by
  simpa [circle] using Complex.exp_two_pi_mul_I

theorem continuous_circle : Continuous circle := by unfold circle; fun_prop

def innerFactor (a : ℂ) (t : ℝ) : ℂ := 1 - a / circle t
def outerFactor (a : ℂ) (t : ℝ) : ℂ := 1 - circle t / a

theorem innerFactor_re_pos {a : ℂ} (ha : ‖a‖ < 1) (t : ℝ) :
    0 < (innerFactor a t).re := by
  have h := Complex.re_le_norm (a / circle t)
  simp only [norm_div, norm_circle, div_one] at h
  simp only [innerFactor, sub_re, one_re]
  linarith

theorem outerFactor_re_pos {a : ℂ} (ha : 1 < ‖a‖) (t : ℝ) :
    0 < (outerFactor a t).re := by
  have h := Complex.re_le_norm (circle t / a)
  simp only [norm_div, norm_circle] at h
  have hn : 1 / ‖a‖ < 1 := (div_lt_one (by positivity)).2 ha
  simp only [outerFactor, sub_re, one_re]
  linarith

theorem factor_inner (a : ℂ) (t : ℝ) :
    circle t - a = circle t * innerFactor a t := by
  unfold innerFactor
  field_simp [circle_ne_zero]

theorem factor_outer {a : ℂ} (ha : a ≠ 0) (t : ℝ) :
    circle t - a = (-a) * outerFactor a t := by
  unfold outerFactor
  field_simp
  ring

def linearAngle (a : ℂ) (t : ℝ) : ℝ :=
  if ‖a‖ < 1 then t + Complex.arg (innerFactor a t)
  else Complex.arg (-a) + Complex.arg (outerFactor a t)

theorem continuous_linearAngle {a : ℂ} (ha : ‖a‖ ≠ 1) :
    Continuous (linearAngle a) := by
  change Continuous (fun t => linearAngle a t)
  by_cases hi : ‖a‖ < 1
  · simp only [linearAngle, if_pos hi]
    apply continuous_id.add
    apply continuous_iff_continuousAt.2
    intro t
    apply (Complex.continuousAt_arg (Or.inl (innerFactor_re_pos hi t))).comp
    unfold innerFactor
    exact (continuous_const.sub (continuous_const.div continuous_circle circle_ne_zero)).continuousAt
  · have ho : 1 < ‖a‖ := lt_of_le_of_ne (le_of_not_gt hi) (Ne.symm ha)
    simp only [linearAngle, if_neg hi]
    apply continuous_const.add
    apply continuous_iff_continuousAt.2
    intro t
    apply (Complex.continuousAt_arg (Or.inl (outerFactor_re_pos ho t))).comp
    unfold outerFactor
    exact (continuous_const.sub (continuous_circle.div_const a)).continuousAt

theorem polar_inner (a : ℂ) (t : ℝ) :
    circle t - a = (‖circle t - a‖ : ℂ) *
      Complex.exp (((t + Complex.arg (innerFactor a t) : ℝ) : ℂ) * Complex.I) := by
  have hn : ‖circle t - a‖ = ‖innerFactor a t‖ := by
    rw [factor_inner, norm_mul, norm_circle, one_mul]
  rw [hn, Complex.ofReal_add, add_mul, Complex.exp_add]
  change circle t - a = (‖innerFactor a t‖ : ℂ) *
    (circle t * Complex.exp ((Complex.arg (innerFactor a t) : ℂ) * Complex.I))
  calc
    circle t - a = circle t * innerFactor a t := factor_inner a t
    _ = circle t * ((‖innerFactor a t‖ : ℂ) *
        Complex.exp ((Complex.arg (innerFactor a t) : ℂ) * Complex.I)) := by
          rw [Complex.norm_mul_exp_arg_mul_I]
    _ = _ := by ring

theorem polar_outer {a : ℂ} (ha : a ≠ 0) (t : ℝ) :
    circle t - a = (‖circle t - a‖ : ℂ) *
      Complex.exp (((Complex.arg (-a) + Complex.arg (outerFactor a t) : ℝ) : ℂ) * Complex.I) := by
  have hn : ‖circle t - a‖ = ‖-a‖ * ‖outerFactor a t‖ := by
    rw [factor_outer ha, norm_mul]
  rw [hn, Complex.ofReal_mul, Complex.ofReal_add, add_mul, Complex.exp_add]
  calc
    circle t - a = (-a) * outerFactor a t := factor_outer ha t
    _ = ((‖-a‖ : ℂ) * Complex.exp ((Complex.arg (-a) : ℂ) * Complex.I)) *
        ((‖outerFactor a t‖ : ℂ) *
          Complex.exp ((Complex.arg (outerFactor a t) : ℂ) * Complex.I)) := by
          rw [Complex.norm_mul_exp_arg_mul_I, Complex.norm_mul_exp_arg_mul_I]
    _ = _ := by ring

theorem polar_linear {a : ℂ} (_ha : ‖a‖ ≠ 1) (t : ℝ) :
    circle t - a = (‖circle t - a‖ : ℂ) *
      Complex.exp ((linearAngle a t : ℂ) * Complex.I) := by
  by_cases hi : ‖a‖ < 1
  · simpa only [linearAngle, if_pos hi] using polar_inner a t
  · have ha0 : a ≠ 0 := by intro h; simp [h] at hi
    simpa only [linearAngle, if_neg hi] using polar_outer ha0 t

theorem linearAngle_increment (a : ℂ) :
    linearAngle a (2 * Real.pi) - linearAngle a 0 =
      if ‖a‖ < 1 then 2 * Real.pi else 0 := by
  by_cases hi : ‖a‖ < 1
  · simp [linearAngle, hi, innerFactor]
  · simp [linearAngle, hi, outerFactor]

def rootsAngle : List ℂ → ℝ → ℝ
  | [], _ => 0
  | a :: roots, t => linearAngle a t + rootsAngle roots t

def factors (roots : List ℂ) (t : ℝ) : ℂ :=
  (roots.map (fun a => circle t - a)).prod

def insideCount (roots : List ℂ) : ℕ :=
  (roots.filter (fun a => ‖a‖ < 1)).length

theorem continuous_rootsAngle (roots : List ℂ)
    (hroots : ∀ a ∈ roots, ‖a‖ ≠ 1) : Continuous (rootsAngle roots) := by
  induction roots with
  | nil => exact continuous_const
  | cons a roots ih =>
    exact (continuous_linearAngle (hroots a (by simp))).add
      (ih (fun z hz => hroots z (by simp [hz])))

theorem polar_roots (roots : List ℂ)
    (hroots : ∀ a ∈ roots, ‖a‖ ≠ 1) (t : ℝ) :
    factors roots t = (‖factors roots t‖ : ℂ) *
      Complex.exp ((rootsAngle roots t : ℂ) * Complex.I) := by
  induction roots with
  | nil => simp [rootsAngle, factors]
  | cons a roots ih =>
    have ha := polar_linear (hroots a (by simp)) t
    have hr := ih (fun z hz => hroots z (by simp [hz]))
    simp only [rootsAngle, factors, List.map_cons, List.prod_cons]
    change (circle t - a) * factors roots t = _
    rw [norm_mul, Complex.ofReal_mul, Complex.ofReal_add, add_mul, Complex.exp_add]
    calc
      (circle t - a) * factors roots t =
        ((‖circle t - a‖ : ℂ) * Complex.exp ((linearAngle a t : ℂ) * I)) *
        ((‖factors roots t‖ : ℂ) * Complex.exp ((rootsAngle roots t : ℂ) * I)) := by
          rw [← ha, ← hr]
      _ = _ := by unfold factors; ring

theorem rootsAngle_increment (roots : List ℂ) :
    rootsAngle roots (2 * Real.pi) - rootsAngle roots 0 =
      (insideCount roots : ℝ) * (2 * Real.pi) := by
  induction roots with
  | nil => simp [rootsAngle, insideCount]
  | cons a roots ih =>
    have ha := linearAngle_increment a
    by_cases hi : ‖a‖ < 1
    · simp [rootsAngle, insideCount, List.filter_cons, hi] at *
      linarith
    · simp [rootsAngle, insideCount, List.filter_cons, hi] at *
      linarith

def polynomialAngle (p : Polynomial ℂ) (t : ℝ) : ℝ :=
  Complex.arg p.leadingCoeff + rootsAngle p.roots.toList t

def countInside (p : Polynomial ℂ) : ℕ := insideCount p.roots.toList

theorem eval_eq_factors (p : Polynomial ℂ) (t : ℝ) :
    p.eval (circle t) = p.leadingCoeff * factors p.roots.toList t := by
  rw [Polynomial.eval_eq_prod_roots_sub_of_splits_id (IsAlgClosed.splits p)]
  congr 1
  have hm : (↑(p.roots.toList.map (fun a => circle t - a)) : Multiset ℂ) =
      p.roots.map (fun a => circle t - a) := by
        rw [← Multiset.map_coe, Multiset.coe_toList]
  exact (congrArg Multiset.prod hm).symm

theorem polynomial_polar (p : Polynomial ℂ)
    (hroots : ∀ a ∈ p.roots, ‖a‖ ≠ 1) (t : ℝ) :
    p.eval (circle t) = (‖p.eval (circle t)‖ : ℂ) *
      Complex.exp ((polynomialAngle p t : ℂ) * Complex.I) := by
  have hr := polar_roots p.roots.toList (fun a ha => hroots a (by simpa using ha)) t
  rw [eval_eq_factors, norm_mul, Complex.ofReal_mul]
  simp only [polynomialAngle, Complex.ofReal_add, add_mul, Complex.exp_add]
  calc
    p.leadingCoeff * factors p.roots.toList t =
      ((‖p.leadingCoeff‖ : ℂ) * Complex.exp ((Complex.arg p.leadingCoeff : ℂ) * I)) *
      ((‖factors p.roots.toList t‖ : ℂ) *
        Complex.exp ((rootsAngle p.roots.toList t : ℂ) * I)) := by
          rw [Complex.norm_mul_exp_arg_mul_I, ← hr]
    _ = _ := by ring

theorem continuous_polynomialAngle (p : Polynomial ℂ)
    (hroots : ∀ a ∈ p.roots, ‖a‖ ≠ 1) : Continuous (polynomialAngle p) := by
  exact continuous_const.add
    (continuous_rootsAngle p.roots.toList (fun a ha => hroots a (by simpa using ha)))

theorem polynomialAngle_increment (p : Polynomial ℂ) :
    polynomialAngle p (2 * Real.pi) - polynomialAngle p 0 =
      (countInside p : ℝ) * (2 * Real.pi) := by
  simp only [polynomialAngle, countInside]
  linarith [rootsAngle_increment p.roots.toList]

theorem argument_difference_constant {s : Set ℝ} (hs : IsPreconnected s)
    {α β : ℝ → ℝ} (hα : ContinuousOn α s) (hβ : ContinuousOn β s)
    (he : ∀ t ∈ s, Complex.exp ((α t : ℂ) * I) =
      Complex.exp ((β t : ℂ) * I)) {u v : ℝ} (hu : u ∈ s) (hv : v ∈ s) :
    α u - β u = α v - β v := by
  let f : ℝ → ℂ := fun t =>
    (((α t : ℂ) * I) - ((β t : ℂ) * I)) / (2 * Real.pi * I)
  have hc : ContinuousOn f s := by
    exact (((Complex.continuous_ofReal.comp_continuousOn hα).mul continuousOn_const).sub
      ((Complex.continuous_ofReal.comp_continuousOn hβ).mul continuousOn_const)).div_const _
  have hden : (2 * (Real.pi : ℂ) * I) ≠ 0 := by
    exact mul_ne_zero (mul_ne_zero (by norm_num) (by exact_mod_cast Real.pi_ne_zero)) I_ne_zero
  have hr : f '' s ⊆ Set.range ((↑) : ℤ → ℂ) := by
    rintro z ⟨t, ht, rfl⟩
    obtain ⟨k, hk⟩ := Complex.exp_eq_exp_iff_exists_int.mp (he t ht)
    refine ⟨k, ?_⟩
    dsimp [f]
    rw [hk]
    field_simp
  have hd : IsTotallyDisconnected (Set.range ((↑) : ℤ → ℂ)) :=
    Complex.isometry_intCast.isEmbedding.isTotallyDisconnected_range.mpr inferInstance
  have hf := hd (f '' s) hr (hs.image f hc)
  have huv : f u = f v := hf ⟨u, hu, rfl⟩ ⟨v, hv, rfl⟩
  have hmul := (div_left_inj' hden).mp huv
  have him := congrArg Complex.im hmul
  simpa using him

theorem eval_circle_ne_zero {p : Polynomial ℂ} (hp : p ≠ 0)
    (hroots : ∀ a ∈ p.roots, ‖a‖ ≠ 1) (t : ℝ) : p.eval (circle t) ≠ 0 := by
  intro hz
  have hm : circle t ∈ p.roots := (Polynomial.mem_roots hp).2 hz
  exact hroots (circle t) hm (norm_circle t)

/-- The ordinary argument principle for a complex polynomial, proved directly
from its factorization. This theorem counts actual roots with multiplicity. -/
theorem polynomial_argument_principle {p : Polynomial ℂ} (hp : p ≠ 0)
    (hroots : ∀ a ∈ p.roots, ‖a‖ ≠ 1) {α : ℝ → ℝ}
    (hα : ContinuousOn α (Set.Icc 0 (2 * Real.pi)))
    (hpolar : ∀ t ∈ Set.Icc 0 (2 * Real.pi), p.eval (circle t) =
      (‖p.eval (circle t)‖ : ℂ) * Complex.exp ((α t : ℂ) * I)) :
    α (2 * Real.pi) - α 0 = (countInside p : ℝ) * (2 * Real.pi) := by
  have he : ∀ t ∈ Set.Icc 0 (2 * Real.pi), Complex.exp ((α t : ℂ) * I) =
      Complex.exp ((polynomialAngle p t : ℂ) * I) := by
    intro t ht
    have hn : (‖p.eval (circle t)‖ : ℂ) ≠ 0 := by
      exact_mod_cast (norm_ne_zero_iff.mpr (eval_circle_ne_zero hp hroots t))
    apply mul_left_cancel₀ hn
    exact (hpolar t ht).symm.trans (polynomial_polar p hroots t)
  have h0 : 0 ∈ Set.Icc 0 (2 * Real.pi) := by constructor <;> nlinarith [Real.pi_pos]
  have h1 : 2 * Real.pi ∈ Set.Icc 0 (2 * Real.pi) := by constructor <;> nlinarith [Real.pi_pos]
  have hc := argument_difference_constant isPreconnected_Icc hα
    (continuous_polynomialAngle p hroots).continuousOn he h1 h0
  linarith [polynomialAngle_increment p]

end C2.NGamma.RootCountBridge

end

/- ===== C2.NGammaRootCountReal ===== -/

/-! The real-coefficient, upper-semicircle form of the polynomial argument
principle. The conjugate symmetry doubles the argument increment. -/
noncomputable section
open scoped BigOperators ComplexConjugate
open Set Complex Polynomial
namespace C2.NGamma.RootCountBridge

theorem circle_reflect (t : ℝ) : circle (2 * Real.pi - t) = conj (circle t) := by
  unfold circle
  rw [Complex.ofReal_sub, sub_mul, Complex.exp_sub]
  simp only [Complex.ofReal_mul, Complex.ofReal_ofNat, Complex.exp_two_pi_mul_I, one_div]
  rw [← Complex.exp_neg, ← Complex.exp_conj]
  congr 1
  simp

theorem polynomial_reflected_polar {p : Polynomial ℂ}
    (hconj : ∀ z : ℂ, p.eval (conj z) = conj (p.eval z))
    (hroots : ∀ a ∈ p.roots, ‖a‖ ≠ 1) (t : ℝ) :
    p.eval (circle t) = (‖p.eval (circle t)‖ : ℂ) *
      Complex.exp (((-polynomialAngle p (2 * Real.pi - t) : ℝ) : ℂ) * I) := by
  have hp := polynomial_polar p hroots (2 * Real.pi - t)
  rw [circle_reflect, hconj] at hp
  have hc := congrArg conj hp
  simpa only [Complex.conj_conj, map_mul, Complex.conj_ofReal,
    Complex.norm_conj, ← Complex.exp_conj, map_mul, Complex.conj_I,
    mul_neg, Complex.ofReal_neg, neg_mul] using hc

theorem polynomialAngle_half_increment {p : Polynomial ℂ} (hp : p ≠ 0)
    (hconj : ∀ z : ℂ, p.eval (conj z) = conj (p.eval z))
    (hroots : ∀ a ∈ p.roots, ‖a‖ ≠ 1) :
    polynomialAngle p Real.pi - polynomialAngle p 0 =
      (countInside p : ℝ) * Real.pi := by
  let β : ℝ → ℝ := fun t => -polynomialAngle p (2 * Real.pi - t)
  have hβ : Continuous β := by
    exact ((continuous_polynomialAngle p hroots).comp (continuous_const.sub continuous_id)).neg
  have he : ∀ t ∈ (Set.univ : Set ℝ),
      Complex.exp ((polynomialAngle p t : ℂ) * I) = Complex.exp ((β t : ℂ) * I) := by
    intro t ht
    have hn : (‖p.eval (circle t)‖ : ℂ) ≠ 0 := by
      exact_mod_cast (norm_ne_zero_iff.mpr (eval_circle_ne_zero hp hroots t))
    apply mul_left_cancel₀ hn
    exact (polynomial_polar p hroots t).symm.trans (polynomial_reflected_polar hconj hroots t)
  have hc := argument_difference_constant isPreconnected_univ
    (continuous_polynomialAngle p hroots).continuousOn hβ.continuousOn he
    (Set.mem_univ (0 : ℝ)) (Set.mem_univ Real.pi)
  dsimp [β] at hc
  have hm : 2 * Real.pi - Real.pi = Real.pi := by ring
  simp only [sub_zero, hm, sub_neg_eq_add] at hc
  linarith [polynomialAngle_increment p]

/-- An upper-half-circle argument lift counts the actual interior roots of a
real-coefficient polynomial, including multiplicities. -/
theorem polynomial_argument_principle_half {p : Polynomial ℂ} (hp : p ≠ 0)
    (hconj : ∀ z : ℂ, p.eval (conj z) = conj (p.eval z))
    (hroots : ∀ a ∈ p.roots, ‖a‖ ≠ 1) {α : ℝ → ℝ}
    (hα : ContinuousOn α (Set.Icc 0 Real.pi))
    (hpolar : ∀ t ∈ Set.Icc 0 Real.pi, p.eval (circle t) =
      (‖p.eval (circle t)‖ : ℂ) * Complex.exp ((α t : ℂ) * I)) :
    α Real.pi - α 0 = (countInside p : ℝ) * Real.pi := by
  have he : ∀ t ∈ Set.Icc 0 Real.pi, Complex.exp ((α t : ℂ) * I) =
      Complex.exp ((polynomialAngle p t : ℂ) * I) := by
    intro t ht
    have hn : (‖p.eval (circle t)‖ : ℂ) ≠ 0 := by
      exact_mod_cast (norm_ne_zero_iff.mpr (eval_circle_ne_zero hp hroots t))
    apply mul_left_cancel₀ hn
    exact (hpolar t ht).symm.trans (polynomial_polar p hroots t)
  have hc := argument_difference_constant isPreconnected_Icc hα
    (continuous_polynomialAngle p hroots).continuousOn he
    (show Real.pi ∈ Set.Icc 0 Real.pi from ⟨le_of_lt Real.pi_pos, le_rfl⟩)
    (show 0 ∈ Set.Icc 0 Real.pi from ⟨le_rfl, le_of_lt Real.pi_pos⟩)
  linarith [polynomialAngle_half_increment hp hconj hroots]

end C2.NGamma.RootCountBridge

end

/- ===== C2.NGammaPolynomial ===== -/

/-! Actual complex characteristic polynomials of positive cascades.
These statements use complex roots and do not replace Schur stability by a
phase inequality or an assumed root count. -/

noncomputable section
open scoped BigOperators
open Polynomial

namespace C2.NGamma.PolynomialModel

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def q (x : ℝ) : Polynomial ℂ :=
  C (((1 + x) / 2 : ℝ) : ℂ) * X + C (((1 - x) / 2 : ℝ) : ℂ)

def factor (r x : ℝ) : Polynomial ℂ := X - 1 + C (r : ℂ) * q x

def characteristic (r x : ι → ℝ) (d : ℕ) (b : ℝ) : Polynomial ℂ :=
  X ^ d * ∏ i, factor (r i) (x i) + C (b : ℂ) * ∏ i, q (x i)

def SchurStable (p : Polynomial ℂ) : Prop :=
  ∀ z : ℂ, p.eval z = 0 → ‖z‖ < 1

theorem q_eval (x : ℝ) (z : ℂ) :
    (q x).eval z = ((1 + (x : ℂ)) * z + 1 - x) / 2 := by
  simp only [q, eval_add, eval_mul, eval_C, eval_X]
  push_cast
  ring

theorem factor_eval (r x : ℝ) (z : ℂ) :
    (factor r x).eval z = z - 1 + r * (q x).eval z := by
  simp [factor]

theorem q_eval_one (x : ℝ) : (q x).eval 1 = 1 := by
  rw [q_eval]
  ring

theorem q_eval_neg_one (x : ℝ) : (q x).eval (-1) = -(x : ℂ) := by
  rw [q_eval]
  ring

theorem factor_eval_one (r x : ℝ) : (factor r x).eval 1 = (r : ℂ) := by
  rw [factor_eval, q_eval_one]
  ring

theorem factor_eval_neg_one (r x : ℝ) :
    (factor r x).eval (-1) = -(2 + (r : ℂ) * x) := by
  rw [factor_eval, q_eval_neg_one]
  ring

theorem characteristic_eval_one (r x : ι → ℝ) (d : ℕ) (b : ℝ) :
    (characteristic r x d b).eval 1 = (∏ i, (r i : ℂ)) + b := by
  simp [characteristic, eval_prod, factor_eval_one, q_eval_one]

theorem characteristic_eval_neg_one (r x : ι → ℝ) (d : ℕ) (b : ℝ) :
    (characteristic r x d b).eval (-1) =
      (-1 : ℂ) ^ (d + Fintype.card ι) * ∏ i, (2 + (r i : ℂ) * x i) +
      b * (-1 : ℂ) ^ Fintype.card ι * ∏ i, (x i : ℂ) := by
  simp only [characteristic, eval_add, eval_mul, eval_pow, eval_X, eval_prod,
    eval_C, factor_eval_neg_one, q_eval_neg_one]
  rw [Finset.prod_neg, Finset.prod_neg]
  simp only [Finset.card_univ]
  rw [pow_add]
  ring

theorem q_factor_no_common_root (r x : ℝ) (z : ℂ)
    (hq : (q x).eval z = 0) : (factor r x).eval z ≠ 0 := by
  intro hd
  rw [factor_eval, hq] at hd
  have hz : z = 1 := by linear_combination hd
  rw [hz, q_eval_one] at hq
  exact one_ne_zero hq

theorem factor_root_formula {r x : ℝ} (hr : 0 < r) (hx : 0 ≤ x)
    {z : ℂ} (hz : (factor r x).eval z = 0) :
    z = (((1 - r * (1 - x) / 2) / (1 + r * (1 + x) / 2) : ℝ) : ℂ) := by
  have ha : 0 < 1 + r * (1 + x) / 2 := by positivity
  have hn : (1 + (r : ℂ) * (1 + x) / 2) ≠ 0 := by
    exact_mod_cast ne_of_gt ha
  rw [factor_eval, q_eval] at hz
  push_cast
  apply (eq_div_iff hn).2
  linear_combination hz

theorem factor_schur {r x : ℝ} (hr : 0 < r) (hx : 0 ≤ x) :
    SchurStable (factor r x) := by
  intro z hz
  rw [factor_root_formula hr hx hz, Complex.norm_real]
  have ha : 0 < 1 + r * (1 + x) / 2 := by positivity
  apply abs_lt.mpr
  constructor
  · apply (lt_div_iff₀ ha).2
    nlinarith [mul_nonneg (le_of_lt hr) hx]
  · apply (div_lt_iff₀ ha).2
    linarith

theorem zero_gain_schur {r x : ι → ℝ} (hr : ∀ i, 0 < r i)
    (hx : ∀ i, 0 ≤ x i) (d : ℕ) : SchurStable (characteristic r x d 0) := by
  intro z hz
  have h : z ^ d * ∏ i, (factor (r i) (x i)).eval z = 0 := by
    simpa [characteristic, eval_prod] using hz
  rcases mul_eq_zero.mp h with hpow | hprod
  · have hz0 : z = 0 := pow_eq_zero hpow
    simp [hz0]
  · obtain ⟨i, _, hi⟩ := Finset.prod_eq_zero_iff.mp hprod
    exact factor_schur (hr i) (hx i) z hi

theorem one_not_root {r x : ι → ℝ} (hr : ∀ i, 0 < r i)
    (d : ℕ) {b : ℝ} (hb : 0 ≤ b) :
    (characteristic r x d b).eval 1 ≠ 0 := by
  rw [characteristic_eval_one]
  have hp : 0 < ∏ i, r i := Finset.prod_pos (fun i _ => hr i)
  have hn : (∏ i, r i) + b ≠ 0 := ne_of_gt (by linarith)
  exact_mod_cast hn

theorem endpoint_is_root {r x : ι → ℝ} (hx : ∀ i, x i ≠ 0) :
    (characteristic r x 1 (∏ i, (r i + 2 / x i))).eval (-1) = 0 := by
  rw [characteristic_eval_neg_one]
  have hprod : ((∏ i, (r i + 2 / x i) : ℝ) : ℂ) * ∏ i, (x i : ℂ) =
      ∏ i, (2 + (r i : ℂ) * x i) := by
    push_cast
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro i _
    have hn : (x i : ℂ) ≠ 0 := by exact_mod_cast hx i
    field_simp
    ring
  rw [pow_add]
  simp only [pow_one]
  calc
    (-1 : ℂ) * (-1) ^ Fintype.card ι * (∏ i, (2 + (r i : ℂ) * x i)) +
        (↑(∏ i, (r i + 2 / x i))) * (-1) ^ Fintype.card ι * (∏ i, (x i : ℂ)) =
      (-1) ^ Fintype.card ι *
        (- (∏ i, (2 + (r i : ℂ) * x i)) +
          (↑(∏ i, (r i + 2 / x i))) * ∏ i, (x i : ℂ)) := by ring
    _ = 0 := by rw [hprod]; ring

end C2.NGamma.PolynomialModel

end

/- ===== C2.NGammaRootCountConsequences ===== -/

/-! Actual root counts, Schur stability, and the conjugate symmetry of the
positive-cascade characteristic polynomial. -/
noncomputable section
open scoped BigOperators ComplexConjugate
open Set Complex Polynomial
namespace C2.NGamma.RootCountBridge

def outsideCount (roots : List ℂ) : ℕ :=
  (roots.filter (fun a => 1 < ‖a‖)).length

def countOutside (p : Polynomial ℂ) : ℕ := outsideCount p.roots.toList

theorem count_partition_list (roots : List ℂ)
    (hroots : ∀ a ∈ roots, ‖a‖ ≠ 1) :
    insideCount roots + outsideCount roots = roots.length := by
  induction roots with
  | nil => simp [insideCount, outsideCount]
  | cons a roots ih =>
    have hh : insideCount roots + outsideCount roots = roots.length :=
      ih (fun a ha => hroots a (by simp [ha]))
    have ha := hroots a (by simp)
    by_cases hi : ‖a‖ < 1
    · have ho : ¬ 1 < ‖a‖ := by linarith
      simpa [insideCount, outsideCount, List.filter_cons, hi, ho, Nat.add_assoc,
        Nat.add_comm, Nat.add_left_comm] using congrArg Nat.succ hh
    · have ho : 1 < ‖a‖ := lt_of_le_of_ne (le_of_not_gt hi) ha.symm
      simpa [insideCount, outsideCount, List.filter_cons, hi, ho, Nat.add_assoc,
        Nat.add_comm, Nat.add_left_comm] using congrArg Nat.succ hh

theorem count_partition (p : Polynomial ℂ)
    (hroots : ∀ a ∈ p.roots, ‖a‖ ≠ 1) :
    countInside p + countOutside p = p.natDegree := by
  have hh := count_partition_list p.roots.toList (fun a ha => hroots a (by simpa using ha))
  have hd : p.natDegree = p.roots.card := by
    simpa using Polynomial.natDegree_eq_card_roots (IsAlgClosed.splits p)
  simpa [countInside, countOutside, hd] using hh

theorem outsideCount_eq_zero_iff (roots : List ℂ) :
    outsideCount roots = 0 ↔ ∀ a ∈ roots, ‖a‖ ≤ 1 := by
  simp [outsideCount, List.filter_eq_nil_iff, not_lt]

theorem schur_iff_countOutside_zero {p : Polynomial ℂ} (hp : p ≠ 0)
    (hroots : ∀ a ∈ p.roots, ‖a‖ ≠ 1) :
    PolynomialModel.SchurStable p ↔ countOutside p = 0 := by
  rw [countOutside, outsideCount_eq_zero_iff]
  constructor
  · intro hs a ha
    exact le_of_lt (hs a ((Polynomial.mem_roots hp).1 (by simpa using ha)))
  · intro hs z hz
    have hm : z ∈ p.roots := (Polynomial.mem_roots hp).2 hz
    exact lt_of_le_of_ne (hs z (by simpa using hm)) (hroots z hm)

/-- Once a concrete upper-half-circle lift has the manuscript's endpoint
increment, this theorem gives the exterior-root formula with multiplicity. -/
theorem exterior_count_of_upper_argument {p : Polynomial ℂ} (hp : p ≠ 0)
    (hconj : ∀ z : ℂ, p.eval (conj z) = conj (p.eval z))
    (hroots : ∀ a ∈ p.roots, ‖a‖ ≠ 1) {α : ℝ → ℝ}
    (hα : ContinuousOn α (Set.Icc 0 Real.pi))
    (hpolar : ∀ t ∈ Set.Icc 0 Real.pi, p.eval (circle t) =
      (‖p.eval (circle t)‖ : ℂ) * Complex.exp ((α t : ℂ) * I))
    (m : ℤ) (hend : α Real.pi - α 0 = ((p.natDegree : ℝ) - 2 * m) * Real.pi) :
    (countOutside p : ℤ) = 2 * m := by
  have hi := polynomial_argument_principle_half hp hconj hroots hα hpolar
  have hn := count_partition p hroots
  have hnr : (countInside p : ℝ) + (countOutside p : ℝ) = p.natDegree := by exact_mod_cast hn
  have hi' : (countInside p : ℝ) = (p.natDegree : ℝ) - 2 * m := by
    apply mul_right_cancel₀ Real.pi_ne_zero
    exact hi.symm.trans hend
  have ho : (countOutside p : ℝ) = 2 * m := by linarith
  exact_mod_cast ho

end C2.NGamma.RootCountBridge

namespace C2.NGamma.PolynomialModel
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem q_eval_conj (x : ℝ) (z : ℂ) : (q x).eval (conj z) = conj ((q x).eval z) := by
  simp only [q_eval, map_div₀, map_sub, map_add, map_mul, map_one, map_ofNat,
    Complex.conj_ofReal]

theorem factor_eval_conj (r x : ℝ) (z : ℂ) :
    (factor r x).eval (conj z) = conj ((factor r x).eval z) := by
  simp only [factor_eval, q_eval_conj, map_add, map_sub, map_mul, map_one,
    Complex.conj_ofReal]

theorem characteristic_eval_conj (r x : ι → ℝ) (d : ℕ) (b : ℝ) (z : ℂ) :
    (characteristic r x d b).eval (conj z) = conj ((characteristic r x d b).eval z) := by
  simp only [characteristic, eval_add, eval_mul, eval_pow, eval_X, eval_C, eval_prod,
    map_add, map_mul, map_pow, map_prod, Complex.conj_ofReal, factor_eval_conj, q_eval_conj]

end C2.NGamma.PolynomialModel

end

/- ===== C2.GeneralBoundaryRootCount ===== -/

/-!
# Root-count constancy for a general affine polynomial gain family

A local comparison uses the continuous argument of the quotient of nearby
polynomials. Its real part is positive on the circle, so its total argument
increment is zero. Compactness then supplies a gain neighborhood, and local
constancy gives constancy on every preconnected boundary-free gain set.
-/

noncomputable section
open scoped Topology
open Filter Set Complex Polynomial C2.NGamma.RootCountBridge

namespace C2.GeneralBoundary

def BoundaryFree (p : Polynomial ℂ) : Prop :=
  ∀ z : ℂ, ‖z‖ = 1 → p.eval z ≠ 0

def gainPolynomial (H N : Polynomial ℂ) (k : ℝ) : Polynomial ℂ :=
  H + C (k : ℂ) * N

theorem boundaryFree_iff_not_unitCircleRoot (H N : Polynomial ℂ) (k : ℝ) :
    BoundaryFree (gainPolynomial H N k) ↔
      ¬ C2.UnitCircleRoot (fun z => H.eval z) (fun z => N.eval z) k := by
  simp only [BoundaryFree, gainPolynomial, eval_add, eval_mul, eval_C,
    C2.UnitCircleRoot, not_exists, not_and]

theorem boundaryFree_ne_zero {p : Polynomial ℂ} (h : BoundaryFree p) : p ≠ 0 := by
  intro hp
  have hn := h 1 (by simp)
  simpa [hp] using hn

theorem boundaryFree_roots {p : Polynomial ℂ} (h : BoundaryFree p) :
    ∀ z ∈ p.roots, ‖z‖ ≠ 1 := by
  intro z hz hnorm
  exact h z hnorm (isRoot_of_mem_roots hz)

theorem quotient_re_pos_of_close {p q : Polynomial ℂ} (hp : BoundaryFree p)
    (hclose : ∀ z : ℂ, ‖z‖ = 1 → ‖q.eval z - p.eval z‖ < ‖p.eval z‖)
    (z : ℂ) (hz : ‖z‖ = 1) : 0 < (q.eval z / p.eval z).re := by
  have hpn := hp z hz
  have hnorm : ‖(q.eval z - p.eval z) / p.eval z‖ < 1 := by
    rw [norm_div]
    exact (div_lt_one (norm_pos_iff.mpr hpn)).mpr (hclose z hz)
  have he : q.eval z / p.eval z = 1 + (q.eval z - p.eval z) / p.eval z := by
    field_simp [hpn]
  rw [he, Complex.add_re, Complex.one_re]
  have hb := (abs_le.mp (Complex.abs_re_le_norm ((q.eval z - p.eval z) / p.eval z))).1
  linarith

theorem boundaryFree_of_close {p q : Polynomial ℂ} (hp : BoundaryFree p)
    (hclose : ∀ z : ℂ, ‖z‖ = 1 → ‖q.eval z - p.eval z‖ < ‖p.eval z‖) :
    BoundaryFree q := by
  intro z hz hq
  have h := quotient_re_pos_of_close hp hclose z hz
  simp [hq] at h

/-- A polynomial Rouché comparison on the unit circle, retaining actual root
multiplicities. The proof uses the previously verified polynomial argument
principle, rather than assuming continuity of enumerated roots. -/
theorem countInside_eq_of_close {p q : Polynomial ℂ} (hp : BoundaryFree p)
    (hclose : ∀ z : ℂ, ‖z‖ = 1 → ‖q.eval z - p.eval z‖ < ‖p.eval z‖) :
    countInside q = countInside p := by
  have hq := boundaryFree_of_close hp hclose
  let r : ℝ → ℂ := fun t => q.eval (circle t) / p.eval (circle t)
  have hr : Continuous r :=
    (q.continuous.comp continuous_circle).div (p.continuous.comp continuous_circle)
      (fun t => hp _ (norm_circle t))
  have hrpos : ∀ t, 0 < (r t).re := fun t =>
    quotient_re_pos_of_close hp hclose _ (norm_circle t)
  have harg : Continuous (fun t => Complex.arg (r t)) := by
    apply continuous_iff_continuousAt.mpr
    intro t
    exact (Complex.continuousAt_arg (Or.inl (hrpos t))).comp hr.continuousAt
  let α : ℝ → ℝ := fun t => polynomialAngle p t + Complex.arg (r t)
  have hα : Continuous α := (continuous_polynomialAngle p (boundaryFree_roots hp)).add harg
  have hfac : ∀ t, q.eval (circle t) = p.eval (circle t) * r t := by
    intro t
    dsimp [r]
    field_simp [hp _ (norm_circle t)]
  have hpolar : ∀ t, q.eval (circle t) = (‖q.eval (circle t)‖ : ℂ) *
      Complex.exp ((α t : ℂ) * Complex.I) := by
    intro t
    rw [hfac t, norm_mul, Complex.ofReal_mul]
    dsimp [α]
    rw [Complex.ofReal_add, add_mul, Complex.exp_add]
    calc
      p.eval (circle t) * r t =
          ((‖p.eval (circle t)‖ : ℂ) * Complex.exp ((polynomialAngle p t : ℂ) * I)) *
          ((‖r t‖ : ℂ) * Complex.exp ((Complex.arg (r t) : ℂ) * I)) := by
        rw [← polynomial_polar p (boundaryFree_roots hp) t, Complex.norm_mul_exp_arg_mul_I]
      _ = _ := by ring
  have hi := polynomial_argument_principle (boundaryFree_ne_zero hq) (boundaryFree_roots hq)
    hα.continuousOn (fun t _ => hpolar t)
  have hend : r (2 * Real.pi) = r 0 := by simp [r]
  dsimp [α] at hi
  rw [hend] at hi
  have hpinc := polynomialAngle_increment p
  have hc : (countInside q : ℝ) = (countInside p : ℝ) := by
    have hpipos : 0 < Real.pi := Real.pi_pos
    nlinarith
  exact_mod_cast hc

theorem gain_eval_sub (H N : Polynomial ℂ) (k k₀ : ℝ) (z : ℂ) :
    (gainPolynomial H N k).eval z - (gainPolynomial H N k₀).eval z =
      ((k - k₀ : ℝ) : ℂ) * N.eval z := by
  simp only [gainPolynomial, eval_add, eval_mul, eval_C, Complex.ofReal_sub]
  ring

/-- Compactness of the circle provides an actual open gain neighborhood on
which both boundary-freeness and the root count persist. -/
theorem local_gain_count (H N : Polynomial ℂ) {k₀ : ℝ}
    (hp : BoundaryFree (gainPolynomial H N k₀)) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ k : ℝ, |k - k₀| < ε →
      BoundaryFree (gainPolynomial H N k) ∧
      countInside (gainPolynomial H N k) = countInside (gainPolynomial H N k₀) := by
  let p := gainPolynomial H N k₀
  have hs : IsCompact (Metric.sphere (0 : ℂ) 1) := isCompact_sphere _ _
  have hne : (Metric.sphere (0 : ℂ) 1).Nonempty := ⟨1, by simp⟩
  obtain ⟨z₀, hz₀, hmin⟩ := hs.exists_isMinOn hne p.continuous.norm.continuousOn
  have hz₀norm : ‖z₀‖ = 1 := by simpa using hz₀
  have hm : 0 < ‖p.eval z₀‖ := norm_pos_iff.mpr (hp z₀ hz₀norm)
  obtain ⟨M₀, hM₀⟩ := hs.exists_bound_of_continuousOn N.continuous.continuousOn
  let M := max 1 M₀
  have hM : 0 < M + 1 := by dsimp [M]; linarith [le_max_left (1 : ℝ) M₀]
  let ε := ‖p.eval z₀‖ / (M + 1)
  have hε : 0 < ε := div_pos hm hM
  refine ⟨ε, hε, ?_⟩
  intro k hk
  have hclose : ∀ z : ℂ, ‖z‖ = 1 →
      ‖(gainPolynomial H N k).eval z - p.eval z‖ < ‖p.eval z‖ := by
    intro z hz
    have hzs : z ∈ Metric.sphere (0 : ℂ) 1 := by simpa using hz
    have hNb : ‖N.eval z‖ ≤ M + 1 := by
      have hn := hM₀ z hzs
      have hmax : M₀ ≤ M := le_max_right _ _
      linarith
    rw [gain_eval_sub, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    calc
      |k - k₀| * ‖N.eval z‖ ≤ |k - k₀| * (M + 1) :=
        mul_le_mul_of_nonneg_left hNb (abs_nonneg _)
      _ < ε * (M + 1) := mul_lt_mul_of_pos_right hk hM
      _ = ‖p.eval z₀‖ := div_mul_cancel₀ _ (ne_of_gt hM)
      _ ≤ ‖p.eval z‖ := hmin hzs
  exact ⟨boundaryFree_of_close hp hclose, countInside_eq_of_close hp hclose⟩

theorem boundaryFree_gains_isOpen (H N : Polynomial ℂ) :
    IsOpen {k : ℝ | BoundaryFree (gainPolynomial H N k)} := by
  apply Metric.isOpen_iff.mpr
  intro k hk
  obtain ⟨ε, hε, he⟩ := local_gain_count H N hk
  refine ⟨ε, hε, ?_⟩
  intro l hl
  exact (he l (by simpa only [Metric.mem_ball, Real.dist_eq] using hl)).1

theorem count_locallyConstant_on (H N : Polynomial ℂ) (S : Set ℝ)
    (hS : ∀ k ∈ S, BoundaryFree (gainPolynomial H N k)) :
    IsLocallyConstant (fun k : S => countInside (gainPolynomial H N k)) := by
  apply (IsLocallyConstant.iff_eventually_eq _).mpr
  intro k
  obtain ⟨ε, hε, he⟩ := local_gain_count H N (hS k k.property)
  have ht : ∀ᶠ l : S in 𝓝 k, |(l : ℝ) - k| < ε := by
    have hc : Continuous (fun l : S => |(l : ℝ) - k|) :=
      (continuous_subtype_val.sub continuous_const).abs
    have hn : (fun l : S => |(l : ℝ) - k|) k < ε := by simpa using hε
    exact hc.continuousAt.eventually (gt_mem_nhds hn)
  filter_upwards [ht] with l hl
  exact (he l hl).2

/-- The inside-root count is constant on every preconnected gain set without
a unit-circle zero, including all connected components of the complement of
the finite candidate set. -/
theorem count_constant_on_preconnected (H N : Polynomial ℂ) {S : Set ℝ}
    (hconn : IsPreconnected S) (hS : ∀ k ∈ S, BoundaryFree (gainPolynomial H N k))
    {k l : ℝ} (hk : k ∈ S) (hl : l ∈ S) :
    countInside (gainPolynomial H N k) = countInside (gainPolynomial H N l) := by
  letI : PreconnectedSpace S := isPreconnected_iff_preconnectedSpace.mp hconn
  exact (count_locallyConstant_on H N S hS).apply_eq_of_preconnectedSpace ⟨k, hk⟩ ⟨l, hl⟩

theorem gainPolynomial_natDegree (H N : Polynomial ℂ)
    (hdeg : N.natDegree < H.natDegree) (k : ℝ) :
    (gainPolynomial H N k).natDegree = H.natDegree := by
  unfold gainPolynomial
  exact natDegree_add_eq_left_of_natDegree_lt ((natDegree_C_mul_le _ _).trans_lt hdeg)

theorem schur_iff_insideCount_degree {p : Polynomial ℂ} (hp : BoundaryFree p) :
    C2.NGamma.PolynomialModel.SchurStable p ↔ countInside p = p.natDegree := by
  rw [schur_iff_countOutside_zero (boundaryFree_ne_zero hp) (boundaryFree_roots hp)]
  have hc := count_partition p (boundaryFree_roots hp)
  omega

theorem schur_constant_on_preconnected (H N : Polynomial ℂ)
    (hdeg : N.natDegree < H.natDegree) {S : Set ℝ} (hconn : IsPreconnected S)
    (hS : ∀ k ∈ S, BoundaryFree (gainPolynomial H N k))
    {k l : ℝ} (hk : k ∈ S) (hl : l ∈ S) :
    C2.NGamma.PolynomialModel.SchurStable (gainPolynomial H N k) ↔
      C2.NGamma.PolynomialModel.SchurStable (gainPolynomial H N l) := by
  rw [schur_iff_insideCount_degree (hS k hk), schur_iff_insideCount_degree (hS l hl),
    gainPolynomial_natDegree H N hdeg k, gainPolynomial_natDegree H N hdeg l,
    count_constant_on_preconnected H N hconn hS hk hl]

theorem boundaryFree_of_schur {p : Polynomial ℂ}
    (hs : C2.NGamma.PolynomialModel.SchurStable p) : BoundaryFree p := by
  intro z hz he
  have hlt := hs z he
  rw [hz] at hlt
  exact (lt_irrefl (1 : ℝ)) hlt

theorem schur_gains_isOpen (H N : Polynomial ℂ)
    (hdeg : N.natDegree < H.natDegree) :
    IsOpen {k : ℝ | C2.NGamma.PolynomialModel.SchurStable (gainPolynomial H N k)} := by
  apply Metric.isOpen_iff.mpr
  intro k hk
  have hkfree := boundaryFree_of_schur hk
  obtain ⟨ε, hε, he⟩ := local_gain_count H N hkfree
  refine ⟨ε, hε, ?_⟩
  intro l hl
  obtain ⟨hlfree, hc⟩ := he l (by simpa only [Metric.mem_ball, Real.dist_eq] using hl)
  change C2.NGamma.PolynomialModel.SchurStable (gainPolynomial H N l)
  rw [schur_iff_insideCount_degree hlfree, hc, gainPolynomial_natDegree H N hdeg l]
  have hkcount := (schur_iff_insideCount_degree hkfree).mp hk
  simpa only [gainPolynomial_natDegree H N hdeg k] using hkcount

theorem boundary_point_not_schur (p : Polynomial ℂ)
    (h : ∃ z : ℂ, ‖z‖ = 1 ∧ p.eval z = 0) :
    ¬ C2.NGamma.PolynomialModel.SchurStable p := by
  rintro hs
  obtain ⟨z, hz, he⟩ := h
  have hn := hs z he
  rw [hz] at hn
  exact (lt_irrefl (1 : ℝ)) hn

end C2.GeneralBoundary

end

/- ===== C2.GeneralBoundaryCandidatesDecomposition ===== -/

/-! Complete fixed-parameter gain decomposition: finite explicit candidates,
actual boundary equivalence, multiplicity-count constancy and exact stability
constancy on every connected gain component. -/
noncomputable section
open scoped BigOperators
open Polynomial Set
namespace C2.GeneralBoundaryCandidates

def actualPolynomial (H N : ℝ[X]) (k : ℝ) : ℂ[X] :=
  GeneralBoundary.gainPolynomial (H.map (algebraMap ℝ ℂ)) (N.map (algebraMap ℝ ℂ)) k

theorem actualPolynomial_eval (H N : ℝ[X]) (k : ℝ) (z : ℂ) :
    (actualPolynomial H N k).eval z=evalC H z+(k:ℂ)*evalC N z := by
  simp [actualPolynomial,GeneralBoundary.gainPolynomial,evalC,aeval_def,Polynomial.eval_map]

theorem actual_boundary_iff_candidate {H N : ℝ[X]} {k : ℝ} (hk : 0 < k)
    (hcommon : ∀ z : ℂ, ‖z‖=1 → evalC N z=0 → evalC H z≠0) :
    (∃ z : ℂ, ‖z‖=1 ∧ (actualPolynomial H N k).eval z=0) ↔ k ∈ candidateGains H N := by
  simpa only [C2.UnitCircleRoot,actualPolynomial_eval] using unitCircleRoot_iff_candidate hk hcommon

theorem boundaryFree_of_not_candidate {H N : ℝ[X]} {k : ℝ} (hk : 0 < k)
    (hcommon : ∀ z : ℂ, ‖z‖=1 → evalC N z=0 → evalC H z≠0)
    (hn : k ∉ candidateGains H N) : GeneralBoundary.BoundaryFree (actualPolynomial H N k) := by
  intro z hz he
  exact hn ((actual_boundary_iff_candidate hk hcommon).mp ⟨z,hz,he⟩)

/-- Complete numbered theorem `thm:general-boundaries`. Connected components
are covered by the stronger assertion for every preconnected subset of the
positive gain axis after removing the explicit candidate set. -/
theorem complete_fixed_parameter_decomposition {H N : ℝ[X]}
    (hQ : Q H N ≠ 0) (hdeg : N.natDegree < H.natDegree)
    (hcommon : ∀ z : ℂ, ‖z‖=1 → evalC N z=0 → evalC H z≠0) :
    (candidateGains H N).Finite ∧
    (∀ k : ℝ, 0 < k →
      ((∃ z : ℂ, ‖z‖=1 ∧ (actualPolynomial H N k).eval z=0) ↔ k ∈ candidateGains H N)) ∧
    (∀ S : Set ℝ, IsPreconnected S → S ⊆ Ioi 0 \ candidateGains H N →
      ∀ k ∈ S, ∀ l ∈ S,
        C2.NGamma.RootCountBridge.countInside (actualPolynomial H N k) =
          C2.NGamma.RootCountBridge.countInside (actualPolynomial H N l) ∧
        (C2.NGamma.PolynomialModel.SchurStable (actualPolynomial H N k) ↔
          C2.NGamma.PolynomialModel.SchurStable (actualPolynomial H N l))) ∧
    ∀ k ∈ candidateGains H N, ¬C2.NGamma.PolynomialModel.SchurStable (actualPolynomial H N k) := by
  refine ⟨candidateGains_finite hQ,fun k hk => actual_boundary_iff_candidate hk hcommon,?_,?_⟩
  · intro S hconn hS k hk l hl
    have hf : ∀ b ∈ S, GeneralBoundary.BoundaryFree (actualPolynomial H N b) := fun b hb =>
      boundaryFree_of_not_candidate (hS hb).1 hcommon (hS hb).2
    have hd : (N.map (algebraMap ℝ ℂ)).natDegree < (H.map (algebraMap ℝ ℂ)).natDegree := by
      simpa only [Polynomial.natDegree_map] using hdeg
    exact ⟨GeneralBoundary.count_constant_on_preconnected _ _ hconn hf hk hl,
      GeneralBoundary.schur_constant_on_preconnected _ _ hd hconn hf hk hl⟩
  · intro k hk
    exact GeneralBoundary.boundary_point_not_schur _ ((actual_boundary_iff_candidate hk.1 hcommon).mpr hk)

end C2.GeneralBoundaryCandidates

end

/- ===== C2.GeneralBoundaryGroupedCoefficients ===== -/

/-! Exact equality of the double-sum boundary polynomial to the manuscript's
grouped coefficient construction c_q and sum c_q U_(q-1). -/
noncomputable section
open scoped BigOperators
open Polynomial

namespace C2.GeneralBoundaryCandidates

def differenceCoefficient (H N : ℝ[X]) (q : ℕ) : ℝ :=
  ∑ i ∈ H.support, ∑ j ∈ N.support,
    ((if i = j + q then H.coeff i * N.coeff j else 0) -
      (if j = i + q then H.coeff i * N.coeff j else 0))

def groupedQ (H N : ℝ[X]) (L : ℕ) : ℝ[X] :=
  ∑ q ∈ Finset.Icc 1 L,
    C (differenceCoefficient H N q) * Polynomial.Chebyshev.U ℝ ((q : ℤ) - 1)

theorem differenceCoefficient_eq (H N : ℝ[X]) (q : ℕ) :
    differenceCoefficient H N q =
      (∑ i ∈ H.support, ∑ j ∈ N.support,
        if i = j + q then H.coeff i * N.coeff j else 0) -
      (∑ i ∈ H.support, ∑ j ∈ N.support,
        if j = i + q then H.coeff i * N.coeff j else 0) := by
  simp only [differenceCoefficient, Finset.sum_sub_distrib]

theorem signed_chebyshev_grouping (h : ℝ) {i j L : ℕ} (hi : i ≤ L) (hj : j ≤ L) :
    C h * Polynomial.Chebyshev.U ℝ ((i : ℤ) - (j : ℤ) - 1) =
      ∑ q ∈ Finset.Icc 1 L,
        C ((if i = j + q then h else 0) - (if j = i + q then h else 0)) *
          Polynomial.Chebyshev.U ℝ ((q : ℤ) - 1) := by
  classical
  rcases lt_trichotomy i j with hij | hij | hij
  · have hmem : j - i ∈ Finset.Icc 1 L := by simp only [Finset.mem_Icc]; omega
    rw [Finset.sum_eq_single (j - i)]
    · have hpos : ¬ i = j + (j - i) := by omega
      have hneg : j = i + (j - i) := by omega
      have hind : (i : ℤ) - (j : ℤ) - 1 = -(((j - i : ℕ) : ℤ) - 1) - 2 := by omega
      rw [hind, Polynomial.Chebyshev.U_neg_sub_two]
      simp only [if_neg hpos, if_pos hneg, zero_sub, map_neg, mul_neg, neg_mul]
    · intro q hq hne
      have hq1 := (Finset.mem_Icc.mp hq).1
      have hpos : ¬ i = j + q := by omega
      have hneg : ¬ j = i + q := by omega
      simp [hpos, hneg]
    · exact fun hn => False.elim (hn hmem)
  · subst j
    have hzero : (∑ q ∈ Finset.Icc 1 L,
        C ((if i = i + q then h else 0) - (if i = i + q then h else 0)) *
          Polynomial.Chebyshev.U ℝ ((q : ℤ) - 1)) = 0 := by simp
    simpa using hzero.symm
  · have hmem : i - j ∈ Finset.Icc 1 L := by simp only [Finset.mem_Icc]; omega
    rw [Finset.sum_eq_single (i - j)]
    · have hpos : i = j + (i - j) := by omega
      have hneg : ¬ j = i + (i - j) := by omega
      have hind : (i : ℤ) - (j : ℤ) - 1 = ((i - j : ℕ) : ℤ) - 1 := by omega
      simp only [if_pos hpos, if_neg hneg, sub_zero, hind]
    · intro q hq hne
      have hq1 := (Finset.mem_Icc.mp hq).1
      have hpos : ¬ i = j + q := by omega
      have hneg : ¬ j = i + q := by omega
      simp [hpos, hneg]
    · exact fun hn => False.elim (hn hmem)

/-- The manuscript's c_q formula and the implemented double-sum Q are
literally equal polynomials, for every declared degree bound L. -/
theorem Q_eq_groupedQ (H N : ℝ[X]) (L : ℕ)
    (hH : H.natDegree ≤ L) (hN : N.natDegree ≤ L) : Q H N = groupedQ H N L := by
  classical
  unfold Q groupedQ differenceCoefficient
  simp only [map_sum, Finset.sum_mul]
  calc
    (∑ i ∈ H.support, ∑ j ∈ N.support,
        C (H.coeff i * N.coeff j) * Polynomial.Chebyshev.U ℝ ((i : ℤ) - (j : ℤ) - 1)) =
      ∑ i ∈ H.support, ∑ j ∈ N.support, ∑ q ∈ Finset.Icc 1 L,
        C ((if i = j + q then H.coeff i * N.coeff j else 0) -
          (if j = i + q then H.coeff i * N.coeff j else 0)) *
            Polynomial.Chebyshev.U ℝ ((q : ℤ) - 1) := by
      apply Finset.sum_congr rfl
      intro i hi
      apply Finset.sum_congr rfl
      intro j hj
      exact signed_chebyshev_grouping _ ((le_natDegree_of_mem_supp i hi).trans hH)
        ((le_natDegree_of_mem_supp j hj).trans hN)
    _ = ∑ i ∈ H.support, ∑ q ∈ Finset.Icc 1 L, ∑ j ∈ N.support,
        C ((if i = j + q then H.coeff i * N.coeff j else 0) -
          (if j = i + q then H.coeff i * N.coeff j else 0)) *
            Polynomial.Chebyshev.U ℝ ((q : ℤ) - 1) := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [Finset.sum_comm]
    _ = _ := by rw [Finset.sum_comm]

end C2.GeneralBoundaryCandidates

end

/- ===== C2.GeneralCompletionBounds ===== -/

/-!
# General coefficient and gain bounds

The bounds in this module concern the actual complex roots.  They supply
the quantitative polynomial step in the general rational gain argument.
They do not formalize CAD, root isolation, or a state-space realization.
-/

noncomputable section
open Polynomial Finset
namespace C2.GeneralCompletion

/-- Exact binomial bound for a polynomial whose roots lie in the closed disk.
The leading coefficient is retained, rather than assuming a monic model. -/
theorem coefficient_bound_of_closed_disk {p : Polynomial ℂ} (hp : p ≠ 0)
    (hroot : ∀ z : ℂ, p.eval z = 0 → ‖z‖ ≤ 1) (i : ℕ) :
    ‖p.coeff i‖ ≤ ‖p.leadingCoeff‖ * (p.natDegree.choose i : ℝ) := by
  let q := Polynomial.C p.leadingCoeff⁻¹ * p
  have hl : p.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hp
  have hq : q.Monic := monic_C_mul_of_mul_leadingCoeff_eq_one (inv_mul_cancel₀ hl)
  have hd : q.natDegree = p.natDegree := by
    exact Polynomial.natDegree_C_mul (inv_ne_zero hl)
  have hr : ∀ z ∈ (q.map (RingHom.id ℂ)).roots, ‖z‖ ≤ (1 : ℝ) := by
    intro z hz
    have he : q.eval z = 0 := by
      simpa using (isRoot_of_mem_roots hz)
    have he' : p.eval z = 0 := by
      simpa [q, hl] using he
    exact hroot z he'
  have hb := Polynomial.coeff_le_of_roots_le i hq (IsAlgClosed.splits q) hr
  have hnorm : 0 < ‖p.leadingCoeff‖ := norm_pos_iff.mpr hl
  simp only [Polynomial.map_id, hd, one_pow, one_mul] at hb
  have hb' : ‖p.coeff i‖ / ‖p.leadingCoeff‖ ≤ (p.natDegree.choose i : ℝ) := by
    simpa [q, norm_mul, norm_inv, div_eq_mul_inv, mul_comm] using hb
  exact (div_le_iff₀ hnorm).mp hb' |>.trans_eq (mul_comm _ _)

/-- One uniform coefficient bound using the central binomial coefficient. -/
theorem coefficient_bound_middle_of_closed_disk {p : Polynomial ℂ} (hp : p ≠ 0)
    (hroot : ∀ z : ℂ, p.eval z = 0 → ‖z‖ ≤ 1) (i : ℕ) :
    ‖p.coeff i‖ ≤
      ‖p.leadingCoeff‖ * (p.natDegree.choose (p.natDegree / 2) : ℝ) := by
  apply (coefficient_bound_of_closed_disk hp hroot i).trans
  gcongr
  exact_mod_cast i.choose_le_middle p.natDegree

/-- A real polynomial version, with the actual complex-root interpretation. -/
theorem real_coefficient_bound {p : Polynomial ℝ} (hp : p ≠ 0)
    (hroot : ∀ z : ℂ, (p.map Complex.ofRealHom).eval z = 0 → ‖z‖ ≤ 1)
    (i : ℕ) :
    |p.coeff i| ≤ |p.leadingCoeff| * (p.natDegree.choose i : ℝ) := by
  have hp' : p.map Complex.ofRealHom ≠ 0 := by simpa using hp
  have h := coefficient_bound_of_closed_disk hp' hroot i
  simpa using h

/-- For a delayed affine family, every coefficient below the fixed leading
degree yields an explicit stabilizing-gain bound. -/
theorem affine_gain_bound {H N : Polynomial ℝ} {k μ H₀ E₀ : ℝ} {L i : ℕ}
    (hk : 0 ≤ k) (hμ : 0 < μ) (hN : μ ≤ |N.coeff i|)
    (hH : |H.coeff i| ≤ H₀) (hE : |H.leadingCoeff| ≤ E₀)
    (hdeg : H.natDegree = L) (hlo : N.natDegree < H.natDegree)
    (hroot : ∀ z : ℂ,
      ((H + Polynomial.C k * N).map Complex.ofRealHom).eval z = 0 → ‖z‖ ≤ 1) :
    k ≤ (H₀ + E₀ * (L.choose (L / 2) : ℝ)) / μ := by
  have hd : (H + Polynomial.C k * N).natDegree = H.natDegree :=
    natDegree_add_eq_left_of_natDegree_lt ((natDegree_C_mul_le k N).trans_lt hlo)
  have hlead : (H + Polynomial.C k * N).leadingCoeff = H.leadingCoeff :=
    leadingCoeff_add_of_degree_lt' (degree_lt_degree
      ((natDegree_C_mul_le k N).trans_lt hlo))
  have hHne : H ≠ 0 := by
    intro he
    simp [he] at hlo
  have hp : H + Polynomial.C k * N ≠ 0 := by
    intro he
    have h := congrArg Polynomial.leadingCoeff he
    rw [hlead, leadingCoeff_zero] at h
    exact (leadingCoeff_ne_zero.mpr hHne) h
  have hb := real_coefficient_bound hp hroot i
  rw [hd, hlead, hdeg] at hb
  have hb' : |(H + Polynomial.C k * N).coeff i| ≤
      E₀ * (L.choose (L/2) : ℝ) := by
    calc
      _ ≤ |H.leadingCoeff| * (L.choose i : ℝ) := hb
      _ ≤ E₀ * (L.choose (L/2) : ℝ) := by
        apply mul_le_mul hE
        · exact_mod_cast i.choose_le_middle L
        · positivity
        · exact (abs_nonneg _).trans hE
  have ht : k * |N.coeff i| ≤
      |(H + Polynomial.C k * N).coeff i| + |H.coeff i| := by
    have he : k * N.coeff i =
        (H + Polynomial.C k * N).coeff i - H.coeff i := by simp
    calc
      _ = |k * N.coeff i| := by rw [abs_mul, abs_of_nonneg hk]
      _ = _ := congrArg abs he
      _ ≤ _ := abs_sub _ _
  apply (le_div_iff₀ hμ).mpr
  have hm := mul_le_mul_of_nonneg_left hN hk
  linarith

/-- A nonzero lower-degree feedback numerator forces all nonnegative Schur
gains into a bounded interval. This is the large-gain exclusion used in the
first-margin proof, independently of any boundary enumeration. -/
theorem stable_gains_bounded {H N : Polynomial ℝ} (hN : N ≠ 0)
    (hlo : N.natDegree < H.natDegree) :
    ∃ K : ℝ, ∀ k : ℝ, 0 ≤ k →
      (∀ z : ℂ, ((H+Polynomial.C k*N).map Complex.ofRealHom).eval z = 0 → ‖z‖ < 1) →
      k ≤ K := by
  obtain ⟨i, hi⟩ : ∃ i : ℕ, N.coeff i ≠ 0 := by
    by_contra h
    push_neg at h
    apply hN
    ext i
    simpa using h i
  refine ⟨(|H.coeff i| + |H.leadingCoeff| *
    (H.natDegree.choose (H.natDegree/2) : ℝ))/|N.coeff i|, ?_⟩
  intro k hk hstable
  exact affine_gain_bound hk (abs_pos.mpr hi) le_rfl le_rfl le_rfl rfl hlo
    (fun z hz => le_of_lt (hstable z hz))

end C2.GeneralCompletion

end

/- ===== C2.GeneralCompletionFirstMarginCore ===== -/

/-! The first positive boundary determines the initial stable component.
This order-theoretic step retains possible stable components above it. -/

noncomputable section
open Set
namespace C2.GeneralCompletion

def initialIntervalEndpoints (P : ℝ → Prop) : Set ℝ :=
  {b | 0 < b ∧ ∀ k : ℝ, 0 < k → k < b → P k}

theorem first_boundary_nonempty {P : ℝ → Prop} {K : Set ℝ}
    (hsmall : ∃ ε : ℝ, 0 < ε ∧ ∀ k : ℝ, 0 < k → k < ε → P k)
    (hbound : ∃ B : ℝ, ∀ k : ℝ, 0 < k → P k → k ≤ B)
    (htransfer : ∀ a b : ℝ, 0 < a → a ≤ b →
      (∀ k ∈ Icc a b, k ∉ K) → (P a ↔ P b)) : K.Nonempty := by
  by_contra hn
  have hK : K = ∅ := Set.not_nonempty_iff_eq_empty.mp hn
  obtain ⟨ε,hε,hs⟩ := hsmall
  obtain ⟨B,hB⟩ := hbound
  let b := max B 0 + 1
  have hb : 0 < b := by dsimp [b]; linarith [le_max_right B (0:ℝ)]
  let a := min ε b / 2
  have ha : 0 < a := div_pos (lt_min hε hb) (by norm_num)
  have hae : a < ε := by dsimp [a]; linarith [min_le_left ε b]
  have hab : a ≤ b := by
    change min ε b / 2 ≤ b
    exact (div_le_div_of_nonneg_right (min_le_right ε b) (by norm_num : (0:ℝ) ≤ 2)).trans
      (div_le_self hb.le (by norm_num : (1:ℝ) ≤ 2))
  have hPa : P a := hs a ha hae
  have hPb : P b := (htransfer a b ha hab (by simp [hK])).mp hPa
  have hh := hB b hb hPb
  dsimp [b] at hh
  linarith [le_max_left B (0:ℝ)]

/-- Finite candidates plus the independently proved interval-transport and
large-gain exclusion yield the least actual boundary and exact initial margin. -/
theorem finite_first_boundary_margin {P : ℝ → Prop} {K : Set ℝ}
    (hfinite : K.Finite) (hpositive : ∀ k ∈ K, 0 < k)
    (hboundary : ∀ k ∈ K, ¬P k)
    (hsmall : ∃ ε : ℝ, 0 < ε ∧ ∀ k : ℝ, 0 < k → k < ε → P k)
    (hbound : ∃ B : ℝ, ∀ k : ℝ, 0 < k → P k → k ≤ B)
    (htransfer : ∀ a b : ℝ, 0 < a → a ≤ b →
      (∀ k ∈ Icc a b, k ∉ K) → (P a ↔ P b)) :
    ∃ c : ℝ, IsLeast K c ∧ 0 < c ∧
      (∀ k : ℝ, 0 < k → k < c → P k) ∧ ¬P c ∧
      IsGreatest (initialIntervalEndpoints P) c ∧
      initialIntervalEndpoints P = Ioc 0 c ∧ sSup (initialIntervalEndpoints P) = c := by
  have hne := first_boundary_nonempty hsmall hbound htransfer
  obtain ⟨c,hc⟩ := hfinite.isCompact.exists_isLeast hne
  have hcpos := hpositive c hc.1
  have hbelow : ∀ k : ℝ, 0 < k → k < c → P k := by
    intro k hk hkc
    obtain ⟨ε,hε,hs⟩ := hsmall
    let a := min ε k / 2
    have ha : 0 < a := div_pos (lt_min hε hk) (by norm_num)
    have hae : a < ε := by dsimp [a]; linarith [min_le_left ε k]
    have hak : a ≤ k := by dsimp [a]; linarith [min_le_right ε k]
    have hno : ∀ t ∈ Icc a k, t ∉ K := by
      intro t ht htk
      have hct := hc.2 htk
      linarith [ht.2]
    exact (htransfer a k ha hak hno).mp (hs a ha hae)
  have hnot := hboundary c hc.1
  have hgreat : IsGreatest (initialIntervalEndpoints P) c := by
    refine ⟨⟨hcpos,hbelow⟩,?_⟩
    intro b hb
    by_contra hcb
    have hlt : c < b := lt_of_not_ge hcb
    exact hnot (hb.2 c hcpos hlt)
  have hset : initialIntervalEndpoints P = Ioc 0 c := by
    ext b
    constructor
    · intro hb
      exact ⟨hb.1,hgreat.2 hb⟩
    · rintro ⟨hb,hbc⟩
      exact ⟨hb,fun k hk hkb => hbelow k hk (hkb.trans_le hbc)⟩
  exact ⟨c,hc,hcpos,hbelow,hnot,hgreat,hset,hgreat.csSup_eq⟩

end C2.GeneralCompletion

end

/- ===== C2.GeneralCompletionFirstMargin ===== -/

/-! The least finite Chebyshev boundary is the exact initial gain margin
for the actual real rational characteristic. Later stable components are
not excluded or silently merged with the initial component. -/

noncomputable section
open Polynomial Set
namespace C2.GeneralCompletion

/-- Actual complex-root stability of the real affine characteristic. -/
def realGainSchur (H N : ℝ[X]) (k : ℝ) : Prop :=
  C2.NGamma.PolynomialModel.SchurStable
    (C2.GeneralBoundary.gainPolynomial (H.map Complex.ofRealHom) (N.map Complex.ofRealHom) k)

theorem mapped_gain_polynomial (H N : ℝ[X]) (k : ℝ) :
    (H+Polynomial.C k*N).map Complex.ofRealHom =
      C2.GeneralBoundary.gainPolynomial (H.map Complex.ofRealHom) (N.map Complex.ofRealHom) k := by
  simp [C2.GeneralBoundary.gainPolynomial]

theorem evalC_eq_mapped_eval (p : ℝ[X]) (z : ℂ) :
    C2.GeneralBoundaryCandidates.evalC p z = (p.map Complex.ofRealHom).eval z := by
  have he : algebraMap ℝ ℂ = Complex.ofRealHom := by ext r; rfl
  simp [C2.GeneralBoundaryCandidates.evalC,Polynomial.aeval_def,Polynomial.eval_map,he]

theorem realGainSchur_bounded {H N : ℝ[X]} (hN : N ≠ 0)
    (hdeg : N.natDegree < H.natDegree) :
    ∃ B : ℝ, ∀ k : ℝ, 0 < k → realGainSchur H N k → k ≤ B := by
  obtain ⟨B,hB⟩ := stable_gains_bounded hN hdeg
  refine ⟨B,fun k hk hs => hB k hk.le ?_⟩
  intro z hz
  apply hs z
  simpa only [mapped_gain_polynomial] using hz

theorem realGainSchur_not_at_candidate {H N : ℝ[X]} {k : ℝ}
    (hcommon : ∀ z : ℂ, ‖z‖=1 →
      C2.GeneralBoundaryCandidates.evalC N z=0 → C2.GeneralBoundaryCandidates.evalC H z≠0)
    (hk : k ∈ C2.GeneralBoundaryCandidates.candidateGains H N) :
    ¬realGainSchur H N k := by
  intro hs
  have hu := (C2.GeneralBoundaryCandidates.unitCircleRoot_iff_candidate hk.1 hcommon).mpr hk
  have hfree := C2.GeneralBoundary.boundaryFree_of_schur hs
  have hn := (C2.GeneralBoundary.boundaryFree_iff_not_unitCircleRoot
    (H.map Complex.ofRealHom) (N.map Complex.ofRealHom) k).mp hfree
  apply hn
  simpa only [C2.UnitCircleRoot,evalC_eq_mapped_eval] using hu

/-- Stability transports across every positive interval avoiding the actual
finite candidate set. This discharges the constancy hypothesis in the order lemma. -/
theorem realGainSchur_interval_transport {H N : ℝ[X]}
    (hdeg : N.natDegree < H.natDegree)
    (hcommon : ∀ z : ℂ, ‖z‖=1 →
      C2.GeneralBoundaryCandidates.evalC N z=0 → C2.GeneralBoundaryCandidates.evalC H z≠0)
    (a b : ℝ) (ha : 0 < a) (hab : a ≤ b)
    (hno : ∀ k ∈ Icc a b, k ∉ C2.GeneralBoundaryCandidates.candidateGains H N) :
    realGainSchur H N a ↔ realGainSchur H N b := by
  have hdegc : (N.map Complex.ofRealHom).natDegree < (H.map Complex.ofRealHom).natDegree := by
    simpa using hdeg
  have hfree : ∀ k ∈ Icc a b, C2.GeneralBoundary.BoundaryFree
      (C2.GeneralBoundary.gainPolynomial (H.map Complex.ofRealHom) (N.map Complex.ofRealHom) k) := by
    intro k hk
    apply (C2.GeneralBoundary.boundaryFree_iff_not_unitCircleRoot
      (H.map Complex.ofRealHom) (N.map Complex.ofRealHom) k).mpr
    intro hu
    have hu' : C2.UnitCircleRoot (C2.GeneralBoundaryCandidates.evalC H)
        (C2.GeneralBoundaryCandidates.evalC N) k := by
      simpa only [C2.UnitCircleRoot,evalC_eq_mapped_eval] using hu
    exact hno k hk ((C2.GeneralBoundaryCandidates.unitCircleRoot_iff_candidate
      (ha.trans_le hk.1) hcommon).mp hu')
  exact C2.GeneralBoundary.schur_constant_on_preconnected
    (H.map Complex.ofRealHom) (N.map Complex.ofRealHom) hdegc isPreconnected_Icc hfree
    (left_mem_Icc.mpr hab) (right_mem_Icc.mpr hab)

/-- Full zero-connected-margin proposition, including nonemptiness of the
candidate set, its least element, the exact initial stable interval, failure
of strict stability at the boundary, and the supremum characterization. -/
theorem general_first_margin {H N : ℝ[X]} (hN : N ≠ 0)
    (hdeg : N.natDegree < H.natDegree)
    (hQ : C2.GeneralBoundaryCandidates.Q H N ≠ 0)
    (hcommon : ∀ z : ℂ, ‖z‖=1 →
      C2.GeneralBoundaryCandidates.evalC N z=0 → C2.GeneralBoundaryCandidates.evalC H z≠0)
    (hsmall : ∃ ε : ℝ, 0 < ε ∧ ∀ k : ℝ, 0 < k → k < ε → realGainSchur H N k) :
    (C2.GeneralBoundaryCandidates.candidateGains H N).Nonempty ∧
    ∃ c : ℝ, IsLeast (C2.GeneralBoundaryCandidates.candidateGains H N) c ∧ 0 < c ∧
      (∀ k : ℝ, 0 < k → k < c → realGainSchur H N k) ∧ ¬realGainSchur H N c ∧
      IsGreatest (initialIntervalEndpoints (realGainSchur H N)) c ∧
      initialIntervalEndpoints (realGainSchur H N) = Ioc 0 c ∧
      sSup (initialIntervalEndpoints (realGainSchur H N)) = c := by
  have hfinite := C2.GeneralBoundaryCandidates.candidateGains_finite hQ
  have hbound := realGainSchur_bounded hN hdeg
  have htransport := realGainSchur_interval_transport hdeg hcommon
  refine ⟨first_boundary_nonempty hsmall hbound htransport,?_⟩
  exact finite_first_boundary_margin hfinite (fun _ hk => hk.1)
    (fun _ hk => realGainSchur_not_at_candidate hcommon hk) hsmall hbound htransport

end C2.GeneralCompletion

end

/- ===== C2.GeneralCompletionSmallGain ===== -/

/-!
# A quantitative small-gain theorem for a Schur-stable denominator

This proves the strictly stable branch of `prop:general-small-gain` without
an assumption of root continuity. The simple-integrator branch is not claimed.
-/

noncomputable section
open Polynomial Finset
namespace C2.GeneralCompletion

def coefficientNormSum (p : Polynomial ℂ) : ℝ :=
  ∑ i ∈ Finset.range (p.natDegree + 1), ‖p.coeff i‖

theorem coefficientNormSum_nonneg (p : Polynomial ℂ) : 0 ≤ coefficientNormSum p := by
  exact Finset.sum_nonneg (fun i _ => norm_nonneg _)

/-- Outside the open unit disk, polynomial growth is bounded by its
coefficient norm sum and any exponent above its degree. -/
theorem eval_norm_le_coefficientNormSum {p : Polynomial ℂ} {L : ℕ}
    (hd : p.natDegree ≤ L) {z : ℂ} (hz : 1 ≤ ‖z‖) :
    ‖p.eval z‖ ≤ coefficientNormSum p * ‖z‖ ^ L := by
  rw [eval_eq_sum_range]
  calc
    _ ≤ ∑ i ∈ Finset.range (p.natDegree + 1), ‖p.coeff i * z^i‖ := norm_sum_le _ _
    _ = ∑ i ∈ Finset.range (p.natDegree + 1), ‖p.coeff i‖ * ‖z‖^i := by simp
    _ ≤ ∑ i ∈ Finset.range (p.natDegree + 1), ‖p.coeff i‖ * ‖z‖^L := by
      apply Finset.sum_le_sum
      intro i hi
      gcongr
      · exact hz
      · exact (Nat.le_of_lt_succ (Finset.mem_range.mp hi)).trans hd
    _ = _ := by rw [← Finset.sum_mul]; rfl

/-- A positive radial gap is supplied by every factor of a Schur polynomial. -/
theorem multiset_radial_gap {s : Multiset ℂ}
    (hs : ∀ a ∈ s, ‖a‖ < 1) {z : ℂ} (hz : 1 ≤ ‖z‖) :
    0 < (s.map (fun a => 1 - ‖a‖)).prod ∧
    (s.map (fun a => 1 - ‖a‖)).prod * ‖z‖^s.card ≤
      ‖(s.map (fun a => z-a)).prod‖ := by
  induction s using Multiset.induction_on with
  | empty => simp
  | @cons a s ih =>
    have ha := hs a (Multiset.mem_cons_self _ _)
    obtain ⟨hpos, hbound⟩ := ih (fun b hb => hs b (Multiset.mem_cons_of_mem hb))
    have hfactor : (1 - ‖a‖) * ‖z‖ ≤ ‖z-a‖ := by
      have hnorm := norm_sub_norm_le z a
      have hprod : ‖a‖ ≤ ‖a‖ * ‖z‖ := by nlinarith [norm_nonneg a]
      nlinarith
    simp only [Multiset.map_cons, Multiset.prod_cons, Multiset.card_cons, norm_mul]
    constructor
    · exact mul_pos (sub_pos.mpr ha) hpos
    · calc
        (1 - ‖a‖) * (s.map (fun a => 1 - ‖a‖)).prod * ‖z‖^(s.card+1) =
            ((1 - ‖a‖)*‖z‖) * ((s.map (fun a => 1 - ‖a‖)).prod * ‖z‖^s.card) := by
              rw [pow_succ]; ring
        _ ≤ ‖z-a‖ * ‖(s.map (fun a => z-a)).prod‖ := by
          exact mul_le_mul hfactor hbound (by positivity) (norm_nonneg _)

/-- The explicit positive gap coefficient of a nonzero Schur polynomial. -/
def radialGap (p : Polynomial ℂ) : ℝ :=
  ‖p.leadingCoeff‖ * (p.roots.map (fun a => 1 - ‖a‖)).prod

theorem radialGap_pos {p : Polynomial ℂ} (hp : p ≠ 0)
    (hs : ∀ z : ℂ, p.eval z = 0 → ‖z‖ < 1) : 0 < radialGap p := by
  have hr : ∀ z ∈ p.roots, ‖z‖ < 1 := fun z hz => hs z (isRoot_of_mem_roots hz)
  have h := (multiset_radial_gap hr (z := (1 : ℂ)) (by simp)).1
  exact mul_pos (norm_pos_iff.mpr (leadingCoeff_ne_zero.mpr hp)) h

theorem radialGap_eval_lower_bound {p : Polynomial ℂ}
    (hs : ∀ z : ℂ, p.eval z = 0 → ‖z‖ < 1)
    {z : ℂ} (hz : 1 ≤ ‖z‖) :
    radialGap p * ‖z‖^p.natDegree ≤ ‖p.eval z‖ := by
  have hr : ∀ z ∈ p.roots, ‖z‖ < 1 := fun z hz => hs z (isRoot_of_mem_roots hz)
  have h := (multiset_radial_gap hr hz).2
  have hcard : p.roots.card = p.natDegree := by
    simpa using (natDegree_eq_card_roots (IsAlgClosed.splits p)).symm
  rw [hcard] at h
  rw [eval_eq_prod_roots_sub_of_splits_id (IsAlgClosed.splits p), norm_mul]
  simpa only [radialGap, mul_assoc] using
    mul_le_mul_of_nonneg_left h (norm_nonneg p.leadingCoeff)

/-- Explicit perturbation radius; every complex feedback coefficient within
this radius preserves strict stability. -/
theorem small_gain_schur {H N : Polynomial ℂ} (hH : H ≠ 0)
    (hstable : ∀ z : ℂ, H.eval z = 0 → ‖z‖ < 1)
    (hdegree : N.natDegree ≤ H.natDegree) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ k : ℂ, ‖k‖ < ε →
      ∀ z : ℂ, (H + Polynomial.C k * N).eval z = 0 → ‖z‖ < 1 := by
  let ε := radialGap H / (coefficientNormSum N + 1)
  have hg := radialGap_pos hH hstable
  have hc := coefficientNormSum_nonneg N
  have he : 0 < coefficientNormSum N + 1 := by linarith
  refine ⟨ε, div_pos hg he, ?_⟩
  intro k hk z hz
  by_contra hbad
  have hzn : 1 ≤ ‖z‖ := le_of_not_gt hbad
  have hpow : 0 < ‖z‖^H.natDegree := pow_pos (by linarith) _
  have hlo := radialGap_eval_lower_bound hstable hzn
  have hup := eval_norm_le_coefficientNormSum hdegree hzn
  have heq : H.eval z = -(k*N.eval z) := by
    simpa only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
      add_eq_zero_iff_eq_neg] using hz
  rw [heq, norm_neg, norm_mul] at hlo
  have hmul := mul_le_mul_of_nonneg_left hup (norm_nonneg k)
  have hless : ‖k‖ * (coefficientNormSum N + 1) < radialGap H :=
    (lt_div_iff₀ he).mp hk
  have hstrict : ‖k‖ * coefficientNormSum N < radialGap H := by
    nlinarith [norm_nonneg k]
  have hfinal := mul_lt_mul_of_pos_right hstrict hpow
  nlinarith

/-- The strictly stable-denominator clause of the manuscript, for every
integer delay. The conclusion includes a quantitative two-sided gain
neighborhood, so in particular all sufficiently small positive gains. -/
theorem delayed_small_positive_gains {D N : Polynomial ℝ} (m : ℕ)
    (hD : D ≠ 0) (hdegree : N.natDegree ≤ D.natDegree)
    (hstable : ∀ z : ℂ, (D.map Complex.ofRealHom).eval z = 0 → ‖z‖ < 1) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ k : ℝ, |k| < ε →
      ∀ z : ℂ, ((Polynomial.X^m*D + Polynomial.C k*N).map
        Complex.ofRealHom).eval z = 0 → ‖z‖ < 1 := by
  let H : Polynomial ℂ := Polynomial.X^m * D.map Complex.ofRealHom
  have hDc : D.map Complex.ofRealHom ≠ 0 := by simpa using hD
  have hH : H ≠ 0 := mul_ne_zero (pow_ne_zero m Polynomial.X_ne_zero) hDc
  have hHs : ∀ z : ℂ, H.eval z = 0 → ‖z‖ < 1 := by
    intro z hz
    have hz' : z^m * (D.map Complex.ofRealHom).eval z = 0 := by
      simpa [H] using hz
    by_cases hz0 : z = 0
    · simp [hz0]
    · exact hstable z ((mul_eq_zero.mp hz').resolve_left (pow_ne_zero m hz0))
  have hdeg : (N.map Complex.ofRealHom).natDegree ≤ H.natDegree := by
    dsimp [H]
    rw [natDegree_X_pow_mul m hDc]
    simpa using hdegree.trans (Nat.le_add_right D.natDegree m)
  obtain ⟨ε, hε, hs⟩ := small_gain_schur hH hHs hdeg
  refine ⟨ε, hε, ?_⟩
  intro k hk z hz
  apply hs (k : ℂ) (by simpa using hk) z
  simpa [H] using hz

end C2.GeneralCompletion

end

/- ===== C2.GeneralCompletionIntegrator ===== -/

/-! The simple-integrator small-gain stability theorem.  Every possible
exterior root is excluded quantitatively; no root-continuity theorem or
chosen root branch is assumed. -/
noncomputable section
set_option maxHeartbeats 1200000
open Polynomial
namespace C2.GeneralCompletion

theorem polynomial_expansion_at_one (p : Polynomial ℂ) :
    ∃ q : Polynomial ℂ, ∀ z : ℂ, p.eval z = p.eval 1 + (z-1)*q.eval z := by
  have hd : (Polynomial.X - Polynomial.C (1 : ℂ)) ∣ (p-Polynomial.C (p.eval 1)) := by
    apply dvd_iff_isRoot.mpr
    simp
  obtain ⟨q,hq⟩ := hd
  refine ⟨q, ?_⟩
  intro z
  have h := congrArg (Polynomial.eval z) hq
  simp only [Polynomial.eval_sub, Polynomial.eval_C, Polynomial.eval_mul,
    Polynomial.eval_X] at h
  linear_combination h

theorem polynomial_norm_le_on_two {p : Polynomial ℂ} {z : ℂ}
    (hz : 1 ≤ ‖z‖) (hz2 : ‖z‖ ≤ 2) :
    ‖p.eval z‖ ≤ coefficientNormSum p * 2^p.natDegree := by
  apply (eval_norm_le_coefficientNormSum le_rfl hz).trans
  apply mul_le_mul_of_nonneg_left _ (coefficientNormSum_nonneg p)
  exact pow_le_pow_left₀ (norm_nonneg z) hz2 _

/-- A simple pole at one with positive feedback residue moves into the disk,
and every remaining pole remains strictly inside it. The conclusion is about
all actual complex roots, including their multiplicities. -/
theorem simple_integrator_small_positive_gains {Q N : Polynomial ℂ}
    (hQ : Q ≠ 0)
    (hstable : ∀ z : ℂ, Q.eval z = 0 → ‖z‖ < 1)
    (hdegree : N.natDegree ≤ Q.natDegree+1)
    {c : ℝ} (hc : 0 < c) (hratio : N.eval 1 = (c : ℂ)*Q.eval 1) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ k : ℝ, 0 < k → k < ε →
      ∀ z : ℂ, ((Polynomial.X-1)*Q+Polynomial.C (k : ℂ)*N).eval z = 0 → ‖z‖ < 1 := by
  obtain ⟨S,hS⟩ := polynomial_expansion_at_one Q
  obtain ⟨R,hR⟩ := polynomial_expansion_at_one N
  have hQ1 : Q.eval 1 ≠ 0 := by
    intro hz
    have h := hstable 1 hz
    simpa using h
  have hQ1p : 0 < ‖Q.eval 1‖ := norm_pos_iff.mpr hQ1
  let g := radialGap Q
  let C := coefficientNormSum N+1
  let α := 2*C/g
  let CS := coefficientNormSum S*2^S.natDegree
  let CR := coefficientNormSum R*2^R.natDegree
  let B := (α^2*CS+α*CR)/‖Q.eval 1‖
  let D := 2*B+α^2+1
  have hg : 0 < g := radialGap_pos hQ hstable
  have hCN := coefficientNormSum_nonneg N
  have hC : 0 < C := by dsimp [C]; linarith
  have hα : 0 < α := by dsimp [α]; positivity
  have hCS : 0 ≤ CS := mul_nonneg (coefficientNormSum_nonneg S) (by positivity)
  have hCR : 0 ≤ CR := mul_nonneg (coefficientNormSum_nonneg R) (by positivity)
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hD : 0 < D := by dsimp [D]; positivity
  have hαg : α*g = 2*C := by dsimp [α]; field_simp [hg.ne']
  have hBQ : B*‖Q.eval 1‖ = α^2*CS+α*CR := by
    dsimp [B]
    exact div_mul_cancel₀ _ hQ1p.ne'
  refine ⟨min (g/(2*C)) (c/D), lt_min (by positivity) (by positivity), ?_⟩
  intro k hk hsmall z hroot
  by_contra hbad
  have hz : 1 ≤ ‖z‖ := le_of_not_gt hbad
  have hk1 : k < g/(2*C) := hsmall.trans_le (min_le_left _ _)
  have hk2 : k < c/D := hsmall.trans_le (min_le_right _ _)
  have hkg : 2*k*C < g := by
    have h := (lt_div_iff₀ (show 0 < 2*C by positivity)).mp hk1
    nlinarith
  have hαk : α*k < 1 := by
    apply (mul_lt_mul_right hg).mp
    calc
      α*k*g = k*(α*g) := by ring
      _ = 2*k*C := by rw [hαg]; ring
      _ < g := hkg
      _ = 1*g := by ring
  let w := z-1
  have heq : w*Q.eval z + (k : ℂ)*N.eval z = 0 := by
    simpa only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_sub,
      Polynomial.eval_X, Polynomial.eval_one, Polynomial.eval_C] using hroot
  have hnormeq : ‖w‖*‖Q.eval z‖ = k*‖N.eval z‖ := by
    have h := congrArg norm (add_eq_zero_iff_eq_neg.mp heq)
    simpa only [norm_mul,norm_neg,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hk] using h
  have hQlo := radialGap_eval_lower_bound hstable hz
  have hNup := eval_norm_le_coefficientNormSum hdegree hz
  have hzpow : 0 < ‖z‖^Q.natDegree := pow_pos (by linarith) _
  have hbasic : g*‖w‖ ≤ k*C*‖z‖ := by
    apply (mul_le_mul_right hzpow).mp
    have hC' : coefficientNormSum N ≤ C := by dsimp [C]; linarith
    calc
      g*‖w‖*‖z‖^Q.natDegree = ‖w‖*(g*‖z‖^Q.natDegree) := by ring
      _ ≤ ‖w‖*‖Q.eval z‖ := mul_le_mul_of_nonneg_left hQlo (norm_nonneg w)
      _ = k*‖N.eval z‖ := hnormeq
      _ ≤ k*(coefficientNormSum N*‖z‖^(Q.natDegree+1)) :=
        mul_le_mul_of_nonneg_left hNup hk.le
      _ ≤ k*(C*‖z‖^(Q.natDegree+1)) := by gcongr
      _ = (k*C*‖z‖)*‖z‖^Q.natDegree := by rw [pow_succ]; ring
  have hzw : ‖z‖ ≤ ‖w‖+1 := by
    have h := norm_sub_norm_le z (1 : ℂ)
    simp only [norm_one] at h
    change ‖z‖-1 ≤ ‖w‖ at h
    linarith
  have hw : ‖w‖ ≤ α*k := by
    apply (mul_le_mul_right hg).mp
    have hnon : 0 ≤ (g-2*k*C)*‖w‖ := mul_nonneg (by linarith) (norm_nonneg _)
    have hsub : k*C*‖z‖ ≤ k*C*(‖w‖+1) :=
      mul_le_mul_of_nonneg_left hzw (by positivity)
    have he : α*k*g = 2*k*C := by calc
      _ = k*(α*g) := by ring
      _ = _ := by rw [hαg]; ring
    rw [he]
    nlinarith
  have hz2 : ‖z‖ ≤ 2 := by linarith
  have hSbound : ‖S.eval z‖ ≤ CS := polynomial_norm_le_on_two hz hz2
  have hRbound : ‖R.eval z‖ ≤ CR := polynomial_norm_le_on_two hz hz2
  have hres : (w+(k*c : ℝ))*Q.eval 1 =
      -(w^2*S.eval z + (k : ℂ)*w*R.eval z) := by
    rw [hS z, hR z, hratio] at heq
    change w*(Q.eval 1+w*S.eval z)+(k : ℂ)*((c : ℂ)*Q.eval 1+w*R.eval z)=0 at heq
    push_cast
    linear_combination heq
  have hresnorm : ‖w+(k*c : ℝ)‖ ≤ B*k^2 := by
    apply (mul_le_mul_right hQ1p).mp
    have hnorm := congrArg norm hres
    simp only [norm_mul,norm_neg] at hnorm
    calc
      _ = ‖w^2*S.eval z+(k : ℂ)*w*R.eval z‖ := hnorm
      _ ≤ ‖w^2*S.eval z‖+‖(k : ℂ)*w*R.eval z‖ := norm_add_le _ _
      _ = ‖w‖^2*‖S.eval z‖+k*‖w‖*‖R.eval z‖ := by
        simp [norm_mul,norm_pow,abs_of_pos hk]
      _ ≤ (α*k)^2*CS+k*(α*k)*CR := by gcongr
      _ = (α^2*CS+α*CR)*k^2 := by ring
      _ = (B*k^2)*‖Q.eval 1‖ := by rw [← hBQ]; ring
  have hre : w.re+k*c ≤ B*k^2 := by
    have h := (Complex.re_le_norm (w+(k*c : ℝ))).trans hresnorm
    simpa using h
  have hw2 : ‖w‖^2 ≤ (α*k)^2 := by gcongr
  have hid : ‖z‖^2 = 1+2*w.re+‖w‖^2 := by
    simp only [w,Complex.sq_norm,Complex.normSq_sub,Complex.normSq_one,
      map_one,mul_one,Complex.sub_re,Complex.one_re]
    ring
  have hkD : k*D < c := (lt_div_iff₀ hD).mp hk2
  have hkDk := mul_lt_mul_of_pos_right hkD hk
  dsimp [D] at hkDk
  nlinarith [mul_pos hk hc]

theorem simple_root_small_positive_gains {H N : Polynomial ℂ}
    (hH0 : H.eval 1 = 0) (hHd : H.derivative.eval 1 ≠ 0)
    (hstable : ∀ z : ℂ, H.eval z = 0 → z ≠ 1 → ‖z‖ < 1)
    (hdegree : N.natDegree ≤ H.natDegree)
    {c : ℝ} (hc : 0 < c) (hratio : N.eval 1 = (c : ℂ)*H.derivative.eval 1) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ k : ℝ, 0 < k → k < ε →
      ∀ z : ℂ, (H+Polynomial.C (k : ℂ)*N).eval z = 0 → ‖z‖ < 1 := by
  have hd : (Polynomial.X-Polynomial.C (1 : ℂ)) ∣ H := dvd_iff_isRoot.mpr hH0
  obtain ⟨Q,hQ⟩ := hd
  have hQne : Q ≠ 0 := by
    intro hq
    apply hHd
    simp [hQ,hq]
  have hder : H.derivative.eval 1 = Q.eval 1 := by
    rw [hQ]
    simp [Polynomial.derivative_mul]
  have hQstable : ∀ z : ℂ, Q.eval z = 0 → ‖z‖ < 1 := by
    intro z hz
    apply hstable z
    · simp [hQ,hz]
    · intro hz1
      apply hHd
      simpa [hz1, hder] using hz
  have hdegH : H.natDegree = Q.natDegree+1 := by
    rw [hQ,natDegree_mul (monic_X_sub_C 1).ne_zero hQne,natDegree_X_sub_C]
    omega
  rw [hdegH] at hdegree
  rw [hder] at hratio
  obtain ⟨ε,hε,hs⟩ := simple_integrator_small_positive_gains hQne hQstable hdegree hc hratio
  refine ⟨ε,hε,?_⟩
  intro k hk hkε z hz
  apply hs k hk hkε z
  simpa [hQ] using hz

theorem real_simple_root_small_positive_gains {H N : Polynomial ℝ}
    (hH0 : H.eval 1 = 0) (hHd : H.derivative.eval 1 ≠ 0)
    (hstable : ∀ z : ℂ, (H.map Complex.ofRealHom).eval z = 0 → z ≠ 1 → ‖z‖ < 1)
    (hdegree : N.natDegree ≤ H.natDegree)
    (hratio : 0 < N.eval 1/H.derivative.eval 1) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ k : ℝ, 0 < k → k < ε →
      ∀ z : ℂ, ((H+Polynomial.C k*N).map Complex.ofRealHom).eval z = 0 → ‖z‖ < 1 := by
  have hH0c : (H.map Complex.ofRealHom).eval 1 = 0 := by
    simp [Polynomial.eval_map,hH0]
  have hHdc : (H.map Complex.ofRealHom).derivative.eval 1 ≠ 0 := by
    simpa using hHd
  have hdegc : (N.map Complex.ofRealHom).natDegree ≤ (H.map Complex.ofRealHom).natDegree := by
    simpa using hdegree
  have hrc : (N.map Complex.ofRealHom).eval 1 =
      ((N.eval 1/H.derivative.eval 1 : ℝ) : ℂ)*(H.map Complex.ofRealHom).derivative.eval 1 := by
    simp only [Polynomial.derivative_map,Polynomial.eval_map,Polynomial.eval₂_at_one,
      Complex.ofRealHom_eq_coe]
    exact_mod_cast (div_mul_cancel₀ (N.eval 1) hHd).symm
  obtain ⟨ε,hε,hs⟩ := simple_root_small_positive_gains hH0c hHdc hstable hdegc hratio hrc
  refine ⟨ε,hε,?_⟩
  intro k hk hkε z hz
  apply hs k hk hkε z
  simpa using hz

end C2.GeneralCompletion

end

/- ===== C2.GeneralCompletionTransformDerivative ===== -/

/-! Exact value and derivative at the transformed simple integrator pole. -/
noncomputable section
open Polynomial Finset
namespace C2.GeneralCompletion

/-- The simple-zero hypotheses used below are exactly the manuscript's
factorization A(s)=s*A0(s), A0(0)≠0. -/
theorem simple_origin_iff_integrator_factor (A : Polynomial ℝ) :
    (A.eval 0 = 0 ∧ A.derivative.eval 0 ≠ 0) ↔
      ∃ A₀ : Polynomial ℝ, A = Polynomial.X*A₀ ∧ A₀.eval 0 ≠ 0 := by
  constructor
  · rintro ⟨hA0,hAd⟩
    have hx : Polynomial.X ∣ A := by
      simpa using (dvd_iff_isRoot.mpr hA0 : (Polynomial.X-Polynomial.C (0 : ℝ)) ∣ A)
    obtain ⟨A₀,hA₀⟩ := hx
    refine ⟨A₀,hA₀,?_⟩
    simpa [hA₀,Polynomial.derivative_mul] using hAd
  · rintro ⟨A₀,rfl,hA₀⟩
    simpa [Polynomial.derivative_mul] using hA₀

theorem theta_transform_eval_one (p : Polynomial ℝ) (d : ℕ) (T γ : ℝ) :
    (C2.commonDegreeTransform p d (C2.thetaScale T γ) C2.thetaNumerator).eval 1 =
      T^d*p.eval 0 := by
  rw [C2.commonDegreeTransform_eval]
  have hU : (C2.thetaScale T γ).eval 1 = T := by simp [C2.thetaScale]
  have hV : (C2.thetaNumerator : Polynomial ℝ).eval 1 = 0 := by simp [C2.thetaNumerator]
  rw [hU,hV]
  rw [Finset.sum_eq_single 0]
  · simp [mul_comm,Polynomial.coeff_zero_eq_eval_zero]
  · intro j hj hj0
    simp [zero_pow hj0]
  · simp

theorem theta_transform_derivative_at_integrator
    (A : Polynomial ℝ) (d : ℕ) (T γ : ℝ) (hd : 1 ≤ d) (hA0 : A.eval 0 = 0) :
    (C2.commonDegreeTransform A d (C2.thetaScale T γ) C2.thetaNumerator).derivative.eval 1 =
      T^(d-1)*A.derivative.eval 0 := by
  have hcoeff0 : A.coeff 0 = 0 := (Polynomial.coeff_zero_eq_eval_zero A).trans hA0
  have hU : (C2.thetaScale T γ).eval 1 = T := by simp [C2.thetaScale]
  have hV : (C2.thetaNumerator : Polynomial ℝ).eval 1 = 0 := by simp [C2.thetaNumerator]
  have hV' : (C2.thetaNumerator : Polynomial ℝ).derivative.eval 1 = 1 := by
    simp [C2.thetaNumerator]
  unfold C2.commonDegreeTransform
  rw [Polynomial.derivative_sum,Polynomial.eval_finset_sum]
  rw [Finset.sum_eq_single 1]
  · simp [Polynomial.derivative_mul,Polynomial.derivative_pow,hU,hV,hV',mul_comm,
      ← Polynomial.coeff_zero_eq_eval_zero,Polynomial.coeff_derivative]
  · intro j hj hj1
    by_cases hj0 : j = 0
    · simp [hj0,hcoeff0]
    · have hjpred : j-1 ≠ 0 := by omega
      simp [Polynomial.derivative_mul,Polynomial.derivative_pow,hU,hV,hV',
        hj0,hjpred]
  · intro hnot
    exact False.elim (hnot (Finset.mem_range.mpr (by omega)))

theorem theta_integrator_residue
    (A B : Polynomial ℝ) (d : ℕ) (T γ : ℝ) (hd : 1 ≤ d)
    (hT : T ≠ 0) (hA0 : A.eval 0 = 0) (hA' : A.derivative.eval 0 ≠ 0) :
    (C2.commonDegreeTransform B d (C2.thetaScale T γ) C2.thetaNumerator).eval 1 /
      (C2.commonDegreeTransform A d (C2.thetaScale T γ) C2.thetaNumerator).derivative.eval 1 =
      T*(B.eval 0/A.derivative.eval 0) := by
  rw [theta_transform_eval_one,theta_transform_derivative_at_integrator A d T γ hd hA0]
  have hpow : T^d = T^(d-1)*T := by
    rw [← pow_succ]
    congr 1
    omega
  rw [hpow]
  field_simp
  <;> ring

theorem delayed_integrator_derivative_one (D : Polynomial ℝ) (m : ℕ)
    (hD0 : D.eval 1 = 0) :
    (Polynomial.X^m*D).derivative.eval 1 = D.derivative.eval 1 := by
  simp [Polynomial.derivative_mul,Polynomial.derivative_pow,hD0]

end C2.GeneralCompletion

end

/- ===== C2.GeneralCompletionLocalRoot ===== -/

/-! A genuine local real root branch of H(z)+k N(z), with its derivative
and a uniform quadratic remainder. No root branch or remainder is assumed. -/

noncomputable section
open Polynomial Filter Asymptotics
open scoped Topology
namespace C2.GeneralCompletion

theorem exists_local_real_root_branch (H N : ℝ[X])
    (hH : H.eval 1 = 0) (hD : H.derivative.eval 1 ≠ 0) (hN : N.eval 1 ≠ 0) :
    ∃ z : ℝ → ℝ, z 0 = 1 ∧
      HasDerivAt z (-N.eval 1 / H.derivative.eval 1) 0 ∧
      ∀ᶠ k in 𝓝 (0:ℝ), H.eval (z k) + k*N.eval (z k) = 0 := by
  let F : ℝ → ℝ := fun x => -H.eval x / N.eval x
  let d : ℝ := -H.derivative.eval 1 / N.eval 1
  have hd : d ≠ 0 := div_ne_zero (neg_ne_zero.mpr hD) hN
  have hF0 : F 1 = 0 := by simp [F,hH]
  have hf : HasStrictDerivAt F d 1 := by
    convert (H.hasStrictDerivAt (1:ℝ)).neg.div (N.hasStrictDerivAt 1) hN using 1
    dsimp [d]
    rw [hH]
    field_simp [hN]
    <;> ring
  let z : ℝ → ℝ := hf.localInverse F d 1 hd
  let hFE := hf.hasStrictFDerivAt_equiv hd
  have hz0 : z 0 = 1 := by
    simpa only [z,hF0] using hFE.localInverse_apply_image
  have hzder : HasDerivAt z (-N.eval 1 / H.derivative.eval 1) 0 := by
    have h := (hf.to_localInverse hd).hasDerivAt
    rw [hF0] at h
    convert h using 1
    dsimp [d]
    field_simp [hD,hN]
  have hzt : Tendsto z (𝓝 0) (𝓝 1) := by
    simpa only [ContinuousAt,hz0] using hzder.continuousAt
  have hInv : ∀ᶠ k in 𝓝 (0:ℝ), F (z k) = k := by
    simpa only [z,hF0] using hFE.eventually_right_inverse
  have hNnear : ∀ᶠ k in 𝓝 (0:ℝ), N.eval (z k) ≠ 0 :=
    hzt ((N.continuous.continuousAt).eventually_ne hN)
  refine ⟨z,hz0,hzder,?_⟩
  filter_upwards [hInv,hNnear] with k hk hNk
  dsimp [F] at hk
  have he := (div_eq_iff hNk).mp hk
  linarith

/-- The quadratic error follows from polynomial divisibility and one-point
first-order bounds: H=(X-1)Q and z-1=-k N(z)/Q(z). -/
theorem local_real_root_quadratic_error (H N : ℝ[X])
    (hH : H.eval 1 = 0) (hD : H.derivative.eval 1 ≠ 0)
    {z : ℝ → ℝ} (hz0 : z 0 = 1)
    (hzder : HasDerivAt z (-N.eval 1 / H.derivative.eval 1) 0)
    (hroot : ∀ᶠ k in 𝓝 (0:ℝ), H.eval (z k) + k*N.eval (z k) = 0) :
    (fun k => z k - (1-k*N.eval 1/H.derivative.eval 1)) =O[𝓝 (0:ℝ)]
      (fun k => k^2) := by
  obtain ⟨Q,hQ⟩ := (Polynomial.dvd_iff_isRoot (p:=H) (a:=(1:ℝ))).mpr hH
  have hQone : Q.eval 1 = H.derivative.eval 1 := by
    rw [hQ,Polynomial.derivative_mul]
    simp
  have hQ1 : Q.eval 1 ≠ 0 := by rw [hQone]; exact hD
  let R : ℝ → ℝ := fun x => N.eval x / Q.eval x
  have hRdiff := (N.hasDerivAt (1:ℝ)).div (Q.hasDerivAt 1) hQ1
  have hRO : (fun x => R x - R 1) =O[𝓝 (1:ℝ)] (fun x => x-1) :=
    hRdiff.isBigO_sub
  have hzt : Tendsto z (𝓝 0) (𝓝 1) := by
    simpa only [ContinuousAt,hz0] using hzder.continuousAt
  have hzO : (fun k => z k - 1) =O[𝓝 (0:ℝ)] (fun k => k) := by
    simpa only [hz0,sub_zero] using hzder.isBigO_sub
  have hROz : (fun k => R (z k) - R 1) =O[𝓝 (0:ℝ)] (fun k => z k - 1) := by
    simpa only [Function.comp_def] using hRO.comp_tendsto hzt
  have hprod := (isBigO_refl (fun k : ℝ => k) (𝓝 (0:ℝ))).mul (hROz.trans hzO)
  have hQnear : ∀ᶠ k in 𝓝 (0:ℝ), Q.eval (z k) ≠ 0 :=
    hzt ((Q.continuous.continuousAt).eventually_ne hQ1)
  apply hprod.neg_left.congr'
  · filter_upwards [hroot,hQnear] with k hk hQk
    have he : (z k - 1)*Q.eval (z k) + k*N.eval (z k) = 0 := by
      simpa only [hQ,Polynomial.eval_mul,Polynomial.eval_sub,Polynomial.eval_X,
        Polynomial.eval_C] using hk
    have hratio : z k - 1 = -k * R (z k) := by
      have hmul : (z k - 1)*Q.eval (z k) = -k*N.eval (z k) := by linarith
      have heq := (eq_div_iff hQk).mpr hmul
      calc
        z k - 1 = (-k*N.eval (z k))/Q.eval (z k) := heq
        _ = -k * R (z k) := by dsimp [R]; ring
    have hR1 : R 1 = N.eval 1/H.derivative.eval 1 := by dsimp [R]; rw [hQone]
    rw [hR1]
    linear_combination -hratio
  · filter_upwards with k
    ring

/-- Complete local perturbation theorem with an explicit quantified O(k²)
remainder, obtained from the polynomial hypotheses alone. -/
theorem exists_local_real_root_branch_quadratic (H N : ℝ[X])
    (hH : H.eval 1 = 0) (hD : H.derivative.eval 1 ≠ 0) (hN : N.eval 1 ≠ 0) :
    ∃ (z : ℝ → ℝ) (C δ : ℝ), z 0 = 1 ∧
      HasDerivAt z (-N.eval 1/H.derivative.eval 1) 0 ∧ 0 < C ∧ 0 < δ ∧
      ∀ k : ℝ, |k| < δ → H.eval (z k)+k*N.eval (z k)=0 ∧
        |z k-(1-k*N.eval 1/H.derivative.eval 1)| ≤ C*k^2 := by
  obtain ⟨z,hz0,hzder,hroot⟩ := exists_local_real_root_branch H N hH hD hN
  obtain ⟨C,hC,hbound⟩ := (local_real_root_quadratic_error H N hH hD hz0 hzder hroot).exists_pos
  have hall : ∀ᶠ k in 𝓝 (0:ℝ), H.eval (z k)+k*N.eval (z k)=0 ∧
      |z k-(1-k*N.eval 1/H.derivative.eval 1)| ≤ C*k^2 := by
    filter_upwards [hroot,hbound.bound] with k hk hb
    refine ⟨hk,?_⟩
    simpa only [Real.norm_eq_abs,abs_sq] using hb
  obtain ⟨δ,hδ,hball⟩ := Metric.mem_nhds_iff.mp hall
  refine ⟨z,C,δ,hz0,hzder,hC,hδ,?_⟩
  intro k hk
  apply hball
  simpa only [Metric.mem_ball,Real.dist_eq,sub_zero] using hk

end C2.GeneralCompletion

end

/- ===== C2.GeneralCompletionIntegratorTransform ===== -/

/-! Exact specialization of the simple-root small-gain theorem to the common
theta substitution and an arbitrary integer delay. -/
noncomputable section
open Polynomial
namespace C2.GeneralCompletion

theorem delayed_integrator_small_positive_gains {D N : Polynomial ℝ} (m : ℕ)
    (hD0 : D.eval 1 = 0) (hDd : D.derivative.eval 1 ≠ 0)
    (hstable : ∀ z : ℂ, (D.map Complex.ofRealHom).eval z = 0 → z ≠ 1 → ‖z‖ < 1)
    (hdegree : N.natDegree ≤ D.natDegree)
    (hratio : 0 < N.eval 1/D.derivative.eval 1) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ k : ℝ, 0 < k → k < ε →
      ∀ z : ℂ, ((Polynomial.X^m*D+Polynomial.C k*N).map
        Complex.ofRealHom).eval z = 0 → ‖z‖ < 1 := by
  let H := Polynomial.X^m*D
  have hDne : D ≠ 0 := by intro he; simp [he] at hDd
  have hH0 : H.eval 1 = 0 := by simp [H,hD0]
  have hHder : H.derivative.eval 1 = D.derivative.eval 1 :=
    delayed_integrator_derivative_one D m hD0
  have hHd : H.derivative.eval 1 ≠ 0 := by rwa [hHder]
  have hHstable : ∀ z : ℂ, (H.map Complex.ofRealHom).eval z = 0 → z ≠ 1 → ‖z‖ < 1 := by
    intro z hz hz1
    by_cases hz0 : z = 0
    · simp [hz0]
    · apply hstable z _ hz1
      have he : z^m*(D.map Complex.ofRealHom).eval z = 0 := by simpa [H] using hz
      exact (mul_eq_zero.mp he).resolve_left (pow_ne_zero m hz0)
  have hdeg : N.natDegree ≤ H.natDegree := by
    dsimp [H]
    rw [natDegree_X_pow_mul m hDne]
    exact hdegree.trans (Nat.le_add_right _ _)
  have hratio' : 0 < N.eval 1/H.derivative.eval 1 := by rwa [hHder]
  exact real_simple_root_small_positive_gains hH0 hHd hHstable hdeg hratio'

/-- The simple-integrator clause under the manuscript's common-parameter
substitution. The residue is exactly T*B(0)/A'(0), including the pure delay. -/
theorem theta_integrator_small_positive_gains
    (A B : Polynomial ℝ) (d m : ℕ) (T γ : ℝ)
    (hd : 1 ≤ d) (hT : 0 < T) (hB : B.natDegree ≤ d)
    (hA0 : A.eval 0 = 0) (hAd : A.derivative.eval 0 ≠ 0)
    (hr : 0 < B.eval 0/A.derivative.eval 0)
    (htop : (C2.commonDegreeTransform A d (C2.thetaScale T γ)
      C2.thetaNumerator).coeff d ≠ 0)
    (hstable : ∀ z : ℂ,
      ((C2.commonDegreeTransform A d (C2.thetaScale T γ) C2.thetaNumerator).map
        Complex.ofRealHom).eval z = 0 → z ≠ 1 → ‖z‖ < 1) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ k : ℝ, 0 < k → k < ε →
      ∀ z : ℂ, ((Polynomial.X^m *
          C2.commonDegreeTransform A d (C2.thetaScale T γ) C2.thetaNumerator +
        Polynomial.C k * C2.commonDegreeTransform B d (C2.thetaScale T γ)
          C2.thetaNumerator).map Complex.ofRealHom).eval z = 0 → ‖z‖ < 1 := by
  let D := C2.commonDegreeTransform A d (C2.thetaScale T γ) C2.thetaNumerator
  let N := C2.commonDegreeTransform B d (C2.thetaScale T γ) C2.thetaNumerator
  have hD0 : D.eval 1 = 0 := by rw [theta_transform_eval_one,hA0,mul_zero]
  have hDd : D.derivative.eval 1 ≠ 0 := by
    rw [theta_transform_derivative_at_integrator A d T γ hd hA0]
    exact mul_ne_zero (pow_ne_zero _ hT.ne') hAd
  have hDdegree : D.natDegree = d :=
    natDegree_eq_of_le_of_coeff_ne_zero
      (C2.commonDegreeTransform_natDegree_le A d _ _
        (C2.thetaScale_natDegree_le T γ) C2.thetaNumerator_natDegree_le) htop
  have hNdegree : N.natDegree ≤ D.natDegree := by
    rw [hDdegree]
    exact C2.commonDegreeTransform_natDegree_le B d _ _
      (C2.thetaScale_natDegree_le T γ) C2.thetaNumerator_natDegree_le
  have hratio : 0 < N.eval 1/D.derivative.eval 1 := by
    rw [theta_integrator_residue A B d T γ hd hT.ne' hA0 hAd]
    exact mul_pos hT hr
  exact delayed_integrator_small_positive_gains m hD0 hDd hstable hNdegree hratio

/-- Complete simple-integrator clause: exact Schur stability of every mode,
the local real root and derivative, and a quantified quadratic remainder
with the manuscript's coefficient T*B(0)/A'(0). -/
theorem theta_integrator_small_gain_full
    (A B : Polynomial ℝ) (d m : ℕ) (T γ : ℝ)
    (hd : 1 ≤ d) (hT : 0 < T) (hB : B.natDegree ≤ d)
    (hA0 : A.eval 0 = 0) (hAd : A.derivative.eval 0 ≠ 0)
    (hr : 0 < B.eval 0/A.derivative.eval 0)
    (htop : (C2.commonDegreeTransform A d (C2.thetaScale T γ)
      C2.thetaNumerator).coeff d ≠ 0)
    (hstable : ∀ z : ℂ,
      ((C2.commonDegreeTransform A d (C2.thetaScale T γ) C2.thetaNumerator).map
        Complex.ofRealHom).eval z = 0 → z ≠ 1 → ‖z‖ < 1) :
    let D := C2.commonDegreeTransform A d (C2.thetaScale T γ) C2.thetaNumerator
    let N := C2.commonDegreeTransform B d (C2.thetaScale T γ) C2.thetaNumerator
    (∃ ε : ℝ, 0 < ε ∧ ∀ k : ℝ, 0 < k → k < ε →
      ∀ z : ℂ, ((Polynomial.X^m*D+Polynomial.C k*N).map
        Complex.ofRealHom).eval z = 0 → ‖z‖ < 1) ∧
    ∃ (z : ℝ → ℝ) (C δ : ℝ), z 0 = 1 ∧
      HasDerivAt z (-T*(B.eval 0/A.derivative.eval 0)) 0 ∧ 0 < C ∧ 0 < δ ∧
      ∀ k : ℝ, |k| < δ →
        (Polynomial.X^m*D).eval (z k)+k*N.eval (z k)=0 ∧
        |z k-(1-k*T*(B.eval 0/A.derivative.eval 0))| ≤ C*k^2 := by
  dsimp only
  constructor
  · exact theta_integrator_small_positive_gains A B d m T γ hd hT hB hA0 hAd hr htop hstable
  · let D := C2.commonDegreeTransform A d (C2.thetaScale T γ) C2.thetaNumerator
    let N := C2.commonDegreeTransform B d (C2.thetaScale T γ) C2.thetaNumerator
    let H := Polynomial.X^m*D
    have hD0 : D.eval 1 = 0 := by rw [theta_transform_eval_one,hA0,mul_zero]
    have hH0 : H.eval 1 = 0 := by simp [H,hD0]
    have hHder : H.derivative.eval 1 = T^(d-1)*A.derivative.eval 0 := by
      rw [delayed_integrator_derivative_one D m hD0,
        theta_transform_derivative_at_integrator A d T γ hd hA0]
    have hHd : H.derivative.eval 1 ≠ 0 := by
      rw [hHder]
      exact mul_ne_zero (pow_ne_zero _ hT.ne') hAd
    have hB0 : B.eval 0 ≠ 0 := by intro he; simp [he] at hr
    have hN1 : N.eval 1 ≠ 0 := by
      rw [theta_transform_eval_one]
      exact mul_ne_zero (pow_ne_zero _ hT.ne') hB0
    have hres : N.eval 1/H.derivative.eval 1 = T*(B.eval 0/A.derivative.eval 0) := by
      rw [delayed_integrator_derivative_one D m hD0]
      exact theta_integrator_residue A B d T γ hd hT.ne' hA0 hAd
    obtain ⟨z,C,δ,hz0,hzder,hC,hδ,hz⟩ :=
      exists_local_real_root_branch_quadratic H N hH0 hHd hN1
    have hder : -N.eval 1/H.derivative.eval 1 = -T*(B.eval 0/A.derivative.eval 0) := by
      rw [neg_div,hres]
      ring
    rw [hder] at hzder
    refine ⟨z,C,δ,hz0,hzder,hC,hδ,?_⟩
    intro k hk
    obtain ⟨hroot,herr⟩ := hz k hk
    refine ⟨hroot,?_⟩
    have he : 1-k*N.eval 1/H.derivative.eval 1 =
        1-k*T*(B.eval 0/A.derivative.eval 0) := by
      rw [mul_div_assoc,hres]
      ring
    rwa [he] at herr

end C2.GeneralCompletion

end

/- ===== C2.NGammaRealization ===== -/

/-! # State-realization algebra for independently weighted discretizations

These identities retain the chosen state realization.  Gamma is an actual
matrix, so the algebra also proves the similarity-coordinate qualification.
-/

noncomputable section
namespace C2.NGamma.Realization
open Matrix
variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {𝕜 : Type*} [Field 𝕜]

def E (T : 𝕜) (Γ A : Matrix ι ι 𝕜) := 1 - T • (Γ*A)
def F (T : 𝕜) (Γ A : Matrix ι ι 𝕜) := 1 + T • ((1-Γ)*A)
def Q (Γ : Matrix ι ι 𝕜) (z : 𝕜) := 1-Γ+z • Γ
def M (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (z : 𝕜) := z • E T Γ A - F T Γ A

theorem pencil_identity (T z : 𝕜) (Γ A : Matrix ι ι 𝕜) :
    M T Γ A z = (z-1) • (1 : Matrix ι ι 𝕜) - T • (Q Γ z * A) := by
  simp only [M, E, F, Q, smul_sub, smul_add, sub_smul, one_smul,
    Matrix.add_mul, Matrix.sub_mul, Matrix.one_mul, Matrix.smul_mul,
    smul_smul]
  rw [mul_comm T z]
  abel

/-- Exact transform equation obtained by collecting the current and previous
 state terms. -/
theorem transform_equation (T z u : 𝕜) (Γ A : Matrix ι ι 𝕜) (B x : ι → 𝕜) :
    (z-1) • x = T • (Q Γ z *ᵥ (A *ᵥ x + u • B)) ↔
      M T Γ A z *ᵥ x = (T*u) • (Q Γ z *ᵥ B) := by
  rw [pencil_identity]
  simp only [Matrix.sub_mulVec, Matrix.smul_mulVec_assoc, Matrix.one_mulVec,
    ← Matrix.mulVec_mulVec, Matrix.mulVec_add, Matrix.mulVec_smul, smul_add,
    smul_smul]
  constructor <;> intro h <;> apply_fun (fun v : ι → 𝕜 => v) at h
  · rw [h]
    abel
  · rw [sub_eq_iff_eq_add] at h
    rw [h]
    abel

/-- State matrix and input terms in the causal shifted realization. -/
def Ad (T : 𝕜) (Γ A : Matrix ι ι 𝕜) := (E T Γ A)⁻¹ * F T Γ A
def B0 (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B : ι → 𝕜) :=
  T • ((E T Γ A)⁻¹ *ᵥ (Γ *ᵥ B))
def B1 (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B : ι → 𝕜) :=
  T • ((E T Γ A)⁻¹ *ᵥ ((1-Γ) *ᵥ B))
def Bd (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B : ι → 𝕜) :=
  Ad T Γ A *ᵥ B0 T Γ A B + B1 T Γ A B

/-- The actual two-time-level state scheme, before introducing a transform. -/
theorem state_scheme_collected (T u up : 𝕜) (Γ A : Matrix ι ι 𝕜) (B x xp : ι → 𝕜) :
    (xp-x = T • (Γ *ᵥ (A *ᵥ xp + up • B) + (1-Γ) *ᵥ (A *ᵥ x + u • B))) ↔
      E T Γ A *ᵥ xp = F T Γ A *ᵥ x + (T*up) • (Γ *ᵥ B) +
        (T*u) • ((1-Γ) *ᵥ B) := by
  simp only [E, F, Matrix.sub_mulVec, Matrix.add_mulVec, Matrix.smul_mulVec_assoc,
    Matrix.one_mulVec, ← Matrix.mulVec_mulVec, Matrix.mulVec_add, Matrix.mulVec_smul,
    Matrix.mulVec_sub, smul_add, smul_sub, smul_smul]
  constructor <;> intro h <;> apply sub_eq_iff_eq_add.mpr
  · convert sub_eq_iff_eq_add.mp h using 1 <;> abel
  · convert sub_eq_iff_eq_add.mp h using 1 <;> abel

/-- Nonsingularity of E solves the state scheme, with precisely the advance
 and current input coefficients used in the coordinate shift. -/
theorem collected_step_solved (T u up : 𝕜) (Γ A : Matrix ι ι 𝕜) (B x xp : ι → 𝕜)
    (hE : (E T Γ A).det ≠ 0)
    (h : E T Γ A *ᵥ xp = F T Γ A *ᵥ x + (T*up) • (Γ *ᵥ B) +
        (T*u) • ((1-Γ) *ᵥ B)) :
    xp = Ad T Γ A *ᵥ x + up • B0 T Γ A B + u • B1 T Γ A B := by
  have hh := congrArg (fun v => (E T Γ A)⁻¹ *ᵥ v) h
  dsimp only at hh
  rw [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hE),
    Matrix.one_mulVec] at hh
  simp only [Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_mulVec] at hh
  rw [hh]
  simp only [Ad, B0, B1, smul_smul]
  rw [mul_comm T up, mul_comm T u]
  simp only [Matrix.mulVec_mulVec]

/-- The coordinate shift removes the apparent advance input exactly. -/
theorem causal_shift (T u up : 𝕜) (Γ A : Matrix ι ι 𝕜) (B x xp : ι → 𝕜)
    (h : xp = Ad T Γ A *ᵥ x + up • B0 T Γ A B + u • B1 T Γ A B) :
    xp - up • B0 T Γ A B =
      Ad T Γ A *ᵥ (x-u • B0 T Γ A B) + u • Bd T Γ A B := by
  rw [h]
  simp only [Bd, Matrix.mulVec_sub, Matrix.mulVec_smul, smul_add]
  abel

/-- Output equation in the same shifted coordinates. -/
theorem causal_output (C x b : ι → 𝕜) (D u : 𝕜) :
    dotProduct C x + D*u = dotProduct C (x-u • b) + (D+dotProduct C b)*u := by
  simp only [dotProduct_sub, dotProduct_smul, smul_eq_mul]
  ring

/-- The implicit pencil factors through the actual causal state matrix. -/
theorem pencil_factor (T z : 𝕜) (Γ A : Matrix ι ι 𝕜)
    (hE : (E T Γ A).det ≠ 0) :
    M T Γ A z = E T Γ A * (z • 1 - Ad T Γ A) := by
  rw [Matrix.mul_sub, Matrix.mul_smul, Matrix.mul_one, Ad,
    Matrix.mul_nonsing_inv_cancel_left _ _ (isUnit_iff_ne_zero.mpr hE)]
  rfl

/-- The uncancelled denominator retains det E as its leading factor. -/
theorem determinant_factor (T z : 𝕜) (Γ A : Matrix ι ι 𝕜)
    (hE : (E T Γ A).det ≠ 0) :
    (M T Γ A z).det = (E T Γ A).det * (z • 1 - Ad T Γ A).det := by
  rw [pencil_factor T z Γ A hE, Matrix.det_mul]

/-- Wherever the transform pencil is nonsingular, its equation has the stated
 inverse solution. This is an actual finite-dimensional solve. -/
theorem transform_solution (T z u : 𝕜) (Γ A : Matrix ι ι 𝕜) (B x : ι → 𝕜)
    (hM : (M T Γ A z).det ≠ 0)
    (hx : M T Γ A z *ᵥ x = (T*u) • (Q Γ z *ᵥ B)) :
    x = (T*u) • ((M T Γ A z)⁻¹ *ᵥ (Q Γ z *ᵥ B)) := by
  have h := congrArg (fun v => (M T Γ A z)⁻¹ *ᵥ v) hx
  dsimp only at h
  rw [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hM),
    Matrix.one_mulVec, Matrix.mulVec_smul] at h
  exact h

/-- Multiplication by E recovers the two implicit input coefficients. -/
lemma E_B0 (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B : ι → 𝕜)
    (hE : (E T Γ A).det ≠ 0) :
    E T Γ A *ᵥ B0 T Γ A B = T • (Γ *ᵥ B) := by
  rw [B0, Matrix.mulVec_smul, Matrix.mulVec_mulVec,
    Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hE), Matrix.one_mulVec]

lemma E_B1 (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B : ι → 𝕜)
    (hE : (E T Γ A).det ≠ 0) :
    E T Γ A *ᵥ B1 T Γ A B = T • ((1-Γ) *ᵥ B) := by
  rw [B1, Matrix.mulVec_smul, Matrix.mulVec_mulVec,
    Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hE), Matrix.one_mulVec]

/-- The transform of the shifted causal state has exactly the original input
 column; this links the causal state realization to the implicit pencil. -/
lemma causal_input_identity (T z : 𝕜) (Γ A : Matrix ι ι 𝕜) (B : ι → 𝕜)
    (hE : (E T Γ A).det ≠ 0) :
    M T Γ A z *ᵥ B0 T Γ A B + E T Γ A *ᵥ Bd T Γ A B = T • (Q Γ z *ᵥ B) := by
  rw [M, Bd, Matrix.sub_mulVec, Matrix.smul_mulVec_assoc, Matrix.mulVec_add,
    Matrix.mulVec_mulVec, Ad,
    Matrix.mul_nonsing_inv_cancel_left _ _ (isUnit_iff_ne_zero.mpr hE),
    E_B0 T Γ A B hE, E_B1 T Γ A B hE]
  simp only [Q, Matrix.add_mulVec, Matrix.smul_mulVec_assoc, smul_add, smul_smul]
  rw [mul_comm z T]
  abel

/-- Resolvent identity proving equality of the causal and implicit transfer
 functions wherever their common state denominator is nonsingular. -/
theorem causal_resolvent (T z : 𝕜) (Γ A : Matrix ι ι 𝕜) (B : ι → 𝕜)
    (hE : (E T Γ A).det ≠ 0)
    (hH : (z • (1 : Matrix ι ι 𝕜) - Ad T Γ A).det ≠ 0) :
    B0 T Γ A B + (z • (1 : Matrix ι ι 𝕜) - Ad T Γ A)⁻¹ *ᵥ Bd T Γ A B =
      T • ((M T Γ A z)⁻¹ *ᵥ (Q Γ z *ᵥ B)) := by
  have hm : (M T Γ A z).det ≠ 0 := by
    rw [determinant_factor T z Γ A hE]
    exact mul_ne_zero hE hH
  have hv : M T Γ A z *ᵥ
      (B0 T Γ A B + (z • (1 : Matrix ι ι 𝕜) - Ad T Γ A)⁻¹ *ᵥ Bd T Γ A B) =
        (T*1) • (Q Γ z *ᵥ B) := by
    rw [Matrix.mulVec_add, Matrix.mulVec_mulVec, pencil_factor T z Γ A hE,
      Matrix.mul_assoc, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hH),
      Matrix.mul_one, mul_one]
    simpa only [pencil_factor T z Γ A hE] using causal_input_identity T z Γ A B hE
  simpa only [mul_one] using transform_solution T z 1 Γ A B _ hm hv

/-- Equality of the causal and implicit transfer functions, including the
 feedthrough term generated by the coordinate shift. -/
theorem causal_transfer (T z : 𝕜) (Γ A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D : 𝕜)
    (hE : (E T Γ A).det ≠ 0)
    (hH : (z • (1 : Matrix ι ι 𝕜) - Ad T Γ A).det ≠ 0) :
    (D + dotProduct C (B0 T Γ A B)) +
        dotProduct C ((z • (1 : Matrix ι ι 𝕜) - Ad T Γ A)⁻¹ *ᵥ Bd T Γ A B) =
      D + T * dotProduct C ((M T Γ A z)⁻¹ *ᵥ (Q Γ z *ᵥ B)) := by
  rw [add_assoc, ← dotProduct_add, causal_resolvent T z Γ A B hE hH,
    dotProduct_smul, smul_eq_mul]

end C2.NGamma.Realization

end

/- ===== C2.NGammaRealizationPolynomial ===== -/

/-! Polynomial numerator/denominator of the actual state realization.
The numerator degree bound uses Cramer's rule: each replacement column is
still affine in z, so every determinant has degree at most the state count. -/
noncomputable section
namespace C2.NGamma.Realization
open Matrix Polynomial
variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {𝕜 : Type*} [Field 𝕜]

def pencil (T : 𝕜) (Γ A : Matrix ι ι 𝕜) : Matrix ι ι 𝕜[X] :=
  (X : 𝕜[X]) • (E T Γ A).map Polynomial.C + (-F T Γ A).map Polynomial.C

def inputPencil (Γ : Matrix ι ι 𝕜) (B : ι → 𝕜) : ι → 𝕜[X] :=
  fun i => X * Polynomial.C ((Γ *ᵥ B) i) + Polynomial.C (((1-Γ) *ᵥ B) i)

def denominator (T : 𝕜) (Γ A : Matrix ι ι 𝕜) : 𝕜[X] := (pencil T Γ A).det

def numerator (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D : 𝕜) : 𝕜[X] :=
  Polynomial.C D * denominator T Γ A + Polynomial.C T *
    dotProduct (fun i => Polynomial.C (C i))
      ((pencil T Γ A).adjugate *ᵥ inputPencil Γ B)

lemma denominator_degree_le (T : 𝕜) (Γ A : Matrix ι ι 𝕜) :
    (denominator T Γ A).natDegree ≤ Fintype.card ι :=
  Polynomial.natDegree_det_X_add_C_le _ _

lemma denominator_top_coeff (T : 𝕜) (Γ A : Matrix ι ι 𝕜) :
    (denominator T Γ A).coeff (Fintype.card ι) = (E T Γ A).det :=
  Polynomial.coeff_det_X_add_C_card _ _

/-- The denominator has exactly n degrees; det E is retained, not cancelled. -/
theorem denominator_degree (T : 𝕜) (Γ A : Matrix ι ι 𝕜)
    (hE : (E T Γ A).det ≠ 0) :
    (denominator T Γ A).natDegree = Fintype.card ι := by
  apply le_antisymm (denominator_degree_le T Γ A)
  exact Polynomial.le_natDegree_of_ne_zero (by rwa [denominator_top_coeff])

lemma replacement_affine (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B : ι → 𝕜) (i : ι) :
    (pencil T Γ A).updateCol i (inputPencil Γ B) =
      (X : 𝕜[X]) • ((E T Γ A).updateCol i (Γ *ᵥ B)).map Polynomial.C +
        ((-F T Γ A).updateCol i ((1-Γ) *ᵥ B)).map Polynomial.C := by
  ext j k
  by_cases hk : k = i
  · subst k
    simp [pencil, inputPencil, Matrix.updateCol_apply, Matrix.map_apply]
  · simp [pencil, inputPencil, Matrix.updateCol_apply, Matrix.map_apply, hk]

/-- The uncancelled numerator has degree at most n, including feedthrough. -/
theorem numerator_degree_le (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D : 𝕜) :
    (numerator T Γ A B C D).natDegree ≤ Fintype.card ι := by
  unfold numerator
  apply (Polynomial.natDegree_add_le _ _).trans
  apply max_le
  · exact (Polynomial.natDegree_C_mul_le _ _).trans (denominator_degree_le T Γ A)
  · apply (Polynomial.natDegree_C_mul_le _ _).trans
    rw [← Matrix.cramer_eq_adjugate_mulVec]
    unfold dotProduct
    apply Polynomial.natDegree_sum_le_of_forall_le
    intro i _
    apply (Polynomial.natDegree_C_mul_le _ _).trans
    rw [Matrix.cramer_apply, replacement_affine]
    exact Polynomial.natDegree_det_X_add_C_le _ _

lemma pencil_eval (T z : 𝕜) (Γ A : Matrix ι ι 𝕜) :
    (pencil T Γ A).map (Polynomial.eval z) = M T Γ A z := by
  ext i j
  simp [pencil, M, Matrix.map_apply]
  ring

lemma inputPencil_eval (Γ : Matrix ι ι 𝕜) (B : ι → 𝕜) (z : 𝕜) :
    (fun i => Polynomial.eval z (inputPencil Γ B i)) = Q Γ z *ᵥ B := by
  ext i
  simp [inputPencil, Q, Matrix.add_mulVec, Matrix.smul_mulVec_assoc]
  ring

lemma denominator_eval (T z : 𝕜) (Γ A : Matrix ι ι 𝕜) :
    (denominator T Γ A).eval z = (M T Γ A z).det := by
  exact ((Polynomial.evalRingHom z).map_det (pencil T Γ A)).trans
    (congrArg Matrix.det (pencil_eval T z Γ A))

lemma numerator_eval (T z : 𝕜) (Γ A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D : 𝕜) :
    (numerator T Γ A B C D).eval z =
      D*(M T Γ A z).det + T*dotProduct C ((M T Γ A z).adjugate *ᵥ (Q Γ z *ᵥ B)) := by
  have ha := (Polynomial.evalRingHom z).map_adjugate (pencil T Γ A)
  change ((pencil T Γ A).adjugate.map (Polynomial.eval z)) =
    ((pencil T Γ A).map (Polynomial.eval z)).adjugate at ha
  rw [pencil_eval] at ha
  unfold numerator
  simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, denominator_eval]
  congr 2
  simp only [dotProduct, Matrix.mulVec, Polynomial.eval_finset_sum, Polynomial.eval_mul,
    Polynomial.eval_C]
  apply Finset.sum_congr rfl
  intro i _
  congr 1
  apply Finset.sum_congr rfl
  intro j _
  have hb := congrFun (inputPencil_eval Γ B z) j
  change _ = (Q Γ z *ᵥ B) j at hb
  rw [hb]
  exact congrArg (fun a => a * (Q Γ z *ᵥ B) j) (congrFun (congrFun ha i) j)

/-- Exact rational transfer identity at every nonsingular transform point. -/
theorem transfer_quotient (T z : 𝕜) (Γ A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D : 𝕜)
    (hM : (M T Γ A z).det ≠ 0) :
    D + T*dotProduct C ((M T Γ A z)⁻¹ *ᵥ (Q Γ z *ᵥ B)) =
      (numerator T Γ A B C D).eval z / (denominator T Γ A).eval z := by
  rw [numerator_eval, denominator_eval, Matrix.inv_def, Ring.inverse_eq_inv,
    Matrix.smul_mulVec_assoc, dotProduct_smul]
  simp only [smul_eq_mul]
  field_simp

/-- Literal degree statements, with the zero numerator correctly having
 degree minus infinity. -/
theorem polynomial_degrees (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D : 𝕜)
    (hE : (E T Γ A).det ≠ 0) :
    (denominator T Γ A).degree = (Fintype.card ι : WithBot ℕ) ∧
      (numerator T Γ A B C D).degree ≤ (Fintype.card ι : WithBot ℕ) := by
  constructor
  · have hd : denominator T Γ A ≠ 0 := by
      intro h
      have hc := denominator_top_coeff T Γ A
      rw [h, Polynomial.coeff_zero] at hc
      exact hE hc.symm
    rw [Polynomial.degree_eq_natDegree hd, denominator_degree T Γ A hE]
  · exact Polynomial.degree_le_of_natDegree_le (numerator_degree_le T Γ A B C D)

end C2.NGamma.Realization

end

/- ===== C2.NGammaRealizationCausal ===== -/

/-! The uncancelled polynomials of the implicit and causal realizations agree
up to det E. Polynomial identities include the eigenvalues, where the
resolvent formulas themselves are undefined. -/
noncomputable section
namespace C2.NGamma.Realization
open Matrix Polynomial
variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {𝕜 : Type*} [Field 𝕜]

lemma charmatrix_eval (A : Matrix ι ι 𝕜) (z : 𝕜) :
    A.charmatrix.map (Polynomial.eval z) = z • 1 - A := by
  ext i j
  by_cases hij : i = j
  · subst j
    simp [Matrix.charmatrix_apply_eq, Matrix.map_apply]
  · simp [Matrix.charmatrix_apply_ne _ _ _ hij, Matrix.map_apply, hij]

lemma charpoly_eval (A : Matrix ι ι 𝕜) (z : 𝕜) :
    A.charpoly.eval z = (z • 1 - A).det := by
  exact ((Polynomial.evalRingHom z).map_det A.charmatrix).trans
    (congrArg Matrix.det (charmatrix_eval A z))

def causalNumerator (A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D : 𝕜) : 𝕜[X] :=
  Polynomial.C D * A.charpoly +
    dotProduct (fun i => Polynomial.C (C i))
      (A.charmatrix.adjugate *ᵥ (fun i => Polynomial.C (B i)))

lemma causalNumerator_eval (A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D z : 𝕜) :
    (causalNumerator A B C D).eval z =
      D*(z • 1-A).det + dotProduct C ((z • 1-A).adjugate *ᵥ B) := by
  have ha := (Polynomial.evalRingHom z).map_adjugate A.charmatrix
  change (A.charmatrix.adjugate.map (Polynomial.eval z)) =
    (A.charmatrix.map (Polynomial.eval z)).adjugate at ha
  rw [charmatrix_eval] at ha
  unfold causalNumerator
  simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, charpoly_eval]
  congr 1
  simp only [dotProduct, Matrix.mulVec, Polynomial.eval_finset_sum, Polynomial.eval_mul,
    Polynomial.eval_C]
  apply Finset.sum_congr rfl
  intro i _
  congr 1
  apply Finset.sum_congr rfl
  intro j _
  exact congrArg (fun a => a * B j) (congrFun (congrFun ha i) j)

lemma causalNumerator_quotient (A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D z : 𝕜)
    (hH : (z • (1 : Matrix ι ι 𝕜)-A).det ≠ 0) :
    D + dotProduct C ((z • 1-A)⁻¹ *ᵥ B) =
      (causalNumerator A B C D).eval z / A.charpoly.eval z := by
  rw [causalNumerator_eval, charpoly_eval, Matrix.inv_def, Ring.inverse_eq_inv,
    Matrix.smul_mulVec_assoc, dotProduct_smul]
  simp only [smul_eq_mul]
  field_simp

variable [Infinite 𝕜]

/-- Equality as uncancelled polynomials, including singular transform points. -/
theorem denominator_eq_charpoly (T : 𝕜) (Γ A : Matrix ι ι 𝕜)
    (hE : (E T Γ A).det ≠ 0) :
    denominator T Γ A = Polynomial.C (E T Γ A).det * (Ad T Γ A).charpoly := by
  apply Polynomial.funext
  intro z
  rw [denominator_eval, Polynomial.eval_mul, Polynomial.eval_C, charpoly_eval,
    determinant_factor T z Γ A hE]

/-- The numerator retains the same common det E factor as the denominator;
this is a polynomial identity and performs no pole-zero cancellation. -/
theorem numerator_eq_causal (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D : 𝕜)
    (hE : (E T Γ A).det ≠ 0) :
    numerator T Γ A B C D = Polynomial.C (E T Γ A).det *
      causalNumerator (Ad T Γ A) (Bd T Γ A B) C (D+dotProduct C (B0 T Γ A B)) := by
  have hp : (Ad T Γ A).charpoly * (numerator T Γ A B C D -
      Polynomial.C (E T Γ A).det *
        causalNumerator (Ad T Γ A) (Bd T Γ A B) C (D+dotProduct C (B0 T Γ A B))) = 0 := by
    apply Polynomial.funext
    intro z
    simp only [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_C, Polynomial.eval_zero]
    by_cases hH : (z • (1 : Matrix ι ι 𝕜) - Ad T Γ A).det = 0
    · rw [charpoly_eval, hH, zero_mul]
    · have hm : (M T Γ A z).det ≠ 0 := by
        rw [determinant_factor T z Γ A hE]
        exact mul_ne_zero hE hH
      have ht := causal_transfer T z Γ A B C D hE hH
      rw [causalNumerator_quotient _ _ _ _ _ hH, transfer_quotient _ _ _ _ _ _ _ hm,
        denominator_eval, determinant_factor T z Γ A hE, charpoly_eval] at ht
      have hn : (numerator T Γ A B C D).eval z = (E T Γ A).det *
          (causalNumerator (Ad T Γ A) (Bd T Γ A B) C (D+dotProduct C (B0 T Γ A B))).eval z := by
        field_simp [hH, hE] at ht
        apply mul_right_cancel₀ hH
        calc
          (numerator T Γ A B C D).eval z * (z • 1 - Ad T Γ A).det =
              (causalNumerator (Ad T Γ A) (Bd T Γ A B) C (D+dotProduct C (B0 T Γ A B))).eval z *
                ((E T Γ A).det * (z • 1 - Ad T Γ A).det) := ht.symm
          _ = _ := by ring
      rw [hn, sub_self, mul_zero]
  have hn := (mul_eq_zero.mp hp).resolve_left (Matrix.charpoly_monic _).ne_zero
  exact sub_eq_zero.mp hn

end C2.NGamma.Realization

end

/- ===== C2.NGammaRealizationDelay ===== -/

/-! A concrete causal realization of arbitrary integer output delays.
Each step appends the previous output as one new state.  The determinant
formula below concerns this actual augmented matrix, not a prescribed
characteristic polynomial. -/
noncomputable section
open Matrix
namespace C2.NGamma.Realization.Delay

structure StateSpace (𝕜 : Type) where
  State : Type
  fintype : Fintype State
  decEq : DecidableEq State
  A : Matrix State State 𝕜
  B : State → 𝕜
  C : State → 𝕜
  D : 𝕜

attribute [instance] StateSpace.fintype StateSpace.decEq
variable {𝕜 : Type} [Field 𝕜]

def pencil (S : StateSpace 𝕜) (z : 𝕜) := z • (1 : Matrix S.State S.State 𝕜) - S.A

def transfer (S : StateSpace 𝕜) (z : 𝕜) := S.D + S.C ⬝ᵥ ((pencil S z)⁻¹ *ᵥ S.B)

/-- Append q[k+1] = y[k] and use q as the new output. -/
def append (S : StateSpace 𝕜) : StateSpace 𝕜 where
  State := S.State ⊕ Unit
  fintype := inferInstance
  decEq := inferInstance
  A := Matrix.fromBlocks S.A 0 (Matrix.replicateRow Unit S.C) 0
  B := Sum.elim S.B (fun _ => S.D)
  C := Sum.elim (fun _ => 0) (fun _ => 1)
  D := 0

def delay (S : StateSpace 𝕜) : ℕ → StateSpace 𝕜
  | 0 => S
  | d + 1 => append (delay S d)

lemma delay_card (S : StateSpace 𝕜) (d : ℕ) :
    Fintype.card (delay S d).State = Fintype.card S.State + d := by
  induction d with
  | zero => simp [delay]
  | succ d ih => simpa [delay, append, Fintype.card_sum] using congrArg (· + 1) ih

lemma pencil_append (S : StateSpace 𝕜) (z : 𝕜) :
    pencil (append S) z = Matrix.fromBlocks (pencil S z) 0
      (-Matrix.replicateRow Unit S.C) (z • (1 : Matrix Unit Unit 𝕜)) := by
  ext i j
  cases i <;> cases j <;>
    simp [pencil, append, Matrix.fromBlocks, Matrix.one_apply]

lemma det_pencil_append (S : StateSpace 𝕜) (z : 𝕜) :
    (pencil (append S) z).det = z * (pencil S z).det := by
  rw [pencil_append, Matrix.det_fromBlocks_zero₁₂]
  simp [Matrix.det_unique, mul_comm]

lemma det_pencil_delay (S : StateSpace 𝕜) (z : 𝕜) (d : ℕ) :
    (pencil (delay S d) z).det = z ^ d * (pencil S z).det := by
  induction d with
  | zero => simp [delay]
  | succ d ih => rw [delay, det_pencil_append, ih, pow_succ]; ring

lemma transfer_append (S : StateSpace 𝕜) {z : 𝕜} (hz : z ≠ 0)
    (hM : (pencil S z).det ≠ 0) :
    transfer (append S) z = transfer S z / z := by
  let H := pencil S z
  have hH : IsUnit H.det := isUnit_iff_ne_zero.mpr hM
  let v := Sum.elim (H⁻¹ *ᵥ S.B) (fun _ : Unit => transfer S z / z)
  have hv : pencil (append S) z *ᵥ v = (append S).B := by
    rw [pencil_append]
    change Matrix.fromBlocks H 0 (-Matrix.replicateRow Unit S.C)
      (z • (1 : Matrix Unit Unit 𝕜)) *ᵥ v = _
    rw [Matrix.fromBlocks_mulVec]
    have hinv : H *ᵥ (H⁻¹ *ᵥ S.B) = S.B := by
      rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv H hH, Matrix.one_mulVec]
    ext i
    cases i with
    | inl i => simpa [v, append] using congrFun hinv i
    | inr i =>
      change ((-Matrix.replicateRow Unit S.C) *ᵥ (H⁻¹ *ᵥ S.B) +
        (z • (1 : Matrix Unit Unit 𝕜)) *ᵥ (fun _ => transfer S z / z)) i = S.D
      rw [Matrix.neg_mulVec, Matrix.replicateRow_mulVec_eq_const,
        Matrix.smul_mulVec_assoc, Matrix.one_mulVec]
      change -(S.C ⬝ᵥ (H⁻¹ *ᵥ S.B)) + z * (transfer S z / z) = S.D
      dsimp [transfer, H]
      field_simp
      <;> ring
  have hP : IsUnit (pencil (append S) z).det := by
    rw [det_pencil_append]
    exact isUnit_iff_ne_zero.mpr (mul_ne_zero hz hM)
  have hinv : (pencil (append S) z)⁻¹ *ᵥ (append S).B = v := by
    rw [← hv, Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul _ hP, Matrix.one_mulVec]
  unfold transfer
  rw [hinv]
  simp [append, v, transfer, dotProduct, Fintype.sum_sum_type]

lemma transfer_delay (S : StateSpace 𝕜) {z : 𝕜} (hz : z ≠ 0)
    (hM : (pencil S z).det ≠ 0) (d : ℕ) :
    transfer (delay S d) z = transfer S z / z ^ d := by
  induction d with
  | zero => simp [delay]
  | succ d ih =>
    rw [delay, transfer_append _ hz, ih, div_div, pow_succ]
    rw [det_pencil_delay]
    exact mul_ne_zero (pow_ne_zero _ hz) hM

/-- Negative static feedback on a strictly proper state realization. -/
def closedLoop (S : StateSpace 𝕜) (k : 𝕜) : Matrix S.State S.State 𝕜 :=
  S.A - Matrix.replicateCol Unit (k • S.B) * Matrix.replicateRow Unit S.C

lemma det_closedLoop (S : StateSpace 𝕜) (z k : 𝕜)
    (hM : (pencil S z).det ≠ 0) :
    (z • (1 : Matrix S.State S.State 𝕜) - closedLoop S k).det =
      (pencil S z).det * (1 + k * (S.C ⬝ᵥ ((pencil S z)⁻¹ *ᵥ S.B))) := by
  have hp : z • (1 : Matrix S.State S.State 𝕜) - closedLoop S k =
      pencil S z + Matrix.replicateCol Unit (k • S.B) * Matrix.replicateRow Unit S.C := by
    unfold closedLoop pencil
    abel
  rw [hp, Matrix.det_add_replicateCol_mul_replicateRow (isUnit_iff_ne_zero.mpr hM)]
  simp only [Matrix.det_unique]
  congr 1
  simp only [Matrix.add_apply, Matrix.one_apply_eq, Matrix.mul_apply,
    Matrix.replicateRow, Matrix.replicateCol, Matrix.mulVec,
    dotProduct, Finset.mul_sum, Finset.sum_mul, Pi.smul_apply, smul_eq_mul]
  congr 1
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  simp only [Matrix.of_apply]
  ring

lemma delay_feedthrough (S : StateSpace 𝕜) {d : ℕ} (hd : 0 < d) : (delay S d).D = 0 := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hd)
  rfl

/-- Exact determinant of the concrete n+d dimensional feedback realization,
initially away from z=0 and the plant eigenvalues. -/
lemma delayed_closedLoop_determinant (S : StateSpace 𝕜) {d : ℕ} (hd : 0 < d)
    (z k : 𝕜) (hz : z ≠ 0) (hM : (pencil S z).det ≠ 0) :
    (z • (1 : Matrix (delay S d).State (delay S d).State 𝕜) -
      closedLoop (delay S d) k).det =
      z ^ d * (pencil S z).det + k * ((pencil S z).det * transfer S z) := by
  have hMd : (pencil (delay S d) z).det ≠ 0 := by
    rw [det_pencil_delay]
    exact mul_ne_zero (pow_ne_zero _ hz) hM
  rw [det_closedLoop _ _ _ hMd, det_pencil_delay]
  have ht : (delay S d).C ⬝ᵥ ((pencil (delay S d) z)⁻¹ *ᵥ (delay S d).B) =
      transfer S z / z ^ d := by
    simpa [transfer, delay_feedthrough S hd] using transfer_delay S hz hM d
  rw [ht]
  field_simp
  <;> ring

end C2.NGamma.Realization.Delay

end

/- ===== C2.NGammaDiagonal ===== -/

/-! # Independent diagonal weights preserve diagonal dissipativity

The hypotheses below are the coordinate form of a positive diagonal Lyapunov
matrix and `Aᵀ P + P A ≺ 0`.  The proof uses the actual homogeneous difference
equation.  No stability or contraction conclusion is assumed.
-/

noncomputable section
namespace C2.NGamma
open scoped BigOperators
open Matrix
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The quadratic form of the positive diagonal matrix with entries `p`. -/
def energy (p : ι → ℝ) (v : ι → ℝ) : ℝ := ∑ i, p i * (v i)^2

/-- Half of the quadratic form of `Aᵀ P + P A`. -/
def dissipation (p : ι → ℝ) (A : Matrix ι ι ℝ) (v : ι → ℝ) : ℝ :=
  ∑ i, p i * v i * (A *ᵥ v) i

/-- Strict diagonal dissipativity, in exact coordinates. -/
def DiagonallyDissipative (p : ι → ℝ) (A : Matrix ι ι ℝ) : Prop :=
  ∀ v : ι → ℝ, v ≠ 0 → dissipation p A v < 0

/-- The unforced generalized-theta difference equation. -/
def HomogeneousStep (T : ℝ) (γ : ι → ℝ) (A : Matrix ι ι ℝ)
    (x xp : ι → ℝ) : Prop :=
  ∀ i, xp i - x i = T * (γ i * (A *ᵥ xp) i + (1-γ i) * (A *ᵥ x) i)

def stepE (T : ℝ) (γ : ι → ℝ) (A : Matrix ι ι ℝ) : Matrix ι ι ℝ :=
  1 - T • (diagonal γ * A)

def stepF (T : ℝ) (γ : ι → ℝ) (A : Matrix ι ι ℝ) : Matrix ι ι ℝ :=
  1 + T • (diagonal (fun i => 1 - γ i) * A)

lemma energy_nonneg {p : ι → ℝ} (hp : ∀ i, 0 ≤ p i) (v : ι → ℝ) :
    0 ≤ energy p v := by
  exact Finset.sum_nonneg fun i _ => mul_nonneg (hp i) (sq_nonneg _)

lemma energy_pos {p : ι → ℝ} (hp : ∀ i, 0 < p i) {v : ι → ℝ} (hv : v ≠ 0) :
    0 < energy p v := by
  obtain ⟨i, hi⟩ : ∃ i, v i ≠ 0 := by
    by_contra h
    push_neg at h
    exact hv (funext h)
  exact Finset.sum_pos' (fun j _ => mul_nonneg (hp j).le (sq_nonneg _))
    ⟨i, Finset.mem_univ _, mul_pos (hp i) (sq_pos_of_ne_zero hi)⟩

@[simp] lemma energy_zero (p : ι → ℝ) : energy p 0 = 0 := by simp [energy]

lemma DiagonallyDissipative.ker {p : ι → ℝ} {A : Matrix ι ι ℝ}
    (hA : DiagonallyDissipative p A) {v : ι → ℝ} (hv : A *ᵥ v = 0) : v = 0 := by
  by_contra h
  have hn := hA v h
  simp [dissipation, hv] at hn

/-- The paper's strict Lyapunov hypothesis is exactly strict diagonal
 dissipativity; this identity includes both real bilinear terms. -/
lemma lyapunov_quadratic (p : ι → ℝ) (A : Matrix ι ι ℝ) (v : ι → ℝ) :
    dotProduct v ((A.transpose * diagonal p + diagonal p * A) *ᵥ v) =
      2 * dissipation p A v := by
  simp only [add_mulVec, dotProduct_add, ← mulVec_mulVec]
  rw [dotProduct_mulVec, vecMul_transpose]
  simp only [dotProduct, mulVec_diagonal, Pi.mul_apply, dissipation]
  rw [← Finset.sum_add_distrib, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  ring

lemma homogeneousStep_iff (T : ℝ) (γ : ι → ℝ) (A : Matrix ι ι ℝ)
    (x xp : ι → ℝ) :
    HomogeneousStep T γ A x xp ↔ stepE T γ A *ᵥ xp = stepF T γ A *ᵥ x := by
  simp only [stepE, stepF, sub_mulVec, add_mulVec, smul_mulVec_assoc, one_mulVec,
    ← mulVec_mulVec, mulVec_diagonal, HomogeneousStep, funext_iff, Pi.sub_apply,
    Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.mul_apply]
  constructor <;> intro h i <;> specialize h i <;> linarith

/-- Exact discrete energy balance, before imposing positivity hypotheses. -/
theorem homogeneous_energy_identity (p γ : ι → ℝ) (A : Matrix ι ι ℝ)
    (T : ℝ) {x xp : ι → ℝ} (h : HomogeneousStep T γ A x xp) :
    T * (energy p (A *ᵥ xp) - energy p (A *ᵥ x)) =
      2 * dissipation p A (xp-x) -
      2*T * ∑ i, p i * (γ i - 1/2) * ((A *ᵥ (xp-x)) i)^2 := by
  simp only [energy, dissipation, mulVec_sub, Pi.sub_apply]
  rw [← Finset.sum_sub_distrib, Finset.mul_sum, Finset.mul_sum, Finset.mul_sum,
    ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro i _
  rw [h i]
  ring

/-- Every nonstationary homogeneous step strictly decreases the weighted
 energy of `A x`.  In particular the result does not assume invertibility of E. -/
theorem homogeneous_energy_strict {p γ : ι → ℝ} {A : Matrix ι ι ℝ} {T : ℝ}
    (hp : ∀ i, 0 < p i) (hγ : ∀ i, 1/2 ≤ γ i) (hT : 0 < T)
    (hA : DiagonallyDissipative p A) {x xp : ι → ℝ}
    (h : HomogeneousStep T γ A x xp) (hne : xp ≠ x) :
    energy p (A *ᵥ xp) < energy p (A *ᵥ x) := by
  have hδ : xp-x ≠ 0 := sub_ne_zero.mpr hne
  have hd := hA (xp-x) hδ
  have hn : 0 ≤ ∑ i, p i * (γ i - 1/2) * ((A *ᵥ (xp-x)) i)^2 :=
    Finset.sum_nonneg fun i _ => mul_nonneg (mul_nonneg (hp i).le (sub_nonneg.mpr (hγ i))) (sq_nonneg _)
  have he := homogeneous_energy_identity p γ A T h
  nlinarith

/-- Strict dissipativity rules out a nonzero fixed state. -/
lemma homogeneous_ne {p γ : ι → ℝ} {A : Matrix ι ι ℝ} {T : ℝ}
    (hT : 0 < T) (hA : DiagonallyDissipative p A) {x xp : ι → ℝ}
    (h : HomogeneousStep T γ A x xp) (hx : x ≠ 0) : xp ≠ x := by
  intro he
  subst xp
  have hz : A *ᵥ x = 0 := by
    ext i
    have hh := h i
    have ht : T ≠ 0 := ne_of_gt hT
    have : T * (A *ᵥ x) i = 0 := by nlinarith [hh]
    exact (mul_eq_zero.mp this).resolve_left ht
  exact hx (hA.ker hz)

/-- The implicit step matrix is actually nonsingular for every admissible T
 and every diagonal weight gamma >= 1/2. -/
theorem stepE_det_ne_zero {p γ : ι → ℝ} {A : Matrix ι ι ℝ} {T : ℝ}
    (hp : ∀ i, 0 < p i) (hγ : ∀ i, 1/2 ≤ γ i) (hT : 0 < T)
    (hA : DiagonallyDissipative p A) : (stepE T γ A).det ≠ 0 := by
  intro he
  obtain ⟨v, hv, hev⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr he
  have hs : HomogeneousStep T γ A 0 v :=
    (homogeneousStep_iff T γ A 0 v).mpr (by simpa using hev)
  have hh := homogeneous_energy_strict hp hγ hT hA hs hv
  simp only [Matrix.mulVec_zero, energy_zero] at hh
  exact (not_lt_of_ge (energy_nonneg (fun i => (hp i).le) (A *ᵥ v)) hh)


def stepMatrix (T : ℝ) (γ : ι → ℝ) (A : Matrix ι ι ℝ) : Matrix ι ι ℝ :=
  (stepE T γ A)⁻¹ * stepF T γ A

lemma stepMatrix_step {p γ : ι → ℝ} {A : Matrix ι ι ℝ} {T : ℝ}
    (hp : ∀ i, 0 < p i) (hγ : ∀ i, 1/2 ≤ γ i) (hT : 0 < T)
    (hA : DiagonallyDissipative p A) (x : ι → ℝ) :
    HomogeneousStep T γ A x (stepMatrix T γ A *ᵥ x) := by
  apply (homogeneousStep_iff T γ A x _).mpr
  rw [stepMatrix, Matrix.mulVec_mulVec,
    Matrix.mul_nonsing_inv_cancel_left _ _ (isUnit_iff_ne_zero.mpr (stepE_det_ne_zero hp hγ hT hA))]

lemma stepMatrix_energy_lt {p γ : ι → ℝ} {A : Matrix ι ι ℝ} {T : ℝ}
    (hp : ∀ i, 0 < p i) (hγ : ∀ i, 1/2 ≤ γ i) (hT : 0 < T)
    (hA : DiagonallyDissipative p A) {x : ι → ℝ} (hx : x ≠ 0) :
    energy p (A *ᵥ (stepMatrix T γ A *ᵥ x)) < energy p (A *ᵥ x) := by
  have hs := stepMatrix_step hp hγ hT hA x
  exact homogeneous_energy_strict hp hγ hT hA hs (homogeneous_ne hT hA hs hx)

lemma stepMatrix_energy_le {p γ : ι → ℝ} {A : Matrix ι ι ℝ} {T : ℝ}
    (hp : ∀ i, 0 < p i) (hγ : ∀ i, 1/2 ≤ γ i) (hT : 0 < T)
    (hA : DiagonallyDissipative p A) (x : ι → ℝ) :
    energy p (A *ᵥ (stepMatrix T γ A *ᵥ x)) ≤ energy p (A *ᵥ x) := by
  by_cases hx : x = 0
  · simp [hx]
  · exact (stepMatrix_energy_lt hp hγ hT hA hx).le

lemma energy_rotation (p : ι → ℝ) (u v : ι → ℝ) (a b : ℝ) :
    energy p (a • u - b • v) + energy p (b • u + a • v) =
      (a^2+b^2)*(energy p u + energy p v) := by
  simp only [energy, Pi.sub_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  ring

/-- Real matrices are embedded in the complex field, so the stability
 statement below concerns actual complex eigenvalues. -/
def complexify (A : Matrix ι ι ℝ) : Matrix ι ι ℂ := A.map Complex.ofReal

lemma complexify_mulVec_re (A : Matrix ι ι ℝ) (v : ι → ℂ) :
    (fun i => ((complexify A *ᵥ v) i).re) = A *ᵥ (fun i => (v i).re) := by
  ext i
  simp [complexify, Matrix.mulVec, dotProduct, Complex.mul_re]

lemma complexify_mulVec_im (A : Matrix ι ι ℝ) (v : ι → ℂ) :
    (fun i => ((complexify A *ᵥ v) i).im) = A *ᵥ (fun i => (v i).im) := by
  ext i
  simp [complexify, Matrix.mulVec, dotProduct, Complex.mul_im]

/-- Every actual complex eigenvalue of the implicit step lies strictly inside
 the unit disk. The proof follows from the derived, not assumed, energy law. -/
theorem stepMatrix_eigenvalue_norm_lt_one {p γ : ι → ℝ} {A : Matrix ι ι ℝ} {T : ℝ}
    (hp : ∀ i, 0 < p i) (hγ : ∀ i, 1/2 ≤ γ i) (hT : 0 < T)
    (hA : DiagonallyDissipative p A) {z : ℂ} {v : ι → ℂ} (hv : v ≠ 0)
    (he : complexify (stepMatrix T γ A) *ᵥ v = z • v) : ‖z‖ < 1 := by
  let u : ι → ℝ := fun i => (v i).re
  let w : ι → ℝ := fun i => (v i).im
  have huw : u ≠ 0 ∨ w ≠ 0 := by
    by_contra h
    push_neg at h
    apply hv
    funext i
    apply Complex.ext
    · exact congrFun h.1 i
    · exact congrFun h.2 i
  have hr : stepMatrix T γ A *ᵥ u = z.re • u - z.im • w := by
    rw [← complexify_mulVec_re, he]
    ext i
    simp [u, w, Complex.mul_re]
  have hi : stepMatrix T γ A *ᵥ w = z.im • u + z.re • w := by
    rw [← complexify_mulVec_im, he]
    ext i
    simp [u, w, Complex.mul_im]
    ring
  have hsum : 0 < energy p (A *ᵥ u) + energy p (A *ᵥ w) := by
    rcases huw with hu | hw
    · exact add_pos_of_pos_of_nonneg (energy_pos hp (fun h => hu (hA.ker h)))
        (energy_nonneg (fun i => (hp i).le) _)
    · exact add_pos_of_nonneg_of_pos (energy_nonneg (fun i => (hp i).le) _)
        (energy_pos hp (fun h => hw (hA.ker h)))
  have hstrict : energy p (A *ᵥ (stepMatrix T γ A *ᵥ u)) +
      energy p (A *ᵥ (stepMatrix T γ A *ᵥ w)) <
      energy p (A *ᵥ u) + energy p (A *ᵥ w) := by
    rcases huw with hu | hw
    · exact add_lt_add_of_lt_of_le (stepMatrix_energy_lt hp hγ hT hA hu)
        (stepMatrix_energy_le hp hγ hT hA w)
    · exact add_lt_add_of_le_of_lt (stepMatrix_energy_le hp hγ hT hA u)
        (stepMatrix_energy_lt hp hγ hT hA hw)
  rw [hr, hi, Matrix.mulVec_sub, Matrix.mulVec_add, Matrix.mulVec_smul,
    Matrix.mulVec_smul, Matrix.mulVec_smul, Matrix.mulVec_smul, energy_rotation] at hstrict
  have hq : z.re^2 + z.im^2 < 1 := by nlinarith
  have hn := Complex.sq_norm z
  rw [Complex.normSq_apply] at hn
  nlinarith [norm_nonneg z]

lemma eval_charpoly (M : Matrix ι ι ℂ) (z : ℂ) :
    M.charpoly.eval z = (z • 1 - M).det := by
  rw [Matrix.charpoly, Matrix.eval_det, Matrix.matPolyEquiv_eval_eq_map]
  congr 1
  ext i j
  by_cases hij : i = j
  · subst j
    simp [Matrix.charmatrix_apply_eq, Matrix.map_apply]
  · simp [Matrix.charmatrix_apply_ne _ _ _ hij, Matrix.map_apply, hij]

/-- Root-based strict Schur stability for a real square matrix. -/
def MatrixSchurStable (M : Matrix ι ι ℝ) : Prop :=
  ∀ z : ℂ, (complexify M).charpoly.eval z = 0 → ‖z‖ < 1

/-- Full diagonal-stability conclusion: nonsingular implicit solve and actual
 complex-root Schur stability of E^-1 F for every T>0 and gamma>=1/2. -/
theorem diagonal_stability {p γ : ι → ℝ} {A : Matrix ι ι ℝ} {T : ℝ}
    (hp : ∀ i, 0 < p i) (hγ : ∀ i, 1/2 ≤ γ i) (hT : 0 < T)
    (hA : DiagonallyDissipative p A) :
    (stepE T γ A).det ≠ 0 ∧ MatrixSchurStable (stepMatrix T γ A) := by
  refine ⟨stepE_det_ne_zero hp hγ hT hA, ?_⟩
  intro z hz
  rw [eval_charpoly] at hz
  obtain ⟨v, hv, he⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hz
  have hev : complexify (stepMatrix T γ A) *ᵥ v = z • v := by
    rw [Matrix.sub_mulVec, Matrix.smul_mulVec_assoc, Matrix.one_mulVec] at he
    exact (sub_eq_zero.mp he).symm
  exact stepMatrix_eigenvalue_norm_lt_one hp hγ hT hA hv hev

/-- The proposition stated with the literal positive/negative definite matrix
 hypotheses used in the manuscript. -/
theorem diagonal_stability_of_lyapunov {p γ : ι → ℝ} {A : Matrix ι ι ℝ} {T : ℝ}
    (hp : (diagonal p).PosDef) (hγ : ∀ i, 1/2 ≤ γ i) (hT : 0 < T)
    (hL : (-(A.transpose * diagonal p + diagonal p * A)).PosDef) :
    (stepE T γ A).det ≠ 0 ∧ MatrixSchurStable (stepMatrix T γ A) := by
  have hpp : ∀ i, 0 < p i := by
    intro i
    have h := hp.2 (Pi.single i 1) (by simp)
    simpa [Matrix.mulVec_diagonal, dotProduct, Pi.single_apply] using h
  apply diagonal_stability hpp hγ hT
  intro v hv
  have h := hL.2 v hv
  simp only [star_trivial, Matrix.neg_mulVec, dotProduct_neg] at h
  rw [lyapunov_quadratic] at h
  linarith

end C2.NGamma

end

/- ===== C2.NGammaRealizationAligned ===== -/

/-! Exact characteristic polynomial of the concrete delayed feedback matrix.
Polynomial continuation closes the singular-point cases left out of a
resolvent computation, so cancelled transfer modes are retained. -/
noncomputable section
namespace C2.NGamma.Realization
open Matrix Polynomial
variable {𝕜 : Type} [Field 𝕜] [Infinite 𝕜]

/-- The actual delayed feedback matrix has the uncancelled causal polynomial. -/
theorem delayed_charpoly (S : Delay.StateSpace 𝕜) {d : ℕ} (hd : 0 < d) (k : 𝕜) :
    (Delay.closedLoop (Delay.delay S d) k).charpoly =
      X^d * S.A.charpoly + Polynomial.C k * causalNumerator S.A S.B S.C S.D := by
  let R := (Delay.closedLoop (Delay.delay S d) k).charpoly -
    (X^d * S.A.charpoly + Polynomial.C k * causalNumerator S.A S.B S.C S.D)
  have hp : (X * S.A.charpoly) * R = 0 := by
    apply Polynomial.funext
    intro z
    simp only [Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_zero]
    by_cases hz : z = 0
    · rw [hz, zero_mul, zero_mul]
    by_cases hM : (Delay.pencil S z).det = 0
    · rw [charpoly_eval]
      change (z * (Delay.pencil S z).det) * _ = 0
      rw [hM, mul_zero, zero_mul]
    · have ht := Delay.delayed_closedLoop_determinant S hd z k hz hM
      have hq := causalNumerator_quotient S.A S.B S.C S.D z hM
      change Delay.transfer S z = _ at hq
      rw [charpoly_eval] at hq
      have hn : (Delay.pencil S z).det * Delay.transfer S z =
          (causalNumerator S.A S.B S.C S.D).eval z := by
        rw [hq]
        exact mul_div_cancel₀ _ hM
      have hr : R.eval z = 0 := by
        dsimp [R]
        simp only [Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
          Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C, charpoly_eval]
        change _ - (z^d*(Delay.pencil S z).det + _) = 0
        rw [ht, hn, sub_self]
      rw [hr, mul_zero]
  have hn := (mul_eq_zero.mp hp).resolve_left
    (mul_ne_zero Polynomial.X_ne_zero (Matrix.charpoly_monic S.A).ne_zero)
  exact sub_eq_zero.mp hn

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- The concrete shifted causal realization of the independently weighted
 state scheme. -/
def causalStateSpace (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D : 𝕜) :
    Delay.StateSpace 𝕜 where
  State := ι
  fintype := inferInstance
  decEq := inferInstance
  A := Ad T Γ A
  B := Bd T Γ A B
  C := C
  D := D + dotProduct C (B0 T Γ A B)

/-- Exact aligned-delay polynomial identity for the actual n+d state matrix. -/
theorem aligned_characteristic (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D k : 𝕜)
    {d : ℕ} (hd : 0 < d) (hE : (E T Γ A).det ≠ 0) :
    Polynomial.C (E T Γ A).det *
        (Delay.closedLoop (Delay.delay (causalStateSpace T Γ A B C D) d) k).charpoly =
      X^d * denominator T Γ A + Polynomial.C k * numerator T Γ A B C D := by
  rw [delayed_charpoly _ hd, denominator_eq_charpoly T Γ A hE,
    numerator_eq_causal T Γ A B C D hE]
  dsimp only [causalStateSpace]
  ring

/-- The displayed determinant quotient holds at all z, even plant eigenvalues
 or z=0, because it is derived from a polynomial identity. -/
theorem aligned_characteristic_eval (T z : 𝕜) (Γ A : Matrix ι ι 𝕜)
    (B C : ι → 𝕜) (D k : 𝕜) {d : ℕ} (hd : 0 < d) (hE : (E T Γ A).det ≠ 0) :
    (z • (1 : Matrix (Delay.delay (causalStateSpace T Γ A B C D) d).State
        (Delay.delay (causalStateSpace T Γ A B C D) d).State 𝕜) -
      Delay.closedLoop (Delay.delay (causalStateSpace T Γ A B C D) d) k).det =
      (z^d*(denominator T Γ A).eval z+k*(numerator T Γ A B C D).eval z) / (E T Γ A).det := by
  have h := congrArg (Polynomial.eval z) (aligned_characteristic T Γ A B C D k hd hE)
  simp only [Polynomial.eval_mul, Polynomial.eval_add, Polynomial.eval_pow,
    Polynomial.eval_X, Polynomial.eval_C, charpoly_eval] at h
  exact (eq_div_iff hE).mpr (by simpa only [mul_comm] using h)

/-- The actual augmented state dimension is n+d. -/
theorem aligned_state_count (T : 𝕜) (Γ A : Matrix ι ι 𝕜) (B C : ι → 𝕜) (D : 𝕜) (d : ℕ) :
    Fintype.card (Delay.delay (causalStateSpace T Γ A B C D) d).State = Fintype.card ι + d :=
  Delay.delay_card _ _

/-- Retaining the determinant polynomial preserves every complex closed-loop
 mode; Schur stability is exactly equivalent on the two sides. -/
theorem aligned_schur_iff (T : ℝ) (Γ A : Matrix ι ι ℝ) (B C : ι → ℝ) (D k : ℝ)
    {d : ℕ} (hd : 0 < d) (hE : (E T Γ A).det ≠ 0) :
    C2.NGamma.MatrixSchurStable
        (Delay.closedLoop (Delay.delay (causalStateSpace T Γ A B C D) d) k) ↔
      ∀ z : ℂ, ((X^d * denominator T Γ A + Polynomial.C k * numerator T Γ A B C D).map
        Complex.ofRealHom).eval z = 0 → ‖z‖ < 1 := by
  have hc : ((E T Γ A).det : ℂ) ≠ 0 := by exact_mod_cast hE
  have hp := congrArg (Polynomial.map Complex.ofRealHom)
    (aligned_characteristic T Γ A B C D k hd hE)
  simp only [Polynomial.map_mul, Polynomial.map_C] at hp
  have he (z : ℂ) :
      ((X^d * denominator T Γ A + Polynomial.C k * numerator T Γ A B C D).map
        Complex.ofRealHom).eval z = 0 ↔
      (C2.NGamma.complexify
        (Delay.closedLoop (Delay.delay (causalStateSpace T Γ A B C D) d) k)).charpoly.eval z = 0 := by
    rw [← hp, Polynomial.eval_mul, Polynomial.eval_C, mul_eq_zero]
    simp only [Complex.ofRealHom_eq_coe, hc, false_or]
    rw [← Matrix.charpoly_map _ Complex.ofRealHom]
    rfl
  constructor
  · intro h z hz
    exact h z ((he z).mp hz)
  · intro h z hz
    exact h z ((he z).mpr hz)

end C2.NGamma.Realization

end

/- ===== C2.NGammaRealizationDynamics ===== -/

/-! Standard finite-dimensional dynamics bridge: spectral Schur stability is
 equivalent to decay of every state trajectory. -/
noncomputable section
open Filter Topology Matrix
open scoped NNReal ENNReal
namespace C2.NGamma.Realization

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Every state trajectory of the homogeneous recurrence tends to zero. -/
def AsymptoticallyStable (A : Matrix ι ι ℝ) : Prop :=
  ∀ x : ι → ℝ, Tendsto (fun n : ℕ => (A^n) *ᵥ x) atTop (𝓝 0)

lemma complex_powers_tendsto_zero (A : Matrix ι ι ℂ)
    (h : ∀ z : ℂ, A.charpoly.eval z = 0 → ‖z‖ < 1) :
    Tendsto (fun n : ℕ => A^n) atTop (𝓝 0) := by
  cases isEmpty_or_nonempty ι with
  | inl hi =>
    letI := hi
    have he : ∀ n : ℕ, A^n = 0 := fun _ => Subsingleton.elim _ _
    simp_rw [he]
    exact tendsto_const_nhds
  | inr hi =>
    letI := hi
    letI : NormedRing (Matrix ι ι ℂ) := Matrix.linftyOpNormedRing
    letI : NormedAlgebra ℂ (Matrix ι ι ℂ) := Matrix.linftyOpNormedAlgebra
    have hs : spectralRadius ℂ A < 1 := by
      apply spectrum.spectralRadius_lt_of_forall_lt A
      intro z hz
      have hr : A.charpoly.eval z = 0 := by
        rw [charpoly_eval]
        have hu : ¬ IsUnit (z • (1 : Matrix ι ι ℂ)-A) := by
          simpa only [spectrum.mem_iff, Algebra.algebraMap_eq_smul_one] using hz
        simpa only [Matrix.isUnit_iff_isUnit_det, isUnit_iff_ne_zero, not_not] using hu
      exact_mod_cast h z hr
    exact powers_tendsto_zero_of_spectralRadius_lt_one A hs

lemma complexify_pow (A : Matrix ι ι ℝ) (n : ℕ) :
    C2.NGamma.complexify (A^n) = (C2.NGamma.complexify A)^n := by
  exact map_pow Complex.ofRealHom.mapMatrix A n

lemma complex_pow_mulVec (A : Matrix ι ι ℂ) (v : ι → ℂ) (mu : ℂ)
    (hv : A *ᵥ v = mu • v) (n : ℕ) : (A^n) *ᵥ v = mu^n • v := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ', ← Matrix.mulVec_mulVec, ih, Matrix.mulVec_smul, hv,
      smul_smul, pow_succ]

lemma complex_schur_of_powers_tendsto_zero (A : Matrix ι ι ℂ)
    (h : Tendsto (fun n : ℕ => A^n) atTop (𝓝 0)) :
    ∀ z : ℂ, A.charpoly.eval z = 0 → ‖z‖ < 1 := by
  intro z hz
  rw [charpoly_eval] at hz
  obtain ⟨v,hv,he⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hz
  have hev : A *ᵥ v = z • v := by
    rw [Matrix.sub_mulVec, Matrix.smul_mulVec_assoc, Matrix.one_mulVec] at he
    exact (sub_eq_zero.mp he).symm
  obtain ⟨i,hi⟩ : ∃ i, v i ≠ 0 := by
    by_contra hh
    push_neg at hh
    exact hv (funext hh)
  have hc : Tendsto (fun n : ℕ => ((A^n) *ᵥ v) i) atTop (𝓝 0) := by
    have hs := tendsto_finset_sum Finset.univ (fun j _ =>
      ((tendsto_pi_nhds.mp (tendsto_pi_nhds.mp h i) j).mul_const (v j)))
    simpa only [Matrix.mulVec, dotProduct, Matrix.zero_apply, zero_mul, Finset.sum_const_zero] using hs
  have hp : Tendsto (fun n : ℕ => z^n) atTop (𝓝 0) := by
    have hh := hc.div_const (v i)
    simp only [complex_pow_mulVec A v z hev, Pi.smul_apply, smul_eq_mul,
      mul_div_cancel_right₀ _ hi, zero_div] at hh
    exact hh
  exact tendsto_pow_atTop_nhds_zero_iff_norm_lt_one.mp hp

/-- Spectral Schur stability is sufficient for decay of every real state. -/
theorem asymptoticallyStable_of_schur (A : Matrix ι ι ℝ)
    (h : C2.NGamma.MatrixSchurStable A) : AsymptoticallyStable A := by
  have hp := complex_powers_tendsto_zero (C2.NGamma.complexify A) h
  have hr (i j : ι) : Tendsto (fun n : ℕ => (A^n) i j) atTop (𝓝 0) := by
    have ht := Complex.continuous_re.continuousAt.tendsto.comp
      (tendsto_pi_nhds.mp (tendsto_pi_nhds.mp hp i) j)
    simp_rw [← complexify_pow] at ht
    simpa only [C2.NGamma.complexify, Matrix.map_apply, Function.comp_def,
      Complex.ofReal_re, Matrix.zero_apply, Complex.zero_re] using ht
  intro x
  apply tendsto_pi_nhds.mpr
  intro i
  have hs := tendsto_finset_sum Finset.univ (fun j _ => (hr i j).mul_const (x j))
  simpa only [Matrix.mulVec, dotProduct, zero_mul, Finset.sum_const_zero, Pi.zero_apply] using hs

/-- Decay of every real initial state forces every complex eigenvalue inside
 the unit circle. The proof does not assume diagonalizability. -/
theorem schur_of_asymptoticallyStable (A : Matrix ι ι ℝ)
    (h : AsymptoticallyStable A) : C2.NGamma.MatrixSchurStable A := by
  apply complex_schur_of_powers_tendsto_zero
  apply tendsto_pi_nhds.mpr
  intro i
  apply tendsto_pi_nhds.mpr
  intro j
  have hr : Tendsto (fun n : ℕ => (A^n) i j) atTop (𝓝 0) := by
    simpa only [Matrix.mulVec_single_one] using
      (tendsto_pi_nhds.mp (h (Pi.single j 1)) i)
  have hc := Complex.continuous_ofReal.continuousAt.tendsto.comp hr
  change Tendsto (fun n : ℕ => ((C2.NGamma.complexify A)^n) i j) atTop (𝓝 0)
  simp_rw [← complexify_pow]
  simpa only [C2.NGamma.complexify, Matrix.map_apply, Function.comp_def,
    Complex.ofReal_zero, Matrix.zero_apply] using hc

/-- The standard spectral/dynamical equivalence for arbitrary real matrices. -/
theorem asymptoticallyStable_iff_schur (A : Matrix ι ι ℝ) :
    AsymptoticallyStable A ↔ C2.NGamma.MatrixSchurStable A :=
  ⟨schur_of_asymptoticallyStable A, asymptoticallyStable_of_schur A⟩

/-- Final internal-stability clause of the realization and aligned-delay
 theorem, stated literally as decay of every augmented-state trajectory. -/
theorem aligned_asymptotic_stability_iff {ι : Type} [Fintype ι] [DecidableEq ι]
    (T : ℝ) (Γ A : Matrix ι ι ℝ) (B C : ι → ℝ) (D k : ℝ)
    {d : ℕ} (hd : 0 < d) (hE : (E T Γ A).det ≠ 0) :
    AsymptoticallyStable
        (Delay.closedLoop (Delay.delay (causalStateSpace T Γ A B C D) d) k) ↔
      ∀ z : ℂ, ((Polynomial.X^d * denominator T Γ A +
        Polynomial.C k * numerator T Γ A B C D).map Complex.ofRealHom).eval z = 0 → ‖z‖ < 1 := by
  rw [asymptoticallyStable_iff_schur, aligned_schur_iff T Γ A B C D k hd hE]

end C2.NGamma.Realization

end

/- ===== C2.GeneralCompletionRealization ===== -/

/-!
# Degree-minimal rational realizations and retained internal modes

The realization premise is an equality of rational transfer functions,
written as a polynomial cross-product, together with state dimension deg D.
The latter is the degree-minimal convention: the lower-bound theorem below
proves that no realization of a coprime quotient can have fewer states.
The characteristic polynomial and decay equivalence are conclusions.
-/
noncomputable section
open Polynomial Matrix
namespace C2.GeneralCompletion
open C2.NGamma.Realization

/-- Every common divisor introduced by the integer delay divides X^m.
Thus even multiplicities of cancelled modes are confined to zero. -/
theorem common_divisor_dvd_delay_power {K : Type*} [Field K]
    {D N Q : Polynomial K} (m : ℕ) (hDN : IsCoprime D N)
    (hQH : Q ∣ Polynomial.X^m * D) (hQN : Q ∣ N) :
    Q ∣ (Polynomial.X : Polynomial K)^m := by
  have hDQ : IsCoprime D Q := hDN.of_isCoprime_of_dvd_right hQN
  exact hDQ.symm.dvd_of_dvd_mul_right hQH

/-- A state-space system realizes the rational quotient N/D. This condition
contains no closed-loop characteristic or stability assumption. -/
def RationalRealization (S : Delay.StateSpace ℝ) (D N : Polynomial ℝ) : Prop :=
  causalNumerator S.A S.B S.C S.D * D = N * S.A.charpoly

/-- The polynomial cross-product indeed gives the ordinary state-space
transfer quotient wherever both sides are defined. -/
theorem realization_transfer_quotient (S : Delay.StateSpace ℝ)
    {D N : Polynomial ℝ} (hreal : RationalRealization S D N) (z : ℝ)
    (hP : S.A.charpoly.eval z ≠ 0) (hD : D.eval z ≠ 0) :
    Delay.transfer S z = N.eval z / D.eval z := by
  have hM : (z • (1 : Matrix S.State S.State ℝ)-S.A).det ≠ 0 := by
    simpa only [charpoly_eval] using hP
  have hq := causalNumerator_quotient S.A S.B S.C S.D z hM
  change Delay.transfer S z = _ at hq
  rw [hq]
  apply (div_eq_div_iff hP hD).mpr
  simpa only [Polynomial.eval_mul] using congrArg (Polynomial.eval z) hreal

theorem denominator_dvd_realization_charpoly (S : Delay.StateSpace ℝ)
    {D N : Polynomial ℝ} (hDN : IsCoprime D N) (hreal : RationalRealization S D N) :
    D ∣ S.A.charpoly := by
  apply hDN.dvd_of_dvd_mul_left
  change D ∣ N * S.A.charpoly
  rw [← hreal]
  exact dvd_mul_left D _

/-- Every realization of a coprime quotient has at least deg D states. -/
theorem realization_dimension_lower_bound (S : Delay.StateSpace ℝ)
    {D N : Polynomial ℝ} (hDN : IsCoprime D N) (hreal : RationalRealization S D N) :
    D.natDegree ≤ Fintype.card S.State := by
  have h := Polynomial.natDegree_le_of_dvd
    (denominator_dvd_realization_charpoly S hDN hreal) (Matrix.charpoly_monic S.A).ne_zero
  simpa using h

/-- Degree minimality and coprimeness recover both uncancelled state-space
polynomials, with the same scalar normalization. -/
theorem minimal_realization_polynomials (S : Delay.StateSpace ℝ)
    {D N : Polynomial ℝ} (hD : D ≠ 0) (hDN : IsCoprime D N)
    (hreal : RationalRealization S D N)
    (hdim : Fintype.card S.State = D.natDegree) :
    D = Polynomial.C D.leadingCoeff * S.A.charpoly ∧
      N = Polynomial.C D.leadingCoeff * causalNumerator S.A S.B S.C S.D := by
  have hl : D.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hD
  have hdiv := denominator_dvd_realization_charpoly S hDN hreal
  have hden : D = Polynomial.C D.leadingCoeff * S.A.charpoly := by
    apply Polynomial.eq_of_dvd_of_natDegree_le_of_leadingCoeff
    · exact dvd_mul_of_dvd_right hdiv _
    · rw [Polynomial.natDegree_C_mul hl, Matrix.charpoly_natDegree_eq_dim, hdim]
    · rw [Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C,
        (Matrix.charpoly_monic S.A).leadingCoeff, mul_one]
  refine ⟨hden, ?_⟩
  apply mul_right_cancel₀ (Matrix.charpoly_monic S.A).ne_zero
  change N * S.A.charpoly =
    (Polynomial.C D.leadingCoeff * causalNumerator S.A S.B S.C S.D) * S.A.charpoly
  calc
    _ = causalNumerator S.A S.B S.C S.D * D := hreal.symm
    _ = causalNumerator S.A S.B S.C S.D * (Polynomial.C D.leadingCoeff * S.A.charpoly) :=
      congrArg (fun p => causalNumerator S.A S.B S.C S.D * p) hden
    _ = _ := by ring

/-- The concrete delayed feedback matrix retains the full, uncancelled
characteristic polynomial stated in the manuscript. -/
theorem minimal_delayed_characteristic (S : Delay.StateSpace ℝ)
    {D N : Polynomial ℝ} (hD : D ≠ 0) (hDN : IsCoprime D N)
    (hreal : RationalRealization S D N)
    (hdim : Fintype.card S.State = D.natDegree)
    {m : ℕ} (hm : 0 < m) (k : ℝ) :
    Polynomial.C D.leadingCoeff * (Delay.closedLoop (Delay.delay S m) k).charpoly =
      Polynomial.X^m * D + Polynomial.C k * N := by
  obtain ⟨hden, hnum⟩ := minimal_realization_polynomials S hD hDN hreal hdim
  calc
    _ = Polynomial.X^m * (Polynomial.C D.leadingCoeff * S.A.charpoly) +
        Polynomial.C k * (Polynomial.C D.leadingCoeff * causalNumerator S.A S.B S.C S.D) := by
      rw [delayed_charpoly S hm k]
      ring
    _ = _ := by rw [← hden, ← hnum]

/-- Actual augmented-state dimension, including all m shift-register states. -/
theorem minimal_delayed_dimension (S : Delay.StateSpace ℝ)
    {D : Polynomial ℝ} (hdim : Fintype.card S.State = D.natDegree) (m : ℕ) :
    Fintype.card (Delay.delay S m).State = D.natDegree + m := by
  rw [Delay.delay_card, hdim]

/-- No internal instability can be hidden by transfer cancellations: the
actual trajectory decay test is equivalent to the full polynomial-root test. -/
theorem minimal_delayed_asymptotic_stability_iff (S : Delay.StateSpace ℝ)
    {D N : Polynomial ℝ} (hD : D ≠ 0) (hDN : IsCoprime D N)
    (hreal : RationalRealization S D N)
    (hdim : Fintype.card S.State = D.natDegree)
    {m : ℕ} (hm : 0 < m) (k : ℝ) :
    AsymptoticallyStable (Delay.closedLoop (Delay.delay S m) k) ↔
      ∀ z : ℂ, ((Polynomial.X^m*D+Polynomial.C k*N).map
        Complex.ofRealHom).eval z = 0 → ‖z‖ < 1 := by
  rw [asymptoticallyStable_iff_schur]
  have hl : (D.leadingCoeff : ℂ) ≠ 0 := by
    exact_mod_cast leadingCoeff_ne_zero.mpr hD
  have hp := congrArg (Polynomial.map Complex.ofRealHom)
    (minimal_delayed_characteristic S hD hDN hreal hdim hm k)
  simp only [Polynomial.map_mul, Polynomial.map_C] at hp
  have he (z : ℂ) :
      ((Polynomial.X^m*D+Polynomial.C k*N).map Complex.ofRealHom).eval z = 0 ↔
        (C2.NGamma.complexify (Delay.closedLoop (Delay.delay S m) k)).charpoly.eval z = 0 := by
    rw [← hp, Polynomial.eval_mul, Polynomial.eval_C, mul_eq_zero]
    simp only [Complex.ofRealHom_eq_coe, hl, false_or]
    rw [← Matrix.charpoly_map _ Complex.ofRealHom]
    rfl
  constructor
  · intro h z hz
    exact h z ((he z).mp hz)
  · intro h z hz
    exact h z ((he z).mpr hz)

end C2.GeneralCompletion

end

/- ===== C2.GeneralCompletionUniform ===== -/

/-!
# Explicit uniform gain bound for the common-parameter rational family

The symbolic coefficient envelopes are polynomials in gamma; evaluating
them recovers the original transformed polynomial. No numerical root test
or sampled parameter bound is assumed.
-/

noncomputable section
open Polynomial Finset
namespace C2.GeneralCompletion

def coefficientAbsSum (p : Polynomial ℝ) : ℝ :=
  ∑ i ∈ Finset.range (p.natDegree + 1), |p.coeff i|

theorem abs_eval_le_coefficientAbsSum (p : Polynomial ℝ) {x : ℝ}
    (hx : |x| ≤ 1) : |p.eval x| ≤ coefficientAbsSum p := by
  rw [eval_eq_sum_range]
  calc
    _ ≤ ∑ i ∈ Finset.range (p.natDegree+1), |p.coeff i*x^i| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ i ∈ Finset.range (p.natDegree+1), |p.coeff i| := by
      apply Finset.sum_le_sum
      intro i hi
      rw [abs_mul, abs_pow]
      exact mul_le_of_le_one_right (abs_nonneg _) (pow_le_one₀ (abs_nonneg _) hx)
    _ = _ := rfl

/-- Some coefficient is large whenever a polynomial is large at a point of
the closed unit interval. The declared degree may exceed the actual degree. -/
theorem exists_coefficient_lower_bound {p : Polynomial ℝ} {d : ℕ}
    (hd : p.natDegree ≤ d) {z μ : ℝ} (hz : |z| ≤ 1) (hμ : 0 < μ)
    (heval : (d+1 : ℝ)*μ ≤ |p.eval z|) :
    ∃ i ≤ d, μ ≤ |p.coeff i| := by
  by_contra h
  push_neg at h
  have he : |p.eval z| ≤ ∑ i ∈ Finset.range (d+1), |p.coeff i| := by
    rw [eval_eq_sum_range' (Nat.lt_succ_of_le hd)]
    apply (abs_sum_le_sum_abs _ _).trans
    apply Finset.sum_le_sum
    intro i hi
    rw [abs_mul, abs_pow]
    exact mul_le_of_le_one_right (abs_nonneg _) (pow_le_one₀ (abs_nonneg _) hz)
  have hs : (∑ i ∈ Finset.range (d+1), |p.coeff i|) <
      ∑ _i ∈ Finset.range (d+1), μ := by
    apply Finset.sum_lt_sum
    · intro i hi
      exact (h i (Nat.le_of_lt_succ (Finset.mem_range.mp hi))).le
    · exact ⟨0, by simp, h 0 (Nat.zero_le d)⟩
  simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul, Nat.cast_add,
    Nat.cast_one] at hs
  linarith

def samplePoint (T s γ : ℝ) : ℝ :=
  (1 + T*(1-γ)*s)/(1-T*γ*s)

theorem samplePoint_bounds {T s γ : ℝ} (hT : 0 < T)
    (hs : -1 ≤ T*s ∧ T*s ≤ 0) (hγ : γ ∈ Set.Icc (0 : ℝ) 1) :
    0 ≤ samplePoint T s γ ∧ samplePoint T s γ ≤ 1 := by
  have hgs : T*γ*s ≤ 0 := by nlinarith [mul_nonpos_of_nonneg_of_nonpos hγ.1 hs.2]
  have hden : 0 < 1-T*γ*s := by linarith
  have hnum : 0 ≤ 1+T*(1-γ)*s := by nlinarith
  constructor
  · exact div_nonneg hnum hden.le
  · apply (div_le_one hden).mpr
    nlinarith

theorem samplePoint_transform {B : Polynomial ℝ} {d : ℕ} (hB : B.natDegree ≤ d)
    {T s γ : ℝ} (hT : 0 < T) (hs : T*s ≤ 0)
    (hγ : 0 ≤ γ) :
    (C2.commonDegreeTransform B d (C2.thetaScale T γ) C2.thetaNumerator).eval
        (samplePoint T s γ) = (T/(1-T*γ*s))^d * B.eval s := by
  have hgs : T*γ*s ≤ 0 := by nlinarith [mul_nonpos_of_nonneg_of_nonpos hγ hs]
  have hden : 0 < 1-T*γ*s := by linarith
  have hscale : (C2.thetaScale T γ).eval (samplePoint T s γ) = T/(1-T*γ*s) := by
    simp only [C2.thetaScale, Polynomial.eval_mul, Polynomial.eval_add,
      Polynomial.eval_C, Polynomial.eval_X, samplePoint]
    field_simp [hden.ne']
    <;> ring
  have hnonzero : (C2.thetaScale T γ).eval (samplePoint T s γ) ≠ 0 := by
    rw [hscale]
    exact div_ne_zero hT.ne' hden.ne'
  rw [C2.commonDegreeTransform_eval_div B d _ _ _ hB hnonzero, hscale]
  congr 2
  simp only [C2.thetaNumerator, Polynomial.eval_sub, Polynomial.eval_X,
    Polynomial.eval_one, samplePoint]
  field_simp [hT.ne', hden.ne']
  <;> ring

/-- Explicit lower bound for a numerator coefficient, uniformly on the
whole admissible gamma interval. -/
theorem transformed_numerator_coefficient_lower_bound
    {B : Polynomial ℝ} {d : ℕ} (hB : B.natDegree ≤ d)
    {T s γ : ℝ} (hT : 0 < T) (hs : -1 ≤ T*s ∧ T*s ≤ 0)
    (hBs : B.eval s ≠ 0) (hγ : γ ∈ Set.Icc (0 : ℝ) 1) :
    ∃ i ≤ d, T^d*|B.eval s| / ((d+1 : ℝ)*(1+T*|s|)^d) ≤
      |(C2.commonDegreeTransform B d (C2.thetaScale T γ) C2.thetaNumerator).coeff i| := by
  let μ := T^d*|B.eval s| / ((d+1 : ℝ)*(1+T*|s|)^d)
  have hsp : s ≤ 0 := by nlinarith
  have hden1 : 0 < 1+T*|s| := by positivity
  have hμ : 0 < μ := by dsimp [μ]; positivity
  have hgs : T*γ*s ≤ 0 := by nlinarith [mul_nonpos_of_nonneg_of_nonpos hγ.1 hs.2]
  have hden : 0 < 1-T*γ*s := by linarith
  have hdenle : 1-T*γ*s ≤ 1+T*|s| := by
    rw [abs_of_nonpos hsp]
    have h := mul_nonpos_of_nonneg_of_nonpos (sub_nonneg.mpr hγ.2) hs.2
    nlinarith
  have hfrac : T/(1+T*|s|) ≤ T/(1-T*γ*s) :=
    div_le_div_of_nonneg_left hT.le hden hdenle
  have hlower : T^d*|B.eval s| /(1+T*|s|)^d ≤
      |(C2.commonDegreeTransform B d (C2.thetaScale T γ) C2.thetaNumerator).eval
        (samplePoint T s γ)| := by
    rw [samplePoint_transform hB hT hs.2 hγ.1, abs_mul, abs_pow,
      abs_of_pos (div_pos hT hden)]
    have hp := pow_le_pow_left₀ (div_nonneg hT.le hden1.le) hfrac d
    have hm := mul_le_mul_of_nonneg_right hp (abs_nonneg (B.eval s))
    simpa [div_pow, div_mul_eq_mul_div] using hm
  apply exists_coefficient_lower_bound
    (C2.commonDegreeTransform_natDegree_le B d _ _
      (C2.thetaScale_natDegree_le T γ) C2.thetaNumerator_natDegree_le)
    (abs_le.mpr ⟨by linarith [(samplePoint_bounds hT hs hγ).1],
      (samplePoint_bounds hT hs hγ).2⟩) hμ
  have hdpos : 0 < (d+1 : ℝ) := by positivity
  have hμeq : (d+1 : ℝ)*μ = T^d*|B.eval s| /(1+T*|s|)^d := by
    dsimp [μ]
    field_simp [hdpos.ne', hden1.ne']
    ring
  rw [hμeq]
  exact hlower

def symbolicTransform (p : Polynomial ℝ) (d : ℕ) (T : ℝ) :
    Polynomial (Polynomial ℝ) :=
  C2.commonDegreeTransform (p.map Polynomial.C) d
    (C2.thetaScale (Polynomial.C T) Polynomial.X) C2.thetaNumerator

theorem symbolicTransform_evaluate (p : Polynomial ℝ) (d : ℕ) (T γ : ℝ) :
    (symbolicTransform p d T).map (Polynomial.evalRingHom γ) =
      C2.commonDegreeTransform p d (C2.thetaScale T γ) C2.thetaNumerator := by
  simp [symbolicTransform, C2.commonDegreeTransform, C2.thetaScale, C2.thetaNumerator,
    Polynomial.map_sum]

def symbolicDelayedDenominator (A : Polynomial ℝ) (d m : ℕ) (T : ℝ) :
    Polynomial (Polynomial ℝ) :=
  Polynomial.X^m * symbolicTransform A d T

theorem symbolicDelayedDenominator_evaluate (A : Polynomial ℝ) (d m : ℕ) (T γ : ℝ) :
    (symbolicDelayedDenominator A d m T).map (Polynomial.evalRingHom γ) =
      Polynomial.X^m * C2.commonDegreeTransform A d (C2.thetaScale T γ) C2.thetaNumerator := by
  simp [symbolicDelayedDenominator, symbolicTransform_evaluate]

def denominatorCoefficientEnvelope (A : Polynomial ℝ) (d m : ℕ) (T : ℝ) : ℝ :=
  (Finset.range (d+1)).sup' ⟨0, by simp⟩
    (fun i => coefficientAbsSum ((symbolicDelayedDenominator A d m T).coeff i))

def leadingCoefficientEnvelope (A : Polynomial ℝ) (d : ℕ) (T : ℝ) : ℝ :=
  coefficientAbsSum ((symbolicTransform A d T).coeff d)

/-- Full explicit uniform real gain bound, with the paper's actual coefficient
one-norm envelopes. Rational input is a specialization of this stronger result.
The node `s` can be any nonzero-evaluation point with `-1 ≤ T*s ≤ 0`. -/
theorem uniform_gain_bound
    (A B : Polynomial ℝ) (d m : ℕ) (T s γ k : ℝ)
    (hB : B.natDegree ≤ d) (hm : 0 < m) (hT : 0 < T)
    (hs : -1 ≤ T*s ∧ T*s ≤ 0) (hBs : B.eval s ≠ 0)
    (hγ : γ ∈ Set.Icc (0 : ℝ) 1) (hk : 0 ≤ k)
    (hdegree : (C2.commonDegreeTransform A d (C2.thetaScale T γ)
      C2.thetaNumerator).coeff d ≠ 0)
    (hstable : ∀ z : ℂ,
      ((Polynomial.X^m * C2.commonDegreeTransform A d (C2.thetaScale T γ)
          C2.thetaNumerator + Polynomial.C k *
        C2.commonDegreeTransform B d (C2.thetaScale T γ) C2.thetaNumerator).map
          Complex.ofRealHom).eval z = 0 → ‖z‖ < 1) :
    k ≤ (denominatorCoefficientEnvelope A d m T +
      leadingCoefficientEnvelope A d T * ((d+m).choose ((d+m)/2) : ℝ)) /
      (T^d*|B.eval s| /((d+1 : ℝ)*(1+T*|s|)^d)) := by
  let D := C2.commonDegreeTransform A d (C2.thetaScale T γ) C2.thetaNumerator
  let N := C2.commonDegreeTransform B d (C2.thetaScale T γ) C2.thetaNumerator
  let H := Polynomial.X^m * D
  have hDle : D.natDegree ≤ d :=
    C2.commonDegreeTransform_natDegree_le A d _ _
      (C2.thetaScale_natDegree_le T γ) C2.thetaNumerator_natDegree_le
  have hDd : D.natDegree = d := natDegree_eq_of_le_of_coeff_ne_zero hDle hdegree
  have hDne : D ≠ 0 := by
    intro he
    apply hdegree
    change D.coeff d = 0
    rw [he, coeff_zero]
  have hHd : H.natDegree = d+m := by
    dsimp [H]
    rw [natDegree_X_pow_mul m hDne, hDd]
  have hNle : N.natDegree ≤ d :=
    C2.commonDegreeTransform_natDegree_le B d _ _
      (C2.thetaScale_natDegree_le T γ) C2.thetaNumerator_natDegree_le
  have hlow : N.natDegree < H.natDegree := by rw [hHd]; omega
  have hμ : 0 < T^d*|B.eval s| /((d+1 : ℝ)*(1+T*|s|)^d) := by positivity
  obtain ⟨i, hi, hcoef⟩ := transformed_numerator_coefficient_lower_bound hB hT hs hBs hγ
  have hγabs : |γ| ≤ 1 := abs_le.mpr ⟨by linarith [hγ.1], hγ.2⟩
  have hHcoef : |H.coeff i| ≤ denominatorCoefficientEnvelope A d m T := by
    have he := congrArg (fun p : Polynomial ℝ => p.coeff i)
      (symbolicDelayedDenominator_evaluate A d m T γ)
    have he' : ((symbolicDelayedDenominator A d m T).coeff i).eval γ = H.coeff i := by
      simpa using he
    rw [← he']
    apply (abs_eval_le_coefficientAbsSum _ hγabs).trans
    exact Finset.le_sup'
      (fun j => coefficientAbsSum ((symbolicDelayedDenominator A d m T).coeff j))
      (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  have hlead : H.leadingCoeff = D.coeff d := by
    calc
      H.leadingCoeff = D.leadingCoeff := by simp [H]
      _ = D.coeff d := by rw [Polynomial.leadingCoeff, hDd]
  have hEcoef : |H.leadingCoeff| ≤ leadingCoefficientEnvelope A d T := by
    have he := congrArg (fun p : Polynomial ℝ => p.coeff d)
      (symbolicTransform_evaluate A d T γ)
    have he' : ((symbolicTransform A d T).coeff d).eval γ = D.coeff d := by
      simpa using he
    rw [hlead, ← he']
    exact abs_eval_le_coefficientAbsSum _ hγabs
  exact affine_gain_bound hk hμ hcoef hHcoef hEcoef hHd hlow
    (fun z hz => le_of_lt (hstable z hz))

/-- A nonzero degree-at-most-d polynomial has a nonvanishing value among any
d+1 distinct proposed nodes. -/
theorem exists_nonzero_node {K : Type*} [Field K] {d : ℕ}
    (B : Polynomial K) (hB : B ≠ 0) (hd : B.natDegree ≤ d)
    (s : Fin (d+1) → K) (hs : Function.Injective s) :
    ∃ j, B.eval (s j) ≠ 0 := by
  by_contra h
  push_neg at h
  apply hB
  exact Polynomial.eq_zero_of_natDegree_lt_card_of_eval_eq_zero B hs h
    (by simpa using Nat.lt_succ_of_le hd)

/-- The paper's particular d+1 negative nodes always include a nonzero
numerator value, and each node lies in the interval required above. -/
theorem exists_paper_node {B : Polynomial ℝ} {d : ℕ} {T : ℝ}
    (hB : B ≠ 0) (hd : B.natDegree ≤ d) (hT : 0 < T) :
    ∃ j : ℕ, 1 ≤ j ∧ j ≤ d+1 ∧ B.eval (-1/((j : ℝ)*T)) ≠ 0 ∧
      -1 ≤ T*(-1/((j : ℝ)*T)) ∧ T*(-1/((j : ℝ)*T)) ≤ 0 := by
  let s : Fin (d+1) → ℝ := fun i => -1/(((i.val : ℝ)+1)*T)
  have hs : Function.Injective s := by
    intro i j hij
    have hi : 0 < ((i.val : ℝ)+1)*T := by positivity
    have hj : 0 < ((j.val : ℝ)+1)*T := by positivity
    have he := (div_eq_div_iff hi.ne' hj.ne').mp hij
    have he' : (i.val : ℝ) = (j.val : ℝ) := by nlinarith
    apply Fin.ext
    exact_mod_cast he'
  obtain ⟨i, hi⟩ := exists_nonzero_node B hB hd s hs
  refine ⟨i.val+1, by omega, by have := i.isLt; omega, ?_, ?_, ?_⟩
  · simpa [s] using hi
  all_goals
    have hj : 0 < ((i.val+1 : ℕ) : ℝ) := by positivity
    have he : T*(-1/((((i.val+1 : ℕ) : ℝ))*T)) =
        -1/(((i.val+1 : ℕ) : ℝ)) := by field_simp [hT.ne', hj.ne']; ring
    rw [he]
  · apply (le_div_iff₀ hj).mpr
    have hn : (1 : ℝ) ≤ ((i.val+1 : ℕ) : ℝ) := by
      exact_mod_cast Nat.succ_le_succ (Nat.zero_le i.val)
    linarith
  · exact div_nonpos_of_nonpos_of_nonneg (by norm_num) hj.le

/-- The integer ceiling prescription is a strict search bound. -/
theorem strict_search_bound {k K₀ : ℝ} (h : k ≤ K₀) : k < (⌈K₀⌉ : ℝ)+1 := by
  have hc : K₀ ≤ (⌈K₀⌉ : ℝ) := Int.le_ceil K₀
  linarith

end C2.GeneralCompletion

end

/- ===== C2.IntegratorDelayAmplitude ===== -/

noncomputable section
namespace C2.IntegratorDelay

def amplitude (x t : ℝ) : ℝ := 2 * t / Real.sqrt (1 + (x * t) ^ 2)

theorem amplitude_den_pos (x t : ℝ) : 0 < Real.sqrt (1 + (x * t) ^ 2) := by positivity

@[simp] theorem amplitude_zero (x : ℝ) : amplitude x 0 = 0 := by simp [amplitude]

theorem amplitude_nonneg (x : ℝ) {t : ℝ} (ht : 0 ≤ t) : 0 ≤ amplitude x t := by
  unfold amplitude
  positivity

theorem amplitude_pos (x : ℝ) {t : ℝ} (ht : 0 < t) : 0 < amplitude x t := by
  unfold amplitude
  positivity

theorem amplitude_continuous (x : ℝ) : Continuous (amplitude x) := by
  unfold amplitude
  exact (continuous_const.mul continuous_id).div
    ((continuous_const.add ((continuous_const.mul continuous_id).pow 2)).sqrt)
    (fun t => (amplitude_den_pos x t).ne')

theorem amplitude_sq (x t : ℝ) :
    amplitude x t ^ 2 = 4 * t ^ 2 / (1 + (x * t) ^ 2) := by
  unfold amplitude
  rw [div_pow, mul_pow, Real.sq_sqrt (by positivity)]
  ring

theorem amplitude_strictMonoOn (x : ℝ) : StrictMonoOn (amplitude x) (Set.Ici 0) := by
  intro s hs t ht hst
  change 0 ≤ s at hs
  change 0 ≤ t at ht
  have hsq : s ^ 2 < t ^ 2 := by nlinarith only [hs, hst]
  have hab : amplitude x s ^ 2 < amplitude x t ^ 2 := by
    rw [amplitude_sq, amplitude_sq]
    apply (div_lt_div_iff₀ (by positivity) (by positivity)).mpr
    nlinarith only [hsq]
  nlinarith only [hab, amplitude_nonneg x hs, amplitude_nonneg x ht]

theorem amplitude_endpoint_bound (x : ℝ) {t : ℝ} (ht : 0 ≤ t) :
    amplitude x t * |x| < 2 := by
  have hsq : amplitude x t ^ 2 * x ^ 2 < 4 := by
    rw [amplitude_sq]
    have he : 4 * t ^ 2 / (1 + (x * t) ^ 2) * x ^ 2 =
        4 * (x * t) ^ 2 / (1 + (x * t) ^ 2) := by ring
    rw [he]
    apply (div_lt_iff₀ (by positivity)).mpr
    linarith
  have habs := sq_abs x
  have hid : (amplitude x t * |x|) ^ 2 = amplitude x t ^ 2 * x ^ 2 := by
    rw [mul_pow, habs]
  nlinarith only [hsq, hid, mul_nonneg (amplitude_nonneg x ht) (abs_nonneg x)]

def amplitudeCrossing (x a : ℝ) : ℝ := a / Real.sqrt (4 - a ^ 2 * x ^ 2)

theorem crossing_radicand_pos {x a : ℝ} (ha : 0 < a) (hax : a * |x| < 2) :
    0 < 4 - a ^ 2 * x ^ 2 := by
  have hn : 0 ≤ a * |x| := mul_nonneg ha.le (abs_nonneg x)
  have hs : (a * |x|) ^ 2 = a ^ 2 * x ^ 2 := by rw [mul_pow, sq_abs]
  nlinarith only [ha, hax, hn, hs]

theorem amplitudeCrossing_pos {x a : ℝ} (ha : 0 < a) (hax : a * |x| < 2) :
    0 < amplitudeCrossing x a := by
  unfold amplitudeCrossing
  exact div_pos ha (Real.sqrt_pos.mpr (crossing_radicand_pos ha hax))

theorem amplitude_at_crossing {x a : ℝ} (ha : 0 < a) (hax : a * |x| < 2) :
    amplitude x (amplitudeCrossing x a) = a := by
  have hr := crossing_radicand_pos ha hax
  have ht := amplitudeCrossing_pos ha hax
  have he : amplitudeCrossing x a ^ 2 = a ^ 2 / (4 - a ^ 2 * x ^ 2) := by
    unfold amplitudeCrossing
    rw [div_pow, Real.sq_sqrt hr.le]
  have hsq : amplitude x (amplitudeCrossing x a) ^ 2 = a ^ 2 := by
    rw [amplitude_sq, mul_pow, he]
    field_simp
    <;> ring
  nlinarith only [hsq, amplitude_pos x ht, ha]

theorem existsUnique_amplitude_crossing {x a : ℝ} (ha : 0 < a) (hax : a * |x| < 2) :
    ∃! t : ℝ, 0 < t ∧ amplitude x t = a := by
  refine ⟨amplitudeCrossing x a, ⟨amplitudeCrossing_pos ha hax, amplitude_at_crossing ha hax⟩, ?_⟩
  intro y hy
  exact (amplitude_strictMonoOn x).injOn hy.1.le (amplitudeCrossing_pos ha hax).le
    (hy.2.trans (amplitude_at_crossing ha hax).symm)

theorem amplitude_lt_gain_iff {x a t : ℝ} (ha : 0 < a) (hax : a * |x| < 2)
    (ht : 0 ≤ t) : amplitude x t < a ↔ t < amplitudeCrossing x a := by
  conv_lhs => rw [← amplitude_at_crossing ha hax]
  exact (amplitude_strictMonoOn x).lt_iff_lt ht (amplitudeCrossing_pos ha hax).le

end C2.IntegratorDelay

end

/- ===== C2.IntegratorDelayGain ===== -/

noncomputable section
namespace C2.IntegratorDelay

def lowerFrequency (n : ℕ) : ℝ := Real.pi / (2 * (n : ℝ) + 1)
def upperFrequency (n : ℕ) : ℝ := Real.pi / (2 * (n : ℝ) - 1)
def boundaryGain (n : ℕ) (w : ℝ) : ℝ :=
  2 * Real.tan (w / 2) * Real.sin ((n : ℝ) * w)

theorem frequency_bounds {n : ℕ} (hn : 2 ≤ n) {w : ℝ}
    (hw : w ∈ Set.Icc (lowerFrequency n) (upperFrequency n)) :
    0 < w ∧ w ≤ Real.pi / 3 ∧
      0 < (n : ℝ) * w ∧ (n : ℝ) * w < Real.pi ∧
      (n : ℝ) * w ≤ Real.pi / 2 + w / 2 := by
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hlo : 0 < lowerFrequency n := by unfold lowerFrequency; positivity
  have hw0 : 0 < w := lt_of_lt_of_le hlo hw.1
  have hd : 0 < 2 * (n : ℝ) - 1 := by linarith
  have hmul : w * (2 * (n : ℝ) - 1) ≤ Real.pi :=
    (le_div_iff₀ hd).mp hw.2
  have hwpi : w ≤ Real.pi / 3 := by nlinarith
  refine ⟨hw0, hwpi, mul_pos (by linarith) hw0, ?_, ?_⟩
  · nlinarith [Real.pi_pos]
  · linarith

theorem boundaryGain_hasDerivAt (n : ℕ) {w : ℝ}
    (hc : Real.cos (w / 2) ≠ 0) :
    HasDerivAt (boundaryGain n)
      ((Real.sin ((n : ℝ) * w) +
        (n : ℝ) * Real.sin w * Real.cos ((n : ℝ) * w)) /
          Real.cos (w / 2) ^ 2) w := by
  have ht := (Real.hasDerivAt_tan hc).comp w ((hasDerivAt_id w).div_const 2)
  have hs := (Real.hasDerivAt_sin ((n : ℝ) * w)).comp w
    ((hasDerivAt_id w).const_mul (n : ℝ))
  have h := (ht.const_mul 2).mul hs
  convert h using 1
  simp only [Function.comp_apply, id_eq, one_div, mul_one, Real.tan_eq_sin_div_cos]
  have hdouble : Real.sin w = 2 * Real.sin (w / 2) * Real.cos (w / 2) := by
    convert Real.sin_two_mul (w / 2) using 1 <;> ring
  rw [hdouble]
  field_simp [hc]
  ring

/-- The numerator of the derivative has a useful lower bound past its midpoint. -/
theorem gain_derivative_numerator_lower {n : ℕ} (hn : 2 ≤ n) {w : ℝ}
    (hw : w ∈ Set.Icc (lowerFrequency n) (upperFrequency n))
    (hmid : Real.pi / 2 ≤ (n : ℝ) * w) :
    Real.cos (w / 2) * (1 - 2 * (n : ℝ) * Real.sin (w / 2) ^ 2) ≤
      Real.sin ((n : ℝ) * w) +
        (n : ℝ) * Real.sin w * Real.cos ((n : ℝ) * w) := by
  obtain ⟨hw0, hwpi, hnw0, hnwpi, hup⟩ := frequency_bounds hn hw
  let η := (n : ℝ) * w - Real.pi / 2
  have hη0 : 0 ≤ η := by dsimp [η]; linarith
  have hη : η ≤ w / 2 := by dsimp [η]; linarith
  have hc := Real.cos_le_cos_of_nonneg_of_le_pi hη0
    (show w / 2 ≤ Real.pi by linarith [Real.pi_pos]) hη
  have hs := Real.sin_le_sin_of_le_of_le_pi_div_two
    (le_trans (show -(Real.pi / 2) ≤ 0 by linarith [Real.pi_pos]) hη0)
    (show w / 2 ≤ Real.pi / 2 by linarith [Real.pi_pos]) hη
  have hsin : 0 ≤ Real.sin w :=
    Real.sin_nonneg_of_nonneg_of_le_pi hw0.le (by linarith [Real.pi_pos])
  have hn' : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have hmul := mul_le_mul_of_nonneg_left hs (mul_nonneg hn' hsin)
  have hid1 : Real.sin ((n : ℝ) * w) = Real.cos η := by
    dsimp [η]
    rw [Real.cos_sub, Real.cos_pi_div_two, Real.sin_pi_div_two]
    ring
  have hid2 : Real.cos ((n : ℝ) * w) = -Real.sin η := by
    dsimp [η]
    rw [Real.sin_sub, Real.cos_pi_div_two, Real.sin_pi_div_two]
    ring
  have hdouble : Real.sin w = 2 * Real.sin (w / 2) * Real.cos (w / 2) := by
    convert Real.sin_two_mul (w / 2) using 1 <;> ring
  rw [hid1, hid2]
  rw [hdouble] at hmul ⊢
  nlinarith only [hmul, hc]

theorem gain_sine_bracket_pos {n : ℕ} (hn : 2 ≤ n) {w : ℝ}
    (hw : w ∈ Set.Icc (lowerFrequency n) (upperFrequency n))
    (hstrict : n = 2 → w < upperFrequency n) :
    0 < 1 - 2 * (n : ℝ) * Real.sin (w / 2) ^ 2 := by
  obtain ⟨hw0, hwpi, _, _, _⟩ := frequency_bounds hn hw
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  by_cases hn2 : n = 2
  · subst n
    have hwp : w < Real.pi / 3 := by
      have h := hstrict rfl
      norm_num [upperFrequency] at h
      exact h
    have hs := Real.sin_lt_sin_of_lt_of_le_pi_div_two
      (show -(Real.pi / 2) ≤ w / 2 by linarith [Real.pi_pos])
      (show Real.pi / 6 ≤ Real.pi / 2 by linarith [Real.pi_pos])
      (show w / 2 < Real.pi / 6 by linarith)
    rw [Real.sin_pi_div_six] at hs
    have hs0 : 0 ≤ Real.sin (w / 2) :=
      Real.sin_nonneg_of_nonneg_of_le_pi (by linarith) (by linarith [Real.pi_pos])
    norm_num
    nlinarith
  · have hn3 : (3 : ℝ) ≤ n := by exact_mod_cast (show 3 ≤ n by omega)
    have hd : 0 < 2 * (n : ℝ) - 1 := by linarith
    have hbound : w * (2 * (n : ℝ) - 1) ≤ Real.pi :=
      (le_div_iff₀ hd).mp hw.2
    have hsq : w ^ 2 * (2 * (n : ℝ) - 1) ^ 2 ≤ Real.pi ^ 2 := by
      nlinarith [sq_le_sq₀ (mul_pos hw0 hd).le Real.pi_pos.le |>.mpr hbound]
    have hpi : Real.pi ^ 2 < 10 := by
      nlinarith [Real.pi_pos, Real.pi_lt_d2]
    have hnpi := mul_lt_mul_of_pos_left hpi (show (0 : ℝ) < n by linarith)
    have hpoly : (n : ℝ) * Real.pi ^ 2 < 2 * (2 * (n : ℝ) - 1) ^ 2 := by
      nlinarith [sq_nonneg ((n : ℝ) - 3)]
    have hmul := mul_le_mul_of_nonneg_left hsq (Nat.cast_nonneg n : (0 : ℝ) ≤ n)
    have hneg : ((n : ℝ) * w ^ 2 - 2) * (2 * (n : ℝ) - 1) ^ 2 < 0 := by
      nlinarith
    have hsmall : (n : ℝ) * w ^ 2 < 2 := by
      by_contra! hb
      have hnon := mul_nonneg (show 0 ≤ (n : ℝ) * w ^ 2 - 2 by linarith)
        (sq_nonneg (2 * (n : ℝ) - 1))
      linarith
    have hs := mul_le_mul_of_nonneg_left (Real.sin_sq_le_sq (x := w / 2))
      (show 0 ≤ 2 * (n : ℝ) by positivity)
    nlinarith

theorem boundaryGain_deriv_pos {n : ℕ} (hn : 2 ≤ n) {w : ℝ}
    (hw : w ∈ Set.Icc (lowerFrequency n) (upperFrequency n))
    (hstrict : n = 2 → w < upperFrequency n) :
    0 < deriv (boundaryGain n) w := by
  obtain ⟨hw0, hwpi, hnw0, hnwpi, hup⟩ := frequency_bounds hn hw
  have hc : 0 < Real.cos (w / 2) := Real.cos_pos_of_mem_Ioo
    ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩
  rw [(boundaryGain_hasDerivAt n hc.ne').deriv]
  apply div_pos _ (sq_pos_of_pos hc)
  by_cases hmid : Real.pi / 2 ≤ (n : ℝ) * w
  · exact lt_of_lt_of_le (mul_pos hc (gain_sine_bracket_pos hn hw hstrict))
      (gain_derivative_numerator_lower hn hw hmid)
  · have hcos : 0 ≤ Real.cos ((n : ℝ) * w) :=
      Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], by linarith⟩
    have hsin : 0 ≤ Real.sin w :=
      Real.sin_nonneg_of_nonneg_of_le_pi hw0.le (by linarith [Real.pi_pos])
    exact add_pos_of_pos_of_nonneg (Real.sin_pos_of_pos_of_lt_pi hnw0 hnwpi)
      (mul_nonneg (mul_nonneg (Nat.cast_nonneg n) hsin) hcos)

/-- `lem:gainmonotone`: strict increase on the entire closed frequency interval. -/
theorem boundaryGain_strictMonoOn {n : ℕ} (hn : 2 ≤ n) :
    StrictMonoOn (boundaryGain n) (Set.Icc (lowerFrequency n) (upperFrequency n)) := by
  apply strictMonoOn_of_deriv_pos (convex_Icc _ _) ?_ ?_
  · intro w hw
    obtain ⟨hw0, hwpi, _, _, _⟩ := frequency_bounds hn hw
    have hc : 0 < Real.cos (w / 2) := Real.cos_pos_of_mem_Ioo
      ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩
    exact (boundaryGain_hasDerivAt n hc.ne').continuousAt.continuousWithinAt
  · intro w hw
    rw [interior_Icc] at hw
    exact boundaryGain_deriv_pos hn ⟨hw.1.le, hw.2.le⟩ (fun _ => hw.2)

theorem boundaryGain_deriv_two_upper :
    deriv (boundaryGain 2) (upperFrequency 2) = 0 := by
  have hw : upperFrequency 2 = Real.pi / 3 := by norm_num [upperFrequency]
  rw [hw]
  have hc : Real.cos ((Real.pi / 3) / 2) ≠ 0 :=
    (Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩).ne'
  rw [(boundaryGain_hasDerivAt 2 hc).deriv]
  have hsin := Real.sin_two_mul (Real.pi / 3)
  have hcos := Real.cos_two_mul (Real.pi / 3)
  rw [Real.cos_pi_div_three] at hsin hcos
  norm_num at hsin hcos
  norm_num only [Nat.cast_ofNat]
  apply div_eq_zero_iff.mpr
  left
  rw [hsin, hcos, Real.sin_pi_div_three]
  ring

end C2.IntegratorDelay

end

/- ===== C2.IntegratorDelayPhase ===== -/

noncomputable section
namespace C2.IntegratorDelay

/-- Centered-chord phase; `x = 2γ − 1`. On `0 < w < π` this is
`(n+1/2)w − arg(1−γ+γ exp(iw))`. -/
def lowPhase (n : ℕ) (x w : ℝ) : ℝ :=
  (n : ℝ) * w - Real.arctan (x * Real.tan (w / 2))

def totalPhase (n : ℕ) (x t : ℝ) : ℝ :=
  2 * (n : ℝ) * Real.arctan t + Real.pi / 2 - Real.arctan (x * t)

theorem totalPhase_eq_lowPhase (n : ℕ) (x t : ℝ) :
    totalPhase n x t = lowPhase n x (2 * Real.arctan t) + Real.pi / 2 := by
  simp only [totalPhase, lowPhase]
  have h : 2 * Real.arctan t / 2 = Real.arctan t := by ring
  rw [h, Real.tan_arctan]
  ring

theorem lowPhase_hasDerivAt (n : ℕ) (x : ℝ) {w : ℝ}
    (hc : Real.cos (w / 2) ≠ 0) :
    HasDerivAt (lowPhase n x)
      ((n : ℝ) - x / (2 * Real.cos (w / 2) ^ 2 *
        (1 + (x * Real.tan (w / 2)) ^ 2))) w := by
  have ht := (Real.hasDerivAt_tan hc).comp w ((hasDerivAt_id w).div_const 2)
  have ha := (Real.hasDerivAt_arctan (x * Real.tan (w / 2))).comp w (ht.const_mul x)
  convert ((hasDerivAt_id w).const_mul (n : ℝ)).sub ha using 1
  simp only [mul_one]
  field_simp
  ring

theorem lowPhase_deriv_pos {n : ℕ} (hn : 2 ≤ n) {x w : ℝ} (hx : x ≤ 1)
    (hw : w ∈ Set.Icc 0 (Real.pi / 2)) : 0 < deriv (lowPhase n x) w := by
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hw0 := hw.1
  have hw1 := hw.2
  have hc : 0 < Real.cos (w / 2) := Real.cos_pos_of_mem_Ioo
    ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩
  have hcos : 0 ≤ Real.cos w := Real.cos_nonneg_of_mem_Icc
    ⟨by linarith [Real.pi_pos], hw.2⟩
  have hdouble : Real.cos w = 2 * Real.cos (w / 2) ^ 2 - 1 := by
    convert Real.cos_two_mul (w / 2) using 1 <;> ring
  have hc2 : 1 / 2 ≤ Real.cos (w / 2) ^ 2 := by linarith
  have hd : 0 < 2 * Real.cos (w / 2) ^ 2 *
      (1 + (x * Real.tan (w / 2)) ^ 2) := by positivity
  have hd1 : 1 ≤ 2 * Real.cos (w / 2) ^ 2 *
      (1 + (x * Real.tan (w / 2)) ^ 2) := by
    nlinarith [mul_nonneg (sq_nonneg (Real.cos (w / 2)))
      (sq_nonneg (x * Real.tan (w / 2)))]
  have hdiv : x / (2 * Real.cos (w / 2) ^ 2 *
      (1 + (x * Real.tan (w / 2)) ^ 2)) ≤ 1 :=
    (div_le_one hd).2 (le_trans hx hd1)
  rw [(lowPhase_hasDerivAt n x hc.ne').deriv]
  linarith

theorem lowPhase_strictMonoOn {n : ℕ} (hn : 2 ≤ n) {x : ℝ} (hx : x ≤ 1) :
    StrictMonoOn (lowPhase n x) (Set.Icc 0 (Real.pi / 2)) := by
  apply strictMonoOn_of_deriv_pos (convex_Icc _ _) ?_ ?_
  · intro w hw
    have hw0 := hw.1
    have hw1 := hw.2
    have hc : 0 < Real.cos (w / 2) := Real.cos_pos_of_mem_Ioo
      ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩
    exact (lowPhase_hasDerivAt n x hc.ne').continuousAt.continuousWithinAt
  · intro w hw
    exact lowPhase_deriv_pos hn hx (interior_subset hw)

theorem lowPhase_chord_bounds {n : ℕ} {x w : ℝ}
    (hx0 : -1 ≤ x) (hx1 : x ≤ 1) (hw0 : 0 ≤ w) (hwpi : w < Real.pi) :
    ((n : ℝ) - 1 / 2) * w ≤ lowPhase n x w ∧
      lowPhase n x w ≤ ((n : ℝ) + 1 / 2) * w := by
  have ht : 0 ≤ Real.tan (w / 2) :=
    Real.tan_nonneg_of_nonneg_of_le_pi_div_two (by linarith) (by linarith)
  have hlo : -Real.tan (w / 2) ≤ x * Real.tan (w / 2) := by nlinarith
  have hhi : x * Real.tan (w / 2) ≤ Real.tan (w / 2) := by nlinarith
  have ha1 := Real.arctan_le_arctan hlo
  have ha2 := Real.arctan_le_arctan hhi
  have hid : Real.arctan (Real.tan (w / 2)) = w / 2 :=
    Real.arctan_tan (by linarith [Real.pi_pos]) (by linarith)
  rw [Real.arctan_neg, hid] at ha1
  rw [hid] at ha2
  unfold lowPhase
  constructor <;> nlinarith

theorem frequency_interval_order {n : ℕ} (hn : 2 ≤ n) :
    lowerFrequency n ≤ upperFrequency n := by
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  unfold lowerFrequency upperFrequency
  apply (div_le_div_iff₀ (by positivity) (by linarith)).2
  nlinarith [Real.pi_pos]

/-- Existence and uniqueness of the manuscript's first frequency branch. -/
theorem existsUnique_low_frequency {n : ℕ} (hn : 2 ≤ n) {x : ℝ}
    (hx0 : -1 ≤ x) (hx1 : x ≤ 1) :
    ∃! w : ℝ, w ∈ Set.Icc (lowerFrequency n) (upperFrequency n) ∧
      lowPhase n x w = Real.pi / 2 := by
  have horder := frequency_interval_order hn
  have hl := frequency_bounds hn (show lowerFrequency n ∈
    Set.Icc (lowerFrequency n) (upperFrequency n) from ⟨le_rfl, horder⟩)
  have hu := frequency_bounds hn (show upperFrequency n ∈
    Set.Icc (lowerFrequency n) (upperFrequency n) from ⟨horder, le_rfl⟩)
  have hlo := (lowPhase_chord_bounds (n := n) hx0 hx1 hl.1.le
    (show lowerFrequency n < Real.pi by linarith [hl.2.1, Real.pi_pos])).2
  have hhi := (lowPhase_chord_bounds (n := n) hx0 hx1 hu.1.le
    (show upperFrequency n < Real.pi by linarith [hu.2.1, Real.pi_pos])).1
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have helo : ((n : ℝ) + 1 / 2) * lowerFrequency n = Real.pi / 2 := by
    unfold lowerFrequency
    field_simp
    ring
  have hehi : ((n : ℝ) - 1 / 2) * upperFrequency n = Real.pi / 2 := by
    unfold upperFrequency
    have hd : 2 * (n : ℝ) - 1 ≠ 0 := by linarith
    field_simp
    ring
  rw [helo] at hlo
  rw [hehi] at hhi
  have hcont : ContinuousOn (lowPhase n x)
      (Set.Icc (lowerFrequency n) (upperFrequency n)) := by
    intro w hw
    have hw' := frequency_bounds hn hw
    have hc : 0 < Real.cos (w / 2) := Real.cos_pos_of_mem_Ioo
      ⟨by linarith [hw'.1, Real.pi_pos], by linarith [hw'.2.1, Real.pi_pos]⟩
    exact (lowPhase_hasDerivAt n x hc.ne').continuousAt.continuousWithinAt
  obtain ⟨w, hw, he⟩ := intermediate_value_Icc horder hcont ⟨hlo, hhi⟩
  refine ⟨w, ⟨hw, he⟩, ?_⟩
  intro v hv
  have hw' := frequency_bounds hn hw
  have hv' := frequency_bounds hn hv.1
  apply (lowPhase_strictMonoOn hn hx1).injOn
    ⟨hv'.1.le, by linarith [hv'.2.1, Real.pi_pos]⟩
    ⟨hw'.1.le, by linarith [hw'.2.1, Real.pi_pos]⟩
  exact hv.2.trans he.symm

def frequency (n : ℕ) (x : ℝ) : ℝ :=
  if h : 2 ≤ n ∧ -1 ≤ x ∧ x ≤ 1 then
    Classical.choose (existsUnique_low_frequency h.1 h.2.1 h.2.2)
  else 0

theorem frequency_spec {n : ℕ} (hn : 2 ≤ n) {x : ℝ}
    (hx0 : -1 ≤ x) (hx1 : x ≤ 1) :
    frequency n x ∈ Set.Icc (lowerFrequency n) (upperFrequency n) ∧
      lowPhase n x (frequency n x) = Real.pi / 2 := by
  simp only [frequency, dif_pos (show 2 ≤ n ∧ -1 ≤ x ∧ x ≤ 1 from ⟨hn, hx0, hx1⟩)]
  exact (Classical.choose_spec (existsUnique_low_frequency hn hx0 hx1)).1

theorem lowPhase_strictAnti_parameter {n : ℕ} {x y w : ℝ}
    (hxy : x < y) (hw0 : 0 < w) (hwpi : w < Real.pi) :
    lowPhase n y w < lowPhase n x w := by
  have ht : 0 < Real.tan (w / 2) :=
    Real.tan_pos_of_pos_of_lt_pi_div_two (by linarith) (by linarith)
  have h := Real.arctan_lt_arctan (mul_lt_mul_of_pos_right hxy ht)
  unfold lowPhase
  linarith

theorem frequency_strictMonoOn {n : ℕ} (hn : 2 ≤ n) :
    StrictMonoOn (frequency n) (Set.Icc (-1) 1) := by
  intro x hx y hy hxy
  have hfx := frequency_spec hn hx.1 hx.2
  have hfy := frequency_spec hn hy.1 hy.2
  have hbx := frequency_bounds hn hfx.1
  have hby := frequency_bounds hn hfy.1
  have hp := lowPhase_strictAnti_parameter (n := n) hxy hbx.1
    (show frequency n x < Real.pi by linarith [hbx.2.1, Real.pi_pos])
  rw [hfx.2, ← hfy.2] at hp
  exact (lowPhase_strictMonoOn hn hy.2).lt_iff_lt
    ⟨hbx.1.le, by linarith [hbx.2.1, Real.pi_pos]⟩
    ⟨hby.1.le, by linarith [hby.2.1, Real.pi_pos]⟩ |>.mp hp

theorem lowPhase_lt_halfpi_iff {n : ℕ} (hn : 2 ≤ n) {x w : ℝ}
    (hx0 : -1 ≤ x) (hx1 : x ≤ 1) (hw0 : 0 < w) (hwpi : w < Real.pi) :
    lowPhase n x w < Real.pi / 2 ↔ w < frequency n x := by
  have hf := frequency_spec hn hx0 hx1
  have hbf := frequency_bounds hn hf.1
  by_cases hw : w ≤ upperFrequency n
  · have hu := frequency_bounds hn ⟨frequency_interval_order hn, le_rfl⟩
    rw [← hf.2]
    exact (lowPhase_strictMonoOn hn hx1).lt_iff_lt
      ⟨hw0.le, by linarith [hu.2.1, Real.pi_pos]⟩
      ⟨hbf.1.le, by linarith [hbf.2.1, Real.pi_pos]⟩
  · have hwu : upperFrequency n < w := lt_of_not_ge hw
    have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
    have hd : 0 < 2 * (n : ℝ) - 1 := by linarith
    have hgt : Real.pi < w * (2 * (n : ℝ) - 1) := (div_lt_iff₀ hd).mp hwu
    have hp := (lowPhase_chord_bounds (n := n) hx0 hx1 hw0.le hwpi).1
    exact iff_of_false (by linarith) (by linarith [hf.1.2])

theorem totalPhase_pos {n : ℕ} (hn : 2 ≤ n) {x t : ℝ}
    (hx : x ≤ 1) (ht : 0 ≤ t) : 0 < totalPhase n x t := by
  have hmul : x * t ≤ t := by nlinarith
  have ha := Real.arctan_le_arctan hmul
  have ht0 : 0 ≤ Real.arctan t := by simpa using Real.arctan_le_arctan ht
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  unfold totalPhase
  nlinarith [Real.pi_pos]

theorem totalPhase_lt_pi_iff {n : ℕ} (hn : 2 ≤ n) {x t : ℝ}
    (hx0 : -1 ≤ x) (hx1 : x ≤ 1) (ht : 0 < t) :
    totalPhase n x t < Real.pi ↔ 2 * Real.arctan t < frequency n x := by
  have hat : 0 < Real.arctan t := by simpa using Real.arctan_lt_arctan ht
  have hapi := Real.arctan_lt_pi_div_two t
  rw [totalPhase_eq_lowPhase]
  have h := lowPhase_lt_halfpi_iff hn hx0 hx1
    (show 0 < 2 * Real.arctan t by positivity) (show 2 * Real.arctan t < Real.pi by linarith)
  convert h using 1 <;> constructor <;> intro hh <;> linarith

end C2.IntegratorDelay

end

/- ===== C2.NGammaPhaseScale ===== -/

/-! Elementary arctangent scale inequalities used by the arbitrary-order
normalized phase lemma. No assumptions about root counts or stability occur. -/

noncomputable section

namespace C2.NGamma.PhaseScale

def elasticityReciprocal (s : ℝ) : ℝ := (1 + s ^ 2) / s * Real.arctan s

theorem arctan_pos {s : ℝ} (hs : 0 < s) : 0 < Real.arctan s := by
  simpa only [Real.arctan_zero] using Real.arctan_strictMono hs

theorem arctan_lt_self {s : ℝ} (hs : 0 < s) : Real.arctan s < s := by
  simpa only [Real.tan_arctan] using
    Real.lt_tan (arctan_pos hs) (Real.arctan_lt_pi_div_two s)

theorem elasticityReciprocal_hasDerivAt {s : ℝ} (hs : 0 < s) :
    HasDerivAt elasticityReciprocal
      ((s ^ 2 * Real.arctan s + (s - Real.arctan s)) / s ^ 2) s := by
  have hn : s ≠ 0 := ne_of_gt hs
  have h := (((hasDerivAt_id s).pow 2).const_add 1).div (hasDerivAt_id s) hn
  convert h.mul (Real.hasDerivAt_arctan s) using 1 <;>
    simp only [elasticityReciprocal, id_eq] <;> field_simp <;> ring

theorem elasticityReciprocal_deriv_pos {s : ℝ} (hs : 0 < s) :
    0 < deriv elasticityReciprocal s := by
  rw [(elasticityReciprocal_hasDerivAt hs).deriv]
  exact div_pos (add_pos_of_nonneg_of_pos
    (mul_nonneg (sq_nonneg s) (le_of_lt (arctan_pos hs)))
    (sub_pos.mpr (arctan_lt_self hs))) (sq_pos_of_pos hs)

theorem elasticityReciprocal_strictMonoOn :
    StrictMonoOn elasticityReciprocal (Set.Ioi 0) := by
  apply strictMonoOn_of_deriv_pos (convex_Ioi 0)
  · intro s hs
    exact (elasticityReciprocal_hasDerivAt hs).continuousAt.continuousWithinAt
  · intro s hs
    exact elasticityReciprocal_deriv_pos (by simpa using hs)

def scaleRatio (c u : ℝ) : ℝ := Real.arctan (c * u) / Real.arctan u

theorem scaleRatio_hasDerivAt {c u : ℝ} (hc : 0 < c) (hu : 0 < u) :
    HasDerivAt (scaleRatio c)
      (c * u * (elasticityReciprocal u - elasticityReciprocal (c * u)) /
        ((1 + u ^ 2) * (1 + (c * u) ^ 2) * (Real.arctan u) ^ 2)) u := by
  have hun : u ≠ 0 := ne_of_gt hu
  have hcn : c ≠ 0 := ne_of_gt hc
  have han : Real.arctan u ≠ 0 := ne_of_gt (arctan_pos hu)
  have hp : 1 + u ^ 2 ≠ 0 := by positivity
  have hq : 1 + (c * u) ^ 2 ≠ 0 := by positivity
  have h := (((hasDerivAt_id u).const_mul c).arctan).div
    (Real.hasDerivAt_arctan u) han
  convert h using 1
  simp only [elasticityReciprocal, id_eq]
  field_simp
  <;> ring

theorem scaleRatio_strictMonoOn {c : ℝ} (hc : 0 < c) (hc1 : c < 1) :
    StrictMonoOn (scaleRatio c) (Set.Ioi 0) := by
  apply strictMonoOn_of_deriv_pos (convex_Ioi 0)
  · intro u hu
    exact (scaleRatio_hasDerivAt hc hu).continuousAt.continuousWithinAt
  · intro u hu
    have hu0 : 0 < u := by simpa using hu
    rw [(scaleRatio_hasDerivAt hc hu0).deriv]
    have hcu : 0 < c * u := mul_pos hc hu0
    have hlt : c * u < u := by nlinarith
    have hH := elasticityReciprocal_strictMonoOn hcu hu0 hlt
    apply div_pos
    · exact mul_pos (mul_pos hc hu0) (sub_pos.mpr hH)
    · have hapos := arctan_pos hu0
      positivity

theorem scaleRatio_strictAntiOn {c : ℝ} (hc : 1 < c) :
    StrictAntiOn (scaleRatio c) (Set.Ioi 0) := by
  have hc0 : 0 < c := by linarith
  apply strictAntiOn_of_deriv_neg (convex_Ioi 0)
  · intro u hu
    exact (scaleRatio_hasDerivAt hc0 hu).continuousAt.continuousWithinAt
  · intro u hu
    have hu0 : 0 < u := by simpa using hu
    rw [(scaleRatio_hasDerivAt hc0 hu0).deriv]
    have hcu : 0 < c * u := mul_pos hc0 hu0
    have hlt : u < c * u := by nlinarith
    have hH := elasticityReciprocal_strictMonoOn hu0 hcu hlt
    apply div_neg_of_neg_of_pos
    · exact mul_neg_of_pos_of_neg (mul_pos hc0 hu0) (sub_neg.mpr hH)
    · have hapos := arctan_pos hu0
      positivity

end C2.NGamma.PhaseScale

end

/- ===== C2.NGammaPhase ===== -/

/-!
# Normalized phase contribution for independent discretization parameters

This file concerns the real analytic lemma `lem:ngamma-phase-ratio`.
It does not replace the separate complex root-count obligation.
-/

noncomputable section
open Set Filter
open scoped Topology

namespace C2.NGamma.Phase

def contribution (a x t : ℝ) : ℝ := Real.arctan (a*t) - Real.arctan (x*t)

def ratio (a x t : ℝ) : ℝ := contribution a x t / Real.arctan (1/t)

theorem arctan_pos {u : ℝ} (hu : 0 < u) : 0 < Real.arctan u := by
  simpa only [Real.arctan_zero] using Real.arctan_strictMono hu

theorem arctan_upper_bound {u : ℝ} (hu : 0 < u) : Real.arctan u ≤ u := by
  have h := Real.lt_tan (arctan_pos hu) (Real.arctan_lt_pi_div_two u)
  simpa only [Real.tan_arctan] using h.le

theorem arctan_lower_bound (u : ℝ) (hu : 0 ≤ u) :
    u / (1+u^2) ≤ Real.arctan u := by
  let f : ℝ → ℝ := fun v => Real.arctan v - v/(1+v^2)
  have hd (v : ℝ) : HasDerivAt f (2*v^2/(1+v^2)^2) v := by
    have h := (Real.hasDerivAt_arctan v).sub
      ((hasDerivAt_id v).div
        ((hasDerivAt_const v (1:ℝ)).add ((hasDerivAt_id v).pow 2))
        (by positivity : (1+v^2:ℝ) ≠ 0))
    convert h using 1 <;> dsimp [f]
    field_simp
    <;> ring
  have hm : Monotone f := monotone_of_hasDerivAt_nonneg hd (by
    intro v
    positivity)
  have he := hm hu
  simpa [f] using he

theorem contribution_pos {a x t : ℝ} (hax : x < a) (ht : 0 < t) :
    0 < contribution a x t := by
  unfold contribution
  exact sub_pos.mpr (Real.arctan_strictMono (mul_lt_mul_of_pos_right hax ht))

theorem contribution_hasDerivAt (a x t : ℝ) :
    HasDerivAt (contribution a x)
      ((a-x)*(1-a*x*t^2)/((1+a^2*t^2)*(1+x^2*t^2))) t := by
  have h := ((Real.hasDerivAt_arctan (a*t)).comp t
    ((hasDerivAt_id t).const_mul a)).sub
    ((Real.hasDerivAt_arctan (x*t)).comp t ((hasDerivAt_id t).const_mul x))
  convert h using 1 <;> dsimp [contribution]
  field_simp
  <;> ring

theorem inverse_arctan_hasDerivAt {t : ℝ} (ht : t ≠ 0) :
    HasDerivAt (fun v : ℝ => Real.arctan (1/v)) (-1/(1+t^2)) t := by
  have h := (Real.hasDerivAt_arctan (1/t)).comp t
    ((hasDerivAt_const t (1:ℝ)).div (hasDerivAt_id t) ht)
  convert h using 1
  field_simp
  <;> ring

theorem ratio_hasDerivAt {a x t : ℝ} (ht : 0 < t) :
    HasDerivAt (ratio a x)
      ((((a-x)*(1-a*x*t^2)/((1+a^2*t^2)*(1+x^2*t^2))) *
        Real.arctan (1/t) + contribution a x t/(1+t^2)) /
        (Real.arctan (1/t))^2) t := by
  have h := (contribution_hasDerivAt a x t).div
    (inverse_arctan_hasDerivAt ht.ne')
    ((arctan_pos (by positivity : 0 < (1/t:ℝ))).ne')
  convert h using 1 <;> dsimp [ratio]
  ring

theorem contribution_arctan {a x t : ℝ} (hx : 0 ≤ x) (hax : x < a)
    (ht : 0 < t) :
    contribution a x t = Real.arctan ((a-x)*t/(1+a*x*t^2)) := by
  have ha : 0 < a := lt_of_le_of_lt hx hax
  have hprod : a*t*(-(x*t)) < 1 := by
    have : 0 ≤ a*x*t^2 := by positivity
    nlinarith
  have h := Real.arctan_add hprod
  rw [Real.arctan_neg] at h
  calc
    contribution a x t = Real.arctan ((a*t + -(x*t))/(1-a*t*(-(x*t)))) := by
      exact h
    _ = _ := by congr 1; congr 1 <;> ring

theorem contribution_lower_bound {a x t : ℝ} (hx : 0 ≤ x)
    (hax : x < a) (ht : 0 < t) :
    (a-x)*t*(1+a*x*t^2)/((1+a^2*t^2)*(1+x^2*t^2)) ≤
      contribution a x t := by
  have ha : 0 < a := lt_of_le_of_lt hx hax
  have hA : 0 < a-x := sub_pos.mpr hax
  rw [contribution_arctan hx hax ht]
  have h := arctan_lower_bound ((a-x)*t/(1+a*x*t^2)) (by positivity)
  convert h using 1
  field_simp
  <;> ring

theorem ratio_derivative_pos_of_le_one {a x t : ℝ} (hx : 0 ≤ x)
    (hax : x < a) (ha : a ≤ 1) (ht : 0 < t) :
    0 < deriv (ratio a x) t := by
  rw [(ratio_hasDerivAt ht).deriv]
  apply div_pos _ (sq_pos_of_pos (arctan_pos (by positivity)))
  have hapos : 0 < a := lt_of_le_of_lt hx hax
  have hP : 0 < (1+a^2*t^2)*(1+x^2*t^2) := by positivity
  have hA : 0 < a-x := sub_pos.mpr hax
  have hN := contribution_pos hax ht
  have hD := arctan_pos (by positivity : 0 < (1/t:ℝ))
  by_cases hc : 0 ≤ 1-a*x*t^2
  · exact add_pos_of_nonneg_of_pos
      (mul_nonneg (div_nonneg (mul_nonneg hA.le hc) hP.le) hD.le)
      (div_pos hN (by positivity))
  · have hc' : (a-x)*(1-a*x*t^2)/((1+a^2*t^2)*(1+x^2*t^2)) < 0 :=
      div_neg_of_neg_of_pos (mul_neg_of_pos_of_neg hA (lt_of_not_ge hc)) hP
    have hDupper := arctan_upper_bound (by positivity : 0 < (1/t:ℝ))
    have hNlower := contribution_lower_bound hx hax ht
    have haxbound : a*x ≤ 1 := by
      have hxone : x ≤ 1 := le_trans hax.le ha
      nlinarith [mul_nonneg (by linarith : 0 ≤ 1-a) (by linarith : 0 ≤ 1-x)]
    have hlower : 0 <
        (a-x)*(1-a*x*t^2)/((1+a^2*t^2)*(1+x^2*t^2))*(1/t) +
        ((a-x)*t*(1+a*x*t^2)/((1+a^2*t^2)*(1+x^2*t^2)))/(1+t^2) := by
      have he :
          (a-x)*(1-a*x*t^2)/((1+a^2*t^2)*(1+x^2*t^2))*(1/t) +
          ((a-x)*t*(1+a*x*t^2)/((1+a^2*t^2)*(1+x^2*t^2)))/(1+t^2) =
          (a-x)*(1+(2-a*x)*t^2)/(t*((1+a^2*t^2)*(1+x^2*t^2))*(1+t^2)) := by
        field_simp
        <;> ring
      rw [he]
      have htwo : 0 < 2-a*x := by linarith
      positivity
    exact lt_of_lt_of_le hlower (add_le_add
      (mul_le_mul_of_nonpos_left hDupper hc'.le)
      (div_le_div_of_nonneg_right hNlower (by positivity)))

theorem ratio_strictMonoOn_of_le_one {a x : ℝ} (hx : 0 ≤ x)
    (hax : x < a) (ha : a ≤ 1) : StrictMonoOn (ratio a x) (Ioi 0) := by
  apply strictMonoOn_of_deriv_pos (convex_Ioi 0)
  · intro t ht
    exact (ratio_hasDerivAt ht).continuousAt.continuousWithinAt
  · intro t ht
    exact ratio_derivative_pos_of_le_one hx hax ha (by simpa using ht)

theorem ratio_strictMonoOn_of_zero {a : ℝ} (ha : 0 < a) :
    StrictMonoOn (ratio a 0) (Ioi 0) := by
  intro s hs t ht hst
  have hs0 : 0 < s := hs
  have ht0 : 0 < t := ht
  have hN : Real.arctan (a*s) < Real.arctan (a*t) :=
    Real.arctan_strictMono (mul_lt_mul_of_pos_left hst ha)
  have hDs : 0 < Real.arctan (1/s) := arctan_pos (one_div_pos.mpr hs0)
  have hDt : 0 < Real.arctan (1/t) := arctan_pos (one_div_pos.mpr ht0)
  have hD : Real.arctan (1/t) ≤ Real.arctan (1/s) :=
    Real.arctan_strictMono.monotone (one_div_le_one_div_of_le hs hst.le)
  dsimp [ratio, contribution]
  simp only [zero_mul, Real.arctan_zero, sub_zero]
  exact lt_of_lt_of_le (div_lt_div_of_pos_right hN hDs)
    (div_le_div_of_nonneg_left (arctan_pos (mul_pos ha ht)).le hDt hD)

theorem ratio_eq_scale_difference {a x t : ℝ} (hx : 0 < x)
    (ha : 0 < a) (ht : 0 < t) :
    ratio a x t = PhaseScale.scaleRatio (1/x) (1/t) -
      PhaseScale.scaleRatio (1/a) (1/t) := by
  have hi (c : ℝ) (hc : 0 < c) :
      Real.arctan ((1/c)*(1/t)) = Real.pi/2 - Real.arctan (c*t) := by
    convert Real.arctan_inv_of_pos (mul_pos hc ht) using 1 <;> field_simp
  dsimp [ratio, contribution, PhaseScale.scaleRatio]
  rw [hi x hx, hi a ha]
  ring

theorem ratio_strictMonoOn {a x : ℝ} (hx : 0 ≤ x) (hx1 : x ≤ 1)
    (hax : x < a) : StrictMonoOn (ratio a x) (Ioi 0) := by
  by_cases hx0 : x = 0
  · subst x
    exact ratio_strictMonoOn_of_zero hax
  have hxpos : 0 < x := lt_of_le_of_ne hx (Ne.symm hx0)
  by_cases ha1 : a ≤ 1
  · exact ratio_strictMonoOn_of_le_one hx hax ha1
  have ha : 1 < a := lt_of_not_ge ha1
  have hapos : 0 < a := by linarith
  intro s hs t ht hst
  have hs0 : 0 < s := hs
  have ht0 : 0 < t := ht
  rw [ratio_eq_scale_difference hxpos hapos hs,
    ratio_eq_scale_difference hxpos hapos ht]
  have hsi : 0 < (1/s:ℝ) := one_div_pos.mpr hs0
  have hti : 0 < (1/t:ℝ) := one_div_pos.mpr ht0
  have hist : (1/t:ℝ) < 1/s := one_div_lt_one_div_of_lt hs hst
  have hfirst : PhaseScale.scaleRatio (1/x) (1/s) ≤ PhaseScale.scaleRatio (1/x) (1/t) := by
    by_cases hxone : x = 1
    · subst x
      have hsn : Real.arctan s⁻¹ ≠ 0 := by simpa only [one_div] using (arctan_pos hsi).ne'
      have htn : Real.arctan t⁻¹ ≠ 0 := by simpa only [one_div] using (arctan_pos hti).ne'
      simp [PhaseScale.scaleRatio, hsn, htn]
    · have hxlt : x < 1 := lt_of_le_of_ne hx1 hxone
      exact (PhaseScale.scaleRatio_strictAntiOn
        ((one_lt_div hxpos).mpr (by simpa using hxlt)) hti hsi hist).le
  have hsecond : PhaseScale.scaleRatio (1/a) (1/t) < PhaseScale.scaleRatio (1/a) (1/s) :=
    PhaseScale.scaleRatio_strictMonoOn (by positivity)
      ((div_lt_one hapos).mpr ha) hti hsi hist
  linarith

theorem ratio_tendsto_zero (a x : ℝ) :
    Tendsto (ratio a x) (𝓝[>] 0) (𝓝 0) := by
  have hn : Tendsto (contribution a x) (𝓝[>] 0) (𝓝 0) := by
    have h : Continuous (contribution a x) := by
      unfold contribution
      exact (Real.continuous_arctan.comp (continuous_const.mul continuous_id)).sub
        (Real.continuous_arctan.comp (continuous_const.mul continuous_id))
    simpa [contribution] using
      (h.continuousAt (x := 0)).tendsto.mono_left (nhdsWithin_le_nhds (s := Ioi 0))
  have hd : Tendsto (fun t : ℝ => Real.arctan (1/t)) (𝓝[>] 0) (𝓝 (Real.pi/2)) := by
    simpa only [one_div] using
      Real.tendsto_arctan_atTop.mono_right nhdsWithin_le_nhds |>.comp tendsto_inv_nhdsGT_zero
  change Tendsto (fun t => contribution a x t / Real.arctan (1/t)) _ _
  simpa only [zero_div] using hn.div hd (by positivity : Real.pi/2 ≠ 0)

theorem arctan_difference_ratio_tendsto (c d : ℝ) :
    Tendsto (fun u : ℝ => (Real.arctan (c*u)-Real.arctan (d*u))/Real.arctan u)
      (𝓝[>] 0) (𝓝 (c-d)) := by
  have hf : HasDerivAt (fun u : ℝ => Real.arctan (c*u)-Real.arctan (d*u))
      (c-d) 0 := by
    convert ((Real.hasDerivAt_arctan (c*0)).comp 0
      ((hasDerivAt_id 0).const_mul c)).sub
      ((Real.hasDerivAt_arctan (d*0)).comp 0 ((hasDerivAt_id 0).const_mul d)) using 1 <;> simp
  have hn : Tendsto (fun u : ℝ => (Real.arctan (c*u)-Real.arctan (d*u))/u)
      (𝓝[>] 0) (𝓝 (c-d)) := by
    simpa [div_eq_mul_inv, mul_comm] using hf.tendsto_slope_zero_right
  have hd : Tendsto (fun u : ℝ => Real.arctan u/u) (𝓝[>] 0) (𝓝 1) := by
    simpa [div_eq_mul_inv, mul_comm] using (Real.hasDerivAt_arctan 0).tendsto_slope_zero_right
  have h := hn.div hd (by norm_num : (1:ℝ) ≠ 0)
  simp only [div_one] at h
  apply h.congr'
  filter_upwards [self_mem_nhdsWithin] with u hu
  have hu' : u ≠ 0 := ne_of_gt hu
  dsimp
  field_simp

theorem ratio_tendsto_atTop_of_pos {a x : ℝ} (hx : 0 < x) (hax : x < a) :
    Tendsto (ratio a x) atTop (𝓝 (1/x-1/a)) := by
  have ha : 0 < a := lt_trans hx hax
  have h := (arctan_difference_ratio_tendsto (1/x) (1/a)).comp tendsto_inv_atTop_nhdsGT_zero
  apply h.congr'
  filter_upwards [eventually_gt_atTop (0:ℝ)] with t ht
  have hi (c : ℝ) (hc : 0 < c) :
      Real.arctan ((1/c)*t⁻¹) = Real.pi/2 - Real.arctan (c*t) := by
    convert Real.arctan_inv_of_pos (mul_pos hc ht) using 1 <;> field_simp
  dsimp [ratio, contribution]
  rw [hi x hx, hi a ha]
  simp only [one_div]
  ring

theorem ratio_tendsto_atTop_of_zero {a : ℝ} (ha : 0 < a) :
    Tendsto (ratio a 0) atTop atTop := by
  have hn : Tendsto (fun t : ℝ => Real.arctan (a*t)) atTop (𝓝 (Real.pi/2)) :=
    (Real.tendsto_arctan_atTop.mono_right nhdsWithin_le_nhds).comp
      (tendsto_id.const_mul_atTop ha)
  have hd : Tendsto (fun t : ℝ => Real.arctan (1/t)) atTop (𝓝[>] 0) := by
    apply tendsto_nhdsWithin_iff.mpr
    constructor
    · have h := Real.continuous_arctan.continuousAt.tendsto.comp
        (tendsto_inv_atTop_zero : Tendsto (fun t : ℝ => t⁻¹) atTop (𝓝 0))
      simpa [one_div] using h
    · filter_upwards [eventually_gt_atTop (0:ℝ)] with t ht
      exact arctan_pos (by positivity)
  change Tendsto (fun t => contribution a 0 t / Real.arctan (1/t)) atTop atTop
  simpa [contribution, div_eq_mul_inv] using
    hn.pos_mul_atTop (by positivity : 0 < Real.pi/2) hd.inv_tendsto_nhdsGT_zero

/-- Complete analytic statement of paper Lemma `lem:ngamma-phase-ratio`. -/
theorem normalized_phase_contribution {a x : ℝ} (hx : 0 ≤ x) (hx1 : x ≤ 1)
    (hax : x < a) :
    StrictMonoOn (ratio a x) (Ioi 0) ∧
    Tendsto (ratio a x) (𝓝[>] 0) (𝓝 0) ∧
    (0 < x → Tendsto (ratio a x) atTop (𝓝 (1/x-1/a))) ∧
    (x = 0 → Tendsto (ratio a x) atTop atTop) := by
  refine ⟨ratio_strictMonoOn hx hx1 hax, ratio_tendsto_zero a x,
    fun hxpos => ratio_tendsto_atTop_of_pos hxpos hax, ?_⟩
  intro hxzero
  subst x
  exact ratio_tendsto_atTop_of_zero hax

end C2.NGamma.Phase

end

/- ===== C2.NGammaPhaseCrossing ===== -/

/-! The first phase crossing for several aligned delay samples.
This file proves phase existence, uniqueness and the strict frequency bound.
Root counting and the resulting full Schur interval are separate obligations. -/

noncomputable section
open Set Filter
open scoped Topology BigOperators

namespace C2.NGamma.Phase

def sumRatio {n : ℕ} (a x : Fin n → ℝ) (t : ℝ) : ℝ :=
  ∑ j, ratio (a j) (x j) t

def totalPhase {n : ℕ} (a x : Fin n → ℝ) (d : ℕ) (t : ℝ) : ℝ :=
  2*(d:ℝ)*Real.arctan t + ∑ j, contribution (a j) (x j) t

theorem sumRatio_strictMonoOn {n : ℕ} (hn : 0 < n) {a x : Fin n → ℝ}
    (hx : ∀ j, 0 ≤ x j) (hx1 : ∀ j, x j ≤ 1) (hax : ∀ j, x j < a j) :
    StrictMonoOn (sumRatio a x) (Ioi 0) := by
  intro s hs t ht hst
  apply Finset.sum_lt_sum
  · intro j _
    exact (ratio_strictMonoOn (hx j) (hx1 j) (hax j) hs ht hst).le
  · exact ⟨⟨0, hn⟩, Finset.mem_univ _,
      ratio_strictMonoOn (hx _) (hx1 _) (hax _) hs ht hst⟩

theorem sum_contribution_pos {n : ℕ} (hn : 0 < n) {a x : Fin n → ℝ}
    (hax : ∀ j, x j < a j) {t : ℝ} (ht : 0 < t) :
    0 < ∑ j, contribution (a j) (x j) t := by
  exact Finset.sum_pos (fun j _ => contribution_pos (hax j) ht)
    ⟨⟨0,hn⟩, Finset.mem_univ _⟩

theorem totalPhase_continuous {n : ℕ} (a x : Fin n → ℝ) (d : ℕ) :
    Continuous (totalPhase a x d) := by
  unfold totalPhase
  apply Continuous.add
  · exact continuous_const.mul Real.continuous_arctan
  · apply continuous_finset_sum
    intro j _
    unfold contribution
    exact (Real.continuous_arctan.comp (continuous_const.mul continuous_id)).sub
      (Real.continuous_arctan.comp (continuous_const.mul continuous_id))

theorem phase_eq_pi_iff_sumRatio {n : ℕ} (a x : Fin n → ℝ) (d : ℕ)
    {t : ℝ} (ht : 0 < t) :
    totalPhase a x d t = Real.pi ↔
    sumRatio a x t = 2*(d:ℝ)-((d:ℝ)-1)*Real.pi/Real.arctan (1/t) := by
  have hD : Real.arctan (1/t) ≠ 0 := (arctan_pos (one_div_pos.mpr ht)).ne'
  have hinv : Real.arctan (1/t) = Real.pi/2 - Real.arctan t := by
    simpa only [one_div] using Real.arctan_inv_of_pos ht
  have hsum : sumRatio a x t = (∑ j, contribution (a j) (x j) t)/Real.arctan (1/t) := by
    simp only [sumRatio, ratio, Finset.sum_div]
  rw [hsum]
  unfold totalPhase
  field_simp
  rw [hinv]
  constructor <;> intro h <;> linarith

theorem first_phase_crossing_exists {n d : ℕ} (hn : 0 < n) (hd : 2 ≤ d)
    {a x : Fin n → ℝ} (hax : ∀ j, x j < a j) :
    ∃ t : ℝ, 0 < t ∧ t < 1 ∧ totalPhase a x d t = Real.pi := by
  have hzero : totalPhase a x d 0 = 0 := by simp [totalPhase, contribution]
  have hone : Real.pi < totalPhase a x d 1 := by
    have hs := sum_contribution_pos hn hax (by norm_num : (0:ℝ) < 1)
    have hd' : (2:ℝ) ≤ d := by exact_mod_cast hd
    dsimp [totalPhase]
    rw [Real.arctan_one]
    nlinarith [Real.pi_pos]
  have hmem : Real.pi ∈ Icc (totalPhase a x d 0) (totalPhase a x d 1) := by
    rw [hzero]
    exact ⟨Real.pi_pos.le, hone.le⟩
  obtain ⟨t, ht, he⟩ := intermediate_value_Icc (by norm_num : (0:ℝ) ≤ 1)
    (totalPhase_continuous a x d).continuousOn hmem
  refine ⟨t, ?_, ?_, he⟩
  · by_contra! h
    have heq : t = 0 := le_antisymm h ht.1
    subst t
    rw [hzero] at he
    exact Real.pi_pos.ne he
  · by_contra hnot
    have h : 1 ≤ t := le_of_not_gt hnot
    have heq : t = 1 := le_antisymm ht.2 h
    subst t
    linarith

theorem first_phase_crossing_unique {n d : ℕ} (hn : 0 < n) (hd : 1 ≤ d)
    {a x : Fin n → ℝ} (hx : ∀ j, 0 ≤ x j) (hx1 : ∀ j, x j ≤ 1)
    (hax : ∀ j, x j < a j) {s t : ℝ} (hs : 0 < s) (ht : 0 < t)
    (hps : totalPhase a x d s = Real.pi) (hpt : totalPhase a x d t = Real.pi) : s = t := by
  have hmono := sumRatio_strictMonoOn hn hx hx1 hax
  have hc : 0 ≤ ((d:ℝ)-1)*Real.pi := by
    have hd' : (1:ℝ) ≤ d := by exact_mod_cast hd
    exact mul_nonneg (by linarith) Real.pi_pos.le
  have hanti : AntitoneOn
      (fun u : ℝ => 2*(d:ℝ)-((d:ℝ)-1)*Real.pi/Real.arctan (1/u)) (Ioi 0) := by
    intro u hu v hv huv
    have hu' : 0 < u := hu
    have hv' : 0 < v := hv
    have hDa : 0 < Real.arctan (1/v) := arctan_pos (one_div_pos.mpr hv')
    have hDb : Real.arctan (1/v) ≤ Real.arctan (1/u) :=
      Real.arctan_strictMono.monotone (one_div_le_one_div_of_le hu' huv)
    exact sub_le_sub_left (div_le_div_of_nonneg_left hc hDa hDb) _
  have hps' := (phase_eq_pi_iff_sumRatio a x d hs).mp hps
  have hpt' := (phase_eq_pi_iff_sumRatio a x d ht).mp hpt
  rcases lt_trichotomy s t with h | h | h
  · have hm := hmono hs ht h
    have ha := hanti hs ht h.le
    rw [hps', hpt'] at hm
    linarith
  · exact h
  · have hm := hmono ht hs h
    have ha := hanti ht hs h.le
    rw [hps', hpt'] at hm
    linarith

theorem phase_crossing_arctan_bound {n d : ℕ} (hn : 0 < n) (hd : 1 ≤ d)
    {a x : Fin n → ℝ} (hax : ∀ j, x j < a j) {t : ℝ} (ht : 0 < t)
    (he : totalPhase a x d t = Real.pi) :
    Real.arctan t < Real.pi/(2*(d:ℝ)) := by
  have hd' : (1:ℝ) ≤ d := by exact_mod_cast hd
  have hdpos : 0 < 2*(d:ℝ) := by linarith
  apply (lt_div_iff₀ hdpos).mpr
  have hs := sum_contribution_pos hn hax ht
  dsimp [totalPhase] at he
  nlinarith

theorem phase_crossing_frequency_bound {n d : ℕ} (hn : 0 < n) (hd : 2 ≤ d)
    {a x : Fin n → ℝ} (hax : ∀ j, x j < a j) {t : ℝ} (ht : 0 < t)
    (he : totalPhase a x d t = Real.pi) :
    t < Real.tan (Real.pi/(2*(d:ℝ))) := by
  have hd' : (2:ℝ) ≤ d := by exact_mod_cast hd
  have hpos : 0 < Real.pi/(2*(d:ℝ)) := div_pos Real.pi_pos (by linarith)
  have hhalf : Real.pi/(2*(d:ℝ)) < Real.pi/2 :=
    div_lt_div_of_pos_left Real.pi_pos (by norm_num) (by linarith)
  apply Real.arctan_strictMono.lt_iff_lt.mp
  rw [Real.arctan_tan (by linarith [Real.pi_pos]) hhalf]
  exact phase_crossing_arctan_bound hn (by omega) hax ht he

/-- Complete analytic crossing assertion of the multiple-delay corollary.
The Schur-interval conclusion is not part of this theorem. -/
theorem multiple_delay_unique_phase_crossing {n d : ℕ} (hn : 0 < n) (hd : 2 ≤ d)
    {a x : Fin n → ℝ} (hx : ∀ j, 0 ≤ x j) (hx1 : ∀ j, x j ≤ 1)
    (hax : ∀ j, x j < a j) :
    ∃! t : ℝ, 0 < t ∧ t < Real.tan (Real.pi/(2*(d:ℝ))) ∧
      totalPhase a x d t = Real.pi := by
  obtain ⟨t, ht, _, he⟩ := first_phase_crossing_exists hn hd hax
  refine ⟨t, ⟨ht, phase_crossing_frequency_bound hn hd hax ht he, he⟩, ?_⟩
  intro s hs
  exact first_phase_crossing_unique hn (by omega) hx hx1 hax hs.1 ht hs.2.2 he

end C2.NGamma.Phase

end

/- ===== C2.NGammaCayley ===== -/

/-! Exact Cayley-coordinate bridge from the actual characteristic polynomial to
its analytic amplitude and phase on the unit circle. -/

noncomputable section
open scoped BigOperators

namespace C2.NGamma.Cayley

open PolynomialModel

def point (t : ℝ) : ℂ := (1 + Complex.I * t) / (1 - Complex.I * t)

def amplitudeFactor (r x t : ℝ) : ℝ :=
  r * Real.sqrt (1 + ((x + 2 / r) * t) ^ 2) /
    Real.sqrt (1 + (x * t) ^ 2)

def amplitude {n : ℕ} (r x : Fin n → ℝ) (t : ℝ) : ℝ :=
  ∏ i, amplitudeFactor (r i) (x i) t

def transfer {n : ℕ} (r x : Fin n → ℝ) (d : ℕ) (z : ℂ) : ℂ :=
  z ^ d * ∏ i, (factor (r i) (x i)).eval z / (q (x i)).eval z

lemma one_add_I_mul_ne_zero (s : ℝ) : 1 + Complex.I * (s : ℂ) ≠ 0 := by
  intro h
  have := congrArg Complex.re h
  simpa using this

lemma one_sub_I_mul_ne_zero (s : ℝ) : 1 - Complex.I * (s : ℂ) ≠ 0 := by
  intro h
  have := congrArg Complex.re h
  simpa using this

lemma linear_polar (s : ℝ) :
    1 + Complex.I * (s : ℂ) =
      (Real.sqrt (1+s^2) : ℂ) * Complex.exp ((Real.arctan s : ℂ) * Complex.I) := by
  have hpos : 0 < Real.sqrt (1+s^2) := Real.sqrt_pos.2 (by positivity)
  rw [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin,
    Real.cos_arctan, Real.sin_arctan]
  have hn : (Real.sqrt (1+s^2) : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hpos
  push_cast
  field_simp
  ring

lemma q_eval_point (x t : ℝ) :
    (q x).eval (point t) = (1 + Complex.I * (x*t : ℝ)) / (1 - Complex.I * t) := by
  rw [q_eval, point]
  push_cast
  field_simp [one_sub_I_mul_ne_zero t]
  ring

lemma q_eval_point_ne_zero (x t : ℝ) : (q x).eval (point t) ≠ 0 := by
  rw [q_eval_point]
  exact div_ne_zero (one_add_I_mul_ne_zero (x*t)) (one_sub_I_mul_ne_zero t)

lemma factor_eval_point (r x t : ℝ) :
    (factor r x).eval (point t) =
      ((r : ℂ) + Complex.I * ((r*x+2)*t : ℝ)) / (1 - Complex.I*t) := by
  rw [factor_eval, q_eval_point, point]
  push_cast
  field_simp [one_sub_I_mul_ne_zero t]
  ring

lemma factor_div_q_point {r : ℝ} (hr : r ≠ 0) (x t : ℝ) :
    (factor r x).eval (point t) / (q x).eval (point t) =
      (r : ℂ) * (1+Complex.I*((x+2/r)*t : ℝ)) /
        (1+Complex.I*(x*t : ℝ)) := by
  rw [factor_eval_point, q_eval_point]
  have hrc : (r : ℂ) ≠ 0 := by exact_mod_cast hr
  push_cast
  field_simp [one_sub_I_mul_ne_zero t, one_add_I_mul_ne_zero (x*t), hrc]
  ring

lemma point_exp (t : ℝ) :
    point t = Complex.exp (((2 * Real.arctan t : ℝ) : ℂ) * Complex.I) := by
  have hpos : 0 < Real.sqrt (1+t^2) := Real.sqrt_pos.2 (by positivity)
  have hn : (Real.sqrt (1+t^2) : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hpos
  have hneg : (1 - Complex.I * (t : ℂ)) =
      (Real.sqrt (1+t^2) : ℂ) * Complex.exp (-(Real.arctan t : ℂ)*Complex.I) := by
    simpa using linear_polar (-t)
  rw [point, linear_polar, hneg, mul_div_mul_left _ _ hn, ← Complex.exp_sub]
  congr 1
  push_cast
  ring

lemma point_norm (t : ℝ) : ‖point t‖ = 1 := by
  rw [point_exp]
  exact Complex.norm_exp_ofReal_mul_I _

lemma amplitudeFactor_pos {r : ℝ} (hr : 0 < r) (x t : ℝ) :
    0 < amplitudeFactor r x t := by
  unfold amplitudeFactor
  positivity

lemma amplitude_pos {n : ℕ} {r : Fin n → ℝ} (hr : ∀ i, 0 < r i)
    (x : Fin n → ℝ) (t : ℝ) : 0 < amplitude r x t := by
  exact Finset.prod_pos (fun i _ => amplitudeFactor_pos (hr i) (x i) t)

lemma factor_div_q_polar {r : ℝ} (hr : r ≠ 0) (x t : ℝ) :
    (factor r x).eval (point t) / (q x).eval (point t) =
      (amplitudeFactor r x t : ℂ) *
        Complex.exp ((Phase.contribution (x+2/r) x t : ℂ) * Complex.I) := by
  rw [factor_div_q_point hr, linear_polar, linear_polar]
  simp only [amplitudeFactor, Phase.contribution, Complex.ofReal_div, Complex.ofReal_mul,
    Complex.ofReal_sub, sub_mul, Complex.exp_sub]
  ring

lemma transfer_polar {n : ℕ} {r : Fin n → ℝ} (hr : ∀ i, r i ≠ 0)
    (x : Fin n → ℝ) (d : ℕ) (t : ℝ) :
    transfer r x d (point t) = (amplitude r x t : ℂ) *
      Complex.exp ((Phase.totalPhase (fun i => x i + 2/r i) x d t : ℂ) * Complex.I) := by
  unfold transfer
  simp_rw [factor_div_q_polar (hr _)]
  rw [point_exp, Finset.prod_mul_distrib, ← Complex.exp_nat_mul, ← Complex.exp_sum]
  simp only [amplitude, Phase.totalPhase, Complex.ofReal_add, Complex.ofReal_sum,
    Complex.ofReal_mul, Complex.ofReal_natCast, Complex.ofReal_ofNat, Complex.ofReal_prod]
  rw [add_mul, Complex.exp_add, Finset.sum_mul]
  have he : (d : ℂ) * (2 * (Real.arctan t : ℂ) * Complex.I) =
      2 * d * Real.arctan t * Complex.I := by ring
  rw [he]
  ring

lemma characteristic_eval_point {n : ℕ} (r x : Fin n → ℝ) (d : ℕ) (b t : ℝ) :
    (characteristic r x d b).eval (point t) =
      (∏ i, (q (x i)).eval (point t)) * (transfer r x d (point t) + b) := by
  simp only [characteristic, Polynomial.eval_add, Polynomial.eval_mul,
    Polynomial.eval_pow, Polynomial.eval_prod, Polynomial.eval_X, Polynomial.eval_C,
    transfer]
  rw [Finset.prod_div_distrib]
  have hn : (∏ i, (q (x i)).eval (point t)) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun i _ => q_eval_point_ne_zero (x i) t)
  field_simp

lemma characteristic_point_zero_iff {n : ℕ} {r : Fin n → ℝ}
    (hr : ∀ i, r i ≠ 0) (x : Fin n → ℝ) (d : ℕ) (b t : ℝ) :
    (characteristic r x d b).eval (point t) = 0 ↔
      (amplitude r x t : ℂ) *
        Complex.exp ((Phase.totalPhase (fun i => x i+2/r i) x d t : ℂ) * Complex.I) + b = 0 := by
  rw [characteristic_eval_point, transfer_polar hr]
  exact mul_eq_zero.trans (or_iff_right
    (Finset.prod_ne_zero_iff.mpr (fun i _ => q_eval_point_ne_zero (x i) t)))

lemma transfer_norm {n : ℕ} {r : Fin n → ℝ} (hr : ∀ i, 0 < r i)
    (x : Fin n → ℝ) (d : ℕ) (t : ℝ) :
    ‖transfer r x d (point t)‖ = amplitude r x t := by
  rw [transfer_polar (fun i => ne_of_gt (hr i)), norm_mul,
    Complex.norm_real, Complex.norm_exp_ofReal_mul_I, mul_one,
    Real.norm_eq_abs, abs_of_pos (amplitude_pos hr x t)]

lemma characteristic_point_zero_iff_gain_phase {n : ℕ} {r : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (x : Fin n → ℝ) (d : ℕ) {b : ℝ} (hb : 0 ≤ b)
    (t : ℝ) :
    (characteristic r x d b).eval (point t) = 0 ↔
      amplitude r x t = b ∧
        Complex.exp ((Phase.totalPhase (fun i => x i+2/r i) x d t : ℂ) * Complex.I) = -1 := by
  rw [characteristic_point_zero_iff (fun i => ne_of_gt (hr i))]
  set B := amplitude r x t
  set E := Complex.exp ((Phase.totalPhase (fun i => x i+2/r i) x d t : ℂ) * Complex.I)
  have hB : 0 < B := amplitude_pos hr x t
  have hBn : (B : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hB
  have hE : ‖E‖ = 1 := Complex.norm_exp_ofReal_mul_I _
  constructor
  · intro he
    have he' : (B : ℂ)*E = -(b : ℂ) := by linear_combination he
    have hn := congrArg norm he'
    simp only [norm_mul, Complex.norm_real, hE, mul_one, norm_neg,
      Real.norm_eq_abs, abs_of_pos hB, abs_of_nonneg hb] at hn
    refine ⟨hn, ?_⟩
    apply (mul_left_cancel₀ hBn)
    rw [he', hn]
    ring
  · rintro ⟨hbE, hphase⟩
    rw [hbE, hphase]
    ring

lemma first_crossing_gives_unit_root {n : ℕ} {r : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (x : Fin n → ℝ) (d : ℕ) (t : ℝ)
    (hphase : Phase.totalPhase (fun i => x i+2/r i) x d t = Real.pi) :
    (characteristic r x d (amplitude r x t)).eval (point t) = 0 ∧ ‖point t‖ = 1 := by
  refine ⟨?_, point_norm t⟩
  rw [characteristic_point_zero_iff_gain_phase hr x d (le_of_lt (amplitude_pos hr x t))]
  exact ⟨rfl, by rw [hphase]; exact Complex.exp_pi_mul_I⟩

end C2.NGamma.Cayley

end

/- ===== C2.NGammaPhaseEndpoint ===== -/

noncomputable section
open scoped BigOperators Topology
open Filter
namespace C2.NGamma.Cayley

/-- A continuous real argument of a numerator factor on the upper semicircle. -/
def qPhase (x t : ℝ) : ℝ := Real.arctan t + Real.arctan (x*t)

def qAmplitude (x t : ℝ) : ℝ :=
  Real.sqrt (1+(x*t)^2) / Real.sqrt (1+t^2)

theorem qAmplitude_pos (x t : ℝ) : 0 < qAmplitude x t := by
  unfold qAmplitude
  positivity

theorem q_polar (x t : ℝ) :
    (PolynomialModel.q x).eval (point t) =
      (qAmplitude x t : ℂ) * Complex.exp ((qPhase x t : ℂ) * Complex.I) := by
  rw [q_eval_point, linear_polar]
  have hneg : 1 - Complex.I * (t : ℂ) =
      (Real.sqrt (1+t^2) : ℂ) * Complex.exp (-(Real.arctan t : ℂ)*Complex.I) := by
    simpa using linear_polar (-t)
  rw [hneg]
  simp only [qAmplitude, qPhase, Complex.ofReal_div, Complex.ofReal_add,
    add_mul, Complex.exp_add, neg_mul, Complex.exp_neg]
  field_simp
  ring

theorem qPhase_continuous (x : ℝ) : Continuous (qPhase x) := by
  unfold qPhase
  exact Real.continuous_arctan.add (Real.continuous_arctan.comp (continuous_const.mul continuous_id))

theorem arctan_mul_tendsto_atTop {x : ℝ} (hx : 0 ≤ x) :
    Tendsto (fun t : ℝ => Real.arctan (x*t)) atTop
      (𝓝 (if x = 0 then 0 else Real.pi/2)) := by
  split_ifs with h
  · simp [h]
  · exact (Real.tendsto_arctan_atTop.mono_right nhdsWithin_le_nhds).comp
      ((tendsto_const_mul_atTop_of_pos (lt_of_le_of_ne hx (Ne.symm h))).2 tendsto_id)

theorem qPhase_tendsto_atTop {x : ℝ} (hx : 0 ≤ x) :
    Tendsto (qPhase x) atTop (𝓝 (Real.pi - (if x = 0 then Real.pi/2 else 0))) := by
  have h := (Real.tendsto_arctan_atTop.mono_right nhdsWithin_le_nhds).add
    (arctan_mul_tendsto_atTop hx)
  convert h using 1
  split_ifs <;> ring

/-- The endpoint contribution of zero numerator parameters is counted explicitly. -/
theorem sum_qPhase_tendsto_atTop {n : ℕ} {x : Fin n → ℝ}
    (hx : ∀ i, 0 ≤ x i) :
    Tendsto (fun t => ∑ i, qPhase (x i) t) atTop
      (𝓝 ((n : ℝ)*Real.pi - ∑ i, if x i = 0 then Real.pi/2 else 0)) := by
  have h := tendsto_finset_sum Finset.univ (fun i _ => qPhase_tendsto_atTop (hx i))
  simpa only [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ,
    Fintype.card_fin, nsmul_eq_mul] using h

theorem totalPhase_tendsto_atTop {n : ℕ} {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) (d : ℕ) :
    Tendsto (Phase.totalPhase (fun i => x i+2/r i) x d) atTop
      (𝓝 ((d : ℝ)*Real.pi + ∑ i, if x i = 0 then Real.pi/2 else 0)) := by
  have hi (i : Fin n) : Tendsto (Phase.contribution (x i+2/r i) (x i)) atTop
      (𝓝 (if x i = 0 then Real.pi/2 else 0)) := by
    have ha : 0 < x i+2/r i := add_pos_of_nonneg_of_pos (hx i) (div_pos (by norm_num) (hr i))
    have h := (arctan_mul_tendsto_atTop (le_of_lt ha)).sub (arctan_mul_tendsto_atTop (hx i))
    simp only [ne_of_gt ha, if_false] at h
    convert h using 1
    split_ifs <;> ring
  have h0 := (Real.tendsto_arctan_atTop.mono_right nhdsWithin_le_nhds).const_mul (2*(d:ℝ))
  have h := h0.add (tendsto_finset_sum Finset.univ (fun i _ => hi i))
  convert h using 1 <;> try {unfold Phase.totalPhase; rfl}
  congr 1
  ring

end C2.NGamma.Cayley

end

/- ===== C2.NGammaPolynomialDegree ===== -/

noncomputable section
open scoped BigOperators
open Polynomial
namespace C2.NGamma.PolynomialModel

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem factor_linear (r x : ℝ) :
    factor r x = C (1 + (r : ℂ) * (1 + x) / 2) * X +
      C ((r : ℂ) * (1 - x) / 2 - 1) := by
  apply Polynomial.funext
  intro z
  simp [factor_eval, q_eval]
  ring

theorem factor_natDegree {r x : ℝ} (hr : 0 < r) (hx : 0 ≤ x) :
    (factor r x).natDegree = 1 := by
  rw [factor_linear]
  apply natDegree_linear
  exact_mod_cast (ne_of_gt (by positivity : 0 < 1 + r * (1 + x) / 2))

theorem factor_ne_zero {r x : ℝ} (hr : 0 < r) (hx : 0 ≤ x) :
    factor r x ≠ 0 := by
  intro h
  have hd := factor_natDegree hr hx
  simp [h] at hd

theorem q_natDegree {x : ℝ} (hx : 0 ≤ x) : (q x).natDegree = 1 := by
  apply natDegree_linear
  exact_mod_cast (ne_of_gt (by positivity : 0 < (1 + x) / 2))

theorem characteristic_natDegree {r x : ι → ℝ} {d : ℕ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) (hd : 1 ≤ d) (b : ℝ) :
    (characteristic r x d b).natDegree = Fintype.card ι + d := by
  have hn : (∏ i, factor (r i) (x i)) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun i _ => factor_ne_zero (hr i) (hx i))
  have hD : (∏ i, factor (r i) (x i)).natDegree = Fintype.card ι := by
    rw [natDegree_prod _ _ (fun i _ => factor_ne_zero (hr i) (hx i))]
    simp only [factor_natDegree (hr _) (hx _), Finset.sum_const, Finset.card_univ, smul_eq_mul,
      mul_one]
  have hQ : (∏ i, q (x i)).natDegree ≤ Fintype.card ι := by
    calc
      _ ≤ ∑ i, (q (x i)).natDegree := natDegree_prod_le _ _
      _ = _ := by simp [q_natDegree (hx _)]
  have hterm : (C (b : ℂ) * ∏ i, q (x i)).natDegree ≤ Fintype.card ι := by
    exact (natDegree_C_mul_le _ _).trans hQ
  unfold characteristic
  rw [natDegree_add_eq_left_of_natDegree_lt]
  · rw [natDegree_X_pow_mul d hn, hD]
  · rw [natDegree_X_pow_mul d hn, hD]
    omega

theorem characteristic_ne_zero {r x : ι → ℝ} {d : ℕ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) (hd : 1 ≤ d) (b : ℝ) :
    characteristic r x d b ≠ 0 := by
  intro h
  have hh := characteristic_natDegree hr hx hd b
  simp only [h, natDegree_zero] at hh
  omega

end C2.NGamma.PolynomialModel

end

/- ===== C2.NGammaRootClosedness ===== -/

/-!
# Quantitative persistence of a root outside the unit disk

Root factorization supplies a uniform lower bound for the value of every
Schur-stable polynomial at an exterior point. Applied to the actual characteristic
polynomial, this excludes an entire neighborhood of zero gain when a zero-gain
factor has an exterior root. No root-continuity oracle is assumed.
-/
noncomputable section
open scoped BigOperators
open Polynomial
namespace C2.NGamma.PolynomialModel

theorem schur_eval_norm_lower_bound {p : Polynomial ℂ} (hp : SchurStable p)
    {z : ℂ} (hz : 1 < ‖z‖) :
    ‖p.leadingCoeff‖ * (‖z‖-1)^p.natDegree ≤ ‖p.eval z‖ := by
  have hm : ∀ s : Multiset ℂ, (∀ a ∈ s, ‖a‖ ≤ 1) →
      (‖z‖-1)^s.card ≤ ‖(s.map (fun a => z-a)).prod‖ := by
    intro s
    induction s using Multiset.induction_on with
    | empty => simp
    | @cons a s ih =>
      intro hs
      have ha : ‖z‖-1 ≤ ‖z-a‖ := by
        have h := norm_sub_norm_le z a
        have h' := hs a (Multiset.mem_cons_self _ _)
        linarith
      have hh := ih (fun b hb => hs b (Multiset.mem_cons_of_mem hb))
      simp only [Multiset.card_cons,Multiset.map_cons,Multiset.prod_cons,norm_mul,pow_succ]
      calc
        (‖z‖-1)^s.card*(‖z‖-1) ≤ ‖(s.map (fun a => z-a)).prod‖*‖z-a‖ :=
          mul_le_mul hh ha (by linarith) (norm_nonneg _)
        _ = _ := by ring
  have hroot : ∀ a ∈ p.roots, ‖a‖ ≤ 1 := by
    intro a ha
    exact le_of_lt (hp a (isRoot_of_mem_roots ha))
  have hcard : p.roots.card=p.natDegree := by
    simpa using (natDegree_eq_card_roots (IsAlgClosed.splits p)).symm
  rw [eval_eq_prod_roots_sub_of_splits_id (IsAlgClosed.splits p),norm_mul]
  exact mul_le_mul_of_nonneg_left (hcard ▸ hm p.roots hroot) (norm_nonneg _)

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem cube_factor_leading_pos {r x : ℝ} (hr : 0 < r) (hx : -1 ≤ x) :
    0 < 1+r*(1+x)/2 := by
  have h : 0 ≤ 1+x := by linarith
  positivity

theorem cube_factor_natDegree {r x : ℝ} (hr : 0 < r) (hx : -1 ≤ x) :
    (factor r x).natDegree=1 := by
  rw [factor_linear]
  apply natDegree_linear
  exact_mod_cast ne_of_gt (cube_factor_leading_pos hr hx)

theorem cube_factor_ne_zero {r x : ℝ} (hr : 0 < r) (hx : -1 ≤ x) :
    factor r x ≠ 0 := by
  intro h
  have hd := cube_factor_natDegree hr hx
  simp [h] at hd

theorem cube_factor_leadingCoeff {r x : ℝ} (hr : 0 < r) (hx : -1 ≤ x) :
    (factor r x).leadingCoeff = ((1+r*(1+x)/2 : ℝ) : ℂ) := by
  rw [factor_linear,leadingCoeff_linear]
  · push_cast
    rfl
  · exact_mod_cast ne_of_gt (cube_factor_leading_pos hr hx)

theorem q_natDegree_le_one (x : ℝ) : (q x).natDegree ≤ 1 := by
  exact natDegree_linear_le

theorem cube_characteristic_degree_leading {r x : ι → ℝ} {d : ℕ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, -1 ≤ x i) (hd : 1 ≤ d) (b : ℝ) :
    (characteristic r x d b).natDegree=Fintype.card ι+d ∧
    (characteristic r x d b).leadingCoeff=(∏ i, ((1+r i*(1+x i)/2 : ℝ) : ℂ)) := by
  have hn : (∏ i, factor (r i) (x i)) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun i _ => cube_factor_ne_zero (hr i) (hx i))
  have hD : (∏ i, factor (r i) (x i)).natDegree=Fintype.card ι := by
    rw [natDegree_prod _ _ (fun i _ => cube_factor_ne_zero (hr i) (hx i))]
    simp only [cube_factor_natDegree (hr _) (hx _),Finset.sum_const,Finset.card_univ,
      smul_eq_mul,mul_one]
  have hQ : (∏ i, q (x i)).natDegree ≤ Fintype.card ι := by
    calc
      _ ≤ ∑ i, (q (x i)).natDegree := natDegree_prod_le _ _
      _ ≤ ∑ _i : ι, 1 := Finset.sum_le_sum (fun i _ => q_natDegree_le_one (x i))
      _ = _ := by simp
  have ht : (C (b : ℂ)*∏ i, q (x i)).natDegree < (X^d*∏ i, factor (r i) (x i)).natDegree := by
    have hle := (natDegree_C_mul_le (b : ℂ) (∏ i, q (x i))).trans hQ
    rw [natDegree_X_pow_mul d hn,hD]
    omega
  unfold characteristic
  constructor
  · rw [natDegree_add_eq_left_of_natDegree_lt ht,natDegree_X_pow_mul d hn,hD]
  · rw [leadingCoeff_add_of_degree_lt' (degree_lt_degree ht),leadingCoeff_mul,
      leadingCoeff_pow,leadingCoeff_X,one_pow,one_mul,leadingCoeff_prod]
    exact Finset.prod_congr rfl (fun i _ => cube_factor_leadingCoeff (hr i) (hx i))

def factorRoot (r x : ℝ) : ℂ :=
  (((1-r*(1-x)/2)/(1+r*(1+x)/2) : ℝ) : ℂ)

theorem cube_factorRoot_eval {r x : ℝ} (hr : 0 < r) (hx : -1 ≤ x) :
    (factor r x).eval (factorRoot r x)=0 := by
  have hn : (1+(r:ℂ)*(1+x)/2) ≠ 0 := by
    exact_mod_cast ne_of_gt (cube_factor_leading_pos hr hx)
  rw [factor_linear]
  simp only [eval_add,eval_mul,eval_C,eval_X]
  unfold factorRoot
  push_cast
  rw [mul_div_cancel₀ _ hn]
  ring

theorem cube_factorRoot_exterior {r x : ℝ} (hr : 0 < r) (hx : -1 ≤ x)
    (hbad : x < -2/r) : 1 < ‖factorRoot r x‖ := by
  have ha := cube_factor_leading_pos hr hx
  have hnum : (1-r*(1-x)/2)/(1+r*(1+x)/2) < -1 := by
    apply (div_lt_iff₀ ha).2
    have hb := (lt_div_iff₀ hr).mp hbad
    nlinarith
  unfold factorRoot
  rw [Complex.norm_real,Real.norm_eq_abs,abs_of_neg (by linarith)]
  linarith

theorem cube_zero_gain_exterior_root {r x : ι → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, -1 ≤ x i) (d : ℕ)
    (j : ι) (hbad : x j < -2/r j) :
    (characteristic r x d 0).eval (factorRoot (r j) (x j))=0 ∧
      1 < ‖factorRoot (r j) (x j)‖ := by
  constructor
  · have hprod : (∏ i, (factor (r i) (x i)).eval (factorRoot (r j) (x j)))=0 := by
      exact Finset.prod_eq_zero (Finset.mem_univ j) (cube_factorRoot_eval (hr j) (hx j))
    simp [characteristic,eval_prod,hprod]
  · exact cube_factorRoot_exterior (hr j) (hx j) hbad

/-- A fixed-degree characteristic family cannot acquire Schur stability at
arbitrarily small gain when its zero-gain polynomial has an exterior root. -/
theorem cube_exterior_root_small_gain_not_schur {r x : ι → ℝ} {d : ℕ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, -1 ≤ x i) (hd : 1 ≤ d)
    {z : ℂ} (hz : 1 < ‖z‖) (hroot : (characteristic r x d 0).eval z=0) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ b : ℝ, |b| < ε → ¬SchurStable (characteristic r x d b) := by
  let L : ℂ := ∏ i, ((1+r i*(1+x i)/2 : ℝ) : ℂ)
  let Q : ℂ := ∏ i, (q (x i)).eval z
  let C : ℝ := ‖L‖*(‖z‖-1)^(Fintype.card ι+d)
  have hL : L ≠ 0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro i _
    exact_mod_cast ne_of_gt (cube_factor_leading_pos (hr i) (hx i))
  have hC : 0 < C := mul_pos (norm_pos_iff.mpr hL) (pow_pos (sub_pos.mpr hz) _)
  have hQ : 0 < ‖Q‖+1 := by positivity
  refine ⟨C/(‖Q‖+1),div_pos hC hQ,?_⟩
  intro b hb hstable
  have hbound := schur_eval_norm_lower_bound hstable hz
  obtain ⟨hdeg,hlead⟩ := cube_characteristic_degree_leading hr hx hd b
  rw [hdeg,hlead] at hbound
  have hzero : z^d*(∏ i, (factor (r i) (x i)).eval z)=0 := by
    simpa [characteristic,eval_prod] using hroot
  have heval : (characteristic r x d b).eval z=(b:ℂ)*Q := by
    simp only [characteristic,eval_add,eval_mul,eval_pow,eval_X,eval_prod,eval_C]
    rw [hzero,zero_add]
  rw [heval,norm_mul,Complex.norm_real,Real.norm_eq_abs] at hbound
  have hsmall := (lt_div_iff₀ hQ).mp hb
  change C ≤ |b| *‖Q‖ at hbound
  nlinarith [abs_nonneg b]

/-- The outside-cube branch of the global theorem: one coordinate below -2/r
precludes any positive initial interval of Schur stability. -/
theorem cube_bad_coordinate_small_gain_not_schur {r x : ι → ℝ} {d : ℕ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, -1 ≤ x i) (hd : 1 ≤ d)
    (j : ι) (hbad : x j < -2/r j) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ b : ℝ, |b| < ε → ¬SchurStable (characteristic r x d b) := by
  have hh := cube_zero_gain_exterior_root hr hx d j hbad
  exact cube_exterior_root_small_gain_not_schur hr hx hd hh.2 hh.1

end C2.NGamma.PolynomialModel

end

/- ===== C2.IntegratorDelayCayley ===== -/

noncomputable section
open Polynomial Filter
open scoped Topology ComplexConjugate
namespace C2.IntegratorDelay
open C2.NGamma.PolynomialModel
open C2.NGamma.Cayley

def poly (n : ℕ) (x a : ℝ) : Polynomial ℂ :=
  X ^ n * (X - 1) + C (a : ℂ) * q x

def transfer (n : ℕ) (x : ℝ) (z : ℂ) : ℂ :=
  z ^ n * (z - 1) / (q x).eval z

theorem poly_eval (n : ℕ) (x a : ℝ) (z : ℂ) :
    (poly n x a).eval z = z ^ n * (z - 1) + (a : ℂ) * (q x).eval z := by
  simp [poly]

theorem poly_natDegree {n : ℕ} (hn : 1 ≤ n) (x a : ℝ) :
    (poly n x a).natDegree = n + 1 := by
  have hd : (X ^ n * (X - 1) : Polynomial ℂ).natDegree = n + 1 := by
    rw [natDegree_X_pow_mul n (by simpa using X_sub_C_ne_zero (1 : ℂ))]
    have hsub : (X - 1 : Polynomial ℂ).natDegree = 1 := by
      simpa only [Polynomial.C_1] using natDegree_X_sub_C (1 : ℂ)
    rw [hsub]
    omega
  have hl : (C (a : ℂ) * q x).natDegree < (X ^ n * (X - 1) : Polynomial ℂ).natDegree := by
    have h := (natDegree_C_mul_le (a : ℂ) (q x)).trans (q_natDegree_le_one x)
    rw [hd]
    omega
  unfold poly
  rw [natDegree_add_eq_left_of_natDegree_lt hl, hd]

theorem poly_ne_zero {n : ℕ} (hn : 1 ≤ n) (x a : ℝ) : poly n x a ≠ 0 := by
  intro h
  have hd := poly_natDegree hn x a
  rw [h, natDegree_zero] at hd
  omega

theorem poly_eval_one (n : ℕ) (x a : ℝ) : (poly n x a).eval 1 = (a : ℂ) := by
  simp [poly_eval, q_eval_one]

theorem poly_eval_neg_one (n : ℕ) (x a : ℝ) :
    (poly n x a).eval (-1) = -2 * (-1 : ℂ) ^ n - (a : ℂ) * x := by
  rw [poly_eval, q_eval_neg_one]
  ring

theorem poly_eval_conj (n : ℕ) (x a : ℝ) (z : ℂ) :
    (poly n x a).eval (conj z) = conj ((poly n x a).eval z) := by
  simp [poly_eval, q_eval, map_add, map_sub, map_mul, map_pow, _root_.map_div, map_ofNat]

theorem poly_eval_point (n : ℕ) (x a t : ℝ) :
    (poly n x a).eval (point t) =
      (q x).eval (point t) * (transfer n x (point t) + a) := by
  rw [poly_eval]
  unfold transfer
  field_simp [q_eval_point_ne_zero x t]

theorem transfer_point (n : ℕ) (x t : ℝ) :
    transfer n x (point t) = (point t) ^ n * (2 * Complex.I * t) /
      (1 + Complex.I * (x * t : ℝ)) := by
  unfold transfer
  rw [q_eval_point]
  have hp : point t - 1 = (2 * Complex.I * t) / (1 - Complex.I * t) := by
    unfold point
    field_simp [one_sub_I_mul_ne_zero t]
    ring
  rw [hp]
  field_simp [one_sub_I_mul_ne_zero t, one_add_I_mul_ne_zero (x * t)]

theorem transfer_polar (n : ℕ) (x t : ℝ) (_ht : 0 ≤ t) :
    transfer n x (point t) = (amplitude x t : ℂ) *
      Complex.exp ((totalPhase n x t : ℂ) * Complex.I) := by
  rw [transfer_point, point_exp, linear_polar, ← Complex.exp_nat_mul]
  have hpi : Complex.exp (((Real.pi / 2 : ℝ) : ℂ) * Complex.I) = Complex.I := by
    simpa using Complex.exp_pi_div_two_mul_I
  simp only [amplitude, totalPhase, Complex.ofReal_div, Complex.ofReal_mul,
    Complex.ofReal_sub, Complex.ofReal_add, Complex.ofReal_natCast, Complex.ofReal_ofNat,
    sub_mul, add_mul, Complex.exp_sub, Complex.exp_add]
  rw [show (Real.pi : ℂ) / 2 * Complex.I = ((Real.pi / 2 : ℝ) : ℂ) * Complex.I by push_cast; ring, hpi]
  congr 1 <;> ring

theorem transfer_norm (n : ℕ) (x t : ℝ) (ht : 0 ≤ t) :
    ‖transfer n x (point t)‖ = amplitude x t := by
  rw [transfer_polar n x t ht, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (amplitude_nonneg x ht), Complex.norm_exp_ofReal_mul_I, mul_one]

theorem point_tendsto_atTop : Tendsto point atTop (𝓝 (-1 : ℂ)) := by
  have ha := (Real.tendsto_arctan_atTop.mono_right nhdsWithin_le_nhds).const_mul 2
  have hc := (Complex.continuous_ofReal.tendsto _).comp ha
  have he := Complex.continuous_exp.continuousAt.tendsto.comp (hc.mul_const Complex.I)
  convert he using 1
  · funext t
    exact point_exp t
  · have hp : (2 * (Real.pi / 2) : ℝ) = Real.pi := by ring
    rw [hp, Complex.exp_pi_mul_I]

theorem reciprocal_transfer_identity (n : ℕ) (x a : ℝ) {t : ℝ} (ht : t ≠ 0) :
    (a : ℂ) / transfer n x (point t) =
      (a : ℂ) * ((x : ℂ) / 2 + (1 / t : ℝ) / (2 * Complex.I)) / (point t) ^ n := by
  rw [transfer_point]
  have hp : point t ≠ 0 := by intro h; have hn := point_norm t; simp [h] at hn
  have htc : (t : ℂ) ≠ 0 := by exact_mod_cast ht
  have hlin : (x : ℂ) / 2 + ((1 / t : ℝ) : ℂ) / (2 * Complex.I) =
      (1 + Complex.I * ((x * t : ℝ) : ℂ)) / (2 * Complex.I * t) := by
    push_cast
    field_simp [htc, Complex.I_ne_zero]
    <;> ring
  rw [hlin]
  simp only [div_eq_mul_inv, mul_inv_rev, inv_inv]
  ring

theorem reciprocal_transfer_tendsto_atTop (n : ℕ) (x a : ℝ) :
    Tendsto (fun t => (a : ℂ) / transfer n x (point t)) atTop
      (𝓝 (((a * x / (2 * (-1) ^ n) : ℝ) : ℂ))) := by
  have hi : Tendsto (fun t : ℝ => ((1 / t : ℝ) : ℂ)) atTop (𝓝 0) := by
    simpa only [Function.comp_def, one_div, Complex.ofReal_zero] using
      (Complex.continuous_ofReal.tendsto 0).comp tendsto_inv_atTop_zero
  have hnum : Tendsto (fun t : ℝ => (a : ℂ) * ((x : ℂ) / 2 + ((1 / t : ℝ) : ℂ) / (2 * Complex.I)))
      atTop (𝓝 ((a : ℂ) * ((x : ℂ) / 2 + 0 / (2 * Complex.I)))) :=
    (tendsto_const_nhds.add (hi.div_const (2 * Complex.I))).const_mul (a : ℂ)
  have hden := point_tendsto_atTop.pow n
  have hlim := hnum.div hden (pow_ne_zero n (by norm_num : (-1 : ℂ) ≠ 0))
  have he := hlim.congr' (show ∀ᶠ t : ℝ in atTop,
      (a : ℂ) * ((x : ℂ) / 2 + (1 / t : ℝ) / (2 * Complex.I)) / (point t) ^ n =
        (a : ℂ) / transfer n x (point t) from by
    filter_upwards [eventually_gt_atTop (0 : ℝ)] with t ht
    exact (reciprocal_transfer_identity n x a ht.ne').symm)
  convert he using 1 <;> push_cast <;> ring

theorem transfer_tendsto_atTop (n : ℕ) {x : ℝ} (hx : x ≠ 0) :
    Tendsto (fun t => transfer n x (point t)) atTop
      (𝓝 (((2 * (-1) ^ n / x : ℝ) : ℂ))) := by
  have hxC : (x : ℂ) ≠ 0 := by exact_mod_cast hx
  have hn : (2 * (-1 : ℂ) ^ n) ≠ 0 := mul_ne_zero (by norm_num) (pow_ne_zero n (by norm_num))
  have hnon : (((1 * x / (2 * (-1) ^ n) : ℝ) : ℂ)) ≠ 0 := by
    push_cast
    simpa only [one_mul] using div_ne_zero hxC hn
  have he := (reciprocal_transfer_tendsto_atTop n x 1).inv₀ hnon
  convert he using 1
  · funext t
    simp
  · push_cast
    field_simp

end C2.IntegratorDelay

end

/- ===== C2.NGammaArgumentMatch ===== -/

/-! Branch matching at the unique amplitude crossing. -/

noncomputable section
open scoped Topology

namespace C2.NGamma.ArgumentMatch

lemma exp_sub_turns (u : ℝ) (k : ℤ) :
    Complex.exp (((u-2*Real.pi*k : ℝ) : ℂ)*Complex.I) =
      Complex.exp ((u : ℂ)*Complex.I) := by
  push_cast
  rw [sub_mul, Complex.exp_sub]
  have h : (2*(Real.pi : ℂ)*(k : ℂ))*Complex.I = (k : ℂ)*(2*Real.pi*Complex.I) := by ring
  rw [h, Complex.exp_int_mul_two_pi_mul_I, div_one]

lemma one_add_exp_half (u : ℝ) :
    1 + Complex.exp ((u : ℂ)*Complex.I) =
      (2*Real.cos (u/2) : ℝ) * Complex.exp (((u/2 : ℝ) : ℂ)*Complex.I) := by
  have hcos := Real.cos_two_mul (u/2)
  have hsin := Real.sin_two_mul (u/2)
  have he : 2*(u/2) = u := by ring
  rw [he] at hcos hsin
  simp only [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
  apply Complex.ext <;> simp only [Complex.add_re, Complex.add_im, Complex.one_re,
    Complex.one_im, Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
    Complex.I_re, Complex.I_im, mul_zero, zero_mul, add_zero, zero_add, sub_zero, mul_one]
  · nlinarith
  · nlinarith

lemma arg_one_add_exp {u : ℝ} (hlo : -Real.pi < u) (hhi : u < Real.pi) :
    Complex.arg (1+Complex.exp ((u : ℂ)*Complex.I)) = u/2 := by
  have hc : 0 < 2*Real.cos (u/2) := by
    apply mul_pos (by norm_num)
    exact Real.cos_pos_of_mem_Ioo ⟨by linarith, by linarith⟩
  rw [one_add_exp_half, Complex.arg_real_mul _ hc, Complex.exp_mul_I]
  exact Complex.arg_cos_add_sin_mul_I ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩

lemma arg_one_add_exp_neg {u : ℝ} (hlo : -Real.pi < u) (hhi : u < Real.pi) :
    Complex.arg (1+Complex.exp (-(u : ℂ)*Complex.I)) = -(u/2) := by
  have h := arg_one_add_exp (u := -u) (by linarith) (by linarith)
  simpa only [Complex.ofReal_neg, neg_div] using h

lemma amplitude_crossing_branch_match {b : ℝ} (hb : 0 < b) (u : ℝ) (k : ℤ)
    (hlo : -Real.pi < u-2*Real.pi*k) (hhi : u-2*Real.pi*k < Real.pi) :
    Complex.arg ((b : ℂ)*Complex.exp ((u : ℂ)*Complex.I)+b) =
      u + Complex.arg (1+(b : ℂ)/((b : ℂ)*Complex.exp ((u : ℂ)*Complex.I))) - 2*Real.pi*k := by
  have hbn : (b : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hb
  have hfac : (b : ℂ)*Complex.exp ((u : ℂ)*Complex.I)+b =
      (b : ℂ)*(1+Complex.exp ((u : ℂ)*Complex.I)) := by ring
  have hquot : (b : ℂ)/((b : ℂ)*Complex.exp ((u : ℂ)*Complex.I)) =
      Complex.exp (-(u : ℂ)*Complex.I) := by
    rw [neg_mul, Complex.exp_neg]
    field_simp
  have hperiod := exp_sub_turns u k
  have hnegperiod : Complex.exp (-((u-2*Real.pi*k : ℝ) : ℂ)*Complex.I) =
      Complex.exp (-(u : ℂ)*Complex.I) := by
    simp only [neg_mul, Complex.exp_neg]
    rw [hperiod]
  rw [hfac, Complex.arg_real_mul _ hb, hquot, ← hperiod, ← hnegperiod,
    arg_one_add_exp hlo hhi, arg_one_add_exp_neg hlo hhi]
  ring

end C2.NGamma.ArgumentMatch

end

/- ===== C2.NGammaPiecewiseLift ===== -/

/-! A continuous argument for a positive amplitude curve translated by a positive
real number.  The branch shift is proved at its unique amplitude crossing. -/

noncomputable section
open Set
set_option maxHeartbeats 800000
open scoped Topology

namespace C2.NGamma.ArgumentMatch

def polarCurve (B ψ : ℝ → ℝ) (t : ℝ) : ℂ :=
  (B t : ℂ)*Complex.exp ((ψ t : ℂ)*Complex.I)

def translatedAngle (B ψ : ℝ → ℝ) (b tb : ℝ) (k : ℤ) (t : ℝ) : ℝ :=
  if t ≤ tb then Complex.arg (polarCurve B ψ t+b)
  else ψ t+Complex.arg (1+(b:ℂ)/polarCurve B ψ t)-2*Real.pi*k

lemma polarCurve_norm {B ψ : ℝ → ℝ} {t : ℝ} (hB : 0 < B t) :
    ‖polarCurve B ψ t‖ = B t := by
  simp [polarCurve, norm_mul, Complex.norm_exp_ofReal_mul_I, abs_of_pos hB]

lemma polarCurve_ne_zero {B ψ : ℝ → ℝ} {t : ℝ} (hB : 0 < B t) :
    polarCurve B ψ t ≠ 0 := by
  apply norm_ne_zero_iff.mp
  rw [polarCurve_norm hB]
  exact ne_of_gt hB

lemma polarCurve_continuous {B ψ : ℝ → ℝ} (hB : Continuous B) (hψ : Continuous ψ) :
    Continuous (polarCurve B ψ) := by
  exact (Complex.continuous_ofReal.comp hB).mul
    (Complex.continuous_exp.comp ((Complex.continuous_ofReal.comp hψ).mul continuous_const))

lemma one_add_exp_re_pos {u : ℝ} (hlo : -Real.pi < u) (hhi : u < Real.pi) :
    0 < (1+Complex.exp ((u : ℂ)*Complex.I)).re := by
  have hc : 0 < Real.cos (u/2) := Real.cos_pos_of_mem_Ioo ⟨by linarith, by linarith⟩
  rw [one_add_exp_half]
  simp only [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
  simp only [Complex.mul_re, Complex.add_re, Complex.ofReal_re, Complex.ofReal_im,
    Complex.I_re, Complex.I_im, mul_zero, zero_mul, add_zero, sub_zero]
  exact mul_pos (mul_pos (by norm_num) hc) hc

lemma add_re_pos_of_norm_lt {z : ℂ} {b : ℝ} (h : ‖z‖ < b) :
    0 < (z+(b:ℂ)).re := by
  have hlo := (abs_le.mp (Complex.abs_re_le_norm z)).1
  simp only [Complex.add_re, Complex.ofReal_re]
  linarith

lemma one_add_re_pos_of_norm_lt {z : ℂ} (h : ‖z‖ < 1) :
    0 < (1+z).re := by
  simpa only [add_comm] using add_re_pos_of_norm_lt h

lemma left_branch_re_pos {B ψ : ℝ → ℝ} {b tb : ℝ} {k : ℤ}
    (hBp : ∀ t ∈ Ici (0:ℝ), 0 < B t) (hBm : StrictMonoOn B (Ici 0))
    (htb : 0 ≤ tb) (hBeq : B tb = b)
    (hlo : -Real.pi < ψ tb-2*Real.pi*k) (hhi : ψ tb-2*Real.pi*k < Real.pi)
    {t : ℝ} (ht : 0 ≤ t) (htt : t ≤ tb) :
    0 < (polarCurve B ψ t+b).re := by
  rcases lt_or_eq_of_le htt with hlt | heq
  · apply add_re_pos_of_norm_lt
    rw [polarCurve_norm (hBp t ht)]
    rw [← hBeq]
    exact hBm ht htb hlt
  · subst t
    have hb : 0 < b := hBeq ▸ hBp tb htb
    have hp := one_add_exp_re_pos hlo hhi
    rw [exp_sub_turns] at hp
    have he : polarCurve B ψ tb+b = (b:ℂ)*(1+Complex.exp ((ψ tb : ℂ)*Complex.I)) := by
      simp only [polarCurve, hBeq]
      ring
    rw [he]
    simpa using mul_pos hb hp

lemma right_branch_re_pos {B ψ : ℝ → ℝ} {b tb : ℝ} {k : ℤ}
    (hBp : ∀ t ∈ Ici (0:ℝ), 0 < B t) (hBm : StrictMonoOn B (Ici 0))
    (htb : 0 ≤ tb) (hBeq : B tb = b)
    (hlo : -Real.pi < ψ tb-2*Real.pi*k) (hhi : ψ tb-2*Real.pi*k < Real.pi)
    {t : ℝ} (htt : tb ≤ t) :
    0 < (1+(b:ℂ)/polarCurve B ψ t).re := by
  have ht : 0 ≤ t := le_trans htb htt
  have hb : 0 < b := hBeq ▸ hBp tb htb
  rcases lt_or_eq_of_le htt with hlt | heq
  · apply one_add_re_pos_of_norm_lt
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hb,
      polarCurve_norm (hBp t ht)]
    apply (div_lt_one (hBp t ht)).2
    rw [← hBeq]
    exact hBm htb ht hlt
  · subst t
    have hbn : (b:ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hb
    have he : (b:ℂ)/polarCurve B ψ tb = Complex.exp (-((ψ tb):ℂ)*Complex.I) := by
      rw [polarCurve, hBeq, neg_mul, Complex.exp_neg]
      field_simp
    rw [he, neg_mul, Complex.exp_neg, ← exp_sub_turns (ψ tb) k, ← Complex.exp_neg, ← neg_mul]
    convert one_add_exp_re_pos (u := -(ψ tb-2*Real.pi*k)) (by linarith) (by linarith) using 1 <;> simp only [Complex.ofReal_neg]

lemma translatedAngle_continuousOn {B ψ : ℝ → ℝ} {b tb : ℝ} {k : ℤ}
    (hB : Continuous B) (hψ : Continuous ψ)
    (hBp : ∀ t ∈ Ici (0:ℝ), 0 < B t) (hBm : StrictMonoOn B (Ici 0))
    (htb : 0 ≤ tb) (hBeq : B tb = b)
    (hlo : -Real.pi < ψ tb-2*Real.pi*k) (hhi : ψ tb-2*Real.pi*k < Real.pi) :
    ContinuousOn (translatedAngle B ψ b tb k) (Ici 0) := by
  have hW := polarCurve_continuous hB hψ
  have hleft : ContinuousOn (fun t => Complex.arg (polarCurve B ψ t+b)) (Ici 0 ∩ Iic tb) := by
    intro t ht
    have hc : ContinuousWithinAt (fun u => polarCurve B ψ u + (b:ℂ)) (Ici 0 ∩ Iic tb) t :=
      (hW.add continuous_const).continuousAt.continuousWithinAt
    exact ContinuousAt.comp_continuousWithinAt (f := fun u => polarCurve B ψ u + (b:ℂ))
      (Complex.continuousAt_arg (Or.inl (left_branch_re_pos hBp hBm htb hBeq hlo hhi ht.1 ht.2))) hc
  have hright : ContinuousOn (fun t => ψ t+Complex.arg (1+(b:ℂ)/polarCurve B ψ t)-2*Real.pi*k)
      (Ici 0 ∩ Ici tb) := by
    intro t ht
    apply ContinuousWithinAt.sub _ continuousWithinAt_const
    apply hψ.continuousAt.continuousWithinAt.add
    have hc : ContinuousWithinAt (fun u => 1+(b:ℂ)/polarCurve B ψ u) (Ici 0 ∩ Ici tb) t :=
      continuousWithinAt_const.add (continuousWithinAt_const.div hW.continuousAt.continuousWithinAt
        (polarCurve_ne_zero (hBp t ht.1)))
    exact ContinuousAt.comp_continuousWithinAt (f := fun u => 1+(b:ℂ)/polarCurve B ψ u)
      (Complex.continuousAt_arg (Or.inl (right_branch_re_pos hBp hBm htb hBeq hlo hhi ht.2))) hc
  have hmatch : ∀ t ∈ Ici (0:ℝ) ∩ frontier (Iic tb),
      Complex.arg (polarCurve B ψ t+b) =
        ψ t+Complex.arg (1+(b:ℂ)/polarCurve B ψ t)-2*Real.pi*k := by
    intro t ht
    have he : t = tb := by simpa using ht.2
    subst t
    simp only [polarCurve, hBeq]
    exact amplitude_crossing_branch_match (hBeq ▸ hBp tb htb) (ψ tb) k hlo hhi
  simpa only [closure_Iic, compl_Iic, closure_Ioi, Set.piecewise, mem_Iic] using
    (ContinuousOn.piecewise (t := Iic tb) hmatch
      (by simpa only [closure_Iic] using hleft)
      (by simpa only [compl_Iic, closure_Ioi] using hright))

lemma translated_curve_ne_zero {B ψ : ℝ → ℝ} {b tb : ℝ} {k : ℤ}
    (hBp : ∀ t ∈ Ici (0:ℝ), 0 < B t) (hBm : StrictMonoOn B (Ici 0))
    (htb : 0 ≤ tb) (hBeq : B tb = b)
    (hlo : -Real.pi < ψ tb-2*Real.pi*k) (hhi : ψ tb-2*Real.pi*k < Real.pi)
    {t : ℝ} (ht : 0 ≤ t) : polarCurve B ψ t+b ≠ 0 := by
  by_cases htt : t ≤ tb
  · intro hz
    have hp := left_branch_re_pos hBp hBm htb hBeq hlo hhi ht htt
    rw [hz] at hp
    exact lt_irrefl 0 hp
  · have hW := polarCurve_ne_zero (ψ := ψ) (hBp t ht)
    have hp := right_branch_re_pos hBp hBm htb hBeq hlo hhi (le_of_not_ge htt)
    intro hz
    have he : 1+(b:ℂ)/polarCurve B ψ t = 0 := by
      field_simp
      linear_combination hz
    rw [he] at hp
    exact lt_irrefl 0 hp

lemma translatedAngle_polar {B ψ : ℝ → ℝ} {b tb : ℝ} {k : ℤ}
    {t : ℝ} (hBp : 0 < B t) :
    polarCurve B ψ t+b = (‖polarCurve B ψ t+b‖ : ℂ)*
      Complex.exp ((translatedAngle B ψ b tb k t : ℂ)*Complex.I) := by
  unfold translatedAngle
  split_ifs with htt
  · exact (Complex.norm_mul_exp_arg_mul_I _).symm
  · set W := polarCurve B ψ t
    set Z : ℂ := 1+(b:ℂ)/W
    have hW : W ≠ 0 := polarCurve_ne_zero hBp
    have hmul : W+b = W*Z := by dsimp [Z]; field_simp
    have hnorm : ‖W+b‖ = B t*‖Z‖ := by
      rw [hmul, norm_mul]
      exact congrArg (fun v : ℝ => v*‖Z‖) (polarCurve_norm hBp)
    rw [exp_sub_turns, Complex.ofReal_add, add_mul, Complex.exp_add, hnorm,
      Complex.ofReal_mul]
    calc
      W+b = W*Z := hmul
      _ = (B t:ℂ)*Complex.exp ((ψ t:ℂ)*Complex.I)*
          ((‖Z‖:ℂ)*Complex.exp ((Complex.arg Z:ℂ)*Complex.I)) := by
        rw [Complex.norm_mul_exp_arg_mul_I]
        rfl
      _ = _ := by ring

lemma translatedAngle_zero {B ψ : ℝ → ℝ} {b tb : ℝ} {k : ℤ}
    (hB0 : 0 < B 0) (hb : 0 < b) (htb : 0 ≤ tb) (hψ0 : ψ 0 = 0) :
    translatedAngle B ψ b tb k 0 = 0 := by
  simp only [translatedAngle, htb, if_pos, polarCurve, hψ0, Complex.ofReal_zero,
    zero_mul, Complex.exp_zero, mul_one]
  have hp : 0 < B 0+b := add_pos hB0 hb
  rw [← Complex.ofReal_add]
  exact Complex.arg_ofReal_of_nonneg hp.le

lemma translatedAngle_tendsto_atTop {B ψ : ℝ → ℝ} {b tb L : ℝ} {k : ℤ}
    (hψ : Filter.Tendsto ψ Filter.atTop (𝓝 L))
    (harg : Filter.Tendsto (fun t => Complex.arg (1+(b:ℂ)/polarCurve B ψ t))
      Filter.atTop (𝓝 0)) :
    Filter.Tendsto (translatedAngle B ψ b tb k) Filter.atTop (𝓝 (L-2*Real.pi*k)) := by
  have h := (hψ.add harg).sub_const (2*Real.pi*k)
  simp only [add_zero] at h
  apply h.congr'
  filter_upwards [Filter.eventually_gt_atTop tb] with t ht
  simp only [translatedAngle, not_le.mpr ht, if_false]

end C2.NGamma.ArgumentMatch

end

/- ===== C2.IntegratorDelayLift ===== -/

/-! A translated polar curve whose amplitude is zero at the initial endpoint.
This is the integrator version of the strictly-positive cascade argument lift. -/
noncomputable section
open Set
open scoped Topology
namespace C2.IntegratorDelay
open NGamma.ArgumentMatch

theorem polarCurve_norm_nonneg {B ψ : ℝ → ℝ} {t : ℝ} (hB : 0 ≤ B t) :
    ‖polarCurve B ψ t‖ = B t := by
  simp [polarCurve, norm_mul, Complex.norm_exp_ofReal_mul_I, abs_of_nonneg hB]

theorem zero_left_branch_re_pos {B ψ : ℝ → ℝ} {b tb : ℝ} {k : ℤ}
    (hBp : ∀ t ∈ Ici (0 : ℝ), 0 ≤ B t) (hBm : StrictMonoOn B (Ici 0))
    (hb : 0 < b) (htb : 0 ≤ tb) (hBeq : B tb = b)
    (hlo : -Real.pi < ψ tb - 2 * Real.pi * k)
    (hhi : ψ tb - 2 * Real.pi * k < Real.pi)
    {t : ℝ} (ht : 0 ≤ t) (htt : t ≤ tb) :
    0 < (polarCurve B ψ t + b).re := by
  rcases lt_or_eq_of_le htt with hlt | heq
  · apply add_re_pos_of_norm_lt
    rw [polarCurve_norm_nonneg (hBp t ht), ← hBeq]
    exact hBm ht htb hlt
  · subst t
    have hp := one_add_exp_re_pos hlo hhi
    rw [exp_sub_turns] at hp
    have he : polarCurve B ψ tb + b =
        (b : ℂ) * (1 + Complex.exp ((ψ tb : ℂ) * Complex.I)) := by
      simp only [polarCurve, hBeq]
      ring
    rw [he]
    simpa using mul_pos hb hp

theorem zero_right_branch_re_pos {B ψ : ℝ → ℝ} {b tb : ℝ} {k : ℤ}
    (hBp : ∀ t ∈ Ioi (0 : ℝ), 0 < B t) (hBm : StrictMonoOn B (Ici 0))
    (hb : 0 < b) (htb : 0 < tb) (hBeq : B tb = b)
    (hlo : -Real.pi < ψ tb - 2 * Real.pi * k)
    (hhi : ψ tb - 2 * Real.pi * k < Real.pi)
    {t : ℝ} (htt : tb ≤ t) :
    0 < (1 + (b : ℂ) / polarCurve B ψ t).re := by
  have ht : 0 < t := lt_of_lt_of_le htb htt
  rcases lt_or_eq_of_le htt with hlt | heq
  · apply one_add_re_pos_of_norm_lt
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hb,
      polarCurve_norm (hBp t ht)]
    apply (div_lt_one (hBp t ht)).2
    rw [← hBeq]
    exact hBm htb.le ht.le hlt
  · subst t
    have hbn : (b : ℂ) ≠ 0 := by exact_mod_cast hb.ne'
    have he : (b : ℂ) / polarCurve B ψ tb = Complex.exp (-((ψ tb) : ℂ) * Complex.I) := by
      rw [polarCurve, hBeq, neg_mul, Complex.exp_neg]
      field_simp
    rw [he, neg_mul, Complex.exp_neg, ← exp_sub_turns (ψ tb) k,
      ← Complex.exp_neg, ← neg_mul]
    convert one_add_exp_re_pos (u := -(ψ tb - 2 * Real.pi * k))
      (by linarith) (by linarith) using 1 <;> simp only [Complex.ofReal_neg]

theorem zero_translatedAngle_continuousOn {B ψ : ℝ → ℝ} {b tb : ℝ} {k : ℤ}
    (hB : Continuous B) (hψ : Continuous ψ)
    (hB0 : ∀ t ∈ Ici (0 : ℝ), 0 ≤ B t) (hBp : ∀ t ∈ Ioi (0 : ℝ), 0 < B t)
    (hBm : StrictMonoOn B (Ici 0)) (hb : 0 < b) (htb : 0 < tb) (hBeq : B tb = b)
    (hlo : -Real.pi < ψ tb - 2 * Real.pi * k)
    (hhi : ψ tb - 2 * Real.pi * k < Real.pi) :
    ContinuousOn (translatedAngle B ψ b tb k) (Ici 0) := by
  have hW := polarCurve_continuous hB hψ
  have hleft : ContinuousOn (fun t => Complex.arg (polarCurve B ψ t + b))
      (Ici 0 ∩ Iic tb) := by
    intro t ht
    exact ContinuousAt.comp_continuousWithinAt (f := fun u => polarCurve B ψ u + (b : ℂ))
      (Complex.continuousAt_arg (Or.inl
        (zero_left_branch_re_pos hB0 hBm hb htb.le hBeq hlo hhi ht.1 ht.2)))
      (hW.add continuous_const).continuousAt.continuousWithinAt
  have hright : ContinuousOn
      (fun t => ψ t + Complex.arg (1 + (b : ℂ) / polarCurve B ψ t) - 2 * Real.pi * k)
      (Ici 0 ∩ Ici tb) := by
    intro t ht
    apply ContinuousWithinAt.sub _ continuousWithinAt_const
    apply hψ.continuousAt.continuousWithinAt.add
    have hc : ContinuousWithinAt (fun u => 1 + (b : ℂ) / polarCurve B ψ u)
        (Ici 0 ∩ Ici tb) t :=
      continuousWithinAt_const.add
        (continuousWithinAt_const.div hW.continuousAt.continuousWithinAt
          (polarCurve_ne_zero (hBp t (lt_of_lt_of_le htb ht.2))))
    exact ContinuousAt.comp_continuousWithinAt
      (f := fun u => 1 + (b : ℂ) / polarCurve B ψ u)
      (Complex.continuousAt_arg (Or.inl
        (zero_right_branch_re_pos hBp hBm hb htb hBeq hlo hhi ht.2))) hc
  have hmatch : ∀ t ∈ Ici (0 : ℝ) ∩ frontier (Iic tb),
      Complex.arg (polarCurve B ψ t + b) =
        ψ t + Complex.arg (1 + (b : ℂ) / polarCurve B ψ t) - 2 * Real.pi * k := by
    intro t ht
    have he : t = tb := by simpa using ht.2
    subst t
    simp only [polarCurve, hBeq]
    exact amplitude_crossing_branch_match hb (ψ tb) k hlo hhi
  simpa only [closure_Iic, compl_Iic, closure_Ioi, Set.piecewise, mem_Iic] using
    (ContinuousOn.piecewise (t := Iic tb) hmatch
      (by simpa only [closure_Iic] using hleft)
      (by simpa only [compl_Iic, closure_Ioi] using hright))

theorem zero_translated_curve_ne_zero {B ψ : ℝ → ℝ} {b tb : ℝ} {k : ℤ}
    (hB0 : ∀ t ∈ Ici (0 : ℝ), 0 ≤ B t) (hBp : ∀ t ∈ Ioi (0 : ℝ), 0 < B t)
    (hBm : StrictMonoOn B (Ici 0)) (hb : 0 < b) (htb : 0 < tb) (hBeq : B tb = b)
    (hlo : -Real.pi < ψ tb - 2 * Real.pi * k)
    (hhi : ψ tb - 2 * Real.pi * k < Real.pi)
    {t : ℝ} (ht : 0 ≤ t) : polarCurve B ψ t + b ≠ 0 := by
  by_cases htt : t ≤ tb
  · intro hz
    have hp := zero_left_branch_re_pos hB0 hBm hb htb.le hBeq hlo hhi ht htt
    rw [hz] at hp
    exact lt_irrefl 0 hp
  · have htpos : 0 < t := lt_trans htb (lt_of_not_ge htt)
    have hW := polarCurve_ne_zero (ψ := ψ) (hBp t htpos)
    have hp := zero_right_branch_re_pos hBp hBm hb htb hBeq hlo hhi (le_of_not_ge htt)
    intro hz
    have he : 1 + (b : ℂ) / polarCurve B ψ t = 0 := by
      field_simp
      linear_combination hz
    rw [he] at hp
    exact lt_irrefl 0 hp

theorem zero_translatedAngle_polar {B ψ : ℝ → ℝ} {b tb : ℝ} {k : ℤ}
    (hBp : ∀ t ∈ Ioi (0 : ℝ), 0 < B t) (htb : 0 ≤ tb)
    {t : ℝ} (ht : 0 ≤ t) :
    polarCurve B ψ t + b = (‖polarCurve B ψ t + b‖ : ℂ) *
      Complex.exp ((translatedAngle B ψ b tb k t : ℂ) * Complex.I) := by
  by_cases htt : t ≤ tb
  · simp only [translatedAngle, htt, if_pos]
    exact (Complex.norm_mul_exp_arg_mul_I _).symm
  · exact translatedAngle_polar (hBp t (lt_of_le_of_lt htb (lt_of_not_ge htt)))

theorem zero_translatedAngle_zero {B ψ : ℝ → ℝ} {b tb : ℝ} {k : ℤ}
    (hB0 : B 0 = 0) (hb : 0 < b) (htb : 0 ≤ tb) :
    translatedAngle B ψ b tb k 0 = 0 := by
  simp only [translatedAngle, htb, if_pos, polarCurve, hB0, Complex.ofReal_zero,
    zero_mul, zero_add]
  exact Complex.arg_ofReal_of_nonneg hb.le

end C2.IntegratorDelay

end

/- ===== C2.NGammaRootCountCayley ===== -/

/-! The half-circle argument principle in the manuscript's unbounded Cayley
parameter. Taking the endpoint limit avoids any branch choice at infinity. -/
noncomputable section
open scoped BigOperators ComplexConjugate Topology
open Set Complex Polynomial Filter
namespace C2.NGamma.RootCountBridge

theorem polynomial_argument_principle_cayley {p : Polynomial ℂ} (hp : p ≠ 0)
    (hconj : ∀ z : ℂ, p.eval (conj z) = conj (p.eval z))
    (hroots : ∀ a ∈ p.roots, ‖a‖ ≠ 1) {α : ℝ → ℝ} {L : ℝ}
    (hα : ContinuousOn α (Set.Ici 0))
    (hpolar : ∀ t ∈ Set.Ici 0, p.eval (Cayley.point t) =
      (‖p.eval (Cayley.point t)‖ : ℂ) * Complex.exp ((α t : ℂ) * I))
    (hlim : Tendsto α atTop (𝓝 L)) :
    L - α 0 = (countInside p : ℝ) * Real.pi := by
  let β : ℝ → ℝ := fun t => polynomialAngle p (2 * Real.arctan t)
  have hβ : Continuous β :=
    (continuous_polynomialAngle p hroots).comp (continuous_const.mul Real.continuous_arctan)
  have hpoint (t : ℝ) : Cayley.point t = circle (2 * Real.arctan t) := by
    simpa [circle] using Cayley.point_exp t
  have he : ∀ t ∈ Set.Ici 0, Complex.exp ((α t : ℂ) * I) =
      Complex.exp ((β t : ℂ) * I) := by
    intro t ht
    have hn : (‖p.eval (Cayley.point t)‖ : ℂ) ≠ 0 := by
      rw [hpoint]
      exact_mod_cast (norm_ne_zero_iff.mpr (eval_circle_ne_zero hp hroots (2 * Real.arctan t)))
    apply mul_left_cancel₀ hn
    rw [← hpolar t ht, hpoint]
    exact polynomial_polar p hroots _
  have hdiff : ∀ t ∈ Set.Ici 0, α t - β t = α 0 - β 0 := by
    intro t ht
    exact argument_difference_constant isPreconnected_Ici hα hβ.continuousOn he ht (by simp)
  have hθ : Tendsto (fun t : ℝ => 2 * Real.arctan t) atTop (𝓝 Real.pi) := by
    have he : (2 : ℝ) * (Real.pi / 2) = Real.pi := by ring
    simpa only [he] using
      (Real.tendsto_arctan_atTop.mono_right nhdsWithin_le_nhds).const_mul (2 : ℝ)
  have hbLim : Tendsto β atTop (𝓝 (polynomialAngle p Real.pi)) :=
    (continuous_polynomialAngle p hroots).continuousAt.tendsto.comp hθ
  have heq : (fun t => α t - β t) =ᶠ[atTop] (fun _ => α 0 - β 0) := by
    filter_upwards [eventually_ge_atTop (0 : ℝ)] with t ht
    exact hdiff t ht
  have hh : L - polynomialAngle p Real.pi = α 0 - β 0 :=
    tendsto_nhds_unique (hlim.sub hbLim) (tendsto_const_nhds.congr' heq.symm)
  have hb0 : β 0 = polynomialAngle p 0 := by simp [β]
  rw [hb0] at hh
  linarith [polynomialAngle_half_increment hp hconj hroots]

theorem exterior_count_of_cayley_argument {p : Polynomial ℂ} (hp : p ≠ 0)
    (hconj : ∀ z : ℂ, p.eval (conj z) = conj (p.eval z))
    (hroots : ∀ a ∈ p.roots, ‖a‖ ≠ 1) {α : ℝ → ℝ} {L : ℝ}
    (hα : ContinuousOn α (Set.Ici 0))
    (hpolar : ∀ t ∈ Set.Ici 0, p.eval (Cayley.point t) =
      (‖p.eval (Cayley.point t)‖ : ℂ) * Complex.exp ((α t : ℂ) * I))
    (hlim : Tendsto α atTop (𝓝 L))
    (m : ℤ) (hend : L - α 0 = ((p.natDegree : ℝ) - 2 * m) * Real.pi) :
    (countOutside p : ℤ) = 2 * m := by
  have hi := polynomial_argument_principle_cayley hp hconj hroots hα hpolar hlim
  have hn := count_partition p hroots
  have hnr : (countInside p : ℝ) + (countOutside p : ℝ) = p.natDegree := by exact_mod_cast hn
  have hi' : (countInside p : ℝ) = (p.natDegree : ℝ) - 2 * m := by
    apply mul_right_cancel₀ Real.pi_ne_zero
    exact hi.symm.trans hend
  have ho : (countOutside p : ℝ) = 2 * m := by linarith
  exact_mod_cast ho

end C2.NGamma.RootCountBridge

end

/- ===== C2.NGammaRootCountBoundary ===== -/

/-! Coverage of the unit circle by the upper Cayley semicircle, its conjugate,
and the point -1. This connects concrete frequency nonvanishing to root counts. -/
noncomputable section
open scoped BigOperators ComplexConjugate Topology
open Set Complex Polynomial Filter
namespace C2.NGamma.RootCountBridge

theorem upper_unit_circle_cayley {z : ℂ} (hz : ‖z‖ = 1)
    (him : 0 ≤ z.im) (hne : z ≠ -1) :
    ∃ t : ℝ, 0 ≤ t ∧ Cayley.point t = z := by
  have harg0 : 0 ≤ z.arg := Complex.arg_nonneg_iff.2 him
  have hargπ : z.arg < Real.pi := by
    apply lt_of_le_of_ne (Complex.arg_le_pi z)
    intro heq
    apply hne
    have hp := Complex.norm_mul_exp_arg_mul_I z
    rw [hz, Complex.ofReal_one, one_mul, heq, Complex.exp_pi_mul_I] at hp
    exact hp.symm
  have hargn : -(Real.pi / 2) < z.arg / 2 := by nlinarith [Real.pi_pos]
  have hargp : z.arg / 2 < Real.pi / 2 := by linarith
  refine ⟨Real.tan (z.arg / 2), ?_, ?_⟩
  · exact Real.tan_nonneg_of_nonneg_of_le_pi_div_two (by positivity) hargp.le
  · rw [Cayley.point_exp, Real.arctan_tan hargn hargp]
    have heq : 2 * (z.arg / 2) = z.arg := by ring
    rw [heq]
    simpa [hz] using Complex.norm_mul_exp_arg_mul_I z

theorem unit_circle_cayley_or_conj {z : ℂ} (hz : ‖z‖ = 1) (hne : z ≠ -1) :
    ∃ t : ℝ, 0 ≤ t ∧ (Cayley.point t = z ∨ conj (Cayley.point t) = z) := by
  by_cases him : 0 ≤ z.im
  · obtain ⟨t, ht, he⟩ := upper_unit_circle_cayley hz him hne
    exact ⟨t, ht, Or.inl he⟩
  · have hcNorm : ‖conj z‖ = 1 := by simpa using hz
    have hcIm : 0 ≤ (conj z).im := by simp only [Complex.conj_im]; linarith
    have hcNe : conj z ≠ -1 := by
      intro he
      have hh := congrArg conj he
      simp only [Complex.conj_conj, map_neg, map_one] at hh
      exact hne hh
    obtain ⟨t, ht, he⟩ := upper_unit_circle_cayley hcNorm hcIm hcNe
    refine ⟨t, ht, Or.inr ?_⟩
    rw [he, Complex.conj_conj]

theorem no_unit_roots_of_cayley_nonzero {p : Polynomial ℂ}
    (hconj : ∀ z : ℂ, p.eval (conj z) = conj (p.eval z))
    (hfinite : ∀ t : ℝ, 0 ≤ t → p.eval (Cayley.point t) ≠ 0)
    (hend : p.eval (-1) ≠ 0) :
    ∀ a ∈ p.roots, ‖a‖ ≠ 1 := by
  intro z hz hnorm
  have hzero : p.eval z = 0 := (Polynomial.mem_roots (by
    intro hp; simpa [hp] using hend)).1 hz
  have hne : z ≠ -1 := by intro he; subst z; exact hend hzero
  obtain ⟨t, ht, he | he⟩ := unit_circle_cayley_or_conj hnorm hne
  · exact hfinite t ht (he ▸ hzero)
  · have hh : conj (p.eval (Cayley.point t)) = 0 := by
      rw [← hconj, he]
      exact hzero
    apply hfinite t ht
    have hc := congrArg conj hh
    simpa only [Complex.conj_conj, map_zero] using hc

end C2.NGamma.RootCountBridge

end

/- ===== C2.NGammaAmplitude ===== -/

noncomputable section
open scoped BigOperators Topology
open Filter
namespace C2.NGamma.Cayley

theorem amplitudeFactor_sq (r x t : ℝ) :
    (amplitudeFactor r x t)^2 = r^2 * (1+((x+2/r)*t)^2)/(1+(x*t)^2) := by
  simp only [amplitudeFactor, div_pow, mul_pow]
  rw [Real.sq_sqrt (by positivity), Real.sq_sqrt (by positivity)]

theorem amplitudeFactor_continuous (r x : ℝ) : Continuous (amplitudeFactor r x) := by
  unfold amplitudeFactor
  exact (continuous_const.mul (Real.continuous_sqrt.comp
    (continuous_const.add ((continuous_const.mul continuous_id).pow 2)))).div
    (Real.continuous_sqrt.comp (continuous_const.add ((continuous_const.mul continuous_id).pow 2)))
    (fun t => ne_of_gt (Real.sqrt_pos.2 (by positivity)))

theorem amplitudeFactor_strictMonoOn {r x : ℝ} (hr : 0 < r) (hx : 0 ≤ x) :
    StrictMonoOn (amplitudeFactor r x) (Set.Ici 0) := by
  intro u hu v hv huv
  have ha : x < x+2/r := by linarith [div_pos (by norm_num : (0:ℝ)<2) hr]
  have ha0 : 0 < x+2/r := lt_of_le_of_lt hx ha
  have hax : 0 < (x+2/r)^2-x^2 := by nlinarith
  have huv2 : 0 < v^2-u^2 := by have := hu; change 0 ≤ u at this; nlinarith
  have hprod := mul_pos hax huv2
  have hs : (amplitudeFactor r x u)^2 < (amplitudeFactor r x v)^2 := by
    rw [amplitudeFactor_sq, amplitudeFactor_sq]
    apply (div_lt_div_iff₀ (by positivity : 0 < 1+(x*u)^2)
      (by positivity : 0 < 1+(x*v)^2)).2
    nlinarith [mul_pos (sq_pos_of_pos hr) hprod]
  nlinarith [amplitudeFactor_pos hr x u, amplitudeFactor_pos hr x v]

theorem amplitude_continuous {n : ℕ} (r x : Fin n → ℝ) : Continuous (amplitude r x) := by
  exact continuous_finset_prod _ (fun i _ => amplitudeFactor_continuous (r i) (x i))

theorem amplitude_strictMonoOn {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) :
    StrictMonoOn (amplitude r x) (Set.Ici 0) := by
  intro u hu v hv huv
  unfold amplitude
  apply Finset.prod_lt_prod
  · intro i _
    exact amplitudeFactor_pos (hr i) (x i) u
  · intro i _
    exact le_of_lt (amplitudeFactor_strictMonoOn (hr i) (hx i) hu hv huv)
  · exact ⟨⟨0, hn⟩, Finset.mem_univ _, amplitudeFactor_strictMonoOn
      (hr _) (hx _) hu hv huv⟩

theorem amplitude_zero {n : ℕ} (r x : Fin n → ℝ) : amplitude r x 0 = ∏ i, r i := by
  simp [amplitude, amplitudeFactor]

theorem amplitudeFactor_rescale {r x t : ℝ} (ht : 0 < t) :
    amplitudeFactor r x t =
      r * Real.sqrt (t⁻¹^2+(x+2/r)^2) / Real.sqrt (t⁻¹^2+x^2) := by
  have he (a : ℝ) : Real.sqrt (1+(a*t)^2) = t * Real.sqrt (t⁻¹^2+a^2) := by
    have hid : 1+(a*t)^2 = t^2*(t⁻¹^2+a^2) := by field_simp; ring
    rw [hid, Real.sqrt_mul (sq_nonneg t), Real.sqrt_sq (le_of_lt ht)]
  unfold amplitudeFactor
  rw [he, he]
  field_simp

theorem amplitudeFactor_tendsto_atTop {r x : ℝ} (hr : 0 < r) (hx : 0 < x) :
    Tendsto (amplitudeFactor r x) atTop (𝓝 (r+2/x)) := by
  have ht := (tendsto_inv_atTop_zero : Tendsto (fun t : ℝ => t⁻¹) atTop (𝓝 0)).pow 2
  have h := ((tendsto_const_nhds : Tendsto (fun _ : ℝ => r) atTop (𝓝 r)).mul (Real.continuous_sqrt.continuousAt.tendsto.comp
    (ht.add_const ((x+2/r)^2)))).div
    (Real.continuous_sqrt.continuousAt.tendsto.comp (ht.add_const (x^2)))
    (show Real.sqrt (0^2+x^2) ≠ 0 by simpa [Real.sqrt_sq (le_of_lt hx)] using ne_of_gt hx)
  have hlim : r * Real.sqrt ((0:ℝ)^2+(x+2/r)^2) / Real.sqrt ((0:ℝ)^2+x^2) = r+2/x := by
    rw [zero_pow (by norm_num), zero_add, zero_add, Real.sqrt_sq (by positivity), Real.sqrt_sq (le_of_lt hx)]
    field_simp
    ring
  rw [hlim] at h
  apply h.congr'
  filter_upwards [eventually_gt_atTop (0:ℝ)] with t ht
  exact (amplitudeFactor_rescale ht).symm

theorem amplitude_tendsto_atTop {n : ℕ} {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) :
    Tendsto (amplitude r x) atTop (𝓝 (∏ i, (r i+2/x i))) := by
  exact tendsto_finset_prod _ (fun i _ => amplitudeFactor_tendsto_atTop (hr i) (hx i))

theorem amplitudeFactor_zero_lower {r t : ℝ} (hr : 0 < r) (ht : 0 ≤ t) :
    2*t ≤ amplitudeFactor r 0 t := by
  have hs := amplitudeFactor_sq r 0 t
  simp only [zero_add, zero_mul, zero_pow (by norm_num : (2:ℕ) ≠ 0), add_zero, div_one] at hs
  have he : r^2 * (1+(2/r*t)^2) = r^2+4*t^2 := by field_simp; ring
  rw [he] at hs
  nlinarith [amplitudeFactor_pos hr 0 t]

theorem amplitude_tendsto_atTop_of_zero {n : ℕ} {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) {j : Fin n} (hj : x j = 0) :
    Tendsto (amplitude r x) atTop atTop := by
  classical
  let c : ℝ := ∏ i ∈ Finset.univ.erase j, r i
  have hc : 0 < c := Finset.prod_pos (fun i _ => hr i)
  have hlow : ∀ t ≥ 0, c*(2*t) ≤ amplitude r x t := by
    intro t ht
    have hother : c ≤ ∏ i ∈ Finset.univ.erase j, amplitudeFactor (r i) (x i) t := by
      apply Finset.prod_le_prod
      · intro i _; exact (hr i).le
      · intro i _
        have h := (amplitudeFactor_strictMonoOn (hr i) (hx i)).monotoneOn
          (show (0:ℝ) ∈ Set.Ici 0 by simp) ht ht
        simpa [amplitudeFactor] using h
    have hzero : 2*t ≤ amplitudeFactor (r j) (x j) t := by
      rw [hj]
      exact amplitudeFactor_zero_lower (hr j) ht
    unfold amplitude
    rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ j)]
    calc
      c*(2*t) = (2*t)*c := by ring
      _ ≤ amplitudeFactor (r j) (x j) t * ∏ i ∈ Finset.univ.erase j, amplitudeFactor (r i) (x i) t :=
        mul_le_mul hzero hother hc.le (amplitudeFactor_pos (hr j) (x j) t).le
  apply tendsto_atTop_mono' atTop ?_ ((tendsto_id.const_mul_atTop (by norm_num : (0:ℝ)<2)).const_mul_atTop hc)
  filter_upwards [eventually_ge_atTop (0:ℝ)] with t ht
  exact hlow t ht

theorem existsUnique_amplitude_crossing_of_upper {n : ℕ} (hn : 0 < n)
    {r x : Fin n → ℝ} (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i)
    {b : ℝ} (hb : (∏ i, r i) < b) (hupper : ∃ v, 0 < v ∧ b < amplitude r x v) :
    ∃! t : ℝ, 0 < t ∧ amplitude r x t = b := by
  obtain ⟨v, hv, hbv⟩ := hupper
  have hb0 : amplitude r x 0 < b := by simpa only [amplitude_zero] using hb
  obtain ⟨t, ht, he⟩ := intermediate_value_Icc hv.le
    (amplitude_continuous r x).continuousOn ⟨hb0.le,hbv.le⟩
  have htpos : 0 < t := by
    by_contra h
    have ht0 : t=0 := le_antisymm (le_of_not_gt h) ht.1
    rw [ht0] at he
    linarith
  refine ⟨t, ⟨htpos,he⟩, ?_⟩
  intro u hu
  exact (amplitude_strictMonoOn hn hr hx).injOn hu.1.le htpos.le (hu.2.trans he.symm)

theorem existsUnique_amplitude_crossing {n : ℕ} (hn : 0 < n)
    {r x : Fin n → ℝ} (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i)
    {b : ℝ} (hb : (∏ i, r i) < b) (hbinf : b < ∏ i, (r i+2/x i)) :
    ∃! t : ℝ, 0 < t ∧ amplitude r x t = b := by
  apply existsUnique_amplitude_crossing_of_upper hn hr (fun i => (hx i).le) hb
  have he := (amplitude_tendsto_atTop hr hx) (Ioi_mem_nhds hbinf)
  obtain ⟨v,hv,hvb⟩ := ((eventually_gt_atTop (0:ℝ)).and he).exists
  exact ⟨v,hv,hvb⟩

theorem existsUnique_amplitude_crossing_of_zero {n : ℕ} (hn : 0 < n)
    {r x : Fin n → ℝ} (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i)
    {j : Fin n} (hj : x j = 0) {b : ℝ} (hb : (∏ i, r i) < b) :
    ∃! t : ℝ, 0 < t ∧ amplitude r x t = b := by
  apply existsUnique_amplitude_crossing_of_upper hn hr hx hb
  have he := (amplitude_tendsto_atTop_of_zero hr hx hj) (eventually_gt_atTop b)
  obtain ⟨v,hv,hvb⟩ := ((eventually_gt_atTop (0:ℝ)).and he).exists
  exact ⟨v,hv,hvb⟩

end C2.NGamma.Cayley

end

/- ===== C2.NGammaTransferEndpoint ===== -/

noncomputable section
open scoped BigOperators Topology
open Filter
namespace C2.NGamma.Cayley

theorem exp_nat_pi (d : ℕ) :
    Complex.exp ((((d : ℝ)*Real.pi : ℝ) : ℂ)*Complex.I) = (-1:ℂ)^d := by
  have he : (((d : ℝ)*Real.pi : ℝ) : ℂ)*Complex.I = (d : ℂ)*((Real.pi : ℂ)*Complex.I) := by push_cast; ring
  rw [he, Complex.exp_nat_mul, Complex.exp_pi_mul_I]

theorem transfer_point_tendsto_atTop {n : ℕ} {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) (d : ℕ) :
    Tendsto (fun t => transfer r x d (point t)) atTop
      (𝓝 (((∏ i, (r i+2/x i) : ℝ) : ℂ)*(-1)^d)) := by
  have hp : Tendsto (Phase.totalPhase (fun i => x i+2/r i) x d) atTop
      (𝓝 ((d:ℝ)*Real.pi)) := by
    simpa [ne_of_gt (hx _)] using totalPhase_tendsto_atTop hr (fun i => (hx i).le) d
  have hpc := (Complex.continuous_ofReal.tendsto _).comp hp
  have hexp := Complex.continuous_exp.continuousAt.tendsto.comp (hpc.mul_const Complex.I)
  rw [exp_nat_pi] at hexp
  have ha := (Complex.continuous_ofReal.tendsto _).comp (amplitude_tendsto_atTop hr hx)
  simpa only [transfer_polar (fun i => ne_of_gt (hr i))] using ha.mul hexp

theorem reciprocal_transfer_tendsto_zero_of_zero {n : ℕ} {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) {j : Fin n} (hj : x j = 0)
    (d : ℕ) (b : ℝ) :
    Tendsto (fun t => (b : ℂ)/transfer r x d (point t)) atTop (𝓝 0) := by
  apply tendsto_zero_iff_norm_tendsto_zero.2
  have h := tendsto_inv_atTop_zero.comp (amplitude_tendsto_atTop_of_zero hr hx hj)
  have hm := h.const_mul |b|
  simpa [norm_div, transfer_norm hr, Complex.norm_real, Real.norm_eq_abs, div_eq_mul_inv] using hm

theorem transfer_correction_arg_tendsto_zero_of_zero {n : ℕ} {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) {j : Fin n} (hj : x j = 0)
    (d : ℕ) (b : ℝ) :
    Tendsto (fun t => Complex.arg (1+(b : ℂ)/transfer r x d (point t))) atTop (𝓝 0) := by
  have hc := (reciprocal_transfer_tendsto_zero_of_zero hr hx hj d b).const_add 1
  have ha := (Complex.continuousAt_arg (show (1:ℂ) ∈ Complex.slitPlane from Or.inl (by norm_num))).tendsto
  simpa using ha.comp (by simpa using hc)

theorem transfer_correction_arg_tendsto_zero {n : ℕ} {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) (d : ℕ) {b : ℝ}
    (hb : 0 ≤ b) (hbinf : b < ∏ i, (r i+2/x i)) :
    Tendsto (fun t => Complex.arg (1+(b : ℂ)/transfer r x d (point t))) atTop (𝓝 0) := by
  let B : ℝ := ∏ i, (r i+2/x i)
  have hB : 0 < B := Finset.prod_pos (fun i _ => add_pos (hr i) (div_pos (by norm_num) (hx i)))
  have hBn : (B:ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hB
  have hs : (-1:ℂ)^d ≠ 0 := pow_ne_zero _ (by norm_num)
  let z : ℂ := (b:ℂ)/((B:ℂ)*(-1)^d)
  have hzlim : Tendsto (fun t => (b:ℂ)/transfer r x d (point t)) atTop (𝓝 z) :=
    tendsto_const_nhds.div (transfer_point_tendsto_atTop hr hx d) (mul_ne_zero hBn hs)
  have hzreal : z.im = 0 := by
    have he : z = ((b / (B * (-1)^d) : ℝ) : ℂ) := by simp only [z, Complex.ofReal_div, Complex.ofReal_mul, Complex.ofReal_pow, Complex.ofReal_neg, Complex.ofReal_one]
    rw [he]
    exact Complex.ofReal_im _
  have hznorm : ‖z‖ < 1 := by
    simp only [z, norm_div, norm_mul, norm_pow, norm_neg, norm_one, one_pow, mul_one,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hb, abs_of_pos hB]
    exact (div_lt_one hB).2 hbinf
  have hzpos : 0 < (1+z).re := by
    have hh := Complex.abs_re_le_norm z
    have hhh := neg_abs_le z.re
    simp only [Complex.add_re, Complex.one_re]
    linarith
  have harg : Complex.arg (1+z) = 0 := by
    apply Complex.arg_eq_zero_iff.2
    exact ⟨hzpos.le, by simp [hzreal]⟩
  have h := (Complex.continuousAt_arg (Or.inl hzpos)).tendsto.comp (hzlim.const_add 1)
  simpa only [harg] using h

end C2.NGamma.Cayley

end

/- ===== C2.NGammaRootCountEndpoints ===== -/

/-! The real endpoint of the cascade boundary and an actual real exterior root
above the finite endpoint gain. -/
noncomputable section
open scoped BigOperators ComplexConjugate Topology
open Set Complex Polynomial Filter
namespace C2.NGamma.PolynomialModel
variable {n : ℕ} {r x : Fin n → ℝ}

theorem characteristic_neg_one_ne_zero_of_zero
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) {j : Fin n} (hj : x j = 0)
    (d : ℕ) (b : ℝ) : (characteristic r x d b).eval (-1) ≠ 0 := by
  rw [characteristic_eval_neg_one]
  have hxp : (∏ i, (x i : ℂ)) = 0 := by
    apply Finset.prod_eq_zero (Finset.mem_univ j)
    exact_mod_cast hj
  rw [hxp, mul_zero, add_zero]
  apply mul_ne_zero (pow_ne_zero _ (by norm_num))
  apply Finset.prod_ne_zero_iff.2
  intro i hi
  have hh : 0 < 2 + r i * x i := add_pos_of_pos_of_nonneg (by norm_num) (mul_nonneg (hr i).le (hx i))
  exact_mod_cast ne_of_gt hh

theorem characteristic_neg_one_factorized (hx : ∀ i, 0 < x i) (d : ℕ) (b : ℝ) :
    (characteristic r x d b).eval (-1) =
      (-1 : ℂ)^n * (∏ i, (x i : ℂ)) *
      ((-1 : ℂ)^d * ((∏ i, (r i + 2 / x i) : ℝ) : ℂ) + b) := by
  rw [characteristic_eval_neg_one]
  simp only [Fintype.card_fin, pow_add, Complex.ofReal_prod]
  have hp : (∏ i, (2 + (r i : ℂ) * x i)) =
      (∏ i, ((r i + 2 / x i : ℝ) : ℂ)) * ∏ i, (x i : ℂ) := by
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro i hi
    push_cast
    have hn : (x i : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt (hx i)
    field_simp
    <;> ring
  rw [hp]
  ring

theorem characteristic_neg_one_ne_zero_of_lt_endpoint
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) (d : ℕ)
    {b : ℝ} (hb : 0 ≤ b) (hbinf : b < ∏ i, (r i + 2 / x i)) :
    (characteristic r x d b).eval (-1) ≠ 0 := by
  rw [characteristic_neg_one_factorized hx]
  apply mul_ne_zero
  · apply mul_ne_zero (pow_ne_zero _ (by norm_num))
    exact Finset.prod_ne_zero_iff.2 (fun i _ => by exact_mod_cast ne_of_gt (hx i))
  · intro he
    have hn := congrArg norm (show (-1 : ℂ)^d * ((∏ i, (r i+2/x i) : ℝ) : ℂ) = -(b : ℂ) by
      linear_combination he)
    have hB : 0 < ∏ i, (r i+2/x i) := Finset.prod_pos (fun i _ => add_pos (hr i) (div_pos (by norm_num) (hx i)))
    simp only [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos hB, abs_of_nonneg hb] at hn
    linarith

theorem characteristic_eval_neg_one_ne_zero
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) (d : ℕ)
    {b : ℝ} (hb : 0 ≤ b)
    (hbound : (∃ i, x i = 0) ∨ b < ∏ i, (r i + 2 / x i)) :
    (characteristic r x d b).eval (-1) ≠ 0 := by
  by_cases hz : ∃ i, x i = 0
  · obtain ⟨i, hi⟩ := hz
    exact characteristic_neg_one_ne_zero_of_zero hr hx hi d b
  · have hxp : ∀ i, 0 < x i := by
      intro i
      apply lt_of_le_of_ne (hx i)
      intro he
      exact hz ⟨i, he.symm⟩
    exact characteristic_neg_one_ne_zero_of_lt_endpoint hr hxp d hb (hbound.resolve_left hz)

end C2.NGamma.PolynomialModel

end

/- ===== C2.NGammaSinglePhase ===== -/

/-! Complete first-phase classification for one sample of delay.  This is the
analytic and boundary-witness part of the exact gain-interval theorem;
interior/exterior root counting is a separate theorem. -/

noncomputable section
open Set Filter
open scoped Topology BigOperators

namespace C2.NGamma.Phase

def endpointSum {n : ℕ} (r x : Fin n → ℝ) : ℝ :=
  ∑ j, 1 / (x j * (2 + r j * x j))

lemma sumRatio_tendsto_atTop {n : ℕ} {a x : Fin n → ℝ}
    (hx : ∀ j, 0 < x j) (hax : ∀ j, x j < a j) :
    Tendsto (sumRatio a x) atTop (𝓝 (∑ j, (1/x j-1/a j))) := by
  exact tendsto_finset_sum _ (fun j _ => ratio_tendsto_atTop_of_pos (hx j) (hax j))

lemma single_phase_identity {n : ℕ} (a x : Fin n → ℝ) {t : ℝ} (ht : 0 < t) :
    totalPhase a x 1 t - Real.pi = Real.arctan (1/t) * (sumRatio a x t-2) := by
  have hD : Real.arctan (1/t) ≠ 0 := (arctan_pos (one_div_pos.mpr ht)).ne'
  have hi : Real.arctan (1/t) = Real.pi/2-Real.arctan t := by
    simpa only [one_div] using Real.arctan_inv_of_pos ht
  have hsum : sumRatio a x t = (∑ j, contribution (a j) (x j) t)/Real.arctan (1/t) := by
    simp only [sumRatio, ratio, Finset.sum_div]
  rw [hsum]
  unfold totalPhase
  field_simp
  rw [hi]
  norm_num
  ring

lemma single_crossing_exists_of_sumRatio_gt {n : ℕ} (a x : Fin n → ℝ)
    {t : ℝ} (ht : 0 < t) (hs : 2 < sumRatio a x t) :
    ∃ s : ℝ, 0 < s ∧ s < t ∧ totalPhase a x 1 s = Real.pi := by
  have hphase : Real.pi < totalPhase a x 1 t := by
    have hi := single_phase_identity a x ht
    have hp : 0 < Real.arctan (1/t)*(sumRatio a x t-2) :=
      mul_pos (arctan_pos (one_div_pos.mpr ht)) (sub_pos.mpr hs)
    linarith
  have hz : totalPhase a x 1 0 = 0 := by simp [totalPhase, contribution]
  obtain ⟨s, hsI, hsE⟩ := intermediate_value_Icc ht.le
    (totalPhase_continuous a x 1).continuousOn
    (show Real.pi ∈ Icc (totalPhase a x 1 0) (totalPhase a x 1 t) by
      rw [hz]; exact ⟨Real.pi_pos.le, hphase.le⟩)
  refine ⟨s, ?_, ?_, hsE⟩
  · by_contra! hh
    have : s = 0 := le_antisymm hh hsI.1
    subst s
    rw [hz] at hsE
    exact Real.pi_pos.ne hsE
  · by_contra! hh
    have : s = t := le_antisymm hsI.2 hh
    subst s
    linarith

lemma sumRatio_lt_limit {n : ℕ} (hn : 0 < n) {a x : Fin n → ℝ}
    (hx : ∀ j, 0 < x j) (hx1 : ∀ j, x j ≤ 1) (hax : ∀ j, x j < a j)
    {t : ℝ} (ht : 0 < t) : sumRatio a x t < ∑ j, (1/x j-1/a j) := by
  have hm := sumRatio_strictMonoOn hn (fun j => (hx j).le) hx1 hax
  have hmono : sumRatio a x (t+1) ≤ ∑ j, (1/x j-1/a j) := by
    apply ge_of_tendsto (sumRatio_tendsto_atTop hx hax)
    filter_upwards [eventually_ge_atTop (t+1)] with s hs
    exact hm.monotoneOn (show 0 < t+1 by linarith) (show 0 < s by linarith) hs
  exact lt_of_lt_of_le (hm ht (show 0 < t+1 by linarith) (by linarith)) hmono

lemma single_crossing_iff_limit {n : ℕ} (hn : 0 < n) {a x : Fin n → ℝ}
    (hx : ∀ j, 0 < x j) (hx1 : ∀ j, x j ≤ 1) (hax : ∀ j, x j < a j) :
    (∃ t : ℝ, 0 < t ∧ totalPhase a x 1 t = Real.pi) ↔
      2 < ∑ j, (1/x j-1/a j) := by
  constructor
  · rintro ⟨t, ht, he⟩
    have hR : sumRatio a x t = 2 := by
      simpa using (phase_eq_pi_iff_sumRatio a x 1 ht).mp he
    rw [← hR]
    exact sumRatio_lt_limit hn hx hx1 hax ht
  · intro hs
    have he : ∀ᶠ t in atTop, 2 < sumRatio a x t :=
      (tendsto_order.1 (sumRatio_tendsto_atTop hx hax)).1 2 hs
    obtain ⟨t, ht, hR⟩ := (he.and (eventually_gt_atTop (0:ℝ))).exists
    obtain ⟨s, hs, _, he⟩ := single_crossing_exists_of_sumRatio_gt a x hR ht
    exact ⟨s, hs, he⟩

lemma single_crossing_of_zero {n : ℕ} {a x : Fin n → ℝ}
    (hx : ∀ j, 0 ≤ x j) (hax : ∀ j, x j < a j)
    {j : Fin n} (hj : x j = 0) :
    ∃ t : ℝ, 0 < t ∧ totalPhase a x 1 t = Real.pi := by
  have ha : 0 < a j := by rw [← hj]; exact hax j
  have hlim : Tendsto (ratio (a j) (x j)) atTop atTop := by
    rw [hj]
    exact ratio_tendsto_atTop_of_zero ha
  have he : ∀ᶠ t in atTop, 2 < ratio (a j) (x j) t := hlim.eventually (eventually_gt_atTop 2)
  obtain ⟨t, htR, ht⟩ := (he.and (eventually_gt_atTop (0:ℝ))).exists
  have hsum : ratio (a j) (x j) t ≤ sumRatio a x t := by
    apply Finset.single_le_sum (fun i _ => ?_) (Finset.mem_univ j)
    unfold ratio
    exact le_of_lt (div_pos (contribution_pos (hax i) ht) (arctan_pos (one_div_pos.mpr ht)))
  obtain ⟨s, hs, _, hE⟩ := single_crossing_exists_of_sumRatio_gt a x ht (lt_of_lt_of_le htR hsum)
  exact ⟨s, hs, hE⟩

lemma ratio_limit_eq_endpoint_summand {r x : ℝ} (hr : 0 < r) (hx : 0 < x) :
    1/x-1/(x+2/r) = 2*(1/(x*(2+r*x))) := by
  have hrn := ne_of_gt hr
  have hxn := ne_of_gt hx
  have hrx : 2+r*x ≠ 0 := ne_of_gt (by positivity)
  have hax : x+2/r ≠ 0 := ne_of_gt (by positivity)
  field_simp [hrn, hxn, hrx, hax]
  <;> ring

lemma single_sample_phase_crossing_iff {n : ℕ} (hn : 0 < n)
    {r x : Fin n → ℝ} (hr : ∀ j, 0 < r j)
    (hx : ∀ j, 0 ≤ x j) (hx1 : ∀ j, x j ≤ 1) :
    (∃! t : ℝ, 0 < t ∧ totalPhase (fun j => x j+2/r j) x 1 t = Real.pi) ↔
      (∃ j, x j = 0) ∨ 1 < endpointSum r x := by
  have hax : ∀ j, x j < x j+2/r j := fun j => lt_add_of_pos_right _ (div_pos (by norm_num) (hr j))
  have huniq := fun {s t} (hs : 0 < s) (ht : 0 < t) =>
    first_phase_crossing_unique hn (by norm_num : 1 ≤ (1:ℕ)) hx hx1 hax hs ht
  have hiff : (∃ t : ℝ, 0 < t ∧ totalPhase (fun j => x j+2/r j) x 1 t = Real.pi) ↔
      (∃ j, x j = 0) ∨ 1 < endpointSum r x := by
    by_cases hz : ∃ j, x j = 0
    · constructor
      · intro _; exact Or.inl hz
      · intro _
        obtain ⟨j, hj⟩ := hz
        exact single_crossing_of_zero hx hax hj
    · have hxp : ∀ j, 0 < x j := by
        intro j
        have hj : x j ≠ 0 := fun he => hz ⟨j, he⟩
        exact lt_of_le_of_ne (hx j) (Ne.symm hj)
      have hsum : (∑ j, (1/x j-1/(x j+2/r j))) = 2*endpointSum r x := by
        simp_rw [ratio_limit_eq_endpoint_summand (hr _) (hxp _)]
        exact (Finset.mul_sum ..).symm
      rw [single_crossing_iff_limit hn hxp hx1 hax, hsum]
      simp only [hz, false_or]
      constructor <;> intro h <;> linarith
  constructor
  · rintro ⟨t, ht, _⟩
    exact hiff.mp ⟨t, ht⟩
  · intro hh
    obtain ⟨t, ht⟩ := hiff.mpr hh
    exact ⟨t, ht, fun s hs => huniq hs.1 ht.1 hs.2 ht.2⟩

lemma single_phase_below_iff {n : ℕ} (a x : Fin n → ℝ) {t : ℝ} (ht : 0 < t) :
    totalPhase a x 1 t < Real.pi ↔ sumRatio a x t < 2 := by
  have hi := single_phase_identity a x ht
  have hD := arctan_pos (one_div_pos.mpr ht)
  constructor
  · intro h
    by_contra! hh
    have hp := mul_nonneg hD.le (sub_nonneg.mpr hh)
    linarith
  · intro h
    have hp := mul_neg_of_pos_of_neg hD (sub_neg.mpr h)
    linarith

lemma single_phase_above_iff {n : ℕ} (a x : Fin n → ℝ) {t : ℝ} (ht : 0 < t) :
    Real.pi < totalPhase a x 1 t ↔ 2 < sumRatio a x t := by
  have hi := single_phase_identity a x ht
  have hD := arctan_pos (one_div_pos.mpr ht)
  constructor
  · intro h
    by_contra! hh
    have hp := mul_nonpos_of_nonneg_of_nonpos hD.le (sub_nonpos.mpr hh)
    linarith
  · intro h
    have hp := mul_pos hD (sub_pos.mpr h)
    linarith

lemma single_phase_before_after_crossing {n : ℕ} (hn : 0 < n) {a x : Fin n → ℝ}
    (hx : ∀ j, 0 ≤ x j) (hx1 : ∀ j, x j ≤ 1) (hax : ∀ j, x j < a j)
    {s t : ℝ} (hs : 0 < s) (ht : 0 < t) (he : totalPhase a x 1 s = Real.pi) :
    (totalPhase a x 1 t < Real.pi ↔ t < s) ∧
      (Real.pi < totalPhase a x 1 t ↔ s < t) := by
  have hm := sumRatio_strictMonoOn hn hx hx1 hax
  have hR : sumRatio a x s = 2 := by
    simpa using (phase_eq_pi_iff_sumRatio a x 1 hs).mp he
  rw [single_phase_below_iff a x ht, single_phase_above_iff a x ht, ← hR]
  exact ⟨hm.lt_iff_lt ht hs, hm.lt_iff_lt hs ht⟩

lemma single_phase_below_pi_of_endpoint {n : ℕ} (hn : 0 < n)
    {r x : Fin n → ℝ} (hr : ∀ j, 0 < r j) (hx : ∀ j, 0 < x j)
    (hx1 : ∀ j, x j ≤ 1) (hS : endpointSum r x ≤ 1) {t : ℝ} (ht : 0 < t) :
    totalPhase (fun j => x j+2/r j) x 1 t < Real.pi := by
  apply (single_phase_below_iff _ x ht).2
  have hax : ∀ j, x j < x j+2/r j := fun j =>
    lt_add_of_pos_right _ (div_pos (by norm_num) (hr j))
  have h := sumRatio_lt_limit hn hx hx1 hax ht
  have hsum : (∑ j, (1/x j-1/(x j+2/r j))) = 2*endpointSum r x := by
    simp_rw [ratio_limit_eq_endpoint_summand (hr _) (hx _)]
    exact (Finset.mul_sum ..).symm
  rw [hsum] at h
  linarith

lemma totalPhase_pos {n : ℕ} (hn : 0 < n) {a x : Fin n → ℝ}
    (hax : ∀ j, x j < a j) (d : ℕ) {t : ℝ} (ht : 0 < t) :
    0 < totalPhase a x d t := by
  have hs := sum_contribution_pos hn hax ht
  have hd : 0 ≤ 2*(d:ℝ)*Real.arctan t :=
    mul_nonneg (by positivity) (arctan_pos ht).le
  exact add_pos_of_nonneg_of_pos hd hs

end C2.NGamma.Phase

end

/- ===== C2.NGammaCharacteristicLift ===== -/

/-! The explicit continuous argument of the actual characteristic polynomial
on the upper Cayley semicircle. Its endpoint change is (n+d)π−2πk. -/

noncomputable section
open Set Filter
open scoped Topology BigOperators

namespace C2.NGamma.Cayley
open PolynomialModel ArgumentMatch

def characteristicAngle {n : ℕ} (r x : Fin n → ℝ) (d : ℕ) (b tb : ℝ) (k : ℤ)
    (t : ℝ) : ℝ :=
  (∑ i, qPhase (x i) t) +
    translatedAngle (amplitude r x) (Phase.totalPhase (fun i => x i+2/r i) x d) b tb k t

lemma q_product_polar {n : ℕ} (x : Fin n → ℝ) (t : ℝ) :
    (∏ i, (q (x i)).eval (point t)) = (‖∏ i, (q (x i)).eval (point t)‖ : ℂ)*
      Complex.exp (((∑ i, qPhase (x i) t : ℝ) : ℂ)*Complex.I) := by
  have hn : ‖∏ i, (q (x i)).eval (point t)‖ = ∏ i, qAmplitude (x i) t := by
    rw [norm_prod]
    apply Finset.prod_congr rfl
    intro i _
    rw [q_polar, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (qAmplitude_pos _ _), Complex.norm_exp_ofReal_mul_I, mul_one]
  rw [hn]
  simp only [q_polar, Finset.prod_mul_distrib, Complex.ofReal_prod, Complex.ofReal_sum,
    Finset.sum_mul, Complex.exp_sum]

lemma polar_mul {z w : ℂ} {a c : ℝ}
    (hz : z = (‖z‖:ℂ)*Complex.exp ((a:ℂ)*Complex.I))
    (hw : w = (‖w‖:ℂ)*Complex.exp ((c:ℂ)*Complex.I)) :
    z*w = (‖z*w‖:ℂ)*Complex.exp (((a+c:ℝ):ℂ)*Complex.I) := by
  rw [norm_mul, Complex.ofReal_mul, Complex.ofReal_add, add_mul, Complex.exp_add]
  calc
    z*w = ((‖z‖:ℂ)*Complex.exp ((a:ℂ)*Complex.I))*
        ((‖w‖:ℂ)*Complex.exp ((c:ℂ)*Complex.I)) := by rw [← hz, ← hw]
    _ = _ := by ring

lemma characteristicAngle_polar {n : ℕ} {r : Fin n → ℝ} (hr : ∀ i, 0 < r i)
    (x : Fin n → ℝ) (d : ℕ) (b tb : ℝ) (k : ℤ) (t : ℝ) :
    (characteristic r x d b).eval (point t) =
      (‖(characteristic r x d b).eval (point t)‖ : ℂ)*
        Complex.exp ((characteristicAngle r x d b tb k t : ℂ)*Complex.I) := by
  rw [characteristic_eval_point]
  unfold characteristicAngle
  apply polar_mul (q_product_polar x t)
  have h := translatedAngle_polar (b := b) (tb := tb) (k := k)
    (ψ := Phase.totalPhase (fun i => x i+2/r i) x d) (amplitude_pos hr x t)
  simpa only [polarCurve, ← transfer_polar (fun i => ne_of_gt (hr i))] using h

lemma characteristicAngle_continuousOn {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) (d : ℕ) {b tb : ℝ} {k : ℤ}
    (htb : 0 ≤ tb) (hBeq : amplitude r x tb = b)
    (hlo : -Real.pi < Phase.totalPhase (fun i => x i+2/r i) x d tb-2*Real.pi*k)
    (hhi : Phase.totalPhase (fun i => x i+2/r i) x d tb-2*Real.pi*k < Real.pi) :
    ContinuousOn (characteristicAngle r x d b tb k) (Ici 0) := by
  apply ContinuousOn.add
  · exact (continuous_finset_sum _ (fun i _ => qPhase_continuous (x i))).continuousOn
  · exact translatedAngle_continuousOn (amplitude_continuous r x)
      (Phase.totalPhase_continuous _ x d) (fun t _ => amplitude_pos hr x t)
      (amplitude_strictMonoOn hn hr hx) htb hBeq hlo hhi

lemma characteristic_point_ne_zero {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) (d : ℕ) {b tb : ℝ} {k : ℤ}
    (htb : 0 ≤ tb) (hBeq : amplitude r x tb = b)
    (hlo : -Real.pi < Phase.totalPhase (fun i => x i+2/r i) x d tb-2*Real.pi*k)
    (hhi : Phase.totalPhase (fun i => x i+2/r i) x d tb-2*Real.pi*k < Real.pi)
    (t : ℝ) (ht : 0 ≤ t) : (characteristic r x d b).eval (point t) ≠ 0 := by
  rw [characteristic_eval_point]
  apply mul_ne_zero (Finset.prod_ne_zero_iff.mpr (fun i _ => q_eval_point_ne_zero (x i) t))
  have h := translated_curve_ne_zero (fun t _ => amplitude_pos hr x t)
    (amplitude_strictMonoOn hn hr hx) htb hBeq hlo hhi ht
  simpa only [polarCurve, ← transfer_polar (fun i => ne_of_gt (hr i))] using h

lemma characteristicAngle_zero {n : ℕ} {r : Fin n → ℝ} (hr : ∀ i, 0 < r i)
    (x : Fin n → ℝ) (d : ℕ) {b tb : ℝ} (hb : 0 < b) (htb : 0 ≤ tb) (k : ℤ) :
    characteristicAngle r x d b tb k 0 = 0 := by
  unfold characteristicAngle
  have h := translatedAngle_zero (k := k) (ψ := Phase.totalPhase (fun i => x i+2/r i) x d)
    (amplitude_pos hr x 0) hb htb (by simp [Phase.totalPhase, Phase.contribution])
  simpa only [qPhase, mul_zero, Real.arctan_zero, add_zero, zero_add, Finset.sum_const_zero] using h

lemma characteristicAngle_tendsto_atTop {n : ℕ} {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) (d : ℕ) {b tb : ℝ} (hb : 0 ≤ b) (k : ℤ)
    (hbound : (∃ j, x j = 0) ∨ b < ∏ i, (r i+2/x i)) :
    Tendsto (characteristicAngle r x d b tb k) atTop
      (𝓝 (((n:ℝ)+(d:ℝ))*Real.pi-2*Real.pi*k)) := by
  have hcorr : Tendsto (fun t => Complex.arg (1+(b:ℂ)/transfer r x d (point t))) atTop (𝓝 0) := by
    by_cases hz : ∃ j, x j = 0
    · obtain ⟨j, hj⟩ := hz
      exact transfer_correction_arg_tendsto_zero_of_zero hr hx hj d b
    · have hxp : ∀ i, 0 < x i := fun i =>
        lt_of_le_of_ne (hx i) (Ne.symm (fun he => hz ⟨i, he⟩))
      exact transfer_correction_arg_tendsto_zero hr hxp d hb (hbound.resolve_left hz)
  have hcorr' : Tendsto (fun t => Complex.arg (1+(b:ℂ)/polarCurve (amplitude r x)
      (Phase.totalPhase (fun i => x i+2/r i) x d) t)) atTop (𝓝 0) := by
    simpa only [polarCurve, ← transfer_polar (fun i => ne_of_gt (hr i))] using hcorr
  have h := (sum_qPhase_tendsto_atTop hx).add
    (translatedAngle_tendsto_atTop (tb := tb) (k := k) (totalPhase_tendsto_atTop hr hx d) hcorr')
  convert h using 1
  ring

end C2.NGamma.Cayley

end

/- ===== C2.NGammaPhaseIndex ===== -/

noncomputable section
open scoped BigOperators
namespace C2.NGamma.Cayley

/-- Integer selecting the continuous phase branch at a magnitude crossing. -/
def phaseIndex (θ : ℝ) : ℤ := ⌊(θ+Real.pi)/(2*Real.pi)⌋

theorem phaseIndex_bounds {θ : ℝ}
    (hodd : ∀ k : ℤ, θ ≠ (2*(k:ℝ)+1)*Real.pi) :
    -Real.pi < θ-2*(phaseIndex θ:ℝ)*Real.pi ∧
      θ-2*(phaseIndex θ:ℝ)*Real.pi < Real.pi := by
  have hp : 0 < 2*Real.pi := mul_pos (by norm_num) Real.pi_pos
  have hlo := (le_div_iff₀ hp).1 (Int.floor_le ((θ+Real.pi)/(2*Real.pi)))
  have hhi := (div_lt_iff₀ hp).1 (Int.lt_floor_add_one ((θ+Real.pi)/(2*Real.pi)))
  change (phaseIndex θ:ℝ)*(2*Real.pi) ≤ θ+Real.pi at hlo
  change θ+Real.pi < ((phaseIndex θ:ℝ)+1)*(2*Real.pi) at hhi
  constructor
  · have hne := hodd (phaseIndex θ-1)
    push_cast at hne
    by_contra h
    apply hne
    nlinarith
  · nlinarith

theorem phaseIndex_nonneg {θ : ℝ} (hθ : 0 ≤ θ) : 0 ≤ phaseIndex θ := by
  exact Int.floor_nonneg.2 (div_nonneg (by linarith [Real.pi_pos]) (by positivity))

theorem phaseIndex_eq_zero_iff {θ : ℝ} (hθ : 0 ≤ θ) :
    phaseIndex θ = 0 ↔ θ < Real.pi := by
  unfold phaseIndex
  rw [Int.floor_eq_iff]
  norm_num
  have hp : 0 < 2*Real.pi := by positivity
  constructor
  · intro h
    have hlt := (div_lt_iff₀ hp).1 h.2
    linarith
  · intro h
    constructor
    · apply div_nonneg <;> linarith [Real.pi_pos]
    · apply (div_lt_iff₀ hp).2
      linarith

theorem exp_phaseIndex_sub (θ : ℝ) :
    Complex.exp (((θ-2*(phaseIndex θ:ℝ)*Real.pi:ℝ):ℂ)*Complex.I) =
      Complex.exp ((θ:ℂ)*Complex.I) := by
  apply Complex.exp_eq_exp_iff_exists_int.2
  refine ⟨-phaseIndex θ, ?_⟩
  push_cast
  ring

end C2.NGamma.Cayley

end

/- ===== C2.NGammaRootCount ===== -/

/-! Exact outside-root count for the actual positive-cascade characteristic.
The argument principle is proved from polynomial factorization in this project;
no root-count, winding or convergence conclusion is assumed. -/
noncomputable section
open scoped BigOperators Topology
namespace C2.NGamma.Cayley
open PolynomialModel RootCountBridge

/-- The root-count lemma with the nonvanishing endpoint exposed as a separate
algebraic obligation. `root_count` below discharges that obligation. -/
theorem root_count_from_endpoint {n d : ℕ} (hn : 0 < n) (hd : 1 ≤ d)
    {r x : Fin n → ℝ} (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i)
    {b tb : ℝ} (htb : 0 < tb) (hBeq : amplitude r x tb = b)
    (hbound : (∃ j, x j = 0) ∨ b < ∏ i, (r i+2/x i))
    (hodd : ∀ k : ℤ, Phase.totalPhase (fun i => x i+2/r i) x d tb ≠
      (2*(k:ℝ)+1)*Real.pi)
    (hend : (characteristic r x d b).eval (-1) ≠ 0) :
    (countOutside (characteristic r x d b) : ℤ) =
      2 * phaseIndex (Phase.totalPhase (fun i => x i+2/r i) x d tb) := by
  let k := phaseIndex (Phase.totalPhase (fun i => x i+2/r i) x d tb)
  have hk := phaseIndex_bounds hodd
  have hlo : -Real.pi < Phase.totalPhase (fun i => x i+2/r i) x d tb - 2*Real.pi*k := by
    dsimp [k]
    nlinarith [hk.1]
  have hhi : Phase.totalPhase (fun i => x i+2/r i) x d tb - 2*Real.pi*k < Real.pi := by
    dsimp [k]
    nlinarith [hk.2]
  have hb : 0 < b := by rw [← hBeq]; exact amplitude_pos hr x tb
  have hroots := no_unit_roots_of_cayley_nonzero (characteristic_eval_conj r x d b)
    (characteristic_point_ne_zero hn hr hx d htb.le hBeq hlo hhi) hend
  apply exterior_count_of_cayley_argument (characteristic_ne_zero hr hx hd b)
    (characteristic_eval_conj r x d b) hroots
    (characteristicAngle_continuousOn hn hr hx d htb.le hBeq hlo hhi)
    (fun t _ => characteristicAngle_polar hr x d b tb k t)
    (characteristicAngle_tendsto_atTop hr hx d hb.le k hbound) k
  rw [characteristicAngle_zero hr x d hb htb.le k, sub_zero,
    characteristic_natDegree hr hx hd b]
  simp only [Fintype.card_fin, Nat.cast_add]
  ring

/-- Exact exterior-root count, including multiplicity, for every positive
cascade order and integer delay at a nonodd magnitude crossing. -/
theorem root_count {n d : ℕ} (hn : 0 < n) (hd : 1 ≤ d)
    {r x : Fin n → ℝ} (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i)
    {b tb : ℝ} (htb : 0 < tb) (hBeq : amplitude r x tb = b)
    (hbound : (∃ j, x j = 0) ∨ b < ∏ i, (r i+2/x i))
    (hodd : ∀ k : ℤ, Phase.totalPhase (fun i => x i+2/r i) x d tb ≠
      (2*(k:ℝ)+1)*Real.pi) :
    (countOutside (characteristic r x d b) : ℤ) =
      2 * phaseIndex (Phase.totalPhase (fun i => x i+2/r i) x d tb) := by
  have hb : 0 ≤ b := by rw [← hBeq]; exact (amplitude_pos hr x tb).le
  exact root_count_from_endpoint hn hd hr hx htb hBeq hbound hodd
    (characteristic_eval_neg_one_ne_zero hr hx d hb hbound)

theorem nonodd_of_phase_lt_pi {θ : ℝ} (hθ : 0 ≤ θ) (hpi : θ < Real.pi) :
    ∀ k : ℤ, θ ≠ (2*(k:ℝ)+1)*Real.pi := by
  intro k he
  by_cases hk : 0 ≤ k
  · have hkr : 0 ≤ (k:ℝ) := by exact_mod_cast hk
    have hp := mul_nonneg hkr Real.pi_pos.le
    nlinarith
  · have hkr : (k:ℝ) ≤ -1 := by exact_mod_cast (show k ≤ -1 by omega)
    have hp := mul_le_mul_of_nonneg_right hkr Real.pi_pos.le
    nlinarith [Real.pi_pos]

theorem exp_odd_pi (k : ℤ) :
    Complex.exp ((((2*(k:ℝ)+1)*Real.pi:ℝ):ℂ)*Complex.I) = -1 := by
  rw [← Complex.exp_pi_mul_I]
  apply Complex.exp_eq_exp_iff_exists_int.2
  refine ⟨k, ?_⟩
  push_cast
  ring

/-- Actual Schur stability at an intermediate gain is precisely the first
phase inequality. Higher odd phase levels are excluded by unit roots and all
other higher levels by a positive exterior-root count. -/
theorem schur_iff_phase_lt_pi_at_magnitude_crossing {n d : ℕ}
    (hn : 0 < n) (hd : 1 ≤ d) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i)
    {b tb : ℝ} (htb : 0 < tb) (hBeq : amplitude r x tb = b)
    (hbound : (∃ j, x j = 0) ∨ b < ∏ i, (r i+2/x i)) :
    SchurStable (characteristic r x d b) ↔
      Phase.totalPhase (fun i => x i+2/r i) x d tb < Real.pi := by
  classical
  have hb : 0 ≤ b := by rw [← hBeq]; exact (amplitude_pos hr x tb).le
  have hp := Phase.totalPhase_pos hn (a := fun i => x i+2/r i) (x := x)
    (fun i => lt_add_of_pos_right (x i) (div_pos (by norm_num) (hr i))) d htb
  by_cases hodd : ∀ k : ℤ, Phase.totalPhase (fun i => x i+2/r i) x d tb ≠ (2*(k:ℝ)+1)*Real.pi
  · let k := phaseIndex (Phase.totalPhase (fun i => x i+2/r i) x d tb)
    have hk := phaseIndex_bounds hodd
    have hlo : -Real.pi < Phase.totalPhase (fun i => x i+2/r i) x d tb - 2*Real.pi*k := by
      dsimp [k]; nlinarith [hk.1]
    have hhi : Phase.totalPhase (fun i => x i+2/r i) x d tb - 2*Real.pi*k < Real.pi := by
      dsimp [k]; nlinarith [hk.2]
    have hroots := no_unit_roots_of_cayley_nonzero (characteristic_eval_conj r x d b)
      (characteristic_point_ne_zero hn hr hx d htb.le hBeq hlo hhi)
      (characteristic_eval_neg_one_ne_zero hr hx d hb hbound)
    rw [schur_iff_countOutside_zero (characteristic_ne_zero hr hx hd b) hroots]
    have hc := root_count hn hd hr hx htb hBeq hbound hodd
    have hz : countOutside (characteristic r x d b) = 0 ↔
        phaseIndex (Phase.totalPhase (fun i => x i+2/r i) x d tb) = 0 := by omega
    rw [hz, phaseIndex_eq_zero_iff hp.le]
  · push_neg at hodd
    obtain ⟨k, he⟩ := hodd
    have hroot : (characteristic r x d b).eval (point tb) = 0 := by
      rw [characteristic_point_zero_iff_gain_phase hr x d hb]
      exact ⟨hBeq, by rw [he]; exact exp_odd_pi k⟩
    have hns : ¬ SchurStable (characteristic r x d b) := by
      intro hs
      have h := hs (point tb) hroot
      rw [point_norm] at h
      exact lt_irrefl _ h
    have hnlt : ¬ Phase.totalPhase (fun i => x i+2/r i) x d tb < Real.pi := by
      intro h
      exact nonodd_of_phase_lt_pi hp.le h k he
    exact iff_of_false hns hnlt

end C2.NGamma.Cayley

end

/- ===== C2.IntegratorDelayRootCount ===== -/

noncomputable section
open Polynomial Filter
open scoped Topology ComplexConjugate
namespace C2.IntegratorDelay
open NGamma.PolynomialModel NGamma.RootCountBridge NGamma.ArgumentMatch
open NGamma.Cayley

def characteristicAngle (n : ℕ) (x a tb : ℝ) (k : ℤ) (t : ℝ) : ℝ :=
  qPhase x t + translatedAngle (amplitude x) (totalPhase n x) a tb k t

theorem totalPhase_continuous (n : ℕ) (x : ℝ) : Continuous (totalPhase n x) := by
  unfold totalPhase
  exact ((continuous_const.mul Real.continuous_arctan).add continuous_const).sub
    (Real.continuous_arctan.comp (continuous_const.mul continuous_id))

theorem integratorAngle_continuousOn (n : ℕ) (x : ℝ) {a tb : ℝ} {k : ℤ}
    (ha : 0 < a) (htb : 0 < tb) (hBeq : amplitude x tb = a)
    (hlo : -Real.pi < totalPhase n x tb - 2 * Real.pi * k)
    (hhi : totalPhase n x tb - 2 * Real.pi * k < Real.pi) :
    ContinuousOn (characteristicAngle n x a tb k) (Set.Ici 0) := by
  apply ContinuousOn.add (qPhase_continuous x).continuousOn
  exact zero_translatedAngle_continuousOn (amplitude_continuous x)
    (totalPhase_continuous n x) (fun t ht => amplitude_nonneg x ht)
    (fun t ht => amplitude_pos x ht) (amplitude_strictMonoOn x) ha htb hBeq hlo hhi

theorem integratorAngle_polar (n : ℕ) (x a tb : ℝ) (k : ℤ)
    (htb : 0 ≤ tb) {t : ℝ} (ht : 0 ≤ t) :
    (poly n x a).eval (point t) = (‖(poly n x a).eval (point t)‖ : ℂ) *
      Complex.exp ((characteristicAngle n x a tb k t : ℂ) * Complex.I) := by
  have hqnorm : ‖(q x).eval (point t)‖ = qAmplitude x t := by
    rw [q_polar, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (qAmplitude_pos x t), Complex.norm_exp_ofReal_mul_I, mul_one]
  have hq : (q x).eval (point t) = (‖(q x).eval (point t)‖ : ℂ) *
      Complex.exp ((qPhase x t : ℂ) * Complex.I) := by rw [hqnorm]; exact q_polar x t
  have hp := zero_translatedAngle_polar (B := amplitude x) (ψ := totalPhase n x)
    (b := a) (k := k) (fun t ht => amplitude_pos x ht) htb ht
  have hp' : transfer n x (point t) + a = (‖transfer n x (point t) + a‖ : ℂ) *
      Complex.exp ((translatedAngle (amplitude x) (totalPhase n x) a tb k t : ℂ) * Complex.I) := by
    simpa only [polarCurve, ← transfer_polar n x t ht] using hp
  rw [poly_eval_point]
  exact NGamma.Cayley.polar_mul hq hp'

theorem integrator_point_ne_zero (n : ℕ) (x : ℝ) {a tb : ℝ} {k : ℤ}
    (ha : 0 < a) (htb : 0 < tb) (hBeq : amplitude x tb = a)
    (hlo : -Real.pi < totalPhase n x tb - 2 * Real.pi * k)
    (hhi : totalPhase n x tb - 2 * Real.pi * k < Real.pi)
    {t : ℝ} (ht : 0 ≤ t) : (poly n x a).eval (point t) ≠ 0 := by
  rw [poly_eval_point]
  apply mul_ne_zero (q_eval_point_ne_zero x t)
  have h := zero_translated_curve_ne_zero (B := amplitude x) (ψ := totalPhase n x)
    (fun t ht => amplitude_nonneg x ht) (fun t ht => amplitude_pos x ht)
    (amplitude_strictMonoOn x) ha htb hBeq hlo hhi ht
  simpa only [polarCurve, ← transfer_polar n x t ht] using h

theorem integratorAngle_zero (n : ℕ) (x : ℝ) {a tb : ℝ} (k : ℤ)
    (ha : 0 < a) (htb : 0 ≤ tb) : characteristicAngle n x a tb k 0 = 0 := by
  unfold characteristicAngle
  rw [zero_translatedAngle_zero (amplitude_zero x) ha htb]
  simp [qPhase]

theorem poly_endpoint_ne_zero (n : ℕ) {x a : ℝ} (ha : 0 < a)
    (hbound : a * |x| < 2) : (poly n x a).eval (-1) ≠ 0 := by
  intro he
  rw [poly_eval_neg_one] at he
  have he' : (a : ℂ) * x = -2 * (-1 : ℂ) ^ n := by linear_combination -he
  have hh := congrArg norm he'
  simp only [norm_mul, norm_pow, norm_neg, norm_one, one_pow, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos ha, mul_one] at hh
  norm_num at hh
  linarith

theorem transfer_correction_arg_limit (n : ℕ) {x a : ℝ} (ha : 0 < a)
    (hbound : a * |x| < 2) :
    Tendsto (fun t => Complex.arg (1 + (a : ℂ) / transfer n x (point t))) atTop (𝓝 0) := by
  let c : ℝ := a * x / (2 * (-1) ^ n)
  have hcabs : |c| < 1 := by
    have he : |c| = a * |x| / 2 := by
      simp [c, abs_div, abs_mul, abs_pow, abs_of_pos ha]
    rw [he]
    linarith
  have hcpos : 0 < (1 + (c : ℂ)).re := by
    simp only [Complex.add_re, Complex.one_re, Complex.ofReal_re]
    have := (abs_lt.mp hcabs).1
    linarith
  have hcarg : Complex.arg (1 + (c : ℂ)) = 0 :=
    Complex.arg_eq_zero_iff.2 ⟨hcpos.le, by simp⟩
  have h := (Complex.continuousAt_arg (Or.inl hcpos)).tendsto.comp
    ((reciprocal_transfer_tendsto_atTop n x a).const_add 1)
  simpa only [hcarg] using h

theorem integratorAngle_tendsto (n : ℕ) {x a tb : ℝ} (k : ℤ)
    (ha : 0 < a) (hbound : a * |x| < 2) :
    Tendsto (characteristicAngle n x a tb k) atTop
      (𝓝 (((n : ℝ) + 1) * Real.pi - 2 * Real.pi * k)) := by
  have hat := Real.tendsto_arctan_atTop.mono_right nhdsWithin_le_nhds
  have hmain : Tendsto (fun t => (2 * (n : ℝ) + 1) * Real.arctan t + Real.pi / 2)
      atTop (𝓝 (((n : ℝ) + 1) * Real.pi)) := by
    convert (hat.const_mul (2 * (n : ℝ) + 1)).add_const (Real.pi / 2) using 1 <;> ring
  have hlim := ((hmain.add (transfer_correction_arg_limit n ha hbound)).sub_const
    (2 * Real.pi * k))
  simp only [add_zero] at hlim
  apply hlim.congr'
  filter_upwards [eventually_gt_atTop tb, eventually_ge_atTop (0 : ℝ)] with t ht ht0
  simp only [characteristicAngle, translatedAngle, not_le.mpr ht, if_false]
  rw [polarCurve, ← transfer_polar n x t ht0]
  unfold qPhase totalPhase
  ring

/-- Exact exterior-root count, with multiplicity, for the integrator case `r=0`. -/
theorem integrator_root_count {n : ℕ} (hn : 1 ≤ n) {x a tb : ℝ}
    (ha : 0 < a) (htb : 0 < tb) (hBeq : amplitude x tb = a) (hbound : a * |x| < 2)
    (hodd : ∀ k : ℤ, totalPhase n x tb ≠ (2 * (k : ℝ) + 1) * Real.pi) :
    (countOutside (poly n x a) : ℤ) = 2 * phaseIndex (totalPhase n x tb) := by
  let k := phaseIndex (totalPhase n x tb)
  have hk := phaseIndex_bounds hodd
  have hlo : -Real.pi < totalPhase n x tb - 2 * Real.pi * k := by dsimp [k]; nlinarith [hk.1]
  have hhi : totalPhase n x tb - 2 * Real.pi * k < Real.pi := by dsimp [k]; nlinarith [hk.2]
  have hroots := no_unit_roots_of_cayley_nonzero (poly_eval_conj n x a)
    (fun t ht => integrator_point_ne_zero n x ha htb hBeq hlo hhi ht)
    (poly_endpoint_ne_zero n ha hbound)
  apply exterior_count_of_cayley_argument (poly_ne_zero hn x a) (poly_eval_conj n x a)
    hroots (integratorAngle_continuousOn n x ha htb hBeq hlo hhi)
    (fun t ht => integratorAngle_polar n x a tb k htb.le ht)
    (integratorAngle_tendsto n k ha hbound) k
  rw [integratorAngle_zero n x k ha htb.le, sub_zero, poly_natDegree hn]
  push_cast
  ring

theorem integrator_schur_iff_phase {n : ℕ} (hn : 2 ≤ n) {x a tb : ℝ}
    (hx : x ≤ 1) (ha : 0 < a) (htb : 0 < tb)
    (hBeq : amplitude x tb = a) (hbound : a * |x| < 2) :
    SchurStable (poly n x a) ↔ totalPhase n x tb < Real.pi := by
  have hpos := totalPhase_pos hn hx htb.le
  by_cases hodd : ∀ k : ℤ, totalPhase n x tb ≠ (2 * (k : ℝ) + 1) * Real.pi
  · let k := phaseIndex (totalPhase n x tb)
    have hk := phaseIndex_bounds hodd
    have hlo : -Real.pi < totalPhase n x tb - 2 * Real.pi * k := by dsimp [k]; nlinarith [hk.1]
    have hhi : totalPhase n x tb - 2 * Real.pi * k < Real.pi := by dsimp [k]; nlinarith [hk.2]
    have hroots := no_unit_roots_of_cayley_nonzero (poly_eval_conj n x a)
      (fun t ht => integrator_point_ne_zero n x ha htb hBeq hlo hhi ht)
      (poly_endpoint_ne_zero n ha hbound)
    rw [schur_iff_countOutside_zero (poly_ne_zero (by omega) x a) hroots]
    have hc := integrator_root_count (by omega : 1 ≤ n) ha htb hBeq hbound hodd
    have he : countOutside (poly n x a) = 0 ↔ phaseIndex (totalPhase n x tb) = 0 := by omega
    rw [he, phaseIndex_eq_zero_iff hpos.le]
  · push_neg at hodd
    obtain ⟨k, hk⟩ := hodd
    have hroot : (poly n x a).eval (point tb) = 0 := by
      rw [poly_eval_point, transfer_polar n x tb htb.le, hBeq, hk,
        NGamma.Cayley.exp_odd_pi k]
      ring
    have hns : ¬ SchurStable (poly n x a) := by
      intro hs
      have h := hs (point tb) hroot
      rw [point_norm] at h
      exact lt_irrefl 1 h
    have hnt : ¬ totalPhase n x tb < Real.pi := by
      intro h
      exact NGamma.Cayley.nonodd_of_phase_lt_pi hpos.le h k hk
    exact iff_of_false hns hnt

end C2.IntegratorDelay

end

/- ===== C2.IntegratorDelayHighGain ===== -/

noncomputable section
open Polynomial Filter
open scoped Topology ComplexConjugate
namespace C2.IntegratorDelay
open NGamma.PolynomialModel NGamma.RootCountBridge NGamma.ArgumentMatch
open NGamma.Cayley

def highGainAngle (n : ℕ) (x a t : ℝ) : ℝ :=
  qPhase x t + Complex.arg (transfer n x (point t) + a)

theorem transfer_point_continuous (n : ℕ) (x : ℝ) :
    Continuous (fun t => transfer n x (point t)) := by
  have hp : Continuous point := by
    change Continuous (fun t : ℝ => point t)
    simp_rw [point_exp]
    exact Complex.continuous_exp.comp
      ((Complex.continuous_ofReal.comp (continuous_const.mul Real.continuous_arctan)).mul
        continuous_const)
  have h : Continuous (fun t : ℝ => (point t) ^ n * (2 * Complex.I * t) /
      (1 + Complex.I * (x * t : ℝ))) := by
    apply Continuous.div (by fun_prop) (by fun_prop)
    intro t
    exact one_add_I_mul_ne_zero (x * t)
  simpa only [transfer_point] using h

theorem high_gain_curve_re_pos (n : ℕ) {x a : ℝ} (ha : 0 < a)
    (hhigh : 2 ≤ a * |x|) {t : ℝ} (ht : 0 ≤ t) :
    0 < (transfer n x (point t) + a).re := by
  have hx : x ≠ 0 := by
    intro h
    rw [h, abs_zero, mul_zero] at hhigh
    linarith
  have hax := abs_pos.mpr hx
  apply add_re_pos_of_norm_lt
  rw [transfer_norm n x t ht]
  exact (mul_lt_mul_right hax).mp
    ((amplitude_endpoint_bound x ht).trans_le hhigh)

theorem high_gain_finite_ne_zero (n : ℕ) {x a : ℝ} (ha : 0 < a)
    (hhigh : 2 ≤ a * |x|) {t : ℝ} (ht : 0 ≤ t) :
    (poly n x a).eval (point t) ≠ 0 := by
  rw [poly_eval_point]
  apply mul_ne_zero (q_eval_point_ne_zero x t)
  intro he
  have h := high_gain_curve_re_pos n ha hhigh ht
  rw [he] at h
  exact lt_irrefl 0 h

theorem highGainAngle_continuousOn (n : ℕ) {x a : ℝ} (ha : 0 < a)
    (hhigh : 2 ≤ a * |x|) : ContinuousOn (highGainAngle n x a) (Set.Ici 0) := by
  apply ContinuousOn.add (qPhase_continuous x).continuousOn
  intro t ht
  exact ContinuousAt.comp_continuousWithinAt
    (f := fun u => transfer n x (point u) + (a : ℂ))
    (Complex.continuousAt_arg (Or.inl (high_gain_curve_re_pos n ha hhigh ht)))
    ((transfer_point_continuous n x).add continuous_const).continuousAt.continuousWithinAt

theorem highGainAngle_polar (n : ℕ) (x a t : ℝ) :
    (poly n x a).eval (point t) = (‖(poly n x a).eval (point t)‖ : ℂ) *
      Complex.exp ((highGainAngle n x a t : ℂ) * Complex.I) := by
  have hqnorm : ‖(q x).eval (point t)‖ = qAmplitude x t := by
    rw [q_polar, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (qAmplitude_pos x t), Complex.norm_exp_ofReal_mul_I, mul_one]
  have hq : (q x).eval (point t) = (‖(q x).eval (point t)‖ : ℂ) *
      Complex.exp ((qPhase x t : ℂ) * Complex.I) := by rw [hqnorm]; exact q_polar x t
  rw [poly_eval_point]
  exact NGamma.Cayley.polar_mul hq (Complex.norm_mul_exp_arg_mul_I _).symm

theorem highGainAngle_zero (n : ℕ) (x : ℝ) {a : ℝ} (ha : 0 < a) :
    highGainAngle n x a 0 = 0 := by
  simp only [highGainAngle, qPhase, mul_zero, Real.arctan_zero, add_zero,
    transfer_point, Complex.ofReal_zero, mul_zero, zero_div, zero_add]
  exact Complex.arg_ofReal_of_nonneg ha.le

theorem qPhase_negative_limit {x : ℝ} (hx : x < 0) :
    Tendsto (qPhase x) atTop (𝓝 0) := by
  have ha := Real.tendsto_arctan_atTop.mono_right nhdsWithin_le_nhds
  have hb := arctan_mul_tendsto_atTop (show 0 ≤ -x by linarith)
  have hxne : -x ≠ 0 := by linarith
  simp only [hxne, if_false] at hb
  have h := ha.sub hb
  simp only [sub_self] at h
  convert h using 1
  funext t
  simp only [qPhase, neg_mul, Real.arctan_neg]
  ring

theorem highGainAngle_tendsto (n : ℕ) {x a : ℝ} (ha : 0 < a)
    (hhigh : 2 ≤ a * |x|) (hend : (poly n x a).eval (-1) ≠ 0) :
    Tendsto (highGainAngle n x a) atTop (𝓝 (if 0 < x then Real.pi else 0)) := by
  have hx : x ≠ 0 := by
    intro h
    rw [h, abs_zero, mul_zero] at hhigh
    linarith
  let c : ℝ := 2 * (-1) ^ n / x + a
  have hlim : Tendsto (fun t => transfer n x (point t) + a) atTop (𝓝 (c : ℂ)) := by
    simpa [c] using (transfer_tendsto_atTop n hx).add_const (a : ℂ)
  have hreal : Tendsto (fun t => (transfer n x (point t) + a).re) atTop (𝓝 c) := by
    simpa using Complex.continuous_re.continuousAt.tendsto.comp hlim
  have hc0 : 0 ≤ c := ge_of_tendsto hreal (by
    filter_upwards [eventually_ge_atTop (0 : ℝ)] with t ht
    exact (high_gain_curve_re_pos n ha hhigh ht).le)
  have hcne : c ≠ 0 := by
    intro he
    apply hend
    rw [poly_eval_neg_one]
    have hrc : (-2 * (-1 : ℝ) ^ n - a * x) = 0 := by
      have hh : x * c = 2 * (-1 : ℝ) ^ n + a * x := by dsimp [c]; field_simp [hx] <;> ring
      rw [he, mul_zero] at hh
      linarith
    exact_mod_cast hrc
  have hc : 0 < c := lt_of_le_of_ne hc0 (Ne.symm hcne)
  have harg := (Complex.continuousAt_arg (Or.inl (show 0 < (c : ℂ).re by simpa using hc))).tendsto.comp hlim
  have harg0 : Tendsto (fun t => Complex.arg (transfer n x (point t) + a)) atTop (𝓝 0) := by
    simpa only [Complex.arg_ofReal_of_nonneg hc.le] using harg
  by_cases hxpos : 0 < x
  · rw [if_pos hxpos]
    have hq : Tendsto (qPhase x) atTop (𝓝 Real.pi) := by
      simpa only [ne_of_gt hxpos, if_false, sub_zero] using qPhase_tendsto_atTop hxpos.le
    simpa only [highGainAngle, add_zero] using hq.add harg0
  · rw [if_neg hxpos]
    have hxneg : x < 0 := lt_of_le_of_ne (le_of_not_gt hxpos) hx
    simpa only [highGainAngle, add_zero] using (qPhase_negative_limit hxneg).add harg0

/-- All gains beyond the magnitude endpoint are excluded, including equality. -/
theorem not_schur_of_high_gain {n : ℕ} (hn : 1 ≤ n) {x a : ℝ}
    (ha : 0 < a) (hhigh : 2 ≤ a * |x|) : ¬ SchurStable (poly n x a) := by
  by_cases hend : (poly n x a).eval (-1) = 0
  · intro hs
    have h := hs (-1) hend
    norm_num at h
  · have hroots := no_unit_roots_of_cayley_nonzero (poly_eval_conj n x a)
      (fun t ht => high_gain_finite_ne_zero n ha hhigh ht) hend
    have hi := polynomial_argument_principle_cayley (poly_ne_zero hn x a)
      (poly_eval_conj n x a) hroots (highGainAngle_continuousOn n ha hhigh)
      (fun t _ => highGainAngle_polar n x a t) (highGainAngle_tendsto n ha hhigh hend)
    rw [highGainAngle_zero n x ha, sub_zero] at hi
    have hinside : countInside (poly n x a) ≤ 1 := by
      by_contra! hc
      have hc' : (2 : ℝ) ≤ countInside (poly n x a) := by exact_mod_cast hc
      split_ifs at hi <;> nlinarith [Real.pi_pos]
    intro hs
    have hout := (schur_iff_countOutside_zero (poly_ne_zero hn x a) hroots).1 hs
    have hpart := count_partition (poly n x a) hroots
    rw [hout, add_zero, poly_natDegree hn] at hpart
    omega

end C2.IntegratorDelay

end

/- ===== C2.IntegratorDelayTwo ===== -/

/-! The exact two-sample integrator region, including the closed-form threshold.
Stability here quantifies over the actual complex roots of the cubic; it is
not defined by the inequalities that are to be proved. -/

noncomputable section
namespace C2.IntegratorDelay

def characteristic (n : ℕ) (γ a : ℝ) (z : ℂ) : ℂ :=
  z ^ n * (z - 1) + (a : ℂ) * ((γ : ℂ) * z + 1 - γ)

def Stable (n : ℕ) (γ a : ℝ) : Prop :=
  ∀ z : ℂ, characteristic n γ a z = 0 → ‖z‖ < 1

theorem two_characteristic (γ a : ℝ) (z : ℂ) :
    characteristic 2 γ a z =
      z ^ 3 + (-1 : ℂ) * z ^ 2 + (a * γ : ℝ) * z + (a * (1 - γ) : ℝ) := by
  simp only [characteristic]
  push_cast
  ring

theorem two_stable_iff_cubic (γ a : ℝ) :
    Stable 2 γ a ↔ C2.CubicSchur (-1) (a * γ) (a * (1 - γ)) := by
  simp only [Stable, C2.CubicSchur, two_characteristic, Complex.ofReal_neg,
    Complex.ofReal_one]

/-- Corollary `cor:n2`, the full strict region, including positivity of gain. -/
theorem two_stable_iff {γ a : ℝ} (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    Stable 2 γ a ↔ 0 < a ∧ a + (1 - γ) ^ 2 * a ^ 2 < 1 := by
  rw [two_stable_iff_cubic, C2.cubicSchur_iff]
  constructor
  · rintro ⟨_, hp, _, hf⟩
    exact ⟨by nlinarith, by nlinarith⟩
  · rintro ⟨ha, hf⟩
    have hq : 0 ≤ (1 - γ) ^ 2 * a ^ 2 := mul_nonneg (sq_nonneg _) (sq_nonneg _)
    have ha1 : a < 1 := by linarith
    have hc0 : 0 ≤ a * (1 - γ) := mul_nonneg ha.le (by linarith)
    have hc1 : a * (1 - γ) < 1 := by nlinarith
    refine ⟨by simpa only [abs_of_nonneg hc0] using hc1, ?_, ?_, ?_⟩
    · nlinarith
    · nlinarith [mul_nonneg ha.le hγ0]
    · nlinarith

def twoThreshold (γ : ℝ) : ℝ :=
  2 / (1 + Real.sqrt (1 + 4 * (1 - γ) ^ 2))

theorem twoThreshold_pos (γ : ℝ) : 0 < twoThreshold γ := by
  unfold twoThreshold
  positivity

theorem twoThreshold_equation (γ : ℝ) :
    twoThreshold γ + (1 - γ) ^ 2 * (twoThreshold γ) ^ 2 = 1 := by
  have hs := Real.sq_sqrt (show 0 ≤ 1 + 4 * (1 - γ) ^ 2 by positivity)
  have hd : 1 + Real.sqrt (1 + 4 * (1 - γ) ^ 2) ≠ 0 := by positivity
  unfold twoThreshold
  field_simp
  nlinarith

theorem twoThreshold_le_one (γ : ℝ) : twoThreshold γ ≤ 1 := by
  have h := twoThreshold_equation γ
  nlinarith [mul_nonneg (sq_nonneg (1 - γ)) (sq_nonneg (twoThreshold γ))]

theorem two_quadratic_iff_threshold {γ a : ℝ} (ha : 0 < a) :
    a + (1 - γ) ^ 2 * a ^ 2 < 1 ↔ a < twoThreshold γ := by
  have ht := twoThreshold_pos γ
  have he := twoThreshold_equation γ
  have hfac : a + (1 - γ) ^ 2 * a ^ 2 - 1 =
      (a - twoThreshold γ) * (1 + (1 - γ) ^ 2 * (a + twoThreshold γ)) := by
    nlinarith [he]
  have hpos : 0 < 1 + (1 - γ) ^ 2 * (a + twoThreshold γ) := by positivity
  calc
    a + (1 - γ) ^ 2 * a ^ 2 < 1 ↔
        a + (1 - γ) ^ 2 * a ^ 2 - 1 < 0 := sub_neg.symm
    _ ↔ (a - twoThreshold γ) * (1 + (1 - γ) ^ 2 * (a + twoThreshold γ)) < 0 := by
      rw [hfac]
    _ ↔ a - twoThreshold γ < 0 := by
      constructor
      · intro h
        rcases mul_neg_iff.mp h with h | h
        · linarith [h.2]
        · exact h.1
      · intro h
        exact mul_neg_of_neg_of_pos h hpos
    _ ↔ a < twoThreshold γ := sub_neg

/-- The rationalized expression remains valid at backward Euler (`γ = 1`). -/
theorem two_stable_iff_threshold {γ a : ℝ} (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    Stable 2 γ a ↔ 0 < a ∧
      a < 2 / (1 + Real.sqrt (1 + 4 * (1 - γ) ^ 2)) := by
  rw [two_stable_iff hγ0 hγ1]
  constructor
  · rintro ⟨ha, h⟩
    exact ⟨ha, (two_quadratic_iff_threshold ha).mp h⟩
  · rintro ⟨ha, h⟩
    exact ⟨ha, (two_quadratic_iff_threshold ha).mpr h⟩

@[simp] theorem twoThreshold_one : twoThreshold 1 = 1 := by
  norm_num [twoThreshold]

theorem two_threshold_unique_max {γ : ℝ} :
    twoThreshold γ = 1 ↔ γ = 1 := by
  constructor
  · intro h
    have he := twoThreshold_equation γ
    rw [h] at he
    nlinarith [sq_nonneg (1 - γ)]
  · rintro rfl
    exact twoThreshold_one

theorem two_threshold_strictMono : StrictMonoOn twoThreshold (Set.Icc 0 1) := by
  intro γ hγ δ hδ hlt
  have hc : (1 - δ) ^ 2 < (1 - γ) ^ 2 := by nlinarith [hγ.2, hδ.2]
  have htγ := twoThreshold_pos γ
  have htδ := twoThreshold_pos δ
  have heγ := twoThreshold_equation γ
  have heδ := twoThreshold_equation δ
  have hprod := mul_lt_mul_of_pos_right hc (sq_pos_of_pos htγ)
  have hsmall : twoThreshold γ + (1 - δ) ^ 2 * (twoThreshold γ) ^ 2 < 1 := by
    linarith
  exact (two_quadratic_iff_threshold htγ).mp hsmall

end C2.IntegratorDelay

end

/- ===== C2.IntegratorDelaySampling ===== -/

noncomputable section
open Filter Topology
namespace C2.IntegratorDelay

/-- The fine-sampling physical-threshold formula in `cor:global`.
The connection to the optimizing stability margin is a separate theorem. -/
def physicalThreshold (n : ℕ) : ℝ :=
  2 * (n : ℝ) * Real.sin (Real.pi / (4 * (n : ℝ) - 2))

def physicalAngleValue (x : ℝ) : ℝ :=
  (Real.pi / (2 * x) + 1) * Real.sin x

theorem sine_tangent_remainder_bound {x : ℝ} (hx : 0 ≤ x) :
    Real.sin x - x * Real.cos x ≤ x ^ 3 / 3 := by
  let f : ℝ → ℝ := fun t => t ^ 3 / 3 - Real.sin t + t * Real.cos t
  have hf (t : ℝ) : HasDerivAt f (t ^ 2 - t * Real.sin t) t := by
    convert ((((hasDerivAt_id t).pow 3).div_const 3).sub (Real.hasDerivAt_sin t)).add
      ((hasDerivAt_id t).mul (Real.hasDerivAt_cos t)) using 1 <;> simp [f] <;> ring
  have hm : MonotoneOn f (Set.Ici 0) := by
    apply monotoneOn_of_deriv_nonneg (convex_Ici 0) ?_ ?_ ?_
    · exact (by fun_prop : Continuous f).continuousOn
    · intro t ht
      exact (hf t).differentiableAt.differentiableWithinAt
    · intro t ht
      rw [(hf t).deriv]
      have ht0 : 0 ≤ t := (interior_subset ht)
      nlinarith [mul_le_mul_of_nonneg_left (Real.sin_le ht0) ht0]
  have h := hm (show (0 : ℝ) ∈ Set.Ici 0 by simp) hx hx
  simp [f] at h
  linarith

theorem physicalAngleValue_hasDerivAt {x : ℝ} (hx : x ≠ 0) :
    HasDerivAt physicalAngleValue
      (Real.cos x - Real.pi / (2 * x ^ 2) * (Real.sin x - x * Real.cos x)) x := by
  have h := (((hasDerivAt_const x Real.pi).div
    ((hasDerivAt_id x).const_mul 2) (by simpa using hx)).add_const 1).mul
      (Real.hasDerivAt_sin x)
  convert h using 1
  simp only [id_eq, mul_one, zero_mul, zero_sub]
  field_simp [hx] <;> ring

theorem physicalAngleValue_deriv_pos {x : ℝ}
    (hx : x ∈ Set.Ioc 0 (Real.pi / 6)) :
    0 < deriv physicalAngleValue x := by
  rw [(physicalAngleValue_hasDerivAt hx.1.ne').deriv]
  have hrem := sine_tangent_remainder_bound hx.1.le
  have hcoef : 0 ≤ Real.pi / (2 * x ^ 2) := by positivity
  have hbound := mul_le_mul_of_nonneg_left hrem hcoef
  have hsimp : Real.pi / (2 * x ^ 2) * (x ^ 3 / 3) = Real.pi * x / 6 := by
    field_simp [hx.1.ne'] <;> ring
  rw [hsimp] at hbound
  have hcos := Real.cos_le_cos_of_nonneg_of_le_pi hx.1.le
    (show Real.pi / 3 ≤ Real.pi by linarith [Real.pi_pos])
    (show x ≤ Real.pi / 3 by linarith [Real.pi_pos, hx.2])
  rw [Real.cos_pi_div_three] at hcos
  have hmul := mul_le_mul_of_nonneg_left hx.2 Real.pi_pos.le
  have hpi : Real.pi ^ 2 < 10 := by nlinarith [Real.pi_pos, Real.pi_lt_d2]
  nlinarith

theorem physicalAngleValue_strictMonoOn :
    StrictMonoOn physicalAngleValue (Set.Ioc 0 (Real.pi / 6)) := by
  apply strictMonoOn_of_deriv_pos (convex_Ioc _ _) ?_ ?_
  · intro x hx
    exact (physicalAngleValue_hasDerivAt hx.1.ne').continuousAt.continuousWithinAt
  · intro x hx
    exact physicalAngleValue_deriv_pos (interior_subset hx)

theorem physicalThreshold_eq_angle {n : ℕ} (hn : 2 ≤ n) :
    physicalThreshold n = physicalAngleValue (Real.pi / (4 * (n : ℝ) - 2)) := by
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hd : 4 * (n : ℝ) - 2 ≠ 0 := by linarith
  unfold physicalThreshold physicalAngleValue
  field_simp [hd, Real.pi_ne_zero]
  ring

theorem sampling_angle_mem {n : ℕ} (hn : 2 ≤ n) :
    Real.pi / (4 * (n : ℝ) - 2) ∈ Set.Ioc 0 (Real.pi / 6) := by
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hd : 0 < 4 * (n : ℝ) - 2 := by linarith
  refine ⟨div_pos Real.pi_pos hd, ?_⟩
  apply (div_le_div_iff₀ hd (by norm_num : (0 : ℝ) < 6)).2
  nlinarith [Real.pi_pos]

theorem physicalThreshold_strictAntiOn :
    StrictAntiOn physicalThreshold (Set.Ici 2) := by
  intro m hm n hn hmn
  have hm' : (2 : ℝ) ≤ m := by exact_mod_cast hm
  have hmn' : (m : ℝ) < n := by exact_mod_cast hmn
  rw [physicalThreshold_eq_angle hm, physicalThreshold_eq_angle hn]
  apply physicalAngleValue_strictMonoOn (sampling_angle_mem hn) (sampling_angle_mem hm)
  apply (div_lt_div_iff₀ (by linarith) (by linarith)).2
  nlinarith [Real.pi_pos]

@[simp] theorem physicalThreshold_two : physicalThreshold 2 = 2 := by
  norm_num [physicalThreshold, Real.sin_pi_div_six]

theorem physicalThreshold_le_two {n : ℕ} (hn : 2 ≤ n) : physicalThreshold n ≤ 2 := by
  simpa using physicalThreshold_strictAntiOn.antitoneOn (by simp : (2 : ℕ) ∈ Set.Ici 2) hn hn

theorem physicalThreshold_tendsto :
    Tendsto physicalThreshold atTop (𝓝 (Real.pi / 2)) := by
  have hcast : Tendsto (fun n : ℕ => (n : ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hden : Tendsto (fun n : ℕ => 4 * (n : ℝ) - 2) atTop atTop := by
    simpa [sub_eq_add_neg] using tendsto_atTop_add_const_right atTop (-2 : ℝ)
      (hcast.const_mul_atTop (by norm_num : (0 : ℝ) < 4))
  have hang : Tendsto (fun n : ℕ => Real.pi / (4 * (n : ℝ) - 2)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop hden
  have hs : ContinuousAt (dslope Real.sin 0) 0 :=
    continuousAt_dslope_same.2 (Real.hasDerivAt_sin 0).differentiableAt
  have hconst : Tendsto (fun _ : ℕ => Real.pi / 2) atTop (𝓝 (Real.pi / 2)) :=
    tendsto_const_nhds
  have hlim := (hconst.add hang).mul (hs.tendsto.comp hang)
  have hlim' : Tendsto
      (fun n : ℕ => (Real.pi / 2 + Real.pi / (4 * (n : ℝ) - 2)) *
        dslope Real.sin 0 (Real.pi / (4 * (n : ℝ) - 2))) atTop (𝓝 (Real.pi / 2)) := by
    simpa [dslope_same, (Real.hasDerivAt_sin 0).deriv] using hlim
  apply hlim'.congr'
  filter_upwards [eventually_ge_atTop (2 : ℕ)] with n hn
  have hx := (sampling_angle_mem hn).1
  rw [dslope_of_ne _ hx.ne']
  simp only [slope_def_field, Real.sin_zero, sub_zero]
  unfold physicalThreshold
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hd : 4 * (n : ℝ) - 2 ≠ 0 := by linarith
  field_simp [hd, Real.pi_ne_zero]
  ring

end C2.IntegratorDelay

end

/- ===== C2.IntegratorDelayOptimum ===== -/

noncomputable section
namespace C2.IntegratorDelay

def criticalGain (n : ℕ) (γ : ℝ) : ℝ :=
  boundaryGain n (frequency n (2 * γ - 1))

theorem frequency_one {n : ℕ} (hn : 2 ≤ n) :
    frequency n 1 = upperFrequency n := by
  have hf := frequency_spec hn (x := 1) (by norm_num) (by norm_num)
  have hm : upperFrequency n ∈ Set.Icc (lowerFrequency n) (upperFrequency n) :=
    ⟨frequency_interval_order hn, le_rfl⟩
  have hb := frequency_bounds hn hm
  have he : lowPhase n 1 (upperFrequency n) = Real.pi / 2 := by
    unfold lowPhase
    rw [one_mul, Real.arctan_tan (by linarith [hb.1, Real.pi_pos])
      (by linarith [hb.2.1, Real.pi_pos])]
    unfold upperFrequency
    have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
    have hd : 2 * (n : ℝ) - 1 ≠ 0 := by linarith
    field_simp
    ring
  obtain ⟨w, hw, hu⟩ := existsUnique_low_frequency hn (x := 1) (by norm_num) (by norm_num)
  exact (hu _ hf).trans (hu _ ⟨hm, he⟩).symm

theorem criticalGain_pos {n : ℕ} (hn : 2 ≤ n) {γ : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) : 0 < criticalGain n γ := by
  have hf := frequency_spec hn (x := 2 * γ - 1) (by linarith) (by linarith)
  obtain ⟨hw0, hwpi, hnw0, hnwpi, _⟩ := frequency_bounds hn hf.1
  unfold criticalGain boundaryGain
  exact mul_pos (mul_pos (by norm_num)
    (Real.tan_pos_of_pos_of_lt_pi_div_two (by linarith) (by linarith [Real.pi_pos])))
    (Real.sin_pos_of_pos_of_lt_pi hnw0 hnwpi)

theorem criticalGain_strictMonoOn {n : ℕ} (hn : 2 ≤ n) :
    StrictMonoOn (criticalGain n) (Set.Icc 0 1) := by
  intro γ hγ δ hδ hlt
  have hx : 2 * γ - 1 ∈ Set.Icc (-1) 1 := by constructor <;> linarith [hγ.1, hγ.2]
  have hy : 2 * δ - 1 ∈ Set.Icc (-1) 1 := by constructor <;> linarith [hδ.1, hδ.2]
  exact boundaryGain_strictMonoOn hn
    (frequency_spec hn hx.1 hx.2).1 (frequency_spec hn hy.1 hy.2).1
    (frequency_strictMonoOn hn hx hy (by linarith))

theorem boundaryGain_upper {n : ℕ} (hn : 2 ≤ n) :
    boundaryGain n (upperFrequency n) = 2 * Real.sin (Real.pi / (4 * (n : ℝ) - 2)) := by
  have hm : upperFrequency n ∈ Set.Icc (lowerFrequency n) (upperFrequency n) :=
    ⟨frequency_interval_order hn, le_rfl⟩
  have hb := frequency_bounds hn hm
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hd : 2 * (n : ℝ) - 1 ≠ 0 := by linarith
  have he : (n : ℝ) * upperFrequency n = Real.pi / 2 + upperFrequency n / 2 := by
    unfold upperFrequency
    field_simp
    ring
  have hhalf : upperFrequency n / 2 = Real.pi / (4 * (n : ℝ) - 2) := by
    unfold upperFrequency
    rw [show 4 * (n : ℝ) - 2 = (2 * (n : ℝ) - 1) * 2 by ring,
      div_mul_eq_div_div]
  have hc : Real.cos (upperFrequency n / 2) ≠ 0 :=
    (Real.cos_pos_of_mem_Ioo
      ⟨by linarith [hb.1, Real.pi_pos], by linarith [hb.2.1, Real.pi_pos]⟩).ne'
  unfold boundaryGain
  rw [he, Real.sin_add, Real.sin_pi_div_two, Real.cos_pi_div_two]
  simp only [one_mul, zero_mul, add_zero, Real.tan_eq_sin_div_cos]
  rw [← hhalf]
  field_simp

theorem criticalGain_one {n : ℕ} (hn : 2 ≤ n) :
    criticalGain n 1 = 2 * Real.sin (Real.pi / (4 * (n : ℝ) - 2)) := by
  norm_num only [criticalGain, mul_one, show (2 : ℝ) - 1 = 1 by norm_num]
  rw [frequency_one hn, boundaryGain_upper hn]

theorem criticalGain_unique_max {n : ℕ} (hn : 2 ≤ n) {γ : ℝ}
    (hγ : γ ∈ Set.Icc 0 1) :
    criticalGain n γ ≤ criticalGain n 1 ∧
      (criticalGain n γ = criticalGain n 1 ↔ γ = 1) := by
  have h1 : (1 : ℝ) ∈ Set.Icc 0 1 := by norm_num
  exact ⟨(criticalGain_strictMonoOn hn).monotoneOn hγ h1 hγ.2,
    ⟨(criticalGain_strictMonoOn hn).injOn hγ h1, fun h => by rw [h]⟩⟩

theorem physicalThreshold_eq_criticalGain {n : ℕ} (hn : 2 ≤ n) :
    physicalThreshold n = (n : ℝ) * criticalGain n 1 := by
  rw [criticalGain_one hn]
  unfold physicalThreshold
  ring

/-- A nonpositive gain has an actual real root at or beyond one. -/
theorem exists_exterior_real_root_of_nonpos_gain {n : ℕ} (hn : 1 ≤ n)
    {γ a : ℝ} (hγ : γ ≤ 1) (ha : a ≤ 0) :
    ∃ r : ℝ, 1 ≤ r ∧ characteristic n γ a (r : ℂ) = 0 := by
  let R : ℝ := 1 - a
  let f : ℝ → ℝ := fun r => r ^ n * (r - 1) + a * (γ * r + 1 - γ)
  have hR : 1 ≤ R := by dsimp [R]; linarith
  have hpow : R ≤ R ^ n := le_self_pow₀ hR (by omega)
  have hq : γ * R + 1 - γ ≤ R := by nlinarith
  have hprod : 0 ≤ (-a) * (R ^ n - (γ * R + 1 - γ)) :=
    mul_nonneg (by linarith) (by linarith)
  have hfR : 0 ≤ f R := by
    have he : f R = (-a) * (R ^ n - (γ * R + 1 - γ)) := by dsimp [f, R]; ring
    rw [he]
    exact hprod
  have hf1 : f 1 ≤ 0 := by simpa [f] using ha
  have hcont : ContinuousOn f (Set.Icc 1 R) := (by fun_prop : Continuous f).continuousOn
  obtain ⟨r, hr, he⟩ := intermediate_value_Icc hR hcont ⟨hf1, hfR⟩
  refine ⟨r, hr.1, ?_⟩
  have hc : characteristic n γ a (r : ℂ) = (f r : ℝ) := by
    simp only [characteristic, f]
    push_cast
    ring
  rw [hc, he, Complex.ofReal_zero]

theorem stable_gain_pos {n : ℕ} (hn : 1 ≤ n) {γ a : ℝ}
    (hγ : γ ≤ 1) (hs : Stable n γ a) : 0 < a := by
  by_contra! ha
  obtain ⟨r, hr, he⟩ := exists_exterior_real_root_of_nonpos_gain hn hγ ha
  have h := hs (r : ℂ) he
  have hrnorm : 1 ≤ ‖(r : ℂ)‖ := by
    simpa only [Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (show 0 ≤ r by linarith)] using hr
  exact (not_lt_of_ge hrnorm) h

end C2.IntegratorDelay

end

/- ===== C2.IntegratorDelayRegion ===== -/

noncomputable section
namespace C2.IntegratorDelay
open NGamma.PolynomialModel NGamma.Cayley

def criticalCayleyPoint (n : ℕ) (x : ℝ) : ℝ := Real.tan (frequency n x / 2)

theorem criticalCayleyPoint_pos {n : ℕ} (hn : 2 ≤ n) {x : ℝ}
    (hx0 : -1 ≤ x) (hx1 : x ≤ 1) : 0 < criticalCayleyPoint n x := by
  have hb := frequency_bounds hn (frequency_spec hn hx0 hx1).1
  exact Real.tan_pos_of_pos_of_lt_pi_div_two (by linarith [hb.1])
    (by linarith [hb.2.1, Real.pi_pos])

theorem criticalCayleyPoint_angle {n : ℕ} (hn : 2 ≤ n) {x : ℝ}
    (hx0 : -1 ≤ x) (hx1 : x ≤ 1) :
    2 * Real.arctan (criticalCayleyPoint n x) = frequency n x := by
  have hb := frequency_bounds hn (frequency_spec hn hx0 hx1).1
  unfold criticalCayleyPoint
  rw [Real.arctan_tan (by linarith [hb.1, Real.pi_pos]) (by linarith [hb.2.1, Real.pi_pos])]
  ring

theorem criticalCayleyPoint_phase {n : ℕ} (hn : 2 ≤ n) {x : ℝ}
    (hx0 : -1 ≤ x) (hx1 : x ≤ 1) :
    totalPhase n x (criticalCayleyPoint n x) = Real.pi := by
  rw [totalPhase_eq_lowPhase, criticalCayleyPoint_angle hn hx0 hx1,
    (frequency_spec hn hx0 hx1).2]
  ring

theorem criticalCayleyPoint_amplitude {n : ℕ} (hn : 2 ≤ n) {x : ℝ}
    (hx0 : -1 ≤ x) (hx1 : x ≤ 1) :
    amplitude x (criticalCayleyPoint n x) = boundaryGain n (frequency n x) := by
  have hf := (frequency_spec hn hx0 hx1).2
  have hat : Real.arctan (x * Real.tan (frequency n x / 2)) =
      (n : ℝ) * frequency n x - Real.pi / 2 := by
    unfold lowPhase at hf
    linarith
  have hs : 1 / Real.sqrt (1 + (x * Real.tan (frequency n x / 2)) ^ 2) =
      Real.sin ((n : ℝ) * frequency n x) := by
    rw [← Real.cos_arctan, hat, Real.cos_sub, Real.cos_pi_div_two, Real.sin_pi_div_two]
    ring
  unfold amplitude criticalCayleyPoint boundaryGain
  rw [div_eq_mul_inv, ← one_div, hs]

theorem poly_eval_characteristic (n : ℕ) (γ a : ℝ) (z : ℂ) :
    (poly n (2 * γ - 1) a).eval z = characteristic n γ a z := by
  rw [poly_eval, q_eval]
  unfold characteristic
  push_cast
  ring

theorem stable_iff_poly (n : ℕ) (γ a : ℝ) :
    Stable n γ a ↔ SchurStable (poly n (2 * γ - 1) a) := by
  simp only [Stable, SchurStable, poly_eval_characteristic]

theorem positive_gain_exact_region {n : ℕ} (hn : 2 ≤ n) {γ a : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) (ha : 0 < a) :
    Stable n γ a ↔ a < criticalGain n γ := by
  let x : ℝ := 2 * γ - 1
  have hx0 : -1 ≤ x := by dsimp [x]; linarith
  have hx1 : x ≤ 1 := by dsimp [x]; linarith
  have htstar := criticalCayleyPoint_pos hn hx0 hx1
  have hcrit : amplitude x (criticalCayleyPoint n x) = criticalGain n γ :=
    criticalCayleyPoint_amplitude hn hx0 hx1
  rw [stable_iff_poly]
  change SchurStable (poly n x a) ↔ a < criticalGain n γ
  by_cases hbound : a * |x| < 2
  · let tb := amplitudeCrossing x a
    have htb : 0 < tb := amplitudeCrossing_pos ha hbound
    have hBeq : amplitude x tb = a := amplitude_at_crossing ha hbound
    have hangle : (2 * Real.arctan tb < frequency n x) ↔ tb < criticalCayleyPoint n x := by
      rw [← criticalCayleyPoint_angle hn hx0 hx1]
      have h := Real.arctan_strictMono.lt_iff_lt (a := tb) (b := criticalCayleyPoint n x)
      constructor
      · intro hh
        apply h.mp
        linarith
      · intro hh
        have := h.mpr hh
        linarith
    calc
      SchurStable (poly n x a) ↔ totalPhase n x tb < Real.pi :=
        integrator_schur_iff_phase hn hx1 ha htb hBeq hbound
      _ ↔ 2 * Real.arctan tb < frequency n x := totalPhase_lt_pi_iff hn hx0 hx1 htb
      _ ↔ tb < criticalCayleyPoint n x := hangle
      _ ↔ a < criticalGain n γ := by
        rw [← hBeq, ← hcrit]
        exact ((amplitude_strictMonoOn x).lt_iff_lt htb.le htstar.le).symm
  · have hhigh : 2 ≤ a * |x| := le_of_not_gt hbound
    have hcritbound := amplitude_endpoint_bound x htstar.le
    rw [hcrit] at hcritbound
    have hnot : ¬ a < criticalGain n γ := by
      intro hh
      have hm := mul_le_mul_of_nonneg_right hh.le (abs_nonneg x)
      linarith
    exact iff_of_false (not_schur_of_high_gain (by omega) ha hhigh) hnot

/-- `thm:general`, with actual complex roots and every real gain. -/
theorem complete_region {n : ℕ} (hn : 2 ≤ n) {γ a : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    Stable n γ a ↔ 0 < a ∧ a < criticalGain n γ := by
  constructor
  · intro hs
    have ha := stable_gain_pos (by omega) hγ1 hs
    exact ⟨ha, (positive_gain_exact_region hn hγ0 hγ1 ha).1 hs⟩
  · rintro ⟨ha, hlt⟩
    exact (positive_gain_exact_region hn hγ0 hγ1 ha).2 hlt

theorem criticalGain_isLUB {n : ℕ} (hn : 2 ≤ n) {γ : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    IsLUB {a : ℝ | Stable n γ a} (criticalGain n γ) := by
  have he : {a : ℝ | Stable n γ a} = Set.Ioo 0 (criticalGain n γ) := by
    ext a
    exact complete_region hn hγ0 hγ1
  rw [he]
  exact isLUB_Ioo (criticalGain_pos hn hγ0 hγ1)

theorem criticalGain_boundary_root {n : ℕ} (hn : 2 ≤ n) {γ : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    ∃ z : ℂ, ‖z‖ = 1 ∧ characteristic n γ (criticalGain n γ) z = 0 := by
  let x := 2 * γ - 1
  have hx0 : -1 ≤ x := by dsimp [x]; linarith
  have hx1 : x ≤ 1 := by dsimp [x]; linarith
  let t := criticalCayleyPoint n x
  have ht : 0 < t := criticalCayleyPoint_pos hn hx0 hx1
  have hB : amplitude x t = criticalGain n γ := criticalCayleyPoint_amplitude hn hx0 hx1
  have hp : totalPhase n x t = Real.pi := criticalCayleyPoint_phase hn hx0 hx1
  refine ⟨point t, point_norm t, ?_⟩
  rw [← poly_eval_characteristic, poly_eval_point, transfer_polar n x t ht.le, hB, hp,
    Complex.exp_pi_mul_I]
  ring

/-- The unique maximizing integration parameter, formulated using the actual
least upper bound of stable gains rather than defining a margin by a formula. -/
theorem maximizing_parameter_iff {n : ℕ} (hn : 2 ≤ n) {γ : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    IsLUB {a : ℝ | Stable n γ a}
      (2 * Real.sin (Real.pi / (4 * (n : ℝ) - 2))) ↔ γ = 1 := by
  rw [← criticalGain_one hn]
  constructor
  · intro hs
    have he := (criticalGain_isLUB hn hγ0 hγ1).unique hs
    exact (criticalGain_unique_max hn ⟨hγ0, hγ1⟩).2.mp he
  · rintro rfl
    exact criticalGain_isLUB hn (by norm_num) (by norm_num)

end C2.IntegratorDelay

end

/- ===== C2.IntegratorDelayGlobal ===== -/

noncomputable section
namespace C2.IntegratorDelay

theorem one_characteristic (γ a : ℝ) (z : ℂ) :
    characteristic 1 γ a z =
      (1 : ℂ) * z ^ 2 + (-1 + a * γ : ℝ) * z + (a * (1 - γ) : ℝ) := by
  simp only [characteristic, pow_one]
  push_cast
  ring

theorem one_stable_iff_firstOrder {γ a : ℝ} (hγ : γ ≤ 1) :
    Stable 1 γ a ↔ FirstOrder.Stable 0 γ a := by
  have hq : Stable 1 γ a ↔ C2.QuadraticSchur 1 (-1 + a * γ) (a * (1 - γ)) := by
    simp only [Stable, C2.QuadraticSchur, one_characteristic, Complex.ofReal_one]
  unfold FirstOrder.Stable
  simp only [zero_mul, add_zero, zero_add]
  constructor
  · intro hs
    exact ⟨stable_gain_pos (by norm_num) hγ hs, hq.mp hs⟩
  · rintro ⟨_, hs⟩
    exact hq.mpr hs

theorem one_optimal_stable_iff {a : ℝ} :
    Stable 1 (3 / 4) a ↔ 0 < a ∧ a < 4 := by
  rw [one_stable_iff_firstOrder (by norm_num)]
  exact FirstOrder.integrator_stable_optimum_iff

theorem one_stable_gain_bound {γ a : ℝ} (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1)
    (hs : Stable 1 γ a) : a < 4 := by
  have h := FirstOrder.stable_global_gain_bound (by norm_num : (0 : ℝ) ≤ 0)
    hγ0 ((one_stable_iff_firstOrder hγ1).mp hs)
  simpa only [FirstOrder.integrator_aStar] using h

theorem one_maximizing_parameter_iff {γ : ℝ} (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    IsLUB {a : ℝ | Stable 1 γ a} 4 ↔ γ = 3 / 4 := by
  have he : {a : ℝ | Stable 1 γ a} = {a : ℝ | FirstOrder.Stable 0 γ a} := by
    ext a
    exact one_stable_iff_firstOrder hγ1
  rw [he]
  simpa only [FirstOrder.integrator_aStar, FirstOrder.integrator_γStar] using
    FirstOrder.stable_maximizing_parameter_iff (by norm_num : (0 : ℝ) ≤ 0) hγ0

def PhysicalStable (n : ℕ) (γ α : ℝ) : Prop :=
  ∃ a : ℝ, Stable n γ a ∧ α = (n : ℝ) * a

theorem fine_physical_region {n : ℕ} (hn : 2 ≤ n) {γ α : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    PhysicalStable n γ α ↔ 0 < α ∧ α < (n : ℝ) * criticalGain n γ := by
  have hn0 : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  constructor
  · rintro ⟨a, hs, rfl⟩
    have ha := (complete_region hn hγ0 hγ1).mp hs
    exact ⟨mul_pos hn0 ha.1, mul_lt_mul_of_pos_left ha.2 hn0⟩
  · rintro ⟨hα0, hα1⟩
    refine ⟨α / n, (complete_region hn hγ0 hγ1).mpr ⟨div_pos hα0 hn0, ?_⟩, ?_⟩
    · exact (div_lt_iff₀ hn0).mpr (by simpa [mul_comm] using hα1)
    · field_simp

theorem fine_physicalThreshold_isLUB {n : ℕ} (hn : 2 ≤ n) :
    IsLUB {α : ℝ | PhysicalStable n 1 α} (physicalThreshold n) := by
  have he : {α : ℝ | PhysicalStable n 1 α} = Set.Ioo 0 (physicalThreshold n) := by
    ext α
    change PhysicalStable n 1 α ↔ 0 < α ∧ α < physicalThreshold n
    rw [fine_physical_region hn (by norm_num) (by norm_num), physicalThreshold_eq_criticalGain hn]
  rw [he]
  apply isLUB_Ioo
  rw [physicalThreshold_eq_criticalGain hn]
  exact mul_pos (by exact_mod_cast (show 0 < n by omega))
    (criticalGain_pos hn (by norm_num) (by norm_num))

theorem fine_physical_gain_lt_two {n : ℕ} (hn : 2 ≤ n) {γ α : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) (hs : PhysicalStable n γ α) : α < 2 := by
  have h := (fine_physical_region hn hγ0 hγ1).mp hs
  have hmax := (criticalGain_unique_max hn ⟨hγ0, hγ1⟩).1
  have hmul := mul_le_mul_of_nonneg_left hmax (Nat.cast_nonneg n : (0 : ℝ) ≤ n)
  rw [← physicalThreshold_eq_criticalGain hn] at hmul
  exact lt_of_lt_of_le h.2 (hmul.trans (physicalThreshold_le_two hn))

theorem one_physical_iff (γ α : ℝ) : PhysicalStable 1 γ α ↔ Stable 1 γ α := by
  constructor
  · rintro ⟨a, ha, he⟩
    have h : α = a := by simpa using he
    simpa only [h] using ha
  · intro h
    exact ⟨α, h, by simp⟩

/-- The union over every positive integer delay resolution is the exact
physical-gain interval `(0,4)`. -/
theorem physical_gain_projection {α : ℝ} :
    (∃ n : ℕ, 1 ≤ n ∧ ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ PhysicalStable n γ α) ↔
      0 < α ∧ α < 4 := by
  constructor
  · rintro ⟨n, hn, γ, hγ0, hγ1, hs⟩
    have hα : 0 < α := by
      obtain ⟨a, ha, rfl⟩ := hs
      exact mul_pos (by exact_mod_cast (show 0 < n by omega)) (stable_gain_pos hn hγ1 ha)
    refine ⟨hα, ?_⟩
    by_cases hn1 : n = 1
    · subst n
      exact one_stable_gain_bound hγ0 hγ1 ((one_physical_iff γ α).mp hs)
    · have h := fine_physical_gain_lt_two (by omega : 2 ≤ n) hγ0 hγ1 hs
      linarith
  · intro h
    exact ⟨1, by norm_num, 3 / 4, by norm_num, by norm_num,
      (one_physical_iff _ _).mpr (one_optimal_stable_iff.mpr h)⟩

theorem global_physical_gain_isLUB :
    IsLUB {α : ℝ | ∃ n : ℕ, 1 ≤ n ∧ ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ PhysicalStable n γ α} 4 := by
  have he : {α : ℝ | ∃ n : ℕ, 1 ≤ n ∧ ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ PhysicalStable n γ α} =
      Set.Ioo 0 4 := by ext α; exact physical_gain_projection
  rw [he]
  exact isLUB_Ioo (by norm_num)

/-- `cor:global`: uniqueness over both the delay resolution and integration weight. -/
theorem global_physical_maximizer_iff {n : ℕ} (hn : 1 ≤ n) {γ : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    IsLUB {α : ℝ | PhysicalStable n γ α} 4 ↔ n = 1 ∧ γ = 3 / 4 := by
  by_cases hn1 : n = 1
  · subst n
    have he : {α : ℝ | PhysicalStable 1 γ α} = {a : ℝ | Stable 1 γ a} := by
      ext α; exact one_physical_iff γ α
    rw [he, one_maximizing_parameter_iff hγ0 hγ1]
    simp
  · have hbad : ¬ IsLUB {α : ℝ | PhysicalStable n γ α} 4 := by
      intro h
      have hu : (2 : ℝ) ∈ upperBounds {α : ℝ | PhysicalStable n γ α} := by
        intro α hα
        exact (fine_physical_gain_lt_two (by omega : 2 ≤ n) hγ0 hγ1 hα).le
      have hh := h.2 hu
      norm_num at hh
    simp only [hbad, hn1, false_and]

theorem physical_controller_gain_projection {K τ k : ℝ} (hK : 0 < K) (hτ : 0 < τ) :
    (∃ n : ℕ, 1 ≤ n ∧ ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ PhysicalStable n γ (K * τ * k)) ↔
      0 < k ∧ k < 4 / (K * τ) := by
  rw [physical_gain_projection]
  have hc : 0 < K * τ := mul_pos hK hτ
  rw [mul_pos_iff_of_pos_left hc]
  constructor
  · rintro ⟨hk, h⟩
    exact ⟨hk, (lt_div_iff₀ hc).mpr (by simpa [mul_comm] using h)⟩
  · rintro ⟨hk, h⟩
    exact ⟨hk, by simpa [mul_comm] using (lt_div_iff₀ hc).mp h⟩

end C2.IntegratorDelay

end

/- ===== C2.IntegratorDelayManuscript ===== -/

noncomputable section
namespace C2.IntegratorDelay
open NGamma.PolynomialModel NGamma.Cayley

def chordPhase (γ w : ℝ) : ℝ :=
  Complex.arg ((1 - (γ : ℂ)) + (γ : ℂ) * Complex.exp ((w : ℂ) * Complex.I))

theorem chordPhase_eq_centered {γ w : ℝ} (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1)
    (hw0 : 0 ≤ w) (hwpi : w < Real.pi) :
    chordPhase γ w = w / 2 + Real.arctan ((2 * γ - 1) * Real.tan (w / 2)) := by
  let x := 2 * γ - 1
  let t := Real.tan (w / 2)
  have ht : 0 ≤ t := Real.tan_nonneg_of_nonneg_of_le_pi_div_two (by linarith) (by linarith)
  have hat : Real.arctan t = w / 2 :=
    Real.arctan_tan (by linarith [Real.pi_pos]) (by linarith)
  have hx0 : -1 ≤ x := by dsimp [x]; linarith
  have hx1 : x ≤ 1 := by dsimp [x]; linarith
  have hleft : -t ≤ x * t := by nlinarith
  have hright : x * t ≤ t := by nlinarith
  have halo := Real.arctan_le_arctan hleft
  have hahi := Real.arctan_le_arctan hright
  rw [Real.arctan_neg, hat] at halo
  rw [hat] at hahi
  have hangle : qPhase x t ∈ Set.Ioc (-Real.pi) Real.pi := by
    unfold qPhase
    rw [hat]
    constructor <;> linarith [Real.pi_pos]
  have hpoint : point t = Complex.exp ((w : ℂ) * Complex.I) := by
    rw [point_exp, hat]
    congr 2
    ring
  have hq : (q x).eval (point t) = (1 - (γ : ℂ)) +
      (γ : ℂ) * Complex.exp ((w : ℂ) * Complex.I) := by
    rw [q_eval, hpoint]
    dsimp [x]
    push_cast
    ring
  have harg : Complex.arg ((q x).eval (point t)) = qPhase x t := by
    rw [q_polar, Complex.exp_mul_I]
    exact Complex.arg_mul_cos_add_sin_mul_I (qAmplitude_pos x t) hangle
  rw [hq] at harg
  simpa only [chordPhase, qPhase, hat, x, t] using harg

theorem manuscript_phase_eq_lowPhase {n : ℕ} {γ w : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) (hw0 : 0 ≤ w) (hwpi : w < Real.pi) :
    ((n : ℝ) + 1 / 2) * w - chordPhase γ w = lowPhase n (2 * γ - 1) w := by
  rw [chordPhase_eq_centered hγ0 hγ1 hw0 hwpi]
  unfold lowPhase
  ring

/-- The exact phase equation as printed in `lem:phase`, with the chord's
actual principal complex argument. -/
theorem existsUnique_manuscript_frequency {n : ℕ} (hn : 2 ≤ n) {γ : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    ∃! w : ℝ, w ∈ Set.Icc (lowerFrequency n) (upperFrequency n) ∧
      ((n : ℝ) + 1 / 2) * w - chordPhase γ w = Real.pi / 2 := by
  have hx0 : -1 ≤ 2 * γ - 1 := by linarith
  have hx1 : 2 * γ - 1 ≤ 1 := by linarith
  have he (w : ℝ) (hw : w ∈ Set.Icc (lowerFrequency n) (upperFrequency n)) :
      ((n : ℝ) + 1 / 2) * w - chordPhase γ w = lowPhase n (2 * γ - 1) w := by
    have hb := frequency_bounds hn hw
    exact manuscript_phase_eq_lowPhase hγ0 hγ1 hb.1.le (by linarith [hb.2.1, Real.pi_pos])
  obtain ⟨w, hw, hu⟩ := existsUnique_low_frequency hn hx0 hx1
  refine ⟨w, ⟨hw.1, ?_⟩, ?_⟩
  · rw [he w hw.1]
    exact hw.2
  · intro v hv
    apply hu v
    refine ⟨hv.1, ?_⟩
    rw [← he v hv.1]
    exact hv.2

theorem manuscript_frequency_strictMonoOn {n : ℕ} (hn : 2 ≤ n) :
    StrictMonoOn (fun γ : ℝ => frequency n (2 * γ - 1)) (Set.Icc 0 1) := by
  intro γ hγ δ hδ hlt
  exact frequency_strictMonoOn hn
    ⟨by linarith [hγ.1], by linarith [hγ.2]⟩
    ⟨by linarith [hδ.1], by linarith [hδ.2]⟩ (by linarith)

end C2.IntegratorDelay

end

/- ===== C2.IntegratorDelayOutward ===== -/

/-! Algebraic transversality for unit roots of the delayed integrator.
The constant-term restriction is used only as an explicit strict inequality.
All norm and logarithmic-derivative identities concern the actual complex
characteristic, not a surrogate stability predicate. -/

noncomputable section
namespace C2.IntegratorDelay

def feedback (γ : ℝ) (z : ℂ) : ℂ := (γ : ℂ) * z + 1 - γ

def logSlope (n : ℕ) (γ : ℝ) (z : ℂ) : ℂ :=
  n + z / (z - 1) - (γ : ℂ) * z / feedback γ z

theorem unit_feedback_norm {γ : ℝ} {z : ℂ} (hz : ‖z‖ = 1) :
    Complex.normSq (feedback γ z) =
      γ ^ 2 + (1 - γ) ^ 2 + 2 * γ * (1 - γ) * z.re := by
  have hu : z.re ^ 2 + z.im ^ 2 = 1 := by
    have h := Complex.sq_norm z
    rw [hz, Complex.normSq_apply] at h
    nlinarith
  simp only [feedback, Complex.normSq_apply, Complex.add_re, Complex.sub_re,
    Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.one_re,
    Complex.add_im, Complex.sub_im, Complex.mul_im, Complex.one_im]
  linear_combination γ ^ 2 * hu

theorem unit_feedback_norm_lower {γ : ℝ} {z : ℂ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) (hz : ‖z‖ = 1) :
    (2 * γ - 1) ^ 2 ≤ Complex.normSq (feedback γ z) := by
  have hx : -1 ≤ z.re := by
    have h : |z.re| ≤ 1 := by simpa [hz] using Complex.abs_re_le_norm z
    exact (abs_le.mp h).1
  rw [unit_feedback_norm hz]
  nlinarith [mul_nonneg (mul_nonneg hγ0 (show 0 ≤ 1 - γ by linarith))
    (show 0 ≤ z.re + 1 by linarith)]

theorem unit_root_feedback_ne_zero {n : ℕ} {γ a : ℝ} {z : ℂ}
    (ha : 0 < a) (hz : ‖z‖ = 1) (hp : characteristic n γ a z = 0) :
    z ≠ 1 ∧ feedback γ z ≠ 0 := by
  have hz0 : z ≠ 0 := by intro h; simpa [h] using hz
  have hz1 : z ≠ 1 := by
    intro h
    subst z
    simp only [characteristic, one_pow, sub_self, mul_zero, mul_one,
      add_sub_cancel_left, mul_one, zero_add] at hp
    have : a = 0 := by exact_mod_cast hp
    linarith
  refine ⟨hz1, ?_⟩
  intro hq
  have h : z ^ n * (z - 1) = 0 := by
    change z ^ n * (z - 1) + (a : ℂ) * feedback γ z = 0 at hp
    simpa only [hq, mul_zero, add_zero] using hp
  exact (mul_ne_zero (pow_ne_zero n hz0) (sub_ne_zero.mpr hz1)) h

theorem unit_root_norm_identity {n : ℕ} {γ a : ℝ} {z : ℂ}
    (hz : ‖z‖ = 1) (hp : characteristic n γ a z = 0) :
    Complex.normSq (feedback γ z) * (1 + a ^ 2 * γ * (1 - γ)) = 1 := by
  have hu : Complex.normSq z = 1 := by rw [Complex.normSq_eq_norm_sq, hz]; norm_num
  have he : z ^ n * (z - 1) = -(a : ℂ) * feedback γ z := by
    unfold characteristic at hp
    unfold feedback
    linear_combination hp
  have hn := congrArg Complex.normSq he
  simp only [map_mul, map_pow, hu, one_pow, one_mul, Complex.normSq_neg,
    Complex.normSq_ofReal, Complex.normSq_sub, Complex.normSq_one,
    map_one, mul_one] at hn
  have hR := unit_feedback_norm (γ := γ) hz
  linear_combination hR - γ * (1 - γ) * hn

/-- A sharpened scalar form of the constant-term barrier argument. -/
theorem constant_term_barrier {γ a R : ℝ} (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1)
    (ha : 0 < a) (hc : a * (1 - γ) < 1) (hR : 0 < R)
    (hlower : (2 * γ - 1) ^ 2 ≤ R)
    (heq : R * (1 + a ^ 2 * γ * (1 - γ)) = 1) :
    2 * γ - 1 < 2 * R := by
  by_cases ht : 2 * γ - 1 ≤ 0
  · linarith
  have hγ : 0 < γ := by linarith
  have hc0 : 0 ≤ a * (1 - γ) := mul_nonneg ha.le (by linarith)
  have hc2 : (a * (1 - γ)) ^ 2 < 1 := by nlinarith
  have he : 1 - γ = R * (1 - γ) + R * γ * (a * (1 - γ)) ^ 2 := by
    linear_combination -(1 - γ) * heq
  have hmul := mul_lt_mul_of_pos_left hc2 (mul_pos hR hγ)
  have hRlower : 1 - γ < R := by nlinarith
  by_contra! hbad
  have htpos : 0 < 2 * γ - 1 := by linarith
  have hthalf : 0 < (2 * γ - 1) - 1 / 2 := by linarith
  have hprod := mul_pos htpos hthalf
  nlinarith

theorem unit_div_sub_one_re {z : ℂ} (hz : ‖z‖ = 1) (hne : z ≠ 1) :
    (z / (z - 1)).re = 1 / 2 := by
  have hu : z.re ^ 2 + z.im ^ 2 = 1 := by
    have h := Complex.sq_norm z
    rw [hz, Complex.normSq_apply] at h
    nlinarith
  have hd : Complex.normSq (z - 1) ≠ 0 :=
    (Complex.normSq_pos.mpr (sub_ne_zero.mpr hne)).ne'
  rw [Complex.div_re, ← add_div]
  apply (div_eq_iff hd).2
  simp only [Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im,
    Complex.normSq_apply]
  nlinarith

theorem unit_feedback_div_re {γ : ℝ} {z : ℂ} (hz : ‖z‖ = 1)
    (hq : feedback γ z ≠ 0) :
    ((γ : ℂ) * z / feedback γ z).re =
      1 / 2 + (2 * γ - 1) / (2 * Complex.normSq (feedback γ z)) := by
  have hu : z.re ^ 2 + z.im ^ 2 = 1 := by
    have h := Complex.sq_norm z
    rw [hz, Complex.normSq_apply] at h
    nlinarith
  have hd : Complex.normSq (feedback γ z) ≠ 0 := (Complex.normSq_pos.mpr hq).ne'
  have hnum : ((γ : ℂ) * z).re * (feedback γ z).re +
      ((γ : ℂ) * z).im * (feedback γ z).im =
      (Complex.normSq (feedback γ z) + (2 * γ - 1)) / 2 := by
    rw [unit_feedback_norm hz]
    simp only [feedback, Complex.add_re, Complex.sub_re,
      Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.one_re,
      Complex.add_im, Complex.sub_im, Complex.mul_im, Complex.one_im]
    linear_combination γ ^ 2 * hu
  rw [Complex.div_re, ← add_div, hnum]
  field_simp [hd] <;> ring

theorem logSlope_re {n : ℕ} {γ a : ℝ} {z : ℂ}
    (ha : 0 < a) (hz : ‖z‖ = 1) (hp : characteristic n γ a z = 0) :
    (logSlope n γ z).re =
      (n : ℝ) - (2 * γ - 1) / (2 * Complex.normSq (feedback γ z)) := by
  obtain ⟨hz1, hq⟩ := unit_root_feedback_ne_zero ha hz hp
  simp only [logSlope, Complex.sub_re, Complex.add_re, Complex.natCast_re,
    unit_div_sub_one_re hz hz1, unit_feedback_div_re hz hq]
  ring

/-- Every unit root below the strict constant-term barrier has positive
real logarithmic slope. This holds even for one delay sample. -/
theorem logSlope_re_pos {n : ℕ} {γ a : ℝ} {z : ℂ}
    (hn : 1 ≤ n) (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1)
    (ha : 0 < a) (hc : a * (1 - γ) < 1)
    (hz : ‖z‖ = 1) (hp : characteristic n γ a z = 0) :
    0 < (logSlope n γ z).re := by
  have hq := (unit_root_feedback_ne_zero ha hz hp).2
  have hR := Complex.normSq_pos.mpr hq
  have ht := constant_term_barrier hγ0 hγ1 ha hc hR
    (unit_feedback_norm_lower hγ0 hγ1 hz) (unit_root_norm_identity hz hp)
  have hdiv : (2 * γ - 1) / (2 * Complex.normSq (feedback γ z)) < 1 :=
    (div_lt_one (by positivity)).mpr ht
  rw [logSlope_re ha hz hp]
  have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
  linarith

theorem inverse_logSlope_re_pos {n : ℕ} {γ a : ℝ} {z : ℂ}
    (hn : 1 ≤ n) (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1)
    (ha : 0 < a) (hc : a * (1 - γ) < 1)
    (hz : ‖z‖ = 1) (hp : characteristic n γ a z = 0) :
    0 < (logSlope n γ z)⁻¹.re := by
  have hre := logSlope_re_pos hn hγ0 hγ1 ha hc hz hp
  have hne : logSlope n γ z ≠ 0 := by intro h; simpa [h] using hre
  rw [Complex.inv_re]
  exact div_pos hre (Complex.normSq_pos.mpr hne)

def characteristicDerivative (n : ℕ) (γ a : ℝ) (z : ℂ) : ℂ :=
  (n : ℂ) * z ^ (n - 1) * (z - 1) + z ^ n + (a : ℂ) * γ

theorem characteristic_hasDerivAt (n : ℕ) (γ a : ℝ) (z : ℂ) :
    HasDerivAt (characteristic n γ a) (characteristicDerivative n γ a z) z := by
  have h1 := ((hasDerivAt_id z).pow n).mul ((hasDerivAt_id z).sub_const 1)
  have h2 := ((((hasDerivAt_id z).const_mul (γ : ℂ)).add_const 1).sub_const
    (γ : ℂ)).const_mul (a : ℂ)
  convert h1.add h2 using 1 <;> simp [characteristic, characteristicDerivative] <;> ring

theorem root_derivative_logSlope {n : ℕ} {γ a : ℝ} {z : ℂ}
    (hn : 1 ≤ n) (ha : 0 < a) (hz : ‖z‖ = 1)
    (hp : characteristic n γ a z = 0) :
    z * characteristicDerivative n γ a z =
      z ^ n * (z - 1) * logSlope n γ z := by
  obtain ⟨hz1, hq⟩ := unit_root_feedback_ne_zero ha hz hp
  have hz1' := sub_ne_zero.mpr hz1
  have he : z ^ n * (z - 1) = -(a : ℂ) * feedback γ z := by
    unfold characteristic at hp
    unfold feedback
    linear_combination hp
  have hpow : z * z ^ (n - 1) = z ^ n := by
    rw [← pow_succ', Nat.sub_add_cancel hn]
  have hfirst : z ^ n * (z - 1) * (z / (z - 1)) = z ^ n * z := by
    field_simp <;> ring
  have hlast : z ^ n * (z - 1) * ((γ : ℂ) * z / feedback γ z) =
      -(a : ℂ) * γ * z := by
    rw [he]
    field_simp <;> ring
  rw [logSlope, mul_sub, mul_add, hfirst, hlast]
  unfold characteristicDerivative
  linear_combination (n : ℂ) * (z - 1) * hpow

/-- Simplicity and the strictly positive radial logarithmic velocity at every
unit root below the constant-term barrier (the content of `lem:outward`). -/
theorem unit_root_transversality {n : ℕ} {γ a : ℝ} {z : ℂ}
    (hn : 1 ≤ n) (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1)
    (ha : 0 < a) (hc : a * (1 - γ) < 1)
    (hz : ‖z‖ = 1) (hp : characteristic n γ a z = 0) :
    characteristicDerivative n γ a z ≠ 0 ∧
      0 < (-(a : ℂ) * feedback γ z /
        (z * characteristicDerivative n γ a z)).re := by
  obtain ⟨hz1, hq⟩ := unit_root_feedback_ne_zero ha hz hp
  have hz0 : z ≠ 0 := by intro h; simpa [h] using hz
  have hB : logSlope n γ z ≠ 0 := by
    have h := logSlope_re_pos hn hγ0 hγ1 ha hc hz hp
    intro he
    simpa [he] using h
  have hder := root_derivative_logSlope hn ha hz hp
  have hD : characteristicDerivative n γ a z ≠ 0 := by
    intro he
    rw [he, mul_zero] at hder
    exact (mul_ne_zero (mul_ne_zero (pow_ne_zero n hz0) (sub_ne_zero.mpr hz1)) hB)
      hder.symm
  refine ⟨hD, ?_⟩
  have he : z ^ n * (z - 1) = -(a : ℂ) * feedback γ z := by
    unfold characteristic at hp
    unfold feedback
    linear_combination hp
  have hid : -(a : ℂ) * feedback γ z /
      (z * characteristicDerivative n γ a z) = (logSlope n γ z)⁻¹ := by
    rw [hder, he]
    have ha' : (a : ℂ) ≠ 0 := by exact_mod_cast ha.ne'
    field_simp
  rw [hid]
  exact inverse_logSlope_re_pos hn hγ0 hγ1 ha hc hz hp

/-- If a differentiable root branch has tangent `w`, implicit differentiation
gives the displayed linear equation; its radial velocity is strictly outward. -/
theorem root_tangent_outward {n : ℕ} {γ a : ℝ} {z w : ℂ}
    (hn : 1 ≤ n) (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1)
    (ha : 0 < a) (hc : a * (1 - γ) < 1)
    (hz : ‖z‖ = 1) (hp : characteristic n γ a z = 0)
    (htangent : characteristicDerivative n γ a z * w + feedback γ z = 0) :
    0 < ((a : ℂ) * w / z).re := by
  obtain ⟨hD, hv⟩ := unit_root_transversality hn hγ0 hγ1 ha hc hz hp
  have hw : w = -feedback γ z / characteristicDerivative n γ a z := by
    apply (eq_div_iff hD).2
    linear_combination htangent
  rw [hw]
  convert hv using 1 <;> congr 1 <;> field_simp <;> ring

end C2.IntegratorDelay

end

/- ===== C2.IntegratorDelayRootBranch ===== -/

/-! Actual local root branches at the unit circle.  The inverse function theorem
constructs the branch; differentiability is a conclusion, not an assumption. -/
noncomputable section
open Filter ComplexConjugate
open scoped Topology
namespace C2.IntegratorDelay

def gainOfPole (n : ℕ) (γ : ℝ) (z : ℂ) : ℂ :=
  -(z ^ n * (z - 1)) / feedback γ z

theorem gainOfPole_eq_of_root {n : ℕ} {γ a : ℝ} {z : ℂ}
    (hq : feedback γ z ≠ 0) (hp : characteristic n γ a z = 0) :
    gainOfPole n γ z = (a : ℂ) := by
  unfold gainOfPole
  apply (div_eq_iff hq).2
  change z ^ n * (z - 1) + (a : ℂ) * feedback γ z = 0 at hp
  linear_combination -hp

theorem gainOfPole_hasStrictDerivAt {n : ℕ} {γ a : ℝ} {z : ℂ}
    (hq : feedback γ z ≠ 0) (hp : characteristic n γ a z = 0) :
    HasStrictDerivAt (gainOfPole n γ)
      (-characteristicDerivative n γ a z / feedback γ z) z := by
  have hnum := ((hasStrictDerivAt_pow n z).mul
    ((hasStrictDerivAt_id z).sub_const 1)).neg
  have hden := ((((hasStrictDerivAt_id z).const_mul (γ : ℂ)).add_const 1).sub_const
    (γ : ℂ))
  have h := hnum.div hden hq
  have he : z ^ n * (z - 1) = -(a : ℂ) * feedback γ z := by
    change z ^ n * (z - 1) + (a : ℂ) * feedback γ z = 0 at hp
    linear_combination hp
  convert h using 1
  simp only [id_eq, mul_one, one_mul, gainOfPole, characteristicDerivative]
  simp only [feedback] at he ⊢
  rw [he]
  have hq' : (γ : ℂ) * z + 1 - γ ≠ 0 := hq
  field_simp [hq'] <;> ring

/-- The branch is defined on a real neighbourhood of the actual positive gain.
Its poles satisfy the actual characteristic equation, and the radial velocity
is positive at the crossing. -/
theorem exists_outward_root_branch {n : ℕ} {γ a : ℝ} {z : ℂ}
    (hn : 1 ≤ n) (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1)
    (ha : 0 < a) (hc : a * (1 - γ) < 1)
    (hz : ‖z‖ = 1) (hp : characteristic n γ a z = 0) :
    ∃ (f : ℝ → ℂ) (w : ℂ), f a = z ∧ HasDerivAt f w a ∧
      (∀ᶠ t in 𝓝 a, characteristic n γ t (f t) = 0) ∧
      0 < ((a : ℂ) * w / z).re ∧
      0 < deriv (fun t => ‖f t‖ ^ 2) a := by
  obtain ⟨hD, hv⟩ := unit_root_transversality hn hγ0 hγ1 ha hc hz hp
  have hq := (unit_root_feedback_ne_zero ha hz hp).2
  have hz0 : z ≠ 0 := by intro h; simpa [h] using hz
  let v : ℂ := -characteristicDerivative n γ a z / feedback γ z
  have hv0 : v ≠ 0 := div_ne_zero (neg_ne_zero.mpr hD) hq
  have hs : HasStrictDerivAt (gainOfPole n γ) v z := gainOfPole_hasStrictDerivAt hq hp
  have hvalue := gainOfPole_eq_of_root hq hp
  let g := hs.localInverse (gainOfPole n γ) v z hv0
  let f : ℝ → ℂ := fun t => g (t : ℂ)
  have hF := hs.hasStrictFDerivAt_equiv hv0
  have hga : g (a : ℂ) = z := by
    simpa only [g, hvalue] using hF.localInverse_apply_image
  have hder : HasDerivAt g v⁻¹ (a : ℂ) := by
    simpa only [g, hvalue] using (hs.to_localInverse hv0).hasDerivAt
  have hf : HasDerivAt f v⁻¹ a := hder.comp_ofReal
  have hfa : f a = z := hga
  have hrcomplex : ∀ᶠ y in 𝓝 (a : ℂ), gainOfPole n γ (g y) = y := by
    simpa only [g, hvalue] using hF.eventually_right_inverse
  have hrreal : ∀ᶠ t in 𝓝 a, gainOfPole n γ (f t) = (t : ℂ) :=
    Complex.continuous_ofReal.continuousAt.tendsto.eventually hrcomplex
  have hfeedback : ContinuousAt (fun t => feedback γ (f t)) a :=
    ((continuousAt_const.mul hf.continuousAt).add continuousAt_const).sub continuousAt_const
  have hqnear : ∀ᶠ t in 𝓝 a, feedback γ (f t) ≠ 0 :=
    hfeedback.eventually_ne (by simpa only [hfa] using hq)
  have hroot : ∀ᶠ t in 𝓝 a, characteristic n γ t (f t) = 0 := by
    filter_upwards [hrreal, hqnear] with t ht hqt
    have he := (div_eq_iff hqt).mp ht
    change -(f t ^ n * (f t - 1)) = (t : ℂ) * feedback γ (f t) at he
    change f t ^ n * (f t - 1) + (t : ℂ) * feedback γ (f t) = 0
    linear_combination -he
  have hvel : 0 < ((a : ℂ) * v⁻¹ / z).re := by
    have hid : (a : ℂ) * v⁻¹ / z = -(a : ℂ) * feedback γ z /
        (z * characteristicDerivative n γ a z) := by
      dsimp [v]
      field_simp [hD, hq, hz0] <;> ring_nf <;> simp
    rw [hid]
    exact hv
  have hnorm : Complex.normSq z = 1 := by
    rw [Complex.normSq_eq_norm_sq, hz]
    norm_num
  have hvel_eq : ((a : ℂ) * v⁻¹ / z).re = a * (v⁻¹ * conj z).re := by
    simp only [Complex.div_re, hnorm, div_one, Complex.mul_re,
      Complex.ofReal_re, Complex.ofReal_im, Complex.mul_im, Complex.conj_re,
      Complex.conj_im, zero_mul, sub_zero, add_zero]
    ring
  have hinner : 0 < (v⁻¹ * conj z).re := by
    rw [hvel_eq] at hvel
    exact (mul_pos_iff_of_pos_left ha).mp hvel
  have hsq := hf.norm_sq
  rw [hfa, Complex.inner] at hsq
  have hsqpos : 0 < deriv (fun t => ‖f t‖ ^ 2) a := by
    rw [hsq.deriv]
    exact mul_pos (by norm_num) hinner
  exact ⟨f, v⁻¹, hfa, hf, hroot, hvel, hsqpos⟩

end C2.IntegratorDelay

end

/- ===== C2.IntegratorDelayFinal ===== -/

/-! Full manuscript wrappers for the inherited integer-delay integrator block. -/
noncomputable section
namespace C2.IntegratorDelay
open NGamma.Cayley

theorem frequency_boundary_root {n : ℕ} (hn : 2 ≤ n) {γ : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    0 < boundaryGain n (frequency n (2 * γ - 1)) ∧
      characteristic n γ (boundaryGain n (frequency n (2 * γ - 1)))
        (Complex.exp ((frequency n (2 * γ - 1) : ℂ) * Complex.I)) = 0 := by
  refine ⟨criticalGain_pos hn hγ0 hγ1, ?_⟩
  let x := 2 * γ - 1
  have hx0 : -1 ≤ x := by dsimp [x]; linarith
  have hx1 : x ≤ 1 := by dsimp [x]; linarith
  let t := criticalCayleyPoint n x
  have ht : 0 < t := criticalCayleyPoint_pos hn hx0 hx1
  have hpoint : point t = Complex.exp ((frequency n x : ℂ) * Complex.I) := by
    rw [point_exp, criticalCayleyPoint_angle hn hx0 hx1]
  have hB : amplitude x t = criticalGain n γ := criticalCayleyPoint_amplitude hn hx0 hx1
  have hp : totalPhase n x t = Real.pi := criticalCayleyPoint_phase hn hx0 hx1
  change characteristic n γ (criticalGain n γ)
    (Complex.exp ((frequency n x : ℂ) * Complex.I)) = 0
  rw [← hpoint, ← poly_eval_characteristic, poly_eval_point, transfer_polar n x t ht.le,
    hB, hp, Complex.exp_pi_mul_I]
  ring

/-- All clauses of `lem:phase` except parameter monotonicity, which is
`manuscript_frequency_strictMonoOn`: the exact unique printed phase equation,
the prescribed interval, positive gain, and the actual unit-circle root. -/
theorem low_frequency_boundary_theorem {n : ℕ} (hn : 2 ≤ n) {γ : ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    ∃! w : ℝ, w ∈ Set.Icc (lowerFrequency n) (upperFrequency n) ∧
      ((n : ℝ) + 1 / 2) * w - chordPhase γ w = Real.pi / 2 ∧
      0 < boundaryGain n w ∧
      characteristic n γ (boundaryGain n w) (Complex.exp ((w : ℂ) * Complex.I)) = 0 := by
  have hx0 : -1 ≤ 2 * γ - 1 := by linarith
  have hx1 : 2 * γ - 1 ≤ 1 := by linarith
  have hf := frequency_spec hn hx0 hx1
  have hb := frequency_bounds hn hf.1
  have hphase : ((n : ℝ) + 1 / 2) * frequency n (2 * γ - 1) -
      chordPhase γ (frequency n (2 * γ - 1)) = Real.pi / 2 := by
    rw [manuscript_phase_eq_lowPhase hγ0 hγ1 hb.1.le
      (by linarith [hb.2.1, Real.pi_pos])]
    exact hf.2
  refine ⟨frequency n (2 * γ - 1), ⟨hf.1, hphase, frequency_boundary_root hn hγ0 hγ1⟩, ?_⟩
  intro v hv
  obtain ⟨w, hw, hu⟩ := existsUnique_manuscript_frequency hn hγ0 hγ1
  exact (hu v ⟨hv.1, hv.2.1⟩).trans (hu _ ⟨hf.1, hphase⟩).symm

end C2.IntegratorDelay

end

/- ===== C2.MIACEAreas ===== -/

/-!
# Absolute areas for a pure-delay plant

The timing assumptions are stated for the actual tracking error and centred
command sequences. The absolute values occur inside each series.
-/

noncomputable section
open scoped BigOperators

namespace C2.MIACE

def area (T : ℝ) (s : ℕ → ℝ) : ℝ := T * ∑' n, |s n|

def cost (η Ae Au : ℝ) : ℝ := Real.sqrt (Ae ^ 2 + η * Au ^ 2)

theorem area_nonneg {T : ℝ} (hT : 0 ≤ T) (s : ℕ → ℝ) :
    0 ≤ area T s := by
  exact mul_nonneg hT (tsum_nonneg (fun n => abs_nonneg _))

/-- The zero command prehistory gives the first `d` errors equal to one;
the delayed plant gives the centred-command identity in the second premise. -/
theorem pure_delay_area_identity (T : ℝ) (d : ℕ) (e v : ℕ → ℝ)
    (hs : Summable (fun n => |e n|))
    (hstart : ∀ n < d, e n = 1)
    (htiming : ∀ n, v n = -e (n + d)) :
    area T e = (d : ℝ) * T + area T v := by
  have hhead : ∑ n ∈ Finset.range d, |e n| = (d : ℝ) := by
    calc
      ∑ n ∈ Finset.range d, |e n| = ∑ _n ∈ Finset.range d, (1 : ℝ) := by
        apply Finset.sum_congr rfl
        intro n hn
        rw [hstart n (Finset.mem_range.mp hn), abs_one]
      _ = (d : ℝ) := by simp
  have htail : (∑' n, |v n|) = ∑' n, |e (n + d)| := by
    apply tsum_congr
    intro n
    rw [htiming n, abs_neg]
  have hsplit := hs.sum_add_tsum_nat_add d
  rw [hhead, ← htail] at hsplit
  dsimp [area]
  rw [← hsplit]
  ring

theorem pure_delay_tracking_area_lower_bound {T : ℝ} (hT : 0 ≤ T)
    (d : ℕ) (e v : ℕ → ℝ) (hs : Summable (fun n => |e n|))
    (hstart : ∀ n < d, e n = 1)
    (htiming : ∀ n, v n = -e (n + d)) :
    (d : ℝ) * T ≤ area T e := by
  rw [pure_delay_area_identity T d e v hs hstart htiming]
  linarith [area_nonneg hT v]

/-- Strict order preservation explains why every positive MIACE weight has
the same minimizers on any fixed pure-delay response family. -/
theorem cost_strictMono_on_delay_line {η D : ℝ} (hη : 0 < η) (hD : 0 ≤ D) :
    StrictMonoOn (fun x : ℝ => cost η x (x - D)) (Set.Ici D) := by
  intro x hx y hy hxy
  dsimp [cost]
  change D ≤ x at hx
  change D ≤ y at hy
  have hx0 : 0 ≤ x := le_trans hD hx
  have hy0 : 0 ≤ y := le_trans hD hy
  have hsq : x ^ 2 < y ^ 2 := by nlinarith
  have hrest : η * (x - D) ^ 2 ≤ η * (y - D) ^ 2 := by
    apply mul_le_mul_of_nonneg_left _ hη.le
    nlinarith
  apply Real.sqrt_lt_sqrt
  · positivity
  · linarith

theorem cost_le_cost_iff_on_delay_line {η D x y : ℝ}
    (hη : 0 < η) (hD : 0 ≤ D) (hx : D ≤ x) (hy : D ≤ y) :
    cost η x (x - D) ≤ cost η y (y - D) ↔ x ≤ y := by
  constructor
  · intro h
    by_contra hxy
    have hstrict := cost_strictMono_on_delay_line hη hD hy hx (lt_of_not_ge hxy)
    linarith
  · intro h
    rcases lt_or_eq_of_le h with h | h
    · exact (cost_strictMono_on_delay_line hη hD hx hy h).le
    · rw [h]

/-- Pointwise minimizer equivalence, without assuming existence of a
minimizer or finiteness of the design family. -/
theorem pure_delay_minimizer_iff {ι : Type*} (S : Set ι)
    (Ae Au : ι → ℝ) {η D : ℝ} (hη : 0 < η) (hD : 0 ≤ D)
    (hAu : ∀ i ∈ S, 0 ≤ Au i)
    (harea : ∀ i ∈ S, Ae i = D + Au i) (i : ι) (hi : i ∈ S) :
    (∀ j ∈ S, cost η (Ae i) (Au i) ≤ cost η (Ae j) (Au j)) ↔
      (∀ j ∈ S, Ae i ≤ Ae j) := by
  have hxi : D ≤ Ae i := by rw [harea i hi]; linarith [hAu i hi]
  have hai : Au i = Ae i - D := by linarith [harea i hi]
  constructor <;> intro h j hj
  · have hxj : D ≤ Ae j := by rw [harea j hj]; linarith [hAu j hj]
    have haj : Au j = Ae j - D := by linarith [harea j hj]
    have hij := h j hj
    rw [hai, haj] at hij
    exact (cost_le_cost_iff_on_delay_line hη hD hxi hxj).mp hij
  · have hxj : D ≤ Ae j := by rw [harea j hj]; linarith [hAu j hj]
    have haj : Au j = Ae j - D := by linarith [harea j hj]
    rw [hai, haj]
    exact (cost_le_cost_iff_on_delay_line hη hD hxi hxj).mpr (h j hj)

end C2.MIACE

end

/- ===== C2.MIACETail ===== -/

/-!
# MIACE truncation and uniform convergence

The statements here start from an explicit uniform geometric envelope. The
separate implication from a compact family of Schur-stable matrices to such
an envelope is not assumed to have been formalized by these lemmas.
-/

noncomputable section
open scoped BigOperators Topology
open Filter

namespace C2.MIACE

def partialArea (T : ℝ) (s : ℕ → ℝ) (N : ℕ) : ℝ :=
  T * ∑ n ∈ Finset.range N, |s n|

theorem cost_nonneg (η a b : ℝ) : 0 ≤ cost η a b := Real.sqrt_nonneg _

theorem cost_sq {η : ℝ} (hη : 0 ≤ η) (a b : ℝ) :
    cost η a b ^ 2 = a ^ 2 + η * b ^ 2 := by
  exact Real.sq_sqrt (by positivity)

theorem cost_mono {η a b c d : ℝ} (hη : 0 ≤ η)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hac : a ≤ c) (hbd : b ≤ d) :
    cost η a b ≤ cost η c d := by
  apply Real.sqrt_le_sqrt
  have h₁ : a ^ 2 ≤ c ^ 2 := by nlinarith
  have h₂ : η * b ^ 2 ≤ η * d ^ 2 := by
    apply mul_le_mul_of_nonneg_left _ hη
    nlinarith
  linarith

theorem cost_mul {η k : ℝ} (hk : 0 ≤ k) (a b : ℝ) :
    cost η (k * a) (k * b) = k * cost η a b := by
  dsimp [cost]
  rw [show (k * a) ^ 2 + η * (k * b) ^ 2 =
    k ^ 2 * (a ^ 2 + η * b ^ 2) by ring]
  rw [Real.sqrt_mul (sq_nonneg k), Real.sqrt_sq hk]

theorem cost_triangle {η : ℝ} (hη : 0 ≤ η) (a b c d : ℝ) :
    cost η (a + c) (b + d) ≤ cost η a b + cost η c d := by
  have hcs := Real.sum_mul_le_sqrt_mul_sqrt Finset.univ
    (![a, Real.sqrt η * b] : Fin 2 → ℝ)
    (![c, Real.sqrt η * d] : Fin 2 → ℝ)
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_fin_one] at hcs
  have hηsq := Real.sq_sqrt hη
  have hab : (Real.sqrt η * b) ^ 2 = η * b ^ 2 := by nlinarith
  have hcd : (Real.sqrt η * d) ^ 2 = η * d ^ 2 := by nlinarith
  have hbd : Real.sqrt η * b * (Real.sqrt η * d) = η * b * d := by
    nlinarith
  rw [hab, hcd, hbd] at hcs
  change a * c + η * b * d ≤ cost η a b * cost η c d at hcs
  have hs₁ := cost_sq hη a b
  have hs₂ := cost_sq hη c d
  have hs₃ := cost_sq hη (a + c) (b + d)
  have hn₁ := cost_nonneg η a b
  have hn₂ := cost_nonneg η c d
  have hn₃ := cost_nonneg η (a + c) (b + d)
  nlinarith

theorem area_tail_identity (T : ℝ) (s : ℕ → ℝ)
    (hs : Summable (fun n => |s n|)) (N : ℕ) :
    area T s - partialArea T s N = T * ∑' n, |s (n + N)| := by
  have h := hs.sum_add_tsum_nat_add N
  dsimp [area, partialArea]
  rw [← h]
  ring

theorem summable_of_geometric_bound {s : ℕ → ℝ} {C q : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hbound : ∀ n, |s n| ≤ C * q ^ n) :
    Summable (fun n => |s n|) := by
  apply Summable.of_nonneg_of_le (fun n => abs_nonneg _) hbound
  exact (summable_geometric_of_lt_one hq0 hq1).mul_left C

theorem absolute_tail_bound {s : ℕ → ℝ} {C q : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hbound : ∀ n, |s n| ≤ C * q ^ n)
    (N : ℕ) :
    (∑' n, |s (n + N)|) ≤ C * q ^ N / (1 - q) := by
  have hs := summable_of_geometric_bound hq0 hq1 hbound
  have htail := (summable_nat_add_iff N).2 hs
  have hg := (summable_geometric_of_lt_one hq0 hq1).mul_left (C * q ^ N)
  have hb : ∀ n, |s (n + N)| ≤ (C * q ^ N) * q ^ n := by
    intro n
    convert hbound (n + N) using 1 <;> rw [pow_add] <;> ring
  have ht := tsum_le_tsum hb htail hg
  rw [tsum_mul_left, tsum_geometric_of_lt_one hq0 hq1] at ht
  simpa [div_eq_mul_inv, mul_assoc] using ht

theorem area_tail_bounds {T Tmax C q : ℝ} {s : ℕ → ℝ}
    (hT : 0 ≤ T) (hTmax : T ≤ Tmax) (hC : 0 ≤ C)
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hbound : ∀ n, |s n| ≤ C * q ^ n)
    (N : ℕ) :
    0 ≤ area T s - partialArea T s N ∧
      area T s - partialArea T s N ≤ Tmax * C * q ^ N / (1 - q) := by
  rw [area_tail_identity T s (summable_of_geometric_bound hq0 hq1 hbound) N]
  have ht0 : 0 ≤ ∑' n, |s (n + N)| := tsum_nonneg (fun n => abs_nonneg _)
  constructor
  · exact mul_nonneg hT ht0
  · calc
      T * (∑' n, |s (n + N)|) ≤ Tmax * (∑' n, |s (n + N)|) :=
        mul_le_mul_of_nonneg_right hTmax ht0
      _ ≤ Tmax * (C * q ^ N / (1 - q)) :=
        mul_le_mul_of_nonneg_left (absolute_tail_bound hq0 hq1 hbound N)
          (le_trans hT hTmax)
      _ = Tmax * C * q ^ N / (1 - q) := by ring

/-- Exact two-area remainder constant, including the nonnegative lower
bound. Here `Ce` and `Cu` are the geometric envelopes of the output signals. -/
theorem miace_tail_bound {T Tmax Ce Cu q η : ℝ} {e v : ℕ → ℝ}
    (hT : 0 ≤ T) (hTmax : T ≤ Tmax) (hCe : 0 ≤ Ce) (hCu : 0 ≤ Cu)
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hη : 0 ≤ η)
    (he : ∀ n, |e n| ≤ Ce * q ^ n) (hv : ∀ n, |v n| ≤ Cu * q ^ n)
    (N : ℕ) :
    0 ≤ cost η (area T e) (area T v) -
      cost η (partialArea T e N) (partialArea T v N) ∧
    cost η (area T e) (area T v) -
      cost η (partialArea T e N) (partialArea T v N) ≤
        (Tmax * q ^ N / (1 - q)) * Real.sqrt (Ce ^ 2 + η * Cu ^ 2) := by
  obtain ⟨he0, he1⟩ := area_tail_bounds hT hTmax hCe hq0 hq1 he N
  obtain ⟨hv0, hv1⟩ := area_tail_bounds hT hTmax hCu hq0 hq1 hv N
  have hpe : 0 ≤ partialArea T e N := by dsimp [partialArea]; positivity
  have hpv : 0 ≤ partialArea T v N := by dsimp [partialArea]; positivity
  have hmono := cost_mono hη hpe hpv (by linarith : partialArea T e N ≤ area T e)
    (by linarith : partialArea T v N ≤ area T v)
  refine ⟨sub_nonneg.mpr hmono, ?_⟩
  have htri := cost_triangle hη (partialArea T e N) (partialArea T v N)
    (area T e - partialArea T e N) (area T v - partialArea T v N)
  simp only [add_sub_cancel] at htri
  let K := Tmax * q ^ N / (1 - q)
  have hTm : 0 ≤ Tmax := hT.trans hTmax
  have hden : 0 < 1 - q := sub_pos.mpr hq1
  have hK : 0 ≤ K := by dsimp [K]; positivity
  have heK : area T e - partialArea T e N ≤ K * Ce := by
    dsimp [K]
    convert he1 using 1 <;> ring
  have hvK : area T v - partialArea T v N ≤ K * Cu := by
    dsimp [K]
    convert hv1 using 1 <;> ring
  have hc := cost_mono hη he0 hv0 heK hvK
  rw [cost_mul hK] at hc
  change cost η (area T e) (area T v) -
    cost η (partialArea T e N) (partialArea T v N) ≤ K * cost η Ce Cu
  linarith

theorem uniform_area_series {X : Type*} (s : ℕ → X → ℝ) {C q : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hbound : ∀ n x, |s n x| ≤ C * q ^ n) :
    TendstoUniformly (fun N x => ∑ n ∈ Finset.range N, |s n x|)
      (fun x => ∑' n, |s n x|) atTop := by
  apply tendstoUniformly_tsum_nat ((summable_geometric_of_lt_one hq0 hq1).mul_left C)
  intro n x
  simpa only [Real.norm_eq_abs, abs_abs] using hbound n x

theorem continuous_area_of_geometric_bound {X : Type*} [TopologicalSpace X]
    (s : ℕ → X → ℝ) (T : X → ℝ) {C q : ℝ}
    (hs : ∀ n, Continuous (s n)) (hT : Continuous T)
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hbound : ∀ n x, |s n x| ≤ C * q ^ n) :
    Continuous (fun x => area (T x) (fun n => s n x)) := by
  apply hT.mul
  apply continuous_tsum (fun n => (hs n).abs)
    ((summable_geometric_of_lt_one hq0 hq1).mul_left C)
  intro n x
  simpa only [Real.norm_eq_abs, abs_abs] using hbound n x

theorem miace_continuous_and_attains_minimum
    {X : Type*} [TopologicalSpace X] [CompactSpace X] [Nonempty X]
    (e v : ℕ → X → ℝ) (T : X → ℝ) (η : ℝ) {Ce Cu q : ℝ}
    (he : ∀ n, Continuous (e n)) (hv : ∀ n, Continuous (v n))
    (hT : Continuous T) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hbe : ∀ n x, |e n x| ≤ Ce * q ^ n) (hbv : ∀ n x, |v n x| ≤ Cu * q ^ n) :
    Continuous (fun x => cost η (area (T x) (fun n => e n x))
      (area (T x) (fun n => v n x))) ∧
    ∃ x, ∀ y, cost η (area (T x) (fun n => e n x)) (area (T x) (fun n => v n x)) ≤
      cost η (area (T y) (fun n => e n y)) (area (T y) (fun n => v n y)) := by
  have hAe := continuous_area_of_geometric_bound e T he hT hq0 hq1 hbe
  have hAu := continuous_area_of_geometric_bound v T hv hT hq0 hq1 hbv
  have hM : Continuous (fun x => cost η (area (T x) (fun n => e n x))
      (area (T x) (fun n => v n x))) := by
    exact ((hAe.pow 2).add (continuous_const.mul (hAu.pow 2))).sqrt
  refine ⟨hM, ?_⟩
  obtain ⟨x, _, hx⟩ := isCompact_univ.exists_isMinOn Set.univ_nonempty hM.continuousOn
  exact ⟨x, fun y => hx (Set.mem_univ y)⟩

end C2.MIACE

end

/- ===== C2.MIACECompact ===== -/

/-! The compact Schur-stable state-space hypotheses imply the uniform
envelopes needed by the MIACE continuity and existence theorem. -/

noncomputable section
open scoped BigOperators Topology
open Filter Matrix

namespace C2.MIACE

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def stateOutput {X : Type*} (A : X → Matrix ι ι ℝ)
    (x₀ c : X → ι → ℝ) (n : ℕ) (x : X) : ℝ :=
  dotProduct (c x) ((A x) ^ n *ᵥ x₀ x)

theorem stateOutput_continuous {X : Type*} [TopologicalSpace X]
    (A : X → Matrix ι ι ℝ) (x₀ c : X → ι → ℝ)
    (hA : Continuous A) (hx : Continuous x₀) (hc : Continuous c) (n : ℕ) :
    Continuous (stateOutput A x₀ c n) := by
  exact hc.matrix_dotProduct ((hA.pow n).matrix_mulVec hx)

theorem dotProduct_abs_bound (c v : ι → ℝ) :
    |dotProduct c v| ≤ (∑ i, |c i|) * ‖v‖ := by
  unfold dotProduct
  calc
    |∑ i, c i * v i| ≤ ∑ i, |c i * v i| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i, |c i| * ‖v‖ := by
      apply Finset.sum_le_sum
      intro i _
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_left (by simpa only [Real.norm_eq_abs] using norm_le_pi_norm v i)
        (abs_nonneg _)
    _ = (∑ i, |c i|) * ‖v‖ := (Finset.sum_mul _ _ _).symm

theorem real_matrix_powers_tendsto_zero (A : Matrix ι ι ℝ)
    (h : C2.NGamma.MatrixSchurStable A) :
    Tendsto (fun n : ℕ => A ^ n) atTop (𝓝 0) := by
  apply tendsto_pi_nhds.mpr
  intro i
  apply tendsto_pi_nhds.mpr
  intro j
  have ht := C2.NGamma.Realization.asymptoticallyStable_of_schur A h (Pi.single j 1)
  simpa only [Matrix.mulVec_single_one, Pi.zero_apply, Matrix.zero_apply] using
    tendsto_pi_nhds.mp ht i

theorem compact_schur_output_envelopes
    {X : Type*} [TopologicalSpace X] [CompactSpace X]
    (A : X → Matrix ι ι ℝ) (x₀ ce cu : X → ι → ℝ)
    (hA : Continuous A) (hx : Continuous x₀) (he : Continuous ce) (hu : Continuous cu)
    (hstable : ∀ x, C2.NGamma.MatrixSchurStable (A x)) :
    ∃ Ce Cu q : ℝ, 0 ≤ Ce ∧ 0 ≤ Cu ∧ 0 < q ∧ q < 1 ∧
      (∀ n x, |stateOutput A x₀ ce n x| ≤ Ce * q ^ n) ∧
      (∀ n x, |stateOutput A x₀ cu n x| ≤ Cu * q ^ n) := by
  classical
  cases isEmpty_or_nonempty ι with
  | inl hi =>
    letI := hi
    refine ⟨0, 0, 1 / 2, by norm_num, by norm_num, by norm_num, by norm_num, ?_, ?_⟩
    · intro n x
      simp [stateOutput, dotProduct]
    · intro n x
      simp [stateOutput, dotProduct]
  | inr hi =>
    letI := hi
    letI : NormedRing (Matrix ι ι ℝ) := Matrix.linftyOpNormedRing
    obtain ⟨C, q, hC, hq0, hq1, hb⟩ :=
      C2.CompactSchur.uniform_geometric_of_compact_power_decay A hA
        (fun x => real_matrix_powers_tendsto_zero (A x) (hstable x))
    obtain ⟨V, hV, hv⟩ := (isCompact_range hx).isBounded.exists_pos_norm_le
    have hce : Continuous (fun x => ∑ i, |ce x i|) := by
      apply continuous_finset_sum
      intro i _
      exact ((continuous_apply i).comp he).abs
    have hcu : Continuous (fun x => ∑ i, |cu x i|) := by
      apply continuous_finset_sum
      intro i _
      exact ((continuous_apply i).comp hu).abs
    obtain ⟨E, hE, heB⟩ := (isCompact_range hce).isBounded.exists_pos_norm_le
    obtain ⟨U, hU, huB⟩ := (isCompact_range hcu).isBounded.exists_pos_norm_le
    have heB' : ∀ x, (∑ i, |ce x i|) ≤ E := by
      intro x
      have ht := heB _ (Set.mem_range_self x)
      rw [Real.norm_eq_abs, abs_of_nonneg (Finset.sum_nonneg (fun _ _ => abs_nonneg _))] at ht
      exact ht
    have huB' : ∀ x, (∑ i, |cu x i|) ≤ U := by
      intro x
      have ht := huB _ (Set.mem_range_self x)
      rw [Real.norm_eq_abs, abs_of_nonneg (Finset.sum_nonneg (fun _ _ => abs_nonneg _))] at ht
      exact ht
    have hstate : ∀ n x, ‖(A x) ^ n *ᵥ x₀ x‖ ≤ (C * V) * q ^ n := by
      intro n x
      calc
        ‖(A x) ^ n *ᵥ x₀ x‖ ≤ ‖(A x) ^ n‖ * ‖x₀ x‖ := Matrix.linfty_opNorm_mulVec _ _
        _ ≤ (C * q ^ n) * V :=
          mul_le_mul (hb x n) (hv _ (Set.mem_range_self x)) (norm_nonneg _) (by positivity)
        _ = (C * V) * q ^ n := by ring
    refine ⟨E * C * V, U * C * V, q, by positivity, by positivity, hq0, hq1, ?_, ?_⟩
    · intro n x
      calc
        |stateOutput A x₀ ce n x| ≤ (∑ i, |ce x i|) * ‖(A x) ^ n *ᵥ x₀ x‖ :=
          dotProduct_abs_bound _ _
        _ ≤ E * ((C * V) * q ^ n) :=
          mul_le_mul (heB' x) (hstate n x) (norm_nonneg _) hE.le
        _ = E * C * V * q ^ n := by ring
    · intro n x
      calc
        |stateOutput A x₀ cu n x| ≤ (∑ i, |cu x i|) * ‖(A x) ^ n *ᵥ x₀ x‖ :=
          dotProduct_abs_bound _ _
        _ ≤ U * ((C * V) * q ^ n) :=
          mul_le_mul (huB' x) (hstate n x) (norm_nonneg _) hU.le
        _ = U * C * V * q ^ n := by ring

theorem uniform_scaled_area_series {X : Type*} (s : ℕ → X → ℝ) (T : X → ℝ)
    {C M q : ℝ} (hC : 0 ≤ C) (hM : 0 ≤ M) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hT : ∀ x, |T x| ≤ M) (hbound : ∀ n x, |s n x| ≤ C * q ^ n) :
    TendstoUniformly (fun N x => partialArea (T x) (fun n => s n x) N)
      (fun x => area (T x) (fun n => s n x)) atTop := by
  have hsum := (summable_geometric_of_lt_one hq0 hq1).mul_left (M * C)
  have hb : ∀ n x, ‖T x * |s n x|‖ ≤ (M * C) * q ^ n := by
    intro n x
    rw [Real.norm_eq_abs, abs_mul, abs_abs]
    calc
      |T x| * |s n x| ≤ M * (C * q ^ n) :=
        mul_le_mul (hT x) (hbound n x) (abs_nonneg _) hM
      _ = (M * C) * q ^ n := by ring
  have ht := tendstoUniformly_tsum_nat hsum hb
  simpa only [partialArea, area, Finset.mul_sum, tsum_mul_left] using ht

/-- All convergence, continuity, and attainment clauses under exactly the
compact continuous strictly Schur-stable family hypotheses. -/
theorem compact_schur_miace_existence
    {X : Type*} [TopologicalSpace X] [CompactSpace X] [Nonempty X]
    (A : X → Matrix ι ι ℝ) (x₀ ce cu : X → ι → ℝ) (T : X → ℝ) (η : ℝ)
    (hA : Continuous A) (hx : Continuous x₀) (he : Continuous ce) (hu : Continuous cu)
    (hT : Continuous T) (hstable : ∀ x, C2.NGamma.MatrixSchurStable (A x)) :
    TendstoUniformly (fun N x => partialArea (T x) (fun n => stateOutput A x₀ ce n x) N)
      (fun x => area (T x) (fun n => stateOutput A x₀ ce n x)) atTop ∧
    TendstoUniformly (fun N x => partialArea (T x) (fun n => stateOutput A x₀ cu n x) N)
      (fun x => area (T x) (fun n => stateOutput A x₀ cu n x)) atTop ∧
    Continuous (fun x => cost η (area (T x) (fun n => stateOutput A x₀ ce n x))
      (area (T x) (fun n => stateOutput A x₀ cu n x))) ∧
    ∃ x, ∀ y,
      cost η (area (T x) (fun n => stateOutput A x₀ ce n x))
        (area (T x) (fun n => stateOutput A x₀ cu n x)) ≤
      cost η (area (T y) (fun n => stateOutput A x₀ ce n y))
        (area (T y) (fun n => stateOutput A x₀ cu n y)) := by
  obtain ⟨Ce, Cu, q, hCe, hCu, hq0, hq1, hbe, hbu⟩ :=
    compact_schur_output_envelopes A x₀ ce cu hA hx he hu hstable
  have hmin := miace_continuous_and_attains_minimum
    (stateOutput A x₀ ce) (stateOutput A x₀ cu) T η
    (stateOutput_continuous A x₀ ce hA hx he) (stateOutput_continuous A x₀ cu hA hx hu)
    hT hq0.le hq1 hbe hbu
  obtain ⟨M, hM, hMb⟩ := (isCompact_range hT).isBounded.exists_pos_norm_le
  have hMT : ∀ x, |T x| ≤ M := fun x => by
    simpa only [Real.norm_eq_abs] using hMb _ (Set.mem_range_self x)
  exact ⟨uniform_scaled_area_series _ T hCe hM.le hq0.le hq1 hMT hbe,
    uniform_scaled_area_series _ T hCu hM.le hq0.le hq1 hMT hbu,
    hmin.1, hmin.2⟩

end C2.MIACE

end

/- ===== C2.MIACERecurrence ===== -/

/-!
# Actual one-delay tracking recurrence

Nonnegativity is characterized without invoking an unformalized oscillation
argument. In the negative-discriminant case the positive successive-error
ratios would decrease by a fixed positive amount, which is impossible.
-/

noncomputable section
open scoped BigOperators Topology
open Filter

namespace C2.MIACE

def ErrorRecurrence (A B : ℝ) (e : ℕ → ℝ) : Prop :=
  e 0 = 1 ∧ e 1 = A ∧ ∀ n, e (n + 2) = A * e (n + 1) - B * e n

theorem recurrence_nonnegative_of_root_bound {A B : ℝ} {e : ℕ → ℝ}
    (hB : 0 ≤ B) (h : ErrorRecurrence A B e) (hA : 2 * Real.sqrt B ≤ A) :
    ∀ n, 0 ≤ e n := by
  rcases h with ⟨h₀, h₁, hr⟩
  have hs := Real.sqrt_nonneg B
  have hs2 := Real.sq_sqrt hB
  have hind : ∀ n, 0 ≤ e n ∧ Real.sqrt B * e n ≤ e (n + 1) := by
    intro n
    induction n with
    | zero =>
      simp only [Nat.zero_add, h₀, h₁, mul_one]
      constructor <;> linarith
    | succ n ih =>
      have hn1 : 0 ≤ e (n + 1) := le_trans (mul_nonneg hs ih.1) ih.2
      refine ⟨hn1, ?_⟩
      rw [show n + 1 + 1 = n + 2 by omega, hr]
      have hmul := mul_nonneg (by linarith : 0 ≤ A - Real.sqrt B)
        (sub_nonneg.mpr ih.2)
      have hmul' := mul_nonneg (by linarith : 0 ≤ A - 2 * Real.sqrt B)
        (mul_nonneg hs ih.1)
      conv_rhs => rw [← hs2]
      nlinarith
  exact fun n => (hind n).1

theorem recurrence_positive_of_nonnegative {A B : ℝ} {e : ℕ → ℝ}
    (hB : 0 < B) (h : ErrorRecurrence A B e) (he : ∀ n, 0 ≤ e n) :
    ∀ n, 0 < e n := by
  intro n
  induction n with
  | zero => rw [h.1]; norm_num
  | succ n ih =>
    by_contra hn
    have hn1 : e (n + 1) = 0 := le_antisymm (le_of_not_gt hn) (he _)
    have hrec := h.2.2 n
    rw [hn1, mul_zero, zero_sub] at hrec
    have hp := mul_pos hB ih
    have hn2 := he (n + 2)
    linarith

theorem recurrence_root_bound_of_nonnegative {A B : ℝ} {e : ℕ → ℝ}
    (hB : 0 ≤ B) (h : ErrorRecurrence A B e) (he : ∀ n, 0 ≤ e n) :
    2 * Real.sqrt B ≤ A := by
  have hA : 0 ≤ A := by rw [← h.2.1]; exact he 1
  by_contra hbad
  have hAlt : A < 2 * Real.sqrt B := lt_of_not_ge hbad
  have hs2 := Real.sq_sqrt hB
  have hs := Real.sqrt_nonneg B
  have hdisc : A ^ 2 < 4 * B := by nlinarith
  have hBp : 0 < B := by nlinarith [sq_nonneg A]
  have hep := recurrence_positive_of_nonnegative hBp h he
  have hAp : 0 < A := by rw [← h.2.1]; exact hep 1
  let r : ℕ → ℝ := fun n => e (n + 1) / e n
  have hrp : ∀ n, 0 < r n := fun n => div_pos (hep _) (hep _)
  have hr0 : r 0 = A := by simp [r, h.1, h.2.1]
  have hre : ∀ n, r n * r (n + 1) = A * r n - B := by
    intro n
    dsimp [r]
    rw [show n + 1 + 1 = n + 2 by omega, h.2.2 n]
    field_simp [ne_of_gt (hep n), ne_of_gt (hep (n + 1))]
    ring
  have hrle : ∀ n, r n ≤ A := by
    intro n
    cases n with
    | zero => rw [hr0]
    | succ n =>
      apply (mul_le_mul_left (hrp n)).mp
      nlinarith [hre n]
  let δ : ℝ := B - A ^ 2 / 4
  have hδ : 0 < δ := by dsimp [δ]; linarith
  have hdrop : ∀ n, A * r (n + 1) ≤ A * r n - δ := by
    intro n
    have hrec := hre n
    have hsquare := sq_nonneg (r n - A / 2)
    have hbase : δ ≤ r n * (r n - r (n + 1)) := by
      dsimp [δ]
      nlinarith
    have hdiff : 0 < r n - r (n + 1) := by
      have hp := hrp n
      nlinarith
    have hm := mul_le_mul_of_nonneg_right (hrle n) hdiff.le
    nlinarith
  have hind : ∀ n, A * r n ≤ A * r 0 - (n : ℝ) * δ := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      have hd := hdrop n
      push_cast
      linarith
  obtain ⟨n, hn⟩ := exists_nat_gt (A * r 0 / δ)
  have hlarge : A * r 0 < (n : ℝ) * δ := (div_lt_iff₀ hδ).mp hn
  have hlast := hind n
  have hp := mul_pos hAp (hrp n)
  linarith

theorem recurrence_nonnegative_iff {A B : ℝ} {e : ℕ → ℝ}
    (hB : 0 ≤ B) (h : ErrorRecurrence A B e) :
    (∀ n, 0 ≤ e n) ↔ 2 * Real.sqrt B ≤ A :=
  ⟨recurrence_root_bound_of_nonnegative hB h,
    recurrence_nonnegative_of_root_bound hB h⟩

theorem monotone_bound_iff {γ a : ℝ} (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) (ha : 0 < a) :
    2 * Real.sqrt (a * (1 - γ)) ≤ 1 - a * γ ↔
      a ≤ 1 / (1 + Real.sqrt (1 - γ)) ^ 2 := by
  let s := Real.sqrt (1 - γ)
  let t := Real.sqrt a
  have hs : 0 ≤ s := Real.sqrt_nonneg _
  have ht : 0 ≤ t := Real.sqrt_nonneg _
  have hs2 : s ^ 2 = 1 - γ := Real.sq_sqrt (by linarith)
  have ht2 : t ^ 2 = a := Real.sq_sqrt ha.le
  have hs1 : s ≤ 1 := by nlinarith
  have hprod : Real.sqrt (a * (1 - γ)) = t * s := by
    exact Real.sqrt_mul ha.le _
  have hfactor : 1 - a * γ - 2 * (t * s) = (1 - t * (1 + s)) * (1 + t * (1 - s)) := by
    have hγ : γ = 1 - s ^ 2 := by linarith
    rw [← ht2, hγ]
    ring
  have hs1sub : 0 ≤ 1 - s := by linarith
  have hfpos : 0 < 1 + t * (1 - s) := by positivity
  have hsqpos : 0 < (1 + s) ^ 2 := by positivity
  have hL : 0 ≤ t * (1 + s) := by positivity
  have hLsq : (t * (1 + s)) ^ 2 = a * (1 + s) ^ 2 := by rw [mul_pow, ht2]
  rw [hprod]
  change 2 * (t * s) ≤ 1 - a * γ ↔ a ≤ 1 / (1 + s) ^ 2
  rw [le_div_iff₀ hsqpos]
  constructor
  · intro hbound
    have hp : 0 ≤ (1 - t * (1 + s)) * (1 + t * (1 - s)) := by linarith
    have hfirst : 0 ≤ 1 - t * (1 + s) := (mul_nonneg_iff_of_pos_right hfpos).mp hp
    nlinarith
  · intro hbound
    have hfirst : 0 ≤ 1 - t * (1 + s) := by nlinarith
    have hp := mul_nonneg hfirst hfpos.le
    linarith

theorem error_nonnegative_iff_monotone_bound {γ a : ℝ} {e : ℕ → ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) (ha : 0 < a)
    (h : ErrorRecurrence (1 - a * γ) (a * (1 - γ)) e) :
    (∀ n, 0 ≤ e n) ↔ a ≤ 1 / (1 + Real.sqrt (1 - γ)) ^ 2 := by
  exact (recurrence_nonnegative_iff (mul_nonneg ha.le (by linarith)) h).trans
    (monotone_bound_iff hγ0 hγ1 ha)

theorem error_antitone_of_nonnegative {γ a : ℝ} {e : ℕ → ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) (ha : 0 < a)
    (h : ErrorRecurrence (1 - a * γ) (a * (1 - γ)) e)
    (he : ∀ n, 0 ≤ e n) : Antitone e := by
  apply antitone_nat_of_succ_le
  intro n
  cases n with
  | zero =>
    rw [h.1, h.2.1]
    nlinarith [mul_nonneg ha.le hγ0]
  | succ n =>
    rw [show n + 1 + 1 = n + 2 by omega, h.2.2 n]
    have hm1 := mul_nonneg (mul_nonneg ha.le hγ0) (he (n + 1))
    have hm2 := mul_nonneg (mul_nonneg ha.le (by linarith : 0 ≤ 1 - γ)) (he n)
    nlinarith

theorem response_and_command_bounds {γ a : ℝ} {e : ℕ → ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) (ha : 0 < a)
    (h : ErrorRecurrence (1 - a * γ) (a * (1 - γ)) e)
    (he : ∀ n, 0 ≤ e n) :
    Monotone (fun n => 1 - e n) ∧ Monotone (fun n => 1 - e (n + 1)) ∧
    (∀ n, 0 ≤ 1 - e n ∧ 1 - e n ≤ 1) ∧
    (∀ n, 0 ≤ 1 - e (n + 1) ∧ 1 - e (n + 1) ≤ 1) := by
  have hanti := error_antitone_of_nonnegative hγ0 hγ1 ha h he
  have hb : ∀ n, e n ≤ 1 := fun n => by simpa only [h.1] using hanti (Nat.zero_le n)
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro m n hmn
    exact sub_le_sub_left (hanti hmn) 1
  · intro m n hmn
    exact sub_le_sub_left (hanti (Nat.add_le_add_right hmn 1)) 1
  · intro n
    constructor <;> linarith [hb n, he n]
  · intro n
    constructor <;> linarith [hb (n + 1), he (n + 1)]

theorem nonnegative_error_summable {γ a : ℝ} {e : ℕ → ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) (ha : 0 < a)
    (h : ErrorRecurrence (1 - a * γ) (a * (1 - γ)) e)
    (he : ∀ n, 0 ≤ e n) : Summable e := by
  have hanti := error_antitone_of_nonnegative hγ0 hγ1 ha h he
  have hA : 0 ≤ 1 - a * γ := by rw [← h.2.1]; exact he 1
  have hstep : ∀ n, e (n + 2) ≤ (1 - a) * e n := by
    intro n
    rw [h.2.2 n]
    have hm := mul_le_mul_of_nonneg_left (hanti (Nat.le_succ n)) hA
    nlinarith
  have ha1 : a ≤ 1 := by
    have hb := hstep 0
    rw [h.1] at hb
    nlinarith [he 2]
  have hev : ∀ n, e (2 * n) ≤ (1 - a) ^ n := by
    intro n
    induction n with
    | zero => simp [h.1]
    | succ n ih =>
      rw [show 2 * (n + 1) = 2 * n + 2 by omega, pow_succ]
      exact (hstep (2 * n)).trans (by
        simpa only [mul_comm] using mul_le_mul_of_nonneg_left ih (by linarith : 0 ≤ 1 - a))
  have hod : ∀ n, e (2 * n + 1) ≤ (1 - a) ^ n := fun n =>
    (hanti (Nat.le_succ _)).trans (hev n)
  have hg := summable_geometric_of_lt_one (by linarith : 0 ≤ 1 - a) (by linarith : 1 - a < 1)
  have hsev : Summable (fun n => e (2 * n)) :=
    Summable.of_nonneg_of_le (fun n => he _) hev hg
  have hsod : Summable (fun n => e (2 * n + 1)) :=
    Summable.of_nonneg_of_le (fun n => he _) hod hg
  exact hsev.even_add_odd hsod

theorem tracking_error_sum {γ a : ℝ} {e : ℕ → ℝ} (ha : 0 < a)
    (h : ErrorRecurrence (1 - a * γ) (a * (1 - γ)) e) (hs : Summable e) :
    (∑' n, e n) = 1 / a := by
  have hsplit1 := hs.sum_add_tsum_nat_add 1
  have hsplit2 := hs.sum_add_tsum_nat_add 2
  simp only [Finset.sum_range_one, h.1] at hsplit1
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add, h.1, h.2.1] at hsplit2
  have hs1 := (summable_nat_add_iff 1).2 hs
  have hr : (∑' n, e (n + 2)) =
      (1 - a * γ) * (∑' n, e (n + 1)) - (a * (1 - γ)) * (∑' n, e n) := by
    simp_rw [h.2.2]
    rw [Summable.tsum_sub (hs1.mul_left _) (hs.mul_left _), tsum_mul_left, tsum_mul_left]
  have ht1 : (∑' n, e (n + 1)) = (∑' n, e n) - 1 := by linarith
  have ht2 : (∑' n, e (n + 2)) = (∑' n, e n) - 1 - (1 - a * γ) := by linarith
  rw [ht1, ht2] at hr
  apply (eq_div_iff (ne_of_gt ha)).mpr
  nlinarith

theorem monotone_tracking_iff {γ a : ℝ} {e : ℕ → ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) (ha : 0 < a)
    (h : ErrorRecurrence (1 - a * γ) (a * (1 - γ)) e) :
    (Monotone (fun n => 1 - e n) ∧
      Tendsto (fun n => 1 - e n) atTop (𝓝 1)) ↔
      a ≤ 1 / (1 + Real.sqrt (1 - γ)) ^ 2 := by
  constructor
  · rintro ⟨hmono, hlim⟩
    apply (error_nonnegative_iff_monotone_bound hγ0 hγ1 ha h).mp
    intro n
    have hb : 1 - e n ≤ 1 := hmono.ge_of_tendsto hlim n
    linarith
  · intro hbound
    have he := (error_nonnegative_iff_monotone_bound hγ0 hγ1 ha h).mpr hbound
    have hmono := (response_and_command_bounds hγ0 hγ1 ha h he).1
    have hs := nonnegative_error_summable hγ0 hγ1 ha h he
    refine ⟨hmono, ?_⟩
    simpa only [sub_zero] using tendsto_const_nhds.sub hs.tendsto_atTop_zero

end C2.MIACE

end

/- ===== C2.MIACEReserve ===== -/

/-!
# Exact gain-reserve optimization

Use `x = sqrt (1 - gamma)`. The constraints below are the monotonicity
bound and the two weak Jury inequalities at the prescribed reserve gain.
This module proves the optimization of these explicit inequalities; the
response-level equivalence is a separate obligation.
-/

noncomputable section

namespace C2.MIACE

def ReserveFeasible (R x a : ℝ) : Prop :=
  0 ≤ x ∧ x ≤ 1 ∧ 0 < a ∧ a * (1 + x) ^ 2 ≤ 1 ∧
    R * a * x ^ 2 ≤ 1 ∧ R * a * (1 - 2 * x ^ 2) ≤ 2

def reserveX (R : ℝ) : ℝ :=
  (Real.sqrt (2 * R * (R - 1)) - 2) / (2 * (R + 1))

def reserveOptimizerX (R : ℝ) : ℝ :=
  if R ≤ 2 then 0 else if R < 9 then reserveX R else 1 / 2

def reserveOptimizerGain (R : ℝ) : ℝ :=
  if R ≤ 2 then 1 else if R < 9 then 1 / (1 + reserveX R) ^ 2 else 4 / R

theorem feasible_gain_le_one {R x a : ℝ} (h : ReserveFeasible R x a) : a ≤ 1 := by
  rcases h with ⟨hx, _, ha, hm, _, _⟩
  have hs : 1 ≤ (1 + x) ^ 2 := by nlinarith
  have hp := mul_le_mul_of_nonneg_left hs ha.le
  nlinarith

theorem feasible_gain_one_unique {R x : ℝ} (h : ReserveFeasible R x 1) : x = 0 := by
  rcases h with ⟨hx, _, _, hm, _, _⟩
  nlinarith

theorem reserve_small_feasible {R : ℝ} (hR : 1 < R) (hR2 : R ≤ 2) :
    ReserveFeasible R 0 1 := by
  constructor
  · norm_num
  constructor
  · norm_num
  constructor
  · norm_num
  constructor
  · norm_num
  constructor
  · norm_num
  · simpa using hR2

theorem feasible_reserved_gain_le_four {R x a : ℝ} (h : ReserveFeasible R x a) :
    R * a ≤ 4 := by
  rcases h with ⟨_, _, _, _, h₁, h₂⟩
  nlinarith

theorem reserve_large_feasible {R : ℝ} (hR : 9 ≤ R) :
    ReserveFeasible R (1 / 2) (4 / R) := by
  have hRp : 0 < R := by linarith
  have hRn : R ≠ 0 := ne_of_gt hRp
  refine ⟨by norm_num, by norm_num, by positivity, ?_, ?_, ?_⟩
  · norm_num
    apply (div_le_iff₀ hRp).mpr
    nlinarith
  · field_simp
    norm_num
  · field_simp
    norm_num

theorem reserve_large_bound {R x a : ℝ} (hR : 9 ≤ R)
    (h : ReserveFeasible R x a) : a ≤ 4 / R := by
  apply (le_div_iff₀ (by linarith : 0 < R)).mpr
  nlinarith [feasible_reserved_gain_le_four h]

theorem reserve_large_unique {R x : ℝ} (hR : 9 ≤ R)
    (h : ReserveFeasible R x (4 / R)) : x = 1 / 2 := by
  have hRn : R ≠ 0 := by linarith
  rcases h with ⟨hx, _, _, _, h₁, h₂⟩
  field_simp [hRn] at h₁ h₂
  nlinarith

theorem reserveX_pos {R : ℝ} (hR : 2 < R) : 0 < reserveX R := by
  have harg : 0 ≤ 2 * R * (R - 1) := mul_nonneg (by linarith) (by linarith)
  have hs := Real.sq_sqrt harg
  have hsn := Real.sqrt_nonneg (2 * R * (R - 1))
  have hroot : 2 < Real.sqrt (2 * R * (R - 1)) := by nlinarith
  dsimp [reserveX]
  exact div_pos (by linarith) (by linarith)

theorem reserveX_lt_half {R : ℝ} (hR : 2 < R) (hR9 : R < 9) :
    reserveX R < 1 / 2 := by
  have harg : 0 ≤ 2 * R * (R - 1) := mul_nonneg (by linarith) (by linarith)
  have hs := Real.sq_sqrt harg
  have hsn := Real.sqrt_nonneg (2 * R * (R - 1))
  have hprod : (R - 9) * (R + 1) < 0 := mul_neg_of_neg_of_pos (by linarith) (by linarith)
  have hroot : Real.sqrt (2 * R * (R - 1)) < R + 3 := by nlinarith
  dsimp [reserveX]
  apply (div_lt_iff₀ (by linarith : 0 < 2 * (R + 1))).mpr
  linarith

theorem reserveX_equation {R : ℝ} (hR : 1 < R) :
    R * (1 - 2 * reserveX R ^ 2) = 2 * (1 + reserveX R) ^ 2 := by
  have harg : 0 ≤ 2 * R * (R - 1) := mul_nonneg (by linarith) (by linarith)
  have hs := Real.sq_sqrt harg
  have hden : 2 * (R + 1) ≠ 0 := by linarith
  generalize hz : Real.sqrt (2 * R * (R - 1)) = z at hs
  unfold reserveX
  rw [hz]
  field_simp [hden]
  nlinarith [congrArg (fun u : ℝ => (R + 1) * u) hs]

theorem reserve_middle_feasible {R : ℝ} (hR : 2 < R) (hR9 : R < 9) :
    ReserveFeasible R (reserveX R) (1 / (1 + reserveX R) ^ 2) := by
  have hx := reserveX_pos hR
  have hxhalf := reserveX_lt_half hR hR9
  have hs : 0 < (1 + reserveX R) ^ 2 := by positivity
  have hn : (1 + reserveX R) ^ 2 ≠ 0 := ne_of_gt hs
  have heq := reserveX_equation (by linarith : 1 < R)
  refine ⟨hx.le, by linarith, one_div_pos.mpr hs, ?_, ?_, ?_⟩
  · rw [one_div, inv_mul_cancel₀ hn]
  · rw [show R * (1 / (1 + reserveX R) ^ 2) * reserveX R ^ 2 =
        (R * reserveX R ^ 2) / (1 + reserveX R) ^ 2 by ring]
    apply (div_le_one hs).mpr
    have hm := mul_nonneg (by linarith : 0 ≤ R)
      (show 0 ≤ 1 - 4 * reserveX R ^ 2 by nlinarith)
    nlinarith
  · have hmul : R * (1 / (1 + reserveX R) ^ 2) * (1 - 2 * reserveX R ^ 2) = 2 := by
      field_simp [hn]
      nlinarith [heq]
    exact hmul.le

/-- Two opposing active constraints give the unique optimum, including
designs on either side of their intersection. -/
theorem reserve_intersection_bound {R q b x a : ℝ}
    (hR : 0 < R) (hq : 0 ≤ q) (hqh : q < 1 / 2) (hb : 0 < b)
    (hbmon : b * (1 + q) ^ 2 = 1)
    (hbres : R * b * (1 - 2 * q ^ 2) = 2)
    (h : ReserveFeasible R x a) : a ≤ b := by
  rcases h with ⟨hx, _, ha, hm, _, hr⟩
  by_cases hxq : q ≤ x
  · have hs : (1 + q) ^ 2 ≤ (1 + x) ^ 2 := by nlinarith
    have ham : a * (1 + q) ^ 2 ≤ 1 :=
      (mul_le_mul_of_nonneg_left hs ha.le).trans hm
    have hp : 0 < (1 + q) ^ 2 := by positivity
    exact (mul_le_mul_right hp).mp (by linarith)
  · have hxq' : x ≤ q := le_of_lt (lt_of_not_ge hxq)
    have hs : 1 - 2 * q ^ 2 ≤ 1 - 2 * x ^ 2 := by nlinarith
    have har : R * a * (1 - 2 * q ^ 2) ≤ 2 :=
      (mul_le_mul_of_nonneg_left hs (mul_pos hR ha).le).trans hr
    have hp : 0 < R * (1 - 2 * q ^ 2) := by
      apply mul_pos hR
      nlinarith
    apply (mul_le_mul_right hp).mp
    nlinarith [har, hbres]

theorem reserve_intersection_unique {R q b x : ℝ}
    (hR : 0 < R) (hq : 0 ≤ q) (hqh : q < 1 / 2) (hb : 0 < b)
    (hbmon : b * (1 + q) ^ 2 = 1)
    (hbres : R * b * (1 - 2 * q ^ 2) = 2)
    (h : ReserveFeasible R x b) : x = q := by
  rcases h with ⟨hx, _, _, hm, _, hr⟩
  have hmon : (1 + x) ^ 2 ≤ (1 + q) ^ 2 :=
    (mul_le_mul_left hb).mp (by linarith)
  have hres : 1 - 2 * x ^ 2 ≤ 1 - 2 * q ^ 2 :=
    (mul_le_mul_left (mul_pos hR hb)).mp (by linarith)
  nlinarith

/-- Explicit feasible maximizer and uniqueness of its `x` coordinate. -/
theorem reserve_three_regime_optimizer {R : ℝ} (hR : 1 < R) :
    ReserveFeasible R (reserveOptimizerX R) (reserveOptimizerGain R) ∧
    (∀ x a, ReserveFeasible R x a → a ≤ reserveOptimizerGain R) ∧
    (∀ x, ReserveFeasible R x (reserveOptimizerGain R) → x = reserveOptimizerX R) := by
  by_cases hR2 : R ≤ 2
  · simp only [reserveOptimizerX, reserveOptimizerGain, if_pos hR2]
    exact ⟨reserve_small_feasible hR hR2,
      fun _ _ h => feasible_gain_le_one h, fun _ h => feasible_gain_one_unique h⟩
  · by_cases hR9 : R < 9
    · simp only [reserveOptimizerX, reserveOptimizerGain, if_neg hR2, if_pos hR9]
      have hR2' : 2 < R := lt_of_not_ge hR2
      have hx := reserveX_pos hR2'
      have hxh := reserveX_lt_half hR2' hR9
      have hfeas := reserve_middle_feasible hR2' hR9
      have hs : 0 < (1 + reserveX R) ^ 2 := by positivity
      have hm : (1 / (1 + reserveX R) ^ 2) * (1 + reserveX R) ^ 2 = 1 := by
        field_simp
      have hr : R * (1 / (1 + reserveX R) ^ 2) * (1 - 2 * reserveX R ^ 2) = 2 := by
        have heq := reserveX_equation hR
        field_simp
        nlinarith [heq]
      exact ⟨hfeas, fun _ _ h => reserve_intersection_bound (by linarith) hx.le hxh
        (one_div_pos.mpr hs) hm hr h,
        fun _ h => reserve_intersection_unique (by linarith) hx.le hxh
          (one_div_pos.mpr hs) hm hr h⟩
    · have hR9' : 9 ≤ R := le_of_not_gt hR9
      simp only [reserveOptimizerX, reserveOptimizerGain, if_neg hR2, if_neg hR9]
      exact ⟨reserve_large_feasible hR9', fun _ _ h => reserve_large_bound hR9' h,
        fun _ h => reserve_large_unique hR9' h⟩

end C2.MIACE

end

/- ===== C2.MIACEResponse ===== -/

/-! Exact absolute areas and their relation to the reserve optimization. -/

noncomputable section
open scoped BigOperators Topology
open Filter

namespace C2.MIACE

theorem monotone_response_areas {γ a T η : ℝ} {e v : ℕ → ℝ}
    (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) (ha : 0 < a) (hT : 0 ≤ T)
    (h : ErrorRecurrence (1 - a * γ) (a * (1 - γ)) e)
    (hv : ∀ n, v n = -e (n + 1))
    (hbound : a ≤ 1 / (1 + Real.sqrt (1 - γ)) ^ 2) :
    area T e = T / a ∧ area T v = T * (1 / a - 1) ∧
      cost η (area T e) (area T v) =
        T * Real.sqrt ((1 / a) ^ 2 + η * (1 / a - 1) ^ 2) := by
  have he := (error_nonnegative_iff_monotone_bound hγ0 hγ1 ha h).mpr hbound
  have hs := nonnegative_error_summable hγ0 hγ1 ha h he
  have hsum := tracking_error_sum ha h hs
  have hAe : area T e = T / a := by
    dsimp [area]
    simp_rw [abs_of_nonneg (he _)]
    rw [hsum]
    ring
  have hsabs : Summable (fun n => |e n|) := by
    simpa only [abs_of_nonneg (he _)] using hs
  have harea := pure_delay_area_identity T 1 e v hsabs
    (fun n hn => by
      have hn0 : n = 0 := by omega
      simpa only [hn0] using h.1) hv
  have hAu : area T v = T * (1 / a - 1) := by
    rw [hAe] at harea
    norm_num at harea
    calc
      area T v = T / a - T := by linarith
      _ = T * (1 / a - 1) := by ring
  refine ⟨hAe, hAu, ?_⟩
  rw [hAe, hAu, div_eq_mul_one_div, cost_mul hT]
  rfl

def nominalCost (η T a : ℝ) : ℝ := cost η (T / a) (T * (1 / a - 1))

/-- The MIACE objective has the opposite order to gain throughout the
monotone region; this includes equality and therefore uniqueness. -/
theorem nominalCost_le_iff {η T a b : ℝ} (hη : 0 < η) (hT : 0 < T)
    (ha : 0 < a) (ha1 : a ≤ 1) (hb : 0 < b) (hb1 : b ≤ 1) :
    nominalCost η T a ≤ nominalCost η T b ↔ b ≤ a := by
  have hAe : T ≤ T / a := by
    apply (le_div_iff₀ ha).mpr
    nlinarith [mul_le_mul_of_nonneg_left ha1 hT.le]
  have hBe : T ≤ T / b := by
    apply (le_div_iff₀ hb).mpr
    nlinarith [mul_le_mul_of_nonneg_left hb1 hT.le]
  have hae : T * (1 / a - 1) = T / a - T := by ring
  have hbe : T * (1 / b - 1) = T / b - T := by ring
  unfold nominalCost
  rw [hae, hbe, cost_le_cost_iff_on_delay_line hη hT.le hAe hBe]
  exact div_le_div_iff_of_pos_left hT ha hb

theorem nominalCost_unique_reserve_minimum {η T R : ℝ}
    (hη : 0 < η) (hT : 0 < T) (hR : 1 < R) :
    ReserveFeasible R (reserveOptimizerX R) (reserveOptimizerGain R) ∧
    (∀ x a, ReserveFeasible R x a →
      nominalCost η T (reserveOptimizerGain R) ≤ nominalCost η T a) ∧
    (∀ x a, ReserveFeasible R x a →
      nominalCost η T a ≤ nominalCost η T (reserveOptimizerGain R) →
      x = reserveOptimizerX R ∧ a = reserveOptimizerGain R) := by
  obtain ⟨hf, hb, hu⟩ := reserve_three_regime_optimizer hR
  have hag := hf.2.2.1
  have hag1 := feasible_gain_le_one hf
  refine ⟨hf, ?_, ?_⟩
  · intro x a h
    exact (nominalCost_le_iff hη hT hag hag1 h.2.2.1 (feasible_gain_le_one h)).mpr (hb x a h)
  · intro x a h hcost
    have hga := (nominalCost_le_iff hη hT h.2.2.1 (feasible_gain_le_one h) hag hag1).mp hcost
    have heq : a = reserveOptimizerGain R := le_antisymm (hb x a h) hga
    exact ⟨hu x (by simpa only [← heq] using h), heq⟩

theorem reserve_transition_two : reserveX 2 = 0 := by
  norm_num [reserveX]

theorem reserve_transition_nine : reserveX 9 = 1 / 2 := by
  norm_num [reserveX]

theorem reserve_gamma_large {R : ℝ} (hR : 9 ≤ R) :
    1 - reserveOptimizerX R ^ 2 = 3 / 4 ∧ reserveOptimizerGain R = 4 / R := by
  have hR2 : ¬ R ≤ 2 := by linarith
  have hR9 : ¬ R < 9 := not_lt.mpr hR
  norm_num [reserveOptimizerX, reserveOptimizerGain, hR2, hR9]

end C2.MIACE

end

/- ===== C2.RegionCompletionFirstOrder ===== -/

noncomputable section
namespace C2.FirstOrder

def U₁ (r γ : ℝ) : ℝ := (1 + r * γ) / (1 - γ)
def U₂ (r γ : ℝ) : ℝ := r + 2 / (2 * γ - 1)

theorem stable_lower_half_iff {r γ a : ℝ} (hr : 0 ≤ r)
    (hγ : 0 ≤ γ) (hγh : γ < 1/2) :
    Stable r γ a ↔ max 0 (r - 2 / (1 - 2 * γ)) < a ∧ a < U₁ r γ := by
  have hd : 0 < 1 - γ := by linarith
  have hq : 0 < 1 - 2 * γ := by linarith
  rw [stable_iff_jury hr hγ]
  unfold Jury U₁
  rw [max_lt_iff, lt_div_iff₀ hd]
  have hl : r - 2 / (1 - 2 * γ) < a ↔ 0 < 2 + (2 * γ - 1) * (r - a) := by
    calc
      r - 2 / (1 - 2 * γ) < a ↔ r - a < 2 / (1 - 2 * γ) := by constructor <;> intro h <;> linarith only [h]
      _ ↔ (r - a) * (1 - 2 * γ) < 2 := lt_div_iff₀ hq
      _ ↔ 0 < 2 + (2 * γ - 1) * (r - a) := by constructor <;> intro h <;> nlinarith
  rw [hl]
  constructor
  · rintro ⟨ha,h₁,h₂⟩
    exact ⟨⟨ha,h₁⟩,by linarith⟩
  · rintro ⟨⟨ha,h₁⟩,h₂⟩
    exact ⟨ha,h₁,by linarith⟩

theorem stable_half_iff {r a : ℝ} (hr : 0 ≤ r) :
    Stable r (1/2) a ↔ 0 < a ∧ a < r + 2 := by
  rw [stable_iff_jury hr (by norm_num)]
  unfold Jury
  constructor
  · rintro ⟨ha,h₁,h₂⟩
    exact ⟨ha,by nlinarith⟩
  · rintro ⟨ha,h⟩
    exact ⟨ha,by norm_num,by nlinarith⟩

theorem stable_upper_half_iff {r γ a : ℝ} (hr : 0 ≤ r)
    (hγh : 1/2 < γ) (hγ1 : γ < 1) :
    Stable r γ a ↔ 0 < a ∧ a < min (U₁ r γ) (U₂ r γ) := by
  have hd : 0 < 1 - γ := by linarith
  have hq : 0 < 2 * γ - 1 := by linarith
  rw [stable_iff_jury hr (by linarith)]
  unfold Jury U₁ U₂
  rw [lt_min_iff, lt_div_iff₀ hd]
  have hu : a < r + 2 / (2 * γ - 1) ↔ 0 < 2 + (2 * γ - 1) * (r - a) := by
    calc
      a < r + 2 / (2 * γ - 1) ↔ a - r < 2 / (2 * γ - 1) := by constructor <;> intro h <;> linarith only [h]
      _ ↔ (a - r) * (2 * γ - 1) < 2 := lt_div_iff₀ hq
      _ ↔ 0 < 2 + (2 * γ - 1) * (r - a) := by constructor <;> intro h <;> nlinarith
  rw [hu]
  constructor <;> rintro ⟨ha, h₁, h₂⟩ <;> exact ⟨ha, by linarith, by linarith⟩

theorem stable_one_iff {r a : ℝ} (hr : 0 ≤ r) :
    Stable r 1 a ↔ 0 < a ∧ a < r + 2 := by
  rw [stable_iff_jury hr (by norm_num)]
  unfold Jury
  constructor
  · rintro ⟨ha,h₁,h₂⟩
    exact ⟨ha,by nlinarith⟩
  · rintro ⟨ha,h⟩
    exact ⟨ha,by nlinarith,by nlinarith⟩

theorem lower_half_interval_nonempty {r γ : ℝ} (hr : 0 ≤ r)
    (hγ : 0 ≤ γ) (hγh : γ < 1/2) :
    (∃ a : ℝ, Stable r γ a) ↔ r < (1 + 2 * (1 - 2 * γ)) / (1 - 2 * γ)^2 := by
  have hd : 0 < 1 - γ := by linarith
  have hq : 0 < 1 - 2 * γ := by linarith
  have hu : 0 < U₁ r γ := div_pos (by nlinarith [mul_nonneg hr hγ]) hd
  have hid : U₁ r γ - (r - 2 / (1 - 2 * γ)) =
      (1 + 2 * (1 - 2 * γ) - r * (1 - 2 * γ)^2) / ((1 - 2 * γ) * (1 - γ)) := by
    unfold U₁
    field_simp [ne_of_gt hd, ne_of_gt hq]
    <;> ring
  have hb : (∃ a : ℝ, Stable r γ a) ↔ max 0 (r - 2/(1-2*γ)) < U₁ r γ := by
    constructor
    · rintro ⟨a,ha⟩
      obtain ⟨hl,hh⟩ := (stable_lower_half_iff hr hγ hγh).mp ha
      exact hl.trans hh
    · intro h
      obtain ⟨a,hl,hh⟩ := exists_between h
      exact ⟨a,(stable_lower_half_iff hr hγ hγh).mpr ⟨hl,hh⟩⟩
  rw [hb, max_lt_iff, and_iff_right hu]
  rw [← sub_pos, hid, div_pos_iff_of_pos_right (mul_pos hq hd)]
  rw [lt_div_iff₀ (sq_pos_of_pos hq)]
  constructor <;> intro h <;> nlinarith

/-- The paper's complete piecewise one-sample threshold. -/
noncomputable def oneSampleThreshold (γ : ℝ) : ℝ :=
  if γ ≤ 3/4 then 1 / (1 - γ) else 2 / (2 * γ - 1)

theorem integrator_lower_branch {γ a : ℝ} (hγ : 0 ≤ γ) (hγq : γ ≤ 3/4) :
    Stable 0 γ a ↔ 0 < a ∧ a < 1 / (1 - γ) := by
  have hd : 0 < 1 - γ := by linarith
  rw [stable_iff_jury (by norm_num) hγ, lt_div_iff₀ hd]
  unfold Jury
  constructor
  · rintro ⟨ha,h₁,h₂⟩
    exact ⟨ha,by nlinarith⟩
  · rintro ⟨ha,h⟩
    have hc := mul_nonneg ha.le (show 0 ≤ 3 - 4 * γ by linarith)
    exact ⟨ha,by nlinarith,by nlinarith⟩

theorem integrator_upper_branch {γ a : ℝ} (hγq : 3/4 ≤ γ) (hγ1 : γ ≤ 1) :
    Stable 0 γ a ↔ 0 < a ∧ a < 2 / (2 * γ - 1) := by
  have hd : 0 < 2 * γ - 1 := by linarith
  rw [stable_iff_jury (by norm_num) (by linarith), lt_div_iff₀ hd]
  unfold Jury
  constructor
  · rintro ⟨ha,h₁,h₂⟩
    exact ⟨ha,by nlinarith⟩
  · rintro ⟨ha,h⟩
    have hc := mul_nonneg ha.le (show 0 ≤ 4 * γ - 3 by linarith)
    exact ⟨ha,by nlinarith,by nlinarith⟩

theorem integrator_piecewise_region {γ a : ℝ} (hγ : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    Stable 0 γ a ↔ 0 < a ∧ a < oneSampleThreshold γ := by
  unfold oneSampleThreshold
  split_ifs with h
  · exact integrator_lower_branch hγ h
  · exact integrator_upper_branch (by linarith) hγ1

theorem oneSampleThreshold_unique_max {γ : ℝ} (hγ : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    oneSampleThreshold γ ≤ 4 ∧ (oneSampleThreshold γ = 4 ↔ γ = 3/4) := by
  unfold oneSampleThreshold
  split_ifs with h
  · have hd : 0 < 1 - γ := by linarith
    constructor
    · rw [div_le_iff₀ hd]
      linarith
    · rw [div_eq_iff (ne_of_gt hd)]
      constructor <;> intro he <;> linarith
  · have hd : 0 < 2 * γ - 1 := by linarith
    constructor
    · rw [div_le_iff₀ hd]
      linarith
    · rw [div_eq_iff (ne_of_gt hd)]
      constructor <;> intro he <;> linarith

theorem oneSampleThreshold_pos {γ : ℝ} (hγ : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    0 < oneSampleThreshold γ := by
  unfold oneSampleThreshold
  split_ifs with h
  · exact div_pos (by norm_num) (by linarith)
  · exact div_pos (by norm_num) (by linarith)

theorem oneSampleThreshold_isLUB {γ : ℝ} (hγ : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    IsLUB {a : ℝ | Stable 0 γ a} (oneSampleThreshold γ) := by
  have he : {a : ℝ | Stable 0 γ a} = Set.Ioo 0 (oneSampleThreshold γ) := by
    ext a
    exact integrator_piecewise_region hγ hγ1
  rw [he]
  exact isLUB_Ioo (oneSampleThreshold_pos hγ hγ1)

theorem le_oneSampleThreshold_iff {γ a : ℝ} (hγ : 0 ≤ γ) (hγ1 : γ ≤ 1)
    (ha : 0 ≤ a) :
    a ≤ oneSampleThreshold γ ↔ a*(1-γ) ≤ 1 ∧ a*(2*γ-1) ≤ 2 := by
  unfold oneSampleThreshold
  split_ifs with h
  · rw [le_div_iff₀ (show 0 < 1-γ by linarith)]
    have hc := mul_nonneg ha (show 0 ≤ 3-4*γ by linarith)
    constructor
    · intro hb
      exact ⟨hb,by nlinarith⟩
    · exact And.left
  · rw [le_div_iff₀ (show 0 < 2*γ-1 by linarith)]
    have hc := mul_nonneg ha (show 0 ≤ 4*γ-3 by linarith)
    constructor
    · intro hb
      exact ⟨by nlinarith,hb⟩
    · exact And.right

end C2.FirstOrder


end

/- ===== C2.MIACEComplete ===== -/

/-! The reserve optimizer for the actual zero-state unit-step recurrence. -/

noncomputable section
open scoped Topology
open Filter

namespace C2.MIACE

def errorPair (A B : ℝ) : ℕ → ℝ × ℝ
  | 0 => (1, A)
  | n + 1 => let p := errorPair A B n; (p.2, A * p.2 - B * p.1)

def unitStepError (γ a : ℝ) (n : ℕ) : ℝ :=
  (errorPair (1 - a * γ) (a * (1 - γ)) n).1

theorem unitStepError_recurrence (γ a : ℝ) :
    ErrorRecurrence (1 - a * γ) (a * (1 - γ)) (unitStepError γ a) := by
  refine ⟨rfl, rfl, fun n => ?_⟩
  rfl

def admissibleDesign (R γ a : ℝ) : Prop :=
  0 ≤ γ ∧ γ ≤ 1 ∧ 0 < a ∧
    Monotone (fun n => 1 - unitStepError γ a n) ∧
    Tendsto (fun n => 1 - unitStepError γ a n) atTop (𝓝 1) ∧
    R ≤ C2.FirstOrder.oneSampleThreshold γ / a

def responseCost (η T γ a : ℝ) : ℝ :=
  cost η (area T (unitStepError γ a)) (area T (fun n => -unitStepError γ a (n + 1)))

def reserveOptimizerGamma (R : ℝ) : ℝ := 1 - reserveOptimizerX R ^ 2

theorem reserve_parameters_eq (R : ℝ) :
    (reserveOptimizerGamma R, reserveOptimizerGain R) =
      if R ≤ 2 then (1, 1)
      else if R < 9 then (1 - reserveX R ^ 2, 1 / (1 + reserveX R) ^ 2)
      else (3 / 4, 4 / R) := by
  unfold reserveOptimizerGamma reserveOptimizerX reserveOptimizerGain
  split_ifs <;> norm_num

theorem reserve_formula_endpoint_agreement :
    (1 - reserveX 2 ^ 2, 1 / (1 + reserveX 2) ^ 2) = ((1 : ℝ), (1 : ℝ)) ∧
    (1 - reserveX 9 ^ 2, 1 / (1 + reserveX 9) ^ 2) = ((3 / 4 : ℝ), (4 / 9 : ℝ)) := by
  rw [reserve_transition_two, reserve_transition_nine]
  norm_num

theorem admissible_iff_reserveFeasible {R γ a : ℝ}
    (hR : 0 ≤ R) (hγ0 : 0 ≤ γ) (hγ1 : γ ≤ 1) (ha : 0 < a) :
    admissibleDesign R γ a ↔ ReserveFeasible R (Real.sqrt (1 - γ)) a := by
  let x := Real.sqrt (1 - γ)
  have hx : 0 ≤ x := Real.sqrt_nonneg _
  have hx2 : x ^ 2 = 1 - γ := Real.sq_sqrt (by linarith)
  have hx1 : x ≤ 1 := by nlinarith
  have hp : 0 < (1 + x) ^ 2 := by positivity
  have hmon := monotone_tracking_iff hγ0 hγ1 ha (unitStepError_recurrence γ a)
  have hreserve : R ≤ C2.FirstOrder.oneSampleThreshold γ / a ↔
      R * a * x ^ 2 ≤ 1 ∧ R * a * (1 - 2 * x ^ 2) ≤ 2 := by
    rw [le_div_iff₀ ha, C2.FirstOrder.le_oneSampleThreshold_iff hγ0 hγ1 (mul_nonneg hR ha.le)]
    rw [hx2]
    ring_nf
  constructor
  · rintro ⟨_, _, _, hm, hl, hr⟩
    have hma := hmon.mp ⟨hm, hl⟩
    have hbound : a * (1 + x) ^ 2 ≤ 1 := (le_div_iff₀ hp).mp hma
    exact ⟨hx, hx1, ha, hbound, (hreserve.mp hr).1, (hreserve.mp hr).2⟩
  · rintro ⟨_, _, _, hm, hr₁, hr₂⟩
    have hma : a ≤ 1 / (1 + x) ^ 2 := (le_div_iff₀ hp).mpr hm
    have ht := hmon.mpr hma
    exact ⟨hγ0, hγ1, ha, ht.1, ht.2, hreserve.mpr ⟨hr₁, hr₂⟩⟩

theorem reserved_uncertain_gain_stable {R γ a q : ℝ}
    (h : admissibleDesign R γ a) (hq0 : 0 < q) (hqR : q < R) :
    C2.FirstOrder.Stable 0 γ (q * a) := by
  rw [C2.FirstOrder.integrator_piecewise_region h.1 h.2.1]
  have ha := h.2.2.1
  have hmargin := (le_div_iff₀ ha).mp h.2.2.2.2.2
  exact ⟨mul_pos hq0 ha, (mul_lt_mul_of_pos_right hqR ha).trans_le hmargin⟩

theorem reserveFeasible_to_admissible {R x a : ℝ}
    (hR : 0 ≤ R) (h : ReserveFeasible R x a) : admissibleDesign R (1 - x ^ 2) a := by
  have hγ0 : 0 ≤ 1 - x ^ 2 := by nlinarith [h.1, h.2.1]
  have hγ1 : 1 - x ^ 2 ≤ 1 := by nlinarith [sq_nonneg x]
  apply (admissible_iff_reserveFeasible hR hγ0 hγ1 h.2.2.1).mpr
  have hs : Real.sqrt (1 - (1 - x ^ 2)) = x := by
    rw [show 1 - (1 - x ^ 2) = x ^ 2 by ring, Real.sqrt_sq h.1]
  simpa only [hs] using h

theorem responseCost_eq_nominalCost {R γ a η T : ℝ} (hT : 0 ≤ T)
    (h : admissibleDesign R γ a) : responseCost η T γ a = nominalCost η T a := by
  have hbound := (monotone_tracking_iff h.1 h.2.1 h.2.2.1
    (unitStepError_recurrence γ a)).mp ⟨h.2.2.2.1, h.2.2.2.2.1⟩
  obtain ⟨he, hv, _⟩ := monotone_response_areas h.1 h.2.1 h.2.2.1 hT
    (η := η) (unitStepError_recurrence γ a) (fun n => rfl) hbound
  unfold responseCost nominalCost
  rw [he, hv]

/-- A literal unique optimizer for the actual-response absolute-area MIACE
criterion under monotonicity and the true critical-gain ratio. The threshold
is separately proved to be the supremum of the actual-root stable gains. -/
theorem exact_monotone_miace_reserve_optimizer {R η T : ℝ}
    (hR : 1 < R) (hη : 0 < η) (hT : 0 < T) :
    admissibleDesign R (reserveOptimizerGamma R) (reserveOptimizerGain R) ∧
    (∀ γ a, admissibleDesign R γ a →
      responseCost η T (reserveOptimizerGamma R) (reserveOptimizerGain R) ≤
        responseCost η T γ a) ∧
    (∀ γ a, admissibleDesign R γ a →
      responseCost η T γ a ≤
        responseCost η T (reserveOptimizerGamma R) (reserveOptimizerGain R) →
      γ = reserveOptimizerGamma R ∧ a = reserveOptimizerGain R) := by
  obtain ⟨hf, hmin, huniq⟩ := nominalCost_unique_reserve_minimum hη hT hR
  have hR0 : 0 ≤ R := by linarith
  have hadm := reserveFeasible_to_admissible hR0 hf
  change admissibleDesign R (reserveOptimizerGamma R) (reserveOptimizerGain R) at hadm
  refine ⟨hadm, ?_, ?_⟩
  · intro γ a h
    have hg := (admissible_iff_reserveFeasible hR0 h.1 h.2.1 h.2.2.1).mp h
    rw [responseCost_eq_nominalCost hT.le hadm, responseCost_eq_nominalCost hT.le h]
    exact hmin _ _ hg
  · intro γ a h hc
    have hg := (admissible_iff_reserveFeasible hR0 h.1 h.2.1 h.2.2.1).mp h
    rw [responseCost_eq_nominalCost hT.le h, responseCost_eq_nominalCost hT.le hadm] at hc
    obtain ⟨hx, ha⟩ := huniq _ _ hg hc
    refine ⟨?_, ha⟩
    have hs := Real.sq_sqrt (show 0 ≤ 1 - γ by linarith [h.2.1])
    rw [hx] at hs
    dsimp [reserveOptimizerGamma]
    linarith

end C2.MIACE

end

/- ===== C2.MIACEDelay ===== -/

/-! Literal zero-prehistory pure-delay plant and its MIACE minimizers. -/
noncomputable section

namespace C2.MIACE

def delayedOutput (d : ℕ) (w : ℕ → ℝ) (n : ℕ) : ℝ :=
  if n < d then 0 else w (n - d)

def delayedError (d : ℕ) (w : ℕ → ℝ) (n : ℕ) : ℝ := 1 - delayedOutput d w n

def centeredCommand (w : ℕ → ℝ) (n : ℕ) : ℝ := w n - 1

theorem pure_delay_initial_error (d : ℕ) (w : ℕ → ℝ) (n : ℕ) (hn : n < d) :
    delayedError d w n = 1 := by simp [delayedError, delayedOutput, hn]

theorem pure_delay_timing (d : ℕ) (w : ℕ → ℝ) (n : ℕ) :
    centeredCommand w n = -delayedError d w (n + d) := by
  have hn : ¬ n + d < d := by omega
  simp [centeredCommand, delayedError, delayedOutput, hn]

theorem pure_delay_plant_area_identity (T : ℝ) (d : ℕ) (w : ℕ → ℝ)
    (hs : Summable (fun n => |delayedError d w n|)) :
    area T (delayedError d w) = (d : ℝ) * T + area T (centeredCommand w) :=
  pure_delay_area_identity T d _ _ hs (pure_delay_initial_error d w) (pure_delay_timing d w)

theorem pure_delay_command_summable (d : ℕ) (w : ℕ → ℝ)
    (hs : Summable (fun n => |delayedError d w n|)) :
    Summable (fun n => |centeredCommand w n|) := by
  have ht := (summable_nat_add_iff d).mpr hs
  apply ht.congr
  intro n
  rw [pure_delay_timing d w n, abs_neg]

theorem pure_delay_plant_minimizer_iff {ι : Type*} (S : Set ι)
    (w : ι → ℕ → ℝ) (d : ℕ) {T η : ℝ} (hT : 0 ≤ T) (hη : 0 < η)
    (hs : ∀ i ∈ S, Summable (fun n => |delayedError d (w i) n|)) (i : ι) (hi : i ∈ S) :
    (∀ j ∈ S, cost η (area T (delayedError d (w i))) (area T (centeredCommand (w i))) ≤
      cost η (area T (delayedError d (w j))) (area T (centeredCommand (w j)))) ↔
    (∀ j ∈ S, area T (delayedError d (w i)) ≤ area T (delayedError d (w j))) := by
  apply pure_delay_minimizer_iff S _ _ hη (mul_nonneg (Nat.cast_nonneg d) hT)
    (fun j _ => area_nonneg hT _) _ i hi
  intro j hj
  exact pure_delay_plant_area_identity T d (w j) (hs j hj)

end C2.MIACE

end

/- ===== C2.MIACEStateTail ===== -/

/-! The manuscript's exact remainder constant from a state-space envelope. -/

noncomputable section

namespace C2.MIACE

theorem state_output_tail_bound {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    (x : ℕ → V) (ce cu : V →L[ℝ] ℝ)
    {T Tmax C E U q η : ℝ} (hT : 0 ≤ T) (hTmax : T ≤ Tmax)
    (hq0 : 0 < q) (hq1 : q < 1) (hη : 0 ≤ η)
    (hx : ∀ n, ‖x n‖ ≤ C * q ^ n) (he : ‖ce‖ ≤ E) (hu : ‖cu‖ ≤ U) (N : ℕ) :
    0 ≤ cost η (area T (fun n => ce (x n))) (area T (fun n => cu (x n))) -
      cost η (partialArea T (fun n => ce (x n)) N) (partialArea T (fun n => cu (x n)) N) ∧
    cost η (area T (fun n => ce (x n))) (area T (fun n => cu (x n))) -
      cost η (partialArea T (fun n => ce (x n)) N) (partialArea T (fun n => cu (x n)) N) ≤
        (Tmax * C * q ^ N / (1 - q)) * Real.sqrt (E ^ 2 + η * U ^ 2) := by
  have hC : 0 ≤ C := by simpa using (norm_nonneg (x 0)).trans (hx 0)
  have hE : 0 ≤ E := (norm_nonneg ce).trans he
  have hU : 0 ≤ U := (norm_nonneg cu).trans hu
  have hbe : ∀ n, |ce (x n)| ≤ (C * E) * q ^ n := by
    intro n
    calc
      |ce (x n)| = ‖ce (x n)‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖ce‖ * ‖x n‖ := ce.le_opNorm _
      _ ≤ E * (C * q ^ n) := mul_le_mul he (hx n) (norm_nonneg _) hE
      _ = (C * E) * q ^ n := by ring
  have hbu : ∀ n, |cu (x n)| ≤ (C * U) * q ^ n := by
    intro n
    calc
      |cu (x n)| = ‖cu (x n)‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖cu‖ * ‖x n‖ := cu.le_opNorm _
      _ ≤ U * (C * q ^ n) := mul_le_mul hu (hx n) (norm_nonneg _) hU
      _ = (C * U) * q ^ n := by ring
  obtain ⟨hl, hr⟩ := miace_tail_bound hT hTmax (mul_nonneg hC hE) (mul_nonneg hC hU)
    hq0.le hq1 hη hbe hbu N
  refine ⟨hl, ?_⟩
  have hcost : Real.sqrt ((C * E) ^ 2 + η * (C * U) ^ 2) =
      C * Real.sqrt (E ^ 2 + η * U ^ 2) := cost_mul hC E U
  rw [hcost] at hr
  convert hr using 1 <;> ring

end C2.MIACE

end

/- ===== C2.NGammaAllocation ===== -/

/-!
# Fixed-frequency allocation calculus

Definitions below are the phase, logarithmic magnitude, and marginal slope of
the actual one-factor frequency response.  They are not abstract surrogates.
-/
noncomputable section
open scoped BigOperators
namespace C2.NGamma

def allocationPhase (r x w : ℝ) : ℝ :=
  Real.arctan ((x+2/r)/w) - Real.arctan (x/w)

def allocationLogGain (r x w : ℝ) : ℝ :=
  (Real.log ((r*x+2)^2+(r*w)^2) - Real.log (x^2+w^2))/2

def allocationMarginal (r x w : ℝ) : ℝ :=
  (r*(x^2-w^2)+2*x)/(2*w*(r*x+1))

def phaseDerivative (r x w : ℝ) : ℝ :=
  -4*w*(r*x+1)/(((r*x+2)^2+r^2*w^2)*(x^2+w^2))

theorem allocationPhase_hasDerivAt {r w : ℝ} (hr : 0 < r) (hw : 0 < w) (x : ℝ) :
    HasDerivAt (fun x => allocationPhase r x w) (phaseDerivative r x w) x := by
  have h := ((((hasDerivAt_id x).add_const (2/r)).div_const w).arctan).sub
    (((hasDerivAt_id x).div_const w).arctan)
  unfold allocationPhase phaseDerivative
  convert h using 1
  have hD : 0 < x^2+w^2 := by positivity
  have hN : 0 < (r*x+2)^2+r^2*w^2 := by positivity
  have hA : 0 < 1+((x+2/r)/w)^2 := by positivity
  have hB : 0 < 1+(x/w)^2 := by positivity
  field_simp
  <;> ring

theorem phaseDerivative_neg {r w x : ℝ} (hr : 0 < r) (hw : 0 < w) (hx : 0 ≤ x) :
    phaseDerivative r x w < 0 := by
  unfold phaseDerivative
  apply div_neg_of_neg_of_pos
  · have h : 0 < r*x+1 := by positivity
    nlinarith
  · positivity

theorem allocationPhase_continuous {r w : ℝ} : Continuous (fun x => allocationPhase r x w) := by
  unfold allocationPhase
  continuity

theorem allocationPhase_strictAntiOn {r w : ℝ} (hr : 0 < r) (hw : 0 < w) :
    StrictAntiOn (fun x => allocationPhase r x w) (Set.Ici 0) := by
  apply strictAntiOn_of_deriv_neg (convex_Ici _) allocationPhase_continuous.continuousOn
  intro x hx
  rw [(allocationPhase_hasDerivAt hr hw x).deriv]
  exact phaseDerivative_neg hr hw (le_of_lt (by simpa using hx))

theorem allocationMarginal_difference {r w x y : ℝ} (hw : w ≠ 0)
    (hx : r*x+1 ≠ 0) (hy : r*y+1 ≠ 0) :
    allocationMarginal r y w-allocationMarginal r x w =
      (y-x)*(r^2*x*y+r*(x+y)+2+r^2*w^2)/(2*w*(r*x+1)*(r*y+1)) := by
  unfold allocationMarginal
  field_simp
  <;> ring

theorem allocationMarginal_strictMonoOn {r w : ℝ} (hr : 0 < r) (hw : 0 < w) :
    StrictMonoOn (fun x => allocationMarginal r x w) (Set.Ici 0) := by
  intro x hx y hy hxy
  have hx0 : 0 ≤ x := hx
  have hy0 : 0 ≤ y := hy
  have hxp : 0 < r*x+1 := by positivity
  have hyp : 0 < r*y+1 := by positivity
  have hd := allocationMarginal_difference (ne_of_gt hw) (ne_of_gt hxp) (ne_of_gt hyp)
  have hn : 0 < r^2*x*y+r*(x+y)+2+r^2*w^2 := by positivity
  have hs : 0 < allocationMarginal r y w-allocationMarginal r x w := by
    rw [hd]
    apply div_pos
    · exact mul_pos (sub_pos.mpr hxy) hn
    · positivity
  linarith

theorem allocationLogGain_hasDerivAt {r w : ℝ} (hr : 0 < r) (hw : 0 < w) (x : ℝ) :
    HasDerivAt (fun x => allocationLogGain r x w)
      ((2*(r*x+2)*r/((r*x+2)^2+(r*w)^2)-2*x/(x^2+w^2))/2) x := by
  have hN : 0 < (r*x+2)^2+(r*w)^2 := by positivity
  have hD : 0 < x^2+w^2 := by positivity
  have hn := ((((hasDerivAt_id x).const_mul r).add_const 2).pow 2).add_const ((r*w)^2)
  have hd := ((hasDerivAt_id x).pow 2).add_const (w^2)
  have h := ((hn.log (ne_of_gt hN)).sub (hd.log (ne_of_gt hD))).div_const 2
  unfold allocationLogGain
  convert h using 1 <;> simp only [id_eq, Nat.cast_ofNat, Nat.reduceSub, pow_one, mul_one] <;> ring

theorem allocation_marginal_identity {r w x : ℝ} (hr : 0 < r) (hw : 0 < w)
    (hx : 0 ≤ x) :
    (2*(r*x+2)*r/((r*x+2)^2+(r*w)^2)-2*x/(x^2+w^2))/2 =
      allocationMarginal r x w * phaseDerivative r x w := by
  have hN : 0 < (r*x+2)^2+r^2*w^2 := by positivity
  have hD : 0 < x^2+w^2 := by positivity
  have hP : 0 < r*x+1 := by positivity
  unfold allocationMarginal phaseDerivative
  field_simp
  <;> ring

/-- The marginal utility rises with x while the phase falls with x.  This is
    the strict decrease of slope in phase coordinates. -/
theorem allocation_strict_concavity_slope {r w x y : ℝ} (hr : 0 < r) (hw : 0 < w)
    (hx : 0 ≤ x) (hy : 0 ≤ y) (hphase : allocationPhase r x w < allocationPhase r y w) :
    allocationMarginal r x w > allocationMarginal r y w := by
  have hxy : y < x := by
    by_contra hn
    have hle : x ≤ y := le_of_not_gt hn
    rcases hle.eq_or_lt with h | h
    · subst y; exact (lt_irrefl _ hphase)
    · have hs := allocationPhase_strictAntiOn hr hw hx hy h
      linarith
  exact allocationMarginal_strictMonoOn hr hw hy hx hxy


/-- The unconstrained inverse-marginal formula in the manuscript. -/
def frequencyFree (r w l : ℝ) : ℝ :=
  l*w+(Real.sqrt (1+(1+l^2)*r^2*w^2)-1)/r

def frequencyAllocation (r w l : ℝ) : ℝ := min 1 (max 0 (frequencyFree r w l))

theorem frequencyFree_den_pos {r w l : ℝ} (hr : 0 < r) (hw : 0 < w) :
    0 < r*frequencyFree r w l+1 := by
  have hs := Real.sq_sqrt (show 0 ≤ 1+(1+l^2)*r^2*w^2 by positivity)
  have hn := Real.sqrt_nonneg (1+(1+l^2)*r^2*w^2)
  have hpos : 0 < r^2*w^2 := by positivity
  have hid : r*frequencyFree r w l+1 = l*r*w+Real.sqrt (1+(1+l^2)*r^2*w^2) := by
    unfold frequencyFree
    field_simp
    <;> ring
  rw [hid]
  nlinarith [sq_nonneg (l*r*w+Real.sqrt (1+(1+l^2)*r^2*w^2))]

theorem frequencyFree_marginal {r w l : ℝ} (hr : 0 < r) (hw : 0 < w) :
    allocationMarginal r (frequencyFree r w l) w = l := by
  have hs := Real.sq_sqrt (show 0 ≤ 1+(1+l^2)*r^2*w^2 by positivity)
  have hn := ne_of_gt (frequencyFree_den_pos (l := l) hr hw)
  unfold allocationMarginal
  apply (div_eq_iff (mul_ne_zero (mul_ne_zero (by norm_num) (ne_of_gt hw)) hn)).2
  unfold frequencyFree
  field_simp
  nlinarith

theorem allocationMarginal_strict_mono_extended {r w x y : ℝ}
    (hr : 0 < r) (hw : 0 < w) (hx : 0 < r*x+1) (hy : 0 < r*y+1) (hxy : x < y) :
    allocationMarginal r x w < allocationMarginal r y w := by
  have hd := allocationMarginal_difference (ne_of_gt hw) (ne_of_gt hx) (ne_of_gt hy)
  have hn : 0 < r^2*x*y+r*(x+y)+2+r^2*w^2 := by
    have hp := mul_pos hx hy
    nlinarith [sq_nonneg (r*w)]
  have hs : 0 < allocationMarginal r y w-allocationMarginal r x w := by
    rw [hd]
    exact div_pos (mul_pos (sub_pos.mpr hxy) hn) (by positivity)
  linarith

theorem frequencyFree_le_iff {r w l x : ℝ} (hr : 0 < r) (hw : 0 < w) (hx : 0 ≤ x) :
    frequencyFree r w l ≤ x ↔ l ≤ allocationMarginal r x w := by
  have hp : 0 < r*x+1 := by positivity
  have hfp := frequencyFree_den_pos (l := l) hr hw
  have heq := frequencyFree_marginal (l := l) hr hw
  constructor
  · intro h
    rcases h.eq_or_lt with h | h
    · rw [h] at heq
      exact le_of_eq heq.symm
    · exact le_of_lt (by simpa [heq] using allocationMarginal_strict_mono_extended hr hw hfp hp h)
  · intro h
    by_contra hn
    have hh := allocationMarginal_strict_mono_extended hr hw hp hfp (lt_of_not_ge hn)
    rw [heq] at hh
    linarith

theorem le_frequencyFree_iff {r w l x : ℝ} (hr : 0 < r) (hw : 0 < w) (hx : 0 ≤ x) :
    x ≤ frequencyFree r w l ↔ allocationMarginal r x w ≤ l := by
  have hp : 0 < r*x+1 := by positivity
  have hfp := frequencyFree_den_pos (l := l) hr hw
  have heq := frequencyFree_marginal (l := l) hr hw
  constructor
  · intro h
    rcases h.eq_or_lt with h | h
    · rw [h]; exact le_of_eq heq
    · exact le_of_lt (by simpa [heq] using allocationMarginal_strict_mono_extended hr hw hp hfp h)
  · intro h
    by_contra hn
    have hh := allocationMarginal_strict_mono_extended hr hw hfp hp (lt_of_not_ge hn)
    rw [heq] at hh
    linarith

theorem frequencyAllocation_mem (r w l : ℝ) : frequencyAllocation r w l ∈ Set.Icc 0 1 := by
  unfold frequencyAllocation
  exact ⟨le_min (by norm_num) (le_max_left _ _), min_le_left _ _⟩

theorem frequencyAllocation_continuous (r w : ℝ) : Continuous (frequencyAllocation r w) := by
  unfold frequencyAllocation frequencyFree
  exact continuous_const.min (continuous_const.max (by fun_prop))

theorem frequencyAllocation_zero_of {r w l : ℝ} (hr : 0 < r) (hw : 0 < w)
    (h : l ≤ allocationMarginal r 0 w) : frequencyAllocation r w l = 0 := by
  unfold frequencyAllocation
  rw [max_eq_left ((frequencyFree_le_iff hr hw (by norm_num)).2 h)]
  norm_num

theorem frequencyAllocation_one_of {r w l : ℝ} (hr : 0 < r) (hw : 0 < w)
    (h : allocationMarginal r 1 w ≤ l) : frequencyAllocation r w l = 1 := by
  have hh := (le_frequencyFree_iff hr hw (by norm_num)).2 h
  unfold frequencyAllocation
  rw [min_eq_left (le_trans hh (le_max_right _ _))]

/-- Exact clipped multiplier inequalities, including active bounds. -/
theorem frequencyAllocation_kkt {r w l : ℝ} (hr : 0 < r) (hw : 0 < w) :
    (0 < frequencyAllocation r w l → allocationMarginal r (frequencyAllocation r w l) w ≤ l) ∧
    (frequencyAllocation r w l < 1 → l ≤ allocationMarginal r (frequencyAllocation r w l) w) := by
  have hm := frequencyAllocation_mem r w l
  constructor
  · intro hp
    apply (le_frequencyFree_iff hr hw hm.1).1
    unfold frequencyAllocation at hp ⊢
    have hf : 0 < frequencyFree r w l := by
      have hh := lt_of_lt_of_le hp (min_le_right 1 (max 0 (frequencyFree r w l)))
      simpa using hh
    rw [max_eq_right (le_of_lt hf)]
    exact min_le_right _ _
  · intro hp
    apply (frequencyFree_le_iff hr hw hm.1).1
    unfold frequencyAllocation at hp ⊢
    have hf : max 0 (frequencyFree r w l) < 1 := by
      simpa only [min_lt_iff, lt_irrefl, false_or] using hp
    rw [min_eq_right (le_of_lt hf)]
    exact le_max_right _ _


def allocationLagrangian (r w l x : ℝ) : ℝ :=
  allocationLogGain r x w-l*allocationPhase r x w

theorem allocationLogGain_continuous {r w : ℝ} (hr : 0 < r) (hw : 0 < w) :
    Continuous (fun x => allocationLogGain r x w) := by
  unfold allocationLogGain
  apply Continuous.div_const
  apply Continuous.sub
  · exact (by fun_prop : Continuous fun x : ℝ => (r*x+2)^2+(r*w)^2).log
      (fun x => ne_of_gt (by positivity : 0 < (r*x+2)^2+(r*w)^2))
  · exact (by fun_prop : Continuous fun x : ℝ => x^2+w^2).log
      (fun x => ne_of_gt (by positivity : 0 < x^2+w^2))

theorem allocationLagrangian_continuous {r w : ℝ} (hr : 0 < r) (hw : 0 < w) (l : ℝ) :
    Continuous (allocationLagrangian r w l) :=
  (allocationLogGain_continuous hr hw).sub (continuous_const.mul allocationPhase_continuous)

theorem allocationLagrangian_hasDerivAt {r w x : ℝ} (hr : 0 < r) (hw : 0 < w)
    (hx : 0 ≤ x) (l : ℝ) :
    HasDerivAt (allocationLagrangian r w l)
      ((allocationMarginal r x w-l)*phaseDerivative r x w) x := by
  have h := (allocationLogGain_hasDerivAt hr hw x).sub
    ((allocationPhase_hasDerivAt hr hw x).const_mul l)
  unfold allocationLagrangian
  convert h using 1
  rw [allocation_marginal_identity hr hw hx]
  ring

/-- The clipped formula is the unique maximizer of the scalar Lagrangian. -/
theorem frequencyAllocation_lagrangian_strict {r w l x : ℝ}
    (hr : 0 < r) (hw : 0 < w) (hx : x ∈ Set.Icc 0 1)
    (hne : x ≠ frequencyAllocation r w l) :
    allocationLagrangian r w l x <
      allocationLagrangian r w l (frequencyAllocation r w l) := by
  let s := frequencyAllocation r w l
  have hs := frequencyAllocation_mem r w l
  have hk := frequencyAllocation_kkt hr hw (l := l)
  rcases lt_or_gt_of_ne hne with hxs | hsx
  · have hspos : 0 < s := lt_of_le_of_lt hx.1 hxs
    have hmono : StrictMonoOn (allocationLagrangian r w l) (Set.Icc 0 s) := by
      apply strictMonoOn_of_deriv_pos (convex_Icc _ _)
        (allocationLagrangian_continuous hr hw l).continuousOn
      intro y hy
      have hy' : 0 < y ∧ y < s := by simpa using hy
      rw [(allocationLagrangian_hasDerivAt hr hw (le_of_lt hy'.1) l).deriv]
      have hm : allocationMarginal r y w < allocationMarginal r s w :=
        allocationMarginal_strictMonoOn hr hw (le_of_lt hy'.1) hs.1 hy'.2
      have hl := hk.1 hspos
      exact mul_pos_of_neg_of_neg (by linarith) (phaseDerivative_neg hr hw (le_of_lt hy'.1))
    exact hmono ⟨hx.1,le_of_lt hxs⟩ ⟨hs.1,le_rfl⟩ hxs
  · have hslt : s < 1 := lt_of_lt_of_le hsx hx.2
    have hanti : StrictAntiOn (allocationLagrangian r w l) (Set.Icc s 1) := by
      apply strictAntiOn_of_deriv_neg (convex_Icc _ _)
        (allocationLagrangian_continuous hr hw l).continuousOn
      intro y hy
      have hy' : s < y ∧ y < 1 := by simpa using hy
      have hy0 : 0 ≤ y := le_trans hs.1 (le_of_lt hy'.1)
      rw [(allocationLagrangian_hasDerivAt hr hw hy0 l).deriv]
      have hm : allocationMarginal r s w < allocationMarginal r y w :=
        allocationMarginal_strictMonoOn hr hw hs.1 hy0 hy'.1
      have hl := hk.2 hslt
      exact mul_neg_of_pos_of_neg (by linarith) (phaseDerivative_neg hr hw hy0)
    exact hanti ⟨le_rfl,hs.2⟩ ⟨le_of_lt hsx,hx.2⟩ hsx

theorem frequencyAllocation_lagrangian_max {r w l x : ℝ}
    (hr : 0 < r) (hw : 0 < w) (hx : x ∈ Set.Icc 0 1) :
    allocationLagrangian r w l x ≤
      allocationLagrangian r w l (frequencyAllocation r w l) := by
  by_cases h : x = frequencyAllocation r w l
  · rw [h]
  · exact le_of_lt (frequencyAllocation_lagrangian_strict hr hw hx h)

variable {ι : Type*} [Fintype ι]

def frequencyAllocatedPhase (r : ι → ℝ) (w l : ℝ) : ℝ :=
  ∑ i, allocationPhase (r i) (frequencyAllocation (r i) w l) w

theorem frequencyAllocatedPhase_continuous (r : ι → ℝ) (w : ℝ) :
    Continuous (frequencyAllocatedPhase r w) := by
  apply continuous_finset_sum
  intro i _
  exact allocationPhase_continuous.comp (frequencyAllocation_continuous (r i) w)

/-- The scalar multiplier exists whenever the actual phase constraint is feasible. -/
theorem exists_frequency_multiplier (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {w a : ℝ} (hw : 0 < w)
    (hlo : (∑ i, allocationPhase (r i) 1 w) ≤ a)
    (hhi : a ≤ ∑ i, allocationPhase (r i) 0 w) :
    ∃ l : ℝ, frequencyAllocatedPhase r w l = a := by
  classical
  let L := -(∑ i, |allocationMarginal (r i) 0 w|)-1
  let U := (∑ i, |allocationMarginal (r i) 1 w|)+1
  have hL : ∀ i, L ≤ allocationMarginal (r i) 0 w := by
    intro i
    have hs := Finset.single_le_sum (fun j (_ : j ∈ Finset.univ) => abs_nonneg (allocationMarginal (r j) 0 w)) (Finset.mem_univ i)
    have ha := neg_abs_le (allocationMarginal (r i) 0 w)
    dsimp [L]
    linarith
  have hU : ∀ i, allocationMarginal (r i) 1 w ≤ U := by
    intro i
    have hs := Finset.single_le_sum (fun j (_ : j ∈ Finset.univ) => abs_nonneg (allocationMarginal (r j) 1 w)) (Finset.mem_univ i)
    have ha := le_abs_self (allocationMarginal (r i) 1 w)
    dsimp [U]
    linarith
  have hLU : L ≤ U := by
    have h0 : 0 ≤ ∑ i, |allocationMarginal (r i) 0 w| := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have h1 : 0 ≤ ∑ i, |allocationMarginal (r i) 1 w| := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    dsimp [L,U]
    linarith
  have hphaseL : frequencyAllocatedPhase r w L = ∑ i, allocationPhase (r i) 0 w := by
    apply Finset.sum_congr rfl
    intro i _
    rw [frequencyAllocation_zero_of (hr i) hw (hL i)]
  have hphaseU : frequencyAllocatedPhase r w U = ∑ i, allocationPhase (r i) 1 w := by
    apply Finset.sum_congr rfl
    intro i _
    rw [frequencyAllocation_one_of (hr i) hw (hU i)]
  obtain ⟨l,_,hl⟩ := intermediate_value_Icc' hLU
    (frequencyAllocatedPhase_continuous r w).continuousOn
      (show a ∈ Set.Icc (frequencyAllocatedPhase r w U) (frequencyAllocatedPhase r w L) from
        ⟨by simpa [hphaseU] using hlo, by simpa [hphaseL] using hhi⟩)
  exact ⟨l,hl⟩


/-- Optimality at an actually attained phase, not an assumed optimization oracle. -/
theorem frequencyAllocation_log_optimal (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {w l : ℝ} (hw : 0 < w) (x : ι → ℝ) (hx : ∀ i, x i ∈ Set.Icc 0 1)
    (hphase : (∑ i, allocationPhase (r i) (x i) w) = frequencyAllocatedPhase r w l) :
    (∑ i, allocationLogGain (r i) (x i) w) ≤
      ∑ i, allocationLogGain (r i) (frequencyAllocation (r i) w l) w := by
  have hs := Finset.sum_le_sum (s := Finset.univ) (fun i _ =>
    frequencyAllocation_lagrangian_max (hr i) hw (l := l) (hx i))
  simp only [allocationLagrangian, Finset.sum_sub_distrib, ← Finset.mul_sum] at hs
  unfold frequencyAllocatedPhase at hphase
  rw [hphase] at hs
  linarith

theorem frequencyAllocation_log_optimal_strict (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {w l : ℝ} (hw : 0 < w) (x : ι → ℝ) (hx : ∀ i, x i ∈ Set.Icc 0 1)
    (hphase : (∑ i, allocationPhase (r i) (x i) w) = frequencyAllocatedPhase r w l)
    (hne : x ≠ fun i => frequencyAllocation (r i) w l) :
    (∑ i, allocationLogGain (r i) (x i) w) <
      ∑ i, allocationLogGain (r i) (frequencyAllocation (r i) w l) w := by
  classical
  obtain ⟨i,hi⟩ : ∃ i, x i ≠ frequencyAllocation (r i) w l := by
    by_contra h
    apply hne
    funext i
    by_contra hi
    exact h ⟨i,hi⟩
  have hs : (∑ i, allocationLagrangian (r i) w l (x i)) <
      ∑ i, allocationLagrangian (r i) w l (frequencyAllocation (r i) w l) := by
    apply Finset.sum_lt_sum
    · intro j _
      exact frequencyAllocation_lagrangian_max (hr j) hw (hx j)
    · exact ⟨i,Finset.mem_univ i,frequencyAllocation_lagrangian_strict (hr i) hw (hx i) hi⟩
  simp only [allocationLagrangian, Finset.sum_sub_distrib, ← Finset.mul_sum] at hs
  unfold frequencyAllocatedPhase at hphase
  rw [hphase] at hs
  linarith

/-- A feasible actual phase vector gives the endpoint inequalities required by IVT. -/
theorem allocation_phase_bounds (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {w : ℝ} (hw : 0 < w) (x : ι → ℝ) (hx : ∀ i, x i ∈ Set.Icc 0 1) :
    (∑ i, allocationPhase (r i) 1 w) ≤ (∑ i, allocationPhase (r i) (x i) w) ∧
      (∑ i, allocationPhase (r i) (x i) w) ≤ (∑ i, allocationPhase (r i) 0 w) := by
  constructor
  · exact Finset.sum_le_sum fun i _ =>
      (allocationPhase_strictAntiOn (hr i) hw).antitoneOn (hx i).1 (by norm_num) (hx i).2
  · exact Finset.sum_le_sum fun i _ =>
      (allocationPhase_strictAntiOn (hr i) hw).antitoneOn (by norm_num) (hx i).1 (hx i).1

/-- Full scalar-allocation/uniqueness conclusion for every feasible fixed frequency. -/
theorem exists_unique_frequency_allocation (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {w a : ℝ} (hw : 0 < w)
    (hfeasible : ∃ x : ι → ℝ, (∀ i, x i ∈ Set.Icc 0 1) ∧
      (∑ i, allocationPhase (r i) (x i) w) = a) :
    ∃ l : ℝ, frequencyAllocatedPhase r w l = a ∧
      (∀ i, frequencyAllocation (r i) w l ∈ Set.Icc 0 1) ∧
      ∀ x : ι → ℝ, (∀ i, x i ∈ Set.Icc 0 1) →
        (∑ i, allocationPhase (r i) (x i) w) = a →
          ((∑ i, allocationLogGain (r i) (x i) w) ≤
            (∑ i, allocationLogGain (r i) (frequencyAllocation (r i) w l) w) ∧
          (x ≠ (fun i => frequencyAllocation (r i) w l) →
            (∑ i, allocationLogGain (r i) (x i) w) <
              (∑ i, allocationLogGain (r i) (frequencyAllocation (r i) w l) w))) := by
  obtain ⟨x,hx,hphase⟩ := hfeasible
  have hb := allocation_phase_bounds r hr hw x hx
  obtain ⟨l,hl⟩ := exists_frequency_multiplier r hr hw (hphase ▸ hb.1) (hphase ▸ hb.2)
  refine ⟨l,hl,fun i => frequencyAllocation_mem _ _ _,?_⟩
  intro y hy hphasey
  have heq : (∑ i, allocationPhase (r i) (y i) w) = frequencyAllocatedPhase r w l := hphasey.trans hl.symm
  exact ⟨frequencyAllocation_log_optimal r hr hw y hy heq,
    fun hne => frequencyAllocation_log_optimal_strict r hr hw y hy heq hne⟩


/-- Actual magnitude of the complex factor r+2/(x-iw), in real coordinates. -/
def allocationGain (r x w : ℝ) : ℝ :=
  Real.sqrt (((r*x+2)^2+(r*w)^2)/(x^2+w^2))

theorem allocationGain_pos {r w : ℝ} (hr : 0 < r) (hw : 0 < w) (x : ℝ) :
    0 < allocationGain r x w := by
  unfold allocationGain
  apply Real.sqrt_pos.2
  positivity

theorem log_allocationGain {r w : ℝ} (hr : 0 < r) (hw : 0 < w) (x : ℝ) :
    Real.log (allocationGain r x w) = allocationLogGain r x w := by
  have hN : 0 < (r*x+2)^2+(r*w)^2 := by positivity
  have hD : 0 < x^2+w^2 := by positivity
  unfold allocationGain allocationLogGain
  rw [Real.log_sqrt (by positivity), Real.log_div (ne_of_gt hN) (ne_of_gt hD)]

theorem allocationGain_eq_complexNorm {r w : ℝ} (hw : 0 < w) (x : ℝ) :
    allocationGain r x w = ‖(r : ℂ)+2/((x : ℂ)-(w : ℂ)*Complex.I)‖ := by
  have hz : (x : ℂ)-(w : ℂ)*Complex.I ≠ 0 := by
    intro h
    have hi := congrArg Complex.im h
    simp at hi
    linarith
  have heq : (r : ℂ)+2/((x : ℂ)-(w : ℂ)*Complex.I) =
      (((r*x+2 : ℝ) : ℂ)-((r*w : ℝ) : ℂ)*Complex.I)/((x : ℂ)-(w : ℂ)*Complex.I) := by
    push_cast
    field_simp
    <;> ring
  rw [heq,norm_div,Complex.norm_def,Complex.norm_def]
  have hN : Complex.normSq ((((r*x+2 : ℝ) : ℂ)-((r*w : ℝ) : ℂ)*Complex.I)) =
      (r*x+2)^2+(r*w)^2 := by
    simp [Complex.normSq_apply]
    ring
  have hD : Complex.normSq ((x : ℂ)-(w : ℂ)*Complex.I) = x^2+w^2 := by
    simp [Complex.normSq_apply]
    ring
  rw [hN,hD]
  unfold allocationGain
  exact Real.sqrt_div (by positivity) _

theorem frequencyAllocation_gain_optimal (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {w l : ℝ} (hw : 0 < w) (x : ι → ℝ) (hx : ∀ i, x i ∈ Set.Icc 0 1)
    (hphase : (∑ i, allocationPhase (r i) (x i) w) = frequencyAllocatedPhase r w l) :
    (∏ i, allocationGain (r i) (x i) w) ≤
      ∏ i, allocationGain (r i) (frequencyAllocation (r i) w l) w := by
  apply (Real.log_le_log_iff (Finset.prod_pos (fun i _ => allocationGain_pos (hr i) hw _))
    (Finset.prod_pos (fun i _ => allocationGain_pos (hr i) hw _))).mp
  rw [Real.log_prod _ _ (fun i _ => ne_of_gt (allocationGain_pos (hr i) hw _)),
    Real.log_prod _ _ (fun i _ => ne_of_gt (allocationGain_pos (hr i) hw _))]
  simp_rw [log_allocationGain (hr _) hw]
  exact frequencyAllocation_log_optimal r hr hw x hx hphase

theorem frequencyAllocation_gain_optimal_strict (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {w l : ℝ} (hw : 0 < w) (x : ι → ℝ) (hx : ∀ i, x i ∈ Set.Icc 0 1)
    (hphase : (∑ i, allocationPhase (r i) (x i) w) = frequencyAllocatedPhase r w l)
    (hne : x ≠ fun i => frequencyAllocation (r i) w l) :
    (∏ i, allocationGain (r i) (x i) w) <
      ∏ i, allocationGain (r i) (frequencyAllocation (r i) w l) w := by
  apply (Real.log_lt_log_iff (Finset.prod_pos (fun i _ => allocationGain_pos (hr i) hw _))
    (Finset.prod_pos (fun i _ => allocationGain_pos (hr i) hw _))).mp
  rw [Real.log_prod _ _ (fun i _ => ne_of_gt (allocationGain_pos (hr i) hw _)),
    Real.log_prod _ _ (fun i _ => ne_of_gt (allocationGain_pos (hr i) hw _))]
  simp_rw [log_allocationGain (hr _) hw]
  exact frequencyAllocation_log_optimal_strict r hr hw x hx hphase hne

/-- The complete fixed-frequency allocation result stated using the actual
complex magnitudes.  The manuscript specializes `a` to `2 * arctan w`.
The optimizer is unique even when a whole interval of multipliers works. -/
theorem exists_unique_frequency_gain_optimizer (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {w a : ℝ} (hw : 0 < w)
    (hfeasible : ∃ x : ι → ℝ, (∀ i, x i ∈ Set.Icc 0 1) ∧
      (∑ i, allocationPhase (r i) (x i) w) = a) :
    ∃ l : ℝ, frequencyAllocatedPhase r w l = a ∧
      (∀ i, frequencyAllocation (r i) w l ∈ Set.Icc 0 1) ∧
      ∀ x : ι → ℝ, (∀ i, x i ∈ Set.Icc 0 1) →
        (∑ i, allocationPhase (r i) (x i) w) = a →
          ((∏ i, ‖(r i : ℂ)+2/((x i : ℂ)-(w : ℂ)*Complex.I)‖) ≤
            (∏ i, ‖(r i : ℂ)+2/((frequencyAllocation (r i) w l : ℂ)-(w : ℂ)*Complex.I)‖) ∧
          (x ≠ (fun i => frequencyAllocation (r i) w l) →
            (∏ i, ‖(r i : ℂ)+2/((x i : ℂ)-(w : ℂ)*Complex.I)‖) <
              (∏ i, ‖(r i : ℂ)+2/((frequencyAllocation (r i) w l : ℂ)-(w : ℂ)*Complex.I)‖))) := by
  obtain ⟨l,hl,hmem,_⟩ := exists_unique_frequency_allocation r hr hw hfeasible
  refine ⟨l,hl,hmem,?_⟩
  intro x hx hphase
  have heq : (∑ i, allocationPhase (r i) (x i) w) = frequencyAllocatedPhase r w l :=
    hphase.trans hl.symm
  constructor
  · simpa only [allocationGain_eq_complexNorm hw] using
      frequencyAllocation_gain_optimal r hr hw x hx heq
  · intro hne
    simpa only [allocationGain_eq_complexNorm hw] using
      frequencyAllocation_gain_optimal_strict r hr hw x hx heq hne

end C2.NGamma

end

/- ===== C2.NGammaAllocationRegularity ===== -/

/-!
# Joint regularity of the exact clipped allocation

These results concern the explicit functions used in the fixed-frequency theorem,
including their behavior when an active clipping constraint changes.
-/
noncomputable section
open scoped BigOperators
namespace C2.NGamma

theorem frequencyFree_joint_continuous (r : ℝ) :
    Continuous (fun p : ℝ × ℝ => frequencyFree r p.1 p.2) := by
  unfold frequencyFree
  continuity

theorem frequencyAllocation_joint_continuous (r : ℝ) :
    Continuous (fun p : ℝ × ℝ => frequencyAllocation r p.1 p.2) := by
  unfold frequencyAllocation
  exact continuous_const.min (continuous_const.max (frequencyFree_joint_continuous r))

theorem allocationPhase_joint_continuousAt (r : ℝ) {p : ℝ × ℝ}
    (hw : p.2 ≠ 0) :
    ContinuousAt (fun p : ℝ × ℝ => allocationPhase r p.1 p.2) p := by
  unfold allocationPhase
  exact (Real.continuousAt_arctan.comp ((continuousAt_fst.add continuousAt_const).div continuousAt_snd hw)).sub
    (Real.continuousAt_arctan.comp (continuousAt_fst.div continuousAt_snd hw))

theorem allocationLogGain_joint_continuousAt {r : ℝ} (hr : 0 < r)
    {p : ℝ × ℝ} (hw : 0 < p.2) :
    ContinuousAt (fun p : ℝ × ℝ => allocationLogGain r p.1 p.2) p := by
  have hn : (r*p.1+2)^2+(r*p.2)^2 ≠ 0 := ne_of_gt (by positivity)
  have hd : p.1^2+p.2^2 ≠ 0 := ne_of_gt (by positivity)
  unfold allocationLogGain
  have hN : ContinuousAt (fun p : ℝ × ℝ => (r*p.1+2)^2+(r*p.2)^2) p := by fun_prop
  have hD : ContinuousAt (fun p : ℝ × ℝ => p.1^2+p.2^2) p := by fun_prop
  exact ((hN.log hn).sub (hD.log hd)).div_const 2

/-- Total derivative along any differentiable coordinate curve.  The second
term vanishes on the unconstrained inverse-marginal curve. -/
theorem allocationLagrangian_curve_hasDerivAt {r w l g' : ℝ} (hr : 0 < r)
    (hw : 0 < w) {g : ℝ → ℝ} (hg : HasDerivAt g g' w)
    (hP : r*g w+1 ≠ 0) :
    HasDerivAt (fun v => allocationLagrangian r v l (g v))
      (phaseDerivative r (g w) w * (1+l*allocationMarginal r (g w) w) +
       (allocationMarginal r (g w) w-l)*phaseDerivative r (g w) w*g') w := by
  have hN : 0 < (r*g w+2)^2+(r*w)^2 := by positivity
  have hD : 0 < (g w)^2+w^2 := by positivity
  have hN' : 0 < (r*g w+2)^2+r^2*w^2 := by positivity
  have hA : 0 < 1+((g w+2/r)/w)^2 := by positivity
  have hB : 0 < 1+(g w/w)^2 := by positivity
  have hn := (((hg.const_mul r).add_const 2).pow 2).add
    (((hasDerivAt_id w).const_mul r).pow 2)
  have hd := (hg.pow 2).add ((hasDerivAt_id w).pow 2)
  have hl := ((hn.log (ne_of_gt hN)).sub (hd.log (ne_of_gt hD))).div_const 2
  have hp := (((hg.add_const (2/r)).div (hasDerivAt_id w) (ne_of_gt hw)).arctan).sub
    ((hg.div (hasDerivAt_id w) (ne_of_gt hw)).arctan)
  have h := hl.sub (hp.const_mul l)
  unfold allocationLagrangian allocationLogGain allocationPhase
  convert h using 1
  unfold allocationMarginal phaseDerivative
  simp only [id_eq, Nat.cast_ofNat, Nat.reduceSub, pow_one, mul_one]
  field_simp
  <;> ring

theorem allocationLagrangian_frequency_hasDerivAt {r w x l : ℝ}
    (hr : 0 < r) (hw : 0 < w) (hx : r*x+1 ≠ 0) :
    HasDerivAt (fun v => allocationLagrangian r v l x)
      (phaseDerivative r x w * (1+l*allocationMarginal r x w)) w := by
  have h := allocationLagrangian_curve_hasDerivAt hr hw
    (g := fun _ => x) (l := l) (hasDerivAt_const w x) hx
  simpa using h

theorem frequencyAllocation_lagrangian_joint_continuousAt {r : ℝ} (hr : 0 < r)
    {p : ℝ × ℝ} (hw : 0 < p.1) :
    ContinuousAt (fun p : ℝ × ℝ =>
      allocationLagrangian r p.1 p.2 (frequencyAllocation r p.1 p.2)) p := by
  have hx := (frequencyAllocation_joint_continuous r).continuousAt (x := p)
  have hc : ContinuousAt (fun p : ℝ × ℝ => (frequencyAllocation r p.1 p.2,p.1)) p :=
    hx.prodMk continuousAt_fst
  have hlog := (allocationLogGain_joint_continuousAt hr hw).comp hc
  have hphase := (allocationPhase_joint_continuousAt r (ne_of_gt hw)).comp hc
  exact hlog.sub (continuousAt_snd.mul hphase)

theorem frequencyFree_frequency_hasDerivAt {r : ℝ} (hr : 0 < r) (l w : ℝ) :
    HasDerivAt (fun v => frequencyFree r v l)
      (l+(1+l^2)*r*w/Real.sqrt (1+(1+l^2)*r^2*w^2)) w := by
  have hn : 0 < 1+(1+l^2)*r^2*w^2 := by positivity
  have hs : Real.sqrt (1+(1+l^2)*r^2*w^2) ≠ 0 :=
    ne_of_gt (Real.sqrt_pos.2 hn)
  have hp := (((hasDerivAt_id w).pow 2).const_mul ((1+l^2)*r^2)).const_add 1
  have h := ((hasDerivAt_id w).const_mul l).add
    (((hp.sqrt (ne_of_gt hn)).sub_const 1).div_const r)
  unfold frequencyFree
  convert h using 1
  simp only [id_eq, Nat.cast_ofNat, Nat.reduceSub, pow_one, mul_one]
  field_simp
  <;> ring

theorem frequencyFree_lagrangian_hasDerivAt {r w l : ℝ}
    (hr : 0 < r) (hw : 0 < w) :
    HasDerivAt (fun v => allocationLagrangian r v l (frequencyFree r v l))
      (phaseDerivative r (frequencyFree r w l) w * (1+l^2)) w := by
  have h := allocationLagrangian_curve_hasDerivAt hr hw
    (l := l) (frequencyFree_frequency_hasDerivAt hr l w)
    (ne_of_gt (frequencyFree_den_pos hr hw))
  simpa only [frequencyFree_marginal hr hw, sub_self, zero_mul, add_zero, pow_two] using h

end C2.NGamma

end

/- ===== C2.NGammaAmplitudeOrder ===== -/

noncomputable section
open Set Filter
open scoped BigOperators Topology
namespace C2.NGamma.Cayley

lemma amplitude_lt_endpoint {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) {t : ℝ} (ht : 0 ≤ t) :
    amplitude r x t < ∏ i, (r i+2/x i) := by
  have hm := amplitude_strictMonoOn hn hr (fun i => (hx i).le)
  have hle : amplitude r x (t+1) ≤ ∏ i, (r i+2/x i) := by
    apply ge_of_tendsto (amplitude_tendsto_atTop hr hx)
    filter_upwards [eventually_ge_atTop (t+1)] with s hs
    exact hm.monotoneOn (show 0 ≤ t+1 by linarith) (show 0 ≤ s by linarith) hs
  exact lt_of_lt_of_le (hm ht (show 0 ≤ t+1 by linarith) (by linarith)) hle

lemma base_gain_lt_endpoint {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) :
    (∏ i, r i) < ∏ i, (r i+2/x i) := by
  simpa only [amplitude_zero] using amplitude_lt_endpoint hn hr hx (le_refl (0:ℝ))

lemma base_gain_lt_amplitude {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) {t : ℝ} (ht : 0 < t) :
    (∏ i, r i) < amplitude r x t := by
  simpa only [amplitude_zero] using amplitude_strictMonoOn hn hr hx (le_refl (0:ℝ)) ht.le ht

end C2.NGamma.Cayley

end

/- ===== C2.NGammaLowGain ===== -/

/-! A direct exterior-disk proof of the initial stable gain interval.
The estimate is strict away from z=1 and therefore includes b=product r.
It requires no root-continuation or winding-number assumption. -/
noncomputable section
open scoped BigOperators
open Polynomial
namespace C2.NGamma.PolynomialModel

/-- Exact exterior-disk energy identity for a single cascade factor. -/
theorem factor_norm_gap (r x : ℝ) (z : ℂ) :
    ‖(factor r x).eval z‖^2 - r^2 * ‖(q x).eval z‖^2 =
      (1+r*x)*‖z-1‖^2 + r*(‖z‖^2-1) := by
  simp only [Complex.sq_norm, Complex.normSq_apply, factor_eval, q_eval]
  simp [Complex.add_re, Complex.add_im, Complex.sub_re, Complex.sub_im,
    Complex.mul_re, Complex.mul_im, Complex.div_re, Complex.div_im,
    Complex.normSq_apply]
  ring

/-- Outside the open unit disk, every nontrivial factor dominates r*q strictly. -/
theorem factor_norm_gt_mul_q {r x : ℝ} (hr : 0 < r) (hx : 0 ≤ x)
    {z : ℂ} (hz : 1 ≤ ‖z‖) (hz1 : z ≠ 1) :
    r * ‖(q x).eval z‖ < ‖(factor r x).eval z‖ := by
  have hgap := factor_norm_gap r x z
  have hcoeff : 0 < 1+r*x := by nlinarith [mul_nonneg hr.le hx]
  have hnorm : 0 < ‖z-1‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hz1)
  have hpos : 0 < (1+r*x)*‖z-1‖^2 := mul_pos hcoeff (sq_pos_of_pos hnorm)
  have hnonneg : 0 ≤ r*(‖z‖^2-1) := mul_nonneg hr.le (by nlinarith)
  have hsq : (r * ‖(q x).eval z‖)^2 < ‖(factor r x).eval z‖^2 := by
    nlinarith
  nlinarith [norm_nonneg ((factor r x).eval z),
    mul_nonneg hr.le (norm_nonneg ((q x).eval z))]

variable {ι : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]

/-- The entire closed low-gain interval is strictly Schur stable. This holds
 for all delays d>=0 and all nonnegative weights, hence in particular for
 the manuscript's d>=1 and x in [0,1]. -/
theorem low_gain_schur {r x : ι → ℝ} (hr : ∀ i, 0 < r i)
    (hx : ∀ i, 0 ≤ x i) (d : ℕ) {b : ℝ} (hb : 0 ≤ b) (hB : b ≤ ∏ i, r i) :
    SchurStable (characteristic r x d b) := by
  intro z hroot
  by_contra! hz
  have hz1 : z ≠ 1 := by
    intro he
    subst z
    exact one_not_root hr d hb hroot
  have hf (i : ι) : 0 < ‖(factor (r i) (x i)).eval z‖ := by
    have hs := factor_norm_gt_mul_q (hr i) (hx i) hz hz1
    exact lt_of_le_of_lt (mul_nonneg (hr i).le (norm_nonneg _)) hs
  have hF : 0 < ∏ i, ‖(factor (r i) (x i)).eval z‖ :=
    Finset.prod_pos (fun i _ => hf i)
  have hp : 1 ≤ ‖z‖^d := one_le_pow₀ hz
  have hnorm : ‖z‖^d * ∏ i, ‖(factor (r i) (x i)).eval z‖ =
      b * ∏ i, ‖(q (x i)).eval z‖ := by
    have he : z^d * ∏ i, (factor (r i) (x i)).eval z =
        -((b : ℂ) * ∏ i, (q (x i)).eval z) := by
      apply eq_neg_of_add_eq_zero_left
      simpa only [characteristic, eval_add, eval_mul, eval_pow, eval_X, eval_C, eval_prod] using hroot
    have hn := congrArg norm he
    simpa only [norm_mul, norm_pow, norm_prod, norm_neg, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg hb] using hn
  by_cases hQ : ∏ i, ‖(q (x i)).eval z‖ = 0
  · rw [hQ, mul_zero] at hnorm
    have hpos := mul_pos (lt_of_lt_of_le zero_lt_one hp) hF
    linarith
  · have hq (i : ι) : 0 < r i * ‖(q (x i)).eval z‖ := by
      have hn := Finset.prod_ne_zero_iff.mp hQ i (Finset.mem_univ i)
      exact mul_pos (hr i) (lt_of_le_of_ne (norm_nonneg _) (Ne.symm hn))
    have hprod : (∏ i, r i) * ∏ i, ‖(q (x i)).eval z‖ <
        ∏ i, ‖(factor (r i) (x i)).eval z‖ := by
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_lt_prod_of_nonempty (fun i _ => hq i)
        (fun i _ => factor_norm_gt_mul_q (hr i) (hx i) hz hz1) Finset.univ_nonempty
    have hQnonneg : 0 ≤ ∏ i, ‖(q (x i)).eval z‖ :=
      Finset.prod_nonneg (fun i _ => norm_nonneg ((q (x i)).eval z))
    have hlow := mul_le_mul_of_nonneg_right hB hQnonneg
    have hhigh : (∏ i, ‖(factor (r i) (x i)).eval z‖) ≤
        ‖z‖^d * ∏ i, ‖(factor (r i) (x i)).eval z‖ := by
      nlinarith
    linarith

/-- The finite-index version used by the gain-interval theorem. -/
theorem low_gain_schur_fin {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) (d : ℕ)
    {b : ℝ} (hb : 0 ≤ b) (hB : b ≤ ∏ i, r i) :
    SchurStable (characteristic r x d b) := by
  letI : Nonempty (Fin n) := ⟨⟨0,hn⟩⟩
  exact low_gain_schur hr hx d hb hB

end C2.NGamma.PolynomialModel

end

/- ===== C2.NGammaPhaseOrder ===== -/

/-! Ordering of all frequencies relative to the first phase crossing, for every
positive integer delay. This excludes later reentry below the first phase level. -/

noncomputable section
open Set
open scoped Topology BigOperators
namespace C2.NGamma.Phase

def phaseThreshold (d : ℕ) (t : ℝ) : ℝ :=
  2*(d:ℝ)-((d:ℝ)-1)*Real.pi/Real.arctan (1/t)

lemma phaseThreshold_antitoneOn {d : ℕ} (hd : 1 ≤ d) :
    AntitoneOn (phaseThreshold d) (Ioi 0) := by
  have hc : 0 ≤ ((d:ℝ)-1)*Real.pi := by
    have hd' : (1:ℝ) ≤ d := by exact_mod_cast hd
    exact mul_nonneg (by linarith) Real.pi_pos.le
  intro u hu v hv huv
  have hu' : 0 < u := hu
  have hv' : 0 < v := hv
  have hDa : 0 < Real.arctan (1/v) := arctan_pos (one_div_pos.mpr hv')
  have hDb : Real.arctan (1/v) ≤ Real.arctan (1/u) :=
    Real.arctan_strictMono.monotone (one_div_le_one_div_of_le hu' huv)
  exact sub_le_sub_left (div_le_div_of_nonneg_left hc hDa hDb) _

lemma phase_gap_identity {n : ℕ} (a x : Fin n → ℝ) (d : ℕ) {t : ℝ} (ht : 0 < t) :
    totalPhase a x d t-Real.pi = Real.arctan (1/t)*(sumRatio a x t-phaseThreshold d t) := by
  have hD : Real.arctan (1/t) ≠ 0 := (arctan_pos (one_div_pos.mpr ht)).ne'
  have hi : Real.arctan (1/t) = Real.pi/2-Real.arctan t := by
    simpa only [one_div] using Real.arctan_inv_of_pos ht
  have hsum : sumRatio a x t = (∑ j, contribution (a j) (x j) t)/Real.arctan (1/t) := by
    simp only [sumRatio, ratio, Finset.sum_div]
  rw [hsum]
  unfold totalPhase phaseThreshold
  field_simp
  rw [hi]
  ring

lemma phase_below_iff {n : ℕ} (a x : Fin n → ℝ) (d : ℕ) {t : ℝ} (ht : 0 < t) :
    totalPhase a x d t < Real.pi ↔ sumRatio a x t < phaseThreshold d t := by
  have hi := phase_gap_identity a x d ht
  have hD := arctan_pos (one_div_pos.mpr ht)
  constructor
  · intro h
    by_contra! hh
    have hp := mul_nonneg hD.le (sub_nonneg.mpr hh)
    linarith
  · intro h
    have hp := mul_neg_of_pos_of_neg hD (sub_neg.mpr h)
    linarith

lemma phase_above_iff {n : ℕ} (a x : Fin n → ℝ) (d : ℕ) {t : ℝ} (ht : 0 < t) :
    Real.pi < totalPhase a x d t ↔ phaseThreshold d t < sumRatio a x t := by
  have hi := phase_gap_identity a x d ht
  have hD := arctan_pos (one_div_pos.mpr ht)
  constructor
  · intro h
    by_contra! hh
    have hp := mul_nonpos_of_nonneg_of_nonpos hD.le (sub_nonpos.mpr hh)
    linarith
  · intro h
    have hp := mul_pos hD (sub_pos.mpr h)
    linarith

lemma phase_before_after_crossing {n d : ℕ} (hn : 0 < n) (hd : 1 ≤ d)
    {a x : Fin n → ℝ} (hx : ∀ j, 0 ≤ x j) (hx1 : ∀ j, x j ≤ 1)
    (hax : ∀ j, x j < a j) {s t : ℝ} (hs : 0 < s) (ht : 0 < t)
    (he : totalPhase a x d s = Real.pi) :
    (totalPhase a x d t < Real.pi ↔ t < s) ∧
      (Real.pi < totalPhase a x d t ↔ s < t) := by
  have hm := sumRatio_strictMonoOn hn hx hx1 hax
  have ha := phaseThreshold_antitoneOn hd
  have hR : sumRatio a x s = phaseThreshold d s :=
    (phase_eq_pi_iff_sumRatio a x d hs).mp he
  rw [phase_below_iff a x d ht, phase_above_iff a x d ht]
  constructor
  · constructor
    · intro h
      by_contra! hst
      have hmono := hm.monotoneOn hs ht hst
      have hanti := ha hs ht hst
      linarith
    · intro hts
      have hmono := hm ht hs hts
      have hanti := ha ht hs hts.le
      linarith
  · constructor
    · intro h
      by_contra! hts
      have hmono := hm.monotoneOn ht hs hts
      have hanti := ha ht hs hts
      linarith
    · intro hst
      have hmono := hm hs ht hst
      have hanti := ha hs ht hst.le
      linarith

end C2.NGamma.Phase

end

/- ===== C2.NGammaGainIntervalCore ===== -/

/-! Exact gain interval below the finite or infinite amplitude endpoint.
All stability statements concern roots of the actual characteristic polynomial. -/
noncomputable section
open scoped BigOperators
namespace C2.NGamma.Cayley
open PolynomialModel

lemma existsUnique_amplitude_crossing_in_range {n : ℕ} (hn : 0 < n)
    {r x : Fin n → ℝ} (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i)
    {b : ℝ} (hb : (∏ i, r i) < b)
    (hbound : (∃ j, x j = 0) ∨ b < ∏ i, (r i+2/x i)) :
    ∃! t : ℝ, 0 < t ∧ amplitude r x t = b := by
  by_cases hz : ∃ j, x j = 0
  · obtain ⟨j, hj⟩ := hz
    exact existsUnique_amplitude_crossing_of_zero hn hr hx hj hb
  · have hxp : ∀ i, 0 < x i := fun i =>
      lt_of_le_of_ne (hx i) (Ne.symm (fun he => hz ⟨i, he⟩))
    exact existsUnique_amplitude_crossing hn hr hxp hb (hbound.resolve_left hz)

lemma interior_interval_below_endpoint {n d : ℕ} (hn : 0 < n) (hd : 1 ≤ d)
    {r x : Fin n → ℝ} (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i)
    (hx1 : ∀ i, x i ≤ 1) {s : ℝ} (hs : 0 < s)
    (hphase : Phase.totalPhase (fun i => x i+2/r i) x d s = Real.pi)
    {b : ℝ} (hb : 0 ≤ b)
    (hbound : (∃ j, x j = 0) ∨ b < ∏ i, (r i+2/x i)) :
    SchurStable (characteristic r x d b) ↔ b < amplitude r x s := by
  have hbase := base_gain_lt_amplitude hn hr hx hs
  by_cases hlow : b ≤ ∏ i, r i
  · exact iff_of_true (low_gain_schur_fin hn hr hx d hb hlow) (lt_of_le_of_lt hlow hbase)
  · obtain ⟨t, ⟨ht, hBt⟩, _⟩ := existsUnique_amplitude_crossing_in_range hn hr hx
      (lt_of_not_ge hlow) hbound
    rw [schur_iff_phase_lt_pi_at_magnitude_crossing hn hd hr hx ht hBt hbound]
    rw [(Phase.phase_before_after_crossing hn hd hx hx1
      (fun i => lt_add_of_pos_right _ (div_pos (by norm_num) (hr i))) hs ht hphase).1]
    rw [← hBt]
    exact ((amplitude_strictMonoOn hn hr hx).lt_iff_lt ht.le hs.le).symm

lemma single_sample_endpoint_stable {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) (hx1 : ∀ i, x i ≤ 1)
    (hS : Phase.endpointSum r x ≤ 1) {b : ℝ} (hb : 0 ≤ b)
    (hbound : b < ∏ i, (r i+2/x i)) :
    SchurStable (characteristic r x 1 b) := by
  by_cases hlow : b ≤ ∏ i, r i
  · exact low_gain_schur_fin hn hr (fun i => (hx i).le) 1 hb hlow
  · obtain ⟨t, ⟨ht, hBt⟩, _⟩ := existsUnique_amplitude_crossing hn hr hx
      (lt_of_not_ge hlow) hbound
    apply (schur_iff_phase_lt_pi_at_magnitude_crossing hn (le_refl 1) hr
      (fun i => (hx i).le) ht hBt (Or.inr hbound)).2
    exact Phase.single_phase_below_pi_of_endpoint hn hr hx hx1 hS ht

end C2.NGamma.Cayley

end

/- ===== C2.NGammaRootCountHighGain ===== -/
noncomputable section
open scoped BigOperators ComplexConjugate Topology
open Set Complex Polynomial Filter
namespace C2.NGamma.PolynomialModel
variable {n : ℕ} {r x : Fin n → ℝ}

def negativeQ (x y : ℝ) : ℝ := ((1+x)*y-(1-x))/2

def negativeMagnitude (r x : Fin n → ℝ) (y : ℝ) : ℝ :=
  y * ∏ i, (r i+(y+1)/negativeQ (x i) y)

theorem negativeQ_pos {x y : ℝ} (hx : 0 < x) (hy : 1 ≤ y) : 0 < negativeQ x y := by
  unfold negativeQ
  have hh : 0 ≤ x*(y-1) := mul_nonneg hx.le (by linarith)
  nlinarith

theorem negativeMagnitude_one (hx : ∀ i, 0 < x i) :
    negativeMagnitude r x 1 = ∏ i, (r i+2/x i) := by
  norm_num [negativeMagnitude, negativeQ]

theorem continuousOn_negativeMagnitude (hx : ∀ i, 0 < x i) :
    ContinuousOn (negativeMagnitude r x) (Set.Ici 1) := by
  apply continuousOn_id.mul
  apply continuousOn_finset_prod
  intro i hi
  apply continuousOn_const.add
  apply (continuousOn_id.add continuousOn_const).div
  · unfold negativeQ
    fun_prop
  · intro y hy
    exact ne_of_gt (negativeQ_pos (hx i) hy)

theorem negativeMagnitude_lower (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i)
    {y : ℝ} (hy : 1 ≤ y) : y * ∏ i, r i ≤ negativeMagnitude r x y := by
  apply mul_le_mul_of_nonneg_left _ (by linarith)
  apply Finset.prod_le_prod
  · intro i hi
    exact (hr i).le
  · intro i hi
    have hh : 0 ≤ (y+1)/negativeQ (x i) y := by
      exact div_nonneg (by linarith) (negativeQ_pos (hx i) hy).le
    linarith

theorem characteristic_eval_neg_real {y : ℝ} (hx : ∀ i, 0 < x i) (hy : 1 ≤ y) (b : ℝ) :
    (characteristic r x 1 b).eval (-(y : ℂ)) =
      (-1 : ℂ)^n * (∏ i, (negativeQ (x i) y : ℂ)) * (b-negativeMagnitude r x y) := by
  have hq (i : Fin n) : (q (x i)).eval (-(y : ℂ)) = -(negativeQ (x i) y : ℂ) := by
    rw [q_eval]
    simp only [negativeQ, Complex.ofReal_div, Complex.ofReal_sub, Complex.ofReal_mul,
      Complex.ofReal_add, Complex.ofReal_one, Complex.ofReal_ofNat]
    ring
  have hf (i : Fin n) : (factor (r i) (x i)).eval (-(y : ℂ)) =
      -(negativeQ (x i) y : ℂ) * (r i+(y+1)/negativeQ (x i) y : ℝ) := by
    rw [factor_eval, hq]
    push_cast
    have hn : (negativeQ (x i) y : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt (negativeQ_pos (hx i) hy)
    field_simp
    <;> ring
  simp only [characteristic, eval_add, eval_mul, eval_pow, eval_X, pow_one, eval_C, eval_prod,
    hf, hq, Finset.prod_mul_distrib, Finset.prod_neg, Finset.card_univ, Fintype.card_fin, negativeMagnitude,
    Complex.ofReal_mul, Complex.ofReal_prod]
  norm_cast
  ring

theorem exists_negative_real_root_of_endpoint_le
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i)
    {b : ℝ} (hb : (∏ i, (r i+2/x i)) ≤ b) :
    ∃ y : ℝ, 1 ≤ y ∧ (characteristic r x 1 b).eval (-(y : ℂ)) = 0 := by
  let B0 : ℝ := ∏ i, r i
  have hB : 0 < B0 := Finset.prod_pos (fun i _ => hr i)
  let Y : ℝ := max 1 ((b+1)/B0)
  have hY : 1 ≤ Y := le_max_left _ _
  have hbY : b < negativeMagnitude r x Y := by
    have hh : (b+1)/B0 ≤ Y := le_max_right _ _
    have hh' : b+1 ≤ Y*B0 := (div_le_iff₀ hB).1 hh
    have hl := negativeMagnitude_lower hr hx hY
    dsimp [B0] at *
    linarith
  have hstart : negativeMagnitude r x 1 ≤ b := by simpa [negativeMagnitude_one hx] using hb
  have hc := (continuousOn_negativeMagnitude (r := r) hx).mono (show Set.Icc 1 Y ⊆ Set.Ici 1 from fun y hy => hy.1)
  obtain ⟨y, hy, he⟩ := intermediate_value_Icc hY hc ⟨hstart, hbY.le⟩
  refine ⟨y, hy.1, ?_⟩
  rw [characteristic_eval_neg_real hx hy.1, he]
  simp

theorem not_schur_of_endpoint_le
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i)
    {b : ℝ} (hb : (∏ i, (r i+2/x i)) ≤ b) :
    ¬ SchurStable (characteristic r x 1 b) := by
  intro hs
  obtain ⟨y, hy, he⟩ := exists_negative_real_root_of_endpoint_le hr hx hb
  have hh := hs (-(y : ℂ)) he
  simp only [norm_neg, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by linarith : 0 ≤ y)] at hh
  exact not_lt_of_ge hy hh

end C2.NGamma.PolynomialModel

end

/- ===== C2.NGammaRootCountHighGainAll ===== -/

/-! Above the finite magnitude endpoint, the translated transfer curve lies in
an open right half-plane. Its argument has zero endpoint change, so exactly d
roots are exterior whenever the endpoint itself is nonzero. -/
noncomputable section
open scoped BigOperators ComplexConjugate Topology
open Set Complex Polynomial Filter
namespace C2.NGamma.Cayley
open PolynomialModel RootCountBridge ArgumentMatch
variable {n : ℕ} {r x : Fin n → ℝ}

def highGainAngle (r x : Fin n → ℝ) (d : ℕ) (b t : ℝ) : ℝ :=
  (∑ i, qPhase (x i) t) + Complex.arg (transfer r x d (point t)+b)

theorem high_gain_count_from_endpoint (hn : 0 < n) {d : ℕ} (hd : 1 ≤ d)
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) {b : ℝ}
    (hb : (∏ i, (r i+2/x i)) ≤ b)
    (hend : (characteristic r x d b).eval (-1) ≠ 0) :
    countOutside (characteristic r x d b) = d := by
  let B : ℝ := ∏ i, (r i+2/x i)
  have hB : 0 < B := Finset.prod_pos (fun i _ => add_pos (hr i) (div_pos (by norm_num) (hx i)))
  have hbpos : 0 < b := lt_of_lt_of_le hB hb
  have hW : Continuous (fun t => transfer r x d (point t)) := by
    have hh := polarCurve_continuous (amplitude_continuous r x)
      (Phase.totalPhase_continuous (fun i => x i+2/r i) x d)
    change Continuous (fun t => polarCurve (amplitude r x)
      (Phase.totalPhase (fun i => x i+2/r i) x d) t) at hh
    simpa only [polarCurve, ← transfer_polar (fun i => ne_of_gt (hr i))] using hh
  have hRe : ∀ t : ℝ, 0 ≤ t → 0 < (transfer r x d (point t)+(b:ℂ)).re := by
    intro t ht
    apply add_re_pos_of_norm_lt
    rw [transfer_norm hr]
    exact lt_of_lt_of_le (amplitude_lt_endpoint hn hr hx ht) hb
  have hfinite : ∀ t : ℝ, 0 ≤ t → (characteristic r x d b).eval (point t) ≠ 0 := by
    intro t ht
    rw [characteristic_eval_point]
    apply mul_ne_zero (Finset.prod_ne_zero_iff.2 (fun i _ => q_eval_point_ne_zero (x i) t))
    intro he
    have hh := hRe t ht
    rw [he] at hh
    exact lt_irrefl 0 hh
  have hroots := no_unit_roots_of_cayley_nonzero (characteristic_eval_conj r x d b) hfinite hend
  have hcont : ContinuousOn (highGainAngle r x d b) (Set.Ici 0) := by
    apply (continuous_finset_sum _ (fun i _ => qPhase_continuous (x i))).continuousOn.add
    intro t ht
    exact ContinuousAt.comp_continuousWithinAt
      (f := fun u => transfer r x d (point u)+(b:ℂ))
      (Complex.continuousAt_arg (Or.inl (hRe t ht)))
      (hW.add continuous_const).continuousAt.continuousWithinAt
  have hpolar : ∀ t ∈ Set.Ici (0:ℝ), (characteristic r x d b).eval (point t) =
      (‖(characteristic r x d b).eval (point t)‖:ℂ)*
      Complex.exp ((highGainAngle r x d b t:ℂ)*I) := by
    intro t ht
    rw [characteristic_eval_point]
    exact polar_mul (q_product_polar x t) (Complex.norm_mul_exp_arg_mul_I _).symm
  let C : ℝ := B*(-1)^d+b
  have hCnonneg : 0 ≤ C := by
    have hh : |(-1:ℝ)^d| = 1 := by simp
    have hl := neg_abs_le ((-1:ℝ)^d)
    dsimp [C]
    nlinarith
  have hCne : C ≠ 0 := by
    intro he
    apply hend
    rw [characteristic_neg_one_factorized hx]
    have hh : (-1:ℂ)^d*((∏ i, (r i+2/x i):ℝ):ℂ)+(b:ℂ) = (C:ℂ) := by
      dsimp [C,B]
      push_cast
      ring
    rw [hh, he, Complex.ofReal_zero, mul_zero]
  have hCpos : 0 < C := lt_of_le_of_ne hCnonneg (Ne.symm hCne)
  have hWlim : Tendsto (fun t => transfer r x d (point t)+(b:ℂ)) atTop (𝓝 (C:ℂ)) := by
    convert (transfer_point_tendsto_atTop hr hx d).add_const (b:ℂ) using 1
    dsimp [C,B]
    push_cast
    ring
  have hargLim : Tendsto (fun t => Complex.arg (transfer r x d (point t)+(b:ℂ))) atTop (𝓝 0) := by
    have h := (Complex.continuousAt_arg (Or.inl (show 0 < (C:ℂ).re from hCpos))).tendsto.comp hWlim
    simpa only [Complex.arg_ofReal_of_nonneg hCpos.le] using h
  have hqLim : Tendsto (fun t => ∑ i, qPhase (x i) t) atTop (𝓝 ((n:ℝ)*Real.pi)) := by
    simpa [ne_of_gt (hx _)] using sum_qPhase_tendsto_atTop (fun i => (hx i).le)
  have hlim : Tendsto (highGainAngle r x d b) atTop (𝓝 ((n:ℝ)*Real.pi)) := by
    simpa only [add_zero] using hqLim.add hargLim
  have hzero : highGainAngle r x d b 0 = 0 := by
    simp only [highGainAngle, qPhase, mul_zero, Real.arctan_zero, add_zero,
      Finset.sum_const_zero, zero_add]
    have hWzero : transfer r x d (point 0) = ((∏ i, r i : ℝ):ℂ) := by
      simp [transfer, point, q_eval_one, factor_eval_one]
    rw [hWzero, ← Complex.ofReal_add]
    apply Complex.arg_ofReal_of_nonneg
    exact (add_pos (Finset.prod_pos (fun i _ => hr i)) hbpos).le
  have hc := polynomial_argument_principle_cayley
    (characteristic_ne_zero hr (fun i => (hx i).le) hd b)
    (characteristic_eval_conj r x d b) hroots hcont hpolar hlim
  rw [hzero, sub_zero] at hc
  have hi : countInside (characteristic r x d b) = n := by
    have hh : (countInside (characteristic r x d b):ℝ) = n :=
      mul_right_cancel₀ Real.pi_ne_zero hc.symm
    exact_mod_cast hh
  have hp := count_partition (characteristic r x d b) hroots
  rw [hi, characteristic_natDegree hr (fun i => (hx i).le) hd b, Fintype.card_fin] at hp
  omega

theorem not_schur_of_endpoint_le_all_delays (hn : 0 < n) {d : ℕ} (hd : 1 ≤ d)
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) {b : ℝ}
    (hb : (∏ i, (r i+2/x i)) ≤ b) :
    ¬ SchurStable (characteristic r x d b) := by
  intro hs
  by_cases hend : (characteristic r x d b).eval (-1) = 0
  · have hh := hs (-1) hend
    simpa using hh
  · have hcount := high_gain_count_from_endpoint hn hd hr hx hb hend
    have hp := characteristic_ne_zero hr (fun i => (hx i).le) hd b
    have hroots : ∀ a ∈ (characteristic r x d b).roots, ‖a‖ ≠ 1 := by
      intro a ha
      exact ne_of_lt (hs a ((Polynomial.mem_roots hp).1 ha))
    have hz := (schur_iff_countOutside_zero hp hroots).1 hs
    omega

end C2.NGamma.Cayley

end

/- ===== C2.NGammaGainInterval ===== -/

/-! Complete exact Schur gain intervals for one or several samples of delay.
The middle-gain implication uses the proved polynomial root count; small gains
use a direct norm inequality and all gains above the finite amplitude endpoint
are excluded by the proved high-gain root count. -/
noncomputable section
open scoped BigOperators
namespace C2.NGamma.Cayley
open PolynomialModel

/-- Exact endpoint interval, including the equality S=1 in its assumptions. -/
theorem single_sample_endpoint_interval {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) (hx1 : ∀ i, x i ≤ 1)
    (hS : Phase.endpointSum r x ≤ 1) {b : ℝ} (hb : 0 ≤ b) :
    SchurStable (characteristic r x 1 b) ↔ b < ∏ i, (r i+2/x i) := by
  constructor
  · intro hs
    by_contra! hbig
    exact not_schur_of_endpoint_le_all_delays hn (le_refl 1) hr hx hbig hs
  · exact single_sample_endpoint_stable hn hr hx hx1 hS hb

/-- The first phase crossing determines the entire stable interval for every
positive integer delay, with no possibility of later stability reentry. -/
theorem interior_exact_gain_interval {n d : ℕ} (hn : 0 < n) (hd : 1 ≤ d)
    {r x : Fin n → ℝ} (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i)
    (hx1 : ∀ i, x i ≤ 1) {s : ℝ} (hs : 0 < s)
    (hphase : Phase.totalPhase (fun i => x i+2/r i) x d s = Real.pi)
    {b : ℝ} (hb : 0 ≤ b) :
    SchurStable (characteristic r x d b) ↔ b < amplitude r x s := by
  by_cases hbound : (∃ j, x j = 0) ∨ b < ∏ i, (r i+2/x i)
  · exact interior_interval_below_endpoint hn hd hr hx hx1 hs hphase hb hbound
  · have hz : ¬ ∃ j, x j = 0 := fun h => hbound (Or.inl h)
    have hxp : ∀ i, 0 < x i := fun i =>
      lt_of_le_of_ne (hx i) (Ne.symm (fun he => hz ⟨i, he⟩))
    have hbig : (∏ i, (r i+2/x i)) ≤ b := by
      by_contra! hh
      exact hbound (Or.inr hh)
    have hBstar := amplitude_lt_endpoint hn hr hxp hs.le
    exact iff_of_false (not_schur_of_endpoint_le_all_delays hn hd hr hxp hbig)
      (not_lt_of_ge (le_trans hBstar.le hbig))

/-- Full one-sample interior alternative of the exact interval theorem. -/
theorem single_sample_interior_interval {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) (hx1 : ∀ i, x i ≤ 1)
    (hcase : (∃ i, x i = 0) ∨ 1 < Phase.endpointSum r x) :
    ∃! s : ℝ, 0 < s ∧
      Phase.totalPhase (fun i => x i+2/r i) x 1 s = Real.pi ∧
      (∀ b : ℝ, 0 ≤ b → (SchurStable (characteristic r x 1 b) ↔ b < amplitude r x s)) ∧
      (characteristic r x 1 (amplitude r x s)).eval (point s) = 0 ∧ ‖point s‖ = 1 := by
  obtain ⟨s, ⟨hs, hphase⟩, huniq⟩ := (Phase.single_sample_phase_crossing_iff hn hr hx hx1).2 hcase
  have hroot := first_crossing_gives_unit_root hr x 1 s hphase
  refine ⟨s, ⟨hs, hphase, ?_, hroot⟩, ?_⟩
  · intro b hb
    exact interior_exact_gain_interval hn (le_refl 1) hr hx hx1 hs hphase hb
  · intro t ht
    exact huniq t ⟨ht.1, ht.2.1⟩

/-- The two alternatives of the paper's exact one-sample gain theorem. -/
theorem single_sample_exact_gain_interval {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) (hx1 : ∀ i, x i ≤ 1) :
    ((∀ i, 0 < x i) ∧ Phase.endpointSum r x ≤ 1 ∧
      (∀ b : ℝ, 0 ≤ b → (SchurStable (characteristic r x 1 b) ↔ b < ∏ i, (r i+2/x i))) ∧
      (characteristic r x 1 (∏ i, (r i+2/x i))).eval (-1) = 0) ∨
    (∃! s : ℝ, 0 < s ∧
      Phase.totalPhase (fun i => x i+2/r i) x 1 s = Real.pi ∧
      (∀ b : ℝ, 0 ≤ b → (SchurStable (characteristic r x 1 b) ↔ b < amplitude r x s)) ∧
      (characteristic r x 1 (amplitude r x s)).eval (point s) = 0 ∧ ‖point s‖ = 1) := by
  by_cases hcase : (∃ i, x i = 0) ∨ 1 < Phase.endpointSum r x
  · exact Or.inr (single_sample_interior_interval hn hr hx hx1 hcase)
  · have hz : ¬ ∃ i, x i = 0 := fun h => hcase (Or.inl h)
    have hxp : ∀ i, 0 < x i := fun i =>
      lt_of_le_of_ne (hx i) (Ne.symm (fun he => hz ⟨i, he⟩))
    have hS : Phase.endpointSum r x ≤ 1 := by
      by_contra! hh
      exact hcase (Or.inr hh)
    exact Or.inl ⟨hxp, hS, fun b hb => single_sample_endpoint_interval hn hr hxp hx1 hS hb,
      endpoint_is_root (fun i => ne_of_gt (hxp i))⟩

/-- Full multiple-delay corollary: unique first phase crossing, strict frequency
bound, exact stable gain interval, and an actual unit-circle boundary root. -/
theorem multiple_delay_exact_gain_interval {n d : ℕ} (hn : 0 < n) (hd : 2 ≤ d)
    {r x : Fin n → ℝ} (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 ≤ x i) (hx1 : ∀ i, x i ≤ 1) :
    ∃! s : ℝ, 0 < s ∧ s < Real.tan (Real.pi/(2*(d:ℝ))) ∧
      Phase.totalPhase (fun i => x i+2/r i) x d s = Real.pi ∧
      (∀ b : ℝ, 0 ≤ b → (SchurStable (characteristic r x d b) ↔ b < amplitude r x s)) ∧
      (characteristic r x d (amplitude r x s)).eval (point s) = 0 ∧ ‖point s‖ = 1 := by
  have hax : ∀ i, x i < x i+2/r i := fun i =>
    lt_add_of_pos_right _ (div_pos (by norm_num) (hr i))
  obtain ⟨s, ⟨hs, hbound, hphase⟩, huniq⟩ := Phase.multiple_delay_unique_phase_crossing hn hd hx hx1 hax
  have hroot := first_crossing_gives_unit_root hr x d s hphase
  refine ⟨s, ⟨hs, hbound, hphase, ?_, hroot⟩, ?_⟩
  · intro b hb
    exact interior_exact_gain_interval hn (by omega) hr hx hx1 hs hphase hb
  · intro t ht
    exact huniq t ⟨ht.1, ht.2.1, ht.2.2.1⟩

end C2.NGamma.Cayley

end

/- ===== C2.NGammaBoundaryPair ===== -/

noncomputable section
open scoped ComplexConjugate
namespace C2.NGamma.Cayley
open PolynomialModel RootCountBridge

lemma point_im_pos {t : ℝ} (ht : 0 < t) : 0 < (point t).im := by
  rw [point_exp, Complex.exp_ofReal_mul_I_im]
  exact Real.sin_pos_of_pos_of_lt_pi (by linarith [Phase.arctan_pos ht])
    (by linarith [Real.arctan_lt_pi_div_two t])

lemma first_crossing_conjugate_pair {n : ℕ} {r : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (x : Fin n → ℝ) (d : ℕ) {t : ℝ} (ht : 0 < t)
    (hphase : Phase.totalPhase (fun i => x i+2/r i) x d t = Real.pi) :
    (characteristic r x d (amplitude r x t)).eval (point t) = 0 ∧
    (characteristic r x d (amplitude r x t)).eval (conj (point t)) = 0 ∧
    ‖point t‖ = 1 ∧ ‖conj (point t)‖ = 1 ∧ point t ≠ conj (point t) := by
  have hroot := first_crossing_gives_unit_root hr x d t hphase
  refine ⟨hroot.1, ?_, hroot.2, ?_, ?_⟩
  · rw [characteristic_eval_conj, hroot.1, map_zero]
  · simpa using hroot.2
  · intro he
    have hh := congrArg Complex.im he
    have hp := point_im_pos ht
    simp only [Complex.conj_im] at hh
    linarith

end C2.NGamma.Cayley

end

/- ===== C2.NGammaGlobal ===== -/

/-!
# Analytic cores for the independent-parameter global optimization

These results prove exact phase feasibility and the strict reflection comparisons.
They do not assume or assert an argument-principle root count, continuity of a
parametric maximizer, or the full global gain-margin theorem.
-/

noncomputable section
open scoped BigOperators Topology
open Set
open Filter

namespace C2.NGamma.Global

def phase (r x w : ℝ) : ℝ :=
  Real.arctan ((x + 2 / r) / w) - Real.arctan (x / w)

def phaseDenom (r x w : ℝ) : ℝ := r * (x ^ 2 + w ^ 2) + 2 * x

theorem phaseDenom_pos {r x w : ℝ} (hr : 0 < r) (hx : 0 ≤ x) (hw : 0 < w) :
    0 < phaseDenom r x w := by
  unfold phaseDenom
  have : 0 < w ^ 2 := sq_pos_of_pos hw
  positivity

theorem phase_pos {r x w : ℝ} (hr : 0 < r) (hw : 0 < w) :
    0 < phase r x w := by
  unfold phase
  apply sub_pos.mpr
  apply Real.arctan_strictMono
  apply (div_lt_div_iff_of_pos_right hw).2
  have : 0 < 2 / r := div_pos (by norm_num) hr
  linarith

theorem phase_lt_pi_div_two {r x w : ℝ} (hx : 0 ≤ x) (hw : 0 < w) :
    phase r x w < Real.pi / 2 := by
  have hx' : 0 ≤ Real.arctan (x / w) := by
    simpa only [Real.arctan_zero] using Real.arctan_strictMono.monotone (div_nonneg hx hw.le)
  have h := Real.arctan_lt_pi_div_two ((x + 2/r) / w)
  unfold phase
  linarith

theorem phase_eq_arctan {r x w : ℝ} (hr : 0 < r) (hx : 0 ≤ x) (hw : 0 < w) :
    phase r x w = Real.arctan (2 * w / phaseDenom r x w) := by
  have hnon : 0 ≤ (x + 2 / r) / w := by positivity
  have hprod : ((x + 2 / r) / w) * (-(x / w)) < 1 := by
    have := mul_nonpos_of_nonneg_of_nonpos hnon (neg_nonpos.mpr (div_nonneg hx hw.le))
    linarith
  have h := Real.arctan_add hprod
  rw [Real.arctan_neg] at h
  change phase r x w = _ at h
  rw [h]
  congr 1
  have hd := ne_of_gt (phaseDenom_pos hr hx hw)
  unfold phaseDenom at *
  field_simp [ne_of_gt hr, ne_of_gt hw, hd]
  <;> ring

theorem phase_strictAntiOn {r w : ℝ} (hr : 0 < r) (hw : 0 < w) :
    StrictAntiOn (fun x => phase r x w) (Ici 0) := by
  intro a ha b hb hab
  dsimp only
  rw [phase_eq_arctan hr ha hw, phase_eq_arctan hr hb hw]
  apply Real.arctan_strictMono
  apply div_lt_div_of_pos_left (by positivity) (phaseDenom_pos hr ha hw)
  unfold phaseDenom
  have hsq : a ^ 2 < b ^ 2 := sq_lt_sq₀ ha hb |>.2 hab
  nlinarith

theorem phase_continuous (r w : ℝ) : Continuous (fun x => phase r x w) := by
  unfold phase
  exact (Real.continuous_arctan.comp ((continuous_id.add continuous_const).div_const w)).sub
    (Real.continuous_arctan.comp (continuous_id.div_const w))

theorem phase_bounds {r x w : ℝ} (hr : 0 < r) (hw : 0 < w)
    (hx : x ∈ Icc (0:ℝ) 1) :
    phase r 1 w ≤ phase r x w ∧ phase r x w ≤ phase r 0 w := by
  have h := (phase_strictAntiOn hr hw).antitoneOn
  exact ⟨h hx.1 (by norm_num) hx.2, h (by norm_num) hx.1 hx.1⟩

/-- The finite-dimensional phase constraint is feasible exactly between its
two endpoint sums. A common coordinate already witnesses every intermediate
sum; no Lagrange-multiplier or optimizer-existence premise is used. -/
theorem phase_feasible_iff {n : ℕ} (r : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    {w q : ℝ} (hw : 0 < w) :
    (∃ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) ∧
      ∑ j, phase (r j) (x j) w = q) ↔
    (∑ j, phase (r j) 1 w ≤ q ∧ q ≤ ∑ j, phase (r j) 0 w) := by
  constructor
  · rintro ⟨x,hx,hq⟩
    rw [← hq]
    constructor
    · exact Finset.sum_le_sum (fun j _ => (phase_bounds (hr j) hw (hx j)).1)
    · exact Finset.sum_le_sum (fun j _ => (phase_bounds (hr j) hw (hx j)).2)
  · intro hq
    let f : ℝ → ℝ := fun a => ∑ j, phase (r j) a w
    have hf : ContinuousOn f (Icc (0:ℝ) 1) := by
      apply Continuous.continuousOn
      exact continuous_finset_sum _ (fun j _ => phase_continuous (r j) w)
    obtain ⟨a,ha,heq⟩ := intermediate_value_Icc' (by norm_num : (0:ℝ) ≤ 1) hf hq
    exact ⟨fun _ => a, fun _ => ha, heq⟩

/-- If a phase sum is at its all-zero endpoint, each coordinate is zero. -/
theorem phase_upper_endpoint_unique {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) {w : ℝ} (hw : 0 < w)
    (hx : ∀ j, x j ∈ Icc (0:ℝ) 1)
    (heq : (∑ j, phase (r j) (x j) w) = ∑ j, phase (r j) 0 w) :
    ∀ j, x j = 0 := by
  intro j
  by_contra hne
  have hp : 0 < x j := lt_of_le_of_ne (hx j).1 (Ne.symm hne)
  have hs : (∑ i, phase (r i) (x i) w) < ∑ i, phase (r i) 0 w := by
    apply Finset.sum_lt_sum
    · intro i _
      exact (phase_bounds (hr i) hw (hx i)).2
    · exact ⟨j, Finset.mem_univ j,
        phase_strictAntiOn (hr j) hw (by norm_num) (hx j).1 hp⟩
  exact (ne_of_lt hs) heq

/-- If a phase sum is at its all-one endpoint, each coordinate is one. -/
theorem phase_lower_endpoint_unique {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) {w : ℝ} (hw : 0 < w)
    (hx : ∀ j, x j ∈ Icc (0:ℝ) 1)
    (heq : (∑ j, phase (r j) (x j) w) = ∑ j, phase (r j) 1 w) :
    ∀ j, x j = 1 := by
  intro j
  by_contra hne
  have hp : x j < 1 := lt_of_le_of_ne (hx j).2 hne
  have hs : (∑ i, phase (r i) 1 w) < ∑ i, phase (r i) (x i) w := by
    apply Finset.sum_lt_sum
    · intro i _
      exact (phase_bounds (hr i) hw (hx i)).1
    · exact ⟨j, Finset.mem_univ j,
        phase_strictAntiOn (hr j) hw (hx j).1 (by norm_num) hp⟩
  exact (ne_of_gt hs) heq

theorem arctan_sum_le {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    Real.arctan (a+b) ≤ Real.arctan a + Real.arctan b := by
  by_cases hab : a*b < 1
  · rw [Real.arctan_add hab]
    apply Real.arctan_strictMono.monotone
    apply (le_div_iff₀ (by linarith : 0 < 1-a*b)).2
    have := mul_nonneg (add_nonneg ha hb) (mul_nonneg ha hb)
    nlinarith
  · have hp : 0 < b := by
      by_contra hn
      have : b = 0 := le_antisymm (le_of_not_gt hn) hb
      simp [this] at hab
    have hba : b⁻¹ ≤ a := by
      rw [inv_eq_one_div]
      exact (div_le_iff₀ hp).2 (by linarith)
    have h := Real.arctan_strictMono.monotone hba
    rw [Real.arctan_inv_of_pos hp] at h
    exact le_trans (Real.arctan_lt_pi_div_two (a+b)).le (by linarith)

theorem arctan_double_lt {v : ℝ} (hv : 0 < v) :
    Real.arctan (2*v) < 2 * Real.arctan v := by
  by_cases hvv : v*v < 1
  · have h := Real.arctan_add hvv
    have hh : 2*v < (v+v)/(1-v*v) := by
      apply (lt_div_iff₀ (by linarith : 0 < 1-v*v)).2
      have := mul_pos hv (sq_pos_of_pos hv)
      nlinarith
    have := Real.arctan_strictMono hh
    rw [← h] at this
    linarith
  · have hinv : v⁻¹ ≤ v := by
      rw [inv_eq_one_div]
      exact (div_le_iff₀ hv).2 (by linarith)
    have h := Real.arctan_strictMono.monotone hinv
    rw [Real.arctan_inv_of_pos hv] at h
    have := Real.arctan_lt_pi_div_two (2*v)
    linarith

/-- Strict phase improvement under reflection, including the zero-gain
boundary case u=c. This is the analytical comparison used by the full-cube
initial-margin argument, not a statement about polynomial roots. -/
theorem reflection_phase_strict {c u t : ℝ} (hu : 0 < u) (huc : u ≤ c)
    (ht : 0 < t) :
    Real.arctan ((c+u)*t) - Real.arctan (u*t) <
      Real.arctan ((c-u)*t) + Real.arctan (u*t) := by
  have h₁ := arctan_sum_le (mul_nonneg (sub_nonneg.mpr huc) ht.le)
    (by positivity : 0 ≤ 2*(u*t))
  have heq : (c-u)*t + 2*(u*t) = (c+u)*t := by ring
  rw [heq] at h₁
  have h₂ := arctan_double_lt (mul_pos hu ht)
  linarith

theorem reflection_magnitude_sq_strict {c u t : ℝ} (hc : 0 < c)
    (hu : 0 < u) (ht : 0 < t) :
    (1+(c-u)^2*t^2)/(1+u^2*t^2) <
      (1+(c+u)^2*t^2)/(1+u^2*t^2) := by
  apply (div_lt_div_iff_of_pos_right (by positivity : 0 < 1+u^2*t^2)).2
  have := mul_pos (mul_pos hc hu) (sq_pos_of_pos ht)
  nlinarith

theorem reflection_magnitude_strict {r c u t : ℝ} (hr : 0 < r)
    (hc : 0 < c) (hu : 0 < u) (ht : 0 < t) :
    r * Real.sqrt ((1+(c-u)^2*t^2)/(1+u^2*t^2)) <
      r * Real.sqrt ((1+(c+u)^2*t^2)/(1+u^2*t^2)) := by
  apply mul_lt_mul_of_pos_left _ hr
  apply Real.sqrt_lt_sqrt (by positivity)
  exact reflection_magnitude_sq_strict hc hu ht

def marginal (r x w : ℝ) : ℝ :=
  (r * (x^2-w^2) + 2*x) / (2*w*(r*x+1))

def negPhaseDerivative (r x w : ℝ) : ℝ :=
  4*w*(r*x+1) / (((r*x+2)^2 + r^2*w^2)*(x^2+w^2))

theorem marginal_below_x_div_w {r x w : ℝ} (hr : 0 < r)
    (hx : 0 ≤ x) (hw : 0 < w) : marginal r x w < x/w := by
  unfold marginal
  have hy : 0 < r*x+1 := by positivity
  apply (div_lt_div_iff₀ (by positivity) hw).2
  have hsq : 0 < x^2+w^2 := by positivity
  nlinarith [mul_pos (mul_pos hr hw) hsq]

theorem negPhaseDerivative_pos {r x w : ℝ} (hr : 0 < r)
    (hx : 0 ≤ x) (hw : 0 < w) : 0 < negPhaseDerivative r x w := by
  unfold negPhaseDerivative
  positivity

/-- Algebraic factorization behind the positive-multiplier branch of the
envelope estimate. Every quantity is the actual rational derivative. -/
theorem positive_multiplier_component {r x w lam : ℝ} (hr : 0 < r)
    (hx : 0 ≤ x) (hw : 0 < w) (hlam : 0 < lam)
    (hbound : lam*w < x) :
    lam/w * (2*w/phaseDenom r x w) <
      negPhaseDerivative r x w * (1+lam*marginal r x w) := by
  let D := phaseDenom r x w
  let Q := ((r*x+2)^2 + r^2*w^2)*(x^2+w^2)
  have hD : 0 < D := phaseDenom_pos hr hx hw
  have hQ : 0 < Q := by dsimp [Q]; positivity
  have hy : 0 < r*x+1 := by positivity
  have hDgt : 2*x < D := by
    dsimp [D,phaseDenom]
    have : 0 < r*(x^2+w^2) := by positivity
    linarith
  have hrbound : lam*r*w < r*x := by nlinarith [mul_pos hr (sub_pos.mpr hbound)]
  have hinner : 0 < D*(r*x+1-lam*r*w)-2*lam*w := by
    have hprod := mul_pos hD (show 0 < r*x-lam*r*w by linarith)
    nlinarith
  have hid :
      negPhaseDerivative r x w * (1+lam*marginal r x w) -
        lam/w * (2*w/phaseDenom r x w) =
      4*w*(D*(r*x+1-lam*r*w)-2*lam*w)/(Q*D) := by
    dsimp [D,Q,negPhaseDerivative,marginal,phaseDenom]
    field_simp
    <;> ring
  apply sub_pos.mp
  rw [hid]
  exact div_pos (by positivity) (mul_pos hQ hD)

/-- The elementary finite-sum trigonometric estimate in the envelope proof.
This form works for any nonempty finite family of positive acute phases. -/
theorem sin_sum_lt_sum_tan {n : ℕ} (hn : 0 < n) (d : Fin n → ℝ)
    (hd : ∀ j, 0 < d j ∧ d j < Real.pi/2) :
    Real.sin (∑ j, d j) < ∑ j, Real.tan (d j) := by
  have hsum : 0 ≤ ∑ j, d j := Finset.sum_nonneg (fun j _ => (hd j).1.le)
  have hlt : (∑ j, d j) < ∑ j, Real.tan (d j) := by
    apply Finset.sum_lt_sum
    · intro j _
      exact (Real.lt_tan (hd j).1 (hd j).2).le
    · exact ⟨⟨0,hn⟩, Finset.mem_univ _, Real.lt_tan (hd ⟨0,hn⟩).1 (hd ⟨0,hn⟩).2⟩
  exact lt_of_le_of_lt (Real.sin_le hsum) hlt

/-- Scalar crossing used for the feasible-frequency endpoints. -/
theorem unique_positive_crossing_atTop {f : ℝ → ℝ}
    (hf : ContinuousOn f (Ioi 0)) (hm : StrictMonoOn f (Ioi 0))
    (hz : Tendsto f (𝓝[>] 0) (𝓝 0)) (hinf : Tendsto f atTop atTop) :
    ∃! t, 0 < t ∧ f t = 2 := by
  have hhi : (atTop : Filter ℝ) ≤ 𝓟 (Ioi 0) := by
    rw [Filter.le_principal_iff]
    exact eventually_gt_atTop 0
  obtain ⟨t,ht,hft⟩ := isPreconnected_Ioi.intermediate_value_Ioi
    (show (𝓝[>] (0:ℝ)) ≤ 𝓟 (Ioi 0) from inf_le_right) hhi hf hz hinf
    (by norm_num : (2:ℝ) ∈ Ioi 0)
  refine ⟨t,⟨ht,hft⟩,?_⟩
  intro s hs
  exact (hm.eq_iff_eq hs.1 ht).mp (hs.2.trans hft.symm)

theorem unique_positive_crossing_finite {f : ℝ → ℝ} {L : ℝ}
    (hf : ContinuousOn f (Ioi 0)) (hm : StrictMonoOn f (Ioi 0))
    (hz : Tendsto f (𝓝[>] 0) (𝓝 0)) (hinf : Tendsto f atTop (𝓝 L))
    (hL : 2 < L) :
    ∃! t, 0 < t ∧ f t = 2 := by
  have hhi : (atTop : Filter ℝ) ≤ 𝓟 (Ioi 0) := by
    rw [Filter.le_principal_iff]
    exact eventually_gt_atTop 0
  obtain ⟨t,ht,hft⟩ := isPreconnected_Ioi.intermediate_value_Ioo
    (show (𝓝[>] (0:ℝ)) ≤ 𝓟 (Ioi 0) from inf_le_right) hhi hf hz hinf
    (show (2:ℝ) ∈ Ioo 0 L from ⟨by norm_num,hL⟩)
  refine ⟨t,⟨ht,hft⟩,?_⟩
  intro s hs
  exact (hm.eq_iff_eq hs.1 ht).mp (hs.2.trans hft.symm)

theorem strictly_below_finite_limit {f : ℝ → ℝ} {L t : ℝ}
    (hm : StrictMonoOn f (Ioi 0)) (hinf : Tendsto f atTop (𝓝 L))
    (ht : 0 < t) : f t < L := by
  have ht1 : 0 < t+1 := by linarith
  have hle : f (t+1) ≤ L := by
    apply le_of_tendsto_of_tendsto tendsto_const_nhds hinf
    filter_upwards [eventually_ge_atTop (t+1)] with u hu
    exact hm.monotoneOn ht1 (show 0 < u by linarith) hu
  exact lt_of_lt_of_le (hm ht ht1 (by linarith)) hle

theorem crossing_order_iff {f : ℝ → ℝ} {s t : ℝ}
    (hm : StrictMonoOn f (Ioi 0)) (hs : 0 < s) (ht : 0 < t)
    (hfs : f s = 2) :
    (f t ≤ 2 ↔ t ≤ s) ∧ (2 ≤ f t ↔ s ≤ t) := by
  rw [← hfs]
  exact ⟨hm.le_iff_le ht hs,hm.le_iff_le hs ht⟩

end C2.NGamma.Global

end

/- ===== C2.NGammaEnvelope ===== -/

/-! Exact sign estimates for the envelope derivative. These are the analytic
core of the outer-monotonicity argument; this module does not assert regularity
of the constrained optimum or identify a derivative of a maximum function. -/

noncomputable section
open scoped BigOperators

namespace C2.NGamma.Global

def envelope {n : ℕ} (r x : Fin n → ℝ) (w lam : ℝ) : ℝ :=
  2*lam/(1+w^2) - ∑ j, negPhaseDerivative (r j) (x j) w *
    (1+lam*marginal (r j) (x j) w)

theorem sin_two_arctan (w : ℝ) :
    Real.sin (2*Real.arctan w) = 2*w/(1+w^2) := by
  rw [Real.sin_two_mul,Real.sin_arctan,Real.cos_arctan]
  have hs := Real.sq_sqrt (show 0 ≤ 1+w^2 by positivity)
  have hne : Real.sqrt (1+w^2) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr (by positivity))
  have hne' : 1+w^2 ≠ 0 := by positivity
  field_simp

theorem tan_phase {r x w : ℝ} (hr : 0 < r) (hx : 0 ≤ x) (hw : 0 < w) :
    Real.tan (phase r x w) = 2*w/phaseDenom r x w := by
  rw [phase_eq_arctan hr hx hw,Real.tan_arctan]

theorem envelope_neg_positive {n : ℕ} (hn : 0 < n) (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hx : ∀ j, 0 ≤ x j) {w lam : ℝ}
    (hw : 0 < w) (hlam : 0 < lam) (hbound : ∀ j, lam*w < x j)
    (hphase : (∑ j, phase (r j) (x j) w) = 2*Real.arctan w) :
    envelope r x w lam < 0 := by
  have hcomp :
      (∑ j, lam/w * Real.tan (phase (r j) (x j) w)) <
      ∑ j, negPhaseDerivative (r j) (x j) w * (1+lam*marginal (r j) (x j) w) := by
    apply Finset.sum_lt_sum
    · intro j _
      rw [tan_phase (hr j) (hx j) hw]
      exact (positive_multiplier_component (hr j) (hx j) hw hlam (hbound j)).le
    · refine ⟨⟨0,hn⟩,Finset.mem_univ _,?_⟩
      rw [tan_phase (hr _) (hx _) hw]
      exact positive_multiplier_component (hr _) (hx _) hw hlam (hbound _)
  have hsin := sin_sum_lt_sum_tan hn (fun j => phase (r j) (x j) w)
    (fun j => ⟨phase_pos (hr j) hw,phase_lt_pi_div_two (hx j) hw⟩)
  rw [hphase,sin_two_arctan] at hsin
  have hscaled := mul_lt_mul_of_pos_left hsin (div_pos hlam hw)
  rw [Finset.mul_sum] at hscaled
  have heq : lam/w * (2*w/(1+w^2)) = 2*lam/(1+w^2) := by
    field_simp
    <;> ring
  rw [heq] at hscaled
  unfold envelope
  linarith

theorem envelope_neg_nonpositive {n : ℕ} (hn : 0 < n) (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hx : ∀ j, 0 ≤ x j) {w lam : ℝ}
    (hw : 0 < w) (hlam : lam ≤ 0)
    (hprod : ∀ j, 0 ≤ lam*marginal (r j) (x j) w) :
    envelope r x w lam < 0 := by
  have hsum : 0 < ∑ j, negPhaseDerivative (r j) (x j) w *
      (1+lam*marginal (r j) (x j) w) := by
    apply Finset.sum_pos
    · intro j _
      exact mul_pos (negPhaseDerivative_pos (hr j) (hx j) hw) (by have := hprod j; linarith)
    · exact ⟨⟨0,hn⟩,Finset.mem_univ _⟩
  have hfirst : 2*lam/(1+w^2) ≤ 0 :=
    div_nonpos_of_nonpos_of_nonneg (by linarith) (by positivity)
  unfold envelope
  linarith

/-- The scalar stationarity/complementarity conditions, stated for the actual
phase-to-log-gain slope, rather than as assumptions about an optimum value. -/
def KKT {n : ℕ} (r x : Fin n → ℝ) (w lam : ℝ) : Prop :=
  ∀ j, (x j = 0 → lam ≤ marginal (r j) (x j) w) ∧
    (x j = 1 → marginal (r j) (x j) w ≤ lam) ∧
    (0 < x j → x j < 1 → marginal (r j) (x j) w = lam)

theorem marginal_zero {r w : ℝ} (hw : 0 < w) : marginal r 0 w = -r*w/2 := by
  unfold marginal
  field_simp
  <;> ring

theorem kkt_positive_no_zero {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hx : ∀ j, 0 ≤ x j) {w lam : ℝ}
    (hw : 0 < w) (hlam : 0 < lam) (hkkt : KKT r x w lam) :
    ∀ j, 0 < x j := by
  intro j
  by_contra h
  have hz : x j = 0 := le_antisymm (le_of_not_gt h) (hx j)
  have hbound := (hkkt j).1 hz
  rw [hz,marginal_zero hw] at hbound
  have hp := mul_pos (hr j) hw
  linarith

theorem kkt_nonpositive_products {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hx : ∀ j, x j ∈ Set.Icc (0:ℝ) 1) {w lam : ℝ}
    (hw : 0 < w) (hlam : lam ≤ 0) (hkkt : KKT r x w lam) :
    ∀ j, 0 ≤ lam*marginal (r j) (x j) w := by
  intro j
  by_cases hz : x j = 0
  · rw [hz,marginal_zero hw]
    exact mul_nonneg_of_nonpos_of_nonpos hlam (by have := mul_pos (hr j) hw; linarith)
  by_cases ho : x j = 1
  · have h := (hkkt j).2.1 ho
    exact mul_nonneg_of_nonpos_of_nonpos hlam (le_trans h hlam)
  · have h := (hkkt j).2.2 (lt_of_le_of_ne (hx j).1 (Ne.symm hz))
      (lt_of_le_of_ne (hx j).2 ho)
    rw [h]
    exact mul_self_nonneg lam

theorem kkt_positive_coordinate_bounds {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hx : ∀ j, x j ∈ Set.Icc (0:ℝ) 1) {w lam : ℝ}
    (hw : 0 < w) (hlam : 0 < lam) (hkkt : KKT r x w lam)
    (hnotone : ∃ j, x j < 1) :
    ∀ j, lam*w < x j := by
  have hxpos := kkt_positive_no_zero r x hr (fun j => (hx j).1) hw hlam hkkt
  obtain ⟨i,hi⟩ := hnotone
  have hmi := (hkkt i).2.2 (hxpos i) hi
  have hbi := marginal_below_x_div_w (hr i) (hx i).1 hw
  rw [hmi] at hbi
  have hli : lam*w < 1 := by
    have := (lt_div_iff₀ hw).mp hbi
    linarith
  intro j
  by_cases ho : x j = 1
  · simpa [ho] using hli
  · have hmj := (hkkt j).2.2 (hxpos j) (lt_of_le_of_ne (hx j).2 ho)
    have hbj := marginal_below_x_div_w (hr j) (hx j).1 hw
    rw [hmj] at hbj
    exact (lt_div_iff₀ hw).mp hbj

/-- Negativity of the actual envelope expression at any feasible KKT point
away from the all-one endpoint. This establishes both multiplier branches.
The separate regularity theorem needed to integrate this derivative is not
part of this statement. -/
theorem envelope_neg_of_KKT {n : ℕ} (hn : 0 < n) (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hx : ∀ j, x j ∈ Set.Icc (0:ℝ) 1) {w lam : ℝ}
    (hw : 0 < w) (hkkt : KKT r x w lam)
    (hphase : (∑ j, phase (r j) (x j) w) = 2*Real.arctan w)
    (hstrict : (∑ j, phase (r j) 1 w) < 2*Real.arctan w) :
    envelope r x w lam < 0 := by
  by_cases hlam : 0 < lam
  · have hnotone : ∃ j, x j < 1 := by
      by_contra h
      push_neg at h
      have heq : x = fun _ => 1 := funext (fun j => le_antisymm (hx j).2 (h j))
      rw [heq] at hphase
      linarith
    exact envelope_neg_positive hn r x hr (fun j => (hx j).1) hw hlam
      (kkt_positive_coordinate_bounds r x hr hx hw hlam hkkt hnotone) hphase
  · exact envelope_neg_nonpositive hn r x hr (fun j => (hx j).1) hw (le_of_not_gt hlam)
      (kkt_nonpositive_products r x hr hx hw (le_of_not_gt hlam) hkkt)

end C2.NGamma.Global

end

/- ===== C2.NGammaDual ===== -/

/-! Dual upper supports for the fixed-frequency optimum.  The clipped scalar
maximizer is allowed to change active sets. -/

noncomputable section
open scoped BigOperators Topology
open Filter Set

namespace C2.NGamma.Global

/-- Switching between branches with a common value and derivative preserves
the derivative. No regularity assumption on the switching set is needed. -/
theorem hasDerivAt_of_eventually_eq_or {f g h : ℝ → ℝ} {a d : ℝ}
    (hg : HasDerivAt g d a) (hh : HasDerivAt h d a)
    (hfg : f a = g a) (hfh : f a = h a)
    (hsel : ∀ᶠ z in 𝓝 a, f z = g z ∨ f z = h z) :
    HasDerivAt f d a := by
  apply hasDerivAt_iff_tendsto_slope.mpr
  intro s hs
  change ∀ᶠ z in 𝓝[≠] a, slope f a z ∈ s
  have hg' := (hasDerivAt_iff_tendsto_slope.mp hg) hs
  have hh' := (hasDerivAt_iff_tendsto_slope.mp hh) hs
  change ∀ᶠ z in 𝓝[≠] a, slope g a z ∈ s at hg'
  change ∀ᶠ z in 𝓝[≠] a, slope h a z ∈ s at hh'
  filter_upwards [hg', hh', hsel.filter_mono nhdsWithin_le_nhds] with z hgz hhz hz
  rcases hz with hz | hz
  · simpa only [slope_def_field, hfg, hz] using hgz
  · simpa only [slope_def_field, hfh, hz] using hhz

def dualValue {n : ℕ} (r : Fin n → ℝ) (w lam : ℝ) : ℝ :=
  2*lam*Real.arctan w + ∑ j,
    allocationLagrangian (r j) w lam (frequencyAllocation (r j) w lam)

theorem clipped_KKT {n : ℕ} (r : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    {w lam : ℝ} (hw : 0 < w) :
    KKT r (fun j => frequencyAllocation (r j) w lam) w lam := by
  intro j
  have hk := frequencyAllocation_kkt (hr j) hw (l := lam)
  refine ⟨?_, ?_, ?_⟩
  · intro hz
    exact hk.2 (by dsimp at hz; rw [hz]; norm_num)
  · intro ho
    exact hk.1 (by dsimp at ho; rw [ho]; norm_num)
  · intro hp hl
    exact le_antisymm (hk.1 hp) (hk.2 hl)

theorem dualValue_eq_gain {n : ℕ} (r : Fin n → ℝ) {w lam : ℝ}
    (heq : frequencyAllocatedPhase r w lam = 2*Real.arctan w) :
    dualValue r w lam = ∑ j, allocationLogGain (r j) (frequencyAllocation (r j) w lam) w := by
  unfold dualValue allocationLagrangian
  rw [Finset.sum_sub_distrib, ← Finset.mul_sum]
  change 2*lam*Real.arctan w +
    ((∑ j, allocationLogGain (r j) (frequencyAllocation (r j) w lam) w) -
      lam*frequencyAllocatedPhase r w lam) = _
  rw [heq]
  ring

theorem gain_le_dualValue {n : ℕ} (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    (hx : ∀ j, x j ∈ Icc (0:ℝ) 1) {w lam : ℝ} (hw : 0 < w)
    (hphase : (∑ j, allocationPhase (r j) (x j) w) = 2*Real.arctan w) :
    (∑ j, allocationLogGain (r j) (x j) w) ≤ dualValue r w lam := by
  have hs := Finset.sum_le_sum (s := Finset.univ) fun j _ =>
    frequencyAllocation_lagrangian_max (hr j) hw (l := lam) (hx j)
  simp only [allocationLagrangian, Finset.sum_sub_distrib, ← Finset.mul_sum] at hs
  unfold dualValue allocationLagrangian
  rw [Finset.sum_sub_distrib, ← Finset.mul_sum]
  rw [hphase] at hs
  linarith

theorem clipped_envelope_neg {n : ℕ} (hn : 0 < n) (r : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) {w lam : ℝ} (hw : 0 < w)
    (heq : frequencyAllocatedPhase r w lam = 2*Real.arctan w)
    (hstrict : (∑ j, allocationPhase (r j) 1 w) < 2*Real.arctan w) :
    envelope r (fun j => frequencyAllocation (r j) w lam) w lam < 0 := by
  exact envelope_neg_of_KKT hn r _ hr (fun j => frequencyAllocation_mem _ _ _)
    hw (clipped_KKT r hr hw) heq hstrict

/-- Continuous functions with differentiable upper supports of nonpositive
slope are antitone. This form avoids differentiating a selected optimizer. -/
theorem antitoneOn_of_upper_support {f : ℝ → ℝ} {a b : ℝ}
    (hf : ContinuousOn f (Icc a b))
    (hs : ∀ x ∈ Icc a b, ∃ g : ℝ → ℝ, ∃ d : ℝ,
      HasDerivAt g d x ∧ d ≤ 0 ∧ g x = f x ∧ ∀ z ∈ Icc a b, f z ≤ g z) :
    AntitoneOn f (Icc a b) := by
  intro x hx y hy hxy
  have hsub : Icc x y ⊆ Icc a b := fun z hz =>
    ⟨le_trans hx.1 hz.1,le_trans hz.2 hy.2⟩
  apply image_le_of_liminf_slope_right_le_deriv_boundary (hf.mono hsub)
    (B := fun _ => f x) (B' := fun _ => 0) (le_refl _) continuousOn_const
    (fun z _ => (hasDerivAt_const z (f x)).hasDerivWithinAt) ?_ ⟨hxy,le_refl _⟩
  intro z hz q hq
  obtain ⟨g,d,hd,hd0,hgf,hmajor⟩ := hs z (hsub (Ico_subset_Icc_self hz))
  have he : ∀ᶠ t in 𝓝[>] z, slope g z t < q :=
    ((hasDerivAt_iff_tendsto_slope.mp hd).mono_left (nhdsGT_le_nhdsNE z))
      (Iio_mem_nhds (lt_of_le_of_lt hd0 hq))
  have hi : ∀ᶠ t in 𝓝[>] z, t ∈ Icc x y := Icc_mem_nhdsGT_of_mem hz
  have hp : ∀ᶠ t in 𝓝[>] z, z < t := self_mem_nhdsWithin
  apply Filter.Eventually.frequently
  filter_upwards [he,hi,hp] with t het hit hpt
  have hle : slope f z t ≤ slope g z t := by
    rw [slope_def_field,slope_def_field,hgf]
    exact div_le_div_of_nonneg_right (sub_le_sub_right (hmajor t (hsub hit)) _) (sub_nonneg.mpr hpt.le)
  exact lt_of_le_of_lt hle het

/-- Strictly negative upper-support slopes imply strict outer monotonicity,
even when no derivative of the optimum itself has been selected. -/
theorem strictAntiOn_of_upper_support {f : ℝ → ℝ} {a b : ℝ}
    (hf : ContinuousOn f (Icc a b))
    (hs : ∀ x ∈ Icc a b, ∃ g : ℝ → ℝ, ∃ d : ℝ,
      HasDerivAt g d x ∧ d < 0 ∧ g x = f x ∧ ∀ z ∈ Icc a b, f z ≤ g z) :
    StrictAntiOn f (Icc a b) := by
  have hanti := antitoneOn_of_upper_support hf (fun x hx => by
    obtain ⟨g,d,hd,hneg,heq,hbound⟩ := hs x hx
    exact ⟨g,d,hd,hneg.le,heq,hbound⟩)
  intro x hx y hy hxy
  obtain ⟨g,d,hd,hneg,heq,hbound⟩ := hs x hx
  have he : ∀ᶠ t in 𝓝[>] x, slope g x t < 0 :=
    ((hasDerivAt_iff_tendsto_slope.mp hd).mono_left (nhdsGT_le_nhdsNE x))
      (Iio_mem_nhds hneg)
  obtain ⟨t,ht,hti⟩ : ∃ t, slope g x t < 0 ∧ t ∈ Ioc x y :=
    (he.and (Ioc_mem_nhdsGT hxy)).exists
  have htmem : t ∈ Icc a b := ⟨le_trans hx.1 hti.1.le,le_trans hti.2 hy.2⟩
  have hlt : f t < f x := by
    have hgt : g t < g x := by
      rw [slope_def_field] at ht
      have hn := (div_lt_iff₀ (sub_pos.mpr hti.1)).mp ht
      exact sub_neg.mp (by simpa using hn)
    exact lt_of_le_of_lt (hbound t htmem) (heq ▸ hgt)
  exact lt_of_le_of_lt (hanti htmem hy hti.2) hlt

end C2.NGamma.Global

end

/- ===== C2.NGammaDualDerivative ===== -/

/-! Differentiability of the dual at clipping transitions.  This proves a
derivative of the actual dual maximum without requiring a derivative of the
clipped coordinate, or of a frequency-dependent multiplier. -/

noncomputable section
open scoped BigOperators Topology
open Filter Set
namespace C2.NGamma.Global

theorem hasDerivAt_clipped_curve {L : ℝ → ℝ → ℝ} {u D : ℝ → ℝ} {w : ℝ}
    (hu : ContinuousAt u w)
    (hzero : HasDerivAt (fun v => L v 0) (D 0) w)
    (hone : HasDerivAt (fun v => L v 1) (D 1) w)
    (hfree : 0 ≤ u w → u w ≤ 1 → HasDerivAt (fun v => L v (u v)) (D (u w)) w) :
    HasDerivAt (fun v => L v (min 1 (max 0 (u v)))) (D (min 1 (max 0 (u w)))) w := by
  rcases lt_trichotomy (u w) 0 with hneg | hzero' | hpos
  · have he : ∀ᶠ v in 𝓝 w, u v < 0 := hu (Iio_mem_nhds hneg)
    simp only [max_eq_left hneg.le, min_eq_right (by norm_num : (0:ℝ) ≤ 1)]
    apply hzero.congr_of_eventuallyEq
    filter_upwards [he] with v hv
    simp [max_eq_left hv.le]
  · have he : ∀ᶠ v in 𝓝 w, u v < 1 := hu (Iio_mem_nhds (by linarith))
    have hf := hfree (by linarith) (by linarith)
    rw [hzero'] at hf
    simp only [hzero',max_self,min_eq_right (by norm_num : (0:ℝ) ≤ 1)]
    apply hasDerivAt_of_eventually_eq_or hzero hf
    · simp [hzero']
    · simp [hzero']
    · filter_upwards [he] with v hv
      by_cases hz : u v ≤ 0
      · exact Or.inl (by simp [max_eq_left hz])
      · exact Or.inr (by simp [max_eq_right (le_of_not_ge hz),min_eq_right hv.le])
  · rcases lt_trichotomy (u w) 1 with hlt | heq | hgt
    · have he0 : ∀ᶠ v in 𝓝 w, 0 < u v := hu (Ioi_mem_nhds hpos)
      have he1 : ∀ᶠ v in 𝓝 w, u v < 1 := hu (Iio_mem_nhds hlt)
      simp only [max_eq_right hpos.le,min_eq_right hlt.le]
      apply (hfree hpos.le hlt.le).congr_of_eventuallyEq
      filter_upwards [he0,he1] with v hv0 hv1
      simp only [max_eq_right hv0.le,min_eq_right hv1.le]
    · have he : ∀ᶠ v in 𝓝 w, 0 < u v := hu (Ioi_mem_nhds hpos)
      have hf := hfree hpos.le heq.le
      rw [heq] at hf
      simp only [heq,max_eq_right (by norm_num : (0:ℝ) ≤ 1),min_self]
      apply hasDerivAt_of_eventually_eq_or hone hf
      · simp [heq]
      · simp [heq]
      · filter_upwards [he] with v hv
        by_cases ho : 1 ≤ u v
        · exact Or.inl (by simp [max_eq_right hv.le,min_eq_left ho])
        · exact Or.inr (by simp [max_eq_right hv.le,min_eq_right (le_of_not_ge ho)])
    · have he : ∀ᶠ v in 𝓝 w, 1 < u v := hu (Ioi_mem_nhds hgt)
      simp only [max_eq_right hpos.le,min_eq_left hgt.le]
      apply hone.congr_of_eventuallyEq
      filter_upwards [he] with v hv
      simp [max_eq_right (by linarith : 0 ≤ u v),min_eq_left hv.le]

theorem frequencyFree_frequency_differentiable (r lam w : ℝ) :
    DifferentiableAt ℝ (fun v => frequencyFree r v lam) w := by
  unfold frequencyFree
  have h : DifferentiableAt ℝ (fun v : ℝ => 1+(1+lam^2)*r^2*v^2) w := by fun_prop
  exact (by fun_prop : DifferentiableAt ℝ (fun v : ℝ => lam*v) w).add
    (((h.sqrt (by positivity)).sub_const 1).div_const r)

theorem clipped_lagrangian_hasDerivAt {r w lam : ℝ} (hr : 0 < r) (hw : 0 < w) :
    HasDerivAt (fun v => allocationLagrangian r v lam (frequencyAllocation r v lam))
      (phaseDerivative r (frequencyAllocation r w lam) w *
        (1+lam*allocationMarginal r (frequencyAllocation r w lam) w)) w := by
  unfold frequencyAllocation
  apply hasDerivAt_clipped_curve (D := fun x => phaseDerivative r x w *
    (1+lam*allocationMarginal r x w))
  · exact (frequencyFree_frequency_differentiable r lam w).continuousAt
  · exact allocationLagrangian_frequency_hasDerivAt hr hw (by norm_num)
  · exact allocationLagrangian_frequency_hasDerivAt hr hw (by positivity)
  · intro h0 h1
    have hd := allocationLagrangian_curve_hasDerivAt hr hw
      (l := lam) (frequencyFree_frequency_differentiable r lam w).hasDerivAt
      (ne_of_gt (frequencyFree_den_pos hr hw))
    simpa only [frequencyFree_marginal hr hw,sub_self,zero_mul,add_zero] using hd

theorem dualValue_hasDerivAt {n : ℕ} (r : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    {w lam : ℝ} (hw : 0 < w) :
    HasDerivAt (fun v => dualValue r v lam)
      (envelope r (fun j => frequencyAllocation (r j) w lam) w lam) w := by
  have hd := ((Real.hasDerivAt_arctan w).const_mul (2*lam)).add
    (HasDerivAt.sum (u := Finset.univ) (fun j _ => clipped_lagrangian_hasDerivAt (lam := lam) (hr j) hw))
  unfold dualValue envelope
  convert hd using 1
  have hneg : ∀ j, phaseDerivative (r j) (frequencyAllocation (r j) w lam) w =
      -negPhaseDerivative (r j) (frequencyAllocation (r j) w lam) w := by
    intro j
    unfold phaseDerivative negPhaseDerivative
    ring
  simp_rw [hneg,neg_mul,Finset.sum_neg_distrib]
  simp only [marginal,allocationMarginal]
  ring

/-- Analytic upper-support step for an exactly represented optimum value.
Continuity is discharged separately by the compact dual-minimum theorem. -/
theorem frequency_value_strictAntiOn_of_continuous {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) {F : ℝ → ℝ} {a b : ℝ}
    (hpos : ∀ w ∈ Icc a b, 0 < w)
    (hstrict : ∀ w ∈ Icc a b, (∑ j, allocationPhase (r j) 1 w) < 2*Real.arctan w)
    (hF : ∀ w ∈ Icc a b, ∃ lam,
      frequencyAllocatedPhase r w lam = 2*Real.arctan w ∧
      F w = ∑ j, allocationLogGain (r j) (frequencyAllocation (r j) w lam) w)
    (hcont : ContinuousOn F (Icc a b)) : StrictAntiOn F (Icc a b) := by
  apply strictAntiOn_of_upper_support hcont
  intro w hw
  obtain ⟨lam,hlam,hgain⟩ := hF w hw
  refine ⟨fun v => dualValue r v lam,
    envelope r (fun j => frequencyAllocation (r j) w lam) w lam,
    dualValue_hasDerivAt r hr (hpos w hw),
    clipped_envelope_neg hn r hr (hpos w hw) hlam (hstrict w hw),?_,?_⟩
  · exact (dualValue_eq_gain r hlam).trans hgain.symm
  · intro v hv
    obtain ⟨mu,hmu,hgainv⟩ := hF v hv
    rw [hgainv]
    exact gain_le_dualValue r _ hr (fun j => frequencyAllocation_mem _ _ _)
      (hpos v hv) hmu

end C2.NGamma.Global

end

/- ===== C2.NGammaValueContinuity ===== -/

/-! Continuity of the actual constrained optimal value.  The proof minimizes
the continuous dual over an explicit compact interval of multipliers.
It does not assume a continuous or uniquely determined multiplier. -/
noncomputable section
open scoped BigOperators Topology
open Set Filter
namespace C2.NGamma.Global

variable {n : ℕ}

def multiplierLower (r : Fin n → ℝ) (w : ℝ) : ℝ :=
  -(∑ j, |allocationMarginal (r j) 0 w|)-1

def multiplierUpper (r : Fin n → ℝ) (w : ℝ) : ℝ :=
  (∑ j, |allocationMarginal (r j) 1 w|)+1

lemma multiplier_lower_bound (r : Fin n → ℝ) (w : ℝ) (i : Fin n) :
    multiplierLower r w ≤ allocationMarginal (r i) 0 w := by
  have hs := Finset.single_le_sum
    (fun j (_ : j ∈ Finset.univ) => abs_nonneg (allocationMarginal (r j) 0 w))
    (Finset.mem_univ i)
  have ha := neg_abs_le (allocationMarginal (r i) 0 w)
  unfold multiplierLower
  linarith

lemma multiplier_upper_bound (r : Fin n → ℝ) (w : ℝ) (i : Fin n) :
    allocationMarginal (r i) 1 w ≤ multiplierUpper r w := by
  have hs := Finset.single_le_sum
    (fun j (_ : j ∈ Finset.univ) => abs_nonneg (allocationMarginal (r j) 1 w))
    (Finset.mem_univ i)
  have ha := le_abs_self (allocationMarginal (r i) 1 w)
  unfold multiplierUpper
  linarith

lemma multiplier_bounds_lt (r : Fin n → ℝ) (w : ℝ) :
    multiplierLower r w < multiplierUpper r w := by
  have h0 : 0 ≤ ∑ i, |allocationMarginal (r i) 0 w| :=
    Finset.sum_nonneg (fun _ _ => abs_nonneg _)
  have h1 : 0 ≤ ∑ i, |allocationMarginal (r i) 1 w| :=
    Finset.sum_nonneg (fun _ _ => abs_nonneg _)
  unfold multiplierLower multiplierUpper
  linarith

lemma exists_bounded_frequency_multiplier (r : Fin n → ℝ) (hr : ∀ i, 0 < r i)
    {w a : ℝ} (hw : 0 < w)
    (hlo : (∑ i, allocationPhase (r i) 1 w) ≤ a)
    (hhi : a ≤ ∑ i, allocationPhase (r i) 0 w) :
    ∃ l ∈ Icc (multiplierLower r w) (multiplierUpper r w),
      frequencyAllocatedPhase r w l = a := by
  have hL : frequencyAllocatedPhase r w (multiplierLower r w) =
      ∑ i, allocationPhase (r i) 0 w := by
    apply Finset.sum_congr rfl
    intro i _
    rw [frequencyAllocation_zero_of (hr i) hw (multiplier_lower_bound r w i)]
  have hU : frequencyAllocatedPhase r w (multiplierUpper r w) =
      ∑ i, allocationPhase (r i) 1 w := by
    apply Finset.sum_congr rfl
    intro i _
    rw [frequencyAllocation_one_of (hr i) hw (multiplier_upper_bound r w i)]
  exact intermediate_value_Icc' (multiplier_bounds_lt r w).le
    (frequencyAllocatedPhase_continuous r w).continuousOn
    ⟨by simpa [hU] using hlo, by simpa [hL] using hhi⟩

abbrev PositiveFrequency := {w : ℝ // 0 < w}

lemma allocationMarginal_positiveFrequency_continuous {r x : ℝ}
    (hr : 0 < r) (hx : 0 ≤ x) :
    Continuous (fun w : PositiveFrequency => allocationMarginal r x w) := by
  unfold allocationMarginal
  apply Continuous.div
  · fun_prop
  · fun_prop
  · intro w
    have hw : 0 < (w : ℝ) := w.property
    positivity

lemma multiplierLower_continuous (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    Continuous (fun w : PositiveFrequency => multiplierLower r w) := by
  unfold multiplierLower
  apply Continuous.sub _ continuous_const
  apply Continuous.neg
  exact continuous_finset_sum _ fun j _ =>
    (allocationMarginal_positiveFrequency_continuous (hr j) (by norm_num : (0:ℝ) ≤ 0)).abs

lemma multiplierUpper_continuous (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    Continuous (fun w : PositiveFrequency => multiplierUpper r w) := by
  unfold multiplierUpper
  apply Continuous.add _ continuous_const
  exact continuous_finset_sum _ fun j _ =>
    (allocationMarginal_positiveFrequency_continuous (hr j) (by norm_num : (0:ℝ) ≤ 1)).abs

/-- A fixed compact parameter t traverses a sufficient multiplier interval. -/
def normalizedMultiplier (r : Fin n → ℝ) (w t : ℝ) : ℝ :=
  multiplierLower r w + (multiplierUpper r w - multiplierLower r w) * t

lemma normalizedMultiplier_surjective (r : Fin n → ℝ) (w : ℝ) {l : ℝ}
    (hl : l ∈ Icc (multiplierLower r w) (multiplierUpper r w)) :
    ∃ t ∈ Icc (0:ℝ) 1, normalizedMultiplier r w t = l := by
  let L := multiplierLower r w
  let U := multiplierUpper r w
  have hUL : 0 < U-L := sub_pos.mpr (multiplier_bounds_lt r w)
  refine ⟨(l-L)/(U-L), ⟨div_nonneg (sub_nonneg.mpr hl.1) hUL.le, ?_⟩, ?_⟩
  · exact (div_le_one hUL).2 (by dsimp [L,U]; linarith [hl.2])
  · change L+(U-L)*((l-L)/(U-L))=l
    field_simp
    <;> ring

lemma dualValue_joint_continuousAt (r : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    {p : ℝ × ℝ} (hw : 0 < p.1) :
    ContinuousAt (fun p : ℝ × ℝ => dualValue r p.1 p.2) p := by
  unfold dualValue
  apply ContinuousAt.add
  · exact (continuousAt_const.mul continuousAt_snd).mul
      (Real.continuous_arctan.continuousAt.comp continuousAt_fst)
  · exact tendsto_finset_sum _ fun j _ =>
      frequencyAllocation_lagrangian_joint_continuousAt (hr j) hw

lemma normalizedDual_continuous (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    Continuous (fun p : PositiveFrequency × ℝ =>
      dualValue r p.1 (normalizedMultiplier r p.1 p.2)) := by
  have hL := (multiplierLower_continuous r hr).comp
    (continuous_fst : Continuous (fun p : PositiveFrequency × ℝ => p.1))
  have hU := (multiplierUpper_continuous r hr).comp
    (continuous_fst : Continuous (fun p : PositiveFrequency × ℝ => p.1))
  have hN : Continuous (fun p : PositiveFrequency × ℝ =>
      normalizedMultiplier r p.1 p.2) := hL.add ((hU.sub hL).mul continuous_snd)
  rw [continuous_iff_continuousAt]
  intro p
  exact (dualValue_joint_continuousAt r hr p.1.property).comp
    ((continuous_subtype_val.comp continuous_fst).continuousAt.prodMk hN.continuousAt)

/-- Compact dual definition, globally continuous on positive frequencies. -/
def compactDualValue (r : Fin n → ℝ) (w : PositiveFrequency) : ℝ :=
  sInf ((fun t : ℝ => dualValue r w (normalizedMultiplier r w t)) '' Icc 0 1)

lemma compactDualValue_continuous (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    Continuous (compactDualValue r) := by
  exact isCompact_Icc.continuous_sInf (normalizedDual_continuous r hr)

/-- At every feasible frequency, the compact dual minimum equals the actual
optimal log gain of every phase-balancing clipped allocation. -/
lemma compactDualValue_eq_gain (r : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    (w : PositiveFrequency) {l : ℝ}
    (hphase : frequencyAllocatedPhase r w l = 2*Real.arctan w) :
    compactDualValue r w =
      ∑ j, allocationLogGain (r j) (frequencyAllocation (r j) w l) w := by
  let v := ∑ j, allocationLogGain (r j) (frequencyAllocation (r j) w l) w
  have hlower : ∀ q : ℝ, v ≤ dualValue r w q := by
    intro q
    exact gain_le_dualValue r _ hr (fun j => frequencyAllocation_mem _ _ _)
      w.property hphase
  have hb := allocation_phase_bounds r hr w.property
    (fun j => frequencyAllocation (r j) w l) (fun j => frequencyAllocation_mem _ _ _)
  change (∑ i, allocationPhase (r i) 1 w) ≤ frequencyAllocatedPhase r w l ∧
    frequencyAllocatedPhase r w l ≤ ∑ i, allocationPhase (r i) 0 w at hb
  rw [hphase] at hb
  obtain ⟨q,hq,hpq⟩ := exists_bounded_frequency_multiplier r hr w.property hb.1 hb.2
  have heq : dualValue r w q = v := by
    rw [dualValue_eq_gain r hpq]
    apply le_antisymm
    · exact frequencyAllocation_log_optimal r hr w.property _
        (fun j => frequencyAllocation_mem _ _ _) (hpq.trans hphase.symm)
    · exact frequencyAllocation_log_optimal r hr w.property _
        (fun j => frequencyAllocation_mem _ _ _) (hphase.trans hpq.symm)
  obtain ⟨t,ht,heqt⟩ := normalizedMultiplier_surjective r w hq
  have hmem : v ∈ (fun t : ℝ => dualValue r w (normalizedMultiplier r w t)) '' Icc 0 1 :=
    ⟨t,ht,by dsimp only; rw [heqt,heq]⟩
  have hlow : ∀ y ∈ (fun t : ℝ => dualValue r w (normalizedMultiplier r w t)) '' Icc 0 1,
      v ≤ y := by
    rintro y ⟨t,ht,rfl⟩
    exact hlower _
  exact le_antisymm (csInf_le ⟨v,hlow⟩ hmem) (le_csInf ⟨v,hmem⟩ hlow)

/-- Any function characterized by attained, phase-balanced optimal allocations
is continuous on every positive-frequency set.  No regularity of its chosen
multipliers is assumed. -/
theorem frequencyValue_continuousOn (r : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    (F : ℝ → ℝ) (s : Set ℝ) (hs : ∀ w ∈ s, 0 < w)
    (hF : ∀ w ∈ s, ∃ l : ℝ,
      frequencyAllocatedPhase r w l = 2*Real.arctan w ∧
      F w = ∑ j, allocationLogGain (r j) (frequencyAllocation (r j) w l) w) :
    ContinuousOn F s := by
  rw [continuousOn_iff_continuous_restrict]
  let g : s → PositiveFrequency := fun w => ⟨w,hs w w.property⟩
  have hg : Continuous g := continuous_subtype_val.subtype_mk _
  have heq : (fun w : s => F w) = fun w : s => compactDualValue r (g w) := by
    funext w
    obtain ⟨l,hl,hval⟩ := hF w w.property
    rw [hval]
    exact (compactDualValue_eq_gain r hr (g w) hl).symm
  change Continuous (fun w : s => F w)
  rw [heq]
  exact (compactDualValue_continuous r hr).comp hg

end C2.NGamma.Global

end

/- ===== C2.NGammaFrequency ===== -/

noncomputable section
open scoped BigOperators Topology
open Set Filter

namespace C2.NGamma.Global

def sumRatio {n : ℕ} (r x : Fin n → ℝ) (t : ℝ) : ℝ :=
  ∑ j, Phase.ratio (x j + 2/r j) (x j) t

def endpointSum {n : ℕ} (r : Fin n → ℝ) : ℝ :=
  ∑ j, 1/(r j+2)

def feasible {n : ℕ} (r : Fin n → ℝ) (w : ℝ) : Prop :=
  ∃ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) ∧
    ∑ j, phase (r j) (x j) w = 2*Real.arctan w

theorem ratio_continuousOn {a x : ℝ} : ContinuousOn (Phase.ratio a x) (Ioi 0) := by
  intro t ht
  have hn : Continuous (Phase.contribution a x) := by
    unfold Phase.contribution
    exact (Real.continuous_arctan.comp (continuous_const.mul continuous_id)).sub
      (Real.continuous_arctan.comp (continuous_const.mul continuous_id))
  have hd : ContinuousAt (fun u : ℝ => Real.arctan (1/u)) t :=
    Real.continuous_arctan.continuousAt.comp
      (continuousAt_const.div continuousAt_id (ne_of_gt ht))
  have hp := Phase.arctan_pos (one_div_pos.mpr ht)
  exact (hn.continuousAt.div hd hp.ne').continuousWithinAt

theorem sumRatio_continuousOn {n : ℕ} (r x : Fin n → ℝ) :
    ContinuousOn (sumRatio r x) (Ioi 0) := by
  exact continuousOn_finset_sum _ (fun j _ => ratio_continuousOn)

theorem sumRatio_strictMonoOn {n : ℕ} (hn : 0 < n) (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hx : ∀ j, x j ∈ Icc (0:ℝ) 1) :
    StrictMonoOn (sumRatio r x) (Ioi 0) := by
  intro s hs t ht hst
  apply Finset.sum_lt_sum
  · intro j _
    exact (Phase.ratio_strictMonoOn (hx j).1 (hx j).2
      (by have := div_pos (by norm_num : (0:ℝ)<2) (hr j); linarith) hs ht hst).le
  · refine ⟨⟨0,hn⟩,Finset.mem_univ _,?_⟩
    exact Phase.ratio_strictMonoOn (hx ⟨0,hn⟩).1 (hx ⟨0,hn⟩).2
      (by have := div_pos (by norm_num : (0:ℝ)<2) (hr ⟨0,hn⟩); linarith) hs ht hst

theorem sumRatio_tendsto_zero {n : ℕ} (r x : Fin n → ℝ) :
    Tendsto (sumRatio r x) (𝓝[>] 0) (𝓝 0) := by
  simpa [sumRatio] using tendsto_finset_sum Finset.univ
    (fun j _ => Phase.ratio_tendsto_zero (x j+2/r j) (x j))

theorem sumRatio_zero_atTop {n : ℕ} (hn : 0 < n) (r : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) :
    Tendsto (sumRatio r (fun _ => 0)) atTop atTop := by
  have h := Phase.ratio_tendsto_atTop_of_zero
    (a := 0+2/r ⟨0,hn⟩) (by have := hr ⟨0,hn⟩; positivity)
  refine tendsto_atTop_mono' atTop ?_ h
  filter_upwards [eventually_gt_atTop (0:ℝ)] with t ht
  unfold sumRatio
  apply Finset.single_le_sum (f := fun j : Fin n => Phase.ratio (0+2/r j) 0 t)
    (s := Finset.univ) (fun j _ => ?_) (Finset.mem_univ ⟨0,hn⟩)
  exact (div_pos (Phase.contribution_pos
    (by have := div_pos (by norm_num : (0:ℝ)<2) (hr j); linarith) ht)
    (Phase.arctan_pos (one_div_pos.mpr ht))).le

theorem sumRatio_one_atTop {n : ℕ} (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    Tendsto (sumRatio r (fun _ => 1)) atTop (𝓝 (2*endpointSum r)) := by
  have hi (j : Fin n) : 1/(1:ℝ)-1/(1+2/r j) = 2*(1/(r j+2)) := by
    have hj : r j ≠ 0 := (hr j).ne'
    have hj2 : r j + 2 ≠ 0 := by have := hr j; positivity
    field_simp
    <;> ring
  have h := tendsto_finset_sum Finset.univ (fun j _ =>
    Phase.ratio_tendsto_atTop_of_pos (a := 1+2/r j) (x := 1) (by norm_num)
      (by have := div_pos (by norm_num : (0:ℝ)<2) (hr j); linarith))
  simpa only [sumRatio,hi,endpointSum,Finset.mul_sum] using h

theorem sumRatio_eq_phase_sum {n : ℕ} (r x : Fin n → ℝ) (t : ℝ) :
    sumRatio r x t = (∑ j, phase (r j) (x j) (1/t)) / Real.arctan (1/t) := by
  unfold sumRatio Phase.ratio Phase.contribution phase
  rw [Finset.sum_div]
  simp only [div_eq_mul_inv,inv_inv,one_mul]

theorem feasible_iff_ratios {n : ℕ} (r : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    {w : ℝ} (hw : 0 < w) :
    feasible r w ↔ sumRatio r (fun _ => 1) (1/w) ≤ 2 ∧
      2 ≤ sumRatio r (fun _ => 0) (1/w) := by
  have hp := Phase.arctan_pos hw
  rw [sumRatio_eq_phase_sum,sumRatio_eq_phase_sum]
  simp only [one_div_one_div]
  rw [div_le_iff₀ hp,le_div_iff₀ hp]
  exact phase_feasible_iff r hr hw

theorem sumRatio_one_lt_zero {n : ℕ} (hn : 0 < n) (r : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) {t : ℝ} (ht : 0 < t) :
    sumRatio r (fun _ => 1) t < sumRatio r (fun _ => 0) t := by
  rw [sumRatio_eq_phase_sum,sumRatio_eq_phase_sum]
  apply (div_lt_div_iff_of_pos_right (Phase.arctan_pos (one_div_pos.mpr ht))).2
  apply Finset.sum_lt_sum
  · intro j _
    exact (phase_strictAntiOn (hr j) (one_div_pos.mpr ht)
      (by norm_num) (by norm_num) (by norm_num : (0:ℝ)<1)).le
  · exact ⟨⟨0,hn⟩,Finset.mem_univ _,phase_strictAntiOn (hr ⟨0,hn⟩)
      (one_div_pos.mpr ht) (by norm_num) (by norm_num) (by norm_num : (0:ℝ)<1)⟩

theorem all_zero_crossing {n : ℕ} (hn : 0 < n) (r : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) :
    ∃! t, 0 < t ∧ sumRatio r (fun _ => 0) t = 2 :=
  unique_positive_crossing_atTop (sumRatio_continuousOn _ _)
    (sumRatio_strictMonoOn hn r _ hr (by intro j; norm_num))
    (sumRatio_tendsto_zero _ _) (sumRatio_zero_atTop hn r hr)

theorem all_one_crossing {n : ℕ} (hn : 0 < n) (r : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hS : 1 < endpointSum r) :
    ∃! t, 0 < t ∧ sumRatio r (fun _ => 1) t = 2 :=
  unique_positive_crossing_finite (sumRatio_continuousOn _ _)
    (sumRatio_strictMonoOn hn r _ hr (by intro j; norm_num))
    (sumRatio_tendsto_zero _ _) (sumRatio_one_atTop r hr) (by linarith)

theorem all_one_below_two {n : ℕ} (hn : 0 < n) (r : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hS : endpointSum r ≤ 1) {t : ℝ} (ht : 0 < t) :
    sumRatio r (fun _ => 1) t < 2 := by
  have h := strictly_below_finite_limit
    (sumRatio_strictMonoOn hn r _ hr (by intro j; norm_num))
    (sumRatio_one_atTop r hr) ht
  linarith

/-- Full feasible-frequency interval, in the original reciprocal half-angle
variable w. The endpoints are unique through the all-zero/all-one crossing
theorems, and the feasible vectors at them are identified below. -/
theorem feasible_frequency_interval {n : ℕ} (hn : 0 < n) (r : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) :
    ∃ wp : ℝ, 0 < wp ∧ sumRatio r (fun _ => 0) (1/wp) = 2 ∧
      (endpointSum r ≤ 1 → ∀ w, 0 < w → (feasible r w ↔ w ≤ wp)) ∧
      (1 < endpointSum r → ∃ wm : ℝ, 0 < wm ∧ wm < wp ∧
        sumRatio r (fun _ => 1) (1/wm) = 2 ∧
        ∀ w, 0 < w → (feasible r w ↔ wm ≤ w ∧ w ≤ wp)) := by
  obtain ⟨tp,htp,_⟩ := all_zero_crossing hn r hr
  have hmp := sumRatio_strictMonoOn hn r (fun _ => 0) hr (by intro j; norm_num)
  refine ⟨1/tp,one_div_pos.mpr htp.1,by simpa using htp.2,?_,?_⟩
  · intro hS w hw
    rw [feasible_iff_ratios r hr hw]
    have hlo := (all_one_below_two hn r hr hS (one_div_pos.mpr hw)).le
    rw [and_iff_right hlo]
    rw [(crossing_order_iff hmp htp.1 (one_div_pos.mpr hw) htp.2).2]
    rw [le_div_iff₀ hw,le_div_iff₀ htp.1]
    constructor <;> intro h <;> nlinarith
  · intro hS
    obtain ⟨tm,htm,_⟩ := all_one_crossing hn r hr hS
    have hmm := sumRatio_strictMonoOn hn r (fun _ => 1) hr (by intro j; norm_num)
    have hpm : tp < tm := by
      apply (hmp.lt_iff_lt htp.1 htm.1).mp
      rw [htp.2,← htm.2]
      exact sumRatio_one_lt_zero hn r hr htm.1
    refine ⟨1/tm,one_div_pos.mpr htm.1,
      one_div_lt_one_div_of_lt htp.1 hpm,by simpa using htm.2,?_⟩
    intro w hw
    rw [feasible_iff_ratios r hr hw]
    rw [(crossing_order_iff hmm htm.1 (one_div_pos.mpr hw) htm.2).1,
      (crossing_order_iff hmp htp.1 (one_div_pos.mpr hw) htp.2).2]
    rw [div_le_iff₀ hw,div_le_iff₀ htm.1,le_div_iff₀ hw,le_div_iff₀ htp.1]
    constructor <;> rintro ⟨ha,hb⟩ <;> constructor <;> nlinarith

theorem ratio_eq_two_iff_phase_eq {n : ℕ} (r x : Fin n → ℝ)
    {w : ℝ} (hw : 0 < w) :
    sumRatio r x (1/w) = 2 ↔
      (∑ j, phase (r j) (x j) w) = 2*Real.arctan w := by
  rw [sumRatio_eq_phase_sum]
  simp only [one_div_one_div]
  exact div_eq_iff (Phase.arctan_pos hw).ne'

theorem upper_endpoint_equation {n : ℕ} (r : Fin n → ℝ)
    {w : ℝ} (hw : 0 < w) :
    sumRatio r (fun _ => 0) (1/w) = 2 ↔
      (∑ j, Real.arctan (2/(r j*w))) = 2*Real.arctan w := by
  simpa [phase,div_div] using ratio_eq_two_iff_phase_eq r (fun _ => 0) hw

theorem lower_endpoint_equation {n : ℕ} (r : Fin n → ℝ)
    {w : ℝ} (hw : 0 < w) :
    sumRatio r (fun _ => 1) (1/w) = 2 ↔
      (∑ j, (Real.arctan ((1+2/r j)/w) - Real.arctan (1/w))) =
        2*Real.arctan w := by
  exact ratio_eq_two_iff_phase_eq r (fun _ => 1) hw

theorem upper_frequency_existsUnique {n : ℕ} (hn : 0 < n) (r : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) :
    ∃! w, 0 < w ∧ (∑ j, Real.arctan (2/(r j*w))) = 2*Real.arctan w := by
  obtain ⟨t,ht,hunique⟩ := all_zero_crossing hn r hr
  refine ⟨1/t,⟨one_div_pos.mpr ht.1,?_⟩,?_⟩
  · apply (upper_endpoint_equation r (one_div_pos.mpr ht.1)).mp
    simpa using ht.2
  · intro w hw
    have hi := hunique (1/w) ⟨one_div_pos.mpr hw.1,(upper_endpoint_equation r hw.1).mpr hw.2⟩
    calc w = 1/(1/w) := by simp
      _ = 1/t := by rw [hi]

theorem lower_frequency_existsUnique {n : ℕ} (hn : 0 < n) (r : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hS : 1 < endpointSum r) :
    ∃! w, 0 < w ∧
      (∑ j, (Real.arctan ((1+2/r j)/w) - Real.arctan (1/w))) = 2*Real.arctan w := by
  obtain ⟨t,ht,hunique⟩ := all_one_crossing hn r hr hS
  refine ⟨1/t,⟨one_div_pos.mpr ht.1,?_⟩,?_⟩
  · apply (lower_endpoint_equation r (one_div_pos.mpr ht.1)).mp
    simpa using ht.2
  · intro w hw
    have hi := hunique (1/w) ⟨one_div_pos.mpr hw.1,(lower_endpoint_equation r hw.1).mpr hw.2⟩
    calc w = 1/(1/w) := by simp
      _ = 1/t := by rw [hi]

theorem upper_frequency_vector_unique {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) {w : ℝ} (hw : 0 < w)
    (hwp : (∑ j, Real.arctan (2/(r j*w))) = 2*Real.arctan w)
    (hx : ∀ j, x j ∈ Icc (0:ℝ) 1)
    (hphase : (∑ j, phase (r j) (x j) w) = 2*Real.arctan w) :
    ∀ j, x j = 0 := by
  have hz := (ratio_eq_two_iff_phase_eq r (fun _ => 0) hw).mp
    ((upper_endpoint_equation r hw).mpr hwp)
  exact phase_upper_endpoint_unique r x hr hw hx (hphase.trans hz.symm)

theorem lower_frequency_vector_unique {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) {w : ℝ} (hw : 0 < w)
    (hwm : (∑ j, (Real.arctan ((1+2/r j)/w) - Real.arctan (1/w))) =
      2*Real.arctan w)
    (hx : ∀ j, x j ∈ Icc (0:ℝ) 1)
    (hphase : (∑ j, phase (r j) (x j) w) = 2*Real.arctan w) :
    ∀ j, x j = 1 := by
  exact phase_lower_endpoint_unique r x hr hw hx (hphase.trans hwm.symm)

end C2.NGamma.Global

end

/- ===== C2.NGammaOuter ===== -/

/-! Strict decrease of the actual constrained optimal log gain. The proof
uses a continuous compact dual minimum and differentiable upper supports.
It includes clipping changes and both positive feasible endpoints. -/

noncomputable section
open scoped BigOperators Topology
open Set Filter
namespace C2.NGamma.Global

def frequencyValue {n : ℕ} (r : Fin n → ℝ) (w : ℝ) : ℝ :=
  if h : 0 < w then compactDualValue r ⟨w,h⟩ else 0

theorem frequencyValue_eq_gain {n : ℕ} (r : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    {w lam : ℝ} (hw : 0 < w)
    (hphase : frequencyAllocatedPhase r w lam = 2*Real.arctan w) :
    frequencyValue r w = ∑ j, allocationLogGain (r j) (frequencyAllocation (r j) w lam) w := by
  simp only [frequencyValue,dif_pos hw]
  exact compactDualValue_eq_gain r hr ⟨w,hw⟩ hphase

theorem exp_frequencyValue_eq_product {n : ℕ} (r : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    {w lam : ℝ} (hw : 0 < w)
    (hphase : frequencyAllocatedPhase r w lam = 2*Real.arctan w) :
    Real.exp (frequencyValue r w) =
      ∏ j, allocationGain (r j) (frequencyAllocation (r j) w lam) w := by
  have hlog : Real.log (∏ j, allocationGain (r j) (frequencyAllocation (r j) w lam) w) =
      frequencyValue r w := by
    rw [Real.log_prod _ _ (fun j _ => ne_of_gt (allocationGain_pos (hr j) hw _))]
    simp_rw [log_allocationGain (hr _) hw]
    exact (frequencyValue_eq_gain r hr hw hphase).symm
  rw [← hlog,Real.exp_log (Finset.prod_pos (fun j _ => allocationGain_pos (hr j) hw _))]

theorem exists_balancing_multiplier {n : ℕ} (r : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    {w : ℝ} (hw : 0 < w) (hf : feasible r w) :
    ∃ lam, frequencyAllocatedPhase r w lam = 2*Real.arctan w := by
  obtain ⟨x,hx,hphase⟩ := hf
  have hb := allocation_phase_bounds r hr hw x hx
  exact exists_frequency_multiplier r hr hw (hphase ▸ hb.1) (hphase ▸ hb.2)

theorem frequencyValue_is_unique_maximum {n : ℕ} (r : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) {w : ℝ} (hw : 0 < w) (hf : feasible r w) :
    ∃ xstar : Fin n → ℝ, (∀ j, xstar j ∈ Icc (0:ℝ) 1) ∧
      (∑ j, allocationPhase (r j) (xstar j) w) = 2*Real.arctan w ∧
      frequencyValue r w = (∑ j, allocationLogGain (r j) (xstar j) w) ∧
      ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) →
        (∑ j, allocationPhase (r j) (x j) w) = 2*Real.arctan w →
        (∑ j, allocationLogGain (r j) (x j) w) ≤ frequencyValue r w ∧
        ((∑ j, allocationLogGain (r j) (x j) w) = frequencyValue r w ↔ x = xstar) := by
  obtain ⟨lam,hlam⟩ := exists_balancing_multiplier r hr hw hf
  refine ⟨fun j => frequencyAllocation (r j) w lam,
    fun j => frequencyAllocation_mem _ _ _,hlam,frequencyValue_eq_gain r hr hw hlam,?_⟩
  intro x hx hphase
  have heq : (∑ j, allocationPhase (r j) (x j) w) = frequencyAllocatedPhase r w lam :=
    hphase.trans hlam.symm
  rw [frequencyValue_eq_gain r hr hw hlam]
  refine ⟨frequencyAllocation_log_optimal r hr hw x hx heq,?_⟩
  constructor
  · intro hg
    by_contra hne
    exact (ne_of_lt (frequencyAllocation_log_optimal_strict r hr hw x hx heq hne)) hg
  · intro h
    rw [h]

/-- At an all-one endpoint a maximal marginal gives a multiplier strictly
below 1/w; hence the upper-support slope is still strictly negative. -/
theorem exists_negative_envelope_multiplier {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) {w : ℝ}
    (hw : 0 < w) (hf : feasible r w) :
    ∃ lam, frequencyAllocatedPhase r w lam = 2*Real.arctan w ∧
      envelope r (fun j => frequencyAllocation (r j) w lam) w lam < 0 := by
  obtain ⟨lam,hlam⟩ := exists_balancing_multiplier r hr hw hf
  have hb := allocation_phase_bounds r hr hw (fun j => frequencyAllocation (r j) w lam)
    (fun j => frequencyAllocation_mem _ _ _)
  have hlo : (∑ j, allocationPhase (r j) 1 w) ≤ 2*Real.arctan w := hlam ▸ hb.1
  rcases hlo.lt_or_eq with hstrict | hone
  · exact ⟨lam,hlam,clipped_envelope_neg hn r hr hw hlam hstrict⟩
  obtain ⟨i,hi,hmax⟩ := Finset.exists_max_image Finset.univ
    (fun j : Fin n => allocationMarginal (r j) 1 w) ⟨⟨0,hn⟩,Finset.mem_univ _⟩
  let mu := allocationMarginal (r i) 1 w
  have hone' : ∀ j, frequencyAllocation (r j) w mu = 1 := fun j =>
    frequencyAllocation_one_of (hr j) hw (hmax j (Finset.mem_univ j))
  have hfun : (fun j => frequencyAllocation (r j) w mu) = fun _ => 1 := funext hone'
  have hbalance : frequencyAllocatedPhase r w mu = 2*Real.arctan w := by
    unfold frequencyAllocatedPhase
    simp_rw [hone']
    exact hone
  refine ⟨mu,hbalance,?_⟩
  by_cases hmu : 0 < mu
  · have hm : mu*w < 1 := (lt_div_iff₀ hw).mp (marginal_below_x_div_w (hr i) (by norm_num) hw)
    rw [hfun]
    exact envelope_neg_positive hn r (fun _ => 1) hr (fun _ => by norm_num)
      hw hmu (fun _ => hm) hone
  · exact envelope_neg_nonpositive hn r _ hr
      (fun j => (frequencyAllocation_mem (r j) w mu).1) hw (le_of_not_gt hmu)
      (kkt_nonpositive_products r _ hr (fun j => frequencyAllocation_mem _ _ _) hw
        (le_of_not_gt hmu) (clipped_KKT r hr hw))

theorem frequencyValue_strictAntiOn_interval {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) {a b : ℝ}
    (hpos : ∀ w ∈ Icc a b, 0 < w)
    (hfeasible : ∀ w ∈ Icc a b, feasible r w) :
    StrictAntiOn (frequencyValue r) (Icc a b) := by
  have hF : ∀ w ∈ Icc a b, ∃ lam,
      frequencyAllocatedPhase r w lam = 2*Real.arctan w ∧
      frequencyValue r w = ∑ j, allocationLogGain (r j) (frequencyAllocation (r j) w lam) w := by
    intro w hw
    obtain ⟨lam,hlam⟩ := exists_balancing_multiplier r hr (hpos w hw) (hfeasible w hw)
    exact ⟨lam,hlam,frequencyValue_eq_gain r hr (hpos w hw) hlam⟩
  have hcont := frequencyValue_continuousOn r hr (frequencyValue r) (Icc a b) hpos hF
  apply strictAntiOn_of_upper_support hcont
  intro w hw
  obtain ⟨lam,hlam,hneg⟩ := exists_negative_envelope_multiplier hn r hr (hpos w hw) (hfeasible w hw)
  refine ⟨fun v => dualValue r v lam,
    envelope r (fun j => frequencyAllocation (r j) w lam) w lam,
    dualValue_hasDerivAt r hr (hpos w hw),hneg,?_,?_⟩
  · exact (dualValue_eq_gain r hlam).trans (frequencyValue_eq_gain r hr (hpos w hw) hlam).symm
  · intro v hv
    obtain ⟨mu,hmu,hgain⟩ := hF v hv
    rw [hgain]
    exact gain_le_dualValue r _ hr (fun j => frequencyAllocation_mem _ _ _) (hpos v hv) hmu

theorem feasible_between {n : ℕ} (hn : 0 < n) (r : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    {a b w : ℝ} (ha : 0 < a) (hb : 0 < b) (hfa : feasible r a) (hfb : feasible r b)
    (haw : a ≤ w) (hwb : w ≤ b) : feasible r w := by
  have hw : 0 < w := lt_of_lt_of_le ha haw
  obtain ⟨wp,hwp,hcross,hsmall,hlarge⟩ := feasible_frequency_interval hn r hr
  by_cases hS : endpointSum r ≤ 1
  · exact (hsmall hS w hw).2 (le_trans hwb ((hsmall hS b hb).1 hfb))
  · obtain ⟨wm,hwm,hmwp,hmc,hinterval⟩ := hlarge (lt_of_not_ge hS)
    exact (hinterval w hw).2
      ⟨le_trans ((hinterval a ha).1 hfa).1 haw,le_trans hwb ((hinterval b hb).1 hfb).2⟩

/-- Full outer-monotonicity conclusion for the exact allocation optimum on
the entire positive feasible-frequency interval. -/
theorem frequencyValue_strictAntiOn_feasible {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    StrictAntiOn (frequencyValue r) {w : ℝ | 0 < w ∧ feasible r w} := by
  intro a ha b hb hab
  have hm := frequencyValue_strictAntiOn_interval hn r hr
    (a := a) (b := b) (fun w hw => lt_of_lt_of_le ha.1 hw.1)
    (fun w hw => feasible_between hn r hr ha.1 hb.1 ha.2 hb.2 hw.1 hw.2)
  exact hm ⟨le_refl _,hab.le⟩ ⟨hab.le,le_refl _⟩ hab

theorem frequencyValue_continuousOn_feasible {n : ℕ}
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    ContinuousOn (frequencyValue r) {w : ℝ | 0 < w ∧ feasible r w} := by
  apply frequencyValue_continuousOn r hr _ _ (fun w hw => hw.1)
  intro w hw
  obtain ⟨lam,hlam⟩ := exists_balancing_multiplier r hr hw.1 hw.2
  exact ⟨lam,hlam,frequencyValue_eq_gain r hr hw.1 hlam⟩

/-- Full frequency-domain optimization in the branch with a positive lower
endpoint: the only maximizing pair is that endpoint and the all-one vector.
The separate Schur gain-interval theorem translates this into a stability margin. -/
theorem positive_endpoint_unique_global_maximum {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) (hS : 1 < endpointSum r) :
    ∃ wm : ℝ, 0 < wm ∧
      (∑ j, allocationPhase (r j) 1 wm) = 2*Real.arctan wm ∧
      ∀ w : ℝ, 0 < w → ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) →
        (∑ j, allocationPhase (r j) (x j) w) = 2*Real.arctan w →
        (∑ j, allocationLogGain (r j) (x j) w) ≤ (∑ j, allocationLogGain (r j) 1 wm) ∧
        ((∑ j, allocationLogGain (r j) (x j) w) = (∑ j, allocationLogGain (r j) 1 wm) ↔
          w = wm ∧ x = fun _ => 1) := by
  obtain ⟨wp,hwp,hpc,hsmall,hlarge⟩ := feasible_frequency_interval hn r hr
  obtain ⟨wm,hwm,hmwp,hmc,hinterval⟩ := hlarge hS
  have hone : (∑ j, allocationPhase (r j) 1 wm) = 2*Real.arctan wm :=
    (ratio_eq_two_iff_phase_eq r (fun _ => 1) hwm).mp hmc
  have hfm : feasible r wm := ⟨fun _ => 1,fun _ => by norm_num,hone⟩
  obtain ⟨xm,hxm,hpm,hvm,hmaxm⟩ := frequencyValue_is_unique_maximum r hr hwm hfm
  have hxmone : xm = fun _ => 1 := funext (lower_frequency_vector_unique r xm hr hwm hone hxm hpm)
  have hvmone : frequencyValue r wm = ∑ j, allocationLogGain (r j) 1 wm := by
    simpa only [hxmone] using hvm
  refine ⟨wm,hwm,hone,?_⟩
  intro w hw x hx hp
  have hfw : feasible r w := ⟨x,hx,hp⟩
  have hmlew := ((hinterval w hw).mp hfw).1
  obtain ⟨xs,hxs,hps,hvs,hmax⟩ := frequencyValue_is_unique_maximum r hr hw hfw
  have hgainle := (hmax x hx hp).1
  have hvalle : frequencyValue r w ≤ frequencyValue r wm :=
    (frequencyValue_strictAntiOn_feasible hn r hr).antitoneOn ⟨hwm,hfm⟩ ⟨hw,hfw⟩ hmlew
  refine ⟨hvmone ▸ le_trans hgainle hvalle,?_⟩
  constructor
  · intro heq
    have hwmeq : w = wm := by
      by_contra hne
      have hlt := frequencyValue_strictAntiOn_feasible hn r hr ⟨hwm,hfm⟩ ⟨hw,hfw⟩
        (lt_of_le_of_ne hmlew (Ne.symm hne))
      rw [hvmone] at hlt
      linarith
    refine ⟨hwmeq,?_⟩
    subst w
    exact funext (lower_frequency_vector_unique r x hr hw hone hx hp)
  · rintro ⟨rfl,rfl⟩
    rfl

end C2.NGamma.Global

end

/- ===== C2.NGammaEndpointSequence ===== -/

/-! Genuine optimizing feasible allocations along frequencies tending to zero.
This supplies the sequence used by the endpoint compactness argument. -/
noncomputable section
open scoped BigOperators Topology
open Set Filter
namespace C2.NGamma.Global

theorem exists_optimizing_endpoint_sequence {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) (hS : endpointSum r ≤ 1) :
    ∃ ws : ℕ → ℝ, ∃ xs : ℕ → Fin n → ℝ,
      Tendsto ws atTop (𝓝 0) ∧
      (∀ k, 0 < ws k ∧ (∀ j, xs k j ∈ Icc (0:ℝ) 1) ∧
        (∑ j, allocationPhase (r j) (xs k j) (ws k)) = 2*Real.arctan (ws k) ∧
        Real.exp (frequencyValue r (ws k)) = ∏ j, allocationGain (r j) (xs k j) (ws k)) ∧
      ∀ w, 0 < w → feasible r w →
        ∀ᶠ k in atTop, Real.exp (frequencyValue r w) < ∏ j, allocationGain (r j) (xs k j) (ws k) := by
  obtain ⟨wp,hwp,hcross,hsmall,hlarge⟩ := feasible_frequency_interval hn r hr
  let ws : ℕ → ℝ := fun k => wp / ((k:ℝ)+1)
  have hwpos : ∀ k, 0 < ws k := fun k => div_pos hwp (by positivity)
  have hwle : ∀ k, ws k ≤ wp := by
    intro k
    dsimp [ws]
    apply (div_le_iff₀ (by positivity : 0 < (k:ℝ)+1)).2
    have hk : (0:ℝ) ≤ (k:ℝ) := Nat.cast_nonneg k
    nlinarith
  have hf : ∀ k, feasible r (ws k) := fun k => (hsmall hS (ws k) (hwpos k)).2 (hwle k)
  have hex : ∀ k, ∃ lam, frequencyAllocatedPhase r (ws k) lam = 2*Real.arctan (ws k) :=
    fun k => exists_balancing_multiplier r hr (hwpos k) (hf k)
  choose lam hlam using hex
  let xs : ℕ → Fin n → ℝ := fun k j => frequencyAllocation (r j) (ws k) (lam k)
  have hlim : Tendsto ws atTop (𝓝 0) := by
    have ht := (tendsto_one_div_add_atTop_nhds_zero_nat).const_mul wp
    simpa only [mul_zero,mul_one_div] using ht
  refine ⟨ws,xs,hlim,?_,?_⟩
  · intro k
    exact ⟨hwpos k,fun j => frequencyAllocation_mem _ _ _,hlam k,
      exp_frequencyValue_eq_product r hr (hwpos k) (hlam k)⟩
  · intro w hw hfw
    have he : ∀ᶠ k in atTop, ws k < w := hlim (Iio_mem_nhds hw)
    filter_upwards [he] with k hk
    rw [← exp_frequencyValue_eq_product r hr (hwpos k) (hlam k)]
    exact Real.exp_lt_exp.mpr
      (frequencyValue_strictAntiOn_feasible hn r hr ⟨hwpos k,hf k⟩ ⟨hw,hfw⟩ hk)

end C2.NGamma.Global

end

/- ===== C2.NGammaEndpoint ===== -/

/-!
# Constructive endpoint allocation for independent cascade parameters

This module treats the actual rational endpoint cost and the clipped scalar
allocation.  All hypotheses are explicit; the root-count and complex-root
placement statements belong to the separate phase analysis.
-/

noncomputable section
open scoped BigOperators
namespace C2.NGamma

/-- Endpoint phase resource in the original positive parameter. -/
def endpointCost (r x : ℝ) : ℝ := 1 / (x * (2 + r*x))

/-- Convex endpoint resource, before division by four. -/
def resource (r t : ℝ) : ℝ := t + r^2/t - 2*r

/-- Unconstrained stationary allocation with common multiplier reciprocal. -/
def freeAllocation (r c : ℝ) : ℝ := (c + Real.sqrt (c^2+4*r^2))/2

/-- Allocation including the active backward-Euler lower bound. -/
def endpointAllocation (r c : ℝ) : ℝ := max (r+2) (freeAllocation r c)

theorem endpointCost_pos {r x : ℝ} (hr : 0 < r) (hx : 0 < x) :
    0 < endpointCost r x := by
  unfold endpointCost
  positivity

theorem endpointCost_one (r : ℝ) : endpointCost r 1 = 1/(r+2) := by
  unfold endpointCost
  ring

theorem endpointCost_antitone {r x y : ℝ} (hr : 0 < r)
    (hx : 0 < x) (hxy : x ≤ y) : endpointCost r y ≤ endpointCost r x := by
  have hy : 0 < y := lt_of_lt_of_le hx hxy
  unfold endpointCost
  apply one_div_le_one_div_of_le
  · positivity
  · nlinarith [mul_self_le_mul_self (le_of_lt hx) hxy]

theorem endpointCost_strict_antitone {r x y : ℝ} (hr : 0 < r)
    (hx : 0 < x) (hxy : x < y) : endpointCost r y < endpointCost r x := by
  have hy : 0 < y := lt_trans hx hxy
  unfold endpointCost
  apply one_div_lt_one_div_of_lt
  · positivity
  · nlinarith [sq_lt_sq₀ (le_of_lt hx) (le_of_lt hy) |>.2 hxy]

theorem resource_identity {r t : ℝ} (ht : t ≠ 0) :
    resource r t = (t-r)^2/t := by
  unfold resource
  field_simp
  <;> ring

theorem resource_nonneg {r t : ℝ} (ht : 0 < t) : 0 ≤ resource r t := by
  rw [resource_identity (ne_of_gt ht)]
  positivity

theorem endpoint_change_variables {r x : ℝ} (hr : 0 < r) (hx : 0 < x) :
    resource r (r+2/x) = 4*endpointCost r x := by
  unfold resource endpointCost
  have h : r+2/x ≠ 0 := ne_of_gt (by positivity : 0 < r+2/x)
  field_simp
  <;> ring

theorem resource_lower_bound (r : ℝ) (hr : r+2 ≠ 0) :
    resource r (r+2) = 4/(r+2) := by
  unfold resource
  field_simp
  <;> ring

theorem resource_strict_mono {r s t : ℝ} (hr : 0 < r)
    (hs : r < s) (hst : s < t) : resource r s < resource r t := by
  have hs0 : 0 < s := lt_trans hr hs
  have ht0 : 0 < t := lt_trans hs0 hst
  have hstpos : 0 < s*t-r^2 := by nlinarith
  have hid : resource r t - resource r s = (t-s)*(s*t-r^2)/(s*t) := by
    unfold resource
    field_simp
    <;> ring
  have : 0 < resource r t - resource r s := by
    rw [hid]
    exact div_pos (mul_pos (sub_pos.mpr hst) hstpos) (mul_pos hs0 ht0)
  linarith

theorem resource_mono {r s t : ℝ} (hr : 0 < r)
    (hs : r < s) (hst : s ≤ t) : resource r s ≤ resource r t := by
  rcases hst.eq_or_lt with h | h
  · subst t; rfl
  · exact le_of_lt (resource_strict_mono hr hs h)

variable {ι : Type*} [Fintype ι]

/-- Feasibility of the endpoint regime, for every finite positive cascade. -/
theorem endpoint_feasible_iff (r : ι → ℝ) (hr : ∀ i, 0 < r i) :
    (∃ x : ι → ℝ, (∀ i, 0 < x i ∧ x i ≤ 1) ∧
      (∑ i, endpointCost (r i) (x i)) ≤ 1) ↔
      (∑ i, 1/(r i+2)) ≤ 1 := by
  constructor
  · rintro ⟨x,hx,hs⟩
    calc
      (∑ i, 1/(r i+2)) = ∑ i, endpointCost (r i) 1 := by simp [endpointCost_one]
      _ ≤ ∑ i, endpointCost (r i) (x i) := by
        exact Finset.sum_le_sum fun i _ => endpointCost_antitone (hr i) (hx i).1 (hx i).2
      _ ≤ 1 := hs
  · intro hs
    exact ⟨fun _ => 1, by simp, by simpa [endpointCost_one] using hs⟩

/-- At equality in the feasibility bound the all-one vector is the only design. -/
theorem endpoint_feasible_equality_unique (r x : ι → ℝ) (hr : ∀ i, 0 < r i)
    (hx : ∀ i, 0 < x i ∧ x i ≤ 1)
    (hbase : (∑ i, 1/(r i+2)) = 1)
    (hres : (∑ i, endpointCost (r i) (x i)) ≤ 1) : x = fun _ => 1 := by
  classical
  funext i
  by_contra hne
  have hxi : x i < 1 := lt_of_le_of_ne (hx i).2 hne
  have hlt : (∑ j, endpointCost (r j) 1) < ∑ j, endpointCost (r j) (x j) := by
    apply Finset.sum_lt_sum
    · intro j _
      exact endpointCost_antitone (hr j) (hx j).1 (hx j).2
    · exact ⟨i, Finset.mem_univ i, endpointCost_strict_antitone (hr i) (hx i).1 hxi⟩
  have hbase' : (∑ j, endpointCost (r j) 1) = 1 := by simpa [endpointCost_one] using hbase
  linarith


/-- The positive quadratic branch is positive even when the multiplier is zero. -/
theorem freeAllocation_pos {r c : ℝ} (hr : 0 < r) (hc : 0 ≤ c) :
    0 < freeAllocation r c := by
  unfold freeAllocation
  have hs : 0 < Real.sqrt (c^2+4*r^2) := Real.sqrt_pos.2 (by positivity)
  positivity

theorem freeAllocation_quadratic (r c : ℝ) :
    (freeAllocation r c)^2 - c*freeAllocation r c - r^2 = 0 := by
  have hs := Real.sq_sqrt (show 0 ≤ c^2+4*r^2 by positivity)
  unfold freeAllocation
  nlinarith

theorem freeAllocation_stationarity {r c : ℝ} (hr : 0 < r) (hc : 0 ≤ c) :
    freeAllocation r c - r^2 / freeAllocation r c = c := by
  have hp := freeAllocation_pos hr hc
  have hq := freeAllocation_quadratic r c
  field_simp [ne_of_gt hp]
  nlinarith

theorem freeAllocation_zero {r : ℝ} (hr : 0 ≤ r) : freeAllocation r 0 = r := by
  unfold freeAllocation
  have : Real.sqrt (4*r^2) = 2*r := by
    have hh := Real.sq_sqrt (show 0 ≤ 4*r^2 by positivity)
    have hn := Real.sqrt_nonneg (4*r^2)
    nlinarith
  simpa using congrArg (fun z : ℝ => z/2) this

theorem endpointAllocation_zero {r : ℝ} (hr : 0 ≤ r) :
    endpointAllocation r 0 = r+2 := by
  unfold endpointAllocation
  rw [freeAllocation_zero hr, max_eq_left (by linarith)]

theorem freeAllocation_strict_mono {r c d : ℝ} (hc : 0 ≤ c) (hcd : c < d) :
    freeAllocation r c < freeAllocation r d := by
  have hsq : c^2+4*r^2 ≤ d^2+4*r^2 := by nlinarith
  have hs := Real.sqrt_le_sqrt hsq
  unfold freeAllocation
  linarith

theorem freeAllocation_mono {r c d : ℝ} (hc : 0 ≤ c) (hcd : c ≤ d) :
    freeAllocation r c ≤ freeAllocation r d := by
  rcases hcd.eq_or_lt with h | h
  · subst d; rfl
  · exact le_of_lt (freeAllocation_strict_mono hc h)

theorem endpointAllocation_mono {r c d : ℝ} (hc : 0 ≤ c) (hcd : c ≤ d) :
    endpointAllocation r c ≤ endpointAllocation r d := by
  exact max_le_max_left _ (freeAllocation_mono hc hcd)

theorem endpointAllocation_ge_lower (r c : ℝ) : r+2 ≤ endpointAllocation r c :=
  le_max_left _ _

theorem endpointAllocation_gt_r (r c : ℝ) : r < endpointAllocation r c := by
  have := endpointAllocation_ge_lower r c
  linarith

theorem endpointAllocation_pos {r : ℝ} (hr : 0 < r) (c : ℝ) :
    0 < endpointAllocation r c := lt_trans hr (endpointAllocation_gt_r r c)

theorem endpointAllocation_continuous (r : ℝ) : Continuous (endpointAllocation r) := by
  unfold endpointAllocation freeAllocation
  exact continuous_const.max (by fun_prop)

/-- An active coordinate increases strictly with the common scalar. -/
theorem endpointAllocation_strict_of_active {r c d : ℝ} (hc : 0 ≤ c)
    (hcd : c < d) (ha : r+2 < endpointAllocation r c) :
    endpointAllocation r c < endpointAllocation r d := by
  have hx : r+2 < freeAllocation r c := by
    simpa [endpointAllocation, lt_max_iff, lt_irrefl, false_or] using ha
  rw [endpointAllocation, max_eq_right (le_of_lt hx)]
  exact lt_of_lt_of_le (freeAllocation_strict_mono hc hcd) (le_max_right _ _)

/-- Actual scalar resource function for the clipped finite cascade. -/
def allocatedResource (r : ι → ℝ) (c : ℝ) : ℝ :=
  ∑ i, resource (r i) (endpointAllocation (r i) c)

theorem allocatedResource_zero (r : ι → ℝ) (hr : ∀ i, 0 < r i) :
    allocatedResource r 0 = 4 * ∑ i, 1/(r i+2) := by
  unfold allocatedResource
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [endpointAllocation_zero (le_of_lt (hr i)), resource_lower_bound _ (by linarith [hr i])]
  ring

theorem allocatedResource_continuous (r : ι → ℝ) (hr : ∀ i, 0 < r i) :
    Continuous (allocatedResource r) := by
  unfold allocatedResource resource
  apply continuous_finset_sum
  intro i _
  exact ((endpointAllocation_continuous (r i)).add
    (continuous_const.div (endpointAllocation_continuous (r i))
      (fun c => ne_of_gt (endpointAllocation_pos (hr i) c)))).sub continuous_const

theorem allocatedResource_mono (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {c d : ℝ} (hc : 0 ≤ c) (hcd : c ≤ d) :
    allocatedResource r c ≤ allocatedResource r d := by
  apply Finset.sum_le_sum
  intro i _
  exact resource_mono (hr i) (endpointAllocation_gt_r (r i) c)
    (endpointAllocation_mono hc hcd)


/-- A direct supporting inequality, derived from the two elementary log bounds. -/
theorem resource_log_support {r s t : ℝ} (hs : 0 < s) (ht : 0 < t) :
    (s-r^2/s)*(Real.log t-Real.log s) ≤ resource r t-resource r s := by
  have hq : 0 < t/s := div_pos ht hs
  have hl := Real.log_le_sub_one_of_pos hq
  have hi := Real.log_le_sub_one_of_pos (inv_pos.2 hq)
  rw [Real.log_inv] at hi
  have hcoef : 0 ≤ r^2/s := by positivity
  have hA := mul_nonneg (le_of_lt hs) (sub_nonneg.mpr hl)
  have hB := mul_nonneg hcoef (show 0 ≤ (t/s)⁻¹-1+Real.log (t/s) by linarith)
  have hid : resource r t-resource r s -
      (s-r^2/s)*(Real.log t-Real.log s) =
      s*((t/s)-1-Real.log (t/s)) +
        (r^2/s)*((t/s)⁻¹-1+Real.log (t/s)) := by
    rw [Real.log_div (ne_of_gt ht) (ne_of_gt hs)]
    unfold resource
    field_simp
    <;> ring
  linarith

theorem resource_log_support_strict {r s t : ℝ} (hs : 0 < s) (ht : 0 < t)
    (hne : t ≠ s) :
    (s-r^2/s)*(Real.log t-Real.log s) < resource r t-resource r s := by
  have hq : 0 < t/s := div_pos ht hs
  have hqn : t/s ≠ 1 := by intro h; apply hne; exact (div_eq_one_iff_eq (ne_of_gt hs)).mp h
  have hl := Real.log_lt_sub_one_of_pos hq hqn
  have hi := Real.log_le_sub_one_of_pos (inv_pos.2 hq)
  rw [Real.log_inv] at hi
  have hcoef : 0 ≤ r^2/s := by positivity
  have hA := mul_pos hs (sub_pos.mpr hl)
  have hB := mul_nonneg hcoef (show 0 ≤ (t/s)⁻¹-1+Real.log (t/s) by linarith)
  have hid : resource r t-resource r s -
      (s-r^2/s)*(Real.log t-Real.log s) =
      s*((t/s)-1-Real.log (t/s)) +
        (r^2/s)*((t/s)⁻¹-1+Real.log (t/s)) := by
    rw [Real.log_div (ne_of_gt ht) (ne_of_gt hs)]
    unfold resource
    field_simp
    <;> ring
  linarith

/-- The stationary derivative is strictly increasing on the positive half-line. -/
theorem stationaryRate_strict_mono {r s t : ℝ} (hs : 0 < s) (hst : s < t) :
    s-r^2/s < t-r^2/t := by
  have ht : 0 < t := lt_trans hs hst
  have hdiv : r^2/t ≤ r^2/s := div_le_div_of_nonneg_left (sq_nonneg r) hs (le_of_lt hst)
  linarith

theorem stationaryRate_mono {r s t : ℝ} (hs : 0 < s) (hst : s ≤ t) :
    s-r^2/s ≤ t-r^2/t := by
  rcases hst.eq_or_lt with h | h
  · subst t; rfl
  · exact le_of_lt (stationaryRate_strict_mono hs h)

/-- The clipped allocation satisfies the actual one-dimensional KKT inequalities. -/
theorem endpointAllocation_kkt {r c : ℝ} (hr : 0 < r) (hc : 0 ≤ c) :
    c ≤ endpointAllocation r c-r^2/endpointAllocation r c ∧
      (r+2 < endpointAllocation r c →
        endpointAllocation r c-r^2/endpointAllocation r c = c) := by
  constructor
  · calc
      c = freeAllocation r c-r^2/freeAllocation r c := (freeAllocation_stationarity hr hc).symm
      _ ≤ endpointAllocation r c-r^2/endpointAllocation r c :=
        stationaryRate_mono (freeAllocation_pos hr hc) (le_max_right _ _)
  · intro ha
    have hf : r+2 < freeAllocation r c := by
      simpa [endpointAllocation, lt_max_iff, lt_irrefl, false_or] using ha
    rw [endpointAllocation, max_eq_right (le_of_lt hf)]
    exact freeAllocation_stationarity hr hc

theorem endpointAllocation_support {r c t : ℝ} (hr : 0 < r) (hc : 0 ≤ c)
    (ht : r+2 ≤ t) :
    c*(Real.log t-Real.log (endpointAllocation r c)) ≤
      resource r t-resource r (endpointAllocation r c) := by
  have hs := endpointAllocation_pos hr c
  have ht0 : 0 < t := by linarith
  have hk := endpointAllocation_kkt hr hc
  by_cases ha : r+2 < endpointAllocation r c
  · have hh := resource_log_support (r := r) hs ht0
    rw [hk.2 ha] at hh
    exact hh
  · have heq : endpointAllocation r c = r+2 := le_antisymm (le_of_not_gt ha) (endpointAllocation_ge_lower r c)
    have hlog : 0 ≤ Real.log t-Real.log (endpointAllocation r c) :=
      sub_nonneg.mpr (Real.log_le_log hs (by simpa [heq] using ht))
    exact le_trans (mul_le_mul_of_nonneg_right hk.1 hlog) (resource_log_support hs ht0)

theorem endpointAllocation_support_strict {r c t : ℝ} (hr : 0 < r) (hc : 0 ≤ c)
    (ht : r+2 ≤ t) (hne : t ≠ endpointAllocation r c) :
    c*(Real.log t-Real.log (endpointAllocation r c)) <
      resource r t-resource r (endpointAllocation r c) := by
  have hs := endpointAllocation_pos hr c
  have ht0 : 0 < t := by linarith
  have hk := endpointAllocation_kkt hr hc
  by_cases ha : r+2 < endpointAllocation r c
  · have hh := resource_log_support_strict (r := r) hs ht0 hne
    rw [hk.2 ha] at hh
    exact hh
  · have heq : endpointAllocation r c = r+2 := le_antisymm (le_of_not_gt ha) (endpointAllocation_ge_lower r c)
    have hlog : 0 ≤ Real.log t-Real.log (endpointAllocation r c) :=
      sub_nonneg.mpr (Real.log_le_log hs (by simpa [heq] using ht))
    exact lt_of_le_of_lt (mul_le_mul_of_nonneg_right hk.1 hlog) (resource_log_support_strict hs ht0 hne)

/-- The resource equation is sufficient for the global endpoint maximum. -/
theorem endpointAllocation_log_optimal (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {c : ℝ} (hc : 0 < c) (hbudget : allocatedResource r c = 4)
    (t : ι → ℝ) (ht : ∀ i, r i+2 ≤ t i)
    (htres : (∑ i, resource (r i) (t i)) ≤ 4) :
    (∑ i, Real.log (t i)) ≤ ∑ i, Real.log (endpointAllocation (r i) c) := by
  have hs := Finset.sum_le_sum (s := Finset.univ) fun i _ =>
    endpointAllocation_support (hr i) (le_of_lt hc) (ht i)
  simp_rw [mul_sub, Finset.sum_sub_distrib, ← Finset.mul_sum] at hs
  unfold allocatedResource at hbudget
  nlinarith

/-- A distinct feasible vector has strictly smaller log gain. -/
theorem endpointAllocation_log_optimal_strict (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {c : ℝ} (hc : 0 < c) (hbudget : allocatedResource r c = 4)
    (t : ι → ℝ) (ht : ∀ i, r i+2 ≤ t i)
    (htres : (∑ i, resource (r i) (t i)) ≤ 4)
    (hne : t ≠ fun i => endpointAllocation (r i) c) :
    (∑ i, Real.log (t i)) < ∑ i, Real.log (endpointAllocation (r i) c) := by
  classical
  obtain ⟨i,hi⟩ : ∃ i, t i ≠ endpointAllocation (r i) c := by
    by_contra h
    apply hne
    funext i
    by_contra hi
    exact h ⟨i,hi⟩
  have hs : (∑ i, c*(Real.log (t i)-Real.log (endpointAllocation (r i) c))) <
      ∑ i, (resource (r i) (t i)-resource (r i) (endpointAllocation (r i) c)) := by
    apply Finset.sum_lt_sum
    · intro j _
      exact endpointAllocation_support (hr j) (le_of_lt hc) (ht j)
    · exact ⟨i, Finset.mem_univ i, endpointAllocation_support_strict (hr i) (le_of_lt hc) (ht i) hi⟩
  simp_rw [mul_sub, Finset.sum_sub_distrib, ← Finset.mul_sum] at hs
  unfold allocatedResource at hbudget
  nlinarith


theorem freeAllocation_ge_scalar {r c : ℝ} (hc : 0 ≤ c) : c ≤ freeAllocation r c := by
  have hs : c ≤ Real.sqrt (c^2+4*r^2) := Real.le_sqrt_of_sq_le (by nlinarith [sq_nonneg r])
  unfold freeAllocation
  linarith

theorem allocatedResource_large (r : ι → ℝ) (hr : ∀ i, 0 < r i) (i : ι) :
    4 < allocatedResource r (5+2*r i) := by
  classical
  have hc : 0 ≤ 5+2*r i := by linarith [hr i]
  have hs := endpointAllocation_pos (hr i) (5+2*r i)
  have ha : 5+2*r i ≤ endpointAllocation (r i) (5+2*r i) :=
    le_trans (freeAllocation_ge_scalar hc) (le_max_right _ _)
  have hcost : 4 < resource (r i) (endpointAllocation (r i) (5+2*r i)) := by
    unfold resource
    have hq : 0 ≤ (r i)^2 / endpointAllocation (r i) (5+2*r i) := by positivity
    linarith
  exact lt_of_lt_of_le hcost (Finset.single_le_sum
    (fun j _ => resource_nonneg (endpointAllocation_pos (hr j) _)) (Finset.mem_univ i))

theorem allocatedResource_strict_after_base (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {c d : ℝ} (hc : 0 ≤ c) (hcd : c < d)
    (hactive : allocatedResource r 0 < allocatedResource r c) :
    allocatedResource r c < allocatedResource r d := by
  classical
  have hex : ∃ i, r i+2 < endpointAllocation (r i) c := by
    by_contra hn
    have heq : allocatedResource r c = allocatedResource r 0 := by
      unfold allocatedResource
      apply Finset.sum_congr rfl
      intro i _
      have hlow := endpointAllocation_ge_lower (r i) c
      have hu : endpointAllocation (r i) c ≤ r i+2 := by
        by_contra h
        exact hn ⟨i, lt_of_not_ge h⟩
      rw [le_antisymm hu hlow, endpointAllocation_zero (le_of_lt (hr i))]
    linarith
  obtain ⟨i,hi⟩ := hex
  apply Finset.sum_lt_sum
  · intro j _
    exact resource_mono (hr j) (endpointAllocation_gt_r (r j) c)
      (endpointAllocation_mono hc (le_of_lt hcd))
  · exact ⟨i, Finset.mem_univ i, resource_strict_mono (hr i)
      (endpointAllocation_gt_r (r i) c) (endpointAllocation_strict_of_active hc hcd hi)⟩

/-- Existence and uniqueness of the positive common scalar, without a KKT assumption. -/
theorem existsUnique_endpoint_scalar [Nonempty ι] (r : ι → ℝ)
    (hr : ∀ i, 0 < r i) (hbase : (∑ i, 1/(r i+2)) < 1) :
    ∃! c : ℝ, 0 < c ∧ allocatedResource r c = 4 := by
  classical
  let i : ι := Classical.choice inferInstance
  have hi : 0 < r i := hr i
  have hc : 0 ≤ 5+2*r i := by linarith
  have hzero : allocatedResource r 0 < 4 := by
    rw [allocatedResource_zero r hr]
    linarith
  have hlarge := allocatedResource_large r hr i
  obtain ⟨c,hcI,hcEq⟩ := intermediate_value_Icc hc
    (allocatedResource_continuous r hr).continuousOn
      (show 4 ∈ Set.Icc (allocatedResource r 0) (allocatedResource r (5+2*r i)) from
        ⟨le_of_lt hzero, le_of_lt hlarge⟩)
  have hcpos : 0 < c := by
    have hc0 := hcI.1
    by_contra hn
    have : c = 0 := le_antisymm (le_of_not_gt hn) hc0
    subst c
    linarith
  refine ⟨c,⟨hcpos,hcEq⟩,?_⟩
  rintro d ⟨hdpos,hdEq⟩
  rcases lt_trichotomy d c with h | h | h
  · have hs := allocatedResource_strict_after_base r hr (le_of_lt hdpos) h
      (by linarith : allocatedResource r 0 < allocatedResource r d)
    linarith
  · exact h
  · have hs := allocatedResource_strict_after_base r hr (le_of_lt hcpos) h
      (by linarith : allocatedResource r 0 < allocatedResource r c)
    linarith


/-- Product-gain form of the endpoint optimum. -/
theorem endpointAllocation_product_optimal (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {c : ℝ} (hc : 0 < c) (hbudget : allocatedResource r c = 4)
    (t : ι → ℝ) (ht : ∀ i, r i+2 ≤ t i)
    (htres : (∑ i, resource (r i) (t i)) ≤ 4) :
    (∏ i, t i) ≤ ∏ i, endpointAllocation (r i) c := by
  have htpos : ∀ i, 0 < t i := fun i => by linarith [hr i,ht i]
  have hspos : ∀ i, 0 < endpointAllocation (r i) c := fun i => endpointAllocation_pos (hr i) c
  apply (Real.log_le_log_iff (Finset.prod_pos (fun i _ => htpos i))
    (Finset.prod_pos (fun i _ => hspos i))).mp
  rw [Real.log_prod _ _ (fun i _ => ne_of_gt (htpos i)),
    Real.log_prod _ _ (fun i _ => ne_of_gt (hspos i))]
  exact endpointAllocation_log_optimal r hr hc hbudget t ht htres

theorem endpointAllocation_product_optimal_strict (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {c : ℝ} (hc : 0 < c) (hbudget : allocatedResource r c = 4)
    (t : ι → ℝ) (ht : ∀ i, r i+2 ≤ t i)
    (htres : (∑ i, resource (r i) (t i)) ≤ 4)
    (hne : t ≠ fun i => endpointAllocation (r i) c) :
    (∏ i, t i) < ∏ i, endpointAllocation (r i) c := by
  have htpos : ∀ i, 0 < t i := fun i => by linarith [hr i,ht i]
  have hspos : ∀ i, 0 < endpointAllocation (r i) c := fun i => endpointAllocation_pos (hr i) c
  apply (Real.log_lt_log_iff (Finset.prod_pos (fun i _ => htpos i))
    (Finset.prod_pos (fun i _ => hspos i))).mp
  rw [Real.log_prod _ _ (fun i _ => ne_of_gt (htpos i)),
    Real.log_prod _ _ (fun i _ => ne_of_gt (hspos i))]
  exact endpointAllocation_log_optimal_strict r hr hc hbudget t ht htres hne

/-- The original design parameter recovered from the constructive allocation. -/
def endpointParameter (r c : ℝ) : ℝ := 2/(endpointAllocation r c-r)

theorem endpointParameter_pos (r c : ℝ) : 0 < endpointParameter r c := by
  unfold endpointParameter
  exact div_pos (by norm_num) (sub_pos.mpr (endpointAllocation_gt_r r c))

theorem endpointParameter_le_one (r c : ℝ) : endpointParameter r c ≤ 1 := by
  unfold endpointParameter
  apply (div_le_one (sub_pos.mpr (endpointAllocation_gt_r r c))).2
  linarith [endpointAllocation_ge_lower r c]

theorem endpointParameter_inverse (r c : ℝ) :
    r+2/endpointParameter r c = endpointAllocation r c := by
  unfold endpointParameter
  field_simp
  <;> ring

theorem endpointParameter_resource {r c : ℝ} (hr : 0 < r) :
    4*endpointCost r (endpointParameter r c) = resource r (endpointAllocation r c) := by
  rw [← endpointParameter_inverse r c]
  exact (endpoint_change_variables hr (endpointParameter_pos r c)).symm

theorem endpointParameter_budget (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {c : ℝ} (hbudget : allocatedResource r c = 4) :
    (∑ i, endpointCost (r i) (endpointParameter (r i) c)) = 1 := by
  have hsum : 4*(∑ i, endpointCost (r i) (endpointParameter (r i) c)) = allocatedResource r c := by
    rw [Finset.mul_sum]
    unfold allocatedResource
    exact Finset.sum_congr rfl (fun i _ => endpointParameter_resource (hr i))
  linarith

theorem endpointGain_product_optimal (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {c : ℝ} (hc : 0 < c) (hbudget : allocatedResource r c = 4)
    (x : ι → ℝ) (hx : ∀ i, 0 < x i ∧ x i ≤ 1)
    (hcost : (∑ i, endpointCost (r i) (x i)) ≤ 1) :
    (∏ i, (r i+2/x i)) ≤ ∏ i, endpointAllocation (r i) c := by
  apply endpointAllocation_product_optimal r hr hc hbudget (fun i => r i+2/x i)
  · intro i
    have hh : 2 ≤ 2/x i := (le_div_iff₀ (hx i).1).2 (by nlinarith [(hx i).2])
    linarith
  · have hsum : (∑ i, resource (r i) (r i+2/x i)) = 4*∑ i, endpointCost (r i) (x i) := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun i _ => endpoint_change_variables (hr i) (hx i).1)
    rw [hsum]
    linarith

theorem endpointGain_product_optimal_strict (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {c : ℝ} (hc : 0 < c) (hbudget : allocatedResource r c = 4)
    (x : ι → ℝ) (hx : ∀ i, 0 < x i ∧ x i ≤ 1)
    (hcost : (∑ i, endpointCost (r i) (x i)) ≤ 1)
    (hne : x ≠ fun i => endpointParameter (r i) c) :
    (∏ i, (r i+2/x i)) < ∏ i, endpointAllocation (r i) c := by
  apply endpointAllocation_product_optimal_strict r hr hc hbudget (fun i => r i+2/x i)
  · intro i
    have hh : 2 ≤ 2/x i := (le_div_iff₀ (hx i).1).2 (by nlinarith [(hx i).2])
    linarith
  · have hsum : (∑ i, resource (r i) (r i+2/x i)) = 4*∑ i, endpointCost (r i) (x i) := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun i _ => endpoint_change_variables (hr i) (hx i).1)
    rw [hsum]
    linarith
  · intro heq
    apply hne
    funext i
    have hh := congrFun heq i
    change r i+2/x i = endpointAllocation (r i) c at hh
    unfold endpointParameter
    apply (eq_div_iff (ne_of_gt (sub_pos.mpr (endpointAllocation_gt_r (r i) c)))).2
    have hh' : (r i)*x i+2 = endpointAllocation (r i) c*x i := by
      have ht := (div_eq_iff (ne_of_gt (hx i).1)).mp (show 2/x i = endpointAllocation (r i) c-r i by linarith)
      nlinarith
    nlinarith

/-- Constructive original-parameter endpoint optimizer.  It states the allocation
    and gain optimization; root multiplicities are treated separately. -/
theorem exists_endpoint_optimizer [Nonempty ι] (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    (hbase : (∑ i, 1/(r i+2)) < 1) :
    ∃ c : ℝ, 0 < c ∧ allocatedResource r c = 4 ∧
      (∀ i, 0 < endpointParameter (r i) c ∧ endpointParameter (r i) c ≤ 1) ∧
      (∑ i, endpointCost (r i) (endpointParameter (r i) c)) = 1 ∧
      ∀ x : ι → ℝ, (∀ i, 0 < x i ∧ x i ≤ 1) →
        (∑ i, endpointCost (r i) (x i)) ≤ 1 →
          ((∏ i, (r i+2/x i)) ≤ (∏ i, endpointAllocation (r i) c) ∧
          (x ≠ (fun i => endpointParameter (r i) c) →
            (∏ i, (r i+2/x i)) < (∏ i, endpointAllocation (r i) c))) := by
  obtain ⟨c,⟨hc,hbudget⟩,_⟩ := existsUnique_endpoint_scalar r hr hbase
  refine ⟨c,hc,hbudget,?_,endpointParameter_budget r hr hbudget,?_⟩
  · exact fun i => ⟨endpointParameter_pos _ _, endpointParameter_le_one _ _⟩
  · intro x hx hcost
    exact ⟨endpointGain_product_optimal r hr hc hbudget x hx hcost,
      fun hne => endpointGain_product_optimal_strict r hr hc hbudget x hx hcost hne⟩

end C2.NGamma

end

/- ===== C2.NGammaEndpointLimit ===== -/

/-!
# The zero-frequency bridge to the endpoint resource problem

The normalized phase has a genuine joint continuous extension at zero frequency,
with value twice the endpoint resource.  Feasible positive-frequency points stay
uniformly away from the singular faces x_i=0 near zero frequency.
-/
noncomputable section
open scoped BigOperators Topology
namespace C2.NGamma

def phaseDenominator (r x w : ℝ) : ℝ := r*x^2+2*x+r*w^2

theorem phaseDenominator_pos {r x w : ℝ} (hr : 0 < r) (hx : 0 ≤ x) (hw : 0 < w) :
    0 < phaseDenominator r x w := by
  unfold phaseDenominator
  positivity

theorem allocationPhase_eq_arctan {r x w : ℝ} (hr : 0 < r) (hx : 0 ≤ x) (hw : 0 < w) :
    allocationPhase r x w = Real.arctan (2*w/phaseDenominator r x w) := by
  have ha : 0 ≤ (x+2/r)/w := by positivity
  have hb : 0 ≤ x/w := div_nonneg hx (le_of_lt hw)
  have hp : ((x+2/r)/w)*(-(x/w)) < 1 := by
    have h := mul_nonpos_of_nonneg_of_nonpos ha (neg_nonpos.2 hb)
    linarith
  unfold allocationPhase
  rw [sub_eq_add_neg,← Real.arctan_neg,Real.arctan_add hp]
  congr 1
  have hD := phaseDenominator_pos hr hx hw
  unfold phaseDenominator at *
  have hA : 0 < 1-((x+2/r)/w)*(-(x/w)) := by linarith
  field_simp
  <;> ring

/-- A single phase component bounded by the total phase already gives a
quantitative exclusion of the singular face x=0 as frequency tends to zero. -/
theorem feasible_component_lower_bound {r x w : ℝ} (hr : 0 < r)
    (hx : 0 ≤ x) (hw : 0 < w) (hw1 : w < 1)
    (hp : allocationPhase r x w ≤ 2*Real.arctan w) :
    1 ≤ x*(r*x+2)+(r+1)*w^2 := by
  rw [allocationPhase_eq_arctan hr hx hw,Real.two_mul_arctan (by linarith) hw1] at hp
  have hd : 0 < phaseDenominator r x w := phaseDenominator_pos hr hx hw
  have hdw : 0 < 1-w^2 := by nlinarith
  have harg : 2*w/phaseDenominator r x w ≤ 2*w/(1-w^2) :=
    Real.arctan_strictMono.le_iff_le.mp hp
  have hcross := (div_le_div_iff₀ hd hdw).mp harg
  unfold phaseDenominator at hcross
  nlinarith

theorem feasible_component_uniform_positive {r x w : ℝ} (hr : 0 < r)
    (hx : x ∈ Set.Icc 0 1) (hw : 0 < w) (hw1 : w < 1)
    (hsmall : (r+1)*w^2 ≤ 1/2)
    (hp : allocationPhase r x w ≤ 2*Real.arctan w) :
    1/(2*(r+2)) ≤ x := by
  have hb := feasible_component_lower_bound hr hx.1 hw hw1 hp
  have hsq : x^2 ≤ x := by nlinarith [hx.1,hx.2]
  apply (div_le_iff₀ (by positivity : 0 < 2*(r+2))).2
  nlinarith

/-- A continuous extension of the actual normalized phase `phase / w`.
`dslope` supplies the removable value arctan'(0)=1. -/
def normalizedPhase (r x w : ℝ) : ℝ :=
  dslope Real.arctan 0 (2*w/phaseDenominator r x w) *
    (2/phaseDenominator r x w)

theorem arctan_dslope_continuous : Continuous (dslope Real.arctan 0) := by
  apply continuous_iff_continuousAt.2
  intro x
  by_cases hx : x=0
  · subst x
    exact continuousAt_dslope_same.2 (Real.hasDerivAt_arctan 0).differentiableAt
  · exact (continuousAt_dslope_of_ne hx).2 Real.continuousAt_arctan

theorem normalizedPhase_eq {r x w : ℝ} (hr : 0 < r) (hx : 0 ≤ x) (hw : 0 < w) :
    normalizedPhase r x w = allocationPhase r x w / w := by
  have hd := phaseDenominator_pos hr hx hw
  have hz : 2*w/phaseDenominator r x w ≠ 0 := ne_of_gt (div_pos (by positivity) hd)
  unfold normalizedPhase
  rw [dslope_of_ne _ hz,allocationPhase_eq_arctan hr hx hw]
  simp only [slope_def_field,sub_zero,Real.arctan_zero]
  field_simp
  <;> ring

theorem normalizedPhase_zero {r x : ℝ} (hr : 0 < r) (hx : 0 < x) :
    normalizedPhase r x 0 = 2*endpointCost r x := by
  unfold normalizedPhase phaseDenominator endpointCost
  simp only [mul_zero,zero_pow (by norm_num : (2:ℕ) ≠ 0),add_zero,zero_div,dslope_same]
  rw [(Real.hasDerivAt_arctan 0).deriv]
  norm_num
  field_simp
  <;> ring

theorem normalizedPhase_joint_continuousAt {r : ℝ} {p : ℝ × ℝ}
    (hd : phaseDenominator r p.1 p.2 ≠ 0) :
    ContinuousAt (fun p : ℝ × ℝ => normalizedPhase r p.1 p.2) p := by
  have hD : ContinuousAt (fun p : ℝ × ℝ => phaseDenominator r p.1 p.2) p := by
    unfold phaseDenominator
    fun_prop
  have harg : ContinuousAt (fun p : ℝ × ℝ => 2*p.2/phaseDenominator r p.1 p.2) p :=
    (continuousAt_const.mul continuousAt_snd).div hD hd
  exact (arctan_dslope_continuous.continuousAt.comp harg).mul
    (continuousAt_const.div hD hd)

theorem normalizedPhase_endpoint_continuousAt {r x : ℝ} (hr : 0 < r) (hx : 0 < x) :
    ContinuousAt (fun p : ℝ × ℝ => normalizedPhase r p.1 p.2) (x,0) := by
  apply normalizedPhase_joint_continuousAt
  exact ne_of_gt (by dsimp [phaseDenominator]; positivity)

theorem allocationGain_endpoint {r x : ℝ} (hr : 0 < r) (hx : 0 < x) :
    allocationGain r x 0 = r+2/x := by
  have hx0 : x ≠ 0 := ne_of_gt hx
  have h : 0 ≤ r+2/x := by positivity
  unfold allocationGain
  have heq : ((r*x+2)^2+(r*0)^2)/(x^2+0^2) = (r+2/x)^2 := by
    field_simp
    <;> ring
  rw [heq,Real.sqrt_sq h]

theorem allocationGain_endpoint_continuousAt {r x : ℝ} (hx : 0 < x) :
    ContinuousAt (fun p : ℝ × ℝ => allocationGain r p.1 p.2) (x,0) := by
  unfold allocationGain
  apply Real.continuous_sqrt.continuousAt.comp
  have hd : x^2+(0:ℝ)^2 ≠ 0 := by positivity
  exact ContinuousAt.div (by fun_prop) (by fun_prop) hd

theorem allocationPhase_nonneg {r w x : ℝ} (hr : 0 < r) (hw : 0 < w) (hx : 0 ≤ x) :
    0 ≤ allocationPhase r x w := by
  rw [allocationPhase_eq_arctan hr hx hw]
  have h := Real.arctan_le_arctan (show 0 ≤ 2*w/phaseDenominator r x w by
    exact le_of_lt (div_pos (by positivity) (phaseDenominator_pos hr hx hw)))
  simpa using h

/-- Any cluster point of feasible positive-frequency allocations as w tends to
zero lies on the exact endpoint resource surface, with every coordinate positive.
This is a closed-graph statement for the actual phase equation, not an assumed
regularity or compactness property of the optimizer. -/
theorem feasible_endpoint_cluster {ι κ : Type*} [Fintype ι]
    {F : Filter κ} [Filter.NeBot F]
    (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    (w : κ → ℝ) (x : κ → ι → ℝ) (x₀ : ι → ℝ)
    (hwlim : Filter.Tendsto w F (𝓝 0))
    (hxlim : ∀ i, Filter.Tendsto (fun k => x k i) F (𝓝 (x₀ i)))
    (hw : ∀ k, 0 < w k) (hx : ∀ k i, x k i ∈ Set.Icc 0 1)
    (hphase : ∀ k, (∑ i, allocationPhase (r i) (x k i) (w k)) = 2*Real.arctan (w k)) :
    (∀ i, 0 < x₀ i ∧ x₀ i ≤ 1) ∧ (∑ i, endpointCost (r i) (x₀ i)) = 1 := by
  classical
  have hxmem : ∀ i, x₀ i ∈ Set.Icc 0 1 := by
    intro i
    exact ⟨ge_of_tendsto' (hxlim i) (fun k => (hx k i).1),
      le_of_tendsto' (hxlim i) (fun k => (hx k i).2)⟩
  have hcomponent : ∀ k i, allocationPhase (r i) (x k i) (w k) ≤ 2*Real.arctan (w k) := by
    intro k i
    rw [← hphase k]
    exact Finset.single_le_sum (fun j _ => allocationPhase_nonneg (hr j) (hw k) (hx k j).1)
      (Finset.mem_univ i)
  have hsmall : ∀ᶠ k in F, w k < 1 := hwlim (gt_mem_nhds (by norm_num : (0:ℝ) < 1))
  have hxpos : ∀ i, 0 < x₀ i := by
    intro i
    have hbound : ∀ᶠ k in F, 1 ≤ x k i*(r i*x k i+2)+(r i+1)*(w k)^2 := by
      filter_upwards [hsmall] with k hk
      exact feasible_component_lower_bound (hr i) (hx k i).1 (hw k) hk (hcomponent k i)
    have ht : Filter.Tendsto (fun k => x k i*(r i*x k i+2)+(r i+1)*(w k)^2) F
        (𝓝 (x₀ i*(r i*x₀ i+2))) := by
      have h : Filter.Tendsto (fun k => x k i*(r i*x k i+2)+(r i+1)*(w k)^2) F
          (𝓝 (x₀ i*(r i*x₀ i+2)+(r i+1)*(0:ℝ)^2)) :=
        ((hxlim i).mul ((tendsto_const_nhds.mul (hxlim i)).add_const 2)).add
          (tendsto_const_nhds.mul (hwlim.pow 2))
      simpa using h
    have hb : 1 ≤ x₀ i*(r i*x₀ i+2) := ge_of_tendsto ht hbound
    by_contra hn
    have heq : x₀ i=0 := le_antisymm (le_of_not_gt hn) (hxmem i).1
    norm_num [heq] at hb
  refine ⟨fun i => ⟨hxpos i,(hxmem i).2⟩,?_⟩
  have hnlim : ∀ i, Filter.Tendsto (fun k => normalizedPhase (r i) (x k i) (w k)) F
      (𝓝 (2*endpointCost (r i) (x₀ i))) := by
    intro i
    have h := (normalizedPhase_endpoint_continuousAt (hr i) (hxpos i)).tendsto.comp
      ((hxlim i).prodMk_nhds hwlim)
    simpa only [Function.comp_def,normalizedPhase_zero (hr i) (hxpos i)] using h
  have hsumlim := tendsto_finset_sum Finset.univ (fun i _ => hnlim i)
  have heq : (fun k => ∑ i, normalizedPhase (r i) (x k i) (w k)) =
      (fun k => 2*dslope Real.arctan 0 (w k)) := by
    funext k
    simp_rw [normalizedPhase_eq (hr _) (hx k _).1 (hw k)]
    rw [← Finset.sum_div,hphase k,dslope_of_ne _ (ne_of_gt (hw k))]
    simp only [slope_def_field,sub_zero,Real.arctan_zero]
    ring
  rw [heq] at hsumlim
  have ht : Filter.Tendsto (fun k => 2*dslope Real.arctan 0 (w k)) F (𝓝 2) := by
    have h : Filter.Tendsto (fun k => 2*dslope Real.arctan 0 (w k)) F
        (𝓝 (2*dslope Real.arctan 0 0)) :=
      tendsto_const_nhds.mul (arctan_dslope_continuous.continuousAt.tendsto.comp hwlim)
    simpa only [dslope_same,(Real.hasDerivAt_arctan 0).deriv,zero_pow (by norm_num : (2:ℕ)≠0),
      add_zero,div_one,mul_one,Function.comp_def] using h
  have hsum := tendsto_nhds_unique hsumlim ht
  rw [← Finset.mul_sum] at hsum
  linarith

end C2.NGamma

end

/- ===== C2.NGammaEndpointCompact ===== -/

/-! Compactness closes the upper bound at zero frequency.  Every feasible
sequence approaching zero has an actual convergent gain subsequence, whose
limit is the gain of a feasible endpoint allocation. -/
noncomputable section
open scoped BigOperators Topology
open Set Filter
namespace C2.NGamma

variable {ι : Type*} [Fintype ι]

/-- Compactness supplies the cluster point; it is not supplied as a premise. -/
theorem exists_feasible_endpoint_subsequence
    (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    (w : ℕ → ℝ) (x : ℕ → ι → ℝ)
    (hwlim : Tendsto w atTop (𝓝 0))
    (hw : ∀ k, 0 < w k) (hx : ∀ k i, x k i ∈ Icc 0 1)
    (hphase : ∀ k, (∑ i, allocationPhase (r i) (x k i) (w k)) = 2*Real.arctan (w k)) :
    ∃ x₀ : ι → ℝ, ∃ φ : ℕ → ℕ, StrictMono φ ∧
      (∀ i, 0 < x₀ i ∧ x₀ i ≤ 1) ∧ (∑ i, endpointCost (r i) (x₀ i)) = 1 ∧
      Tendsto (fun k => ∏ i, allocationGain (r i) (x (φ k) i) (w (φ k)))
        atTop (𝓝 (∏ i, (r i+2/x₀ i))) := by
  classical
  have hxcube : ∀ k, x k ∈ Icc (0 : ι → ℝ) 1 := by
    intro k
    exact ⟨fun i => (hx k i).1, fun i => (hx k i).2⟩
  obtain ⟨x₀,hx₀,φ,hφ,hlim⟩ :=
    (isCompact_Icc : IsCompact (Icc (0 : ι → ℝ) 1)).tendsto_subseq hxcube
  have hwsub := hwlim.comp hφ.tendsto_atTop
  have hxsub : ∀ i, Tendsto (fun k => x (φ k) i) atTop (𝓝 (x₀ i)) :=
    fun i => (tendsto_pi_nhds.mp hlim) i
  have hcluster := feasible_endpoint_cluster r hr (w ∘ φ) (x ∘ φ) x₀ hwsub hxsub
    (fun k => hw (φ k)) (fun k i => hx (φ k) i) (fun k => hphase (φ k))
  refine ⟨x₀,φ,hφ,hcluster.1,hcluster.2,?_⟩
  apply tendsto_finset_prod
  intro i hi
  have ht := (allocationGain_endpoint_continuousAt (r := r i) (hcluster.1 i).1).tendsto.comp
    ((hxsub i).prodMk_nhds hwsub)
  simpa only [Function.comp_def, allocationGain_endpoint (hr i) (hcluster.1 i).1] using ht

/-- Every eventual lower bound on gains along a feasible zero-frequency
sequence is bounded by every valid global endpoint gain bound. -/
theorem endpoint_bound_of_feasible_sequence
    (r : ι → ℝ) (hr : ∀ i, 0 < r i) (B v : ℝ)
    (hB : ∀ x₀ : ι → ℝ, (∀ i, 0 < x₀ i ∧ x₀ i ≤ 1) →
      (∑ i, endpointCost (r i) (x₀ i)) ≤ 1 → (∏ i, (r i+2/x₀ i)) ≤ B)
    (w : ℕ → ℝ) (x : ℕ → ι → ℝ)
    (hwlim : Tendsto w atTop (𝓝 0))
    (hw : ∀ k, 0 < w k) (hx : ∀ k i, x k i ∈ Icc 0 1)
    (hphase : ∀ k, (∑ i, allocationPhase (r i) (x k i) (w k)) = 2*Real.arctan (w k))
    (hv : ∀ᶠ k in atTop, v ≤ ∏ i, allocationGain (r i) (x k i) (w k)) : v ≤ B := by
  obtain ⟨x₀,φ,hφ,hx₀,hcost,hlim⟩ := exists_feasible_endpoint_subsequence r hr w x hwlim hw hx hphase
  exact le_trans (ge_of_tendsto hlim (hφ.tendsto_atTop.eventually hv))
    (hB x₀ hx₀ hcost.le)

/-- Specialization to the proved strict-regime endpoint optimizer. -/
theorem endpoint_allocation_bound_of_feasible_sequence
    (r : ι → ℝ) (hr : ∀ i, 0 < r i) {c : ℝ} (hc : 0 < c)
    (hbudget : allocatedResource r c = 4) (v : ℝ)
    (w : ℕ → ℝ) (x : ℕ → ι → ℝ)
    (hwlim : Tendsto w atTop (𝓝 0))
    (hw : ∀ k, 0 < w k) (hx : ∀ k i, x k i ∈ Icc 0 1)
    (hphase : ∀ k, (∑ i, allocationPhase (r i) (x k i) (w k)) = 2*Real.arctan (w k))
    (hv : ∀ᶠ k in atTop, v ≤ ∏ i, allocationGain (r i) (x k i) (w k)) :
    v ≤ ∏ i, endpointAllocation (r i) c := by
  exact endpoint_bound_of_feasible_sequence r hr _ v
    (fun x₀ hx₀ hcost => endpointGain_product_optimal r hr hc hbudget x₀ hx₀ hcost)
    w x hwlim hw hx hphase hv

/-- Specialization to the unique all-one design at the endpoint threshold. -/
theorem endpoint_equality_bound_of_feasible_sequence
    (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    (hbase : (∑ i, 1/(r i+2)) = 1) (v : ℝ)
    (w : ℕ → ℝ) (x : ℕ → ι → ℝ)
    (hwlim : Tendsto w atTop (𝓝 0))
    (hw : ∀ k, 0 < w k) (hx : ∀ k i, x k i ∈ Icc 0 1)
    (hphase : ∀ k, (∑ i, allocationPhase (r i) (x k i) (w k)) = 2*Real.arctan (w k))
    (hv : ∀ᶠ k in atTop, v ≤ ∏ i, allocationGain (r i) (x k i) (w k)) :
    v ≤ ∏ i, (r i+2) := by
  apply endpoint_bound_of_feasible_sequence r hr _ v ?_ w x hwlim hw hx hphase hv
  intro x₀ hx₀ hcost
  rw [endpoint_feasible_equality_unique r x₀ hr hx₀ hbase hcost]
  simp

end C2.NGamma

end

/- ===== C2.NGammaGlobalOptimum ===== -/

/-! Global optimization of the actual frequency-domain gain, including its
zero-frequency endpoint. Schur stability is a separate root-count interface. -/
noncomputable section
open scoped BigOperators Topology
open Set Filter
namespace C2.NGamma.Global

theorem gain_product_le_exp_frequencyValue {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) {w : ℝ} (hw : 0 < w)
    (hx : ∀ j, x j ∈ Icc (0:ℝ) 1)
    (hp : (∑ j, allocationPhase (r j) (x j) w) = 2*Real.arctan w) :
    (∏ j, allocationGain (r j) (x j) w) ≤ Real.exp (frequencyValue r w) := by
  obtain ⟨lam,hlam⟩ := exists_balancing_multiplier r hr hw ⟨x,hx,hp⟩
  rw [exp_frequencyValue_eq_product r hr hw hlam]
  exact frequencyAllocation_gain_optimal r hr hw x hx (hp.trans hlam.symm)

/-- Every positive-frequency optimum is strictly below any valid endpoint
maximum when the endpoint is feasible. The strictness uses a smaller positive
frequency before taking a compact subsequence tending to zero. -/
theorem positive_frequency_below_endpoint_bound {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) (hS : endpointSum r ≤ 1) (B : ℝ)
    (hB : ∀ x : Fin n → ℝ, (∀ j, 0 < x j ∧ x j ≤ 1) →
      (∑ j, endpointCost (r j) (x j)) ≤ 1 → (∏ j, (r j+2/x j)) ≤ B)
    {w : ℝ} (hw : 0 < w) (hf : feasible r w) :
    Real.exp (frequencyValue r w) < B := by
  obtain ⟨wp,hwp,hcross,hsmall,hlarge⟩ := feasible_frequency_interval hn r hr
  have hmidpos : 0 < w/2 := by positivity
  have hmidlt : w/2 < w := by linarith
  have hmidf : feasible r (w/2) := (hsmall hS (w/2) hmidpos).2
    (le_trans hmidlt.le ((hsmall hS w hw).1 hf))
  obtain ⟨ws,xs,hlim,hdata,hevent⟩ := exists_optimizing_endpoint_sequence hn r hr hS
  have hupper : Real.exp (frequencyValue r (w/2)) ≤ B :=
    endpoint_bound_of_feasible_sequence r hr B _ hB ws xs hlim
      (fun k => (hdata k).1) (fun k => (hdata k).2.1)
      (fun k => (hdata k).2.2.1)
      ((hevent (w/2) hmidpos hmidf).mono fun k hk => hk.le)
  have hstrict : Real.exp (frequencyValue r w) < Real.exp (frequencyValue r (w/2)) :=
    Real.exp_lt_exp.mpr
      (frequencyValue_strictAntiOn_feasible hn r hr ⟨hmidpos,hmidf⟩ ⟨hw,hf⟩ hmidlt)
  exact lt_of_lt_of_le hstrict hupper

theorem positive_frequency_below_endpoint_allocation {n : ℕ} (hn : 0 < n)
    (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j) (hS : endpointSum r ≤ 1)
    {c w : ℝ} (hc : 0 < c) (hbudget : allocatedResource r c = 4)
    (hw : 0 < w) (hx : ∀ j, x j ∈ Icc (0:ℝ) 1)
    (hp : (∑ j, allocationPhase (r j) (x j) w) = 2*Real.arctan w) :
    (∏ j, allocationGain (r j) (x j) w) < ∏ j, endpointAllocation (r j) c := by
  exact lt_of_le_of_lt (gain_product_le_exp_frequencyValue r x hr hw hx hp)
    (positive_frequency_below_endpoint_bound hn r hr hS _
      (fun y hy hcost => endpointGain_product_optimal r hr hc hbudget y hy hcost)
      hw ⟨x,hx,hp⟩)

theorem positive_frequency_below_endpoint_equality {n : ℕ} (hn : 0 < n)
    (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j) (hS : endpointSum r = 1)
    {w : ℝ} (hw : 0 < w) (hx : ∀ j, x j ∈ Icc (0:ℝ) 1)
    (hp : (∑ j, allocationPhase (r j) (x j) w) = 2*Real.arctan w) :
    (∏ j, allocationGain (r j) (x j) w) < ∏ j, (r j+2) := by
  apply lt_of_le_of_lt (gain_product_le_exp_frequencyValue r x hr hw hx hp)
  apply positive_frequency_below_endpoint_bound hn r hr hS.le _ ?_ hw ⟨x,hx,hp⟩
  intro y hy hcost
  rw [endpoint_feasible_equality_unique r y hr hy hS hcost]
  simp

/-- Constructive global endpoint optimizer in the strict endpoint regime.
All positive-frequency competitors are strictly inferior, and the endpoint
comparison is unique. No stability conclusion is hidden in the statement. -/
theorem exists_unique_global_endpoint_optimizer {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) (hS : endpointSum r < 1) :
    ∃ c : ℝ, 0 < c ∧ allocatedResource r c = 4 ∧
      (∀ j, 0 < endpointParameter (r j) c ∧ endpointParameter (r j) c ≤ 1) ∧
      (∑ j, endpointCost (r j) (endpointParameter (r j) c)) = 1 ∧
      (∀ x : Fin n → ℝ, (∀ j, 0 < x j ∧ x j ≤ 1) →
        (∑ j, endpointCost (r j) (x j)) ≤ 1 →
          (∏ j, (r j+2/x j)) ≤ (∏ j, endpointAllocation (r j) c) ∧
          ((∏ j, (r j+2/x j)) = (∏ j, endpointAllocation (r j) c) ↔
            x = fun j => endpointParameter (r j) c)) ∧
      ∀ w : ℝ, 0 < w → ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) →
        (∑ j, allocationPhase (r j) (x j) w) = 2*Real.arctan w →
        (∏ j, allocationGain (r j) (x j) w) < ∏ j, endpointAllocation (r j) c := by
  letI : Nonempty (Fin n) := ⟨⟨0,hn⟩⟩
  obtain ⟨c,hc,hbudget,hparam,hcost,hopt⟩ := exists_endpoint_optimizer r hr hS
  refine ⟨c,hc,hbudget,hparam,hcost,?_,?_⟩
  · intro x hx hxcost
    refine ⟨(hopt x hx hxcost).1,?_⟩
    constructor
    · intro heq
      by_contra hne
      exact (ne_of_lt ((hopt x hx hxcost).2 hne)) heq
    · intro heq
      subst x
      exact Finset.prod_congr rfl (fun j _ => endpointParameter_inverse (r j) c)
  · intro w hw x hx hp
    exact positive_frequency_below_endpoint_allocation hn r x hr hS.le hc hbudget hw hx hp

end C2.NGamma.Global

end

/- ===== C2.NGammaReflection ===== -/

/-! Actual phase and magnitude comparisons for componentwise reflection.
No statement about a stable gain interval is assumed or encoded here. -/

noncomputable section
open scoped BigOperators

namespace C2.NGamma.Global

def magnitudeFactor (r x t : ℝ) : ℝ :=
  r * Real.sqrt ((1+(x+2/r)^2*t^2)/(1+x^2*t^2))

theorem magnitudeFactor_pos {r x t : ℝ} (hr : 0 < r) :
    0 < magnitudeFactor r x t := by
  unfold magnitudeFactor
  positivity

theorem negative_reflection_phase {r x t : ℝ} (hr : 0 < r)
    (hx : x < 0) (hzero : -(2/r) ≤ x) (ht : 0 < t) :
    Phase.contribution (|x|+2/r) |x| t < Phase.contribution (x+2/r) x t := by
  rw [abs_of_neg hx]
  unfold Phase.contribution
  have h := reflection_phase_strict (c := 2/r) (u := -x) (t := t)
    (by linarith) (by linarith) ht
  rw [neg_mul,Real.arctan_neg] at h
  convert h using 1 <;> congr 1 <;> congr 1 <;> ring <;> simp only [Real.arctan_neg]

theorem reflection_phase_le {r x t : ℝ} (hr : 0 < r)
    (hzero : -(2/r) ≤ x) (ht : 0 < t) :
    Phase.contribution (|x|+2/r) |x| t ≤ Phase.contribution (x+2/r) x t := by
  by_cases hx : x < 0
  · exact (negative_reflection_phase hr hx hzero ht).le
  · rw [abs_of_nonneg (le_of_not_gt hx)]

theorem negative_reflection_magnitude {r x t : ℝ} (hr : 0 < r)
    (hx : x < 0) (ht : 0 < t) :
    magnitudeFactor r x t < magnitudeFactor r |x| t := by
  rw [abs_of_neg hx]
  unfold magnitudeFactor
  have h := reflection_magnitude_strict (r := r) (c := 2/r) (u := -x) (t := t)
    hr (by positivity) (by linarith) ht
  convert h using 1 <;> congr 1 <;> congr 1 <;> congr 1 <;> ring

theorem reflection_magnitude_le {r x t : ℝ} (hr : 0 < r) (ht : 0 < t) :
    magnitudeFactor r x t ≤ magnitudeFactor r |x| t := by
  by_cases hx : x < 0
  · exact (negative_reflection_magnitude hr hx ht).le
  · rw [abs_of_nonneg (le_of_not_gt hx)]

/-- Reflecting every negative component strictly reduces the sum of the
actual phase contributions whenever at least one component is negative. -/
theorem reflected_phase_sum_strict {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hzero : ∀ j, -(2/r j) ≤ x j)
    (hneg : ∃ j, x j < 0) {t : ℝ} (ht : 0 < t) :
    (∑ j, Phase.contribution (|x j|+2/r j) |x j| t) <
      ∑ j, Phase.contribution (x j+2/r j) (x j) t := by
  apply Finset.sum_lt_sum
  · intro j _
    exact reflection_phase_le (hr j) (hzero j) ht
  · obtain ⟨j,hj⟩ := hneg
    exact ⟨j,Finset.mem_univ _,negative_reflection_phase (hr j) hj (hzero j) ht⟩

/-- The magnitude product of the reflected parameter vector is strictly
larger at every positive frequency. This is an all-order statement. -/
theorem reflected_magnitude_product_strict {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hneg : ∃ j, x j < 0) {t : ℝ} (ht : 0 < t) :
    (∏ j, magnitudeFactor (r j) (x j) t) <
      ∏ j, magnitudeFactor (r j) |x j| t := by
  apply Finset.prod_lt_prod
  · intro j _
    exact magnitudeFactor_pos (hr j)
  · intro j _
    exact reflection_magnitude_le (hr j) ht
  · obtain ⟨j,hj⟩ := hneg
    exact ⟨j,Finset.mem_univ _,negative_reflection_magnitude (hr j) hj ht⟩

end C2.NGamma.Global

end

/- ===== C2.NGammaGainBridge ===== -/

/-! Exact identifications between the allocation coordinates w=1/t and
the amplitude/phase used for the actual characteristic polynomial. -/
noncomputable section
open scoped BigOperators
namespace C2.NGamma.Global

theorem magnitudeFactor_eq_amplitudeFactor (r x t : ℝ) :
    magnitudeFactor r x t = Cayley.amplitudeFactor r x t := by
  unfold magnitudeFactor Cayley.amplitudeFactor
  rw [Real.sqrt_div (by positivity)]
  simp only [mul_pow]
  ring

theorem allocationGain_eq_amplitudeFactor {r w : ℝ} (hr : 0 < r) (hw : 0 < w) (x : ℝ) :
    allocationGain r x w = Cayley.amplitudeFactor r x (1/w) := by
  have hsq : (allocationGain r x w)^2 = (Cayley.amplitudeFactor r x (1/w))^2 := by
    unfold allocationGain
    rw [Real.sq_sqrt (by positivity),Cayley.amplitudeFactor_sq]
    have hD : 0 < x^2+w^2 := by positivity
    have hE : 0 < 1+(x*(1/w))^2 := by positivity
    field_simp
    <;> ring
  nlinarith [allocationGain_pos hr hw x,Cayley.amplitudeFactor_pos hr x (1/w)]

theorem allocationProduct_eq_amplitude {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) {w : ℝ} (hw : 0 < w) :
    (∏ j, allocationGain (r j) (x j) w) = Cayley.amplitude r x (1/w) := by
  exact Finset.prod_congr rfl (fun j _ => allocationGain_eq_amplitudeFactor (hr j) hw (x j))

theorem phase_balance_iff_totalPhase {n : ℕ} (r x : Fin n → ℝ) {w : ℝ} (hw : 0 < w) :
    (∑ j, allocationPhase (r j) (x j) w) = 2*Real.arctan w ↔
      Phase.totalPhase (fun j => x j+2/r j) x 1 (1/w) = Real.pi := by
  rw [Phase.phase_eq_pi_iff_sumRatio _ _ _ (one_div_pos.mpr hw)]
  norm_num
  simpa only [allocationPhase,phase,sumRatio,Phase.sumRatio,one_div] using
    (ratio_eq_two_iff_phase_eq r x hw).symm

theorem reflected_amplitude_strict {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hneg : ∃ j, x j < 0) {t : ℝ} (ht : 0 < t) :
    Cayley.amplitude r x t < Cayley.amplitude r (fun j => |x j|) t := by
  have h := reflected_magnitude_product_strict r x hr hneg ht
  simpa only [magnitudeFactor_eq_amplitudeFactor] using h

end C2.NGamma.Global

end

/- ===== C2.NGammaCriticalGain ===== -/

/-! A single critical-gain relation, with the endpoint and finite-frequency
cases stated using the actual amplitude and phase. Its global optimizer is
unique. The relation is translated to Schur stability in a separate module. -/
noncomputable section
open scoped BigOperators
open Set
namespace C2.NGamma.Global

def CriticalGain {n : ℕ} (r x : Fin n → ℝ) (B : ℝ) : Prop :=
  ((∀ j, 0 < x j) ∧ (∑ j, endpointCost (r j) (x j)) ≤ 1 ∧ B = ∏ j, (r j+2/x j)) ∨
    ∃ t : ℝ, 0 < t ∧ Phase.totalPhase (fun j => x j+2/r j) x 1 t = Real.pi ∧
      B = Cayley.amplitude r x t

/-- The explicit parameter prescription in the three regimes of the paper. -/
def OptimalParameterDescription {n : ℕ} (r x : Fin n → ℝ) : Prop :=
  (1 < endpointSum r → x = fun _ => 1) ∧
  (endpointSum r = 1 → x = fun _ => 1) ∧
  (endpointSum r < 1 → ∃ c : ℝ, 0 < c ∧ allocatedResource r c = 4 ∧
    x = fun j => endpointParameter (r j) c)

theorem criticalGain_pos {n : ℕ} {r x : Fin n → ℝ} (hr : ∀ j, 0 < r j)
    {B : ℝ} (hB : CriticalGain r x B) : 0 < B := by
  rcases hB with ⟨hx,hS,rfl⟩ | ⟨t,ht,hp,rfl⟩
  · exact Finset.prod_pos (fun j _ => by have := hr j; have := hx j; positivity)
  · exact Cayley.amplitude_pos hr x t

theorem criticalGain_of_frequency {n : ℕ} (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    {w : ℝ} (hw : 0 < w)
    (hp : (∑ j, allocationPhase (r j) (x j) w) = 2*Real.arctan w) :
    CriticalGain r x (∏ j, allocationGain (r j) (x j) w) := by
  exact Or.inr ⟨1/w,one_div_pos.mpr hw,(phase_balance_iff_totalPhase r x hw).mp hp,
    allocationProduct_eq_amplitude r x hr hw⟩

theorem finite_critical_to_frequency {n : ℕ} (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    {t B : ℝ} (ht : 0 < t)
    (hp : Phase.totalPhase (fun j => x j+2/r j) x 1 t = Real.pi)
    (hB : B = Cayley.amplitude r x t) :
    ∃ w : ℝ, 0 < w ∧ (∑ j, allocationPhase (r j) (x j) w) = 2*Real.arctan w ∧
      B = ∏ j, allocationGain (r j) (x j) w := by
  refine ⟨1/t,one_div_pos.mpr ht,?_,?_⟩
  · apply (phase_balance_iff_totalPhase r x (one_div_pos.mpr ht)).mpr
    simpa only [one_div_one_div] using hp
  · rw [allocationProduct_eq_amplitude r x hr (one_div_pos.mpr ht),one_div_one_div]
    exact hB

theorem criticalGain_exists {n : ℕ} (hn : 0 < n) (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hx : ∀ j, x j ∈ Icc (0:ℝ) 1) :
    ∃ B : ℝ, CriticalGain r x B := by
  by_cases hc : (∃ j, x j = 0) ∨ 1 < Phase.endpointSum r x
  · obtain ⟨t,ht,_⟩ := (Phase.single_sample_phase_crossing_iff hn hr
      (fun j => (hx j).1) (fun j => (hx j).2)).mpr hc
    exact ⟨Cayley.amplitude r x t,Or.inr ⟨t,ht.1,ht.2,rfl⟩⟩
  · push_neg at hc
    exact ⟨∏ j, (r j+2/x j),Or.inl
      ⟨fun j => lt_of_le_of_ne (hx j).1 (Ne.symm (hc.1 j)),hc.2,rfl⟩⟩

theorem criticalGain_unique {n : ℕ} (hn : 0 < n) (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hx : ∀ j, x j ∈ Icc (0:ℝ) 1)
    {A B : ℝ} (hA : CriticalGain r x A) (hB : CriticalGain r x B) : A = B := by
  rcases hA with ⟨ha,hS,hA⟩ | ⟨s,hs,hps,hA⟩
  · rcases hB with ⟨hb,hT,hB⟩ | ⟨t,ht,hpt,hB⟩
    · exact hA.trans hB.symm
    · have hlt := Phase.single_phase_below_pi_of_endpoint hn hr ha (fun j => (hx j).2) hS ht
      exact False.elim ((ne_of_lt hlt) hpt)
  · rcases hB with ⟨hb,hT,hB⟩ | ⟨t,ht,hpt,hB⟩
    · have hlt := Phase.single_phase_below_pi_of_endpoint hn hr hb (fun j => (hx j).2) hT hs
      exact False.elim ((ne_of_lt hlt) hps)
    · have hst := Phase.first_phase_crossing_unique hn (by norm_num : 1 ≤ (1:ℕ))
        (fun j => (hx j).1) (fun j => (hx j).2)
        (fun j => lt_add_of_pos_right _ (div_pos (by norm_num) (hr j))) hs ht hps hpt
      rw [hA,hB,hst]

theorem log_gain_product {n : ℕ} (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    {w : ℝ} (hw : 0 < w) :
    Real.log (∏ j, allocationGain (r j) (x j) w) = ∑ j, allocationLogGain (r j) (x j) w := by
  rw [Real.log_prod _ _ (fun j _ => ne_of_gt (allocationGain_pos (hr j) hw _))]
  exact Finset.sum_congr rfl (fun j _ => log_allocationGain (hr j) hw (x j))

/-- Unified global gain optimizer, with no assumed maximizing vector, scalar,
or regularity. The explicit three regimes are proved by the imported allocation
and outer-monotonicity theorems. -/
theorem exists_unique_global_critical_gain_classified {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    ∃ xstar : Fin n → ℝ, ∃ Bstar : ℝ,
      (∀ j, xstar j ∈ Icc (0:ℝ) 1) ∧ CriticalGain r xstar Bstar ∧
      OptimalParameterDescription r xstar ∧
      ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) → ∀ B : ℝ, CriticalGain r x B →
        B ≤ Bstar ∧ (B = Bstar ↔ x = xstar) := by
  by_cases hlarge : 1 < endpointSum r
  · obtain ⟨wm,hwm,hp,hopt⟩ := positive_endpoint_unique_global_maximum hn r hr hlarge
    let Bstar := ∏ j, allocationGain (r j) 1 wm
    have hstar : CriticalGain r (fun _ => 1) Bstar := criticalGain_of_frequency r _ hr hwm hp
    refine ⟨fun _ => 1,Bstar,fun _ => by norm_num,hstar,?_,?_⟩
    · exact ⟨fun _ => rfl,fun _ => rfl,fun hsmall => False.elim (not_lt_of_ge hlarge.le hsmall)⟩
    intro x hx B hB
    have hleuniq : B ≤ Bstar ∧ (B = Bstar → x = fun _ => 1) := by
      rcases hB with ⟨hxp,hS,hBeq⟩ | ⟨t,ht,hpt,hBeq⟩
      · have hbase := (endpoint_feasible_iff r hr).mp ⟨x,fun j => ⟨hxp j,(hx j).2⟩,hS⟩
        exact False.elim (not_lt_of_ge hbase hlarge)
      · obtain ⟨w,hw,hphase,hgain⟩ := finite_critical_to_frequency r x hr ht hpt hBeq
        have hoptx := hopt w hw x hx hphase
        have hBP : 0 < B := hgain ▸ Finset.prod_pos (fun j _ => allocationGain_pos (hr j) hw _)
        have hSP : 0 < Bstar := Finset.prod_pos (fun j _ => allocationGain_pos (hr j) hwm _)
        have hlogs : Real.log B ≤ Real.log Bstar := by
          rw [hgain,log_gain_product r x hr hw]
          change _ ≤ Real.log (∏ j, allocationGain (r j) 1 wm)
          rw [log_gain_product r (fun _ => 1) hr hwm]
          exact hoptx.1
        refine ⟨(Real.log_le_log_iff hBP hSP).mp hlogs,?_⟩
        intro heq
        have hlogeq := congrArg Real.log heq
        rw [hgain,log_gain_product r x hr hw] at hlogeq
        change _ = Real.log (∏ j, allocationGain (r j) 1 wm) at hlogeq
        rw [log_gain_product r (fun _ => 1) hr hwm] at hlogeq
        exact ((hoptx.2).mp hlogeq).2
    refine ⟨hleuniq.1,hleuniq.2,?_⟩
    intro heq
    subst x
    exact criticalGain_unique hn r _ hr hx hB hstar
  by_cases hsmall : endpointSum r < 1
  · obtain ⟨c,hc,hbudget,hparam,hcost,hopt,hfinite⟩ := exists_unique_global_endpoint_optimizer hn r hr hsmall
    let xstar : Fin n → ℝ := fun j => endpointParameter (r j) c
    let Bstar : ℝ := ∏ j, endpointAllocation (r j) c
    have hxstar : ∀ j, xstar j ∈ Icc (0:ℝ) 1 := fun j => ⟨(hparam j).1.le,(hparam j).2⟩
    have hstar : CriticalGain r xstar Bstar := Or.inl
      ⟨fun j => (hparam j).1,hcost.le,(Finset.prod_congr rfl (fun j _ => endpointParameter_inverse (r j) c)).symm⟩
    refine ⟨xstar,Bstar,hxstar,hstar,?_,?_⟩
    · exact ⟨fun hlarge => False.elim (not_lt_of_ge hlarge.le hsmall),
        fun hequal => False.elim ((ne_of_lt hsmall) hequal),fun _ => ⟨c,hc,hbudget,rfl⟩⟩
    intro x hx B hB
    have hleuniq : B ≤ Bstar ∧ (B = Bstar → x = xstar) := by
      rcases hB with ⟨hxp,hS,hBeq⟩ | ⟨t,ht,hpt,hBeq⟩
      · rw [hBeq]
        exact ⟨(hopt x (fun j => ⟨hxp j,(hx j).2⟩) hS).1,
          (hopt x (fun j => ⟨hxp j,(hx j).2⟩) hS).2.mp⟩
      · obtain ⟨w,hw,hphase,hgain⟩ := finite_critical_to_frequency r x hr ht hpt hBeq
        have hlt : B < Bstar := by rw [hgain]; exact hfinite w hw x hx hphase
        exact ⟨hlt.le,fun heq => False.elim ((ne_of_lt hlt) heq)⟩
    refine ⟨hleuniq.1,hleuniq.2,?_⟩
    intro heq
    subst x
    exact criticalGain_unique hn r _ hr hx hB hstar
  · have hequal : endpointSum r = 1 := le_antisymm (le_of_not_gt hlarge) (le_of_not_gt hsmall)
    let Bstar : ℝ := ∏ j, (r j+2)
    have hcost : (∑ j, endpointCost (r j) 1) = 1 := by
      simpa [endpointSum,endpointCost,add_comm] using hequal
    have hstar : CriticalGain r (fun _ => 1) Bstar := Or.inl
      ⟨fun _ => by norm_num,hcost.le,by simp [Bstar]⟩
    refine ⟨fun _ => 1,Bstar,fun _ => by norm_num,hstar,?_,?_⟩
    · exact ⟨fun _ => rfl,fun _ => rfl,fun hsmall => False.elim ((ne_of_lt hsmall) hequal)⟩
    intro x hx B hB
    have hleuniq : B ≤ Bstar ∧ (B = Bstar → x = fun _ => 1) := by
      rcases hB with ⟨hxp,hS,hBeq⟩ | ⟨t,ht,hpt,hBeq⟩
      · have hxone := endpoint_feasible_equality_unique r x hr (fun j => ⟨hxp j,(hx j).2⟩) hequal hS
        have hBB : B = Bstar := by rw [hBeq,hxone]; simp [Bstar]
        exact ⟨hBB.le,fun _ => hxone⟩
      · obtain ⟨w,hw,hphase,hgain⟩ := finite_critical_to_frequency r x hr ht hpt hBeq
        have hlt : B < Bstar := by rw [hgain]; exact positive_frequency_below_endpoint_equality hn r x hr hequal hw hx hphase
        exact ⟨hlt.le,fun heq => False.elim ((ne_of_lt hlt) heq)⟩
    refine ⟨hleuniq.1,hleuniq.2,?_⟩
    intro heq
    subst x
    exact criticalGain_unique hn r _ hr hx hB hstar

/-- The unclassified interface used by subsequent stability wrappers. -/
theorem exists_unique_global_critical_gain {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    ∃ xstar : Fin n → ℝ, ∃ Bstar : ℝ,
      (∀ j, xstar j ∈ Icc (0:ℝ) 1) ∧ CriticalGain r xstar Bstar ∧
      ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) → ∀ B : ℝ, CriticalGain r x B →
        B ≤ Bstar ∧ (B = Bstar ↔ x = xstar) := by
  obtain ⟨xstar,Bstar,hx,hB,hdescription,hopt⟩ := exists_unique_global_critical_gain_classified hn r hr
  exact ⟨xstar,Bstar,hx,hB,hopt⟩

end C2.NGamma.Global

end

/- ===== C2.NGammaCriticalBoundary ===== -/

/-! The unified critical gain is an actual unit-circle boundary of the
characteristic polynomial: either -1 or a distinct conjugate pair. -/
noncomputable section
open scoped ComplexConjugate
namespace C2.NGamma.Global
open PolynomialModel Cayley

/-- Every critical gain has an actual unit-circle root. -/
theorem criticalGain_has_unit_root {n : ℕ} {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) {B : ℝ} (hB : CriticalGain r x B) :
    ∃ z : ℂ, ‖z‖ = 1 ∧ (characteristic r x 1 B).eval z = 0 := by
  rcases hB with ⟨hx, _, rfl⟩ | ⟨t, ht, hphase, rfl⟩
  · exact ⟨-1, by simp, endpoint_is_root (fun i => ne_of_gt (hx i))⟩
  · have hroot := first_crossing_gives_unit_root hr x 1 t hphase
    exact ⟨point t, hroot.2, hroot.1⟩

/-- The gain boundary itself is not strictly Schur stable. -/
theorem criticalGain_not_schur {n : ℕ} {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) {B : ℝ} (hB : CriticalGain r x B) :
    ¬ SchurStable (characteristic r x 1 B) := by
  obtain ⟨z, hz, hroot⟩ := criticalGain_has_unit_root hr hB
  intro hs
  have h := hs z hroot
  rw [hz] at h
  exact lt_irrefl _ h

/-- The finite-frequency boundary contains the distinct conjugate unit pair;
the endpoint alternative has a root at -1. -/
theorem criticalGain_boundary_kind {n : ℕ} {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) {B : ℝ} (hB : CriticalGain r x B) :
    (characteristic r x 1 B).eval (-1) = 0 ∨
      ∃ t : ℝ, 0 < t ∧
        (characteristic r x 1 B).eval (point t) = 0 ∧
        (characteristic r x 1 B).eval (conj (point t)) = 0 ∧
        ‖point t‖ = 1 ∧ ‖conj (point t)‖ = 1 ∧ point t ≠ conj (point t) := by
  rcases hB with ⟨hx, _, rfl⟩ | ⟨t, ht, hphase, rfl⟩
  · exact Or.inl (endpoint_is_root (fun i => ne_of_gt (hx i)))
  · exact Or.inr ⟨t, ht, first_crossing_conjugate_pair hr x 1 ht hphase⟩

end C2.NGamma.Global

end

/- ===== C2.NGammaDiagonalCounterexample ===== -/

/-! The explicit Hurwitz counterexample from the manuscript. -/
noncomputable section
namespace C2.NGamma
open Matrix

def counterA : Matrix (Fin 2) (Fin 2) ℝ := !![2,3; -3,-3]
def counterGamma : Fin 2 → ℝ := ![1,1/2]
def counterStep : Matrix (Fin 2) (Fin 2) ℝ := !![-7/3,-2; 1,1]

lemma counterA_charpoly_eval (z : ℂ) :
    (complexify counterA).charpoly.eval z = z^2+z+3 := by
  rw [eval_charpoly, Matrix.det_fin_two]
  norm_num [complexify, counterA, Matrix.map_apply]
  ring

/-- Every complex continuous eigenvalue has strictly negative real part. -/
theorem counterA_hurwitz (z : ℂ) (hz : (complexify counterA).charpoly.eval z = 0) :
    z.re < 0 := by
  rw [counterA_charpoly_eval] at hz
  have hr := congrArg Complex.re hz
  have hi := congrArg Complex.im hz
  simp [pow_two, Complex.mul_re, Complex.mul_im] at hr hi
  by_cases hy : z.im = 0
  · rw [hy] at hr
    nlinarith [sq_nonneg (z.re + 1/2)]
  · have hfac : z.im * (2*z.re+1) = 0 := by nlinarith [hi]
    have hh := (mul_eq_zero.mp hfac).resolve_left hy
    linarith

lemma counterE : stepE 2 counterGamma counterA = !![-3,-6; 3,4] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [stepE, counterGamma, counterA, Matrix.mul_apply, Fin.sum_univ_two]

lemma counterF : stepF 2 counterGamma counterA = !![1,0; -3,-2] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [stepF, counterGamma, counterA, Matrix.mul_apply, Fin.sum_univ_two]

lemma counterE_det : (stepE 2 counterGamma counterA).det = 6 := by
  rw [counterE, Matrix.det_fin_two]
  norm_num

lemma counter_step : stepMatrix 2 counterGamma counterA = counterStep := by
  have h : stepE 2 counterGamma counterA * counterStep = stepF 2 counterGamma counterA := by
    rw [counterE, counterF]
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [counterStep, Matrix.mul_apply, Fin.sum_univ_two]
  have he : IsUnit (stepE 2 counterGamma counterA).det := by
    rw [counterE_det]
    exact isUnit_iff_ne_zero.mpr (by norm_num)
  have hh := congrArg (fun N => (stepE 2 counterGamma counterA)⁻¹ * N) h
  dsimp only at hh
  rw [Matrix.nonsing_inv_mul_cancel_left _ _ he] at hh
  exact hh.symm

lemma counterStep_charpoly_eval (z : ℂ) :
    (complexify counterStep).charpoly.eval z = z^2+(4/3)*z-1/3 := by
  rw [eval_charpoly, Matrix.det_fin_two]
  norm_num [complexify, counterStep, Matrix.map_apply]
  ring

/-- The discrete realization has the displayed real root less than -1. -/
theorem counter_unstable_root :
    let z : ℂ := ((-2-Real.sqrt 7)/3 : ℝ)
    (complexify (stepMatrix 2 counterGamma counterA)).charpoly.eval z = 0 ∧
      1 < ‖z‖ := by
  dsimp only
  rw [counter_step, counterStep_charpoly_eval]
  have hs : (Real.sqrt 7)^2 = 7 := Real.sq_sqrt (by norm_num)
  have hpos : 1 < Real.sqrt 7 := by
    nlinarith [Real.sqrt_nonneg (7:ℝ)]
  constructor
  · apply Complex.ext <;> simp [Complex.mul_re, Complex.mul_im, pow_two]
    nlinarith
  · rw [Complex.norm_real]
    rw [Real.norm_eq_abs, abs_of_neg (by linarith : (-2-Real.sqrt 7)/3 < 0)]
    linarith

/-- Hurwitz stability and individually A-stable weights do not suffice for an
 independently weighted state-space discretization. -/
theorem hurwitz_not_sufficient :
    (∀ z : ℂ, (complexify counterA).charpoly.eval z = 0 → z.re < 0) ∧
    (∀ i, (1/2 : ℝ) ≤ counterGamma i) ∧
    (stepE 2 counterGamma counterA).det ≠ 0 ∧
    ¬ MatrixSchurStable (stepMatrix 2 counterGamma counterA) := by
  refine ⟨counterA_hurwitz, ?_, ?_, ?_⟩
  · intro i
    fin_cases i <;> norm_num [counterGamma]
  · rw [counterE_det]
    norm_num
  · intro h
    obtain ⟨hz, hn⟩ := counter_unstable_root
    exact (not_lt_of_ge hn.le) (h _ hz)

end C2.NGamma

end

/- ===== C2.NGammaDiagonalRealization ===== -/

/-! The diagonal-Lyapunov proposition uses precisely the matrices E and Ad of
 the general realization theorem. -/
noncomputable section
namespace C2.NGamma
open Matrix
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

lemma diagonal_one_sub (γ : ι → ℝ) :
    diagonal (fun i => 1-γ i) = 1-diagonal γ := by
  ext i j
  by_cases hij : i = j
  · subst j
    simp
  · simp [Matrix.diagonal_apply_ne _ hij, Matrix.one_apply_ne hij, hij]

lemma stepF_eq_realizationF (T : ℝ) (γ : ι → ℝ) (A : Matrix ι ι ℝ) :
    stepF T γ A = Realization.F T (diagonal γ) A := by
  rw [stepF, diagonal_one_sub]
  rfl

lemma stepMatrix_eq_realizationAd (T : ℝ) (γ : ι → ℝ) (A : Matrix ι ι ℝ) :
    stepMatrix T γ A = Realization.Ad T (diagonal γ) A := by
  rw [stepMatrix, stepF_eq_realizationF]
  rfl

/-- Literal matrix realization form of the manuscript proposition, including
 decay of every state trajectory. -/
theorem realization_diagonal_stability {p γ : ι → ℝ} {A : Matrix ι ι ℝ} {T : ℝ}
    (hp : (diagonal p).PosDef) (hγ : ∀ i, 1/2 ≤ γ i) (hT : 0 < T)
    (hL : (-(A.transpose * diagonal p + diagonal p * A)).PosDef) :
    (Realization.E T (diagonal γ) A).det ≠ 0 ∧
      MatrixSchurStable (Realization.Ad T (diagonal γ) A) ∧
      Realization.AsymptoticallyStable (Realization.Ad T (diagonal γ) A) := by
  obtain ⟨hE,hS⟩ := diagonal_stability_of_lyapunov hp hγ hT hL
  rw [stepMatrix_eq_realizationAd] at hS
  exact ⟨hE,hS,Realization.asymptoticallyStable_of_schur _ hS⟩

end C2.NGamma

end

/- ===== C2.NGammaMultiplicity ===== -/

noncomputable section
open scoped BigOperators
open Polynomial

namespace C2.NGamma.PolynomialModel

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def linearProduct (s : Finset ι) (a : ι → ℂ) : Polynomial ℂ :=
  ∏ i ∈ s, (1 - C (a i) * X)

theorem linearProduct_eval_zero (s : Finset ι) (a : ι → ℂ) :
    (linearProduct s a).eval 0 = 1 := by
  simp [linearProduct, eval_prod]

theorem linearProduct_derivative_zero (s : Finset ι) (a : ι → ℂ) :
    (linearProduct s a).derivative.eval 0 = -∑ i ∈ s, a i := by
  induction s using Finset.induction_on with
  | empty => simp [linearProduct]
  | @insert i s hi ih =>
    have he : linearProduct (insert i s) a = (1 - C (a i) * X) * linearProduct s a := by
      simp [linearProduct, hi]
    rw [he, derivative_mul]
    simp only [eval_add, eval_mul, derivative_sub, derivative_one, derivative_mul,
      derivative_C, zero_mul, derivative_X, mul_one, zero_add, zero_sub, eval_neg,
      eval_C, linearProduct_eval_zero, mul_one, eval_sub, eval_one, eval_X,
      mul_zero, sub_zero, one_mul, ih, Finset.sum_insert hi]
    ring

theorem linearProduct_second_derivative_zero (s : Finset ι) (a : ι → ℂ) :
    (linearProduct s a).derivative.derivative.eval 0 =
      (∑ i ∈ s, a i) ^ 2 - ∑ i ∈ s, (a i) ^ 2 := by
  induction s using Finset.induction_on with
  | empty => simp [linearProduct]
  | @insert i s hi ih =>
    have he : linearProduct (insert i s) a = (1 - C (a i) * X) * linearProduct s a := by
      simp [linearProduct, hi]
    rw [he, derivative_mul, derivative_add, derivative_mul, derivative_mul]
    simp only [eval_add, eval_mul, derivative_sub, derivative_one, derivative_mul,
      derivative_C, zero_mul, derivative_X, mul_one, zero_add, zero_sub, eval_neg,
      eval_C, linearProduct_eval_zero, mul_one, eval_sub, eval_one, eval_X,
      mul_zero, sub_zero, one_mul, derivative_neg, eval_zero,
      linearProduct_derivative_zero, ih, Finset.sum_insert hi]
    ring

def endpointAlpha (r x : ℝ) : ℝ := (1 + r * (1 + x) / 2) / (2 + r * x)
def endpointBeta (x : ℝ) : ℝ := (1 + x) / (2 * x)

theorem endpointAlpha_gt_half {r x : ℝ} (hr : 0 < r) (hx : 0 < x) :
    1 / 2 < endpointAlpha r x := by
  unfold endpointAlpha
  apply (lt_div_iff₀ (by positivity : 0 < 2 + r*x)).2
  linarith

theorem endpointBeta_gt_half {x : ℝ} (hx : 0 < x) :
    1 / 2 < endpointBeta x := by
  unfold endpointBeta
  apply (lt_div_iff₀ (by positivity : 0 < 2*x)).2
  linarith

theorem endpoint_difference {r x : ℝ} (hr : 0 < r) (hx : 0 < x) :
    endpointBeta x - endpointAlpha r x = 1 / (x * (2 + r*x)) := by
  have hx0 := ne_of_gt hx
  have ha0 : 2+r*x ≠ 0 := by positivity
  unfold endpointBeta endpointAlpha
  field_simp
  ring

def normalizedBoundary (a b : ι → ℂ) : Polynomial ℂ :=
  (X - 1) * linearProduct Finset.univ a + linearProduct Finset.univ b

theorem normalizedBoundary_eval_zero (a b : ι → ℂ) :
    (normalizedBoundary a b).eval 0 = 0 := by
  simp [normalizedBoundary, linearProduct_eval_zero]

theorem normalizedBoundary_derivative_zero (a b : ι → ℂ) :
    (normalizedBoundary a b).derivative.eval 0 = 1 + ∑ i, a i - ∑ i, b i := by
  simp [normalizedBoundary, derivative_mul, linearProduct_eval_zero,
    linearProduct_derivative_zero]
  ring

theorem normalizedBoundary_second_derivative_zero (a b : ι → ℂ)
    (hs : ∑ i, (b i - a i) = 1) :
    (normalizedBoundary a b).derivative.derivative.eval 0 =
      -∑ i, (b i - a i) * (b i + a i - 1) := by
  have hs' : (∑ i, b i) - ∑ i, a i = 1 := by
    simpa only [Finset.sum_sub_distrib] using hs
  have hid : ∑ i, (b i - a i) * (b i + a i - 1) =
      (∑ i, (b i)^2) - (∑ i, (a i)^2) - (∑ i, b i) + ∑ i, a i := by
    simp_rw [show ∀ i, (b i-a i)*(b i+a i-1) = (b i)^2-(a i)^2-b i+a i by intro i; ring]
    simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib]
  rw [hid]
  simp only [normalizedBoundary, derivative_add, derivative_mul, derivative_sub,
    derivative_X, derivative_one, sub_zero, derivative_zero, derivative_add,
    derivative_one, zero_mul, mul_one, one_mul, zero_add, eval_add, eval_mul,
    eval_sub, eval_X, eval_one, zero_sub, linearProduct_derivative_zero,
    linearProduct_second_derivative_zero]
  have hb : (∑ i, b i) = (∑ i, a i) + 1 := by linear_combination hs'
  rw [hb]
  ring

theorem q_comp_shift {x : ℝ} (hx : 0 < x) :
    (q x).comp (X - 1) = C (-(x : ℂ)) * (1 - C (endpointBeta x : ℂ) * X) := by
  apply Polynomial.funext
  intro z
  simp only [eval_comp, eval_sub, eval_X, eval_one, eval_mul, eval_C]
  rw [q_eval]
  unfold endpointBeta
  push_cast
  have hn : (x : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hx
  field_simp
  ring

theorem factor_comp_shift {r x : ℝ} (hr : 0 < r) (hx : 0 < x) :
    (factor r x).comp (X - 1) =
      C (-(2 + (r : ℂ)*x)) * (1 - C (endpointAlpha r x : ℂ) * X) := by
  apply Polynomial.funext
  intro z
  simp only [eval_comp, eval_sub, eval_X, eval_one, eval_mul, eval_C]
  rw [factor_eval, q_eval]
  unfold endpointAlpha
  push_cast
  have hn : (2 + (r : ℂ)*x) ≠ 0 := by
    exact_mod_cast (ne_of_gt (by positivity : 0 < 2 + r*x))
  field_simp
  ring

theorem endpoint_product_identity {r x : ι → ℝ} (hx : ∀ i, 0 < x i) :
    ((∏ i, (r i + 2 / x i) : ℝ) : ℂ) * ∏ i, (x i : ℂ) =
      ∏ i, (2 + (r i : ℂ) * x i) := by
  push_cast
  rw [← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro i _
  have hn : (x i : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt (hx i)
  field_simp
  ring

theorem characteristic_comp_shift {r x : ι → ℝ} (hr : ∀ i, 0 < r i)
    (hx : ∀ i, 0 < x i) :
    (characteristic r x 1 (∏ i, (r i + 2 / x i))).comp (X - 1) =
      C ((-1 : ℂ) ^ Fintype.card ι * ∏ i, (2 + (r i : ℂ) * x i)) *
      normalizedBoundary (fun i => (endpointAlpha (r i) (x i) : ℂ))
        (fun i => (endpointBeta (x i) : ℂ)) := by
  apply Polynomial.funext
  intro z
  have hD (i : ι) := congrArg (Polynomial.eval z) (factor_comp_shift (hr i) (hx i))
  have hQ (i : ι) := congrArg (Polynomial.eval z) (q_comp_shift (hx i))
  simp only [eval_comp, eval_sub, eval_X, eval_one, eval_mul, eval_C] at hD hQ
  simp only [eval_comp, eval_sub, eval_X, eval_one, characteristic,
    eval_add, eval_mul, eval_pow, pow_one, eval_prod, eval_C]
  simp_rw [hD, hQ]
  simp only [Finset.prod_mul_distrib, Finset.prod_neg, Finset.card_univ]
  simp only [normalizedBoundary, eval_mul, eval_add, eval_sub, eval_X,
    eval_one, eval_C, linearProduct, eval_prod]
  have hp := endpoint_product_identity hx (r := r)
  linear_combination
    (-1 : ℂ)^Fintype.card ι *
      (∏ i, (1 - (endpointBeta (x i) : ℂ) * z)) * hp

theorem normalizedBoundary_second_derivative_ne_zero
    [Nonempty ι] {r x : ι → ℝ} (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i)
    (hS : ∑ i, 1 / (x i * (2 + r i * x i)) = 1) :
    (normalizedBoundary (fun i => (endpointAlpha (r i) (x i) : ℂ))
      (fun i => (endpointBeta (x i) : ℂ))).derivative.derivative.eval 0 ≠ 0 := by
  have hsR : ∑ i, (endpointBeta (x i) - endpointAlpha (r i) (x i)) = 1 := by
    simpa only [endpoint_difference (hr _) (hx _)] using hS
  have hsC : ∑ i, ((endpointBeta (x i) : ℂ) - endpointAlpha (r i) (x i)) = 1 := by
    exact_mod_cast hsR
  rw [normalizedBoundary_second_derivative_zero _ _ hsC]
  have hp : 0 < ∑ i, (endpointBeta (x i) - endpointAlpha (r i) (x i)) *
      (endpointBeta (x i) + endpointAlpha (r i) (x i) - 1) := by
    apply Finset.sum_pos
    · intro i _
      apply mul_pos
      · rw [endpoint_difference (hr i) (hx i)]
        have hri := hr i
        have hxi := hx i
        positivity
      · have ha := endpointAlpha_gt_half (hr i) (hx i)
        have hb := endpointBeta_gt_half (hx i)
        linarith
    · exact Finset.univ_nonempty
  have hne := ne_of_gt hp
  simpa only [neg_ne_zero] using (show
    (∑ i, ((endpointBeta (x i) : ℂ) - endpointAlpha (r i) (x i)) *
      ((endpointBeta (x i) : ℂ) + endpointAlpha (r i) (x i) - 1)) ≠ 0 by exact_mod_cast hne)

/-- At a positive one-delay endpoint with saturated resource, the characteristic
polynomial has a root of multiplicity exactly two at -1. -/
theorem endpoint_root_multiplicity_two
    [Nonempty ι] {r x : ι → ℝ} (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i)
    (hS : ∑ i, 1 / (x i * (2 + r i * x i)) = 1) :
    (characteristic r x 1 (∏ i, (r i + 2 / x i))).rootMultiplicity (-1) = 2 := by
  classical
  let p := characteristic r x 1 (∏ i, (r i + 2 / x i))
  let a : ι → ℂ := fun i => (endpointAlpha (r i) (x i) : ℂ)
  let b : ι → ℂ := fun i => (endpointBeta (x i) : ℂ)
  let c : ℂ := (-1 : ℂ) ^ Fintype.card ι * ∏ i, (2 + (r i : ℂ) * x i)
  have hcomp : p.comp (X - 1) = C c * normalizedBoundary a b :=
    characteristic_comp_shift hr hx
  have hsR : ∑ i, (endpointBeta (x i) - endpointAlpha (r i) (x i)) = 1 := by
    simpa only [endpoint_difference (hr _) (hx _)] using hS
  have hsC : ∑ i, (b i - a i) = 1 := by
    dsimp [a, b]
    exact_mod_cast hsR
  have hsum : (∑ i, b i) - ∑ i, a i = 1 := by
    simpa only [Finset.sum_sub_distrib] using hsC
  have hN1 : (normalizedBoundary a b).derivative.eval 0 = 0 := by
    rw [normalizedBoundary_derivative_zero]
    linear_combination -hsum
  have hN2 : (normalizedBoundary a b).derivative.derivative.eval 0 ≠ 0 :=
    normalizedBoundary_second_derivative_ne_zero hr hx hS
  have hc : c ≠ 0 := by
    apply mul_ne_zero (pow_ne_zero _ (by norm_num))
    apply Finset.prod_ne_zero_iff.mpr
    intro i _
    have hri := hr i
    have hxi := hx i
    exact_mod_cast (ne_of_gt (by positivity : 0 < 2 + r i * x i))
  have hp1 : p.derivative.eval (-1) = 0 := by
    have hh := congrArg (fun q : Polynomial ℂ => q.derivative.eval 0) hcomp
    simpa [derivative_comp, derivative_mul, hN1] using hh
  have hp2 : p.derivative.derivative.eval (-1) ≠ 0 := by
    have hh := congrArg (fun q : Polynomial ℂ => q.derivative.derivative.eval 0) hcomp
    have hh' : p.derivative.derivative.eval (-1) =
        c * (normalizedBoundary a b).derivative.derivative.eval 0 := by
      simpa [derivative_comp, derivative_mul] using hh
    rw [hh']
    exact mul_ne_zero hc hN2
  have hp0 : p.eval (-1) = 0 := endpoint_is_root (fun i => ne_of_gt (hx i))
  have hpne : p ≠ 0 := by
    intro h
    apply hp2
    simp [h]
  have hlo : 1 < p.rootMultiplicity (-1) :=
    (Polynomial.one_lt_rootMultiplicity_iff_isRoot hpne).2 ⟨hp0, hp1⟩
  have hhi : p.rootMultiplicity (-1) ≤ 2 := by
    by_contra h
    have hh := Polynomial.isRoot_iterate_derivative_of_lt_rootMultiplicity
      (p := p) (t := (-1 : ℂ)) (n := 2) (by omega : 2 < p.rootMultiplicity (-1))
    apply hp2
    simpa [Polynomial.IsRoot, Function.iterate_succ_apply] using hh
  change p.rootMultiplicity (-1) = 2
  omega

end C2.NGamma.PolynomialModel

end

/- ===== C2.NGammaEndpointStability ===== -/

/-! Closed-disk stability at a limiting gain and the absence of unit roots
other than -1 at the positive endpoint. No continuity of an enumerated list
of polynomial roots is assumed. -/
noncomputable section
open scoped BigOperators Topology
open Polynomial Filter
namespace C2.NGamma.PolynomialModel
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Stable characteristic polynomials below B cannot acquire an exterior root
at B. The fixed nonzero leading coefficient is essential to this argument. -/
theorem roots_closed_disk_of_stable_below {r x : ι → ℝ} {d : ℕ} {B : ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, -1 ≤ x i) (hd : 1 ≤ d) (hB : 0 < B)
    (hstable : ∀ b : ℝ, 0 ≤ b → b < B → SchurStable (characteristic r x d b))
    {z : ℂ} (hz : (characteristic r x d B).eval z = 0) : ‖z‖ ≤ 1 := by
  by_contra! hout
  let lead : ℂ := ∏ i, ((1+r i*(1+x i)/2 : ℝ) : ℂ)
  let L : ℝ := ‖lead‖ * (‖z‖-1)^(Fintype.card ι+d)
  have hlead : lead ≠ 0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro i _
    exact_mod_cast ne_of_gt (cube_factor_leading_pos (hr i) (hx i))
  have hL : 0 < L := mul_pos (norm_pos_iff.mpr hlead) (pow_pos (by linarith) _)
  let seq : ℕ → ℝ := fun n => B - 1 / ((n : ℝ)+1)
  have hseq : Tendsto seq atTop (𝓝 B) := by
    simpa [seq] using (tendsto_const_nhds.sub tendsto_one_div_add_atTop_nhds_zero_nat)
  have hpos : ∀ᶠ n in atTop, 0 < seq n :=
    hseq.eventually (isOpen_Ioi.mem_nhds hB)
  have hbound : ∀ᶠ n in atTop, L ≤ ‖(characteristic r x d (seq n)).eval z‖ := by
    filter_upwards [hpos] with n hn
    have hlt : seq n < B := by
      dsimp [seq]
      have hden : 0 < (n : ℝ)+1 := by positivity
      linarith [one_div_pos.mpr hden]
    have hs := schur_eval_norm_lower_bound (hstable (seq n) hn.le hlt) hout
    obtain ⟨hdeg,hlc⟩ := cube_characteristic_degree_leading hr hx hd (seq n)
    simpa only [hdeg,hlc,L,lead] using hs
  have hc : Continuous (fun b : ℝ => ‖(characteristic r x d b).eval z‖) := by
    simp only [characteristic, eval_add, eval_mul, eval_pow, eval_X, eval_C, eval_prod]
    fun_prop
  have hlim := hc.continuousAt.tendsto.comp hseq
  rw [hz, norm_zero] at hlim
  have hh := ge_of_tendsto hlim hbound
  linarith

/-- The exact complementary norm identity on the unit circle. -/
theorem endpoint_factor_norm_gap {r x : ℝ} (hx : x ≠ 0) {z : ℂ} (hz : ‖z‖ = 1) :
    (r+2/x)^2 * ‖(q x).eval z‖^2 - ‖(factor r x).eval z‖^2 =
      (1+r*x)/x^2 * ‖z+1‖^2 := by
  have hid : (r+2/x)^2 * ‖(q x).eval z‖^2 - ‖(factor r x).eval z‖^2 =
      (1+r*x)/x^2 * ‖z+1‖^2 + (r+2/x)*(‖z‖^2-1) := by
    simp only [Complex.sq_norm, Complex.normSq_apply, factor_eval, q_eval]
    simp [Complex.add_re, Complex.add_im, Complex.sub_re, Complex.sub_im,
      Complex.mul_re, Complex.mul_im, Complex.div_re, Complex.div_im,
      Complex.normSq_apply]
    field_simp
    ring
  rw [hid, hz]
  ring

/-- Every finite unit-circle point has gain strictly below the endpoint. -/
theorem factor_norm_lt_endpoint_mul_q {r x : ℝ} (hr : 0 < r) (hx : 0 < x)
    {z : ℂ} (hz : ‖z‖ = 1) (hz1 : z ≠ -1) :
    ‖(factor r x).eval z‖ < (r+2/x)*‖(q x).eval z‖ := by
  have hg := endpoint_factor_norm_gap (r := r) (ne_of_gt hx) hz
  have hcoeff : 0 < (1+r*x)/x^2 := by positivity
  have hn : 0 < ‖z+1‖ := norm_pos_iff.mpr (by simpa [add_eq_zero_iff_eq_neg] using hz1)
  have hp : 0 < (1+r*x)/x^2*‖z+1‖^2 := mul_pos hcoeff (sq_pos_of_pos hn)
  have hb : 0 < r+2/x := by positivity
  nlinarith [norm_nonneg ((factor r x).eval z),
    mul_nonneg hb.le (norm_nonneg ((q x).eval z))]

/-- At the endpoint gain, -1 is the only possible unit-circle root. -/
theorem endpoint_unit_root_eq_neg_one [Nonempty ι] {r x : ι → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) (d : ℕ) {z : ℂ}
    (hz : ‖z‖ = 1)
    (hroot : (characteristic r x d (∏ i, (r i+2/x i))).eval z = 0) : z = -1 := by
  by_contra hz1
  have hf (i : ι) : 0 < ‖(factor (r i) (x i)).eval z‖ := by
    apply norm_pos_iff.mpr
    intro he
    have hs := factor_schur (hr i) (hx i).le z he
    linarith
  have hprod : (∏ i, ‖(factor (r i) (x i)).eval z‖) <
      (∏ i, (r i+2/x i)) * ∏ i, ‖(q (x i)).eval z‖ := by
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_lt_prod_of_nonempty (fun i _ => hf i)
      (fun i _ => factor_norm_lt_endpoint_mul_q (hr i) (hx i) hz hz1) Finset.univ_nonempty
  have hb : 0 < ∏ i, (r i+2/x i) :=
    Finset.prod_pos (fun i _ => add_pos (hr i) (div_pos (by norm_num) (hx i)))
  have he : z^d * ∏ i, (factor (r i) (x i)).eval z =
      -((∏ i, (r i+2/x i) : ℝ) * ∏ i, (q (x i)).eval z) := by
    apply eq_neg_of_add_eq_zero_left
    simpa only [characteristic, eval_add, eval_mul, eval_pow, eval_X, eval_C, eval_prod] using hroot
  have hh := congrArg norm he
  simp only [norm_mul, norm_pow, norm_prod, norm_neg, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos hb, hz, one_pow, one_mul] at hh
  have hbi (i : ι) : 0 < r i+2/x i := add_pos (hr i) (div_pos (by norm_num) (hx i))
  simp only [abs_of_pos (hbi _)] at hh
  linarith

/-- Conditional closure step: once the exact open stable interval is proved,
all endpoint roots other than -1 remain strictly inside the disk. -/
theorem endpoint_other_roots_inside_of_stable_below [Nonempty ι] {r x : ι → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i)
    (hstable : ∀ b : ℝ, 0 ≤ b → b < ∏ i, (r i+2/x i) →
      SchurStable (characteristic r x 1 b))
    {z : ℂ} (hz : (characteristic r x 1 (∏ i, (r i+2/x i))).eval z = 0)
    (hz1 : z ≠ -1) : ‖z‖ < 1 := by
  have hB : 0 < ∏ i, (r i+2/x i) :=
    Finset.prod_pos (fun i _ => add_pos (hr i) (div_pos (by norm_num) (hx i)))
  have hle := roots_closed_disk_of_stable_below hr (fun i => by linarith [hx i])
    (by norm_num : 1 ≤ (1:ℕ)) hB hstable hz
  exact lt_of_le_of_ne hle (fun he => hz1 (endpoint_unit_root_eq_neg_one hr hx 1 he hz))

end C2.NGamma.PolynomialModel

end

/- ===== C2.NGammaEndpointFinal ===== -/

/-! Final endpoint spectral conclusions. The open-interval stability hypothesis
of the closure lemma is discharged by the proved exact gain-interval theorem. -/
noncomputable section
open scoped BigOperators
namespace C2.NGamma.PolynomialModel

/-- At every feasible positive one-delay endpoint, all roots other than -1
are strictly inside the unit disk. -/
theorem endpoint_other_roots_inside {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) (hx1 : ∀ i, x i ≤ 1)
    (hS : Phase.endpointSum r x ≤ 1)
    {z : ℂ} (hz : (characteristic r x 1 (∏ i, (r i+2/x i))).eval z = 0)
    (hz1 : z ≠ -1) : ‖z‖ < 1 := by
  letI : Nonempty (Fin n) := ⟨⟨0,hn⟩⟩
  apply endpoint_other_roots_inside_of_stable_below hr hx
    (fun b hb hbound => Cayley.single_sample_endpoint_stable hn hr hx hx1 hS hb hbound) hz hz1

/-- Complete spectral clause for the saturated endpoint: exactly a double
root at -1, with every remaining root strictly inside the disk. All premises
are the physical design and resource assumptions from the manuscript. -/
theorem saturated_endpoint_spectrum {n : ℕ} (hn : 0 < n) {r x : Fin n → ℝ}
    (hr : ∀ i, 0 < r i) (hx : ∀ i, 0 < x i) (hx1 : ∀ i, x i ≤ 1)
    (hS : ∑ i, 1 / (x i * (2+r i*x i)) = 1) :
    (characteristic r x 1 (∏ i, (r i+2/x i))).rootMultiplicity (-1) = 2 ∧
      ∀ z : ℂ, (characteristic r x 1 (∏ i, (r i+2/x i))).eval z = 0 →
        z ≠ -1 → ‖z‖ < 1 := by
  letI : Nonempty (Fin n) := ⟨⟨0,hn⟩⟩
  refine ⟨endpoint_root_multiplicity_two hr hx hS, ?_⟩
  intro z hz hz1
  apply endpoint_other_roots_inside hn hr hx hx1 _ hz hz1
  exact le_of_eq hS

end C2.NGamma.PolynomialModel

end

/- ===== C2.NGammaEqual ===== -/

/-!
# Identical positive factors: exact closed-form consequences

These results prove the algebraic and trigonometric specializations used in
`cor:ngamma-identical-global`.  Global maximality is not defined or assumed in
this module: it must be supplied by the arbitrary-order optimization theorem.
-/

noncomputable section
namespace C2.NGammaEqual

def endpointCoordinate (m r : ℝ) : ℝ := m / (1 + Real.sqrt (1 + m * r))
def endpointGamma (m r : ℝ) : ℝ := (1 + endpointCoordinate m r) / 2
def endpointGain (n : ℕ) (r : ℝ) : ℝ :=
  (r + 2 / (n : ℝ) * (1 + Real.sqrt (1 + (n : ℝ) * r))) ^ n

lemma endpointCoordinate_pos {m r : ℝ} (hm : 0 < m) :
    0 < endpointCoordinate m r := by
  unfold endpointCoordinate
  exact div_pos hm (by positivity)

lemma endpointCoordinate_resource {m r : ℝ} (hm : 0 ≤ m) (hr : 0 ≤ r) :
    endpointCoordinate m r * (2 + r * endpointCoordinate m r) = m := by
  have hs := Real.sq_sqrt (show 0 ≤ 1 + m * r by positivity)
  have hd : 1 + Real.sqrt (1 + m * r) ≠ 0 := by positivity
  have hidentity : 2 * (1 + Real.sqrt (1 + m * r)) + r * m =
      (1 + Real.sqrt (1 + m * r)) ^ 2 := by nlinarith
  unfold endpointCoordinate
  calc
    m / (1 + Real.sqrt (1 + m * r)) *
        (2 + r * (m / (1 + Real.sqrt (1 + m * r)))) =
      m * (2 * (1 + Real.sqrt (1 + m * r)) + r * m) /
        (1 + Real.sqrt (1 + m * r)) ^ 2 := by field_simp [hd] <;> ring_nf <;> simp
    _ = m := by rw [hidentity]; exact mul_div_cancel_right₀ m (pow_ne_zero _ hd)

lemma endpointCoordinate_le_one_iff {m r : ℝ} (hm : 1 ≤ m) (hr : 0 < r) :
    endpointCoordinate m r ≤ 1 ↔ m - 2 ≤ r := by
  have hp : 0 < m := by linarith
  have hx : 0 < endpointCoordinate m r := endpointCoordinate_pos hp
  have hq := endpointCoordinate_resource (le_of_lt hp) (le_of_lt hr)
  constructor
  · intro hu
    have hsq : endpointCoordinate m r ^ 2 ≤ 1 := by nlinarith
    have hh := mul_le_mul_of_nonneg_left hsq hr.le
    nlinarith [hh]
  · intro hbound
    by_contra hh
    have hg : 1 < endpointCoordinate m r := lt_of_not_ge hh
    have hprod : 2 + r < endpointCoordinate m r *
        (2 + r * endpointCoordinate m r) := by
      have hsq : 1 < endpointCoordinate m r ^ 2 := by nlinarith
      have hh := mul_lt_mul_of_pos_left hsq hr
      nlinarith [hh]
    linarith

lemma endpointCoordinate_eq_one_iff {m r : ℝ} (hm : 1 ≤ m) (hr : 0 < r) :
    endpointCoordinate m r = 1 ↔ r = m - 2 := by
  have hp : 0 < m := by linarith
  have hx := endpointCoordinate_pos (r := r) hp
  have hq := endpointCoordinate_resource hp.le hr.le
  constructor
  · intro h; rw [h] at hq; linarith
  · intro h
    have hu := (endpointCoordinate_le_one_iff hm hr).2 (by linarith)
    have hf : (endpointCoordinate m r - 1) *
        (r * (endpointCoordinate m r + 1) + 2) = 0 := by nlinarith [hq]
    have hpos : 0 < r * (endpointCoordinate m r + 1) + 2 := by positivity
    have hz := (mul_eq_zero.mp hf).resolve_right (ne_of_gt hpos)
    linarith

lemma endpointGamma_admissible_iff {m r : ℝ} (hm : 1 ≤ m) (hr : 0 < r) :
    (1 / 2 ≤ endpointGamma m r ∧ endpointGamma m r ≤ 1) ↔ m - 2 ≤ r := by
  have hx := endpointCoordinate_pos (r := r) (show 0 < m by linarith)
  unfold endpointGamma
  rw [← endpointCoordinate_le_one_iff hm hr]
  constructor
  · rintro ⟨_, h⟩; linarith
  · intro h; constructor <;> linarith

lemma endpointGain_factor_identity {n : ℕ} (hn : 0 < n) (r : ℝ) :
    r + 2 / endpointCoordinate (n : ℝ) r =
      r + 2 / (n : ℝ) * (1 + Real.sqrt (1 + (n : ℝ) * r)) := by
  have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hn
  have hd : 1 + Real.sqrt (1 + (n : ℝ) * r) ≠ 0 := by positivity
  unfold endpointCoordinate
  field_simp
  <;> ring

lemma equal_resource_sum {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 ≤ r) :
    (∑ _j : Fin n, 1 / (endpointCoordinate (n : ℝ) r *
      (2 + r * endpointCoordinate (n : ℝ) r))) = 1 := by
  rw [endpointCoordinate_resource (by positivity) hr]
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hn
  field_simp

lemma endpoint_boundary_agreement {n : ℕ} (hn : 3 ≤ n) :
    endpointGamma (n : ℝ) ((n : ℝ) - 2) = 1 ∧
    endpointGain n ((n : ℝ) - 2) = (n : ℝ) ^ n := by
  have hnR : 3 ≤ (n : ℝ) := by exact_mod_cast hn
  have hr : 0 < (n : ℝ) - 2 := by linarith
  have hx := (endpointCoordinate_eq_one_iff (by linarith : 1 ≤ (n : ℝ)) hr).2 rfl
  constructor
  · unfold endpointGamma; rw [hx]; norm_num
  · unfold endpointGain
    rw [← endpointGain_factor_identity (by omega : 0 < n), hx]
    congr 1
    ring

lemma sin_three_mul_factor (φ : ℝ) :
    Real.sin (3 * φ) = Real.sin φ * (4 * Real.cos φ ^ 2 - 1) := by
  rw [Real.sin_three_mul]
  have h := Real.sin_sq_add_cos_sq φ
  have hm := congrArg (fun y : ℝ => Real.sin φ * y) h
  dsimp at hm
  nlinarith [hm]

lemma sin_four_mul_factor (φ : ℝ) :
    Real.sin (4 * φ) = 4 * Real.sin φ * Real.cos φ * (2 * Real.cos φ ^ 2 - 1) := by
  have hfour : (4 : ℝ) * φ = 2 * (2 * φ) := by ring
  rw [hfour, Real.sin_two_mul, Real.sin_two_mul, Real.cos_two_mul]
  ring

/-- Direct reduction of the n=3 finite-frequency gain from its angle equation. -/
lemma order_three_gain {r φ : ℝ} (hs : Real.sin φ ≠ 0)
    (hangle : r + 1 = Real.sin (2 * φ) / Real.sin φ) :
    (Real.sin (3 * φ) / Real.sin φ) ^ 3 = (r * (r + 2)) ^ 3 := by
  have hc : r + 1 = 2 * Real.cos φ := by
    rw [Real.sin_two_mul] at hangle
    have hcancel : 2 * Real.sin φ * Real.cos φ / Real.sin φ = 2 * Real.cos φ := by
      field_simp
      ring
    rw [hcancel] at hangle
    exact hangle
  rw [sin_three_mul_factor]
  have hratio : Real.sin φ * (4 * Real.cos φ ^ 2 - 1) / Real.sin φ =
      r * (r + 2) := by
    rw [mul_div_cancel_left₀ _ hs]
    have hc2 := congrArg (fun y : ℝ => y ^ 2) hc
    dsimp at hc2
    nlinarith [hc2]
  rw [hratio]

/-- Direct reduction of the n=4 finite-frequency gain from its angle equation. -/
lemma order_four_gain {r φ : ℝ} (hs : Real.sin φ ≠ 0)
    (hangle : r + 1 = Real.sin (3 * φ) / Real.sin φ) :
    (Real.sin (4 * φ) / Real.sin φ) ^ 4 = r ^ 4 * (r + 2) ^ 2 := by
  rw [sin_three_mul_factor, mul_div_cancel_left₀ _ hs] at hangle
  have hc : 4 * Real.cos φ ^ 2 = r + 2 := by linarith
  rw [sin_four_mul_factor]
  have hratio : (4 * Real.sin φ * Real.cos φ * (2 * Real.cos φ ^ 2 - 1)) /
      Real.sin φ = 2 * r * Real.cos φ := by
    calc
      _ = 4 * Real.cos φ * (2 * Real.cos φ ^ 2 - 1) := by field_simp; ring
      _ = 2 * r * Real.cos φ := by nlinarith [congrArg (fun y : ℝ => Real.cos φ * y) hangle]
  rw [hratio]
  calc
    (2 * r * Real.cos φ) ^ 4 = r ^ 4 * (4 * Real.cos φ ^ 2) ^ 2 := by ring
    _ = r ^ 4 * (r + 2) ^ 2 := by rw [hc]

lemma order_three_example : ((1 / 10 : ℝ) * (1 / 10 + 2)) ^ 3 = 9261 / 1000000 := by
  norm_num

end C2.NGammaEqual

end

/- ===== C2.NGammaEqualAnalytic ===== -/

/-! Exact uniqueness argument for the identical-factor finite-angle equation. -/
noncomputable section
namespace C2.NGammaEqual

/-- The function t cot t used in the paper's monotonicity argument. -/
def weightedCot (t : ℝ) : ℝ := t * Real.cos t / Real.sin t

lemma sin_mul_cos_lt {t : ℝ} (ht : 0 < t) :
    Real.sin t * Real.cos t < t := by
  have h := Real.sin_lt (show 0 < 2 * t by linarith)
  rw [Real.sin_two_mul] at h
  linarith

lemma weightedCot_hasDerivAt {t : ℝ} (ht : Real.sin t ≠ 0) :
    HasDerivAt weightedCot
      ((Real.sin t * Real.cos t - t) / Real.sin t ^ 2) t := by
  have h := ((hasDerivAt_id t).mul (Real.hasDerivAt_cos t)).div
    (Real.hasDerivAt_sin t) ht
  have hs := Real.sin_sq_add_cos_sq t
  have hmul := congrArg (fun y : ℝ => t * y) hs
  convert h using 1
  congr 1
  dsimp at hmul
  dsimp only [id]
  nlinarith [hmul]

lemma weightedCot_strictAntiOn : StrictAntiOn weightedCot (Set.Ioo 0 Real.pi) := by
  apply strictAntiOn_of_deriv_neg (convex_Ioo 0 Real.pi)
  · intro t ht
    exact (weightedCot_hasDerivAt (ne_of_gt (Real.sin_pos_of_pos_of_lt_pi ht.1 ht.2))).continuousAt.continuousWithinAt
  · intro t ht
    have ht' : t ∈ Set.Ioo 0 Real.pi := by simpa only [interior_Ioo] using ht
    have hs := Real.sin_pos_of_pos_of_lt_pi ht'.1 ht'.2
    rw [(weightedCot_hasDerivAt (ne_of_gt hs)).deriv]
    exact div_neg_of_neg_of_pos (sub_neg.mpr (sin_mul_cos_lt ht'.1)) (sq_pos_of_pos hs)

lemma sine_ratio_hasDerivAt (k t : ℝ) (ht : Real.sin t ≠ 0) :
    HasDerivAt (fun y : ℝ => Real.sin (k * y) / Real.sin y)
      ((k * Real.cos (k * t) * Real.sin t -
        Real.sin (k * t) * Real.cos t) / Real.sin t ^ 2) t := by
  convert ((Real.hasDerivAt_sin (k * t)).comp t ((hasDerivAt_id t).const_mul k)).div
    (Real.hasDerivAt_sin t) ht using 1 <;> simp only [Function.comp_apply] <;> ring

lemma sine_ratio_deriv_neg {k t : ℝ} (hk : 1 < k)
    (ht : 0 < t) (hkt : k * t < Real.pi) :
    deriv (fun y : ℝ => Real.sin (k * y) / Real.sin y) t < 0 := by
  have hktpos : 0 < k * t := mul_pos (by linarith) ht
  have htkt : t < k * t := by nlinarith
  have htpi : t < Real.pi := lt_trans htkt hkt
  have hs := Real.sin_pos_of_pos_of_lt_pi ht htpi
  have hks := Real.sin_pos_of_pos_of_lt_pi hktpos hkt
  have hcomp := weightedCot_strictAntiOn ⟨ht, htpi⟩ ⟨hktpos, hkt⟩ htkt
  unfold weightedCot at hcomp
  have hcross := (div_lt_div_iff₀ hks hs).mp hcomp
  have hmul : t * (k * Real.cos (k * t) * Real.sin t -
      Real.sin (k * t) * Real.cos t) < t * 0 := by nlinarith [hcross]
  have hnum := (mul_lt_mul_left ht).mp hmul
  rw [(sine_ratio_hasDerivAt k t (ne_of_gt hs)).deriv]
  exact div_neg_of_neg_of_pos hnum (sq_pos_of_pos hs)

lemma sine_ratio_strictAntiOn {k : ℝ} (hk : 1 < k) :
    StrictAntiOn (fun t : ℝ => Real.sin (k * t) / Real.sin t)
      (Set.Ioo 0 (Real.pi / (k + 1))) := by
  have hp : 0 < k + 1 := by linarith
  have bound : ∀ t ∈ Set.Ioo 0 (Real.pi / (k + 1)), k * t < Real.pi := by
    intro t ht
    have hh := (lt_div_iff₀ hp).mp ht.2
    nlinarith [ht.1]
  apply strictAntiOn_of_deriv_neg (convex_Ioo _ _)
  · intro t ht
    have hkt := bound t ht
    have htpi : t < Real.pi := by nlinarith [ht.1]
    exact (sine_ratio_hasDerivAt k t
      (ne_of_gt (Real.sin_pos_of_pos_of_lt_pi ht.1 htpi))).continuousAt.continuousWithinAt
  · intro t ht
    have ht' : t ∈ Set.Ioo 0 (Real.pi / (k + 1)) := by simpa only [interior_Ioo] using ht
    exact sine_ratio_deriv_neg hk ht'.1 (bound t ht')

/-- The finite-angle equation has at most one solution on the paper's interval. -/
lemma finite_angle_unique {n : ℕ} (hn : 3 ≤ n) (r : ℝ) {φ ψ : ℝ}
    (hφ : φ ∈ Set.Ioo 0 (Real.pi / (n : ℝ)))
    (hψ : ψ ∈ Set.Ioo 0 (Real.pi / (n : ℝ)))
    (hφeq : r + 1 = Real.sin (((n : ℝ) - 1) * φ) / Real.sin φ)
    (hψeq : r + 1 = Real.sin (((n : ℝ) - 1) * ψ) / Real.sin ψ) : φ = ψ := by
  have hnR : 3 ≤ (n : ℝ) := by exact_mod_cast hn
  have hmono := sine_ratio_strictAntiOn (show 1 < (n : ℝ) - 1 by linarith)
  have hsum : (n : ℝ) - 1 + 1 = n := by ring
  rw [hsum] at hmono
  exact hmono.injOn hφ hψ (hφeq.symm.trans hψeq)

open Filter Topology Set

lemma sine_ratio_tendsto_zero_right (k : ℝ) :
    Tendsto (fun t : ℝ => Real.sin (k * t) / Real.sin t) (𝓝[>] 0) (𝓝 k) := by
  have hnum : HasDerivAt (fun t : ℝ => Real.sin (k * t)) k 0 := by
    convert (Real.hasDerivAt_sin (k * 0)).comp 0 ((hasDerivAt_id 0).const_mul k) using 1 <;> simp
  have hn : Tendsto (fun t : ℝ => Real.sin (k * t) / t) (𝓝[>] 0) (𝓝 k) := by
    simpa [smul_eq_mul, div_eq_mul_inv, mul_comm] using hnum.tendsto_slope_zero_right
  have hd : Tendsto (fun t : ℝ => Real.sin t / t) (𝓝[>] 0) (𝓝 (1 : ℝ)) := by
    simpa [smul_eq_mul, div_eq_mul_inv, mul_comm] using
      (Real.hasDerivAt_sin 0).tendsto_slope_zero_right
  have hquot := hn.div hd (one_ne_zero : (1 : ℝ) ≠ 0)
  simp only [div_one] at hquot
  apply hquot.congr'
  filter_upwards [self_mem_nhdsWithin] with t ht
  have ht0 : t ≠ 0 := ne_of_gt ht
  field_simp

lemma sine_ratio_at_endpoint {k : ℝ} (hk : 1 < k) :
    Real.sin (k * (Real.pi / (k + 1))) / Real.sin (Real.pi / (k + 1)) = 1 := by
  have hp : 0 < k + 1 := by linarith
  have hc : 0 < Real.pi / (k + 1) := div_pos Real.pi_pos hp
  have hcpi : Real.pi / (k + 1) < Real.pi := by
    rw [div_lt_iff₀ hp]
    nlinarith [Real.pi_pos]
  have hangle : k * (Real.pi / (k + 1)) = Real.pi - Real.pi / (k + 1) := by
    field_simp; ring
  rw [hangle, Real.sin_pi_sub]
  exact div_self (ne_of_gt (Real.sin_pos_of_pos_of_lt_pi hc hcpi))

lemma sine_ratio_exists_unique {k r : ℝ} (hk : 1 < k) (hr : 0 < r) (hrk : r + 1 < k) :
    ∃! φ : ℝ, φ ∈ Set.Ioo 0 (Real.pi / (k + 1)) ∧
      r + 1 = Real.sin (k * φ) / Real.sin φ := by
  let c : ℝ := Real.pi / (k + 1)
  let f : ℝ → ℝ := fun t => Real.sin (k * t) / Real.sin t
  have hp : 0 < k + 1 := by linarith
  have hc : 0 < c := div_pos Real.pi_pos hp
  have hcpi : c < Real.pi := by
    dsimp [c]
    rw [div_lt_iff₀ hp]
    nlinarith [Real.pi_pos]
  have hf : ContinuousOn f (Set.Ioo 0 c) := by
    intro t ht
    exact ((Real.continuous_sin.comp (continuous_const.mul continuous_id)).continuousAt.div
      Real.continuous_sin.continuousAt
      (ne_of_gt (Real.sin_pos_of_pos_of_lt_pi ht.1 (lt_trans ht.2 hcpi)))).continuousWithinAt
  have hleft : Tendsto f (𝓝[Set.Ioo 0 c] 0) (𝓝 k) := by
    rw [nhdsWithin_Ioo_eq_nhdsGT hc]
    exact sine_ratio_tendsto_zero_right k
  have hright : Tendsto f (𝓝[Set.Ioo 0 c] c) (𝓝 1) := by
    have hfc : f c = 1 := sine_ratio_at_endpoint hk
    rw [← hfc]
    exact (((Real.continuous_sin.comp (continuous_const.mul continuous_id)).continuousAt.div
      Real.continuous_sin.continuousAt
      (ne_of_gt (Real.sin_pos_of_pos_of_lt_pi hc hcpi))).continuousWithinAt)
  haveI : NeBot (𝓝[Set.Ioo 0 c] 0) := left_nhdsWithin_Ioo_neBot hc
  haveI : NeBot (𝓝[Set.Ioo 0 c] c) := right_nhdsWithin_Ioo_neBot hc
  have hi := isPreconnected_Ioo.intermediate_value_Ioo
    (l₁ := 𝓝[Set.Ioo 0 c] c) (l₂ := 𝓝[Set.Ioo 0 c] 0)
    inf_le_right inf_le_right hf hright hleft
  obtain ⟨φ, hφ, heq⟩ := hi (show r + 1 ∈ Set.Ioo 1 k by constructor <;> linarith)
  refine ⟨φ, ⟨hφ, heq.symm⟩, ?_⟩
  intro ψ hψ
  exact (sine_ratio_strictAntiOn hk).injOn hψ.1 hφ (hψ.2.symm.trans heq.symm)

/-- Existence and uniqueness of the actual finite-angle equation, not a supplied witness. -/
lemma finite_angle_exists_unique {n : ℕ} (hn : 3 ≤ n) {r : ℝ}
    (hr : 0 < r) (hrn : r < (n : ℝ) - 2) :
    ∃! φ : ℝ, φ ∈ Set.Ioo 0 (Real.pi / (n : ℝ)) ∧
      r + 1 = Real.sin (((n : ℝ) - 1) * φ) / Real.sin φ := by
  have hnR : 3 ≤ (n : ℝ) := by exact_mod_cast hn
  simpa only [sub_add_cancel] using sine_ratio_exists_unique
    (show 1 < (n : ℝ) - 1 by linarith) hr (show r + 1 < (n : ℝ) - 1 by linarith)

end C2.NGammaEqual

end

/- ===== C2.NGammaEqualBoundary ===== -/

/-! The actual unit-circle polynomial zero for the identical-factor angle equation. -/
noncomputable section
namespace C2.NGammaEqual

/-- Evaluation of z*ΠD+b*Πq when every q=z and every positive factor is r. -/
def backwardCharacteristic (n : ℕ) (r b : ℝ) (z : ℂ) : ℂ :=
  z * (((r : ℂ) + 1) * z - 1) ^ n + (b : ℂ) * z ^ n

lemma backward_boundary_algebra (n : ℕ) (r A : ℝ) (w : ℂ) (hw : w ≠ 0)
    (hfactor : (r : ℂ) + 1 + w ^ n = (A : ℂ) * w) :
    backwardCharacteristic n r (A ^ n) (-(w ^ n)⁻¹) = 0 := by
  let z : ℂ := -(w ^ n)⁻¹
  have hwn : w ^ n ≠ 0 := pow_ne_zero n hw
  have hz : z * w ^ n = -1 := by dsimp [z]; simp [hwn]
  have hd : ((r : ℂ) + 1) * z - 1 = z * ((A : ℂ) * w) := by
    rw [← hfactor]
    calc
      ((r : ℂ) + 1) * z - 1 = z * ((r : ℂ) + 1) + z * w ^ n := by rw [hz]; ring
      _ = _ := by ring
  change z * (((r : ℂ) + 1) * z - 1) ^ n + ((A ^ n : ℝ) : ℂ) * z ^ n = 0
  rw [hd, Complex.ofReal_pow, mul_pow, mul_pow]
  calc
    z * (z ^ n * ((A : ℂ) ^ n * w ^ n)) + (A : ℂ) ^ n * z ^ n =
      z ^ n * (A : ℂ) ^ n * (z * w ^ n + 1) := by ring
    _ = 0 := by rw [hz]; ring

lemma equal_angle_factor {n : ℕ} {r φ : ℝ} (hs : Real.sin φ ≠ 0)
    (hangle : r + 1 = Real.sin (((n : ℝ) - 1) * φ) / Real.sin φ) :
    (r : ℂ) + 1 + Complex.exp ((φ : ℂ) * Complex.I) ^ n =
      ((Real.sin ((n : ℝ) * φ) / Real.sin φ : ℝ) : ℂ) *
        Complex.exp ((φ : ℂ) * Complex.I) := by
  have hsin : (r + 1) * Real.sin φ =
      Real.sin ((n : ℝ) * φ) * Real.cos φ -
      Real.cos ((n : ℝ) * φ) * Real.sin φ := by
    have hh := (eq_div_iff hs).mp hangle
    have harg : ((n : ℝ) - 1) * φ = (n : ℝ) * φ - φ := by ring
    rw [harg, Real.sin_sub] at hh
    exact hh
  have hexp : Complex.exp ((φ : ℂ) * Complex.I) ^ n =
      Complex.exp ((((n : ℝ) * φ : ℝ) : ℂ) * Complex.I) := by
    rw [← Complex.exp_nat_mul]
    congr 1
    push_cast
    ring
  rw [hexp]
  apply Complex.ext
  · simp only [Complex.add_re, Complex.ofReal_re, Complex.one_re,
      Complex.exp_ofReal_mul_I_re, Complex.mul_re, Complex.ofReal_im,
      zero_mul, sub_zero]
    field_simp
    nlinarith [hsin]
  · simp only [Complex.add_im, Complex.ofReal_im, Complex.one_im,
      Complex.exp_ofReal_mul_I_im, zero_add, Complex.mul_im,
      zero_mul, add_zero]
    exact (div_mul_cancel₀ _ hs).symm

lemma equal_finite_boundary {n : ℕ} {r φ : ℝ} (hs : Real.sin φ ≠ 0)
    (hangle : r + 1 = Real.sin (((n : ℝ) - 1) * φ) / Real.sin φ) :
    backwardCharacteristic n r ((Real.sin ((n : ℝ) * φ) / Real.sin φ) ^ n)
      (Complex.exp (((Real.pi - (n : ℝ) * φ : ℝ) : ℂ) * Complex.I)) = 0 := by
  have hz : Complex.exp (((Real.pi - (n : ℝ) * φ : ℝ) : ℂ) * Complex.I) =
      -(Complex.exp ((φ : ℂ) * Complex.I) ^ n)⁻¹ := by
    push_cast
    rw [sub_mul, Complex.exp_sub, Complex.exp_pi_mul_I]
    have hh : Complex.exp (((n : ℂ) * φ) * Complex.I) =
        Complex.exp ((φ : ℂ) * Complex.I) ^ n := by
      rw [← Complex.exp_nat_mul]
      congr 1
      ring
    rw [hh]
    simp [div_eq_mul_inv]
  rw [hz]
  exact backward_boundary_algebra n r _ _ (Complex.exp_ne_zero _) (equal_angle_factor hs hangle)

lemma equal_finite_boundary_norm (n : ℕ) (φ : ℝ) :
    ‖Complex.exp (((Real.pi - (n : ℝ) * φ : ℝ) : ℂ) * Complex.I)‖ = 1 := by
  rw [Complex.norm_exp]
  simp

lemma backwardCharacteristic_conjugate (n : ℕ) (r b : ℝ) (z : ℂ) :
    backwardCharacteristic n r b (starRingEnd ℂ z) =
      starRingEnd ℂ (backwardCharacteristic n r b z) := by
  simp [backwardCharacteristic]

lemma equal_finite_boundary_pair {n : ℕ} {r φ : ℝ} (hs : Real.sin φ ≠ 0)
    (hangle : r + 1 = Real.sin (((n : ℝ) - 1) * φ) / Real.sin φ) :
    backwardCharacteristic n r ((Real.sin ((n : ℝ) * φ) / Real.sin φ) ^ n)
      (Complex.exp (((Real.pi - (n : ℝ) * φ : ℝ) : ℂ) * Complex.I)) = 0 ∧
    backwardCharacteristic n r ((Real.sin ((n : ℝ) * φ) / Real.sin φ) ^ n)
      (Complex.exp (-(((Real.pi - (n : ℝ) * φ : ℝ) : ℂ) * Complex.I))) = 0 := by
  have hz := equal_finite_boundary hs hangle
  refine ⟨hz, ?_⟩
  have hconj := congrArg (starRingEnd ℂ) hz
  rw [← backwardCharacteristic_conjugate, ← Complex.exp_conj] at hconj
  simpa using hconj

lemma finite_gain_pos {n : ℕ} (hn : 0 < n) {φ : ℝ}
    (hφ : φ ∈ Set.Ioo 0 (Real.pi / (n : ℝ))) :
    0 < (Real.sin ((n : ℝ) * φ) / Real.sin φ) ^ n := by
  have hnR : 0 < (n : ℝ) := by exact_mod_cast hn
  have hnp : (n : ℝ) * φ < Real.pi := by
    have h := (lt_div_iff₀ hnR).mp hφ.2
    nlinarith
  have ht : φ < Real.pi := by
    have hn1 : 1 ≤ (n : ℝ) := by exact_mod_cast hn
    nlinarith [hφ.1]
  have hnum := Real.sin_pos_of_pos_of_lt_pi (mul_pos hnR hφ.1) hnp
  have hden := Real.sin_pos_of_pos_of_lt_pi hφ.1 ht
  exact pow_pos (div_pos hnum hden) n

end C2.NGammaEqual

end

/- ===== C2.NGammaEqualCubic ===== -/

/-! Actual Schur stability of the n=3 all-backward-Euler design. -/
noncomputable section
namespace C2.NGammaEqual

def cubicB (a b : ℝ) : ℝ := (b - 3 * a ^ 2) / a ^ 3
def cubicC (a : ℝ) : ℝ := 3 / a ^ 2
def cubicD (a : ℝ) : ℝ := -1 / a ^ 3

lemma cubic_jury_plus {a : ℝ} (ha : a ≠ 0) (b : ℝ) :
    1 + cubicB a b + cubicC a + cubicD a = ((a - 1) ^ 3 + b) / a ^ 3 := by
  unfold cubicB cubicC cubicD
  field_simp
  <;> ring

lemma cubic_jury_minus {a : ℝ} (ha : a ≠ 0) (b : ℝ) :
    1 - cubicB a b + cubicC a - cubicD a = ((a + 1) ^ 3 - b) / a ^ 3 := by
  unfold cubicB cubicC cubicD
  field_simp
  <;> ring

lemma cubic_jury_final {a : ℝ} (ha : a ≠ 0) (b : ℝ) :
    1 - cubicC a + cubicB a b * cubicD a - cubicD a ^ 2 =
      ((a ^ 2 - 1) ^ 3 - b) / a ^ 6 := by
  unfold cubicB cubicC cubicD
  field_simp
  <;> ring

lemma cubic_backward_schur_iff {a b : ℝ} (ha : 1 < a) (hb : 0 ≤ b) :
    C2.CubicSchur (cubicB a b) (cubicC a) (cubicD a) ↔
      b < (a + 1) ^ 3 ∧ b < (a ^ 2 - 1) ^ 3 := by
  have ha0 : 0 < a := by linarith
  have ha3 : 0 < a ^ 3 := pow_pos ha0 _
  have ha6 : 0 < a ^ 6 := pow_pos ha0 _
  have ha1 : 1 < a ^ 3 := by nlinarith [sq_nonneg (a - 1)]
  have hd : |cubicD a| < 1 := by
    unfold cubicD
    rw [abs_div, abs_neg, abs_one, abs_of_pos ha3]
    exact (div_lt_one ha3).2 ha1
  have hplus : 0 < 1 + cubicB a b + cubicC a + cubicD a := by
    rw [cubic_jury_plus (ne_of_gt ha0)]
    apply div_pos _ ha3
    have hp : 0 < (a - 1) ^ 3 := pow_pos (sub_pos.mpr ha) _
    linarith
  rw [C2.cubicSchur_iff, cubic_jury_minus (ne_of_gt ha0),
    cubic_jury_final (ne_of_gt ha0)]
  constructor
  · rintro ⟨_, _, hm, hf⟩
    exact ⟨sub_pos.mp ((div_pos_iff_of_pos_right ha3).mp hm),
      sub_pos.mp ((div_pos_iff_of_pos_right ha6).mp hf)⟩
  · rintro ⟨hm, hf⟩
    exact ⟨hd, hplus, div_pos (sub_pos.mpr hm) ha3, div_pos (sub_pos.mpr hf) ha6⟩

lemma order_three_characteristic_factor {r : ℝ} (hr : 0 < r) (b : ℝ) (z : ℂ) :
    backwardCharacteristic 3 r b z =
      z * ((r : ℂ) + 1) ^ 3 *
        (z ^ 3 + (cubicB (r + 1) b : ℂ) * z ^ 2 +
          (cubicC (r + 1) : ℂ) * z + (cubicD (r + 1) : ℂ)) := by
  have ha : (r : ℂ) + 1 ≠ 0 := by
    have hh : r + 1 ≠ 0 := by linarith
    exact_mod_cast hh
  unfold backwardCharacteristic cubicB cubicC cubicD
  push_cast
  field_simp
  <;> ring

/-- Exact actual-root statement: stability is never defined as the Jury inequalities. -/
lemma order_three_backward_stable_iff {r b : ℝ} (hr : 0 < r) (hr1 : r < 1) (hb : 0 ≤ b) :
    (∀ z : ℂ, backwardCharacteristic 3 r b z = 0 → ‖z‖ < 1) ↔
      b < (r * (r + 2)) ^ 3 := by
  have ha : 1 < r + 1 := by linarith
  have hab : (r + 1) ^ 2 - 1 < (r + 1) + 1 := by nlinarith
  have hbase : 0 ≤ (r + 1) ^ 2 - 1 := by nlinarith
  have hcube : ((r + 1) ^ 2 - 1) ^ 3 ≤ (r + 1 + 1) ^ 3 := by
    exact pow_le_pow_left₀ hbase hab.le _
  have halg : (r + 1) ^ 2 - 1 = r * (r + 2) := by ring
  have hcoeff : C2.CubicSchur (cubicB (r + 1) b) (cubicC (r + 1)) (cubicD (r + 1)) ↔
      b < (r * (r + 2)) ^ 3 := by
    rw [cubic_backward_schur_iff ha hb, ← halg]
    exact ⟨And.right, fun h => ⟨lt_of_lt_of_le h hcube, h⟩⟩
  rw [← hcoeff]
  constructor
  · intro h z hz
    apply h z
    rw [order_three_characteristic_factor hr]
    rw [hz, mul_zero]
  · intro h z hz
    rw [order_three_characteristic_factor hr] at hz
    rcases mul_eq_zero.mp hz with hz | hp
    · rcases mul_eq_zero.mp hz with hz | ha0
      · subst z; norm_num
      · have hn : ((r : ℂ) + 1) ^ 3 ≠ 0 := by
          apply pow_ne_zero
          exact_mod_cast (show r + 1 ≠ 0 by linarith)
        exact (hn ha0).elim
    · exact h z hp

end C2.NGammaEqual

end

/- ===== C2.NGammaEqualEndpoint ===== -/

/-! Exact uniform endpoint optimizer, including uniqueness and the threshold.
This specializes the proved arbitrary-order endpoint optimization theorem. -/
noncomputable section
open scoped BigOperators
open C2.NGamma
namespace C2.NGammaEqual

lemma positive_quadratic_resource_unique {r x y : ℝ} (hr : 0 < r)
    (hx : 0 < x) (hy : 0 < y) (heq : x*(2+r*x)=y*(2+r*y)) : x=y := by
  have hf : (x-y)*(r*(x+y)+2)=0 := by nlinarith
  have hp : 0 < r*(x+y)+2 := by positivity
  have hh := (mul_eq_zero.mp hf).resolve_right (ne_of_gt hp)
  linarith

lemma uniform_endpoint_parameter {n : ℕ} (hn : 0 < n) {r c : ℝ} (hr : 0 < r)
    (hbudget : allocatedResource (fun _ : Fin n => r) c = 4) :
    endpointParameter r c = endpointCoordinate (n:ℝ) r := by
  have hx : 0 < endpointParameter r c := endpointParameter_pos r c
  have hy : 0 < endpointCoordinate (n:ℝ) r := endpointCoordinate_pos (by exact_mod_cast hn)
  have hs := endpointParameter_budget (fun _ : Fin n => r) (fun _ => hr) hbudget
  have hb : (n:ℝ)/(endpointParameter r c*(2+r*endpointParameter r c))=1 := by
    simpa [endpointCost,div_eq_mul_inv] using hs
  have hd : endpointParameter r c*(2+r*endpointParameter r c) ≠ 0 := by positivity
  have hh : endpointParameter r c*(2+r*endpointParameter r c) = (n:ℝ) := by
    have h := (div_eq_iff hd).mp hb
    linarith
  apply positive_quadratic_resource_unique hr hx hy
  rw [hh,endpointCoordinate_resource (by positivity) hr.le]

lemma uniform_endpoint_product {n : ℕ} (hn : 0 < n) {r c : ℝ} (hr : 0 < r)
    (hbudget : allocatedResource (fun _ : Fin n => r) c = 4) :
    (∏ _ : Fin n, endpointAllocation r c) = endpointGain n r := by
  rw [← endpointParameter_inverse r c,uniform_endpoint_parameter hn hr hbudget,
    endpointGain_factor_identity hn]
  simp [endpointGain]

/-- Exact endpoint optimizer for equal factors, in the original x-coordinates.
It includes both r>n-2 and the threshold r=n-2. -/
theorem identical_endpoint_optimal {n : ℕ} (hn : 0 < n) {r : ℝ}
    (hr : 0 < r) (hregime : (n:ℝ)-2 ≤ r)
    (x : Fin n → ℝ) (hx : ∀ i, 0 < x i ∧ x i ≤ 1)
    (hcost : (∑ i, endpointCost r (x i)) ≤ 1) :
    (∏ i, (r+2/x i)) ≤ endpointGain n r ∧
      (x ≠ (fun _ => endpointCoordinate (n:ℝ) r) →
        (∏ i, (r+2/x i)) < endpointGain n r) := by
  have hnR : 0 < (n:ℝ) := by exact_mod_cast hn
  have hns : 1 ≤ (n:ℝ) := by exact_mod_cast hn
  have hsum : (∑ _ : Fin n, 1/(r+2)) = (n:ℝ)/(r+2) := by simp [div_eq_mul_inv]
  by_cases hstrict : (n:ℝ)-2 < r
  · letI : Nonempty (Fin n) := ⟨⟨0,hn⟩⟩
    have hbase : (∑ _ : Fin n, 1/(r+2)) < 1 := by
      rw [hsum]
      exact (div_lt_one (by positivity : 0 < r+2)).2 (by linarith)
    obtain ⟨c,hc,hbudget,_,_,hopt⟩ := exists_endpoint_optimizer
      (fun _ : Fin n => r) (fun _ => hr) hbase
    have hh := hopt x hx hcost
    have hp := uniform_endpoint_parameter hn hr hbudget
    have hg := uniform_endpoint_product hn hr hbudget
    simpa only [hp,hg] using hh
  · have heq : r=(n:ℝ)-2 := by linarith
    have hbase : (∑ _ : Fin n, 1/(r+2)) = 1 := by
      rw [hsum]
      apply (div_eq_one_iff_eq (by positivity : r+2≠0)).2
      linarith
    have hxeq := endpoint_feasible_equality_unique (fun _ : Fin n => r) x
      (fun _ => hr) hx hbase hcost
    have hstar : endpointCoordinate (n:ℝ) r = 1 :=
      (endpointCoordinate_eq_one_iff hns hr).2 heq
    have hv : (∏ i, (r+2/x i)) = endpointGain n r := by
      rw [hxeq]
      have hf := endpointGain_factor_identity hn r
      rw [hstar] at hf
      simp only [div_one] at hf
      simp [endpointGain,← hf]
    exact ⟨hv.le, fun hne => (hne (by simpa [hstar] using hxeq)).elim⟩

end C2.NGammaEqual

end

/- ===== C2.NGammaEqualFrequency ===== -/

/-! Identification of the explicit equal-factor angle and gain with the
actual all-backward-Euler frequency optimizer. -/
noncomputable section
open scoped BigOperators
open Set C2.NGamma C2.NGamma.Global
namespace C2.NGammaEqual

lemma cos_two_arctan (w : ℝ) :
    Real.cos (2*Real.arctan w) = (1-w^2)/(1+w^2) := by
  rw [Real.cos_two_mul,Real.cos_arctan]
  have hs := Real.sq_sqrt (show 0 ≤ 1+w^2 by positivity)
  have hn : Real.sqrt (1+w^2) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr (by positivity))
  field_simp
  nlinarith

lemma all_one_phase_tangent {r w : ℝ} (hr : 0 < r) (hw : 0 < w) :
    Real.sin (allocationPhase r 1 w) * (r*(1+w^2)+2) =
      Real.cos (allocationPhase r 1 w) * (2*w) := by
  have hp : allocationPhase r 1 w = Real.arctan (2*w/(r*(1+w^2)+2)) := by
    simpa [phaseDenom] using phase_eq_arctan (x := 1) hr (by norm_num) hw
  rw [hp,Real.sin_arctan,Real.cos_arctan]
  have hd : r*(1+w^2)+2 ≠ 0 := by positivity
  field_simp
  <;> ring

lemma angle_from_all_one_phase {n : ℕ} (hn : 0 < n) {r w : ℝ}
    (hr : 0 < r) (hw : 0 < w)
    (hp : (∑ _ : Fin n, allocationPhase r 1 w) = 2*Real.arctan w) :
    allocationPhase r 1 w ∈ Ioo 0 (Real.pi/(n:ℝ)) ∧
      r+1 = Real.sin (((n:ℝ)-1)*allocationPhase r 1 w) /
        Real.sin (allocationPhase r 1 w) := by
  let φ := allocationPhase r 1 w
  have hnR : 0 < (n:ℝ) := by exact_mod_cast hn
  have hnp : (n:ℝ)*φ=2*Real.arctan w := by simpa [φ] using hp
  have hφ : 0 < φ := phase_pos hr hw
  have hφhalf : φ < Real.pi/2 := phase_lt_pi_div_two (by norm_num : (0:ℝ)≤1) hw
  have hφpi : φ < Real.pi := lt_trans hφhalf (by linarith [Real.pi_pos])
  have hs : Real.sin φ ≠ 0 := ne_of_gt (Real.sin_pos_of_pos_of_lt_pi hφ hφpi)
  have htan := all_one_phase_tangent hr hw
  change Real.sin φ*(r*(1+w^2)+2)=Real.cos φ*(2*w) at htan
  refine ⟨⟨hφ,(lt_div_iff₀ hnR).2 ?_⟩,?_⟩
  · have ha := Real.arctan_lt_pi_div_two w
    nlinarith
  · apply (eq_div_iff hs).2
    rw [show ((n:ℝ)-1)*φ=(n:ℝ)*φ-φ by ring,Real.sin_sub,hnp,
      sin_two_arctan,cos_two_arctan]
    have hd : 1+w^2 ≠ 0 := by positivity
    field_simp
    nlinarith [htan]

lemma all_one_gain_angle {n : ℕ} (hn : 0 < n) {r w : ℝ}
    (hr : 0 < r) (hw : 0 < w)
    (hp : (∑ _ : Fin n, allocationPhase r 1 w) = 2*Real.arctan w) :
    allocationGain r 1 w = Real.sin ((n:ℝ)*allocationPhase r 1 w) /
      Real.sin (allocationPhase r 1 w) := by
  let φ := allocationPhase r 1 w
  have hnp : (n:ℝ)*φ=2*Real.arctan w := by simpa [φ] using hp
  have hf := angle_from_all_one_phase hn hr hw hp
  have hnR : 0 < (n:ℝ) := by exact_mod_cast hn
  have hφpi : φ < Real.pi := by
    have hhalf : φ < Real.pi/2 := phase_lt_pi_div_two (by norm_num : (0:ℝ)≤1) hw
    linarith [Real.pi_pos]
  have hspos := Real.sin_pos_of_pos_of_lt_pi hf.1.1 hφpi
  have hnumpos : 0 < Real.sin ((n:ℝ)*φ) :=
    Real.sin_pos_of_pos_of_lt_pi (mul_pos hnR hf.1.1)
      (by have h := (lt_div_iff₀ hnR).mp hf.1.2; nlinarith)
  have hgain := allocationGain_pos hr hw 1
  have hd : 1+w^2 ≠ 0 := by positivity
  have hD : r*(1+w^2)+2 ≠ 0 := by positivity
  have hφeq : φ = Real.arctan (2*w/(r*(1+w^2)+2)) := by
    simpa [phaseDenom] using phase_eq_arctan (x := 1) hr (by norm_num) hw
  have hsq : (Real.sin ((n:ℝ)*φ)/Real.sin φ)^2 = (allocationGain r 1 w)^2 := by
    rw [hnp,sin_two_arctan,hφeq,Real.sin_arctan]
    unfold allocationGain
    rw [Real.sq_sqrt (by positivity)]
    have hroot := Real.sq_sqrt (show 0 ≤ 1+(2*w/(r*(1+w^2)+2))^2 by positivity)
    have hrootne : Real.sqrt (1+(2*w/(r*(1+w^2)+2))^2) ≠ 0 := by positivity
    field_simp
    rw [mul_pow, Real.sq_sqrt (by positivity)]
    ring
  have hquot : 0 < Real.sin ((n:ℝ)*φ)/Real.sin φ := div_pos hnumpos hspos
  change allocationGain r 1 w = Real.sin ((n:ℝ)*φ)/Real.sin φ
  nlinarith

end C2.NGammaEqual

end

/- ===== C2.NGammaEqualGlobal ===== -/

/-! Both global equal-factor frequency/endpoint optimization regimes, with
the explicit finite-angle value identified with the actual optimum. The
independent Schur interval theorem supplies the dynamical interpretation. -/
noncomputable section
open scoped BigOperators
open Set C2.NGamma C2.NGamma.Global
namespace C2.NGammaEqual

lemma exp_sum_allocationLogGain {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) {w : ℝ} (hw : 0 < w) :
    Real.exp (∑ j, allocationLogGain (r j) (x j) w) =
      ∏ j, allocationGain (r j) (x j) w := by
  rw [Real.exp_sum]
  apply Finset.prod_congr rfl
  intro j hj
  rw [← log_allocationGain (hr j) hw, Real.exp_log (allocationGain_pos (hr j) hw (x j))]

/-- Every finite-frequency competitor is strictly inferior to the explicit
identical endpoint design, throughout its valid regime. -/
theorem identical_endpoint_dominates_finite {n : ℕ} (hn : 0 < n) {r w : ℝ}
    (hr : 0 < r) (hregime : (n:ℝ)-2 ≤ r) (hw : 0 < w)
    (x : Fin n → ℝ) (hx : ∀ j, x j ∈ Icc (0:ℝ) 1)
    (hp : (∑ j, allocationPhase r (x j) w) = 2*Real.arctan w) :
    (∏ j, allocationGain r (x j) w) < endpointGain n r := by
  have hS : endpointSum (fun _ : Fin n => r) ≤ 1 := by
    have hsum : endpointSum (fun _ : Fin n => r) = (n:ℝ)/(r+2) := by
      simp [endpointSum,div_eq_mul_inv]
    rw [hsum]
    exact (div_le_one (by positivity : 0 < r+2)).2 (by linarith)
  exact lt_of_le_of_lt (gain_product_le_exp_frequencyValue
    (fun _ : Fin n => r) x (fun _ => hr) hw hx hp)
    (positive_frequency_below_endpoint_bound hn (fun _ : Fin n => r) (fun _ => hr) hS _
      (fun y hy hc => (identical_endpoint_optimal hn hr hregime y hy hc).1)
      hw ⟨x,hx,hp⟩)

/-- The explicit finite-angle gain is the actual unique global
frequency-domain optimum, rather than an unrelated unit-circle witness. -/
theorem identical_finite_global_gain {n : ℕ} (hn : 3 ≤ n) {r : ℝ}
    (hr : 0 < r) (hrn : r < (n:ℝ)-2) :
    ∃ w : ℝ, ∃ φ : ℝ, 0 < w ∧ φ ∈ Ioo 0 (Real.pi/(n:ℝ)) ∧
      r+1 = Real.sin (((n:ℝ)-1)*φ)/Real.sin φ ∧
      (∑ _ : Fin n, allocationPhase r 1 w) = 2*Real.arctan w ∧
      (∏ _ : Fin n, allocationGain r 1 w) = (Real.sin ((n:ℝ)*φ)/Real.sin φ)^n ∧
      ∀ v : ℝ, 0 < v → ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) →
        (∑ j, allocationPhase r (x j) v) = 2*Real.arctan v →
        (∏ j, allocationGain r (x j) v) ≤ (Real.sin ((n:ℝ)*φ)/Real.sin φ)^n ∧
        ((∏ j, allocationGain r (x j) v) = (Real.sin ((n:ℝ)*φ)/Real.sin φ)^n ↔
          v=w ∧ x=fun _ => 1) := by
  have hn0 : 0 < n := by omega
  have hS : 1 < endpointSum (fun _ : Fin n => r) := by
    have hsum : endpointSum (fun _ : Fin n => r) = (n:ℝ)/(r+2) := by
      simp [endpointSum,div_eq_mul_inv]
    rw [hsum]
    exact (one_lt_div (by positivity : 0 < r+2)).2 (by linarith)
  obtain ⟨w,hw,hp,hmax⟩ := positive_endpoint_unique_global_maximum hn0
    (fun _ : Fin n => r) (fun _ => hr) hS
  let φ := allocationPhase r 1 w
  have hangle := angle_from_all_one_phase hn0 hr hw hp
  have hgain : (∏ _ : Fin n, allocationGain r 1 w) = (Real.sin ((n:ℝ)*φ)/Real.sin φ)^n := by
    rw [all_one_gain_angle hn0 hr hw hp]
    simp [φ,div_pow]
  refine ⟨w,φ,hw,hangle.1,hangle.2,hp,hgain,?_⟩
  intro v hv x hx hphase
  have hh := hmax v hv x hx hphase
  have hvexp := exp_sum_allocationLogGain (fun _ : Fin n => r) x (fun _ => hr) hv
  have hwexp := exp_sum_allocationLogGain (fun _ : Fin n => r) (fun _ => 1) (fun _ => hr) hw
  rw [← hgain,← hvexp,← hwexp]
  exact ⟨Real.exp_le_exp.mpr hh.1, by rw [Real.exp_injective.eq_iff]; exact hh.2⟩

end C2.NGammaEqual

end

/- ===== C2.NGammaReflectionOrder ===== -/

/-! Strict improvement of the critical boundary gain after reflecting negative
coordinates. The phase crossing is an actual arctangent identity; the gain is
the actual Cayley amplitude of the characteristic polynomial. -/
noncomputable section
open scoped BigOperators Topology
open Set Filter
namespace C2.NGamma.Global

theorem reflected_phase_below_at_crossing {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hzero : ∀ j, -(2/r j) ≤ x j)
    (hneg : ∃ j, x j < 0) {t : ℝ} (ht : 0 < t)
    (hcross : Phase.totalPhase (fun j => x j+2/r j) x 1 t = Real.pi) :
    Phase.totalPhase (fun j => |x j|+2/r j) (fun j => |x j|) 1 t < Real.pi := by
  have hs := reflected_phase_sum_strict r x hr hzero hneg ht
  unfold Phase.totalPhase at hcross ⊢
  linarith

theorem reflected_finite_critical_gain_strict {n : ℕ} (hn : 0 < n)
    (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    (hx : ∀ j, |x j| ≤ 1) (hzero : ∀ j, -(2/r j) ≤ x j)
    (hneg : ∃ j, x j < 0) {s t : ℝ} (hs : 0 < s) (ht : 0 < t)
    (hold : Phase.totalPhase (fun j => x j+2/r j) x 1 s = Real.pi)
    (hnew : Phase.totalPhase (fun j => |x j|+2/r j) (fun j => |x j|) 1 t = Real.pi) :
    s < t ∧ Cayley.amplitude r x s < Cayley.amplitude r (fun j => |x j|) t := by
  have hbelow := reflected_phase_below_at_crossing r x hr hzero hneg hs hold
  have horder : s < t :=
    (Phase.single_phase_before_after_crossing hn (fun j => abs_nonneg (x j)) hx
      (fun j => lt_add_of_pos_right _ (div_pos (by norm_num) (hr j))) ht hs hnew).1.mp hbelow
  refine ⟨horder,?_⟩
  exact lt_trans (reflected_amplitude_strict r x hr hneg hs)
    (Cayley.amplitude_strictMonoOn hn hr (fun j => abs_nonneg (x j)) hs.le ht.le horder)

theorem amplitude_strictly_below_endpoint {n : ℕ} (hn : 0 < n)
    (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j) (hx : ∀ j, 0 < x j)
    {t : ℝ} (ht : 0 ≤ t) :
    Cayley.amplitude r x t < ∏ j, (r j+2/x j) := by
  have hm := Cayley.amplitude_strictMonoOn hn hr (fun j => (hx j).le)
  have hupper : Cayley.amplitude r x (t+1) ≤ ∏ j, (r j+2/x j) := by
    apply ge_of_tendsto (Cayley.amplitude_tendsto_atTop hr hx)
    filter_upwards [eventually_ge_atTop (t+1)] with s hs
    exact hm.monotoneOn (show 0 ≤ t+1 by linarith) (show 0 ≤ s by linarith) hs
  exact lt_of_lt_of_le (hm ht (show 0 ≤ t+1 by linarith) (by linarith)) hupper

theorem reflected_endpoint_critical_gain_strict {n : ℕ} (hn : 0 < n)
    (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j) (hx : ∀ j, 0 < |x j|)
    (hneg : ∃ j, x j < 0) {t : ℝ} (ht : 0 < t) :
    Cayley.amplitude r x t < ∏ j, (r j+2/|x j|) := by
  exact lt_trans (reflected_amplitude_strict r x hr hneg ht)
    (amplitude_strictly_below_endpoint hn r (fun j => |x j|) hr hx ht.le)

end C2.NGamma.Global

end

/- ===== C2.NGammaNegativePhase ===== -/

/-! The actual first phase crossing for admissible vectors with negative
coordinates.  This includes the zero-gain boundary x=-2/r. -/
noncomputable section
open scoped BigOperators Topology
open Set Filter
namespace C2.NGamma.Phase

lemma negative_contribution_strictMono {a x : ℝ} (ha : 0 ≤ a) (hx : x < 0) :
    StrictMono (contribution a x) := by
  intro s t hst
  have hA := Real.arctan_strictMono.monotone (mul_le_mul_of_nonneg_left hst.le ha)
  have hX := Real.arctan_strictMono (mul_lt_mul_of_neg_left hst hx)
  unfold contribution
  linarith

lemma negative_ratio_strictMonoOn {a x : ℝ} (ha : 0 ≤ a) (hx : x < 0) :
    StrictMonoOn (ratio a x) (Ioi 0) := by
  intro s hs t ht hst
  have hax : x < a := lt_of_lt_of_le hx ha
  have hDs := arctan_pos (one_div_pos.mpr hs)
  have hDt := arctan_pos (one_div_pos.mpr ht)
  have hDlt : Real.arctan (1/t) < Real.arctan (1/s) :=
    Real.arctan_strictMono (one_div_lt_one_div_of_lt hs hst)
  have hNt := contribution_pos hax ht
  unfold ratio
  exact lt_of_lt_of_le ((div_lt_div_iff_of_pos_right hDs).2
    (negative_contribution_strictMono ha hx hst))
    (div_le_div_of_nonneg_left hNt.le hDt hDlt.le)

lemma negative_ratio_tendsto_atTop {a x : ℝ} (ha : 0 ≤ a) (hx : x < 0) :
    Tendsto (ratio a x) atTop atTop := by
  have ht := ratio_tendsto_atTop_of_zero (a := -x) (by linarith)
  apply tendsto_atTop_mono' atTop _ ht
  filter_upwards [eventually_gt_atTop (0:ℝ)] with t ht
  have hA : 0 ≤ Real.arctan (a*t) := by
    simpa only [Real.arctan_zero] using
      Real.arctan_strictMono.monotone (mul_nonneg ha ht.le)
  unfold ratio contribution
  apply (div_le_div_iff_of_pos_right (arctan_pos (one_div_pos.mpr ht))).2
  simp only [zero_mul,Real.arctan_zero,sub_zero,neg_mul,Real.arctan_neg]
  linarith

end C2.NGamma.Phase
namespace C2.NGamma.Global

lemma mixed_sumRatio_strictMonoOn {n : ℕ} (hn : 0 < n) (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hlo : ∀ j, -(2/r j) ≤ x j) (hhi : ∀ j, x j ≤ 1) :
    StrictMonoOn (sumRatio r x) (Ioi 0) := by
  have hi : ∀ j, StrictMonoOn (Phase.ratio (x j+2/r j) (x j)) (Ioi 0) := by
    intro j
    by_cases hx : x j < 0
    · exact Phase.negative_ratio_strictMonoOn (by have := hlo j; linarith) hx
    · exact Phase.ratio_strictMonoOn (le_of_not_gt hx) (hhi j)
        (by have := div_pos (by norm_num : (0:ℝ)<2) (hr j); linarith)
  intro s hs t ht hst
  apply Finset.sum_lt_sum
  · intro j _
    exact (hi j hs ht hst).le
  · exact ⟨⟨0,hn⟩,Finset.mem_univ _,hi _ hs ht hst⟩

lemma negative_sumRatio_tendsto_atTop {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hlo : ∀ j, -(2/r j) ≤ x j)
    (hneg : ∃ j, x j < 0) : Tendsto (sumRatio r x) atTop atTop := by
  obtain ⟨i,hi⟩ := hneg
  have ht := Phase.negative_ratio_tendsto_atTop
    (a := x i+2/r i) (by have := hlo i; linarith) hi
  apply tendsto_atTop_mono' atTop _ ht
  filter_upwards [eventually_gt_atTop (0:ℝ)] with t ht
  unfold sumRatio
  apply Finset.single_le_sum (s := Finset.univ) _ (Finset.mem_univ i)
  intro j hj
  exact (div_pos (Phase.contribution_pos
    (by have := div_pos (by norm_num : (0:ℝ)<2) (hr j); linarith) ht)
    (Phase.arctan_pos (one_div_pos.mpr ht))).le

/-- Existence and uniqueness of the actual first normalized phase crossing,
including negative coordinates whose zero-gain factor is still admissible. -/
theorem negative_first_phase_crossing {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hlo : ∀ j, -(2/r j) ≤ x j) (hhi : ∀ j, x j ≤ 1)
    (hneg : ∃ j, x j < 0) : ∃! t, 0 < t ∧ sumRatio r x t = 2 := by
  have hn : 0 < n := by obtain ⟨j,_⟩ := hneg; exact Nat.zero_lt_of_lt j.isLt
  exact unique_positive_crossing_atTop (sumRatio_continuousOn r x)
    (mixed_sumRatio_strictMonoOn hn r x hr hlo hhi) (sumRatio_tendsto_zero r x)
    (negative_sumRatio_tendsto_atTop r x hr hlo hneg)

lemma reflected_sumRatio_strict {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hlo : ∀ j, -(2/r j) ≤ x j)
    (hneg : ∃ j, x j < 0) {t : ℝ} (ht : 0 < t) :
    sumRatio r (fun j => |x j|) t < sumRatio r x t := by
  simp only [sumRatio,Phase.ratio,← Finset.sum_div]
  exact (div_lt_div_iff_of_pos_right (Phase.arctan_pos (one_div_pos.mpr ht))).2
    (reflected_phase_sum_strict r x hr hlo hneg ht)

lemma reflected_crossing_later {n : ℕ} (r x : Fin n → ℝ)
    (hr : ∀ j, 0 < r j) (hlo : ∀ j, -(2/r j) ≤ x j)
    (habs : ∀ j, |x j| ≤ 1) (hneg : ∃ j, x j < 0)
    {t u : ℝ} (ht : 0 < t) (hu : 0 < u)
    (hcross : sumRatio r x t = 2) (href : sumRatio r (fun j => |x j|) u = 2) : t < u := by
  have hn : 0 < n := by obtain ⟨j,_⟩ := hneg; exact Nat.zero_lt_of_lt j.isLt
  have hlt := reflected_sumRatio_strict r x hr hlo hneg ht
  rw [hcross] at hlt
  by_contra h
  have hle := (sumRatio_strictMonoOn hn r (fun j => |x j|) hr
    (fun j => ⟨abs_nonneg _,habs j⟩)).monotoneOn hu ht (le_of_not_gt h)
  rw [href] at hle
  linarith

end C2.NGamma.Global

end

/- ===== C2.NGammaInitialMargin ===== -/

/-! The actual initial gain margin from the full-cube corollary. -/
noncomputable section
open scoped BigOperators
open Polynomial
namespace C2.NGamma.PolynomialModel
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def initialStableGains (r x : ι → ℝ) (d : ℕ) : Set ℝ :=
  {c | 0<c ∧ ∀ b : ℝ, 0<b → b<c → SchurStable (characteristic r x d b)}

/-- Real's supremum of the empty set is zero, matching the manuscript's
explicit convention when no positive initial interval is stable. -/
def initialGainMargin (r x : ι → ℝ) (d : ℕ) : ℝ := sSup (initialStableGains r x d)

theorem initialStableGains_eq_of_exact_interval {r x : ι → ℝ} {d : ℕ}
    {B : ℝ} (hB : 0<B)
    (hstable : ∀ b : ℝ, 0≤b → (SchurStable (characteristic r x d b) ↔ b<B)) :
    initialStableGains r x d=Set.Ioc 0 B := by
  ext c
  constructor
  · rintro ⟨hc,hcstable⟩
    refine ⟨hc,?_⟩
    by_contra hnc
    have hbc : B<c := lt_of_not_ge hnc
    have hbad := hcstable B hB hbc
    exact (lt_irrefl B) ((hstable B (le_of_lt hB)).mp hbad)
  · rintro ⟨hc,hcB⟩
    refine ⟨hc,?_⟩
    intro b hb hbc
    exact (hstable b (le_of_lt hb)).mpr (lt_of_lt_of_le hbc hcB)

theorem initialGainMargin_eq_of_exact_interval {r x : ι → ℝ} {d : ℕ}
    {B : ℝ} (hB : 0<B)
    (hstable : ∀ b : ℝ, 0≤b → (SchurStable (characteristic r x d b) ↔ b<B)) :
    initialGainMargin r x d=B := by
  unfold initialGainMargin
  rw [initialStableGains_eq_of_exact_interval hB hstable]
  exact csSup_Ioc hB

theorem initialGainMargin_le_of_not_schur {r x : ι → ℝ} {d : ℕ}
    {b : ℝ} (hb : 0<b) (hnot : ¬SchurStable (characteristic r x d b)) :
    initialGainMargin r x d ≤ b := by
  classical
  unfold initialGainMargin
  by_cases hn : (initialStableGains r x d).Nonempty
  · apply csSup_le hn
    intro c hc
    by_contra hcb
    exact hnot (hc.2 b hb (lt_of_not_ge hcb))
  · rw [Set.not_nonempty_iff_eq_empty.mp hn,Real.sSup_empty]
    exact le_of_lt hb

theorem initialGainMargin_le_of_unit_root {r x : ι → ℝ} {d : ℕ}
    {b : ℝ} (hb : 0<b) {z : ℂ}
    (hz : (characteristic r x d b).eval z=0) (hunit : 1≤‖z‖) :
    initialGainMargin r x d ≤ b := by
  apply initialGainMargin_le_of_not_schur hb
  intro hs
  exact (not_lt_of_ge hunit) (hs z hz)

theorem initialStableGains_empty_of_small_gain_not_schur {r x : ι → ℝ} {d : ℕ}
    (hsmall : ∃ ε : ℝ, 0<ε ∧ ∀ b : ℝ, |b|<ε → ¬SchurStable (characteristic r x d b)) :
    initialStableGains r x d=∅ := by
  obtain ⟨ε,hε,hnot⟩ := hsmall
  apply Set.eq_empty_iff_forall_not_mem.2
  intro c hc
  have hm : 0 < min ε c := lt_min hε hc.1
  have hb : 0 < min ε c/2 := by positivity
  have hbmin : min ε c/2 < min ε c := by linarith
  have hbε : min ε c/2<ε := lt_of_lt_of_le hbmin (min_le_left _ _)
  have hbc : min ε c/2<c := lt_of_lt_of_le hbmin (min_le_right _ _)
  have h := hnot (min ε c/2) (by rwa [abs_of_pos hb])
  exact h (hc.2 _ hb hbc)

theorem initialGainMargin_bad_coordinate_eq_zero {r x : ι → ℝ} {d : ℕ}
    (hr : ∀ i, 0<r i) (hx : ∀ i, -1≤x i) (hd : 1≤d)
    (j : ι) (hbad : x j < -2/r j) :
    initialGainMargin r x d=0 := by
  unfold initialGainMargin
  rw [initialStableGains_empty_of_small_gain_not_schur
    (cube_bad_coordinate_small_gain_not_schur hr hx hd j hbad),Real.sSup_empty]

end C2.NGamma.PolynomialModel

end

/- ===== C2.NGammaMarginOptimization ===== -/

/-! Global optimization of the actual initial Schur-stable gain margin.
The margin is the supremum from the manuscript, not an abstract surrogate.
The full-cube argument includes inadmissible zero-gain factors and reflection
of every admissible negative component. -/
noncomputable section
open scoped BigOperators
open Set
namespace C2.NGamma.Global
open PolynomialModel

theorem criticalGain_exact_interval {n : ℕ} (hn : 0 < n)
    (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j) (hx : ∀ j, x j ∈ Icc (0:ℝ) 1)
    {B : ℝ} (hB : CriticalGain r x B) {b : ℝ} (hb : 0 ≤ b) :
    SchurStable (characteristic r x 1 b) ↔ b < B := by
  rcases hB with ⟨hxp,hS,rfl⟩ | ⟨t,ht,hp,rfl⟩
  · exact Cayley.single_sample_endpoint_interval hn hr hxp (fun j => (hx j).2) hS hb
  · exact Cayley.interior_exact_gain_interval hn (le_refl 1) hr
      (fun j => (hx j).1) (fun j => (hx j).2) ht hp hb

theorem criticalGain_eq_initialMargin {n : ℕ} (hn : 0 < n)
    (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j) (hx : ∀ j, x j ∈ Icc (0:ℝ) 1)
    {B : ℝ} (hB : CriticalGain r x B) : initialGainMargin r x 1 = B := by
  exact initialGainMargin_eq_of_exact_interval (criticalGain_pos hr hB)
    (fun b hb => criticalGain_exact_interval hn r x hr hx hB hb)

/-- The actual initial stable margin strictly increases when every negative
coordinate is reflected, provided the zero-gain factors are admissible. -/
theorem negative_reflection_initial_margin_strict {n : ℕ} (hn : 0 < n)
    (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j)
    (hx : ∀ j, x j ∈ Icc (-1:ℝ) 1)
    (hlo : ∀ j, -(2/r j) ≤ x j) (hneg : ∃ j, x j < 0) :
    initialGainMargin r x 1 < initialGainMargin r (fun j => |x j|) 1 := by
  have habs : ∀ j, |x j| ≤ 1 := fun j => abs_le.mpr (hx j)
  have habscube : ∀ j, |x j| ∈ Icc (0:ℝ) 1 := fun j => ⟨abs_nonneg _,habs j⟩
  obtain ⟨t,⟨ht,hcross⟩,_⟩ := negative_first_phase_crossing r x hr hlo (fun j => (hx j).2) hneg
  have hphase : Phase.totalPhase (fun j => x j+2/r j) x 1 t = Real.pi := by
    apply (Phase.phase_eq_pi_iff_sumRatio _ _ 1 ht).mpr
    simpa only [Phase.sumRatio,sumRatio,Nat.cast_one,mul_one,sub_self,zero_mul,zero_div,sub_zero] using hcross
  have hroot := Cayley.first_crossing_gives_unit_root hr x 1 t hphase
  have hbound : initialGainMargin r x 1 ≤ Cayley.amplitude r x t :=
    initialGainMargin_le_of_unit_root (Cayley.amplitude_pos hr x t) hroot.1 hroot.2.ge
  obtain ⟨B,hB⟩ := criticalGain_exists hn r (fun j => |x j|) hr habscube
  rw [criticalGain_eq_initialMargin hn r _ hr habscube hB]
  apply lt_of_le_of_lt hbound
  rcases hB with ⟨hxp,hS,rfl⟩ | ⟨s,hs,hps,rfl⟩
  · exact reflected_endpoint_critical_gain_strict hn r x hr hxp hneg ht
  · exact (reflected_finite_critical_gain_strict hn r x hr habs hlo hneg ht hs hphase hps).2

/-- Unified half-cube theorem for the actual polynomial: a unique maximizing
parameter vector, an exact stable interval, and its actual supremum. -/
theorem exists_unique_half_cube_margin_optimizer {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    ∃ xstar : Fin n → ℝ, ∃ Bstar : ℝ,
      (∀ j, xstar j ∈ Icc (0:ℝ) 1) ∧ CriticalGain r xstar Bstar ∧
      initialGainMargin r xstar 1 = Bstar ∧
      (∀ b : ℝ, 0 ≤ b → (SchurStable (characteristic r xstar 1 b) ↔ b < Bstar)) ∧
      ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) →
        initialGainMargin r x 1 ≤ Bstar ∧ (initialGainMargin r x 1 = Bstar ↔ x = xstar) := by
  obtain ⟨xstar,Bstar,hxs,hBs,hopt⟩ := exists_unique_global_critical_gain hn r hr
  refine ⟨xstar,Bstar,hxs,hBs,criticalGain_eq_initialMargin hn r _ hr hxs hBs,
    fun b hb => criticalGain_exact_interval hn r _ hr hxs hBs hb,?_⟩
  intro x hx
  obtain ⟨B,hB⟩ := criticalGain_exists hn r x hr hx
  rw [criticalGain_eq_initialMargin hn r x hr hx hB]
  exact hopt x hx B hB

/-- Full-cube corollary for the supremum of the stable interval adjacent to
zero. Every maximizing coordinate lies in the nonnegative half cube. -/
theorem exists_unique_full_cube_margin_optimizer {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    ∃ xstar : Fin n → ℝ, ∃ Bstar : ℝ,
      (∀ j, xstar j ∈ Icc (0:ℝ) 1) ∧ CriticalGain r xstar Bstar ∧
      initialGainMargin r xstar 1 = Bstar ∧
      (∀ b : ℝ, 0 ≤ b → (SchurStable (characteristic r xstar 1 b) ↔ b < Bstar)) ∧
      ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (-1:ℝ) 1) →
        initialGainMargin r x 1 ≤ Bstar ∧ (initialGainMargin r x 1 = Bstar ↔ x = xstar) := by
  obtain ⟨xstar,Bstar,hxs,hBs,hmargin,hstable,hopt⟩ := exists_unique_half_cube_margin_optimizer hn r hr
  refine ⟨xstar,Bstar,hxs,hBs,hmargin,hstable,?_⟩
  intro x hx
  by_cases hnonneg : ∀ j, 0 ≤ x j
  · exact hopt x (fun j => ⟨hnonneg j,(hx j).2⟩)
  have hneg : ∃ j, x j < 0 := by simpa only [not_forall,not_le] using hnonneg
  have hlt : initialGainMargin r x 1 < Bstar := by
    by_cases hadmiss : ∀ j, -(2/r j) ≤ x j
    · have hreflection := negative_reflection_initial_margin_strict hn r x hr hx hadmiss hneg
      have habscube : ∀ j, |x j| ∈ Icc (0:ℝ) 1 := fun j => ⟨abs_nonneg _,abs_le.mpr (hx j)⟩
      exact lt_of_lt_of_le hreflection (hopt (fun j => |x j|) habscube).1
    · obtain ⟨j,hbad⟩ : ∃ j, x j < -(2/r j) := by simpa only [not_forall,not_le] using hadmiss
      rw [initialGainMargin_bad_coordinate_eq_zero hr (fun j => (hx j).1) (le_refl 1) j
        (by simpa only [neg_div] using hbad)]
      exact criticalGain_pos hr hBs
  refine ⟨hlt.le,?_,?_⟩
  · intro heq
    exact False.elim ((ne_of_lt hlt) heq)
  · intro heq
    subst x
    exact hmargin

end C2.NGamma.Global

end

/- ===== C2.NGammaEqualMargin ===== -/

/-! Equal-factor corollary for the actual initial Schur-stable gain margin.
Both explicit optimizers are identified with the supremum defined from roots
of the concrete characteristic polynomial, including the exact stable range. -/
noncomputable section
open scoped BigOperators
open Set C2.NGamma C2.NGamma.Global C2.NGamma.PolynomialModel
namespace C2.NGammaEqual

private lemma actual_margin_of_critical_optimizer {n : ℕ} (hn : 0 < n)
    (r xs : Fin n → ℝ) (hr : ∀ j, 0 < r j) (hxs : ∀ j, xs j ∈ Icc (0:ℝ) 1)
    (B : ℝ) (hB : CriticalGain r xs B)
    (hopt : ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) →
      ∀ C : ℝ, CriticalGain r x C → C ≤ B ∧ (C=B ↔ x=xs)) :
    initialGainMargin r xs 1 = B ∧
      (∀ b : ℝ, 0 ≤ b → (SchurStable (characteristic r xs 1 b) ↔ b<B)) ∧
      ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) →
        initialGainMargin r x 1 ≤ B ∧ (initialGainMargin r x 1=B ↔ x=xs) := by
  refine ⟨criticalGain_eq_initialMargin hn r xs hr hxs hB,
    fun b hb => criticalGain_exact_interval hn r xs hr hxs hB hb,?_⟩
  intro x hx
  obtain ⟨C,hC⟩ := criticalGain_exists hn r x hr hx
  rw [criticalGain_eq_initialMargin hn r x hr hx hC]
  exact hopt x hx C hC

/-- Full endpoint regime of the identical-factor corollary, for actual Schur
stability and its initial margin. The explicit vector is uniquely optimal. -/
theorem identical_endpoint_margin {n : ℕ} (hn : 0 < n) {r : ℝ}
    (hr : 0 < r) (hregime : (n:ℝ)-2 ≤ r) :
    initialGainMargin (fun _ : Fin n => r) (fun _ => endpointCoordinate (n:ℝ) r) 1 = endpointGain n r ∧
      (∀ b : ℝ, 0 ≤ b →
        (SchurStable (characteristic (fun _ : Fin n => r)
          (fun _ => endpointCoordinate (n:ℝ) r) 1 b) ↔ b < endpointGain n r)) ∧
      ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) →
        initialGainMargin (fun _ : Fin n => r) x 1 ≤ endpointGain n r ∧
          (initialGainMargin (fun _ : Fin n => r) x 1 = endpointGain n r ↔
            x=fun _ => endpointCoordinate (n:ℝ) r) := by
  let xs : Fin n → ℝ := fun _ => endpointCoordinate (n:ℝ) r
  have hxpos : 0 < endpointCoordinate (n:ℝ) r := endpointCoordinate_pos (by exact_mod_cast hn)
  have hxone : endpointCoordinate (n:ℝ) r ≤ 1 :=
    (endpointCoordinate_le_one_iff (by exact_mod_cast hn) hr).2 hregime
  have hxs : ∀ j, xs j ∈ Icc (0:ℝ) 1 := fun _ => ⟨hxpos.le,hxone⟩
  have hcost : (∑ _ : Fin n, endpointCost r (endpointCoordinate (n:ℝ) r)) = 1 :=
    equal_resource_sum hn hr.le
  have hgain : endpointGain n r = ∏ _ : Fin n, (r+2/endpointCoordinate (n:ℝ) r) := by
    rw [endpointGain_factor_identity hn]
    simp [endpointGain]
  have hstar : CriticalGain (fun _ : Fin n => r) xs (endpointGain n r) :=
    Or.inl ⟨fun _ => hxpos,hcost.le,hgain⟩
  apply actual_margin_of_critical_optimizer hn (fun _ => r) xs (fun _ => hr) hxs _ hstar
  intro x hx B hB
  have hle : B ≤ endpointGain n r ∧ (B=endpointGain n r → x=xs) := by
    rcases hB with ⟨hxp,hcost,rfl⟩ | ⟨t,ht,hphase,hgain⟩
    · have hh := identical_endpoint_optimal hn hr hregime x (fun j => ⟨hxp j,(hx j).2⟩) hcost
      refine ⟨hh.1,?_⟩
      intro heq
      by_contra hne
      exact (ne_of_lt (hh.2 hne)) heq
    · obtain ⟨w,hw,hp,hprod⟩ := finite_critical_to_frequency
        (fun _ : Fin n => r) x (fun _ => hr) ht hphase hgain
      have hh : B < endpointGain n r := by
        rw [hprod]
        exact identical_endpoint_dominates_finite hn hr hregime hw x hx hp
      exact ⟨hh.le,fun heq => ((ne_of_lt hh) heq).elim⟩
  refine ⟨hle.1,hle.2,?_⟩
  intro heq
  subst x
  exact criticalGain_unique hn _ _ (fun _ => hr) hxs hB hstar

/-- Full finite-frequency regime, with the explicit sine-power gain, unique
angle, exact actual-root Schur interval, and unique global initial-margin design. -/
theorem identical_finite_margin {n : ℕ} (hn : 3 ≤ n) {r : ℝ}
    (hr : 0 < r) (hrn : r < (n:ℝ)-2) :
    ∃ φ : ℝ, φ ∈ Ioo 0 (Real.pi/(n:ℝ)) ∧
      r+1=Real.sin (((n:ℝ)-1)*φ)/Real.sin φ ∧
      (∀ ψ : ℝ, ψ ∈ Ioo 0 (Real.pi/(n:ℝ)) →
        r+1=Real.sin (((n:ℝ)-1)*ψ)/Real.sin ψ → ψ=φ) ∧
      initialGainMargin (fun _ : Fin n => r) (fun _ => 1) 1 =
        (Real.sin ((n:ℝ)*φ)/Real.sin φ)^n ∧
      (∀ b : ℝ, 0 ≤ b →
        (SchurStable (characteristic (fun _ : Fin n => r) (fun _ => 1) 1 b) ↔
          b < (Real.sin ((n:ℝ)*φ)/Real.sin φ)^n)) ∧
      ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) →
        initialGainMargin (fun _ : Fin n => r) x 1 ≤ (Real.sin ((n:ℝ)*φ)/Real.sin φ)^n ∧
        (initialGainMargin (fun _ : Fin n => r) x 1 = (Real.sin ((n:ℝ)*φ)/Real.sin φ)^n ↔
          x=fun _ => 1) := by
  have hn0 : 0 < n := by omega
  obtain ⟨w,φ,hw,hφ,hangle,hp,hgain,hopt⟩ := identical_finite_global_gain hn hr hrn
  have hstar : CriticalGain (fun _ : Fin n => r) (fun _ => 1)
      ((Real.sin ((n:ℝ)*φ)/Real.sin φ)^n) := by
    rw [← hgain]
    exact criticalGain_of_frequency (fun _ : Fin n => r) _ (fun _ => hr) hw hp
  refine ⟨φ,hφ,hangle,?_,?_⟩
  · intro ψ hψ hpψ
    exact finite_angle_unique hn r hψ hφ hpψ hangle
  · apply actual_margin_of_critical_optimizer hn0 (fun _ : Fin n => r) (fun _ => 1)
      (fun _ => hr) (fun _ => by norm_num) _ hstar
    intro x hx B hB
    have hle : B ≤ (Real.sin ((n:ℝ)*φ)/Real.sin φ)^n ∧ (B=(Real.sin ((n:ℝ)*φ)/Real.sin φ)^n → x=fun _ => 1) := by
      rcases hB with ⟨hxp,hcost,hgainB⟩ | ⟨t,ht,hphase,hgainB⟩
      · have hbase := (endpoint_feasible_iff (fun _ : Fin n => r) (fun _ => hr)).mp
          ⟨x,fun j => ⟨hxp j,(hx j).2⟩,hcost⟩
        have hsum : (∑ _ : Fin n, 1/(r+2)) = (n:ℝ)/(r+2) := by simp [div_eq_mul_inv]
        rw [hsum] at hbase
        have hh := (div_le_one (by positivity : 0 < r+2)).mp hbase
        linarith
      · obtain ⟨v,hv,hpv,hprod⟩ := finite_critical_to_frequency
          (fun _ : Fin n => r) x (fun _ => hr) ht hphase hgainB
        rw [hprod]
        have hh := hopt v hv x hx hpv
        exact ⟨hh.1,fun heq => ((hh.2).mp heq).2⟩
    refine ⟨hle.1,hle.2,?_⟩
    intro heq
    subst x
    exact criticalGain_unique hn0 _ _ (fun _ => hr) hx hB hstar

/-- The all-backward-Euler evaluation used above is exactly the project's
actual characteristic polynomial, including the harmless root at zero. -/
lemma identical_backward_characteristic_eval (n : ℕ) (r b : ℝ) (z : ℂ) :
    (characteristic (fun _ : Fin n => r) (fun _ => 1) 1 b).eval z =
      backwardCharacteristic n r b z := by
  simp [characteristic,factor,q,backwardCharacteristic]
  ring_nf
  simp

/-- The two explicitly stated boundary roots are roots of the concrete
characteristic polynomial and both lie on the unit circle. -/
theorem identical_finite_boundary_roots {n : ℕ} {r φ : ℝ}
    (hs : Real.sin φ ≠ 0)
    (hangle : r+1=Real.sin (((n:ℝ)-1)*φ)/Real.sin φ) :
    let B := (Real.sin ((n:ℝ)*φ)/Real.sin φ)^n
    let z := Complex.exp (((Real.pi-(n:ℝ)*φ : ℝ) : ℂ)*Complex.I)
    let zbar := Complex.exp (-(((Real.pi-(n:ℝ)*φ : ℝ) : ℂ)*Complex.I))
    (characteristic (fun _ : Fin n => r) (fun _ => 1) 1 B).eval z=0 ∧
    (characteristic (fun _ : Fin n => r) (fun _ => 1) 1 B).eval zbar=0 ∧
    ‖z‖=1 ∧ ‖zbar‖=1 := by
  dsimp only
  rw [identical_backward_characteristic_eval,identical_backward_characteristic_eval]
  have hh := equal_finite_boundary_pair hs hangle
  refine ⟨hh.1,hh.2,equal_finite_boundary_norm n φ,?_⟩
  rw [Complex.norm_exp]
  simp

lemma finite_angle_sin_ne_zero {n : ℕ} (hn : 0<n) {φ : ℝ}
    (hφ : φ ∈ Ioo 0 (Real.pi/(n:ℝ))) : Real.sin φ ≠ 0 := by
  have hnR : 0<(n:ℝ) := by exact_mod_cast hn
  have hn1 : 1≤(n:ℝ) := by exact_mod_cast hn
  have hh := (lt_div_iff₀ hnR).mp hφ.2
  exact ne_of_gt (Real.sin_pos_of_pos_of_lt_pi hφ.1 (by nlinarith [hφ.1]))

/-- The explicit cubic formula is the actual optimized initial margin. -/
theorem identical_order_three_margin {r : ℝ} (hr : 0<r) (hr1 : r<1) :
    initialGainMargin (fun _ : Fin 3 => r) (fun _ => 1) 1 = (r*(r+2))^3 := by
  obtain ⟨φ,hφ,hangle,huniq,hm,hstable,hmax⟩ :=
    identical_finite_margin (n := 3) (by norm_num) hr (by norm_num; exact hr1)
  rw [hm]
  have hh := order_three_gain (r := r) (φ := φ)
    (finite_angle_sin_ne_zero (by norm_num : 0<(3:ℕ)) hφ)
    (by norm_num at hangle ⊢; exact hangle)
  simpa using hh

/-- The explicit quartic formula is the actual optimized initial margin. -/
theorem identical_order_four_margin {r : ℝ} (hr : 0<r) (hr2 : r<2) :
    initialGainMargin (fun _ : Fin 4 => r) (fun _ => 1) 1 = r^4*(r+2)^2 := by
  obtain ⟨φ,hφ,hangle,huniq,hm,hstable,hmax⟩ :=
    identical_finite_margin (n := 4) (by norm_num) hr (by norm_num; exact hr2)
  rw [hm]
  have hh := order_four_gain (r := r) (φ := φ)
    (finite_angle_sin_ne_zero (by norm_num : 0<(4:ℕ)) hφ)
    (by norm_num at hangle ⊢; exact hangle)
  simpa using hh

/-- The displayed conjugate roots are distinct throughout the finite regime. -/
lemma identical_finite_boundary_distinct {n : ℕ} (hn : 0<n) {φ : ℝ}
    (hφ : φ ∈ Ioo 0 (Real.pi/(n:ℝ))) :
    Complex.exp (((Real.pi-(n:ℝ)*φ : ℝ) : ℂ)*Complex.I) ≠
      Complex.exp (-(((Real.pi-(n:ℝ)*φ : ℝ) : ℂ)*Complex.I)) := by
  have hnR : 0<(n:ℝ) := by exact_mod_cast hn
  have hangle : 0 < Real.pi-(n:ℝ)*φ := by
    have h := (lt_div_iff₀ hnR).mp hφ.2
    nlinarith
  have hanglepi : Real.pi-(n:ℝ)*φ < Real.pi := by nlinarith [mul_pos hnR hφ.1]
  have hs := Real.sin_pos_of_pos_of_lt_pi hangle hanglepi
  intro heq
  have him := congrArg Complex.im heq
  simp [Complex.exp_im] at him
  rw [Real.sin_pi_sub] at hs
  linarith

/-- The explicit endpoint gain has the claimed actual unit-circle root -1. -/
lemma identical_endpoint_boundary {n : ℕ} (hn : 0<n) (r : ℝ) :
    (characteristic (fun _ : Fin n => r) (fun _ => endpointCoordinate (n:ℝ) r)
      1 (endpointGain n r)).eval (-1) = 0 := by
  have hgain : endpointGain n r = ∏ _ : Fin n, (r+2/endpointCoordinate (n:ℝ) r) := by
    rw [endpointGain_factor_identity hn]
    simp [endpointGain]
  rw [hgain]
  exact endpoint_is_root (fun _ => ne_of_gt (endpointCoordinate_pos (by exact_mod_cast hn)))

end C2.NGammaEqual

