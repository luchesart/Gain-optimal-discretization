/- ===== C2.NGammaGlobalTheorems ===== -/

/-! Complete global optimization statements, including the explicit regimes,
the supremal stable gain, strict stability below it, and the boundary root.
The full-cube statement concerns the initial stable interval adjacent to zero. -/
noncomputable section
open scoped BigOperators
open Set
namespace C2.NGamma.Global
open PolynomialModel

def OptimalGainDescription {n : ℕ} (r x : Fin n → ℝ) (B : ℝ) : Prop :=
  (1 < endpointSum r → x = (fun _ => 1) ∧ ∃ t : ℝ, 0 < t ∧
    Phase.totalPhase (fun j => 1+2/r j) (fun _ => 1) 1 t = Real.pi ∧
      B = Cayley.amplitude r (fun _ => 1) t) ∧
  (endpointSum r = 1 → x = (fun _ => 1) ∧ B = ∏ j, (r j+2)) ∧
  (endpointSum r < 1 → ∃ c : ℝ, 0 < c ∧ allocatedResource r c = 4 ∧
    x = (fun j => endpointParameter (r j) c) ∧ B = ∏ j, endpointAllocation (r j) c)

theorem optimalGainDescription_of_parameters {n : ℕ} (hn : 0 < n)
    (r x : Fin n → ℝ) (hr : ∀ j, 0 < r j) (hx : ∀ j, x j ∈ Icc (0:ℝ) 1)
    {B : ℝ} (hB : CriticalGain r x B) (hd : OptimalParameterDescription r x) :
    OptimalGainDescription r x B := by
  refine ⟨?_,?_,?_⟩
  · intro hS
    have hxone := hd.1 hS
    refine ⟨hxone,?_⟩
    rcases hB with ⟨hxp,hcost,hgain⟩ | ⟨t,ht,hp,hgain⟩
    · have hbase := (endpoint_feasible_iff r hr).mp ⟨x,fun j => ⟨hxp j,(hx j).2⟩,hcost⟩
      exact False.elim (not_lt_of_ge hbase hS)
    · refine ⟨t,ht,?_,?_⟩
      · simpa only [hxone] using hp
      · simpa only [hxone] using hgain
  · intro hS
    have hxone := hd.2.1 hS
    refine ⟨hxone,?_⟩
    have hcost : (∑ j, endpointCost (r j) 1) ≤ 1 := by
      have heq : (∑ j, endpointCost (r j) 1) = 1 := by simpa [endpointCost,endpointSum,add_comm] using hS
      exact heq.le
    have hE : CriticalGain r x (∏ j, (r j+2)) := by
      rw [hxone]
      exact Or.inl ⟨fun _ => by norm_num,hcost,by simp⟩
    exact criticalGain_unique hn r x hr hx hB hE
  · intro hS
    obtain ⟨c,hc,hbudget,hxc⟩ := hd.2.2 hS
    refine ⟨c,hc,hbudget,hxc,?_⟩
    have hE : CriticalGain r x (∏ j, endpointAllocation (r j) c) := by
      rw [hxc]
      exact Or.inl ⟨fun j => endpointParameter_pos _ _,(endpointParameter_budget r hr hbudget).le,
        (Finset.prod_congr rfl (fun j _ => endpointParameter_inverse (r j) c)).symm⟩
    exact criticalGain_unique hn r x hr hx hB hE

/-- Complete full-cube result, with the same explicit unique design as the
half-cube theorem and the actual supremum definition of the initial margin. -/
theorem full_cube_initial_margin_global_theorem {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    ∃ xstar : Fin n → ℝ, ∃ Bstar : ℝ,
      (∀ j, xstar j ∈ Icc (0:ℝ) 1) ∧ 0 < Bstar ∧
      OptimalGainDescription r xstar Bstar ∧
      initialGainMargin r xstar 1 = Bstar ∧
      (∀ b : ℝ, 0 ≤ b → (SchurStable (characteristic r xstar 1 b) ↔ b < Bstar)) ∧
      (∃ z : ℂ, ‖z‖ = 1 ∧ (characteristic r xstar 1 Bstar).eval z = 0) ∧
      ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (-1:ℝ) 1) →
        initialGainMargin r x 1 ≤ Bstar ∧ (initialGainMargin r x 1 = Bstar ↔ x = xstar) := by
  obtain ⟨xs,Bs,hxs,hBs,hmargin,hstable,hfull⟩ := exists_unique_full_cube_margin_optimizer hn r hr
  obtain ⟨xc,Bc,hxc,hBc,hdescription,hcritical⟩ := exists_unique_global_critical_gain_classified hn r hr
  have hxcfull : ∀ j, xc j ∈ Icc (-1:ℝ) 1 := fun j => ⟨by linarith [(hxc j).1],(hxc j).2⟩
  have hBc_le : Bc ≤ Bs := by
    have h := (hfull xc hxcfull).1
    rw [criticalGain_eq_initialMargin hn r xc hr hxc hBc] at h
    exact h
  have hBs_le : Bs ≤ Bc := (hcritical xs hxs Bs hBs).1
  have heq : Bs = Bc := le_antisymm hBs_le hBc_le
  have hxeq : xs = xc := (hcritical xs hxs Bs hBs).2.mp heq
  have hd : OptimalParameterDescription r xs := hxeq ▸ hdescription
  exact ⟨xs,Bs,hxs,criticalGain_pos hr hBs,
    optimalGainDescription_of_parameters hn r xs hr hxs hBs hd,
    hmargin,hstable,criticalGain_has_unit_root hr hBs,hfull⟩

/-- The full half-cube theorem: explicit unique global critical gain,
strict stability of every smaller nonnegative gain, and unit-circle roots
at its supremum. The stronger full-cube theorem supplies its optimization. -/
theorem half_cube_global_gain_theorem {n : ℕ} (hn : 0 < n)
    (r : Fin n → ℝ) (hr : ∀ j, 0 < r j) :
    ∃ xstar : Fin n → ℝ, ∃ Bstar : ℝ,
      (∀ j, xstar j ∈ Icc (0:ℝ) 1) ∧ 0 < Bstar ∧
      OptimalGainDescription r xstar Bstar ∧
      initialGainMargin r xstar 1 = Bstar ∧
      (∀ b : ℝ, 0 ≤ b → (SchurStable (characteristic r xstar 1 b) ↔ b < Bstar)) ∧
      (∃ z : ℂ, ‖z‖ = 1 ∧ (characteristic r xstar 1 Bstar).eval z = 0) ∧
      ∀ x : Fin n → ℝ, (∀ j, x j ∈ Icc (0:ℝ) 1) →
        initialGainMargin r x 1 ≤ Bstar ∧ (initialGainMargin r x 1 = Bstar ↔ x = xstar) := by
  obtain ⟨xs,Bs,hxs,hB,hd,hm,hs,hroot,hfull⟩ := full_cube_initial_margin_global_theorem hn r hr
  refine ⟨xs,Bs,hxs,hB,hd,hm,hs,hroot,?_⟩
  intro x hx
  exact hfull x (fun j => ⟨by linarith [(hx j).1],(hx j).2⟩)

end C2.NGamma.Global

end

/- ===== C2.NGammaParameterization ===== -/

/-! Exact affine change between the manuscript's discretization weights gamma
and the proof's coordinates x=2*gamma-1. -/
noncomputable section
open Polynomial
namespace C2.NGamma.Parameterization

def xOfGamma (γ : ℝ) : ℝ := 2*γ-1
def gammaOfX (x : ℝ) : ℝ := (1+x)/2

theorem gammaOfX_xOfGamma (γ : ℝ) : gammaOfX (xOfGamma γ) = γ := by
  unfold gammaOfX xOfGamma
  ring

theorem xOfGamma_gammaOfX (x : ℝ) : xOfGamma (gammaOfX x) = x := by
  unfold gammaOfX xOfGamma
  ring

theorem half_cube_coordinate (γ : ℝ) :
    γ ∈ Set.Icc (1/2:ℝ) 1 ↔ xOfGamma γ ∈ Set.Icc (0:ℝ) 1 := by
  simp only [Set.mem_Icc, xOfGamma]
  constructor <;> rintro ⟨h1,h2⟩ <;> constructor <;> linarith

theorem full_cube_coordinate (γ : ℝ) :
    γ ∈ Set.Icc (0:ℝ) 1 ↔ xOfGamma γ ∈ Set.Icc (-1:ℝ) 1 := by
  simp only [Set.mem_Icc, xOfGamma]
  constructor <;> rintro ⟨h1,h2⟩ <;> constructor <;> linarith

theorem gammaOfX_injective : Function.Injective gammaOfX := by
  intro x y he
  have := congrArg xOfGamma he
  simpa only [xOfGamma_gammaOfX] using this

theorem xOfGamma_injective : Function.Injective xOfGamma := by
  intro x y he
  have := congrArg gammaOfX he
  simpa only [gammaOfX_xOfGamma] using this

theorem numerator_factor (γ : ℝ) :
    PolynomialModel.q (xOfGamma γ) = C (γ:ℂ)*X+C (1-(γ:ℂ)) := by
  apply Polynomial.funext
  intro z
  simp only [PolynomialModel.q_eval, eval_add, eval_mul, eval_C, eval_X]
  unfold xOfGamma
  push_cast
  ring

theorem vector_gamma_equality {ι : Type*} (x y : ι → ℝ) :
    (fun i => gammaOfX (x i)) = (fun i => gammaOfX (y i)) ↔ x=y := by
  constructor
  · intro he
    funext i
    apply gammaOfX_injective
    exact congrFun he i
  · intro he; rw [he]

end C2.NGamma.Parameterization

end

/- ===== C2.PoleMap ===== -/

/-! The actual complex-norm pole map for the common discretization parameter.
No stability predicate is replaced by a coefficient inequality in this file. -/

namespace C2

noncomputable def poleMap (T γ : ℝ) (ζ : ℂ) : ℂ :=
  (1 + (T * (1 - γ) : ℝ) * ζ) / (1 - (T * γ : ℝ) * ζ)

theorem norm_lt_one_iff_normSq_lt_one (z : ℂ) :
    ‖z‖ < 1 ↔ Complex.normSq z < 1 := by
  have hn := norm_nonneg z
  have hs := Complex.sq_norm z
  constructor <;> intro h <;> nlinarith

theorem poleMap_normSq_difference (T γ : ℝ) (ζ : ℂ) :
    Complex.normSq (1 + (T * (1 - γ) : ℝ) * ζ) -
      Complex.normSq (1 - (T * γ : ℝ) * ζ) =
      T * (2 * ζ.re + (1 - 2 * γ) * T * Complex.normSq ζ) := by
  simp [Complex.normSq_apply, Complex.add_re, Complex.add_im,
    Complex.sub_re, Complex.sub_im, Complex.mul_re, Complex.mul_im]
  ring

theorem poleMap_mem_unitDisk_iff (T γ : ℝ) (ζ : ℂ) (hT : 0 < T)
    (hd : (1 - (T * γ : ℝ) * ζ : ℂ) ≠ 0) :
    ‖poleMap T γ ζ‖ < 1 ↔
      2 * ζ.re + (1 - 2 * γ) * T * Complex.normSq ζ < 0 := by
  rw [norm_lt_one_iff_normSq_lt_one, poleMap, Complex.normSq_div]
  have hp : 0 < Complex.normSq (1 - (T * γ : ℝ) * ζ : ℂ) :=
    Complex.normSq_pos.mpr hd
  rw [div_lt_one hp, ← sub_neg, poleMap_normSq_difference]
  constructor
  · intro h
    by_contra h'
    have hp := mul_nonneg hT.le (le_of_not_gt h')
    linarith
  · intro h
    exact mul_neg_of_pos_of_neg hT h

theorem poleMap_denominator_ne_zero (T γ : ℝ) (ζ : ℂ)
    (hT : 0 < T) (hγ : 0 ≤ γ) (hζ : ζ.re < 0) :
    (1 - (T * γ : ℝ) * ζ : ℂ) ≠ 0 := by
  intro he
  have hr := congrArg Complex.re he
  simp only [Complex.sub_re, Complex.one_re, Complex.mul_re,
    Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
    Complex.zero_re] at hr
  have hp : 0 ≤ T * γ := mul_nonneg hT.le hγ
  have hnonpos : T * γ * ζ.re ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hp hζ.le
  linarith

theorem poleMap_preserves_leftHalfPlane (T γ : ℝ) (ζ : ℂ)
    (hT : 0 < T) (hγ : 1 / 2 ≤ γ) (hζ : ζ.re < 0) :
    ‖poleMap T γ ζ‖ < 1 := by
  have hg : 0 ≤ γ := by linarith
  apply (poleMap_mem_unitDisk_iff T γ ζ hT
    (poleMap_denominator_ne_zero T γ ζ hT hg hζ)).mpr
  have hc : 1 - 2 * γ ≤ 0 := by linarith
  have hs := Complex.normSq_nonneg ζ
  have ht : (1 - 2 * γ) * T * Complex.normSq ζ ≤ 0 :=
    mul_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonpos_of_nonneg hc hT.le) hs
  linarith

end C2


/- ===== C2.PoleRadius ===== -/

/-! Exact maximum complex-root norm for the fixed gamma=3/4 characteristic,
and uniqueness of its minimum over the full positive stable-gain interval. -/

noncomputable section
namespace C2.PoleRadius

def characteristic (a : ℝ) (z : ℂ) : ℂ :=
  z^2 + ((3*a/4-1:ℝ):ℂ)*z + ((a/4:ℝ):ℂ)

def discriminant (a : ℝ) : ℝ := (9/16)*(a-4)*(a-4/9)

def upperRoot (a : ℝ) : ℝ := (1-3*a/4+Real.sqrt (discriminant a))/2

def lowerRoot (a : ℝ) : ℝ := (1-3*a/4-Real.sqrt (discriminant a))/2

def rootNorms (a : ℝ) : Set ℝ := {r | ∃ z : ℂ, characteristic a z = 0 ∧ ‖z‖ = r}

def radius (a : ℝ) : ℝ := sSup (rootNorms a)

theorem discriminant_identity (a : ℝ) :
    discriminant a = (1-3*a/4)^2-a := by unfold discriminant; ring

theorem low_discriminant_nonneg {a : ℝ} (ha : a ≤ 4/9) : 0 ≤ discriminant a := by
  unfold discriminant
  have hp := mul_nonneg_of_nonpos_of_nonpos (show a-4 ≤ 0 by linarith)
    (show a-4/9 ≤ 0 by linarith)
  nlinarith

theorem low_roots_nonnegative {a : ℝ} (ha : 0 < a) (haq : a ≤ 4/9) :
    0 ≤ lowerRoot a ∧ lowerRoot a ≤ upperRoot a := by
  have hsq : (Real.sqrt (discriminant a))^2 = (1-3*a/4)^2-a :=
    (Real.sq_sqrt (low_discriminant_nonneg haq)).trans (discriminant_identity a)
  have hs := Real.sqrt_nonneg (discriminant a)
  unfold lowerRoot upperRoot
  constructor <;> nlinarith

theorem low_factorization {a : ℝ} (haq : a ≤ 4/9) (z : ℂ) :
    characteristic a z = (z-(upperRoot a:ℂ))*(z-(lowerRoot a:ℂ)) := by
  have hsq : (Real.sqrt (discriminant a))^2 = (1-3*a/4)^2-a :=
    (Real.sq_sqrt (low_discriminant_nonneg haq)).trans (discriminant_identity a)
  have hsum : upperRoot a + lowerRoot a = 1-3*a/4 := by unfold upperRoot lowerRoot; ring
  have hprod : upperRoot a * lowerRoot a = a/4 := by
    unfold upperRoot lowerRoot
    nlinarith
  have hsumc : (upperRoot a:ℂ)+(lowerRoot a:ℂ) = ((1-3*a/4:ℝ):ℂ) := by exact_mod_cast hsum
  have hprodc : (upperRoot a:ℂ)*(lowerRoot a:ℂ) = ((a/4:ℝ):ℂ) := by exact_mod_cast hprod
  unfold characteristic
  push_cast at hsumc hprodc ⊢
  linear_combination z*hsumc - hprodc

theorem low_radius_isGreatest {a : ℝ} (ha : 0 < a) (haq : a ≤ 4/9) :
    IsGreatest (rootNorms a) (upperRoot a) := by
  obtain ⟨hl,hlu⟩ := low_roots_nonnegative ha haq
  have hu := hl.trans hlu
  constructor
  · refine ⟨(upperRoot a:ℂ),?_,?_⟩
    · rw [low_factorization haq]
      simp
    · simp [Complex.norm_real,abs_of_nonneg hu]
  · rintro r ⟨z,hz,hr⟩
    rw [low_factorization haq] at hz
    rcases mul_eq_zero.mp hz with hz | hz
    · have he : z = (upperRoot a:ℂ) := sub_eq_zero.mp hz
      rw [he] at hr
      simpa [Complex.norm_real,abs_of_nonneg hu] using hr.symm.le
    · have he : z = (lowerRoot a:ℂ) := sub_eq_zero.mp hz
      rw [he] at hr
      have heq : r = lowerRoot a := by simpa [Complex.norm_real,abs_of_nonneg hl] using hr.symm
      rw [heq]
      exact hlu

theorem high_discriminant_nonpos {a : ℝ} (haq : 4/9 ≤ a) (ha4 : a ≤ 4) :
    discriminant a ≤ 0 := by
  unfold discriminant
  have hp := mul_nonpos_of_nonpos_of_nonneg (show a-4 ≤ 0 by linarith)
    (show 0 ≤ a-4/9 by linarith)
  nlinarith

theorem high_root_norm {a : ℝ} (haq : 4/9 ≤ a) (ha4 : a ≤ 4) {z : ℂ}
    (hz : characteristic a z = 0) : ‖z‖ = Real.sqrt a / 2 := by
  have ha : 0 ≤ a := by linarith
  have hs := Real.sq_sqrt ha
  have hsn := Real.sqrt_nonneg a
  have hd := high_discriminant_nonpos haq ha4
  rw [discriminant_identity] at hd
  have hz' : (1:ℂ)*z^2 + ((3*a/4-1:ℝ):ℂ)*z + ((a/4:ℝ):ℂ) = 0 := by
    simpa [characteristic] using hz
  obtain ⟨hre,him⟩ := C2.quadratic_root_parts hz'
  have hlin : 2*z.re+(3*a/4-1)=0 := by
    by_cases hi : z.im = 0
    · rw [hi] at hre
      have hsquare := sq_nonneg (2*z.re+(3*a/4-1))
      nlinarith
    · have h := (mul_eq_zero.mp him).resolve_left hi
      nlinarith
  have hn : ‖z‖^2 = z.re^2+z.im^2 := by
    rw [Complex.sq_norm,Complex.normSq_apply]
    ring
  have hlinmul := congrArg (fun t : ℝ => t*z.re) hlin
  dsimp at hlinmul
  have hnorm : ‖z‖^2 = a/4 := by nlinarith
  nlinarith [norm_nonneg z]

theorem high_radius_isGreatest {a : ℝ} (haq : 4/9 ≤ a) (ha4 : a ≤ 4) :
    IsGreatest (rootNorms a) (Real.sqrt a/2) := by
  obtain ⟨z,hz⟩ := C2.quadratic_has_root (L:=1) (b:=3*a/4-1) (c:=a/4) (by norm_num)
  have hz' : characteristic a z = 0 := by simpa [characteristic] using hz
  constructor
  · exact ⟨z,hz',high_root_norm haq ha4 hz'⟩
  · rintro r ⟨w,hw,hr⟩
    have hn := high_root_norm haq ha4 hw
    linarith

theorem low_radius_formula {a : ℝ} (ha : 0 < a) (haq : a ≤ 4/9) :
    radius a = (1-3*a/4+Real.sqrt ((9/16)*(a-4)*(a-4/9)))/2 := by
  exact (low_radius_isGreatest ha haq).csSup_eq

theorem high_radius_formula {a : ℝ} (haq : 4/9 ≤ a) (ha4 : a ≤ 4) :
    radius a = Real.sqrt a/2 := (high_radius_isGreatest haq ha4).csSup_eq

theorem radius_at_minimum : radius (4/9) = 1/3 := by
  rw [low_radius_formula (by norm_num) (by norm_num)]
  norm_num

/-- The actual maximum complex-root norm has a unique minimum, including
both real-root and complex-conjugate regimes. -/
theorem radius_unique_minimum {a : ℝ} (ha : 0 < a) (ha4 : a < 4) :
    1/3 ≤ radius a ∧ (radius a = 1/3 ↔ a = 4/9) := by
  by_cases haq : a ≤ 4/9
  · have hf : radius a = upperRoot a := (low_radius_isGreatest ha haq).csSup_eq
    rw [hf]
    have hs := Real.sqrt_nonneg (discriminant a)
    constructor
    · unfold upperRoot
      nlinarith
    · constructor
      · intro h
        unfold upperRoot at h
        nlinarith
      · intro h
        subst a
        norm_num [upperRoot,discriminant]
  · have haq' : 4/9 ≤ a := le_of_lt (lt_of_not_ge haq)
    rw [high_radius_formula haq' ha4.le]
    have hs := Real.sq_sqrt ha.le
    have hsn := Real.sqrt_nonneg a
    constructor
    · nlinarith
    · constructor
      · intro h
        nlinarith
      · intro h
        subst a
        norm_num

end C2.PoleRadius

end

/- ===== C2.PoleZeroInterior ===== -/

/-!
# A broader first-order pole-zero family

The normalized characteristic polynomial is
  (1+rγ) z² + [-1+r(1-γ)+a(γ+η)] z + a(1-γ-η).
For v=1-rη>0 its Jury inequalities reduce exactly to the lag problem by
γ' = γ+η, r'=r/v, a'=a/v.  This file proves the global optimizer when the
unconstrained maximizing parameter lies in [0,1].  Endpoint-clamped and
v≤0 regimes are separate claims and are not hidden in this scope.
-/

noncomputable section

namespace C2.PoleZero

def Jury (r η γ a : ℝ) : Prop :=
  0 < a ∧ 0 < 2 + r * (2 * γ - 1) + a * (1 - 2 * γ - 2 * η) ∧
    0 < 1 + r * γ - a * (1 - γ - η)

def v (r η : ℝ) : ℝ := 1 - r * η

def γInterior (r η : ℝ) : ℝ := FirstOrder.γStar (r / v r η) - η

def aInterior (r η : ℝ) : ℝ := v r η * FirstOrder.aStar (r / v r η)

theorem first_identity {r η γ a : ℝ} (hv : 0 < v r η) :
    v r η * (2 + (2 * (γ + η) - 1) * (r / v r η - a / v r η)) =
      2 + r * (2 * γ - 1) + a * (1 - 2 * γ - 2 * η) := by
  have hn : v r η ≠ 0 := ne_of_gt hv
  field_simp [hn]
  dsimp [v]
  ring

theorem second_identity {r η γ a : ℝ} (hv : 0 < v r η) :
    v r η * (1 + (r / v r η) * (γ + η) - (a / v r η) * (1 - (γ + η))) =
      1 + r * γ - a * (1 - γ - η) := by
  have hn : v r η ≠ 0 := ne_of_gt hv
  field_simp [hn]
  dsimp [v]
  ring

theorem jury_scaling {r η γ a : ℝ} (hv : 0 < v r η) :
    Jury r η γ a ↔ FirstOrder.Jury (r / v r η) (γ + η) (a / v r η) := by
  constructor
  · rintro ⟨ha, h₁, h₂⟩
    refine ⟨div_pos ha hv, ?_, ?_⟩
    · have hh := first_identity (γ := γ) (a := a) hv
      by_contra hn
      have hnon := mul_nonpos_of_nonneg_of_nonpos (le_of_lt hv) (le_of_not_gt hn)
      linarith
    · have hh := second_identity (γ := γ) (a := a) hv
      by_contra hn
      have hnon := mul_nonpos_of_nonneg_of_nonpos (le_of_lt hv) (le_of_not_gt hn)
      linarith
  · rintro ⟨ha, h₁, h₂⟩
    have hap := mul_pos hv ha
    have hvn : v r η ≠ 0 := ne_of_gt hv
    have hac : v r η * (a / v r η) = a := by field_simp
    rw [hac] at hap
    refine ⟨hap, ?_, ?_⟩
    · have := mul_pos hv h₁
      rwa [first_identity hv] at this
    · have := mul_pos hv h₂
      rwa [second_identity hv] at this

theorem global_gain_bound {r η γ a : ℝ} (hr : 0 ≤ r) (hv : 0 < v r η)
    (h : Jury r η γ a) : a < aInterior r η := by
  have hscaled := (jury_scaling hv).1 h
  have hb := FirstOrder.global_gain_bound (div_nonneg hr (le_of_lt hv)) hscaled
  unfold aInterior
  have hm := (div_lt_iff₀ hv).1 hb
  simpa only [mul_comm] using hm

theorem interior_parameter_bounds {r η : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η)
    (hv : 0 < v r η) (hint : η ≤ FirstOrder.γStar (r / v r η)) :
    0 ≤ γInterior r η ∧ γInterior r η ≤ 1 := by
  have hb := FirstOrder.γStar_bounds (div_nonneg hr (le_of_lt hv))
  unfold γInterior
  constructor <;> linarith

theorem interior_admissible_iff {r η a : ℝ} (hr : 0 ≤ r)
    (hv : 0 < v r η) :
    Jury r η (γInterior r η) a ↔ 0 < a ∧ a < aInterior r η := by
  rw [jury_scaling hv]
  have heq : γInterior r η + η = FirstOrder.γStar (r / v r η) := by
    unfold γInterior
    ring
  rw [heq, FirstOrder.optimum_admissible_iff (div_nonneg hr (le_of_lt hv))]
  constructor
  · rintro ⟨ha, hb⟩
    have hap := (lt_div_iff₀ hv).1 ha
    have hbp := (div_lt_iff₀ hv).1 hb
    refine ⟨?_, ?_⟩
    · simpa using hap
    · simpa only [aInterior, mul_comm] using hbp
  · rintro ⟨ha, hb⟩
    refine ⟨div_pos ha hv, ?_⟩
    apply (div_lt_iff₀ hv).2
    simpa only [aInterior, mul_comm] using hb

theorem admissible_projection {r η a : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η)
    (hv : 0 < v r η) (hint : η ≤ FirstOrder.γStar (r / v r η)) :
    (∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r η γ a) ↔
      0 < a ∧ a < aInterior r η := by
  constructor
  · rintro ⟨γ, _, _, h⟩
    exact ⟨h.1, global_gain_bound hr hv h⟩
  · intro h
    have hg := interior_parameter_bounds hr hη hv hint
    exact ⟨γInterior r η, hg.1, hg.2, (interior_admissible_iff hr hv).2 h⟩

theorem interior_gain_pos {r η : ℝ} (hr : 0 ≤ r) (hv : 0 < v r η) :
    0 < aInterior r η :=
  mul_pos hv (FirstOrder.aStar_pos (div_nonneg hr (le_of_lt hv)))

theorem interior_gain_isLUB {r η : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η)
    (hv : 0 < v r η) (hint : η ≤ FirstOrder.γStar (r / v r η)) :
    IsLUB {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r η γ a}
      (aInterior r η) := by
  constructor
  · intro a ha
    exact le_of_lt ((admissible_projection hr hη hv hint).1 ha).2
  · intro b hb
    by_contra hn
    have hbA : b < aInterior r η := lt_of_not_ge hn
    have hA := interior_gain_pos hr hv
    let a : ℝ := (max b 0 + aInterior r η) / 2
    have hmax : max b 0 < aInterior r η := max_lt_iff.mpr ⟨hbA, hA⟩
    have ha : 0 < a := by dsimp [a]; nlinarith [le_max_right b 0]
    have haA : a < aInterior r η := by dsimp [a]; linarith
    have hba : b < a := by dsimp [a]; nlinarith [le_max_left b 0]
    have hmem : a ∈ {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r η γ a} :=
      (admissible_projection hr hη hv hint).2 ⟨ha, haA⟩
    have := hb hmem
    linarith

theorem interior_gain_closed_form {r η : ℝ} (hr : 0 ≤ r) (hv : 0 < v r η) :
    aInterior r η = (Real.sqrt (v r η) + Real.sqrt (v r η + r)) ^ 2 := by
  have hr' : 0 ≤ r / v r η := div_nonneg hr (le_of_lt hv)
  have hs := Real.sq_sqrt (le_of_lt hv)
  have ht := Real.sq_sqrt (show 0 ≤ v r η + r by linarith)
  have hu := Real.sq_sqrt (show 0 ≤ 1 + r / v r η by linarith)
  have heq : Real.sqrt (v r η + r) =
      Real.sqrt (v r η) * Real.sqrt (1 + r / v r η) := by
    apply (sq_eq_sq₀ (Real.sqrt_nonneg _)
      (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))).1
    rw [mul_pow, hs, hu, ht]
    field_simp [ne_of_gt hv]
  rw [heq]
  unfold aInterior FirstOrder.aStar
  calc
    v r η * (1 + Real.sqrt (1 + r / v r η)) ^ 2 =
        (Real.sqrt (v r η)) ^ 2 * (1 + Real.sqrt (1 + r / v r η)) ^ 2 := by
      rw [hs]
    _ = _ := by ring

theorem interior_maximizing_parameter_unique {r η γ : ℝ}
    (hr : 0 ≤ r) (hv : 0 < v r η)
    (hS : IsLUB {a : ℝ | Jury r η γ a} (aInterior r η)) :
    γ = γInterior r η := by
  have h₁ := FirstOrder.affine_nonneg_at_lub
    (b := 2 + r * (2 * γ - 1)) (c := 1 - 2 * γ - 2 * η) hS (by
      intro a ha
      simpa only [mul_comm] using ha.2.1)
  have h₂ := FirstOrder.affine_nonneg_at_lub
    (b := 1 + r * γ) (c := -(1 - γ - η)) hS (by
      intro a ha
      have := ha.2.2
      nlinarith)
  have hc₁ := first_identity (γ := γ) (a := aInterior r η) hv
  have hc₂ := second_identity (γ := γ) (a := aInterior r η) hv
  have hscale : aInterior r η / v r η = FirstOrder.aStar (r / v r η) := by
    unfold aInterior
    field_simp [ne_of_gt hv]
  rw [hscale] at hc₁ hc₂
  have hb : FirstOrder.closedJury (r / v r η) (γ + η)
      (FirstOrder.aStar (r / v r η)) := by
    constructor
    · by_contra hn
      have hneg := mul_neg_of_pos_of_neg hv (lt_of_not_ge hn)
      nlinarith [hc₁]
    · by_contra hn
      have hneg := mul_neg_of_pos_of_neg hv (lt_of_not_ge hn)
      nlinarith [hc₂]
  have hγ := FirstOrder.optimal_boundary_unique
    (div_nonneg hr (le_of_lt hv)) hb
  unfold γInterior
  linarith

theorem zero_numerator_parameter {r : ℝ} (hr : 0 ≤ r) :
    γInterior r 0 = FirstOrder.γStar r ∧
      aInterior r 0 = FirstOrder.aStar r := by
  simp [γInterior, aInterior, v]

end C2.PoleZero

end

/- ===== C2.PoleZeroEndpoints ===== -/

/-! Endpoint regimes for the first-order pole-zero optimization.
The admissible gains are strict open intervals; their right endpoints are
suprema, not attained stable gains. All conclusions use the same `Jury`
inequalities as `PoleZeroInterior`. -/

noncomputable section
namespace C2.PoleZero

def aFE (r η : ℝ) : ℝ := (2 - r) / (2 * η - 1)
def aBE (r η : ℝ) : ℝ := (r + 2) / (1 + 2 * η)

/-- Algebraic consequences of the unconstrained optimum lying to the left
of the admissible parameter interval. -/
theorem fe_regime_consequences {r η : ℝ} (hr : 0 ≤ r)
    (hv : 0 < v r η) (hleft : γInterior r η < 0) :
    1 / 2 < η ∧ r < 2 ∧ 0 < r * (1 - η) + 4 * η - 3 := by
  let u := Real.sqrt (1 + r / v r η)
  have hu : 1 ≤ u := (FirstOrder.sqrt_param (div_nonneg hr (le_of_lt hv))).1
  have hud : 0 < 1 + u := by linarith
  let t : ℝ := 1 / (1 + u)
  have ht : 0 < t := one_div_pos.mpr hud
  have heq : FirstOrder.γStar (r / v r η) = 1 / 2 + t / 2 := by
    change 1 / 2 + 1 / (2 * (1 + u)) = 1 / 2 + (1 / (1 + u)) / 2
    field_simp [ne_of_gt hud]
    ring_nf
    simp
  have hη : 1 / 2 + t / 2 < η := by
    unfold γInterior at hleft
    rw [heq] at hleft
    linarith
  have hhalf : 1 / 2 < η := by linarith
  have hvr : v r η = 1 - r * η := rfl
  have hr2 : r < 2 := by nlinarith
  have hs : u ^ 2 = 1 + r / v r η := Real.sq_sqrt (by positivity)
  have hru : r = v r η * (u ^ 2 - 1) := by
    have hd := (eq_div_iff (ne_of_gt hv)).1 (by linarith : u ^ 2 - 1 = r / v r η)
    nlinarith [hd]
  have hroot : r * t ^ 2 + 2 * v r η * t - v r η = 0 := by
    dsimp [t]
    field_simp [ne_of_gt hud]
    nlinarith [hru]
  have hdiff : 0 < (2 * η - 1 - t) *
      (r * (2 * η - 1 + t) + 2 * v r η) := by
    apply mul_pos
    · linarith
    · have hm := mul_nonneg hr (by linarith : 0 ≤ 2 * η - 1 + t)
      linarith
  have hpoly : r * (2 * η - 1) ^ 2 +
      2 * v r η * (2 * η - 1) - v r η =
      r * (1 - η) + 4 * η - 3 := by unfold v; ring
  exact ⟨hhalf, hr2, by nlinarith [hroot, hpoly]⟩

theorem fe_gain_pos {r η : ℝ} (hr2 : r < 2) (hη : 1 / 2 < η) :
    0 < aFE r η := div_pos (by linarith) (by linarith)

theorem fe_gain_above_pole {r η : ℝ} (hv : 0 < v r η)
    (hη : 1 / 2 < η) : r < aFE r η := by
  have hd : 0 < 2 * η - 1 := by linarith
  apply (lt_div_iff₀ hd).2
  unfold v at hv
  nlinarith

/-- The FE endpoint is a global upper bound for every admissible gamma. -/
theorem fe_global_gain_bound {r η γ a : ℝ} (hv : 0 < v r η)
    (hη : 1 / 2 < η) (hγ : 0 ≤ γ) (h : Jury r η γ a) :
    a < aFE r η := by
  have hd : 0 < 2 * η - 1 := by linarith
  have hA := fe_gain_above_pole hv hη
  have hcross : aFE r η * (2 * η - 1) = 2 - r :=
    div_mul_cancel₀ _ (ne_of_gt hd)
  by_contra hn
  have ha : aFE r η ≤ a := le_of_not_gt hn
  have hm := mul_nonneg (sub_nonneg.mpr ha)
    (by linarith : 0 ≤ 2 * γ + 2 * η - 1)
  have hg := mul_nonneg hγ (sub_nonneg.mpr (le_of_lt hA))
  have hj := h.2.1
  nlinarith

/-- The whole interval below the FE upper endpoint is attained at gamma=0. -/
theorem fe_admissible_iff {r η a : ℝ} (hr2 : r < 2)
    (hη : 1 / 2 < η) (hF : 0 < r * (1 - η) + 4 * η - 3) :
    Jury r η 0 a ↔ 0 < a ∧ a < aFE r η := by
  have hd : 0 < 2 * η - 1 := by linarith
  have hcross : aFE r η * (2 * η - 1) = 2 - r :=
    div_mul_cancel₀ _ (ne_of_gt hd)
  have hA := fe_gain_pos hr2 hη
  constructor
  · intro h
    refine ⟨h.1, (lt_div_iff₀ hd).2 ?_⟩
    have hj := h.2.1
    nlinarith
  · rintro ⟨ha, haA⟩
    have hm := mul_pos (sub_pos.mpr haA) hd
    have hJ0A : 0 < 1 - aFE r η * (1 - η) := by
      have heq : (1 - aFE r η * (1 - η)) * (2 * η - 1) =
          r * (1 - η) + 4 * η - 3 := by nlinarith [hcross]
      exact pos_of_mul_pos_left (by rw [heq]; exact hF) (le_of_lt hd)
    refine ⟨ha, ?_, ?_⟩
    · nlinarith
    · by_cases he : η ≤ 1
      · have hx := mul_nonneg (sub_nonneg.mpr (le_of_lt haA)) (sub_nonneg.mpr he)
        nlinarith
      · have hx := mul_nonneg (le_of_lt ha) (by linarith : 0 ≤ η - 1)
        nlinarith

/-- Complete projection of the feasible set in the FE regime. -/
theorem fe_admissible_projection {r η a : ℝ} (hr : 0 ≤ r)
    (hv : 0 < v r η) (hleft : γInterior r η < 0) :
    (∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r η γ a) ↔
      0 < a ∧ a < aFE r η := by
  obtain ⟨hη, hr2, hF⟩ := fe_regime_consequences hr hv hleft
  constructor
  · rintro ⟨γ, hγ, _, hj⟩
    exact ⟨hj.1, fe_global_gain_bound hv hη hγ hj⟩
  · intro h
    exact ⟨0, le_refl _, by norm_num, (fe_admissible_iff hr2 hη hF).2 h⟩

/-- When v<0 every stable point lies to the right of the denominator change. -/
theorem be_positive_shift {r η γ a : ℝ} (hr : 0 ≤ r)
    (hv : v r η < 0) (h : Jury r η γ a) : 0 < 2 * γ + 2 * η - 1 := by
  let t := 2 * γ + 2 * η - 1
  have hj : 0 < 2 * v r η + t * (r - a) := by
    have h₁ := h.2.1
    dsimp [t]
    unfold v
    nlinarith
  have hk : 0 < r - a + 2 * v r η + t * (r + a) := by
    have h₂ := h.2.2
    dsimp [t]
    unfold v
    nlinarith
  by_contra hn
  have ht : t ≤ 0 := le_of_not_gt hn
  have har : r < a := by
    by_contra hn'
    have hm := mul_nonpos_of_nonpos_of_nonneg ht (sub_nonneg.mpr (le_of_not_gt hn'))
    linarith
  have hm := mul_nonpos_of_nonpos_of_nonneg ht (by linarith [h.1] : 0 ≤ r + a)
  linarith

theorem be_gain_pos {r η : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η) :
    0 < aBE r η := div_pos (by linarith) (by linarith)

theorem be_gain_below_pole {r η : ℝ} (hη : 0 ≤ η)
    (hv : v r η < 0) : aBE r η < r := by
  have hd : 0 < 1 + 2 * η := by linarith
  apply (div_lt_iff₀ hd).2
  unfold v at hv
  nlinarith

/-- The BE endpoint globally bounds all stable admissible parameters. -/
theorem be_global_gain_bound {r η γ a : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η)
    (hv : v r η < 0) (hγ : γ ≤ 1) (h : Jury r η γ a) :
    a < aBE r η := by
  have hd : 0 < 1 + 2 * η := by linarith
  have hA := be_gain_below_pole hη hv
  have ht := be_positive_shift hr hv h
  have hcross : aBE r η * (1 + 2 * η) = r + 2 :=
    div_mul_cancel₀ _ (ne_of_gt hd)
  by_contra hn
  have ha : aBE r η ≤ a := le_of_not_gt hn
  have hm := mul_nonneg (sub_nonneg.mpr ha) (le_of_lt ht)
  have hg := mul_nonneg (sub_nonneg.mpr hγ) (sub_nonneg.mpr (le_of_lt hA))
  have hj := h.2.1
  nlinarith

theorem be_admissible_iff {r η a : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η) :
    Jury r η 1 a ↔ 0 < a ∧ a < aBE r η := by
  have hd : 0 < 1 + 2 * η := by linarith
  constructor
  · intro h
    refine ⟨h.1, (lt_div_iff₀ hd).2 ?_⟩
    have hj := h.2.1
    nlinarith
  · rintro ⟨ha, haA⟩
    have hc := (lt_div_iff₀ hd).1 haA
    have hm := mul_nonneg (le_of_lt ha) hη
    exact ⟨ha, by nlinarith, by nlinarith⟩

/-- Complete projection of the feasible set in the negative-residual regime. -/
theorem be_admissible_projection {r η a : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η)
    (hv : v r η < 0) :
    (∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r η γ a) ↔
      0 < a ∧ a < aBE r η := by
  constructor
  · rintro ⟨γ, _, hγ, hj⟩
    exact ⟨hj.1, be_global_gain_bound hr hη hv hγ hj⟩
  · intro h
    exact ⟨1, by norm_num, le_refl _, (be_admissible_iff hr hη).2 h⟩

private theorem gain_isLUB_of_projection {S : Set ℝ} {A : ℝ}
    (hA : 0 < A) (hproj : ∀ a, a ∈ S ↔ 0 < a ∧ a < A) : IsLUB S A := by
  constructor
  · intro a ha
    exact le_of_lt ((hproj a).1 ha).2
  · intro b hb
    by_contra hn
    have hbA : b < A := lt_of_not_ge hn
    let a : ℝ := (max b 0 + A) / 2
    have hmax : max b 0 < A := max_lt_iff.mpr ⟨hbA, hA⟩
    have ha : 0 < a := by dsimp [a]; nlinarith [le_max_right b 0]
    have haA : a < A := by dsimp [a]; linarith
    have hba : b < a := by dsimp [a]; nlinarith [le_max_left b 0]
    have := hb ((hproj a).2 ⟨ha, haA⟩)
    linarith

theorem fe_gain_isLUB {r η : ℝ} (hr : 0 ≤ r)
    (hv : 0 < v r η) (hleft : γInterior r η < 0) :
    IsLUB {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r η γ a} (aFE r η) := by
  obtain ⟨hη, hr2, _⟩ := fe_regime_consequences hr hv hleft
  exact gain_isLUB_of_projection (fe_gain_pos hr2 hη)
    (fun _ => fe_admissible_projection hr hv hleft)

theorem be_gain_isLUB {r η : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η)
    (hv : v r η < 0) :
    IsLUB {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r η γ a} (aBE r η) :=
  gain_isLUB_of_projection (be_gain_pos hr hη)
    (fun _ => be_admissible_projection hr hη hv)

theorem fe_parameter_isLUB {r η : ℝ} (hr : 0 ≤ r)
    (hv : 0 < v r η) (hleft : γInterior r η < 0) :
    IsLUB {a : ℝ | Jury r η 0 a} (aFE r η) := by
  obtain ⟨hη, hr2, hF⟩ := fe_regime_consequences hr hv hleft
  exact gain_isLUB_of_projection (fe_gain_pos hr2 hη)
    (fun _ => fe_admissible_iff hr2 hη hF)

theorem be_parameter_isLUB {r η : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η) :
    IsLUB {a : ℝ | Jury r η 1 a} (aBE r η) :=
  gain_isLUB_of_projection (be_gain_pos hr hη)
    (fun _ => be_admissible_iff hr hη)

/-- FE is the unique parameter whose strict stable gain set has the global
supremum, in the regime where the unconstrained optimum is negative. -/
theorem fe_maximizing_parameter_unique {r η γ : ℝ} (hr : 0 ≤ r)
    (hv : 0 < v r η) (hleft : γInterior r η < 0) (hγ : 0 ≤ γ)
    (hS : IsLUB {a : ℝ | Jury r η γ a} (aFE r η)) : γ = 0 := by
  obtain ⟨hη, _, _⟩ := fe_regime_consequences hr hv hleft
  have hA := fe_gain_above_pole hv hη
  have hd : 0 < 2 * η - 1 := by linarith
  have hcross : aFE r η * (2 * η - 1) = 2 - r :=
    div_mul_cancel₀ _ (ne_of_gt hd)
  have hj := FirstOrder.affine_nonneg_at_lub
    (b := 2 + r * (2 * γ - 1)) (c := 1 - 2 * γ - 2 * η) hS (by
      intro a ha
      simpa only [mul_comm] using ha.2.1)
  by_contra hn
  have hγp : 0 < γ := lt_of_le_of_ne hγ (Ne.symm hn)
  have hm := mul_pos hγp (sub_pos.mpr hA)
  nlinarith

/-- BE is the unique maximizing parameter when the residual v is negative. -/
theorem be_maximizing_parameter_unique {r η γ : ℝ} (hη : 0 ≤ η)
    (hv : v r η < 0) (hγ : γ ≤ 1)
    (hS : IsLUB {a : ℝ | Jury r η γ a} (aBE r η)) : γ = 1 := by
  have hA := be_gain_below_pole hη hv
  have hd : 0 < 1 + 2 * η := by linarith
  have hcross : aBE r η * (1 + 2 * η) = r + 2 :=
    div_mul_cancel₀ _ (ne_of_gt hd)
  have hj := FirstOrder.affine_nonneg_at_lub
    (b := 2 + r * (2 * γ - 1)) (c := 1 - 2 * γ - 2 * η) hS (by
      intro a ha
      simpa only [mul_comm] using ha.2.1)
  by_contra hn
  have hγp : γ < 1 := lt_of_le_of_ne hγ hn
  have hm := mul_pos (sub_pos.mpr hγp) (sub_pos.mpr hA)
  nlinarith

end C2.PoleZero

end

/- ===== C2.PoleZeroSchur ===== -/

namespace C2.PoleZero

/-- Actual complex-root stability for the full one-delay pole-zero model. -/
def Stable (r η γ a : ℝ) : Prop :=
  0 < a ∧ C2.QuadraticSchur (1 + r * γ)
    (-1 + r * (1 - γ) + a * (γ + η)) (a * (1 - γ - η))

theorem stable_iff_jury {r η γ a : ℝ} (hr : 0 ≤ r) (hγ : 0 ≤ γ) :
    Stable r η γ a ↔ Jury r η γ a := by
  have hL : 0 < 1 + r * γ := by nlinarith [mul_nonneg hr hγ]
  unfold Stable Jury
  rw [C2.quadraticSchur_iff hL]
  constructor
  · rintro ⟨ha, h₁, h₂, h₃⟩
    refine ⟨ha, ?_, ?_⟩ <;> nlinarith
  · rintro ⟨ha, h₁, h₂⟩
    refine ⟨ha, ?_, ?_, ?_⟩ <;> nlinarith

theorem stable_global_gain_bound {r η γ a : ℝ} (hr : 0 ≤ r)
    (hγ : 0 ≤ γ) (hv : 0 < v r η) (h : Stable r η γ a) :
    a < aInterior r η :=
  global_gain_bound hr hv ((stable_iff_jury hr hγ).1 h)

theorem interior_stable_iff {r η a : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η)
    (hv : 0 < v r η) (hint : η ≤ FirstOrder.γStar (r / v r η)) :
    Stable r η (γInterior r η) a ↔ 0 < a ∧ a < aInterior r η := by
  rw [stable_iff_jury hr (interior_parameter_bounds hr hη hv hint).1]
  exact interior_admissible_iff hr hv

theorem stable_projection {r η a : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η)
    (hv : 0 < v r η) (hint : η ≤ FirstOrder.γStar (r / v r η)) :
    (∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r η γ a) ↔
      0 < a ∧ a < aInterior r η := by
  constructor
  · rintro ⟨γ, hγ, _, h⟩
    exact ⟨h.1, stable_global_gain_bound hr hγ hv h⟩
  · intro h
    have hg := interior_parameter_bounds hr hη hv hint
    exact ⟨γInterior r η, hg.1, hg.2, (interior_stable_iff hr hη hv hint).2 h⟩

theorem stable_interior_gain_isLUB {r η : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η)
    (hv : 0 < v r η) (hint : η ≤ FirstOrder.γStar (r / v r η)) :
    IsLUB {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r η γ a}
      (aInterior r η) := by
  have heq : {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r η γ a} =
      {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r η γ a} := by
    ext a
    exact (stable_projection hr hη hv hint).trans
      (admissible_projection hr hη hv hint).symm
  rw [heq]
  exact interior_gain_isLUB hr hη hv hint

theorem stable_interior_maximizing_parameter_unique {r η γ : ℝ}
    (hr : 0 ≤ r) (hγ : 0 ≤ γ) (hv : 0 < v r η)
    (hS : IsLUB {a : ℝ | Stable r η γ a} (aInterior r η)) :
    γ = γInterior r η := by
  have heq : {a : ℝ | Stable r η γ a} = {a : ℝ | Jury r η γ a} := by
    ext a
    exact stable_iff_jury hr hγ
  rw [heq] at hS
  exact interior_maximizing_parameter_unique hr hv hS

theorem feasible_stable_eq_jury {r η : ℝ} (hr : 0 ≤ r) :
    {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r η γ a} =
      {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r η γ a} := by
  ext a
  constructor
  · rintro ⟨γ, hγ, hγ1, h⟩
    exact ⟨γ, hγ, hγ1, (stable_iff_jury hr hγ).1 h⟩
  · rintro ⟨γ, hγ, hγ1, h⟩
    exact ⟨γ, hγ, hγ1, (stable_iff_jury hr hγ).2 h⟩

theorem fe_stable_iff {r η a : ℝ} (hr : 0 ≤ r)
    (hv : 0 < v r η) (hleft : γInterior r η < 0) :
    Stable r η 0 a ↔ 0 < a ∧ a < aFE r η := by
  obtain ⟨hη, hr2, hF⟩ := fe_regime_consequences hr hv hleft
  rw [stable_iff_jury hr (le_refl 0)]
  exact fe_admissible_iff hr2 hη hF

theorem be_stable_iff {r η a : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η) :
    Stable r η 1 a ↔ 0 < a ∧ a < aBE r η := by
  rw [stable_iff_jury hr (by norm_num : (0 : ℝ) ≤ 1)]
  exact be_admissible_iff hr hη

theorem fe_stable_projection {r η a : ℝ} (hr : 0 ≤ r)
    (hv : 0 < v r η) (hleft : γInterior r η < 0) :
    (∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r η γ a) ↔
      0 < a ∧ a < aFE r η := by
  have heq := feasible_stable_eq_jury (η := η) hr
  have hmem : a ∈ {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r η γ a} ↔
      a ∈ {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r η γ a} := by rw [heq]
  exact hmem.trans (fe_admissible_projection hr hv hleft)

theorem be_stable_projection {r η a : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η)
    (hv : v r η < 0) :
    (∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r η γ a) ↔
      0 < a ∧ a < aBE r η := by
  have heq := feasible_stable_eq_jury (η := η) hr
  have hmem : a ∈ {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r η γ a} ↔
      a ∈ {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Jury r η γ a} := by rw [heq]
  exact hmem.trans (be_admissible_projection hr hη hv)

theorem fe_stable_gain_isLUB {r η : ℝ} (hr : 0 ≤ r)
    (hv : 0 < v r η) (hleft : γInterior r η < 0) :
    IsLUB {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r η γ a}
      (aFE r η) := by
  rw [feasible_stable_eq_jury hr]
  exact fe_gain_isLUB hr hv hleft

theorem be_stable_gain_isLUB {r η : ℝ} (hr : 0 ≤ r) (hη : 0 ≤ η)
    (hv : v r η < 0) :
    IsLUB {a : ℝ | ∃ γ : ℝ, 0 ≤ γ ∧ γ ≤ 1 ∧ Stable r η γ a}
      (aBE r η) := by
  rw [feasible_stable_eq_jury hr]
  exact be_gain_isLUB hr hη hv

theorem fe_stable_maximizing_parameter_iff {r η γ : ℝ} (hr : 0 ≤ r)
    (hv : 0 < v r η) (hleft : γInterior r η < 0) (hγ : 0 ≤ γ) :
    IsLUB {a : ℝ | Stable r η γ a} (aFE r η) ↔ γ = 0 := by
  have heq : {a : ℝ | Stable r η γ a} = {a : ℝ | Jury r η γ a} := by
    ext a
    exact stable_iff_jury hr hγ
  rw [heq]
  constructor
  · exact fe_maximizing_parameter_unique hr hv hleft hγ
  · intro hg
    rw [hg]
    exact fe_parameter_isLUB hr hv hleft

theorem be_stable_maximizing_parameter_iff {r η γ : ℝ} (hr : 0 ≤ r)
    (hη : 0 ≤ η) (hv : v r η < 0) (hγ : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    IsLUB {a : ℝ | Stable r η γ a} (aBE r η) ↔ γ = 1 := by
  have heq : {a : ℝ | Stable r η γ a} = {a : ℝ | Jury r η γ a} := by
    ext a
    exact stable_iff_jury hr hγ
  rw [heq]
  constructor
  · exact be_maximizing_parameter_unique hη hv hγ1
  · intro hg
    rw [hg]
    exact be_parameter_isLUB hr hη

end C2.PoleZero


/- ===== C2.Reentry ===== -/

/-! # Two disconnected components of a genuine Schur-stable gain set -/

namespace C2

noncomputable def reentryLower : ℝ := (5 - Real.sqrt 5) / 10
noncomputable def reentryUpper : ℝ := (5 + Real.sqrt 5) / 10

theorem reentry_transformed_denominator (z : ℂ) :
    9*(z-1)^2+4*(z-1)*((z+1)/2)+36*((z+1)/2)^2 =
      20*(z^2+4/5) := by ring

theorem reentry_transformed_numerator (z : ℂ) :
    10*(z-1)^2+20*(z-1)*((z+1)/2)+80*((z+1)/2)^2 =
      20*(2*z^2+z+1) := by ring

theorem reentry_characteristic (z k : ℂ) :
    z*(20*(z^2+4/5))+k*(20*(2*z^2+z+1)) =
      20*(z^3+2*k*z^2+(4/5+k)*z+k) := by ring

theorem reentry_continuous_denominator_hurwitz {z : ℂ}
    (hz : 9*z^2+4*z+36=0) : z.re < 0 :=
  quadratic_hurwitz_of_positive (by norm_num) (by norm_num) (by norm_num) hz

theorem reentry_continuous_numerator_hurwitz {z : ℂ}
    (hz : 10*z^2+20*z+80=0) : z.re < 0 :=
  quadratic_hurwitz_of_positive (by norm_num) (by norm_num) (by norm_num) hz

theorem reentry_schur_iff {k : ℝ} (hk : 0 < k) :
    CubicSchur (2*k) (4/5+k) k ↔ k < 9/10 ∧ 0 < k^2-k+1/5 := by
  rw [cubicSchur_iff]
  constructor
  · rintro ⟨_, _, hm, hf⟩
    constructor <;> nlinarith
  · rintro ⟨hku, hf⟩
    refine ⟨?_, by linarith, by linarith, by nlinarith⟩
    rw [abs_of_pos hk]
    linarith

theorem reentry_quadratic_iff (k : ℝ) :
    0 < k^2-k+1/5 ↔ k < reentryLower ∨ reentryUpper < k := by
  have hs : 0 < Real.sqrt (5:ℝ) := Real.sqrt_pos.2 (by norm_num)
  have hsq : (Real.sqrt (5:ℝ))^2 = 5 := Real.sq_sqrt (by norm_num)
  have hab : reentryLower < reentryUpper := by
    dsimp [reentryLower,reentryUpper]
    linarith
  have hfac : k^2-k+1/5 = (k-reentryLower)*(k-reentryUpper) := by
    dsimp [reentryLower,reentryUpper]
    nlinarith [hsq]
  rw [hfac, mul_pos_iff]
  constructor
  · rintro (⟨_,hb⟩ | ⟨ha,_⟩)
    · right; linarith
    · left; linarith
  · rintro (ha | hb)
    · right; constructor <;> linarith
    · left; constructor <;> linarith

theorem reentry_exact_intervals {k : ℝ} (hk : 0 < k) :
    CubicSchur (2*k) (4/5+k) k ↔
      (k < reentryLower ∨ reentryUpper < k) ∧ k < 9/10 := by
  rw [reentry_schur_iff hk, reentry_quadratic_iff]
  exact and_comm

theorem reentry_stable_one_tenth : CubicSchur (1/5) (9/10) (1/10) := by
  rw [cubicSchur_iff]
  norm_num [abs_of_nonneg]

theorem reentry_unstable_one_half : ¬ CubicSchur 1 (13/10) (1/2) := by
  rw [cubicSchur_iff]
  norm_num [abs_of_nonneg]

theorem reentry_stable_four_fifths : CubicSchur (8/5) (8/5) (4/5) := by
  rw [cubicSchur_iff]
  norm_num [abs_of_nonneg]

end C2


/- ===== C2.RegionCompletionPoleZero ===== -/

namespace C2.PoleZero

/-- Every fixed-parameter positive stable gain set is open. -/
theorem stable_gain_set_isOpen {r η γ : ℝ} (hr : 0 ≤ r) (hγ : 0 ≤ γ) :
    IsOpen {a : ℝ | Stable r η γ a} := by
  have heq : {a : ℝ | Stable r η γ a} =
      {a : ℝ | 0 < a} ∩ {a : ℝ | 0 < 2 + (2*γ-1)*r + a*(1-2*γ-2*η)} ∩
      {a : ℝ | 0 < 1+r*γ-a*(1-γ-η)} := by
    ext a
    simp only [Set.mem_inter_iff, Set.mem_setOf_eq]
    rw [stable_iff_jury hr hγ]
    unfold Jury
    constructor
    · rintro ⟨h₁,h₂,h₃⟩
      exact ⟨⟨h₁,by nlinarith⟩,h₃⟩
    · rintro ⟨⟨h₁,h₂⟩,h₃⟩
      exact ⟨h₁,by nlinarith,h₃⟩
  rw [heq]
  exact ((isOpen_lt continuous_const continuous_id).inter
    (isOpen_lt continuous_const (by fun_prop))).inter
      (isOpen_lt continuous_const (by fun_prop))

/-- Affine Jury inequalities make the positive stable set order convex,
including the empty case and intervals whose lower endpoint is positive. -/
theorem stable_gain_set_ordConnected {r η γ : ℝ} (hr : 0 ≤ r) (hγ : 0 ≤ γ) :
    Set.OrdConnected {a : ℝ | Stable r η γ a} := by
  refine ⟨?_⟩
  intro x hx y hy z hz
  have hx' := (stable_iff_jury hr hγ).mp hx
  have hy' := (stable_iff_jury hr hγ).mp hy
  apply (stable_iff_jury hr hγ).mpr
  unfold Jury at hx' hy' ⊢
  obtain ⟨hx0,hx1,hx2⟩ := hx'
  obtain ⟨hy0,hy1,hy2⟩ := hy'
  obtain ⟨hxz,hzy⟩ := hz
  refine ⟨lt_of_lt_of_le hx0 hxz,?_,?_⟩
  · by_cases hc : 0 ≤ 1 - 2 * γ - 2 * η
    · nlinarith [mul_nonneg hc (sub_nonneg.mpr hxz)]
    · nlinarith [mul_nonneg_of_nonpos_of_nonpos (le_of_not_ge hc) (sub_nonpos.mpr hzy)]
  · by_cases hc : 0 ≤ 1 - γ - η
    · nlinarith [mul_nonneg hc (sub_nonneg.mpr hzy)]
    · nlinarith [mul_nonneg_of_nonpos_of_nonpos (le_of_not_ge hc) (sub_nonpos.mpr hxz)]

theorem stable_gain_set_bddAbove {r η γ : ℝ} (hr : 0 ≤ r) (hγ : 0 ≤ γ) :
    BddAbove {a : ℝ | Stable r η γ a} := by
  refine ⟨4+r*(4*γ-1),?_⟩
  intro a ha
  have h := (stable_iff_jury hr hγ).mp ha
  unfold Jury at h
  nlinarith [h.2.1,h.2.2]

/-- Full interval formulation: the positive stable gain set is either empty
or one bounded open interval. Its lower endpoint is not assumed to be zero. -/
theorem stable_gain_set_empty_or_open_interval {r η γ : ℝ}
    (hr : 0 ≤ r) (hγ : 0 ≤ γ) :
    {a : ℝ | Stable r η γ a} = ∅ ∨
      ∃ lo hi : ℝ, lo < hi ∧ {a : ℝ | Stable r η γ a} = Set.Ioo lo hi := by
  let S : Set ℝ := {a : ℝ | Stable r η γ a}
  by_cases hS : S.Nonempty
  · right
    have hb : BddBelow S := ⟨0,fun _ ha => ha.1.le⟩
    have ht : BddAbove S := stable_gain_set_bddAbove hr hγ
    have ho : IsOpen S := stable_gain_set_isOpen hr hγ
    have hc : Set.OrdConnected S := stable_gain_set_ordConnected hr hγ
    have heq : S = Set.Ioo (sInf S) (sSup S) := by
      ext a
      constructor
      · intro ha
        obtain ⟨lo,hi,⟨hla,hah⟩,hsub⟩ := mem_nhds_iff_exists_Ioo_subset.mp (ho.mem_nhds ha)
        obtain ⟨l,hll,hla'⟩ := exists_between hla
        obtain ⟨h,hah',hhh⟩ := exists_between hah
        have hlS : l ∈ S := hsub ⟨hll,hla'.trans hah⟩
        have hhS : h ∈ S := hsub ⟨hla.trans hah',hhh⟩
        exact ⟨(csInf_le hb hlS).trans_lt hla',hah'.trans_le (le_csSup ht hhS)⟩
      · rintro ⟨hl,hh⟩
        obtain ⟨l,hlS,hla⟩ := exists_lt_of_csInf_lt hS hl
        obtain ⟨h,hhS,hah⟩ := exists_lt_of_lt_csSup hS hh
        exact hc.out hlS hhS ⟨hla.le,hah.le⟩
    obtain ⟨a,ha⟩ := hS
    have ha' : a ∈ Set.Ioo (sInf S) (sSup S) := heq ▸ ha
    exact ⟨sInf S,sSup S,ha'.1.trans ha'.2,heq⟩
  · left
    exact Set.not_nonempty_iff_eq_empty.mp hS

end C2.PoleZero


/- ===== C2.RegionCompletion ===== -/


/- ===== C2.Robustness ===== -/

/-! Exact closed rectangular robustness box for the one-sample integrator.
The conclusion uses actual complex-root Schur stability, via FirstOrder.Stable.
-/
namespace C2.Robustness

def BoxStable (a₀ δ ρ : ℝ) : Prop :=
  ∀ γ ∈ Set.Icc (3 / 4 - δ) (3 / 4 + δ),
    ∀ a ∈ Set.Icc (a₀ * (1 - ρ)) (a₀ * (1 + ρ)),
      C2.FirstOrder.Stable 0 γ a

theorem exact_rectangular_budget {a₀ δ ρ : ℝ}
    (ha₀ : 0 < a₀) (hδ : 0 ≤ δ) (hδu : δ ≤ 1 / 4)
    (hρ : 0 ≤ ρ) (hρu : ρ < 1) :
    BoxStable a₀ δ ρ ↔ a₀ < 4 / ((1 + ρ) * (1 + 4 * δ)) := by
  have hp : 0 < (1 + ρ) * (1 + 4 * δ) := mul_pos (by linarith) (by linarith)
  rw [lt_div_iff₀ hp]
  constructor
  · intro h
    have hs := h (3 / 4 - δ) ⟨le_rfl, by linarith⟩
      (a₀ * (1 + ρ)) ⟨by nlinarith only [mul_nonneg ha₀.le hρ], le_rfl⟩
    have hj := (C2.FirstOrder.stable_iff_jury (r := 0) (by norm_num)
      (γ := 3 / 4 - δ) (by linarith)).mp hs
    unfold C2.FirstOrder.Jury at hj
    nlinarith only [hj.2.2]
  · intro hb
    intro γ hγ a ha
    have hγ0 : 0 ≤ γ := by linarith [hγ.1]
    apply (C2.FirstOrder.stable_iff_jury (r := 0) (by norm_num) hγ0).mpr
    have ha0 : 0 < a := lt_of_lt_of_le (mul_pos ha₀ (by linarith)) ha.1
    have hcap : a * (1 + 4 * δ) < 4 := by
      have hm := mul_le_mul_of_nonneg_right ha.2 (by linarith : 0 ≤ 1 + 4 * δ)
      nlinarith only [hm, hb]
    unfold C2.FirstOrder.Jury
    refine ⟨ha0, ?_, ?_⟩
    · have hm := mul_le_mul_of_nonneg_left hγ.2 ha0.le
      nlinarith only [hm, hcap]
    · have hm := mul_le_mul_of_nonneg_left hγ.1 ha0.le
      nlinarith only [hm, hcap]

end C2.Robustness


/- ===== C2.RobustAsymmetric ===== -/

/-!
# Exact asymmetric robustness and optimal nominal center

The stability predicate is the existing complex-root Schur predicate.
The parameter box is closed and contained in [0,1]; its width may be any
number from 0 through 1. Gain uncertainty is constant, not switching.
-/

noncomputable section

namespace C2.Robustness

def IntervalStable (l u al au : ℝ) : Prop :=
  ∀ γ ∈ Set.Icc l u, ∀ a ∈ Set.Icc al au,
    C2.FirstOrder.Stable 0 γ a

/-- Two upper-gain endpoint inequalities characterize the entire rectangle. -/
theorem exact_interval_rectangle {l u al au : ℝ}
    (hl : 0 ≤ l) (hlu : l ≤ u) (hu : u ≤ 1)
    (hal : 0 < al) (ha : al ≤ au) :
    IntervalStable l u al au ↔ au * (1 - l) < 1 ∧ au * (u - 1 / 2) < 1 := by
  have hau : 0 < au := hal.trans_le ha
  constructor
  · intro h
    have hL := (C2.FirstOrder.stable_iff_jury (r := 0) (by norm_num) hl).mp
      (h l ⟨le_rfl, hlu⟩ au ⟨ha, le_rfl⟩)
    have hU := (C2.FirstOrder.stable_iff_jury (r := 0) (by norm_num)
      (hl.trans hlu)).mp (h u ⟨hlu, le_rfl⟩ au ⟨ha, le_rfl⟩)
    unfold C2.FirstOrder.Jury at hL hU
    constructor <;> nlinarith [hL.2.2, hU.2.1]
  · rintro ⟨hL, hU⟩ γ hγ a ha'
    have ha0 : 0 < a := hal.trans_le ha'.1
    apply (C2.FirstOrder.stable_iff_jury (r := 0) (by norm_num)
      (hl.trans hγ.1)).mpr
    have hsecond : a * (1 - γ) < 1 := by
      have h₁ := mul_le_mul_of_nonneg_right ha'.2
        (show 0 ≤ 1 - γ by linarith [hγ.2])
      have h₂ := mul_le_mul_of_nonneg_left
        (show 1 - γ ≤ 1 - l by linarith [hγ.1]) hau.le
      exact lt_of_le_of_lt (h₁.trans h₂) hL
    have hfirst : a * (γ - 1 / 2) < 1 := by
      by_cases hc : γ ≤ 1 / 2
      · have hm := mul_nonpos_of_nonneg_of_nonpos ha0.le
          (show γ - 1 / 2 ≤ 0 by linarith)
        linarith
      · have h₁ := mul_le_mul_of_nonneg_right ha'.2
          (show 0 ≤ γ - 1 / 2 by linarith)
        have h₂ := mul_le_mul_of_nonneg_left
          (show γ - 1 / 2 ≤ u - 1 / 2 by linarith [hγ.2]) hau.le
        exact lt_of_le_of_lt (h₁.trans h₂) hU
    unfold C2.FirstOrder.Jury
    exact ⟨ha0, by nlinarith, by nlinarith⟩

def AsymmetricBoxStable (c dm dp a₀ ρ : ℝ) : Prop :=
  IntervalStable (c - dm) (c + dp) (a₀ * (1 - ρ)) (a₀ * (1 + ρ))

def budgetDenominator (c dm dp : ℝ) : ℝ :=
  max (1 - c + dm) (c + dp - 1 / 2)

def nominalCap (c dm dp ρ : ℝ) : ℝ :=
  1 / ((1 + ρ) * budgetDenominator c dm dp)

def optimalCenter (dm dp : ℝ) : ℝ :=
  min (3 / 4 + (dm - dp) / 2) (1 - dp)

def optimalDenominator (dm dp : ℝ) : ℝ :=
  max ((1 + 2 * (dm + dp)) / 4) (dm + dp)

theorem budgetDenominator_pos {c dm dp : ℝ} (hm : 0 ≤ dm) (hp : 0 ≤ dp) :
    0 < budgetDenominator c dm dp := by
  have h₁ := le_max_left (1 - c + dm) (c + dp - 1 / 2)
  have h₂ := le_max_right (1 - c + dm) (c + dp - 1 / 2)
  unfold budgetDenominator
  linarith

theorem mul_max_lt_one_iff {A x y : ℝ} (hA : 0 ≤ A) :
    A * max x y < 1 ↔ A * x < 1 ∧ A * y < 1 := by
  rcases le_total x y with h | h
  · rw [max_eq_right h]
    exact ⟨fun hy => ⟨lt_of_le_of_lt (mul_le_mul_of_nonneg_left h hA) hy, hy⟩,
      fun hxy => hxy.2⟩
  · rw [max_eq_left h]
    exact ⟨fun hx => ⟨hx, lt_of_le_of_lt (mul_le_mul_of_nonneg_left h hA) hx⟩,
      fun hxy => hxy.1⟩

/-- Exact budget for any asymmetric box contained in the physical parameter interval. -/
theorem exact_asymmetric_budget {c dm dp a₀ ρ : ℝ}
    (hm : 0 ≤ dm) (hp : 0 ≤ dp) (hc : dm ≤ c) (hcu : c ≤ 1 - dp)
    (ha : 0 < a₀) (hρ : 0 ≤ ρ) (hρu : ρ < 1) :
    AsymmetricBoxStable c dm dp a₀ ρ ↔ a₀ < nominalCap c dm dp ρ := by
  have hgain : 0 < 1 + ρ := by linarith
  have hA : 0 < a₀ * (1 + ρ) := mul_pos ha hgain
  have hden := budgetDenominator_pos (c := c) hm hp
  have hrect := exact_interval_rectangle
    (l := c - dm) (u := c + dp) (al := a₀ * (1 - ρ)) (au := a₀ * (1 + ρ))
    (by linarith) (by linarith) (by linarith)
    (mul_pos ha (by linarith))
    (by nlinarith [mul_nonneg ha.le hρ])
  rw [AsymmetricBoxStable, hrect]
  unfold nominalCap
  rw [lt_div_iff₀ (mul_pos hgain hden)]
  rw [← mul_assoc]
  rw [show 1 - (c - dm) = 1 - c + dm by ring]
  exact (mul_max_lt_one_iff hA.le).symm

/-- At a prescribed nominal gain, the complete set of feasible centers is
the intersection of the physical closed interval with these strict bounds. -/
theorem exact_center_interval {c dm dp a₀ ρ : ℝ}
    (hm : 0 ≤ dm) (hp : 0 ≤ dp) (hc : dm ≤ c) (hcu : c ≤ 1 - dp)
    (ha : 0 < a₀) (hρ : 0 ≤ ρ) (hρu : ρ < 1) :
    AsymmetricBoxStable c dm dp a₀ ρ ↔
      1 + dm - 1 / (a₀ * (1 + ρ)) < c ∧
        c < 1 / 2 - dp + 1 / (a₀ * (1 + ρ)) := by
  have hA : 0 < a₀ * (1 + ρ) := mul_pos ha (by linarith)
  have hrect := exact_interval_rectangle
    (l := c - dm) (u := c + dp) (al := a₀ * (1 - ρ)) (au := a₀ * (1 + ρ))
    (by linarith) (by linarith) (by linarith)
    (mul_pos ha (by linarith)) (by nlinarith [mul_nonneg ha.le hρ])
  rw [AsymmetricBoxStable, hrect]
  have hleft : a₀ * (1 + ρ) * (1 - (c - dm)) < 1 ↔
      1 + dm - 1 / (a₀ * (1 + ρ)) < c := by
    rw [mul_comm (a₀ * (1 + ρ)), ← lt_div_iff₀ hA]
    constructor <;> intro h <;> linarith
  have hright : a₀ * (1 + ρ) * (c + dp - 1 / 2) < 1 ↔
      c < 1 / 2 - dp + 1 / (a₀ * (1 + ρ)) := by
    rw [mul_comm (a₀ * (1 + ρ)), ← lt_div_iff₀ hA]
    constructor <;> intro h <;> linarith
  exact and_congr hleft hright

theorem optimalCenter_admissible {dm dp : ℝ}
    (hw : dm + dp ≤ 1) :
    dm ≤ optimalCenter dm dp ∧ optimalCenter dm dp ≤ 1 - dp := by
  unfold optimalCenter
  exact ⟨le_min (by linarith) (by linarith), min_le_right _ _⟩

theorem optimalCenter_small {dm dp : ℝ} (hw : dm + dp ≤ 1 / 2) :
    optimalCenter dm dp = 3 / 4 + (dm - dp) / 2 := by
  exact min_eq_left (by linarith)

theorem optimalCenter_large {dm dp : ℝ} (hw : 1 / 2 ≤ dm + dp) :
    optimalCenter dm dp = 1 - dp := by
  exact min_eq_right (by linarith)

theorem optimal_interval_small {dm dp : ℝ} (hw : dm + dp ≤ 1 / 2) :
    optimalCenter dm dp - dm = 3 / 4 - (dm + dp) / 2 ∧
      optimalCenter dm dp + dp = 3 / 4 + (dm + dp) / 2 := by
  rw [optimalCenter_small hw]
  constructor <;> ring

theorem optimal_interval_large {dm dp : ℝ} (hw : 1 / 2 ≤ dm + dp) :
    optimalCenter dm dp - dm = 1 - (dm + dp) ∧
      optimalCenter dm dp + dp = 1 := by
  rw [optimalCenter_large hw]
  constructor <;> ring

theorem optimalDenominator_small {dm dp : ℝ} (hw : dm + dp ≤ 1 / 2) :
    optimalDenominator dm dp = (1 + 2 * (dm + dp)) / 4 := by
  exact max_eq_left (by linarith)

theorem optimalDenominator_large {dm dp : ℝ} (hw : 1 / 2 ≤ dm + dp) :
    optimalDenominator dm dp = dm + dp := by
  exact max_eq_right (by linarith)

theorem budgetDenominator_at_optimalCenter (dm dp : ℝ) :
    budgetDenominator (optimalCenter dm dp) dm dp = optimalDenominator dm dp := by
  by_cases hw : dm + dp ≤ 1 / 2
  · rw [optimalCenter_small hw, optimalDenominator_small hw]
    unfold budgetDenominator
    have h₁ : 1 - (3 / 4 + (dm - dp) / 2) + dm = (1 + 2 * (dm + dp)) / 4 := by ring
    have h₂ : (3 / 4 + (dm - dp) / 2) + dp - 1 / 2 = (1 + 2 * (dm + dp)) / 4 := by ring
    rw [h₁, h₂, max_self]
  · have hw' : 1 / 2 ≤ dm + dp := le_of_not_ge hw
    rw [optimalCenter_large hw', optimalDenominator_large hw']
    unfold budgetDenominator
    have h₁ : 1 - (1 - dp) + dm = dm + dp := by ring
    have h₂ : (1 - dp) + dp - 1 / 2 = (1 : ℝ) / 2 := by ring
    rw [h₁, h₂, max_eq_left hw']

theorem budgetDenominator_lower_bound {c dm dp : ℝ} (hcu : c ≤ 1 - dp) :
    optimalDenominator dm dp ≤ budgetDenominator c dm dp := by
  have h₁ := le_max_left (1 - c + dm) (c + dp - 1 / 2)
  have h₂ := le_max_right (1 - c + dm) (c + dp - 1 / 2)
  unfold optimalDenominator budgetDenominator
  apply max_le <;> linarith

/-- The minimax denominator has a unique minimizer, including widths 0, 1/2 and 1. -/
theorem budgetDenominator_eq_iff {c dm dp : ℝ} (hcu : c ≤ 1 - dp) :
    budgetDenominator c dm dp = optimalDenominator dm dp ↔ c = optimalCenter dm dp := by
  constructor
  · intro h
    have h₁ : 1 - c + dm ≤ optimalDenominator dm dp := by
      rw [← h]; exact le_max_left _ _
    have h₂ : c + dp - 1 / 2 ≤ optimalDenominator dm dp := by
      rw [← h]; exact le_max_right _ _
    by_cases hw : dm + dp ≤ 1 / 2
    · rw [optimalDenominator_small hw] at h₁ h₂
      rw [optimalCenter_small hw]
      linarith
    · have hw' : 1 / 2 ≤ dm + dp := le_of_not_ge hw
      rw [optimalDenominator_large hw'] at h₁
      rw [optimalCenter_large hw']
      linarith
  · rintro rfl
    exact budgetDenominator_at_optimalCenter dm dp

theorem nominalCap_pos {c dm dp ρ : ℝ}
    (hm : 0 ≤ dm) (hp : 0 ≤ dp) (hρ : 0 ≤ ρ) :
    0 < nominalCap c dm dp ρ :=
  div_pos zero_lt_one (mul_pos (by linarith) (budgetDenominator_pos hm hp))

/-- The cap is the actual supremum of positive nominal gains satisfying
complex-root stability for the full uncertainty box. -/
theorem nominal_cap_isLUB {c dm dp ρ : ℝ}
    (hm : 0 ≤ dm) (hp : 0 ≤ dp) (hc : dm ≤ c) (hcu : c ≤ 1 - dp)
    (hρ : 0 ≤ ρ) (hρu : ρ < 1) :
    IsLUB {a₀ : ℝ | 0 < a₀ ∧ AsymmetricBoxStable c dm dp a₀ ρ}
      (nominalCap c dm dp ρ) := by
  have hset : {a₀ : ℝ | 0 < a₀ ∧ AsymmetricBoxStable c dm dp a₀ ρ} =
      Set.Ioo 0 (nominalCap c dm dp ρ) := by
    ext a₀
    constructor
    · rintro ⟨ha, hs⟩
      exact ⟨ha, (exact_asymmetric_budget hm hp hc hcu ha hρ hρu).mp hs⟩
    · rintro ⟨ha, hb⟩
      exact ⟨ha, (exact_asymmetric_budget hm hp hc hcu ha hρ hρu).mpr hb⟩
  rw [hset]
  exact isLUB_Ioo (nominalCap_pos hm hp hρ)

/-- The unique center maximizing the admissible nominal-gain supremum. -/
theorem nominalCap_optimal_unique {c dm dp ρ : ℝ}
    (hm : 0 ≤ dm) (hp : 0 ≤ dp) (hcu : c ≤ 1 - dp) (hρ : 0 ≤ ρ) :
    nominalCap c dm dp ρ ≤ nominalCap (optimalCenter dm dp) dm dp ρ ∧
      (nominalCap c dm dp ρ = nominalCap (optimalCenter dm dp) dm dp ρ ↔
        c = optimalCenter dm dp) := by
  have hρp : 0 < 1 + ρ := by linarith
  have hd := budgetDenominator_pos (c := c) hm hp
  have ho := budgetDenominator_pos (c := optimalCenter dm dp) hm hp
  have hmin := budgetDenominator_lower_bound (dm := dm) hcu
  rw [← budgetDenominator_at_optimalCenter dm dp] at hmin
  constructor
  · unfold nominalCap
    apply (div_le_div_iff₀ (mul_pos hρp hd) (mul_pos hρp ho)).mpr
    simpa using mul_le_mul_of_nonneg_left hmin hρp.le
  · constructor
    · intro he
      unfold nominalCap at he
      have hc := (div_eq_div_iff (mul_pos hρp hd).ne' (mul_pos hρp ho).ne').mp he
      have hz : (1 + ρ) * (budgetDenominator c dm dp -
          budgetDenominator (optimalCenter dm dp) dm dp) = 0 := by nlinarith [hc]
      have heq := sub_eq_zero.mp ((mul_eq_zero.mp hz).resolve_left hρp.ne')
      rw [budgetDenominator_at_optimalCenter] at heq
      exact (budgetDenominator_eq_iff hcu).mp heq
    · rintro rfl
      rfl

theorem robust_maximizing_center_iff {c dm dp ρ : ℝ}
    (hm : 0 ≤ dm) (hp : 0 ≤ dp) (hc : dm ≤ c) (hcu : c ≤ 1 - dp)
    (hρ : 0 ≤ ρ) (hρu : ρ < 1) :
    IsLUB {a₀ : ℝ | 0 < a₀ ∧ AsymmetricBoxStable c dm dp a₀ ρ}
      (nominalCap (optimalCenter dm dp) dm dp ρ) ↔ c = optimalCenter dm dp := by
  constructor
  · intro hs
    exact (nominalCap_optimal_unique hm hp hcu hρ).2.mp
      ((nominal_cap_isLUB hm hp hc hcu hρ hρu).unique hs)
  · rintro rfl
    exact nominal_cap_isLUB hm hp hc hcu hρ hρu

theorem optimal_nominalCap_small {dm dp ρ : ℝ}
    (hm : 0 ≤ dm) (hp : 0 ≤ dp) (hρ : 0 ≤ ρ) (hw : dm + dp ≤ 1 / 2) :
    nominalCap (optimalCenter dm dp) dm dp ρ =
      4 / ((1 + ρ) * (1 + 2 * (dm + dp))) := by
  unfold nominalCap
  rw [budgetDenominator_at_optimalCenter, optimalDenominator_small hw]
  have h₁ : 1 + ρ ≠ 0 := by linarith
  have h₂ : 1 + 2 * (dm + dp) ≠ 0 := by linarith
  field_simp [h₁, h₂]

theorem optimal_nominalCap_large {dm dp ρ : ℝ} (hw : 1 / 2 ≤ dm + dp) :
    nominalCap (optimalCenter dm dp) dm dp ρ = 1 / ((1 + ρ) * (dm + dp)) := by
  unfold nominalCap
  rw [budgetDenominator_at_optimalCenter, optimalDenominator_large hw]

/-- Exact design feasibility: the computed optimal center realizes every
strictly subcritical gain, and no other admissible center improves the cap. -/
theorem exists_robust_center_iff {dm dp a₀ ρ : ℝ}
    (hm : 0 ≤ dm) (hp : 0 ≤ dp) (hw : dm + dp ≤ 1)
    (ha : 0 < a₀) (hρ : 0 ≤ ρ) (hρu : ρ < 1) :
    (∃ c, dm ≤ c ∧ c ≤ 1 - dp ∧ AsymmetricBoxStable c dm dp a₀ ρ) ↔
      a₀ < nominalCap (optimalCenter dm dp) dm dp ρ := by
  constructor
  · rintro ⟨c, hc, hcu, hs⟩
    exact lt_of_lt_of_le ((exact_asymmetric_budget hm hp hc hcu ha hρ hρu).mp hs)
      (nominalCap_optimal_unique hm hp hcu hρ).1
  · intro ha'
    obtain ⟨hc, hcu⟩ := optimalCenter_admissible hw
    exact ⟨optimalCenter dm dp, hc, hcu,
      (exact_asymmetric_budget hm hp hc hcu ha hρ hρu).mpr ha'⟩

theorem global_robust_gain_isLUB {dm dp ρ : ℝ}
    (hm : 0 ≤ dm) (hp : 0 ≤ dp) (hw : dm + dp ≤ 1)
    (hρ : 0 ≤ ρ) (hρu : ρ < 1) :
    IsLUB {a₀ : ℝ | 0 < a₀ ∧
      ∃ c, dm ≤ c ∧ c ≤ 1 - dp ∧ AsymmetricBoxStable c dm dp a₀ ρ}
      (nominalCap (optimalCenter dm dp) dm dp ρ) := by
  have hset : {a₀ : ℝ | 0 < a₀ ∧
      ∃ c, dm ≤ c ∧ c ≤ 1 - dp ∧ AsymmetricBoxStable c dm dp a₀ ρ} =
      Set.Ioo 0 (nominalCap (optimalCenter dm dp) dm dp ρ) := by
    ext a₀
    constructor
    · rintro ⟨ha, hs⟩
      exact ⟨ha, (exists_robust_center_iff hm hp hw ha hρ hρu).mp hs⟩
    · rintro ⟨ha, hb⟩
      exact ⟨ha, (exists_robust_center_iff hm hp hw ha hρ hρu).mpr hb⟩
  rw [hset]
  exact isLUB_Ioo (nominalCap_pos hm hp hρ)

end C2.Robustness

end

/- ===== C2.SecondOrder ===== -/

/-!
# Exact global optimization for a stable second-order rational factor

The parameter is `t = 2 * gamma - 1`, the normalized denominator coefficients
are `u = a₁ T > 0`, `v = a₀ T² > 0`, and the gain is `b = k T²`.
The algebraic feasible set uses the cubic Schur/Jury inequalities, including
one redundant positive Cayley coefficient.  The complex-root bridge is stated
separately; this file does not define stability as an optimizer condition.
-/
noncomputable section
namespace C2.SecondOrder

def gamma (t : ℝ) : ℝ := (1+t)/2

def L (u v t : ℝ) : ℝ := 1 + u*(1+t)/2 + v*(1+t)^2/4

def c (t : ℝ) : ℝ := (1-t)^2/4

def D (t b : ℝ) : ℝ := b*c t

def A0 (v b : ℝ) : ℝ := b+v

def A1 (u v t b : ℝ) : ℝ := 2*t*(b+v)+2*u+v-b

def A2 (u v t b : ℝ) : ℝ := t^2*(b+v)+2*t*(u+v-b)+2*u+4

def A3 (u v t b : ℝ) : ℝ := 4+2*u*t+(v-b)*t^2

def R (u v t b : ℝ) : ℝ := A1 u v t b * A2 u v t b - A0 v b * A3 u v t b

def f (u v t : ℝ) : ℝ := v*t^3+2*u*t^2+(4-u)*t-4

def optimum (u r : ℝ) : ℝ := (4+u*r)/r^3

def rootV (u r : ℝ) : ℝ := 4*(1-r)/r^3+u*(1-2*r)/r^2

def Feasible (u v t b : ℝ) : Prop :=
  0 < A1 u v t b ∧ D t b < L u v t ∧ 0 < A3 u v t b ∧ 0 < R u v t b

def UD (u v t : ℝ) : ℝ := L u v t / c t

def UM (u v t : ℝ) : ℝ := (4+2*u*t+v*t^2)/t^2

theorem root_identity {u v r : ℝ} (hr : 0 < r) (hf : f u v r = 0) :
    v = rootV u r := by
  unfold rootV
  field_simp [ne_of_gt hr]
  unfold f at hf
  nlinarith [hf]

-- The following polynomial identities are proved by field normalization and ring arithmetic.
theorem optimum_boundary_identity (u r : ℝ) (hr : r ≠ 0) :
    A3 u (rootV u r) r (optimum u r) = 0 := by
  unfold A3 rootV optimum
  field_simp
  ring

theorem third_root_gap (u r : ℝ) (hr : r ≠ 0) :
    L u (rootV u r) r - D r (optimum u r) =
      (6-4*r+u*r*(1-r))/(2*r^2) := by
  unfold L D c rootV optimum
  field_simp
  ring

theorem a1_at_optimum (u r : ℝ) (hr : r ≠ 0) :
    A1 u (rootV u r) r (optimum u r) =
      2*(u*r*(1-r)+6-4*r)/r^2 := by
  unfold A1 rootV optimum
  field_simp
  ring

theorem a3_at_optimum (u r t : ℝ) (hr : r ≠ 0) :
    A3 u (rootV u r) t (optimum u r) =
      2*(r-t)*(r*t*u+2*r+2*t)/r^2 := by
  unfold A3 rootV optimum
  field_simp
  ring

theorem determinant_below_optimum (u r e : ℝ) (hr : r ≠ 0) :
    R u (rootV u r) r (optimum u r-e) =
      2*(1-r)*(u*r*(1-r)+8-4*r)/r*e + 2*r*(1-r)^2*e^2 := by
  unfold R A0 A1 A2 A3 rootV optimum
  field_simp
  ring

def q0 (u r : ℝ) : ℝ :=
  4/r^4*(r^2*u^2*(1-r)+2*r*u*(2-r^2)+8)

def q1 (u r : ℝ) : ℝ :=
  2/r^4*(r^3*u^2*(1-r)+2*r^2*u*(2-r)+8*((1-r)^2+1))

def q2 (u r : ℝ) : ℝ :=
  4/r^4*(r^2*u^2*(1-r)^2+4*r*u*(1-r)*(3-2*r)+
    8*(2*(1-r)^2+2*(1-r)+1))

def Q (u r t : ℝ) : ℝ :=
  q0 u r*(1-t/r)^2 + 2*q1 u r*(t/r)*(1-t/r) + q2 u r*(t/r)^2

theorem bernstein_identity (u r t : ℝ) (hr : r ≠ 0) :
    R u (rootV u r) t (optimum u r) = (t-r)*Q u r t := by
  unfold R A0 A1 A2 A3 rootV optimum Q q0 q1 q2
  field_simp
  ring

theorem bernstein_coefficients_positive {u r : ℝ}
    (hu : 0 < u) (hr : 0 < r) (hr1 : r < 1) :
    0 < q0 u r ∧ 0 < q1 u r ∧ 0 < q2 u r := by
  have h1 : 0 < 1-r := sub_pos.mpr hr1
  have h2 : 0 < 2-r := by linarith
  have h3 : 0 < 3-2*r := by linarith
  have h4 : 0 < 2-r^2 := by nlinarith [mul_pos hr h1]
  unfold q0 q1 q2
  constructor
  · positivity
  constructor <;> positivity

theorem bernstein_positive {u r t : ℝ}
    (hu : 0 < u) (hr : 0 < r) (hr1 : r < 1) (ht : 0 < t) (htr : t < r) :
    0 < Q u r t := by
  obtain ⟨h0,h1,h2⟩ := bernstein_coefficients_positive hu hr hr1
  have hx : 0 < t/r := div_pos ht hr
  have hx1 : t/r < 1 := (div_lt_one hr).mpr htr
  have hrem : 0 < 1-t/r := sub_pos.mpr hx1
  unfold Q
  positivity

theorem determinant_at_optimum_negative {u v r t : ℝ}
    (hu : 0 < u) (hr : 0 < r) (hr1 : r < 1) (hf : f u v r = 0)
    (ht : 0 < t) (htr : t < r) : R u v t (optimum u r) < 0 := by
  rw [root_identity hr hf, bernstein_identity u r t (ne_of_gt hr)]
  exact mul_neg_of_neg_of_pos (sub_neg.mpr htr) (bernstein_positive hu hr hr1 ht htr)

theorem root_sign_identity (u v r t : ℝ) (hr : r ≠ 0) (ht : t ≠ 0) :
    f u v t/t = f u v r/r + (t-r)*(v*(t+r)+2*u+4/(t*r)) := by
  unfold f
  field_simp
  ring

theorem root_sign_below {u v r t : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hf : f u v r = 0)
    (ht : 0 < t) (htr : t < r) : f u v t/t < 0 := by
  rw [root_sign_identity u v r t (ne_of_gt hr) (ne_of_gt ht), hf]
  simp only [zero_div, zero_add]
  apply mul_neg_of_neg_of_pos (sub_neg.mpr htr)
  positivity

theorem optimum_positive {u r : ℝ} (hu : 0 < u) (hr : 0 < r) :
    0 < optimum u r := by unfold optimum; positivity


theorem feasible_below_optimum {u v r b : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) (hb : 0 < b) (hbopt : b < optimum u r) :
    Feasible u v r b := by
  have hvr := root_identity hr hf
  have he : 0 < optimum u r-b := sub_pos.mpr hbopt
  have hrem : 0 < 1-r := sub_pos.mpr hr1
  have h68 : 0 < 6-4*r := by linarith
  have h88 : 0 < 8-4*r := by linarith
  have hA1star : 0 < A1 u v r (optimum u r) := by
    rw [hvr, a1_at_optimum u r (ne_of_gt hr)]
    have hn : 0 < u*r*(1-r)+6-4*r := by nlinarith [mul_pos (mul_pos hu hr) hrem]
    positivity
  have hA1 : 0 < A1 u v r b := by
    by_cases hs : 0 ≤ 2*r-1
    · unfold A1
      have : 0 ≤ (2*r-1)*b := mul_nonneg hs (le_of_lt hb)
      have : 0 < (2*r+1)*v := mul_pos (by linarith) hv
      nlinarith
    · have hs' : 2*r-1 < 0 := lt_of_not_ge hs
      have hprod := mul_neg_of_neg_of_pos hs' he
      unfold A1 at hA1star ⊢
      nlinarith
  have hgap : 0 < L u v r-D r (optimum u r) := by
    rw [hvr, third_root_gap u r (ne_of_gt hr)]
    positivity
  have hcc : 0 ≤ c r := by unfold c; positivity
  have hD : D r b ≤ D r (optimum u r) := by
    unfold D
    exact mul_le_mul_of_nonneg_right (le_of_lt hbopt) hcc
  have hA3star : A3 u v r (optimum u r) = 0 := by
    rw [hvr, optimum_boundary_identity u r (ne_of_gt hr)]
  have hA3 : 0 < A3 u v r b := by
    have hrr : 0 < r^2 := sq_pos_of_pos hr
    have hh := mul_pos he hrr
    unfold A3 at hA3star ⊢
    nlinarith
  have hR : 0 < R u v r b := by
    have hid := determinant_below_optimum u r (optimum u r-b) (ne_of_gt hr)
    have hbident : optimum u r-(optimum u r-b)=b := by ring
    rw [hbident] at hid
    rw [hvr,hid]
    have hn : 0 < u*r*(1-r)+8-4*r := by nlinarith [mul_pos (mul_pos hu hr) hrem]
    positivity
  exact ⟨hA1,by linarith,hA3,hR⟩

theorem upper_bounds {u v t b : ℝ} (ht : 0 < t) (ht1 : t < 1)
    (hD : D t b < L u v t) (hA3 : 0 < A3 u v t b) :
    b < UD u v t ∧ b < UM u v t := by
  have hc : 0 < c t := by
    have hh : 0 < 1-t := sub_pos.mpr ht1
    unfold c
    positivity
  have htt : 0 < t^2 := sq_pos_of_pos ht
  constructor
  · unfold UD
    apply (lt_div_iff₀ hc).mpr
    exact hD
  · unfold UM
    apply (lt_div_iff₀ htt).mpr
    unfold A3 at hA3
    nlinarith

theorem a3_nonnegative_of_le_um {u v t b : ℝ} (ht : 0 < t)
    (hb : b ≤ UM u v t) : 0 ≤ A3 u v t b := by
  unfold UM at hb
  have hh := (le_div_iff₀ (sq_pos_of_pos ht)).mp hb
  unfold A3
  nlinarith

theorem d_le_of_le_ud {u v t b : ℝ} (ht1 : t < 1)
    (hb : b ≤ UD u v t) : D t b ≤ L u v t := by
  have hc : 0 < c t := by
    have hh : 0 < 1-t := sub_pos.mpr ht1
    unfold c
    positivity
  exact (le_div_iff₀ hc).mp hb

theorem r_at_ud (u v t : ℝ) (ht1 : t ≠ 1) :
    R u v t (UD u v t) = -8*L u v t*A3 u v t (UD u v t) := by
  have hh : 1-t ≠ 0 := sub_ne_zero.mpr (Ne.symm ht1)
  unfold R A0 A1 A2 A3 UD L c
  field_simp [hh]
  ring

theorem r_at_um (u v t : ℝ) (ht : t ≠ 0) :
    R u v t (UM u v t) =
      8*(L u v t-D t (UM u v t))*(f u v t/t) := by
  unfold R A0 A1 A2 A3 UM L D c f
  field_simp
  ring

theorem determinant_chord (u v t x y z : ℝ) :
    (z-x)*R u v t y = (z-y)*R u v t x + (y-x)*R u v t z -
      (2*t*(1-t)^2)*(y-x)*(z-y)*(z-x) := by
  unfold R A0 A1 A2 A3
  ring

theorem determinant_nonpositive_between {u v t x y z : ℝ}
    (ht : 0 ≤ t) (hxz : x < z) (hxy : x ≤ y) (hyz : y ≤ z)
    (hx : R u v t x ≤ 0) (hz : R u v t z ≤ 0) : R u v t y ≤ 0 := by
  have h0 : 0 ≤ z-y := sub_nonneg.mpr hyz
  have h1 : 0 ≤ y-x := sub_nonneg.mpr hxy
  have h2 : 0 < z-x := sub_pos.mpr hxz
  have hleft : (z-y)*R u v t x ≤ 0 := mul_nonpos_of_nonneg_of_nonpos h0 hx
  have hright : (y-x)*R u v t z ≤ 0 := mul_nonpos_of_nonneg_of_nonpos h1 hz
  have hterm : 0 ≤ (2*t*(1-t)^2)*(y-x)*(z-y)*(z-x) := by positivity
  have hid := determinant_chord u v t x y z
  have htotal : (z-x)*R u v t y ≤ 0 := by linarith
  by_contra hn
  have hp := mul_pos h2 (lt_of_not_ge hn)
  linarith

theorem global_gain_bound {u v r t b : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) (hfeas : Feasible u v t b) : b < optimum u r := by
  obtain ⟨hA1,hD,hA3,hR⟩ := hfeas
  by_contra hb
  have hb : optimum u r ≤ b := le_of_not_gt hb
  have hbpos : 0 < b := lt_of_lt_of_le (optimum_positive hu hr) hb
  have hvr := root_identity hr hf
  have hrem : 0 < 1-r := sub_pos.mpr hr1
  have hdelta : 2*u+v-optimum u r < 0 := by
    have hid : 2*u+v-optimum u r = (2*u*r^3-2*u*r^2-4*r)/r^3 := by
      rw [hvr]
      unfold rootV optimum
      field_simp
      ring
    rw [hid]
    have hneg : 2*u*r^3-2*u*r^2-4*r < 0 := by
      have hh : 0 < 2*u*r^2*(1-r)+4*r := by positivity
      nlinarith
    exact div_neg_of_neg_of_pos hneg (pow_pos hr 3)
  have ht : 0 < t := by
    by_contra ht
    have ht : t ≤ 0 := le_of_not_gt ht
    have hprod : 2*t*(b+v) ≤ 0 := mul_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith)
    unfold A1 at hA1
    linarith
  have htr : t < r := by
    by_contra htr
    have hrt : r ≤ t := le_of_not_gt htr
    have hbound : A3 u v t (optimum u r) ≤ 0 := by
      rw [hvr,a3_at_optimum u r t (ne_of_gt hr)]
      apply div_nonpos_of_nonpos_of_nonneg
      · apply mul_nonpos_of_nonpos_of_nonneg
        · nlinarith
        · positivity
      · positivity
    have hdecrease : A3 u v t b ≤ A3 u v t (optimum u r) := by
      have hprod := mul_nonneg (sub_nonneg.mpr hb) (sq_nonneg t)
      unfold A3
      nlinarith
    linarith
  have ht1 : t < 1 := lt_trans htr hr1
  have hL : 0 < L u v t := by unfold L; positivity
  obtain ⟨hbUD,hbUM⟩ := upper_bounds ht ht1 hD hA3
  let U := min (UD u v t) (UM u v t)
  have hbU : b < U := lt_min hbUD hbUM
  have hoptU : optimum u r < U := lt_of_le_of_lt hb hbU
  have hRU : R u v t U ≤ 0 := by
    by_cases hcase : UD u v t ≤ UM u v t
    · have hU : U = UD u v t := min_eq_left hcase
      rw [hU,r_at_ud u v t (ne_of_lt ht1)]
      have hn := a3_nonnegative_of_le_um ht hcase
      exact mul_nonpos_of_nonpos_of_nonneg (by nlinarith) hn
    · have hcase : UM u v t ≤ UD u v t := le_of_lt (lt_of_not_ge hcase)
      have hU : U = UM u v t := min_eq_right hcase
      rw [hU,r_at_um u v t (ne_of_gt ht)]
      have hgap := d_le_of_le_ud ht1 hcase
      have hsign := root_sign_below hu hv hr hf ht htr
      exact mul_nonpos_of_nonneg_of_nonpos (by nlinarith) (le_of_lt hsign)
  have hRopt := determinant_at_optimum_negative hu hr hr1 hf ht htr
  have hnonpos := determinant_nonpositive_between (le_of_lt ht) hoptU hb
    (le_of_lt hbU) (le_of_lt hRopt) hRU
  linarith


theorem exists_unique_optimal_root {u v : ℝ} (hu : 0 < u) (hv : 0 < v) :
    ∃! r : ℝ, 0 < r ∧ r < 1 ∧ f u v r = 0 := by
  have hc : Continuous (fun t : ℝ => f u v t) := by unfold f; fun_prop
  have htarget : (0:ℝ) ∈ Set.Icc (f u v 0) (f u v 1) := by
    constructor <;> unfold f <;> norm_num; linarith
  obtain ⟨r,hr,hfr⟩ := intermediate_value_Icc (show (0:ℝ) ≤ 1 by norm_num)
    hc.continuousOn htarget
  have hr0 : 0 < r := by
    have hneq : r ≠ 0 := by intro h; subst r; norm_num [f] at hfr
    exact lt_of_le_of_ne hr.1 (Ne.symm hneq)
  have hr1 : r < 1 := by
    have hneq : r ≠ 1 := by intro h; subst r; norm_num [f] at hfr; linarith
    exact lt_of_le_of_ne hr.2 hneq
  refine ⟨r,⟨hr0,hr1,hfr⟩,?_⟩
  intro y hy
  by_contra hne
  rcases lt_or_gt_of_ne hne with hyr | hry
  · have hh := root_sign_below hu hv hr0 hfr hy.1 hyr
    rw [hy.2.2,zero_div] at hh
    linarith
  · have hh := root_sign_below hu hv hy.1 hy.2.2 hr0 hry
    change f u v r = 0 at hfr
    rw [hfr,zero_div] at hh
    linarith

theorem scaled_cubicSchur_iff (l b c d : ℝ) (hl : 0 < l) :
    C2.CubicSchur (b/l) (c/l) (d/l) ↔
      |d| < l ∧ 0 < l+b+c+d ∧ 0 < l-b+c-d ∧ 0 < l^2-l*c+b*d-d^2 := by
  rw [C2.cubicSchur_iff]
  have h0 : |d/l| = |d|/l := by rw [abs_div,abs_of_pos hl]
  have h1 : 1+b/l+c/l+d/l = (l+b+c+d)/l := by field_simp
  have h2 : 1-b/l+c/l-d/l = (l-b+c-d)/l := by field_simp
  have h3 : 1-c/l+(b/l)*(d/l)-(d/l)^2 = (l^2-l*c+b*d-d^2)/l^2 := by
    field_simp
    ring
  rw [h0,h1,h2,h3,div_lt_one hl,div_pos_iff_of_pos_right hl,
    div_pos_iff_of_pos_right hl,div_pos_iff_of_pos_right (sq_pos_of_pos hl)]

-- The real coefficients of the paper's characteristic polynomial.
def B (u v t b : ℝ) : ℝ := (A0 v b-A3 u v t b)/2-D t b

def C (u v t b : ℝ) : ℝ := (A0 v b+A3 u v t b)/2-L u v t

def Schur (u v t b : ℝ) : Prop :=
  C2.CubicSchur (B u v t b/L u v t) (C u v t b/L u v t) (D t b/L u v t)

theorem plus_endpoint_identity (u v t b : ℝ) :
    L u v t+B u v t b+C u v t b+D t b = b+v := by
  unfold B C A0
  ring

theorem minus_endpoint_identity (u v t b : ℝ) :
    L u v t-B u v t b+C u v t b-D t b = A3 u v t b := by
  unfold B C A0
  ring

theorem jury_determinant_identity (u v t b : ℝ) :
    8*(L u v t^2-L u v t*C u v t b+B u v t b*D t b-D t b^2) = R u v t b := by
  unfold B C L D c R A0 A1 A2 A3
  ring

theorem cayley_sum_identity (u v t b : ℝ) :
    A1 u v t b+A2 u v t b = 6*L u v t-2*C u v t b := by
  unfold C L A1 A2 A0 A3
  ring

theorem schur_iff_feasible {u v t b : ℝ}
    (hu : 0 < u) (hv : 0 < v) (ht : -1 ≤ t) (hb : 0 < b) :
    Schur u v t b ↔ Feasible u v t b := by
  have htp : 0 ≤ 1+t := by linarith
  have hl : 0 < L u v t := by unfold L; positivity
  have hd : 0 ≤ D t b := by unfold D c; positivity
  have hp : 0 < b+v := by linarith
  have he := jury_determinant_identity u v t b
  unfold Schur
  rw [scaled_cubicSchur_iff _ _ _ _ hl,abs_of_nonneg hd,
    plus_endpoint_identity,minus_endpoint_identity]
  constructor
  · rintro ⟨hD,hplus,hminus,hJ⟩
    have hR : 0 < R u v t b := by linarith
    have hsum : 0 < A1 u v t b+A2 u v t b := by
      have hm := minus_endpoint_identity u v t b
      have hdm : 0 ≤ D t b * A3 u v t b := mul_nonneg hd (le_of_lt hminus)
      have hprod : (L u v t-D t b)*(L u v t+2*D t b-C u v t b) > 0 := by
        nlinarith [he]
      have hc : C u v t b < L u v t+2*D t b := by
        by_contra hh
        have hh : L u v t+2*D t b-C u v t b ≤ 0 := by linarith
        have hbad := mul_nonpos_of_nonneg_of_nonpos (sub_nonneg.mpr (le_of_lt hD)) hh
        linarith
      rw [cayley_sum_identity]
      linarith
    have hA1 : 0 < A1 u v t b := by
      have hprod : 0 < A1 u v t b*A2 u v t b := by
        unfold R A0 at hR
        have hh := mul_pos hp hminus
        linarith
      by_contra hh
      have hh : A1 u v t b ≤ 0 := le_of_not_gt hh
      have hh2 : 0 < A2 u v t b := by linarith
      have hbad := mul_nonpos_of_nonpos_of_nonneg hh (le_of_lt hh2)
      linarith
    exact ⟨hA1,hD,hminus,hR⟩
  · rintro ⟨hA1,hD,hminus,hR⟩
    exact ⟨hD,hp,hminus,by linarith⟩

theorem schur_below_optimum {u v r b : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) (hb : 0 < b) (hbopt : b < optimum u r) :
    Schur u v r b := by
  apply (schur_iff_feasible hu hv (by linarith) hb).mpr
  exact feasible_below_optimum hu hv hr hr1 hf hb hbopt

theorem schur_global_gain_bound {u v r t b : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) (ht : -1 ≤ t) (hb : 0 < b)
    (hs : Schur u v t b) : b < optimum u r := by
  exact global_gain_bound hu hv hr hr1 hf ((schur_iff_feasible hu hv ht hb).mp hs)

theorem schur_at_optimal_parameter_iff {u v r b : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) (hb : 0 < b) :
    Schur u v r b ↔ b < optimum u r := by
  constructor
  · exact schur_global_gain_bound hu hv hr hr1 hf (by linarith) hb
  · exact schur_below_optimum hu hv hr hr1 hf hb

/-- At the global gain boundary, the closed necessary Schur inequalities
can hold only at the uniquely optimizing parameter. -/
theorem closed_boundary_unique {u v r t : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0)
    (hA1 : 0 ≤ A1 u v t (optimum u r))
    (hA3 : 0 ≤ A3 u v t (optimum u r))
    (hR : 0 ≤ R u v t (optimum u r)) : t = r := by
  have hvr := root_identity hr hf
  have hrem : 0 < 1-r := sub_pos.mpr hr1
  have hdelta : 2*u+v-optimum u r < 0 := by
    have hid : 2*u+v-optimum u r = (2*u*r^3-2*u*r^2-4*r)/r^3 := by
      rw [hvr]
      unfold rootV optimum
      field_simp
      ring
    rw [hid]
    have hneg : 2*u*r^3-2*u*r^2-4*r < 0 := by
      have hh : 0 < 2*u*r^2*(1-r)+4*r := by positivity
      nlinarith
    exact div_neg_of_neg_of_pos hneg (pow_pos hr 3)
  have ht : 0 < t := by
    by_contra ht
    have ht : t ≤ 0 := le_of_not_gt ht
    have hbpos := optimum_positive hu hr
    have hprod : 2*t*(optimum u r+v) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith)
    unfold A1 at hA1
    linarith
  rcases lt_trichotomy t r with htr | heq | hrt
  · have hneg := determinant_at_optimum_negative hu hr hr1 hf ht htr
    linarith
  · exact heq
  · have hneg : A3 u v t (optimum u r) < 0 := by
      rw [hvr,a3_at_optimum u r t (ne_of_gt hr)]
      apply div_neg_of_neg_of_pos
      · apply mul_neg_of_neg_of_pos
        · nlinarith
        · positivity
      · positivity
    linarith

/-- Closed global result: the unique cubic root exists for every stable
second-order denominator, and its parameter attains the sharp global supremum. -/
theorem second_order_global_optimum {u v : ℝ} (hu : 0 < u) (hv : 0 < v) :
    ∃ r : ℝ, 0 < r ∧ r < 1 ∧ f u v r = 0 ∧
      (∀ b : ℝ, 0 < b → (Schur u v r b ↔ b < optimum u r)) ∧
      (∀ t b : ℝ, -1 ≤ t → 0 < b → Schur u v t b → b < optimum u r) := by
  obtain ⟨r,⟨hr,hr1,hf⟩,_⟩ := exists_unique_optimal_root hu hv
  exact ⟨r,hr,hr1,hf,
    fun _ hb => schur_at_optimal_parameter_iff hu hv hr hr1 hf hb,
    fun _ _ ht hb hs => schur_global_gain_bound hu hv hr hr1 hf ht hb hs⟩

/-- All positive stable gains, including every connected component. -/
def stableGains (u v t : ℝ) : Set ℝ := {b | 0 < b ∧ Schur u v t b}

theorem stableGains_at_optimum {u v r : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) : stableGains u v r = Set.Ioo 0 (optimum u r) := by
  ext b
  constructor
  · rintro ⟨hb,hs⟩
    exact ⟨hb,(schur_at_optimal_parameter_iff hu hv hr hr1 hf hb).mp hs⟩
  · rintro ⟨hb,hbo⟩
    exact ⟨hb,schur_below_optimum hu hv hr hr1 hf hb hbo⟩

theorem optimal_gain_isLUB {u v r : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) : IsLUB (stableGains u v r) (optimum u r) := by
  rw [stableGains_at_optimum hu hv hr hr1 hf]
  exact isLUB_Ioo (optimum_positive hu hr)

/-- Uniqueness is about the supremum of every stable gain, not a grid
search and not merely the first stability interval. -/
theorem optimal_parameter_unique {u v r t : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) (ht : -1 ≤ t)
    (hsup : IsLUB (stableGains u v t) (optimum u r)) : t = r := by
  have hcl := hsup.mem_closure hsup.nonempty
  have hclosed : IsClosed {b : ℝ | 0 ≤ A1 u v t b ∧ 0 ≤ A3 u v t b ∧ 0 ≤ R u v t b} := by
    apply IsClosed.inter
    · apply isClosed_le (f := fun _ : ℝ => (0:ℝ)) (g := fun b : ℝ => A1 u v t b) continuous_const
      unfold A1
      fun_prop
    · apply IsClosed.inter
      · apply isClosed_le (f := fun _ : ℝ => (0:ℝ)) (g := fun b : ℝ => A3 u v t b) continuous_const
        unfold A3
        fun_prop
      · apply isClosed_le (f := fun _ : ℝ => (0:ℝ)) (g := fun b : ℝ => R u v t b) continuous_const
        unfold R A0 A1 A2 A3
        fun_prop
  have hsubset : stableGains u v t ⊆
      {b : ℝ | 0 ≤ A1 u v t b ∧ 0 ≤ A3 u v t b ∧ 0 ≤ R u v t b} := by
    intro b hb
    obtain ⟨h1,_,h3,hR⟩ := (schur_iff_feasible hu hv ht hb.1).mp hb.2
    exact ⟨le_of_lt h1,le_of_lt h3,le_of_lt hR⟩
  obtain ⟨h1,h3,hR⟩ := closure_minimal hsubset hclosed hcl
  exact closed_boundary_unique hu hv hr hr1 hf h1 h3 hR

/-- At any other admissible parameter with a nonempty stable set,
the entire stable-gain supremum is strictly smaller. -/
theorem suboptimal_parameter_strict {u v r t : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) (ht : -1 ≤ t) (hne : t ≠ r)
    (hset : (stableGains u v t).Nonempty) :
    sSup (stableGains u v t) < optimum u r := by
  have hbound : ∀ b ∈ stableGains u v t, b ≤ optimum u r := by
    intro b hb
    exact le_of_lt (schur_global_gain_bound hu hv hr hr1 hf ht hb.1 hb.2)
  have hbdd : BddAbove (stableGains u v t) := ⟨optimum u r,hbound⟩
  have hle : sSup (stableGains u v t) ≤ optimum u r := csSup_le hset hbound
  apply lt_of_le_of_ne hle
  intro heq
  have his := isLUB_csSup hset hbdd
  rw [heq] at his
  exact hne (optimal_parameter_unique hu hv hr hr1 hf ht his)

/-- Complete existence and uniqueness of the maximizing discretization,
expressed through the genuine root stability predicate. -/
theorem exists_unique_global_optimizer {u v : ℝ} (hu : 0 < u) (hv : 0 < v) :
    ∃ r : ℝ, 0 < r ∧ r < 1 ∧ f u v r = 0 ∧
      ∃! t : ℝ, -1 ≤ t ∧ t ≤ 1 ∧ IsLUB (stableGains u v t) (optimum u r) := by
  obtain ⟨r,⟨hr,hr1,hf⟩,_⟩ := exists_unique_optimal_root hu hv
  refine ⟨r,hr,hr1,hf,r,⟨by linarith,by linarith,optimal_gain_isLUB hu hv hr hr1 hf⟩,?_⟩
  intro t ht
  exact optimal_parameter_unique hu hv hr hr1 hf ht.1 ht.2.2

theorem root_sign_above {u v r t : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hf : f u v r = 0)
    (ht : 0 < t) (hrt : r < t) : 0 < f u v t/t := by
  rw [root_sign_identity u v r t (ne_of_gt hr) (ne_of_gt ht), hf]
  simp only [zero_div, zero_add]
  apply mul_pos (sub_pos.mpr hrt)
  positivity

theorem root_lt_iff {u v r t : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hf : f u v r = 0)
    (ht : 0 < t) : r < t ↔ 0 < f u v t := by
  constructor
  · intro hrt
    exact (div_pos_iff_of_pos_right ht).mp (root_sign_above hu hv hr hf ht hrt)
  · intro hp
    by_contra hrt
    rcases lt_or_eq_of_le (le_of_not_gt hrt) with htr | heq
    · have hh := root_sign_below hu hv hr hf ht htr
      have hh2 := div_pos hp ht
      linarith
    · rw [heq,hf] at hp
      linarith

theorem root_gt_iff {u v r t : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hf : f u v r = 0)
    (ht : 0 < t) : t < r ↔ f u v t < 0 := by
  constructor
  · intro htr
    have hh := root_sign_below hu hv hr hf ht htr
    by_contra hn
    have hn := div_nonneg (le_of_not_gt hn) (le_of_lt ht)
    linarith
  · intro hn
    by_contra htr
    rcases lt_or_eq_of_le (le_of_not_gt htr) with hrt | heq
    · have hh := (root_lt_iff hu hv hr hf ht).mp hrt
      linarith
    · rw [← heq,hf] at hn
      linarith

/-- The sharp transition at gamma = 3/4 depends only on v = a₀ T². -/
theorem three_quarter_regime {u v r : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hf : f u v r = 0) :
    (gamma r < 3/4 ↔ 16 < v) ∧
    (gamma r = 3/4 ↔ v = 16) ∧
    (3/4 < gamma r ↔ v < 16) := by
  have he : f u v (1/2) = v/8-2 := by unfold f; ring
  have hlo := root_lt_iff hu hv hr hf (show (0:ℝ) < 1/2 by norm_num)
  have hhi := root_gt_iff hu hv hr hf (show (0:ℝ) < 1/2 by norm_num)
  rw [he] at hlo hhi
  unfold gamma
  constructor
  · constructor
    · intro h
      have hh := hlo.mp (by linarith)
      linarith
    · intro h
      have hh := hlo.mpr (by linarith)
      linarith
  constructor
  · constructor
    · intro h
      have heq : r = 1/2 := by linarith
      rw [heq,he] at hf
      linarith
    · intro h
      have hnlo : ¬r < 1/2 := by rw [hlo,h]; norm_num
      have hnhi : ¬(1:ℝ)/2 < r := by rw [hhi,h]; norm_num
      linarith
  · constructor
    · intro h
      have hh := hhi.mp (by linarith)
      linarith
    · intro h
      have hh := hhi.mpr (by linarith)
      linarith

theorem optimum_difference (u x y : ℝ) (hx : x ≠ 0) (hy : y ≠ 0) :
    optimum u x-optimum u y =
      (y-x)*(4*(x^2+x*y+y^2)+u*x*y*(x+y))/(x^3*y^3) := by
  unfold optimum
  field_simp
  ring

theorem optimum_strict_antitone {u x y : ℝ}
    (hu : 0 < u) (hx : 0 < x) (hxy : x < y) : optimum u y < optimum u x := by
  have hy : 0 < y := lt_trans hx hxy
  have hh : 0 < optimum u x-optimum u y := by
    rw [optimum_difference u x y (ne_of_gt hx) (ne_of_gt hy)]
    have hdiff : 0 < y-x := sub_pos.mpr hxy
    positivity
  linarith

/-- Any valid positive root bracket immediately gives rigorous parameter
and gain brackets. The bisection algorithm itself is separate from this lemma. -/
theorem root_bracket_enclosures {u r lo hi : ℝ}
    (hu : 0 < u) (hlo : 0 < lo) (hlr : lo ≤ r) (hrh : r ≤ hi) :
    gamma lo ≤ gamma r ∧ gamma r ≤ gamma hi ∧
    optimum u hi ≤ optimum u r ∧ optimum u r ≤ optimum u lo := by
  have hr : 0 < r := lt_of_lt_of_le hlo hlr
  refine ⟨by unfold gamma; linarith,by unfold gamma; linarith,?_,?_⟩
  · rcases eq_or_lt_of_le hrh with h | h
    · rw [h]
    · exact le_of_lt (optimum_strict_antitone hu hr h)
  · rcases eq_or_lt_of_le hlr with h | h
    · rw [h]
    · exact le_of_lt (optimum_strict_antitone hu hlo h)

theorem optimum_formula {u v r : ℝ} (hr : 0 < r) (hf : f u v r = 0) :
    optimum u r = v+2*u/r+4/r^2 := by
  rw [root_identity hr hf]
  unfold optimum rootV
  field_simp
  ring

theorem optimal_gamma_range {r : ℝ} (hr : 0 < r) (hr1 : r < 1) :
    1/2 < gamma r ∧ gamma r < 1 := by
  unfold gamma
  constructor <;> linarith

/-- The same unique optimizer in the paper's gamma-coordinate. -/
theorem exists_unique_global_gamma_optimizer {u v : ℝ} (hu : 0 < u) (hv : 0 < v) :
    ∃ r : ℝ, 0 < r ∧ r < 1 ∧ f u v r = 0 ∧
      ∃! g : ℝ, 0 ≤ g ∧ g ≤ 1 ∧
        IsLUB (stableGains u v (2*g-1)) (optimum u r) := by
  obtain ⟨r,⟨hr,hr1,hf⟩,_⟩ := exists_unique_optimal_root hu hv
  have hgamma := optimal_gamma_range hr hr1
  have hg : 2*gamma r-1 = r := by unfold gamma; ring
  refine ⟨r,hr,hr1,hf,gamma r,⟨by linarith,by linarith,?_⟩,?_⟩
  · rw [hg]
    exact optimal_gain_isLUB hu hv hr hr1 hf
  · intro g h
    have heq := optimal_parameter_unique hu hv hr hr1 hf (t := 2*g-1) (by linarith [h.1]) h.2.2
    unfold gamma
    linarith

/-- Exact sign tests suffice to enclose the unique positive root. -/
theorem root_bracket_of_signs {u v r lo hi : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hf : f u v r = 0)
    (hlo : 0 < lo) (hhi : 0 < hi)
    (hfl : f u v lo ≤ 0) (hfh : 0 ≤ f u v hi) : lo ≤ r ∧ r ≤ hi := by
  constructor
  · by_contra h
    have hh := (root_lt_iff hu hv hr hf hlo).mp (lt_of_not_ge h)
    linarith
  · by_contra h
    have hh := (root_gt_iff hu hv hr hf hhi).mp (lt_of_not_ge h)
    linarith

theorem root_enclosures {u v r lo hi : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hf : f u v r = 0)
    (hlo : 0 < lo) (hhi : 0 < hi)
    (hfl : f u v lo ≤ 0) (hfh : 0 ≤ f u v hi) :
    gamma lo ≤ gamma r ∧ gamma r ≤ gamma hi ∧
    optimum u hi ≤ optimum u r ∧ optimum u r ≤ optimum u lo := by
  obtain ⟨hlr,hrh⟩ := root_bracket_of_signs hu hv hr hf hlo hhi hfl hfh
  exact root_bracket_enclosures hu hlo hlr hrh

theorem quarter_regime_gain (u : ℝ) : optimum u (1/2) = 32+4*u := by
  unfold optimum
  norm_num
  ring

end C2.SecondOrder

end

/- ===== C2.RootIsolation ===== -/

/-! Exact rational bisection for the second-order optimizer. The executable
iteration uses only rational arithmetic and a rational sign comparison. -/

namespace C2.SecondOrder

def rationalCubic (u v t : ℚ) : ℚ := v*t^3 + 2*u*t^2 + (4-u)*t - 4

def rationalBisectStep (u v : ℚ) (I : ℚ × ℚ) : ℚ × ℚ :=
  let m := (I.1 + I.2)/2
  if rationalCubic u v m ≤ 0 then (m,I.2) else (I.1,m)

def rationalBisect (u v : ℚ) : ℕ → ℚ × ℚ
  | 0 => (0,1)
  | n+1 => rationalBisectStep u v (rationalBisect u v n)

@[simp] theorem rationalCubic_cast (u v t : ℚ) :
    (rationalCubic u v t : ℝ) = f (u:ℝ) (v:ℝ) (t:ℝ) := by
  unfold rationalCubic f
  push_cast
  rfl

theorem rationalBisectStep_nested {u v : ℚ} {I : ℚ × ℚ} (hI : I.1 ≤ I.2) :
    I.1 ≤ (rationalBisectStep u v I).1 ∧
    (rationalBisectStep u v I).1 ≤ (rationalBisectStep u v I).2 ∧
    (rationalBisectStep u v I).2 ≤ I.2 := by
  unfold rationalBisectStep
  dsimp only
  split_ifs <;> dsimp <;> refine ⟨?_,?_,?_⟩ <;> linarith

theorem rationalBisectStep_width (u v : ℚ) (I : ℚ × ℚ) :
    (rationalBisectStep u v I).2 - (rationalBisectStep u v I).1 =
      (I.2-I.1)/2 := by
  unfold rationalBisectStep
  dsimp only
  split_ifs <;> dsimp <;> ring

theorem rationalBisectStep_contains {u v : ℚ} {r : ℝ} {I : ℚ × ℚ}
    (hu : 0 < (u:ℝ)) (hv : 0 < (v:ℝ)) (hr : 0 < r)
    (hf : f (u:ℝ) (v:ℝ) r = 0) (hlo : 0 ≤ I.1)
    (hlr : (I.1:ℝ) ≤ r) (hrh : r ≤ (I.2:ℝ)) :
    ((rationalBisectStep u v I).1:ℝ) ≤ r ∧
      r ≤ ((rationalBisectStep u v I).2:ℝ) := by
  have hm : 0 < (((I.1+I.2)/2:ℚ):ℝ) := by
    push_cast
    have hl : (0:ℝ) ≤ (I.1:ℝ) := by exact_mod_cast hlo
    linarith
  unfold rationalBisectStep
  dsimp only
  split_ifs with h
  · dsimp
    refine ⟨?_,hrh⟩
    by_contra hn
    have hp := (root_lt_iff hu hv hr hf hm).mp (lt_of_not_ge hn)
    have hcast : f (u:ℝ) (v:ℝ) (((I.1+I.2)/2:ℚ):ℝ) ≤ 0 := by
      rw [← rationalCubic_cast]
      exact_mod_cast h
    linarith
  · dsimp
    refine ⟨hlr,?_⟩
    have hp : 0 < f (u:ℝ) (v:ℝ) (((I.1+I.2)/2:ℚ):ℝ) := by
      rw [← rationalCubic_cast]
      exact_mod_cast (lt_of_not_ge h)
    exact ((root_lt_iff hu hv hr hf hm).mpr hp).le

theorem rationalBisect_invariants {u v : ℚ} {r : ℝ}
    (hu : 0 < (u:ℝ)) (hv : 0 < (v:ℝ)) (hr : 0 < r) (hr1 : r < 1)
    (hf : f (u:ℝ) (v:ℝ) r = 0) (n : ℕ) :
    0 ≤ (rationalBisect u v n).1 ∧
    (rationalBisect u v n).1 ≤ (rationalBisect u v n).2 ∧
    (rationalBisect u v n).2 ≤ 1 ∧
    ((rationalBisect u v n).1:ℝ) ≤ r ∧ r ≤ ((rationalBisect u v n).2:ℝ) := by
  induction n with
  | zero =>
    norm_num [rationalBisect]
    exact ⟨hr.le,hr1.le⟩
  | succ n ih =>
    obtain ⟨hl,ho,hh,hlr,hrh⟩ := ih
    obtain ⟨hnl,hno,hnh⟩ := rationalBisectStep_nested (u:=u) (v:=v) ho
    obtain ⟨hnlr,hnrh⟩ := rationalBisectStep_contains hu hv hr hf hl hlr hrh
    exact ⟨hl.trans hnl,hno,hnh.trans hh,hnlr,hnrh⟩

theorem rationalBisect_nested {u v : ℚ} {r : ℝ}
    (hu : 0 < (u:ℝ)) (hv : 0 < (v:ℝ)) (hr : 0 < r) (hr1 : r < 1)
    (hf : f (u:ℝ) (v:ℝ) r = 0) (n : ℕ) :
    (rationalBisect u v n).1 ≤ (rationalBisect u v (n+1)).1 ∧
      (rationalBisect u v (n+1)).2 ≤ (rationalBisect u v n).2 := by
  have h := rationalBisectStep_nested (u:=u) (v:=v)
    (rationalBisect_invariants hu hv hr hr1 hf n).2.1
  exact ⟨h.1,h.2.2⟩

theorem rationalBisect_exact_width (u v : ℚ) (n : ℕ) :
    (rationalBisect u v n).2 - (rationalBisect u v n).1 = (1/2:ℚ)^n := by
  induction n with
  | zero => norm_num [rationalBisect]
  | succ n ih =>
    change (rationalBisectStep u v (rationalBisect u v n)).2 -
      (rationalBisectStep u v (rationalBisect u v n)).1 = _
    rw [rationalBisectStep_width,ih,pow_succ]
    ring

/-- Any iterate strictly inside (0,1) yields both optimizer enclosures. -/
theorem rationalBisect_optimizer_enclosures {u v : ℚ} {r : ℝ}
    (hu : 0 < (u:ℝ)) (hv : 0 < (v:ℝ)) (hr : 0 < r) (hr1 : r < 1)
    (hf : f (u:ℝ) (v:ℝ) r = 0) (n : ℕ)
    (hlo : 0 < (rationalBisect u v n).1) :
    gamma ((rationalBisect u v n).1:ℝ) ≤ gamma r ∧
    gamma r ≤ gamma ((rationalBisect u v n).2:ℝ) ∧
    optimum (u:ℝ) ((rationalBisect u v n).2:ℝ) ≤ optimum (u:ℝ) r ∧
    optimum (u:ℝ) r ≤ optimum (u:ℝ) ((rationalBisect u v n).1:ℝ) := by
  have h := rationalBisect_invariants hu hv hr hr1 hf n
  exact root_bracket_enclosures hu (by exact_mod_cast hlo) h.2.2.2.1 h.2.2.2.2

/-- Arbitrary requested accuracy is reached after finitely many rational steps. -/
theorem rationalBisect_termination (u v : ℚ) {ε : ℝ} (hε : 0 < ε) :
    ∃ N : ℕ, ∀ n ≥ N,
      ((rationalBisect u v n).2:ℝ) - ((rationalBisect u v n).1:ℝ) < ε := by
  have ht := tendsto_pow_atTop_nhds_zero_of_lt_one
    (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨N,hN⟩ := Filter.eventually_atTop.mp (ht.eventually (gt_mem_nhds hε))
  refine ⟨N,fun n hn => ?_⟩
  have hw : ((rationalBisect u v n).2:ℝ) - ((rationalBisect u v n).1:ℝ) = (1/2:ℝ)^n := by
    have h := congrArg (fun q : ℚ => (q : ℝ)) (rationalBisect_exact_width u v n)
    push_cast at h
    exact h
  rw [hw]
  exact hN n hn

/-- After finitely many steps both rational endpoints are strictly inside
(0,1), with arbitrary accuracy and rigorous optimizer enclosures. -/
theorem rationalBisect_eventually_interior {u v : ℚ} {r ε : ℝ}
    (hu : 0 < (u:ℝ)) (hv : 0 < (v:ℝ)) (hr : 0 < r) (hr1 : r < 1)
    (hf : f (u:ℝ) (v:ℝ) r = 0) (hε : 0 < ε) :
    ∃ N : ℕ, ∀ n ≥ N,
      0 < (rationalBisect u v n).1 ∧ (rationalBisect u v n).2 < 1 ∧
      ((rationalBisect u v n).1:ℝ) ≤ r ∧ r ≤ ((rationalBisect u v n).2:ℝ) ∧
      ((rationalBisect u v n).2:ℝ) - ((rationalBisect u v n).1:ℝ) < ε := by
  have he : 0 < min ε (min r (1-r)) := lt_min hε (lt_min hr (by linarith))
  obtain ⟨N,hN⟩ := rationalBisect_termination u v he
  refine ⟨N,fun n hn => ?_⟩
  have hb := rationalBisect_invariants hu hv hr hr1 hf n
  have hw := hN n hn
  have heps := lt_of_lt_of_le hw (min_le_left _ _)
  have hwr := lt_of_lt_of_le hw ((min_le_right _ _).trans (min_le_left _ _))
  have hw1 := lt_of_lt_of_le hw ((min_le_right _ _).trans (min_le_right _ _))
  have hlo : (0:ℝ) < ((rationalBisect u v n).1:ℝ) := by linarith [hb.2.2.2.2]
  have hhi : ((rationalBisect u v n).2:ℝ) < 1 := by linarith [hb.2.2.2.1]
  exact ⟨by exact_mod_cast hlo,by exact_mod_cast hhi,hb.2.2.2.1,hb.2.2.2.2,heps⟩

/-- Manuscript corollary, with an actual rational algorithm and all its
termination, containment, and induced-optimizer guarantees. -/
theorem rational_isolation_complete {u v : ℚ} (hu : 0 < u) (hv : 0 < v)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ r : ℝ, 0 < r ∧ r < 1 ∧ f (u:ℝ) (v:ℝ) r = 0 ∧
      ∃ N : ℕ, ∀ n ≥ N,
        0 < (rationalBisect u v n).1 ∧ (rationalBisect u v n).2 < 1 ∧
        ((rationalBisect u v n).1:ℝ) ≤ r ∧ r ≤ ((rationalBisect u v n).2:ℝ) ∧
        ((rationalBisect u v n).2:ℝ) - ((rationalBisect u v n).1:ℝ) < ε ∧
        gamma ((rationalBisect u v n).1:ℝ) ≤ gamma r ∧
        gamma r ≤ gamma ((rationalBisect u v n).2:ℝ) ∧
        optimum (u:ℝ) ((rationalBisect u v n).2:ℝ) ≤ optimum (u:ℝ) r ∧
        optimum (u:ℝ) r ≤ optimum (u:ℝ) ((rationalBisect u v n).1:ℝ) := by
  have hu' : 0 < (u:ℝ) := by exact_mod_cast hu
  have hv' : 0 < (v:ℝ) := by exact_mod_cast hv
  obtain ⟨r,⟨hr,hr1,hf⟩,_⟩ := exists_unique_optimal_root hu' hv'
  obtain ⟨N,hN⟩ := rationalBisect_eventually_interior hu' hv' hr hr1 hf hε
  refine ⟨r,hr,hr1,hf,N,fun n hn => ?_⟩
  obtain ⟨hl,hh,hlr,hrh,hw⟩ := hN n hn
  obtain ⟨hgl,hgh,hbl,hbh⟩ := rationalBisect_optimizer_enclosures hu' hv' hr hr1 hf n hl
  exact ⟨hl,hh,hlr,hrh,hw,hgl,hgh,hbl,hbh⟩

end C2.SecondOrder


/- ===== C2.SecondOrderCap ===== -/

/-!
# Exact stable-gain threshold, including parameters with no positive stable gain

This module matches the paper's convention `sup ({0} ∪ stable positive gains)`.
The zero is only a convention for the threshold: it is not declared strictly stable.
-/
noncomputable section
namespace C2.SecondOrder

/-- The upper stable-gain threshold used in the paper. -/
def gainCap (u v t : ℝ) : ℝ := sSup (insert 0 (stableGains u v t))

theorem stableGains_bddAbove {u v r t : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) (ht : -1 ≤ t) : BddAbove (stableGains u v t) := by
  refine ⟨optimum u r,?_⟩
  intro b hb
  exact le_of_lt (schur_global_gain_bound hu hv hr hr1 hf ht hb.1 hb.2)

theorem gainCap_eq_zero_of_empty {u v t : ℝ} (hs : stableGains u v t = ∅) :
    gainCap u v t = 0 := by
  simp [gainCap,hs]

theorem gainCap_eq_sSup_of_nonempty {u v r t : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) (ht : -1 ≤ t) (hs : (stableGains u v t).Nonempty) :
    gainCap u v t = sSup (stableGains u v t) := by
  have hbdd := stableGains_bddAbove hu hv hr hr1 hf ht
  unfold gainCap
  rw [csSup_insert hbdd hs]
  obtain ⟨b,hb⟩ := hs
  exact max_eq_right (le_of_lt (lt_of_lt_of_le hb.1 (le_csSup hbdd hb)))

theorem gainCap_at_optimum {u v r : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) : gainCap u v r = optimum u r := by
  have hs := (optimal_gain_isLUB hu hv hr hr1 hf).insert 0
  have hmax : (0:ℝ) ⊔ optimum u r = optimum u r :=
    max_eq_right (le_of_lt (optimum_positive hu hr))
  rw [hmax] at hs
  exact hs.csSup_eq ⟨0,Set.mem_insert _ _⟩

/-- Strict loss at every other admissible parameter, including those
for which the positive stable-gain set is empty. -/
theorem gainCap_strictly_suboptimal {u v r t : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) (ht : -1 ≤ t) (hne : t ≠ r) :
    gainCap u v t < optimum u r := by
  by_cases hs : (stableGains u v t).Nonempty
  · rw [gainCap_eq_sSup_of_nonempty hu hv hr hr1 hf ht hs]
    exact suboptimal_parameter_strict hu hv hr hr1 hf ht hne hs
  · rw [gainCap_eq_zero_of_empty (Set.not_nonempty_iff_eq_empty.mp hs)]
    exact optimum_positive hu hr

theorem gainCap_global_bound {u v r t : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) (ht : -1 ≤ t) :
    gainCap u v t ≤ optimum u r := by
  by_cases htr : t = r
  · subst t
    exact le_of_eq (gainCap_at_optimum hu hv hr hr1 hf)
  · exact le_of_lt (gainCap_strictly_suboptimal hu hv hr hr1 hf ht htr)

theorem gainCap_eq_optimum_iff {u v r t : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) (ht : -1 ≤ t) :
    gainCap u v t = optimum u r ↔ t = r := by
  constructor
  · intro heq
    by_contra hne
    have hh := gainCap_strictly_suboptimal hu hv hr hr1 hf ht hne
    linarith
  · intro heq
    subst t
    exact gainCap_at_optimum hu hv hr hr1 hf

/-- Full existence, sharpness and unique gamma maximization with the paper's
zero-adjoined threshold convention. -/
theorem global_gamma_gainCap {u v : ℝ} (hu : 0 < u) (hv : 0 < v) :
    ∃ r : ℝ, 0 < r ∧ r < 1 ∧ f u v r = 0 ∧
      (∀ g : ℝ, 0 ≤ g → g ≤ 1 → gainCap u v (2*g-1) ≤ optimum u r) ∧
      (∀ g : ℝ, 0 ≤ g → g ≤ 1 →
        (gainCap u v (2*g-1) = optimum u r ↔ g = gamma r)) := by
  obtain ⟨r,⟨hr,hr1,hf⟩,_⟩ := exists_unique_optimal_root hu hv
  refine ⟨r,hr,hr1,hf,?_,?_⟩
  · intro g hg _
    exact gainCap_global_bound hu hv hr hr1 hf (by linarith)
  · intro g hg _
    rw [gainCap_eq_optimum_iff hu hv hr hr1 hf (by linarith)]
    unfold gamma
    constructor <;> intro h <;> linarith

end C2.SecondOrder

end

/- ===== C2.SecondOrderPolynomial ===== -/

/-! # The actual delayed characteristic polynomial for the second-order factor

This file connects the coefficient representation used by the optimization
proof to `z ((z-1)^2 + u (z-1) q + v q^2) + b q^2`, where
`q = gamma z + 1-gamma` and `gamma = (1+t)/2`.
-/

noncomputable section
namespace C2.SecondOrder

def delayCharacteristic (u v t b : ℝ) (z : ℂ) : ℂ :=
  let q := (gamma t : ℂ)*z + (1-(gamma t : ℂ))
  z*((z-1)^2+(u:ℂ)*(z-1)*q+(v:ℂ)*q^2)+(b:ℂ)*q^2

theorem delay_characteristic_identity (u v t b : ℝ) (z : ℂ) :
    delayCharacteristic u v t b z =
      (L u v t : ℂ)*z^3+(B u v t b : ℂ)*z^2+
        (C u v t b : ℂ)*z+(D t b : ℂ) := by
  simp only [delayCharacteristic, gamma, B, C, D, c, A0, A3, L]
  push_cast
  ring

theorem schur_iff_delay_characteristic {u v t b : ℝ} (hL : 0 < L u v t) :
    Schur u v t b ↔ ∀ z : ℂ, delayCharacteristic u v t b z = 0 → ‖z‖ < 1 := by
  have hLc : (L u v t : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hL
  have hfactor (z : ℂ) : delayCharacteristic u v t b z = (L u v t : ℂ) *
      (z^3+(B u v t b / L u v t : ℝ)*z^2+
        (C u v t b / L u v t : ℝ)*z+(D t b / L u v t : ℝ)) := by
    rw [delay_characteristic_identity]
    push_cast
    field_simp [hLc]
    ring
  constructor
  · intro hs z hz
    apply hs z
    rw [hfactor] at hz
    exact (mul_eq_zero.mp hz).resolve_left hLc
  · intro hs z hz
    apply hs z
    rw [hfactor, hz, mul_zero]

theorem optimal_boundary_factorization {u v r : ℝ}
    (hr : 0 < r) (hf : f u v r = 0) (z : ℂ) :
    delayCharacteristic u v r (optimum u r) z =
      (z+1)^2*((L u v r : ℂ)*z+(D r (optimum u r) : ℂ)) := by
  have hB : B u v r (optimum u r) = 2*L u v r+D r (optimum u r) := by
    rw [root_identity hr hf]
    simp only [B, D, c, A0, A3, L, rootV, optimum]
    field_simp [ne_of_gt hr]
    ring
  have hC : C u v r (optimum u r) = L u v r+2*D r (optimum u r) := by
    rw [root_identity hr hf]
    simp only [C, D, c, A0, A3, L, rootV, optimum]
    field_simp [ne_of_gt hr]
    ring
  rw [delay_characteristic_identity, hB, hC]
  push_cast
  ring

theorem optimal_third_root_ratio {u v r : ℝ}
    (hu : 0 < u) (hv : 0 < v) (hr : 0 < r) (hr1 : r < 1)
    (hf : f u v r = 0) :
    0 < D r (optimum u r) / L u v r ∧
      D r (optimum u r) / L u v r < 1 := by
  have hl : 0 < L u v r := by unfold L; positivity
  have hb := optimum_positive hu hr
  have hrem : 0 < 1-r := sub_pos.mpr hr1
  have hd : 0 < D r (optimum u r) := by unfold D c; positivity
  have hgap : 0 < L u v r-D r (optimum u r) := by
    rw [root_identity hr hf, third_root_gap u r (ne_of_gt hr)]
    have h64 : 0 < 6-4*r := by linarith
    positivity
  exact ⟨div_pos hd hl, (div_lt_one hl).mpr (by linarith)⟩

end C2.SecondOrder

end

/- ===== C2.Sensitivity ===== -/

/-! Exact frequency maxima for the one-delay gamma = 3/4 design.
The proofs use polynomial identities and square positivity, so no sampling
or unproved differentiation/critical-point hypothesis is involved. -/
noncomputable section
namespace C2.Sensitivity

def denominator (a x : ℝ) : ℝ :=
  a * x ^ 2 + (3 * a ^ 2 / 8 + a - 2) * x + 5 * a ^ 2 / 8 - 2 * a + 2

def sSquared (a x : ℝ) : ℝ := 2 * (1 - x) / denominator a x
def tSquared (a x : ℝ) : ℝ := a ^ 2 * (5 + 3 * x) / (8 * denominator a x)
def sLocation (a : ℝ) : ℝ := 1 - Real.sqrt a
def tLocation (a : ℝ) : ℝ := (-5 + 2 * Real.sqrt (12 / a - 2)) / 3
def sFactor (a : ℝ) : ℝ := (2 - Real.sqrt a) ^ 3 * (2 + 3 * Real.sqrt a)

theorem sqrt_bounds {a : ℝ} (ha : 0 < a) (ha4 : a < 4) :
    0 < Real.sqrt a ∧ Real.sqrt a < 2 := by
  have hs := Real.sq_sqrt ha.le
  have hpos := Real.sqrt_pos.mpr ha
  exact ⟨hpos, by nlinarith⟩

theorem sFactor_pos {a : ℝ} (ha : 0 < a) (ha4 : a < 4) : 0 < sFactor a := by
  obtain ⟨hs0, hs2⟩ := sqrt_bounds ha ha4
  have hsub : 0 < 2 - Real.sqrt a := by linarith
  unfold sFactor
  positivity

theorem denominator_square_identity {a : ℝ} (ha : 0 ≤ a) (x : ℝ) :
    denominator a x = a * (x - sLocation a) ^ 2 + (1 - x) * sFactor a / 8 := by
  have hs := Real.sq_sqrt ha
  unfold denominator sLocation sFactor
  generalize Real.sqrt a = s at *
  rw [← hs]
  ring

theorem denominator_pos {a x : ℝ} (ha : 0 < a) (ha4 : a < 4)
    (hx : x ≤ 1) : 0 < denominator a x := by
  rw [denominator_square_identity ha.le]
  have hF := sFactor_pos ha ha4
  by_cases he : x = 1
  · subst x
    simp only [sub_self, zero_mul, zero_div, add_zero, sLocation]
    have hs := Real.sq_sqrt ha.le
    nlinarith [mul_pos ha ha]
  · have hxlt : x < 1 := lt_of_le_of_ne hx he
    have h1 := mul_nonneg ha.le (sq_nonneg (x - sLocation a))
    have h2 := mul_pos (sub_pos.mpr hxlt) hF
    linarith

theorem sLocation_mem {a : ℝ} (ha : 0 < a) (ha4 : a < 4) :
    sLocation a ∈ Set.Ioo (-1 : ℝ) 1 := by
  have hs := sqrt_bounds ha ha4
  constructor <;> dsimp [sLocation] <;> linarith

theorem sSquared_at_max {a : ℝ} (ha : 0 < a) (ha4 : a < 4) :
    sSquared a (sLocation a) = 16 / sFactor a := by
  have hs : 1 - sLocation a ≠ 0 := by
    have h := sLocation_mem ha ha4
    linarith [h.2]
  have hF := ne_of_gt (sFactor_pos ha ha4)
  unfold sSquared
  rw [denominator_square_identity ha.le]
  simp only [sub_self, zero_pow, mul_zero, zero_add]
  field_simp [hs, hF]
  <;> ring

theorem sSquared_le_max {a x : ℝ} (ha : 0 < a) (ha4 : a < 4)
    (hx : x ≤ 1) : sSquared a x ≤ 16 / sFactor a := by
  have hD := denominator_pos ha ha4 hx
  have hF := sFactor_pos ha ha4
  unfold sSquared
  apply (div_le_div_iff₀ hD hF).mpr
  rw [denominator_square_identity ha.le]
  nlinarith [mul_nonneg ha.le (sq_nonneg (x - sLocation a))]

theorem sSquared_greatest {a : ℝ} (ha : 0 < a) (ha4 : a < 4) :
    IsGreatest (sSquared a '' Set.Icc (-1 : ℝ) 1) (16 / sFactor a) := by
  constructor
  · exact ⟨sLocation a, ⟨(sLocation_mem ha ha4).1.le,
      (sLocation_mem ha ha4).2.le⟩, sSquared_at_max ha ha4⟩
  · rintro y ⟨x, hx, rfl⟩
    exact sSquared_le_max ha ha4 hx.2

theorem denominator_one (a : ℝ) : denominator a 1 = a ^ 2 := by
  unfold denominator
  ring

theorem tSquared_one {a : ℝ} (ha : 0 < a) : tSquared a 1 = 1 := by
  unfold tSquared
  rw [denominator_one]
  field_simp [ne_of_gt ha]
  <;> ring

theorem tSquared_low_le_one {a x : ℝ} (ha : 0 < a) (ha23 : a ≤ 2 / 3)
    (hx : x ≤ 1) : tSquared a x ≤ 1 := by
  have hD := denominator_pos ha (by linarith) hx
  unfold tSquared
  apply (div_le_one (by positivity : 0 < 8 * denominator a x)).mpr
  have hm : 0 ≤ (x - 1) * (a * x + 2 * a - 2) := by
    apply mul_nonneg_of_nonpos_of_nonpos (by linarith)
    nlinarith
  unfold denominator
  nlinarith

theorem tSquared_low_greatest {a : ℝ} (ha : 0 < a) (ha23 : a ≤ 2 / 3) :
    IsGreatest (tSquared a '' Set.Icc (-1 : ℝ) 1) 1 := by
  refine ⟨⟨1, ⟨by norm_num, le_rfl⟩, tSquared_one ha⟩, ?_⟩
  rintro y ⟨x, hx, rfl⟩
  exact tSquared_low_le_one ha ha23 hx.2

theorem tLocation_properties {a : ℝ} (ha23 : 2 / 3 < a) (ha4 : a < 4) :
    -1 < tLocation a ∧ tLocation a < 1 ∧
      3 * a * tLocation a ^ 2 + 10 * a * tLocation a + 11 * a - 16 = 0 := by
  have ha : 0 < a := by linarith
  have hrad : 0 < 12 / a - 2 := by
    have : 2 * a < 12 := by linarith
    have := (lt_div_iff₀ ha).mpr this
    linarith
  have hs := Real.sq_sqrt hrad.le
  have hs0 := Real.sqrt_nonneg (12 / a - 2)
  have he : a * Real.sqrt (12 / a - 2) ^ 2 = 12 - 2 * a := by
    calc
      _ = a * (12 / a - 2) := by rw [hs]
      _ = _ := by field_simp; ring
  have hlow : 1 < Real.sqrt (12 / a - 2) := by
    by_contra! hn
    have hsle : Real.sqrt (12 / a - 2) ^ 2 ≤ 1 := by nlinarith
    nlinarith [mul_le_mul_of_nonneg_left hsle ha.le]
  have hupp : Real.sqrt (12 / a - 2) < 4 := by
    by_contra! hn
    have hsle : 16 ≤ Real.sqrt (12 / a - 2) ^ 2 := by nlinarith
    nlinarith [mul_le_mul_of_nonneg_left hsle ha.le]
  unfold tLocation
  refine ⟨by linarith, by linarith, ?_⟩
  nlinarith

theorem t_difference_identity (a k x : ℝ) :
    (5 + 3 * k) * denominator a x - (5 + 3 * x) * denominator a k =
      a * (5 + 3 * k) * (x - k) ^ 2 +
        (x - k) * (3 * a * k ^ 2 + 10 * a * k + 11 * a - 16) := by
  unfold denominator
  ring

theorem tSquared_high_le_max {a x : ℝ} (ha23 : 2 / 3 < a) (ha4 : a < 4)
    (hx : x ≤ 1) : tSquared a x ≤ tSquared a (tLocation a) := by
  have ha : 0 < a := by linarith
  obtain ⟨hklo, hkhi, hk⟩ := tLocation_properties ha23 ha4
  have hDx := denominator_pos ha ha4 hx
  have hDk := denominator_pos ha ha4 hkhi.le
  unfold tSquared
  apply (div_le_div_iff₀ (by positivity : 0 < 8 * denominator a x)
    (by positivity : 0 < 8 * denominator a (tLocation a))).mpr
  have hid := t_difference_identity a (tLocation a) x
  rw [hk, mul_zero, add_zero] at hid
  have hprod : 0 ≤ a * (5 + 3 * tLocation a) * (x - tLocation a) ^ 2 := by
    apply mul_nonneg (mul_nonneg ha.le (by linarith)) (sq_nonneg _)
  have h := mul_nonneg (sq_nonneg a) hprod
  nlinarith

theorem tSquared_high_gt_one {a : ℝ} (ha23 : 2 / 3 < a) (ha4 : a < 4) :
    1 < tSquared a (tLocation a) := by
  have ha : 0 < a := by linarith
  obtain ⟨hklo, hkhi, hk⟩ := tLocation_properties ha23 ha4
  have hDk := denominator_pos ha ha4 hkhi.le
  have hid := t_difference_identity a (tLocation a) 1
  rw [hk, mul_zero, add_zero, denominator_one] at hid
  have hprod : 0 < a * (5 + 3 * tLocation a) * (1 - tLocation a) ^ 2 :=
    mul_pos (mul_pos ha (by linarith)) (sq_pos_of_pos (by linarith))
  unfold tSquared
  apply (one_lt_div (by positivity : 0 < 8 * denominator a (tLocation a))).mpr
  nlinarith

theorem tSquared_high_greatest {a : ℝ} (ha23 : 2 / 3 < a) (ha4 : a < 4) :
    IsGreatest (tSquared a '' Set.Icc (-1 : ℝ) 1) (tSquared a (tLocation a)) := by
  obtain ⟨hlo, hhi, _⟩ := tLocation_properties ha23 ha4
  refine ⟨⟨tLocation a, ⟨hlo.le, hhi.le⟩, rfl⟩, ?_⟩
  rintro y ⟨x, hx, rfl⟩
  exact tSquared_high_le_max ha23 ha4 hx.2

def characteristic (a : ℝ) (z : ℂ) : ℂ :=
  z ^ 2 + ((3 * a / 4 - 1 : ℝ) : ℂ) * z + ((a / 4 : ℝ) : ℂ)
def sensitivity (a : ℝ) (z : ℂ) : ℂ := z * (z - 1) / characteristic a z
def complementary (a : ℝ) (z : ℂ) : ℂ :=
  (((3 * a / 4 : ℝ) : ℂ) * z + ((a / 4 : ℝ) : ℂ)) / characteristic a z

theorem unit_re_mem {z : ℂ} (hz : ‖z‖ = 1) : z.re ∈ Set.Icc (-1 : ℝ) 1 := by
  have h := Complex.abs_re_le_norm z
  rw [hz] at h
  exact abs_le.mp h

theorem unit_parts {z : ℂ} (hz : ‖z‖ = 1) : z.re ^ 2 + z.im ^ 2 = 1 := by
  have h : ‖z‖ ^ 2 = z.re ^ 2 + z.im ^ 2 := by
    rw [Complex.sq_norm, Complex.normSq_apply]
    ring
  rw [hz] at h
  linarith

theorem characteristic_norm_sq {z : ℂ} (hz : ‖z‖ = 1) (a : ℝ) :
    ‖characteristic a z‖ ^ 2 = denominator a z.re := by
  have h := unit_parts hz
  calc
    _ = (z.re ^ 2 + z.im ^ 2) ^ 2 +
        (3 * a / 4 - 1) ^ 2 * (z.re ^ 2 + z.im ^ 2) + (a / 4) ^ 2 +
        2 * (3 * a / 4 - 1) * z.re * (z.re ^ 2 + z.im ^ 2 + a / 4) +
        2 * (a / 4) * (z.re ^ 2 - z.im ^ 2) := by
      rw [Complex.sq_norm, Complex.normSq_apply]
      simp [characteristic, Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im, pow_two]
      ring
    _ = _ := by
      rw [h]
      unfold denominator
      linear_combination -(a / 2) * h

theorem sensitivity_norm_sq {z : ℂ} (hz : ‖z‖ = 1) (a : ℝ) :
    ‖sensitivity a z‖ ^ 2 = sSquared a z.re := by
  have h := unit_parts hz
  have hn : ‖z * (z - 1)‖ ^ 2 = 2 * (1 - z.re) := by
    rw [norm_mul, mul_pow, hz]
    simp only [one_pow, one_mul]
    rw [Complex.sq_norm, Complex.normSq_apply]
    simp only [Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im, sub_zero]
    nlinarith [h]
  unfold sensitivity sSquared
  rw [norm_div, div_pow, hn, characteristic_norm_sq hz]

theorem complementary_norm_sq {z : ℂ} (hz : ‖z‖ = 1) (a : ℝ) :
    ‖complementary a z‖ ^ 2 = tSquared a z.re := by
  have h := unit_parts hz
  have hn : ‖((3 * a / 4 : ℝ) : ℂ) * z + ((a / 4 : ℝ) : ℂ)‖ ^ 2 =
      a ^ 2 * (5 + 3 * z.re) / 8 := by
    calc
      _ = 9 * a ^ 2 / 16 * (z.re ^ 2 + z.im ^ 2) +
          3 * a ^ 2 / 8 * z.re + a ^ 2 / 16 := by
        rw [Complex.sq_norm, Complex.normSq_apply]
        simp [pow_two]
        ring
      _ = _ := by rw [h]; ring
  unfold complementary tSquared
  rw [norm_div, div_pow, hn, characteristic_norm_sq hz]
  ring

def unitPoint (x : ℝ) : ℂ := ⟨x, Real.sqrt (1 - x ^ 2)⟩

theorem unitPoint_norm {x : ℝ} (hx : x ∈ Set.Icc (-1 : ℝ) 1) :
    ‖unitPoint x‖ = 1 := by
  have hrad : 0 ≤ 1 - x ^ 2 := by nlinarith [hx.1, hx.2]
  have hs := Real.sq_sqrt hrad
  have hn : ‖unitPoint x‖ ^ 2 = 1 := by
    rw [Complex.sq_norm, Complex.normSq_apply]
    dsimp [unitPoint]
    nlinarith
  nlinarith [norm_nonneg (unitPoint x)]

def circleNorm (f : ℂ → ℂ) : ℝ := sSup {v | ∃ z : ℂ, ‖z‖ = 1 ∧ v = ‖f z‖}

theorem circleNorm_of_squared_greatest {f : ℂ → ℂ} {q : ℝ → ℝ} {M : ℝ}
    (hq : ∀ z : ℂ, ‖z‖ = 1 → ‖f z‖ ^ 2 = q z.re)
    (hM : IsGreatest (q '' Set.Icc (-1 : ℝ) 1) M) :
    circleNorm f = Real.sqrt M := by
  obtain ⟨k, hk, hkM⟩ := hM.1
  have hkN := hq (unitPoint k) (unitPoint_norm hk)
  change ‖f (unitPoint k)‖ ^ 2 = q k at hkN
  have hM0 : 0 ≤ M := by rw [← hkM, ← hkN]; positivity
  have hval : ‖f (unitPoint k)‖ = Real.sqrt M := by
    have hs := Real.sq_sqrt hM0
    rw [hkM] at hkN
    nlinarith [norm_nonneg (f (unitPoint k)), Real.sqrt_nonneg M]
  apply IsGreatest.csSup_eq
  constructor
  · exact ⟨unitPoint k, unitPoint_norm hk, hval.symm⟩
  · rintro v ⟨z, hz, rfl⟩
    have hb := hM.2 (Set.mem_image_of_mem q (unit_re_mem hz))
    rw [← hq z hz] at hb
    have hs := Real.sq_sqrt hM0
    nlinarith [norm_nonneg (f z), Real.sqrt_nonneg M]

/-- The actual unit-circle sensitivity norm, with the explicit attained value. -/
theorem exact_sensitivity_peak {a : ℝ} (ha : 0 < a) (ha4 : a < 4) :
    circleNorm (sensitivity a) = 4 / Real.sqrt (sFactor a) := by
  rw [circleNorm_of_squared_greatest (fun z hz => sensitivity_norm_sq hz a)
    (sSquared_greatest ha ha4)]
  rw [Real.sqrt_div (by norm_num : (0 : ℝ) ≤ 16)]
  norm_num

theorem exact_complementary_low_peak {a : ℝ} (ha : 0 < a) (ha23 : a ≤ 2 / 3) :
    circleNorm (complementary a) = 1 := by
  rw [circleNorm_of_squared_greatest (fun z hz => complementary_norm_sq hz a)
    (tSquared_low_greatest ha ha23)]
  norm_num

theorem exact_complementary_high_peak {a : ℝ} (ha23 : 2 / 3 < a) (ha4 : a < 4) :
    circleNorm (complementary a) = Real.sqrt (tSquared a (tLocation a)) ∧
      1 < circleNorm (complementary a) := by
  have he := circleNorm_of_squared_greatest (fun z hz => complementary_norm_sq hz a)
    (tSquared_high_greatest ha23 ha4)
  refine ⟨he, ?_⟩
  rw [he]
  have hg := tSquared_high_gt_one ha23 ha4
  have hs := Real.sq_sqrt (show 0 ≤ tSquared a (tLocation a) by linarith)
  nlinarith [Real.sqrt_nonneg (tSquared a (tLocation a))]

theorem sensitivity_peak_attained {a : ℝ} (ha : 0 < a) (ha4 : a < 4) :
    ‖unitPoint (sLocation a)‖ = 1 ∧
      ‖sensitivity a (unitPoint (sLocation a))‖ = circleNorm (sensitivity a) := by
  have hk := sLocation_mem ha ha4
  have hz := unitPoint_norm ⟨hk.1.le, hk.2.le⟩
  refine ⟨hz, ?_⟩
  rw [circleNorm_of_squared_greatest (fun z h => sensitivity_norm_sq h a)
    (sSquared_greatest ha ha4)]
  have h := sensitivity_norm_sq hz a
  change ‖sensitivity a (unitPoint (sLocation a))‖ ^ 2 = sSquared a (sLocation a) at h
  rw [sSquared_at_max ha ha4] at h
  rw [← h, Real.sqrt_sq_eq_abs, abs_of_nonneg (norm_nonneg _)]

theorem complementary_high_peak_attained {a : ℝ} (ha23 : 2 / 3 < a) (ha4 : a < 4) :
    ‖unitPoint (tLocation a)‖ = 1 ∧
      ‖complementary a (unitPoint (tLocation a))‖ = circleNorm (complementary a) := by
  obtain ⟨hlo, hhi, _⟩ := tLocation_properties ha23 ha4
  have hz := unitPoint_norm ⟨hlo.le, hhi.le⟩
  refine ⟨hz, ?_⟩
  rw [(exact_complementary_high_peak ha23 ha4).1]
  have h := complementary_norm_sq hz a
  change ‖complementary a (unitPoint (tLocation a))‖ ^ 2 = tSquared a (tLocation a) at h
  rw [← h, Real.sqrt_sq_eq_abs, abs_of_nonneg (norm_nonneg _)]

end C2.Sensitivity

end

/- ===== C2.TwoGammaAlgebra ===== -/

/-! Closed-form two-factor endpoint allocation. The generic optimizer is
specialized through its proved resource equation, rather than presumed to
have the displayed parameter values. -/
noncomputable section
open scoped BigOperators
open Set
namespace C2.TwoGamma

def gain (r₁ r₂ : ℝ) : ℝ :=
  (Real.sqrt (1+r₁+r₂) + Real.sqrt (1+r₁+r₂+r₁*r₂))^2

def radical (r₁ r₂ : ℝ) : ℝ := Real.sqrt ((1+r₁+r₂)*(1+r₁+r₂+r₁*r₂))
def allocation (r₁ r₂ : ℝ) : ℝ := (gain r₁ r₂+r₁^2)/(r₁+r₂+2)
def scalar (r₁ r₂ : ℝ) : ℝ := allocation r₁ r₂+allocation r₂ r₁-r₁-r₂-2

def optimalX (r₁ r₂ : ℝ) : ℝ :=
  (gain r₁ r₂-r₁*r₂-2*r₂)/(gain r₁ r₂+r₁*r₂)

def optimalGamma (r₁ r₂ : ℝ) : ℝ := (1+optimalX r₁ r₂)/2

theorem gain_comm (r₁ r₂ : ℝ) : gain r₂ r₁ = gain r₁ r₂ := by
  unfold gain
  congr 2 <;> congr 1 <;> ring

theorem gain_expanded {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    gain r₁ r₂ = 2*(1+r₁+r₂)+r₁*r₂+2*radical r₁ r₂ := by
  have ha := Real.sq_sqrt (show 0 ≤ 1+r₁+r₂ by linarith)
  have hb := Real.sq_sqrt (show 0 ≤ 1+r₁+r₂+r₁*r₂ by positivity)
  have hc : radical r₁ r₂ = Real.sqrt (1+r₁+r₂)*Real.sqrt (1+r₁+r₂+r₁*r₂) := by
    exact Real.sqrt_mul (by linarith) _
  unfold gain
  rw [hc]
  nlinarith

theorem gain_quadratic {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    (gain r₁ r₂-r₁*r₂)^2 = 4*(1+r₁+r₂)*gain r₁ r₂ := by
  have hq := Real.sq_sqrt (show 0 ≤ (1+r₁+r₂)*(1+r₁+r₂+r₁*r₂) by positivity)
  change (radical r₁ r₂)^2 = _ at hq
  rw [gain_expanded h₁ h₂]
  nlinarith [hq]

theorem radical_gt {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    1+r₁ < radical r₁ r₂ := by
  have hq := Real.sq_sqrt (show 0 ≤ (1+r₁+r₂)*(1+r₁+r₂+r₁*r₂) by positivity)
  change (radical r₁ r₂)^2 = _ at hq
  have hn : 0 ≤ radical r₁ r₂ := Real.sqrt_nonneg _
  have hp : 0 < r₂*(1+r₁)*(r₁+r₂+2) := by positivity
  nlinarith [hq]

theorem gain_pos {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) : 0 < gain r₁ r₂ := by
  rw [gain_expanded h₁ h₂]
  have : 0 ≤ radical r₁ r₂ := Real.sqrt_nonneg _
  positivity

theorem allocation_gt {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    r₁+2 < allocation r₁ r₂ := by
  have hr := radical_gt h₁ h₂
  have hg := gain_expanded h₁ h₂
  unfold allocation
  apply (lt_div_iff₀ (show 0 < r₁+r₂+2 by linarith)).mpr
  nlinarith

theorem allocation_mul {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    allocation r₁ r₂ * allocation r₂ r₁ = gain r₁ r₂ := by
  have hd : r₁+r₂+2 ≠ 0 := by positivity
  have hq := gain_quadratic h₁ h₂
  have he : r₂+r₁+2 = r₁+r₂+2 := by ring
  unfold allocation
  rw [gain_comm r₁ r₂, he]
  field_simp
  nlinarith [hq]

theorem scalar_pos {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    0 < scalar r₁ r₂ := by
  unfold scalar
  linarith [allocation_gt h₁ h₂, allocation_gt h₂ h₁]

theorem allocation_stationarity {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    allocation r₁ r₂-r₁^2/allocation r₁ r₂ = scalar r₁ r₂ := by
  have ht : 0 < allocation r₁ r₂ := by linarith [allocation_gt h₁ h₂]
  have hden : allocation r₁ r₂*(r₁+r₂+2) = gain r₁ r₂+r₁^2 := by
    unfold allocation
    field_simp
  have hp := allocation_mul h₁ h₂
  unfold scalar
  field_simp [ne_of_gt ht]
  nlinarith [hden,hp]

theorem scalar_comm (r₁ r₂ : ℝ) : scalar r₂ r₁ = scalar r₁ r₂ := by
  unfold scalar
  ring

end C2.TwoGamma

end

/- ===== C2.TwoGammaBasic ===== -/

/-! Exact specialization of the arbitrary-order cascade theorem to the
manuscript's two independently discretized first-order factors. -/
noncomputable section
open scoped BigOperators
open Polynomial Set
namespace C2.TwoGamma
open NGamma NGamma.PolynomialModel NGamma.Parameterization

def poles (r₁ r₂ : ℝ) : Fin 2 → ℝ := ![r₁, r₂]
def coordinates (γ₁ γ₂ : ℝ) : Fin 2 → ℝ := ![xOfGamma γ₁, xOfGamma γ₂]

def characteristic (r₁ r₂ γ₁ γ₂ b : ℝ) : Polynomial ℂ :=
  X * ((X-1) + C (r₁:ℂ) * (C (γ₁:ℂ)*X+C (1-(γ₁:ℂ)))) *
      ((X-1) + C (r₂:ℂ) * (C (γ₂:ℂ)*X+C (1-(γ₂:ℂ)))) +
    C (b:ℂ) * (C (γ₁:ℂ)*X+C (1-(γ₁:ℂ))) * (C (γ₂:ℂ)*X+C (1-(γ₂:ℂ)))

theorem characteristic_eq_generic (r₁ r₂ γ₁ γ₂ b : ℝ) :
    characteristic r₁ r₂ γ₁ γ₂ b =
      PolynomialModel.characteristic (poles r₁ r₂) (coordinates γ₁ γ₂) 1 b := by
  simp [characteristic, PolynomialModel.characteristic, poles, coordinates,
    Fin.prod_univ_two, PolynomialModel.factor, numerator_factor]
  ring

theorem poles_pos {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    ∀ i, 0 < poles r₁ r₂ i := by
  intro i
  fin_cases i
  · simpa [poles] using h₁
  · simpa [poles] using h₂

theorem coordinates_in_half_cube {γ₁ γ₂ : ℝ}
    (h₁ : γ₁ ∈ Icc (1/2:ℝ) 1) (h₂ : γ₂ ∈ Icc (1/2:ℝ) 1) :
    ∀ i, coordinates γ₁ γ₂ i ∈ Icc (0:ℝ) 1 := by
  intro i
  fin_cases i
  · simpa [coordinates] using (half_cube_coordinate γ₁).mp h₁
  · simpa [coordinates] using (half_cube_coordinate γ₂).mp h₂

end C2.TwoGamma

end

/- ===== C2.TwoGammaCoefficients ===== -/

/-! Exact cubic coefficient and high-gain exclusion algebra. -/
noncomputable section
namespace C2.TwoGamma

def A0 (r₁ r₂ b : ℝ) : ℝ := r₁*r₂+b
def A1 (r₁ r₂ x y b : ℝ) : ℝ := 2*(r₁+r₂)+r₁*r₂-b+(r₁*r₂+b)*(x+y)
def A2 (r₁ r₂ x y b : ℝ) : ℝ :=
  4+2*(r₁+r₂)+(2*r₁+r₁*r₂-b)*x+(2*r₂+r₁*r₂-b)*y+(r₁*r₂+b)*x*y
def A3 (r₁ r₂ x y b : ℝ) : ℝ := 4+2*r₁*x+2*r₂*y+(r₁*r₂-b)*x*y
def H (r₁ r₂ x y b : ℝ) : ℝ := A1 r₁ r₂ x y b*A2 r₁ r₂ x y b-A0 r₁ r₂ b*A3 r₁ r₂ x y b

def leading (r₁ r₂ x y : ℝ) : ℝ := (1+r₁*(1+x)/2)*(1+r₂*(1+y)/2)
def constantCoeff (x y b : ℝ) : ℝ := b*(1-x)*(1-y)/4
def middleB (r₁ r₂ x y b : ℝ) : ℝ := (A0 r₁ r₂ b-A3 r₁ r₂ x y b)/2-constantCoeff x y b
def middleC (r₁ r₂ x y b : ℝ) : ℝ := (A0 r₁ r₂ b+A3 r₁ r₂ x y b)/2-leading r₁ r₂ x y

theorem coefficient_identities (r₁ r₂ x y b : ℝ) :
    leading r₁ r₂ x y+middleB r₁ r₂ x y b+middleC r₁ r₂ x y b+constantCoeff x y b = A0 r₁ r₂ b ∧
    leading r₁ r₂ x y-middleB r₁ r₂ x y b+middleC r₁ r₂ x y b-constantCoeff x y b = A3 r₁ r₂ x y b ∧
    8*(leading r₁ r₂ x y^2-leading r₁ r₂ x y*middleC r₁ r₂ x y b+
      middleB r₁ r₂ x y b*constantCoeff x y b-constantCoeff x y b^2)=H r₁ r₂ x y b ∧
    A1 r₁ r₂ x y b+A2 r₁ r₂ x y b=6*leading r₁ r₂ x y-2*middleC r₁ r₂ x y b := by
  simp only [leading, middleB, middleC, constantCoeff, H, A0, A1, A2, A3]
  constructor
  · ring
  constructor
  · ring
  constructor <;> ring

theorem gain_discriminant_nonneg {r₁ r₂ b : ℝ}
    (h₁ : 0 < r₁) (h₂ : 0 < r₂) (hb : gain r₁ r₂ ≤ b) :
    0 ≤ (b-r₁*r₂)^2-4*(1+r₁+r₂)*b := by
  have hq := gain_quadratic h₁ h₂
  have he := gain_expanded h₁ h₂
  have hr : 0 ≤ radical r₁ r₂ := Real.sqrt_nonneg _
  have hh : 0 ≤ b+gain r₁ r₂-2*r₁*r₂-4*(1+r₁+r₂) := by linarith
  have hp := mul_nonneg (sub_nonneg.mpr hb) hh
  nlinarith [hq]

theorem gain_minus_product_gt {r₁ r₂ b : ℝ}
    (h₁ : 0 < r₁) (h₂ : 0 < r₂) (hb : gain r₁ r₂ ≤ b) :
    2*(r₁+r₂) < b-r₁*r₂ := by
  have he := gain_expanded h₁ h₂
  have hr : 0 ≤ radical r₁ r₂ := Real.sqrt_nonneg _
  linarith

theorem centered_identities (r₁ r₂ x y b : ℝ) :
    let w := b+r₁*r₂
    let l := b-r₁*r₂
    let U := l-2*r₂-w*x
    let V := l-2*r₁-w*y
    let E := l^2-4*(1+r₁+r₂)*b
    A1 r₁ r₂ x y b = l-U-V ∧
    w*A2 r₁ r₂ x y b = U*V-E ∧
    w*H r₁ r₂ x y b = U*V*(2*l-U-V)-4*b*((1+r₁)*V+(1+r₂)*U) := by
  dsimp
  simp only [A1, A2, H, A0, A3]
  constructor
  · ring
  constructor <;> ring

/-- Even the closed limiting necessary inequalities at a gain at least B
exclude any nonpositive first coordinate. This also handles uniqueness of
limiting optimizers, not just strict stability. -/
theorem closed_high_gain_exclusion_left {r₁ r₂ x y b : ℝ}
    (h₁ : 0 < r₁) (h₂ : 0 < r₂) (hb : gain r₁ r₂ ≤ b) (hx : x ≤ 0)
    (hA1 : 0 ≤ A1 r₁ r₂ x y b) (hA2 : 0 ≤ A2 r₁ r₂ x y b)
    (hH : 0 ≤ H r₁ r₂ x y b) : False := by
  let w := b+r₁*r₂
  let l := b-r₁*r₂
  let U := l-2*r₂-w*x
  let V := l-2*r₁-w*y
  let E := l^2-4*(1+r₁+r₂)*b
  have hb0 : 0 < b := lt_of_lt_of_le (gain_pos h₁ h₂) hb
  have hw : 0 < w := by dsimp [w]; positivity
  have hl : 2*(r₁+r₂) < l := gain_minus_product_gt h₁ h₂ hb
  have hE : 0 ≤ E := gain_discriminant_nonneg h₁ h₂ hb
  have hUbound : l-2*r₂ ≤ U := by
    dsimp [U]
    have hh := mul_nonpos_of_nonneg_of_nonpos hw.le hx
    linarith
  have hU : 0 < U := by linarith
  obtain ⟨ha₁,ha₂,hHid⟩ := centered_identities r₁ r₂ x y b
  change A1 r₁ r₂ x y b = l-U-V at ha₁
  change w*A2 r₁ r₂ x y b = U*V-E at ha₂
  change w*H r₁ r₂ x y b = U*V*(2*l-U-V)-4*b*((1+r₁)*V+(1+r₂)*U) at hHid
  have hlb : l < b := by dsimp [l]; nlinarith [mul_pos h₁ h₂]
  clear_value w l U V E
  have hUV : 0 ≤ U*V := by nlinarith [mul_nonneg hw.le hA2]
  have hV : 0 ≤ V := (mul_nonneg_iff_of_pos_left hU).mp hUV
  have hVbound : V ≤ 2*r₂ := by linarith
  have hsmall : l*V < 2*b*(1+r₂) := by
    have hh := mul_nonneg (by linarith : 0 ≤ b-l) hV
    have hh' := mul_nonneg hb0.le (by linarith : 0 ≤ 2*r₂-V)
    nlinarith
  have hmain := mul_pos hU (show 0 < 2*b*(1+r₂)-l*V by linarith)
  have hother := mul_nonneg (by positivity : 0 ≤ 4*b*(1+r₁)) hV
  have hUVsum := mul_nonneg hUV (by linarith : 0 ≤ U+V)
  have hstable := mul_nonneg hw.le hH
  nlinarith [hHid]

theorem swap_coefficients (r₁ r₂ x y b : ℝ) :
    A1 r₂ r₁ y x b = A1 r₁ r₂ x y b ∧
    A2 r₂ r₁ y x b = A2 r₁ r₂ x y b ∧
    H r₂ r₁ y x b = H r₁ r₂ x y b := by
  simp only [A1, A2, H, A0, A3]
  constructor
  · ring
  constructor <;> ring

theorem closed_high_gain_exclusion_right {r₁ r₂ x y b : ℝ}
    (h₁ : 0 < r₁) (h₂ : 0 < r₂) (hb : gain r₁ r₂ ≤ b) (hy : y ≤ 0)
    (hA1 : 0 ≤ A1 r₁ r₂ x y b) (hA2 : 0 ≤ A2 r₁ r₂ x y b)
    (hH : 0 ≤ H r₁ r₂ x y b) : False := by
  obtain ⟨ha,hb',hc⟩ := swap_coefficients r₁ r₂ x y b
  apply closed_high_gain_exclusion_left (x := y) (y := x) h₂ h₁ (by simpa [gain_comm] using hb) hy
  · simpa only [ha] using hA1
  · simpa only [hb'] using hA2
  · simpa only [hc] using hH

end C2.TwoGamma

end

/- ===== C2.TwoGammaConnected ===== -/

noncomputable section
open scoped BigOperators
open Polynomial Set
namespace C2.TwoGamma
open NGamma NGamma.PolynomialModel NGamma.Parameterization

/-- Complete numbered lemma `lem:two-gamma-connected`, in the paper's gamma
coordinates and with its actual complex characteristic polynomial. -/
theorem connected_stable_gain_interval {r₁ r₂ γ₁ γ₂ : ℝ}
    (hr₁ : 0 < r₁) (hr₂ : 0 < r₂)
    (hγ₁ : γ₁ ∈ Icc (1/2:ℝ) 1) (hγ₂ : γ₂ ∈ Icc (1/2:ℝ) 1) :
    ∃ B : ℝ, 0 < B ∧
      {b : ℝ | 0 ≤ b ∧ SchurStable (characteristic r₁ r₂ γ₁ γ₂ b)} = Ico 0 B := by
  have hr := poles_pos hr₁ hr₂
  have hx := coordinates_in_half_cube hγ₁ hγ₂
  have hinterval : ∃ B : ℝ, 0 < B ∧ ∀ b : ℝ, 0 ≤ b →
      (SchurStable (PolynomialModel.characteristic (poles r₁ r₂) (coordinates γ₁ γ₂) 1 b) ↔ b < B) := by
    rcases Cayley.single_sample_exact_gain_interval (by norm_num : 0 < (2:ℕ))
      hr (fun i => (hx i).1) (fun i => (hx i).2) with he | hi
    · obtain ⟨hxp,hS,hs,hroot⟩ := he
      exact ⟨_,Finset.prod_pos (fun i _ => by have := hr i; have := hxp i; positivity),hs⟩
    · obtain ⟨s,⟨hs,hphase,hstable,hroot,hnorm⟩,_⟩ := hi
      exact ⟨_,Cayley.amplitude_pos hr _ s,hstable⟩
  obtain ⟨B,hB,hstable⟩ := hinterval
  refine ⟨B,hB,?_⟩
  ext b
  simp only [Set.mem_setOf_eq,mem_Ico]
  constructor
  · rintro ⟨hb,hs⟩
    rw [characteristic_eq_generic] at hs
    exact ⟨hb,(hstable b hb).mp hs⟩
  · rintro ⟨hb,hbB⟩
    refine ⟨hb,?_⟩
    rw [characteristic_eq_generic]
    exact (hstable b hb).mpr hbB

end C2.TwoGamma

end

/- ===== C2.TwoGammaCubic ===== -/

/-! Cubic necessary inequalities for the complete parameter square. -/
noncomputable section
open scoped BigOperators
open Polynomial Set
namespace C2.TwoGamma
open NGamma NGamma.PolynomialModel

theorem polynomial_coefficients (r₁ r₂ x y b : ℝ) (z : ℂ) :
    (PolynomialModel.characteristic (poles r₁ r₂) ![x,y] 1 b).eval z =
      (leading r₁ r₂ x y:ℂ)*z^3+(middleB r₁ r₂ x y b:ℂ)*z^2+
      (middleC r₁ r₂ x y b:ℂ)*z+(constantCoeff x y b:ℂ) := by
  simp [PolynomialModel.characteristic,poles,Fin.prod_univ_two,
    factor_eval,q_eval,leading,middleB,middleC,constantCoeff,A0,A3]
  push_cast
  ring

theorem leading_pos {r₁ r₂ x y : ℝ} (hr₁ : 0 < r₁) (hr₂ : 0 < r₂)
    (hx : -1 ≤ x) (hy : -1 ≤ y) : 0 < leading r₁ r₂ x y := by
  unfold leading
  have hx' : 0 ≤ 1+x := by linarith
  have hy' : 0 ≤ 1+y := by linarith
  positivity

theorem stable_iff_cubic {r₁ r₂ x y b : ℝ} (hl : 0 < leading r₁ r₂ x y) :
    SchurStable (PolynomialModel.characteristic (poles r₁ r₂) ![x,y] 1 b) ↔
      C2.CubicSchur (middleB r₁ r₂ x y b/leading r₁ r₂ x y)
        (middleC r₁ r₂ x y b/leading r₁ r₂ x y)
        (constantCoeff x y b/leading r₁ r₂ x y) := by
  have hlc : (leading r₁ r₂ x y : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hl
  have he (z : ℂ) :
      (PolynomialModel.characteristic (poles r₁ r₂) ![x,y] 1 b).eval z =
      (leading r₁ r₂ x y:ℂ)*(z^3+(middleB r₁ r₂ x y b/leading r₁ r₂ x y:ℝ)*z^2+
        (middleC r₁ r₂ x y b/leading r₁ r₂ x y:ℝ)*z+(constantCoeff x y b/leading r₁ r₂ x y:ℝ)) := by
    rw [polynomial_coefficients]
    push_cast
    field_simp [hlc]
    ring
  constructor
  · intro hs z hz
    apply hs z
    rw [he,hz,mul_zero]
  · intro hs z hz
    apply hs z
    rw [he] at hz
    exact (mul_eq_zero.mp hz).resolve_left hlc

/-- Actual Schur stability implies the strict cubic Hurwitz inequalities. -/
theorem stable_necessary {r₁ r₂ x y b : ℝ} (hr₁ : 0 < r₁) (hr₂ : 0 < r₂)
    (hx : x ∈ Icc (-1:ℝ) 1) (hy : y ∈ Icc (-1:ℝ) 1) (hb : 0 ≤ b)
    (hs : SchurStable (PolynomialModel.characteristic (poles r₁ r₂) ![x,y] 1 b)) :
    0 < A1 r₁ r₂ x y b ∧ 0 < A2 r₁ r₂ x y b ∧ 0 < A3 r₁ r₂ x y b ∧ 0 < H r₁ r₂ x y b := by
  have hl := leading_pos hr₁ hr₂ hx.1 hy.1
  have hd : 0 ≤ constantCoeff x y b := by unfold constantCoeff; exact div_nonneg (mul_nonneg (mul_nonneg hb (by linarith [hx.2])) (by linarith [hy.2])) (by norm_num)
  have h0 : 0 < A0 r₁ r₂ b := by unfold A0; positivity
  have hj := (SecondOrder.scaled_cubicSchur_iff _ _ _ _ hl).mp ((stable_iff_cubic hl).mp hs)
  rw [abs_of_nonneg hd] at hj
  obtain ⟨hp,hm,hdet,hsum⟩ := coefficient_identities r₁ r₂ x y b
  have h3 : 0 < A3 r₁ r₂ x y b := by linarith [hj.2.2.1]
  have hH : 0 < H r₁ r₂ x y b := by linarith [hj.2.2.2]
  have hprod : 0 < (leading r₁ r₂ x y-constantCoeff x y b)*
      (leading r₁ r₂ x y+2*constantCoeff x y b-middleC r₁ r₂ x y b) := by
    nlinarith [mul_nonneg hd h3.le,hj.2.2.2]
  have hc : middleC r₁ r₂ x y b < leading r₁ r₂ x y+2*constantCoeff x y b := by
    by_contra hn
    have hh := mul_nonpos_of_nonneg_of_nonpos (by linarith [hj.1] : 0 ≤ leading r₁ r₂ x y-constantCoeff x y b)
      (by linarith [le_of_not_gt hn] : leading r₁ r₂ x y+2*constantCoeff x y b-middleC r₁ r₂ x y b ≤ 0)
    linarith
  have hsumpos : 0 < A1 r₁ r₂ x y b+A2 r₁ r₂ x y b := by linarith [hj.1]
  have hp12 : 0 < A1 r₁ r₂ x y b*A2 r₁ r₂ x y b := by
    have hh := mul_pos h0 h3
    unfold H at hH
    linarith
  have h1 : 0 < A1 r₁ r₂ x y b := by
    by_contra hn
    have h2 : 0 < A2 r₁ r₂ x y b := by linarith [le_of_not_gt hn]
    have hh := mul_nonpos_of_nonpos_of_nonneg (le_of_not_gt hn) h2.le
    linarith
  have h2 : 0 < A2 r₁ r₂ x y b := (mul_pos_iff_of_pos_left h1).mp hp12
  exact ⟨h1,h2,h3,hH⟩

end C2.TwoGamma

end

/- ===== C2.TwoGammaExplicit ===== -/

noncomputable section
open scoped BigOperators
open Set
namespace C2.TwoGamma
open NGamma NGamma.PolynomialModel

theorem allocation_eq_endpoint {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    endpointAllocation r₁ (scalar r₁ r₂) = allocation r₁ r₂ := by
  have hc := scalar_pos h₁ h₂
  have ht : 0 < allocation r₁ r₂ := by linarith [allocation_gt h₁ h₂]
  have hf := freeAllocation_pos h₁ hc.le
  have hs := allocation_stationarity h₁ h₂
  have hfs := freeAllocation_stationarity h₁ hc.le
  have he : freeAllocation r₁ (scalar r₁ r₂) = allocation r₁ r₂ := by
    rcases lt_trichotomy (freeAllocation r₁ (scalar r₁ r₂)) (allocation r₁ r₂) with h|h|h
    · have hh := stationaryRate_strict_mono (r := r₁) hf h
      linarith
    · exact h
    · have hh := stationaryRate_strict_mono (r := r₁) ht h
      linarith
  unfold endpointAllocation
  rw [he,max_eq_right (allocation_gt h₁ h₂).le]

theorem scalar_budget {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    allocatedResource (poles r₁ r₂) (scalar r₁ r₂) = 4 := by
  have hs₁ := allocation_stationarity h₁ h₂
  have hs₂ := allocation_stationarity h₂ h₁
  rw [scalar_comm r₁ r₂] at hs₂
  simp only [allocatedResource, Fin.sum_univ_two, poles, Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.head_cons]
  rw [allocation_eq_endpoint h₁ h₂, ← scalar_comm r₁ r₂, allocation_eq_endpoint h₂ h₁]
  unfold resource
  unfold scalar at hs₁ hs₂
  linarith

theorem optimalX_eq_parameter {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    optimalX r₁ r₂ = endpointParameter r₁ (scalar r₁ r₂) := by
  have hg := gain_pos h₁ h₂
  have hq := gain_quadratic h₁ h₂
  have hd : gain r₁ r₂+r₁*r₂ ≠ 0 := by positivity
  have ht : allocation r₁ r₂-r₁ ≠ 0 := by linarith [allocation_gt h₁ h₂]
  have hd' : r₁+r₂+2 ≠ 0 := by positivity
  unfold endpointParameter
  rw [allocation_eq_endpoint h₁ h₂]
  unfold optimalX
  apply (div_eq_div_iff hd ht).mpr
  unfold allocation
  field_simp
  nlinarith [hq]

theorem optimalX_interior {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    0 < optimalX r₁ r₂ ∧ optimalX r₁ r₂ < 1 := by
  rw [optimalX_eq_parameter h₁ h₂]
  refine ⟨endpointParameter_pos _ _, ?_⟩
  unfold endpointParameter
  rw [allocation_eq_endpoint h₁ h₂]
  apply (div_lt_one (by linarith [allocation_gt h₁ h₂])).mpr
  linarith [allocation_gt h₁ h₂]

theorem optimalGamma_interior {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    1/2 < optimalGamma r₁ r₂ ∧ optimalGamma r₁ r₂ < 1 := by
  have := optimalX_interior h₁ h₂
  unfold optimalGamma
  constructor <;> linarith

end C2.TwoGamma

end

/- ===== C2.TwoGammaOptimum ===== -/

/-! Actual-root global initial-margin theorem with the explicit two-factor
square-root formula. -/
noncomputable section
open scoped BigOperators
open Set
namespace C2.TwoGamma
open NGamma NGamma.PolynomialModel

def optimalVector (r₁ r₂ : ℝ) : Fin 2 → ℝ := ![optimalX r₁ r₂, optimalX r₂ r₁]

theorem two_factor_endpoint_sum_lt_one {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    Global.endpointSum (poles r₁ r₂) < 1 := by
  have ha : 1/(r₁+2) < (1:ℝ)/2 :=
    one_div_lt_one_div_of_lt (by norm_num) (by linarith)
  have hb : 1/(r₂+2) < (1:ℝ)/2 :=
    one_div_lt_one_div_of_lt (by norm_num) (by linarith)
  simpa [Global.endpointSum, poles, Fin.sum_univ_two] using (show 1/(r₁+2)+1/(r₂+2)<1 by linarith)

theorem optimalVector_eq_parameters {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    optimalVector r₁ r₂ = fun i => endpointParameter (poles r₁ r₂ i) (scalar r₁ r₂) := by
  funext i
  fin_cases i
  · simpa [optimalVector,poles] using optimalX_eq_parameter h₁ h₂
  · simpa [optimalVector,poles,scalar_comm] using optimalX_eq_parameter h₂ h₁

theorem optimal_allocation_product {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    (∏ i, endpointAllocation (poles r₁ r₂ i) (scalar r₁ r₂)) = gain r₁ r₂ := by
  simp only [Fin.prod_univ_two, poles, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
  rw [allocation_eq_endpoint h₁ h₂, ← scalar_comm r₁ r₂, allocation_eq_endpoint h₂ h₁]
  exact allocation_mul h₁ h₂

/-- Explicit full-square initial-margin optimum. The assertion about arbitrary
stable components outside the half-square is handled separately. -/
theorem explicit_initial_margin_optimum {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    initialGainMargin (poles r₁ r₂) (optimalVector r₁ r₂) 1 = gain r₁ r₂ ∧
    (∀ b : ℝ, 0 ≤ b →
      (SchurStable (PolynomialModel.characteristic (poles r₁ r₂) (optimalVector r₁ r₂) 1 b)
        ↔ b < gain r₁ r₂)) ∧
    (∃ z : ℂ, ‖z‖ = 1 ∧
      (PolynomialModel.characteristic (poles r₁ r₂) (optimalVector r₁ r₂) 1 (gain r₁ r₂)).eval z = 0) ∧
    ∀ x : Fin 2 → ℝ, (∀ i, x i ∈ Icc (-1:ℝ) 1) →
      initialGainMargin (poles r₁ r₂) x 1 ≤ gain r₁ r₂ ∧
      (initialGainMargin (poles r₁ r₂) x 1 = gain r₁ r₂ ↔ x = optimalVector r₁ r₂) := by
  have hr := poles_pos h₁ h₂
  obtain ⟨xs,Bs,hxs,hBs,hd,hm,hs,hroot,hfull⟩ :=
    Global.full_cube_initial_margin_global_theorem (by norm_num : 0 < (2:ℕ)) (poles r₁ r₂) hr
  have hsmall := two_factor_endpoint_sum_lt_one h₁ h₂
  obtain ⟨c,hc,hbudget,hxc,hBc⟩ := hd.2.2 hsmall
  obtain ⟨c₀,hc₀,hunique⟩ := existsUnique_endpoint_scalar (poles r₁ r₂) hr hsmall
  have he : c = scalar r₁ r₂ :=
    (hunique c ⟨hc,hbudget⟩).trans (hunique _ ⟨scalar_pos h₁ h₂,scalar_budget h₁ h₂⟩).symm
  have hx : xs = optimalVector r₁ r₂ := by
    rw [hxc,he,optimalVector_eq_parameters h₁ h₂]
  have hB : Bs = gain r₁ r₂ := by
    rw [hBc,he]
    exact optimal_allocation_product h₁ h₂
  simpa only [hx,hB] using And.intro hm (And.intro hs (And.intro hroot hfull))

theorem optimal_coordinates {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    coordinates (optimalGamma r₁ r₂) (optimalGamma r₂ r₁) = optimalVector r₁ r₂ := by
  funext i
  fin_cases i <;> simp [coordinates,optimalVector,optimalGamma,Parameterization.xOfGamma] <;> ring

/-- Exact interval for the displayed optimal gamma pair, including gain zero
and the exclusion of the boundary itself. -/
theorem optimal_pair_stable_iff {r₁ r₂ b : ℝ}
    (h₁ : 0 < r₁) (h₂ : 0 < r₂) (hb : 0 ≤ b) :
    SchurStable (characteristic r₁ r₂ (optimalGamma r₁ r₂) (optimalGamma r₂ r₁) b)
      ↔ b < gain r₁ r₂ := by
  rw [characteristic_eq_generic,optimal_coordinates h₁ h₂]
  exact (explicit_initial_margin_optimum h₁ h₂).2.1 b hb

theorem half_square_gain_bound {r₁ r₂ γ₁ γ₂ b : ℝ}
    (h₁ : 0 < r₁) (h₂ : 0 < r₂)
    (hg₁ : γ₁ ∈ Icc (1/2:ℝ) 1) (hg₂ : γ₂ ∈ Icc (1/2:ℝ) 1)
    (hb : 0 ≤ b) (hs : SchurStable (characteristic r₁ r₂ γ₁ γ₂ b)) : b < gain r₁ r₂ := by
  have hr := poles_pos h₁ h₂
  have hx := coordinates_in_half_cube hg₁ hg₂
  obtain ⟨B,hB⟩ := Global.criticalGain_exists (by norm_num : 0 < (2:ℕ))
    (poles r₁ r₂) (coordinates γ₁ γ₂) hr hx
  rw [characteristic_eq_generic] at hs
  have hbB := (Global.criticalGain_exact_interval (by norm_num) _ _ hr hx hB hb).mp hs
  have hle := ((explicit_initial_margin_optimum h₁ h₂).2.2.2 (coordinates γ₁ γ₂)
    (fun i => ⟨by linarith [(hx i).1],(hx i).2⟩)).1
  rw [Global.criticalGain_eq_initialMargin (by norm_num) _ _ hr hx hB] at hle
  exact lt_of_lt_of_le hbB hle

theorem optimalX_equal_iff {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    optimalX r₁ r₂ = optimalX r₂ r₁ ↔ r₁ = r₂ := by
  have hd : gain r₁ r₂+r₁*r₂ ≠ 0 := by have := gain_pos h₁ h₂; positivity
  unfold optimalX
  rw [gain_comm r₁ r₂]
  have hp : r₂*r₁ = r₁*r₂ := by ring
  rw [hp]
  rw [div_left_inj' hd]
  constructor <;> intro h <;> linarith

end C2.TwoGamma

end

/- ===== C2.TwoGammaFullSquare ===== -/

/-! Algebraic exclusion of large-gain stability outside the positive half
square. This argument does not assume connected stable components there. -/
noncomputable section
open scoped BigOperators
open Set
namespace C2.TwoGamma
open NGamma NGamma.PolynomialModel

/-- Full-square global exclusion for every stable gain, including any isolated
stable component. -/
theorem full_square_gain_bound {r₁ r₂ γ₁ γ₂ b : ℝ}
    (h₁ : 0 < r₁) (h₂ : 0 < r₂)
    (hg₁ : γ₁ ∈ Icc (0:ℝ) 1) (hg₂ : γ₂ ∈ Icc (0:ℝ) 1)
    (hb : 0 ≤ b) (hs : SchurStable (characteristic r₁ r₂ γ₁ γ₂ b)) : b < gain r₁ r₂ := by
  by_contra! hbig
  have hx := (Parameterization.full_cube_coordinate γ₁).mp hg₁
  have hy := (Parameterization.full_cube_coordinate γ₂).mp hg₂
  have hs' : SchurStable (PolynomialModel.characteristic (poles r₁ r₂)
      ![Parameterization.xOfGamma γ₁,Parameterization.xOfGamma γ₂] 1 b) := by
    simpa only [characteristic_eq_generic,coordinates] using hs
  obtain ⟨ha₁,ha₂,ha₃,hH⟩ := stable_necessary h₁ h₂ hx hy hb hs'
  have hxpos : 0 < Parameterization.xOfGamma γ₁ := by
    by_contra! hn
    exact closed_high_gain_exclusion_left h₁ h₂ hbig hn ha₁.le ha₂.le hH.le
  have hypos : 0 < Parameterization.xOfGamma γ₂ := by
    by_contra! hn
    exact closed_high_gain_exclusion_right h₁ h₂ hbig hn ha₁.le ha₂.le hH.le
  have hh₁ : γ₁ ∈ Icc (1/2:ℝ) 1 :=
    (Parameterization.half_cube_coordinate γ₁).mpr ⟨hxpos.le,hx.2⟩
  have hh₂ : γ₂ ∈ Icc (1/2:ℝ) 1 :=
    (Parameterization.half_cube_coordinate γ₂).mpr ⟨hypos.le,hy.2⟩
  exact not_lt_of_ge hbig (half_square_gain_bound h₁ h₂ hh₁ hh₂ hb hs)

end C2.TwoGamma

end

/- ===== C2.TwoGammaShared ===== -/

/-! Strict benefit of independent parameters over the globally optimized
shared parameter. The comparison is between actual optimal gains. -/
noncomputable section
open scoped BigOperators
open Set Polynomial
namespace C2.TwoGamma
open NGamma NGamma.PolynomialModel

theorem diagonal_eval (r₁ r₂ t b : ℝ) (z : ℂ) :
    (PolynomialModel.characteristic (poles r₁ r₂) ![t,t] 1 b).eval z =
      SecondOrder.delayCharacteristic (r₁+r₂) (r₁*r₂) t b z := by
  simp [PolynomialModel.characteristic,poles,Fin.prod_univ_two,factor_eval,q_eval,
    SecondOrder.delayCharacteristic,SecondOrder.gamma]
  push_cast
  ring

theorem diagonal_schur_iff {r₁ r₂ t b : ℝ}
    (h₁ : 0 < r₁) (h₂ : 0 < r₂) (ht : -1 ≤ t) :
    SchurStable (PolynomialModel.characteristic (poles r₁ r₂) ![t,t] 1 b) ↔
      SecondOrder.Schur (r₁+r₂) (r₁*r₂) t b := by
  have hl : 0 < SecondOrder.L (r₁+r₂) (r₁*r₂) t := by
    have hh : 0 ≤ 1+t := by linarith
    unfold SecondOrder.L
    positivity
  rw [SecondOrder.schur_iff_delay_characteristic hl]
  simp only [SchurStable,diagonal_eval]

theorem shared_root_margin {r₁ r₂ t : ℝ}
    (h₁ : 0 < r₁) (h₂ : 0 < r₂) (ht : 0 < t) (ht1 : t < 1)
    (hf : SecondOrder.f (r₁+r₂) (r₁*r₂) t = 0) :
    initialGainMargin (poles r₁ r₂) ![t,t] 1 = SecondOrder.optimum (r₁+r₂) t := by
  have hu : 0 < r₁+r₂ := by linarith
  have hv : 0 < r₁*r₂ := mul_pos h₁ h₂
  have hopt := SecondOrder.optimum_positive hu ht
  apply initialGainMargin_eq_of_exact_interval hopt
  intro b hb
  by_cases hb0 : b = 0
  · subst b
    exact iff_of_true (zero_gain_schur (poles_pos h₁ h₂) (by intro i; fin_cases i <;> simpa using ht.le) 1) hopt
  · rw [diagonal_schur_iff h₁ h₂ (by linarith)]
    exact SecondOrder.schur_at_optimal_parameter_iff hu hv ht ht1 hf (lt_of_le_of_ne hb (Ne.symm hb0))

/-- The independent gain is strictly larger than the global shared optimum
exactly when the continuous poles differ. -/
theorem strict_improvement_iff {r₁ r₂ t : ℝ}
    (h₁ : 0 < r₁) (h₂ : 0 < r₂) (ht : 0 < t) (ht1 : t < 1)
    (hf : SecondOrder.f (r₁+r₂) (r₁*r₂) t = 0) :
    SecondOrder.optimum (r₁+r₂) t < gain r₁ r₂ ↔ r₁ ≠ r₂ := by
  have hm := shared_root_margin h₁ h₂ ht ht1 hf
  have hcube : ∀ i : Fin 2, (![t,t] : Fin 2 → ℝ) i ∈ Icc (-1:ℝ) 1 := by
    intro i
    fin_cases i <;> constructor <;> simp <;> linarith
  have hbound := (explicit_initial_margin_optimum h₁ h₂).2.2.2 ![t,t] hcube
  rw [hm] at hbound
  constructor
  · intro hlt heq
    subst r₂
    have hu : 0 < r₁+r₁ := by linarith
    have hv : 0 < r₁*r₁ := mul_pos h₁ h₁
    have ho := SecondOrder.optimum_positive hu ht
    let b := (gain r₁ r₁+SecondOrder.optimum (r₁+r₁) t)/2
    have hb : 0 < b := by dsimp [b]; linarith
    have hbB : b < gain r₁ r₁ := by dsimp [b]; linarith
    have hs := ((explicit_initial_margin_optimum h₁ h₁).2.1 b hb.le).mpr hbB
    change SchurStable (PolynomialModel.characteristic (poles r₁ r₁) ![optimalX r₁ r₁,optimalX r₁ r₁] 1 b) at hs
    have hx := optimalX_interior h₁ h₁
    have hs' := (diagonal_schur_iff h₁ h₁ (by linarith : -1 ≤ optimalX r₁ r₁)).mp hs
    have hh := SecondOrder.schur_global_gain_bound hu hv ht ht1 hf (by linarith : -1 ≤ optimalX r₁ r₁) hb hs'
    dsimp [b] at hh
    linarith
  · intro hne
    apply lt_of_le_of_ne hbound.1
    intro heq
    have he := hbound.2.mp heq
    have ha := congrFun he (0:Fin 2)
    have hb := congrFun he (1:Fin 2)
    have hx : optimalX r₁ r₂ = optimalX r₂ r₁ := by
      simpa [optimalVector] using ha.symm.trans hb
    exact hne ((optimalX_equal_iff h₁ h₂).mp hx)

/-- Unconditional comparison with an attained shared-parameter global
supremum. Since its parameter lies in (0,1), it is admissible both for
shared gamma in [1/2,1] and for shared gamma in [0,1]. -/
theorem shared_global_supremum_comparison {r₁ r₂ : ℝ}
    (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    ∃ t : ℝ, 0 < t ∧ t < 1 ∧
      IsLUB (SecondOrder.stableGains (r₁+r₂) (r₁*r₂) t) (SecondOrder.optimum (r₁+r₂) t) ∧
      (∀ s b : ℝ, -1 ≤ s → 0 < b → SecondOrder.Schur (r₁+r₂) (r₁*r₂) s b →
        b < SecondOrder.optimum (r₁+r₂) t) ∧
      (SecondOrder.optimum (r₁+r₂) t < gain r₁ r₂ ↔ r₁ ≠ r₂) := by
  have hu : 0 < r₁+r₂ := by linarith
  have hv : 0 < r₁*r₂ := mul_pos h₁ h₂
  obtain ⟨t,⟨ht,ht1,hf⟩,_⟩ := SecondOrder.exists_unique_optimal_root hu hv
  exact ⟨t,ht,ht1,SecondOrder.optimal_gain_isLUB hu hv ht ht1 hf,
    fun s b hs hb hstable => SecondOrder.schur_global_gain_bound hu hv ht ht1 hf hs hb hstable,
    strict_improvement_iff h₁ h₂ ht ht1 hf⟩

end C2.TwoGamma

end

/- ===== C2.TwoGammaFinal ===== -/

/-! Named manuscript-level assertions about the supremum of all stable gains,
not only the initial interval. -/
noncomputable section
open scoped BigOperators
open Set
namespace C2.TwoGamma
open NGamma NGamma.PolynomialModel

def stableGains (r₁ r₂ γ₁ γ₂ : ℝ) : Set ℝ :=
  {b | 0 ≤ b ∧ SchurStable (characteristic r₁ r₂ γ₁ γ₂ b)}

def fullSquareGains (r₁ r₂ : ℝ) : Set ℝ :=
  {b | ∃ γ₁ ∈ Icc (0:ℝ) 1, ∃ γ₂ ∈ Icc (0:ℝ) 1, b ∈ stableGains r₁ r₂ γ₁ γ₂}

def halfSquareGains (r₁ r₂ : ℝ) : Set ℝ :=
  {b | ∃ γ₁ ∈ Icc (1/2:ℝ) 1, ∃ γ₂ ∈ Icc (1/2:ℝ) 1, b ∈ stableGains r₁ r₂ γ₁ γ₂}

theorem optimal_pair_isLUB {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    IsLUB (stableGains r₁ r₂ (optimalGamma r₁ r₂) (optimalGamma r₂ r₁)) (gain r₁ r₂) := by
  have he : stableGains r₁ r₂ (optimalGamma r₁ r₂) (optimalGamma r₂ r₁) = Ico 0 (gain r₁ r₂) := by
    ext b
    constructor
    · rintro ⟨hb,hs⟩
      exact ⟨hb,(optimal_pair_stable_iff h₁ h₂ hb).mp hs⟩
    · rintro ⟨hb,hB⟩
      exact ⟨hb,(optimal_pair_stable_iff h₁ h₂ hb).mpr hB⟩
  rw [he]
  exact isLUB_Ico (gain_pos h₁ h₂)

theorem full_square_isLUB {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    IsLUB (fullSquareGains r₁ r₂) (gain r₁ r₂) := by
  have hg₁ := optimalGamma_interior h₁ h₂
  have hg₂ := optimalGamma_interior h₂ h₁
  constructor
  · rintro b ⟨γ₁,hγ₁,γ₂,hγ₂,hb,hs⟩
    exact (full_square_gain_bound h₁ h₂ hγ₁ hγ₂ hb hs).le
  · intro c hc
    apply (optimal_pair_isLUB h₁ h₂).2
    intro b hb
    exact hc ⟨optimalGamma r₁ r₂,⟨by linarith,hg₁.2.le⟩,
      optimalGamma r₂ r₁,⟨by linarith,hg₂.2.le⟩,hb⟩

theorem half_square_isLUB {r₁ r₂ : ℝ} (h₁ : 0 < r₁) (h₂ : 0 < r₂) :
    IsLUB (halfSquareGains r₁ r₂) (gain r₁ r₂) := by
  have hg₁ := optimalGamma_interior h₁ h₂
  have hg₂ := optimalGamma_interior h₂ h₁
  constructor
  · rintro b ⟨γ₁,hγ₁,γ₂,hγ₂,hb,hs⟩
    exact (half_square_gain_bound h₁ h₂ hγ₁ hγ₂ hb hs).le
  · intro c hc
    apply (optimal_pair_isLUB h₁ h₂).2
    intro b hb
    exact hc ⟨optimalGamma r₁ r₂,⟨hg₁.1.le,hg₁.2.le⟩,
      optimalGamma r₂ r₁,⟨hg₂.1.le,hg₂.2.le⟩,hb⟩

/-- The only full-square parameter pair whose entire stable-gain set has
supremum B is the explicitly displayed pair. -/
theorem full_square_optimal_pair_unique {r₁ r₂ γ₁ γ₂ : ℝ}
    (h₁ : 0 < r₁) (h₂ : 0 < r₂)
    (hg₁ : γ₁ ∈ Icc (0:ℝ) 1) (hg₂ : γ₂ ∈ Icc (0:ℝ) 1)
    (hSup : IsLUB (stableGains r₁ r₂ γ₁ γ₂) (gain r₁ r₂)) :
    γ₁ = optimalGamma r₁ r₂ ∧ γ₂ = optimalGamma r₂ r₁ := by
  let x := Parameterization.xOfGamma γ₁
  let y := Parameterization.xOfGamma γ₂
  have hx : x ∈ Icc (-1:ℝ) 1 := (Parameterization.full_cube_coordinate γ₁).mp hg₁
  have hy : y ∈ Icc (-1:ℝ) 1 := (Parameterization.full_cube_coordinate γ₂).mp hg₂
  have hclosed : IsClosed {b : ℝ | 0 ≤ A1 r₁ r₂ x y b ∧ 0 ≤ A2 r₁ r₂ x y b ∧ 0 ≤ H r₁ r₂ x y b} := by
    apply IsClosed.inter
    · apply isClosed_le (f := fun _ : ℝ => (0:ℝ)) (g := fun b : ℝ => A1 r₁ r₂ x y b) continuous_const
      unfold A1
      fun_prop
    · apply IsClosed.inter
      · apply isClosed_le (f := fun _ : ℝ => (0:ℝ)) (g := fun b : ℝ => A2 r₁ r₂ x y b) continuous_const
        unfold A2
        fun_prop
      · apply isClosed_le (f := fun _ : ℝ => (0:ℝ)) (g := fun b : ℝ => H r₁ r₂ x y b) continuous_const
        unfold H A0 A1 A2 A3
        fun_prop
  have hsubset : stableGains r₁ r₂ γ₁ γ₂ ⊆
      {b : ℝ | 0 ≤ A1 r₁ r₂ x y b ∧ 0 ≤ A2 r₁ r₂ x y b ∧ 0 ≤ H r₁ r₂ x y b} := by
    intro b hb
    have hs' : SchurStable (PolynomialModel.characteristic (poles r₁ r₂) ![x,y] 1 b) := by
      simpa only [characteristic_eq_generic,coordinates] using hb.2
    obtain ⟨hA1,hA2,_,hH⟩ := stable_necessary h₁ h₂ hx hy hb.1 hs'
    exact ⟨hA1.le,hA2.le,hH.le⟩
  obtain ⟨ha₁,ha₂,hH⟩ := closure_minimal hsubset hclosed (hSup.mem_closure hSup.nonempty)
  have hxp : 0 < x := lt_of_not_ge fun hn =>
    closed_high_gain_exclusion_left h₁ h₂ (le_refl _) hn ha₁ ha₂ hH
  have hyp : 0 < y := lt_of_not_ge fun hn =>
    closed_high_gain_exclusion_right h₁ h₂ (le_refl _) hn ha₁ ha₂ hH
  have hh₁ : γ₁ ∈ Icc (1/2:ℝ) 1 := (Parameterization.half_cube_coordinate γ₁).mpr ⟨hxp.le,hx.2⟩
  have hh₂ : γ₂ ∈ Icc (1/2:ℝ) 1 := (Parameterization.half_cube_coordinate γ₂).mpr ⟨hyp.le,hy.2⟩
  obtain ⟨C,hC,hset⟩ := connected_stable_gain_interval h₁ h₂ hh₁ hh₂
  change stableGains r₁ r₂ γ₁ γ₂ = Ico 0 C at hset
  have hCLUB : IsLUB (stableGains r₁ r₂ γ₁ γ₂) C := by rw [hset]; exact isLUB_Ico hC
  have hBC : gain r₁ r₂ = C := hSup.unique hCLUB
  have hmargin : initialGainMargin (poles r₁ r₂) (coordinates γ₁ γ₂) 1 = gain r₁ r₂ := by
    rw [hBC]
    apply initialGainMargin_eq_of_exact_interval hC
    intro b hb
    have hmem : b ∈ stableGains r₁ r₂ γ₁ γ₂ ↔ b ∈ Ico 0 C := by rw [hset]
    simpa [stableGains,hb,characteristic_eq_generic] using hmem
  have hcoords := ((explicit_initial_margin_optimum h₁ h₂).2.2.2 (coordinates γ₁ γ₂)
    (by
      intro i
      fin_cases i
      · exact hx
      · exact hy)).2.mp hmargin
  have ha := congrFun hcoords (0:Fin 2)
  have hb := congrFun hcoords (1:Fin 2)
  simp only [coordinates,optimalVector,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.head_cons] at ha hb
  unfold Parameterization.xOfGamma at ha hb
  unfold optimalGamma
  constructor <;> linarith

end C2.TwoGamma

end

/- ===== C2.ZOH ===== -/

/-!
# Exact ZOH lag: algebraic Schur inequalities and global parameter optimum

This file proves the cubic Jury inequalities, their exact positive-gain interval,
and the unique optimal integration parameter. The predicate `zohJury` is explicitly
an algebraic predicate, not a redefinition of root-based Schur stability. The
module `C2.ZOHRoots` composes these results with a proved complex-root cubic
Schur criterion.
-/

noncomputable section
namespace C2

/-- Last cubic Jury expression, using `beta = 1 - gamma`. -/
def zohF (ρ a β : ℝ) : ℝ :=
  1 - ρ - a * (1 + ρ * β) - a ^ 2 * β ^ 2

/-- The four classical cubic Jury inequalities for
`z³ -(1+ρ)z² +(ρ+a(1-β))z +aβ`. -/
def zohJury (ρ a β : ℝ) : Prop :=
  |a * β| < 1 ∧
  0 < 1 + (-(1 + ρ)) + (ρ + a * (1 - β)) + a * β ∧
  0 < 1 - (-(1 + ρ)) + (ρ + a * (1 - β)) - a * β ∧
  0 < 1 - (a * β)^2 - (ρ + a * (1 - β)) + (-(1 + ρ)) * (a * β)

theorem zoh_last_jury_identity (ρ a β : ℝ) :
    1 - (a * β)^2 - (ρ + a * (1 - β)) + (-(1 + ρ)) * (a * β)
      = zohF ρ a β := by
  unfold zohF
  ring

/-- Every point satisfying the decisive inequality lies below the universal cap. -/
theorem zoh_gain_lt_cap {ρ a β : ℝ} (hρ : 0 < ρ) (ha : 0 < a)
    (hβ : 0 ≤ β) (hF : 0 < zohF ρ a β) : a < 1 - ρ := by
  unfold zohF at hF
  have h1 : 0 ≤ a * ρ * β := mul_nonneg (mul_nonneg ha.le hρ.le) hβ
  have h2 : 0 ≤ a ^ 2 * β ^ 2 := mul_nonneg (sq_nonneg a) (sq_nonneg β)
  nlinarith

/-- The four cubic inequalities reduce exactly to one inequality. -/
theorem zoh_jury_iff {ρ a β : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (ha : 0 < a) (hβ : 0 ≤ β) (hβ1 : β ≤ 1) :
    zohJury ρ a β ↔ 0 < zohF ρ a β := by
  constructor
  · intro h
    rw [← zoh_last_jury_identity]
    exact h.2.2.2
  · intro hF
    have hcap := zoh_gain_lt_cap hρ ha hβ hF
    have hab : 0 ≤ a * β := mul_nonneg ha.le hβ
    have hab1 : a * β ≤ a := by nlinarith
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [abs_of_nonneg hab]
      linarith
    · nlinarith
    · nlinarith
    · rw [zoh_last_jury_identity]
      exact hF

/-- Increasing beta strictly decreases the decisive expression at positive gain. -/
theorem zohF_strictAnti_beta {ρ a β₁ β₂ : ℝ} (hρ : 0 < ρ) (ha : 0 < a)
    (hβ₁ : 0 ≤ β₁) (hβ : β₁ < β₂) :
    zohF ρ a β₂ < zohF ρ a β₁ := by
  have hβ₂ : 0 ≤ β₂ := le_trans hβ₁ hβ.le
  have hp : 0 < a * ρ * (β₂ - β₁) :=
    mul_pos (mul_pos ha hρ) (sub_pos.mpr hβ)
  have hs : 0 ≤ β₂ ^ 2 - β₁ ^ 2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hβ.le) (add_nonneg hβ₁ hβ₂)]
  have hq : 0 ≤ a ^ 2 * (β₂ ^ 2 - β₁ ^ 2) := mul_nonneg (sq_nonneg a) hs
  unfold zohF
  nlinarith

/-- Increasing gain strictly decreases the decisive expression. -/
theorem zohF_strictAnti_gain {ρ a₁ a₂ β : ℝ} (hρ : 0 ≤ ρ)
    (hβ : 0 ≤ β) (ha₁ : 0 ≤ a₁) (ha : a₁ < a₂) :
    zohF ρ a₂ β < zohF ρ a₁ β := by
  have ha₂ : 0 ≤ a₂ := le_trans ha₁ ha.le
  have hp : 0 ≤ ρ * β := mul_nonneg hρ hβ
  have hlin : 0 < (a₂ - a₁) * (1 + ρ * β) :=
    mul_pos (sub_pos.mpr ha) (by linarith)
  have hs : 0 ≤ a₂ ^ 2 - a₁ ^ 2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr ha.le) (add_nonneg ha₁ ha₂)]
  have hq : 0 ≤ (a₂ ^ 2 - a₁ ^ 2) * β ^ 2 := mul_nonneg hs (sq_nonneg β)
  unfold zohF
  nlinarith

/-- Positive root, written in a form valid also at beta=0. -/
def zohThreshold (ρ β : ℝ) : ℝ :=
  2 * (1 - ρ) /
    (1 + ρ * β + Real.sqrt ((1 + ρ * β)^2 + 4 * (1 - ρ) * β^2))

private theorem zoh_denom_pos {ρ β : ℝ} (hρ : 0 ≤ ρ) (hβ : 0 ≤ β) :
    0 < 1 + ρ * β + Real.sqrt ((1 + ρ * β)^2 + 4 * (1 - ρ) * β^2) := by
  have hp : 0 ≤ ρ * β := mul_nonneg hρ hβ
  have hs := Real.sqrt_nonneg ((1 + ρ * β)^2 + 4 * (1 - ρ) * β^2)
  linarith

theorem zoh_threshold_pos {ρ β : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hβ : 0 ≤ β) : 0 < zohThreshold ρ β := by
  unfold zohThreshold
  exact div_pos (by linarith) (zoh_denom_pos hρ hβ)

/-- The closed-form threshold lies exactly on the decisive Jury boundary. -/
theorem zoh_threshold_boundary {ρ β : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hβ : 0 ≤ β) : zohF ρ (zohThreshold ρ β) β = 0 := by
  let b : ℝ := 1 + ρ * β
  let c : ℝ := 1 - ρ
  let s : ℝ := Real.sqrt (b^2 + 4*c*β^2)
  have hc : 0 < c := by dsimp [c]; linarith
  have hb : 0 < b := by dsimp [b]; nlinarith [mul_nonneg hρ hβ]
  have hd : 0 ≤ b^2 + 4*c*β^2 := by positivity
  have hs : s^2 = b^2 + 4*c*β^2 := Real.sq_sqrt hd
  have hbs : b+s ≠ 0 := ne_of_gt (by
    have hsn : 0 ≤ s := Real.sqrt_nonneg _
    linarith)
  change c - (2*c/(b+s))*b - (2*c/(b+s))^2*β^2 = 0
  field_simp [hbs]
  nlinarith [congrArg (fun x : ℝ => c*x) hs]

/-- The positive-gain stable region defined by the cubic inequalities is one interval. -/
theorem zohF_pos_iff_lt_threshold {ρ a β : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ < 1)
    (ha : 0 ≤ a) (hβ : 0 ≤ β) :
    0 < zohF ρ a β ↔ a < zohThreshold ρ β := by
  have ht := zoh_threshold_pos hρ hρ1 hβ
  have hb := zoh_threshold_boundary hρ hρ1 hβ
  constructor
  · intro hF
    by_contra h
    have hle : zohThreshold ρ β ≤ a := le_of_not_gt h
    rcases hle.eq_or_lt with he | hlt
    · rw [← he, hb] at hF
      exact (lt_irrefl 0) hF
    · have hm := zohF_strictAnti_gain hρ hβ ht.le hlt
      rw [hb] at hm
      linarith
  · intro hlt
    have hm := zohF_strictAnti_gain hρ hβ ha hlt
    rw [hb] at hm
    exact hm

/-- Full exact algebraic region with all input hypotheses visible. -/
theorem zoh_jury_iff_gain_interval {ρ a β : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (ha : 0 < a) (hβ : 0 ≤ β) (hβ1 : β ≤ 1) :
    zohJury ρ a β ↔ a < zohThreshold ρ β := by
  rw [zoh_jury_iff hρ hρ1 ha hβ hβ1,
    zohF_pos_iff_lt_threshold hρ.le hρ1 ha.le hβ]

theorem zoh_threshold_beta_zero (ρ : ℝ) : zohThreshold ρ 0 = 1 - ρ := by
  simp [zohThreshold]
  ring

/-- Threshold decreases strictly with beta, hence increases strictly with gamma. -/
theorem zoh_threshold_strictAnti {ρ β₁ β₂ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hβ₁ : 0 ≤ β₁) (hβ : β₁ < β₂) :
    zohThreshold ρ β₂ < zohThreshold ρ β₁ := by
  have hβ₂ : 0 ≤ β₂ := le_trans hβ₁ hβ.le
  have ht₂ := zoh_threshold_pos hρ.le hρ1 hβ₂
  have hb₂ := zoh_threshold_boundary hρ.le hρ1 hβ₂
  have hm := zohF_strictAnti_beta hρ ht₂ hβ₁ hβ
  rw [hb₂] at hm
  exact (zohF_pos_iff_lt_threshold hρ.le hρ1 ht₂.le hβ₁).mp hm

/-- Backward Euler is the unique maximizer over gamma in [0,1]. -/
theorem zoh_threshold_unique_max {ρ γ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hγ : 0 ≤ γ) (hγ1 : γ ≤ 1) :
    zohThreshold ρ (1-γ) ≤ 1-ρ ∧
      (zohThreshold ρ (1-γ) = 1-ρ ↔ γ = 1) := by
  by_cases he : γ = 1
  · subst γ
    simp [zoh_threshold_beta_zero]
  · have hb : 0 < 1-γ := sub_pos.mpr (lt_of_le_of_ne hγ1 he)
    have hm := zoh_threshold_strictAnti hρ hρ1 (le_refl 0) hb
    rw [zoh_threshold_beta_zero] at hm
    exact ⟨hm.le, ⟨fun h => False.elim (ne_of_lt hm h), fun h => False.elim (he h)⟩⟩

/-- The dimensional optimum is independent of the sampled lag pole. -/
theorem zoh_physical_gain_iff {ρ k : ℝ} (hρ1 : ρ < 1) :
    k * (1-ρ) < zohThreshold ρ 0 ↔ k < 1 := by
  rw [zoh_threshold_beta_zero]
  have hpos : 0 < 1-ρ := by linarith
  constructor <;> intro h <;> nlinarith

/-- Direct polynomial identity for the characteristic expression. -/
theorem zoh_characteristic_identity (z ρ a β : ℝ) :
    z * (z - ρ) * (z - 1) + a * ((1-β)*z+β) =
      z^3 - (1+ρ)*z^2 + (ρ+a*(1-β))*z + a*β := by ring


/-- The physical first-order lag supplies a pole strictly between zero and one. -/
theorem zoh_sampled_pole_range {T τ : ℝ} (hT : 0 < T) (hτ : 0 < τ) :
    0 < Real.exp (-T/τ) ∧ Real.exp (-T/τ) < 1 := by
  refine ⟨Real.exp_pos _, Real.exp_lt_one_iff.mpr ?_⟩
  exact div_neg_of_neg_of_pos (neg_neg_of_pos hT) hτ


/-- Boundary factorization; the remaining linear root is `-a*beta`. -/
theorem zoh_boundary_factorization (z ρ a β : ℝ)
    (hF : zohF ρ a β = 0) :
    z^3 - (1+ρ)*z^2 + (ρ+a*(1-β))*z + a*β =
      (z+a*β) * (z^2 - (1+ρ+a*β)*z + 1) := by
  unfold zohF at hF
  linear_combination -z * hF

end C2

end

/- ===== C2.ZOHRoots ===== -/

/-! Root-based completion of the exact sampled-lag theorem. -/
noncomputable section
namespace C2

/-- Genuine complex-root Schur stability equals the exact positive-gain interval. -/
theorem zoh_cubicSchur_iff_gain_interval {ρ a β : ℝ}
    (hρ : 0 < ρ) (hρ1 : ρ < 1) (ha : 0 < a) (hβ : 0 ≤ β) (hβ1 : β ≤ 1) :
    CubicSchur (-(1+ρ)) (ρ+a*(1-β)) (a*β) ↔ a < zohThreshold ρ β := by
  rw [cubicSchur_iff]
  have hi : 1 - (ρ+a*(1-β)) + (-(1+ρ))*(a*β) - (a*β)^2 =
      1 - (a*β)^2 - (ρ+a*(1-β)) + (-(1+ρ))*(a*β) := by ring
  rw [hi]
  exact zoh_jury_iff_gain_interval hρ hρ1 ha hβ hβ1

/-- The root-based stable-gain interval at the uniquely optimal parameter. -/
theorem zoh_backward_euler_schur_iff {ρ a : ℝ}
    (hρ : 0 < ρ) (hρ1 : ρ < 1) (ha : 0 < a) :
    CubicSchur (-(1+ρ)) (ρ+a) 0 ↔ a < 1-ρ := by
  have h := zoh_cubicSchur_iff_gain_interval hρ hρ1 ha (le_refl 0) (by norm_num : (0:ℝ) ≤ 1)
  simpa [zoh_threshold_beta_zero] using h

/-- No parameter admits a stable gain at or above the backward-Euler cap. -/
theorem zoh_schur_gain_lt_cap {ρ a β : ℝ}
    (hρ : 0 < ρ) (hρ1 : ρ < 1) (ha : 0 < a) (hβ : 0 ≤ β) (hβ1 : β ≤ 1)
    (hs : CubicSchur (-(1+ρ)) (ρ+a*(1-β)) (a*β)) : a < 1-ρ := by
  have h := (zoh_cubicSchur_iff_gain_interval hρ hρ1 ha hβ hβ1).mp hs
  have hf := (zohF_pos_iff_lt_threshold hρ.le hρ1 ha.le hβ).mpr h
  exact zoh_gain_lt_cap hρ ha hβ hf

end C2

